
;-------------------------------------------------
;函数名:IMG_TALK
;概　要:简单图文混排
; 核心函数：IMG_TALK
; 参  数：
;   IMG_RES   : 图片资源名
;   HTML_TEXT : 纯 HTML 文本串
;   CID       : 角色ID (用于自动取色)
;   AUTO_FMT  : 是否开启自动垂直居中整形 (默认1)
;   IMG_H_PX  : 图片高度
;   CUSTOM_C  : 强制覆盖的字体颜色Hex
;引　用：SPTALK,CID,表情="",默认=0,MESSAGE,整形=0
;K63_PRINT_FACE与SPTALK的功能融合，处理图文混排的HTML底层，默认居中
;-------------------------------------------------
@IMG_TALK(IMG_RES, HTML_TEXT, CID = 0, AUTO_FMT = 1, IMG_H_PX = 180, CUSTOM_C = "")
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS DYNAMIC IMG_RES
#DIMS DYNAMIC HTML_TEXT
#DIM  DYNAMIC CID
#DIM  DYNAMIC AUTO_FMT
#DIMS DYNAMIC CUSTOM_C
#DIM  DYNAMIC IMG_H_PX
#DIMS DYNAMIC FONTCOLOR
#DIMS DYNAMIC IMG_HTML
#DIM  DYNAMIC IMG_W_PX

; 1. 解析字体颜色
CALL RESOLVE_KOJO_COLOR(CID, CUSTOM_C)
FONTCOLOR '= RESULTS

; 2. 图像校验与降级
IF IMG_RES == "" || !SPRITECREATED(IMG_RES)
	SIF CID > 0
		PRINTFORMDL －%CALLNAME:CID%－
	HTML_PRINT @"<font color='%FONTCOLOR%'>%HTML_TEXT%</font>"
	DEBUGPRINTFORML 找不到%IMG_RES%
	RETURN
ENDIF

; 3. 构建图像 HTML 块 + 调用统一排版函数
IMG_W_PX = SPRITEWIDTH(IMG_RES) * IMG_H_PX / SPRITEHEIGHT(IMG_RES)
IMG_HTML '= @"<nonbutton><img src='%IMG_RES%' width='{IMG_W_PX}px' height='{IMG_H_PX}px' ypos='0'></nonbutton>"
CALL LAYOUT_IMG_TEXT(IMG_HTML, IMG_H_PX, IMG_W_PX, FONTCOLOR, HTML_TEXT, AUTO_FMT)

;-------------------------------------------------
; 衍生函数：QOL_SPTALK (立绘表情对话)
; デフォルト是路人角色使用的硬编码索引值，因为这个函数是路人立绘系统的配套函数，对于角色而言无意义
;-------------------------------------------------
@QOL_SPTALK(CID, 表情="通常", デフォルト=0, MESSAGE="", 整形=1, CUSTOMFONTCOLOR="", エフェクト="", EFFECT_OVERRIDE=0)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM  DYNAMIC CID
#DIMS DYNAMIC 表情
#DIM  DYNAMIC デフォルト
#DIMS DYNAMIC MESSAGE
#DIM  DYNAMIC 整形
#DIMS DYNAMIC CUSTOMFONTCOLOR
#DIMS DYNAMIC エフェクト
#DIM  DYNAMIC EFFECT_OVERRIDE

#DIMS DYNAMIC 服装
#DIMS DYNAMIC RES_NAME
#DIM  DYNAMIC PREV_立ち絵種類
#DIMS DYNAMIC IMG_HTML
#DIMS DYNAMIC FONTCOLOR
#DIM  DYNAMIC IMG_H_PX
#DIM  DYNAMIC IMG_W_PX

PREV_立ち絵種類 = FLAG:立ち絵種類

IF 顔絵付きメッセージ == 1
	; 拆解服装与表情标签
	服装 '= SPLIT_SINGLE(表情, 1)
	表情 '= SPLIT_SINGLE(表情)
	SIF 表情 == ""
		表情 '= "通常"

	; -- 处理有名角色 --
	IF CID > 0
		SIF !STRLENS(服装)
			服装 '= デフォルト == 1 ? "服" # ""
			
		FLAG:立ち絵種類 = 1
		IF TALENT:CID:行きずり && !GCREATED(CFLAG:CID:路人子素材CFLAG開始位置)
			CALL 路人子生成(CID, 0)
			CALL 路人子生成(CID, 1)
		ENDIF
		
		; -- 构建图像 HTML + 解析口上色 + 排版 --
		IMG_H_PX = (默认角色画像横幅 * 角色画像表示尺寸比) / 100
		CALL BUILD_FIGURE_HTML(CID, 表情, 服装, "", エフェクト, "顔絵", -1, EFFECT_OVERRIDE)
		IMG_HTML '= RESULTS
		IMG_H_PX = RESULT
		
		; 解析口上色
		CALL RESOLVE_KOJO_COLOR(CID, CUSTOMFONTCOLOR)
		FONTCOLOR '= RESULTS
		
		; 获取底图资源名以计算宽度
		CALL GET_BASE_RESOURCE(CID, "顔絵", 服装, 表情)
		RES_NAME '= RESULT ? RESULTS # @"%GET_BASESTYLE(CID, "顔絵")%_服_通常_{CID}"
		IMG_W_PX = SPRITEWIDTH(RES_NAME) * IMG_H_PX / SPRITEHEIGHT(RES_NAME)
		
		CALL LAYOUT_IMG_TEXT(IMG_HTML, IMG_H_PX, IMG_W_PX, FONTCOLOR, MESSAGE, 整形)
		
	; -- 处理路人/店员 (MOB) --
	ELSE
		SIF !STRLENS(服装)
			服装 '= "服"

		; -- 构建图像 HTML + 解析口上色 + 排版 --
		IMG_H_PX = (默认角色画像横幅 * 角色画像表示尺寸比) / 100
		CALL BUILD_FIGURE_HTML(-1, 表情, 服装, TOSTR(デフォルト), エフェクト, "顔絵", -1, EFFECT_OVERRIDE)
		IMG_HTML '= RESULTS
		IMG_H_PX = RESULT
		
		; MOB 口上色
		IF CUSTOMFONTCOLOR != ""
			FONTCOLOR '= CUSTOMFONTCOLOR
			SIF !HTMLCCHK(FONTCOLOR)
				FONTCOLOR '= HEX_TO_HTML_COLOR()
		ELSEIF デフォルト == 90
			FONTCOLOR '= "#C8C9CF"
		ELSEIF デフォルト == 95
			FONTCOLOR '= "#D37CD0"
		ELSE
			FONTCOLOR '= "#" + TOSTR(路人子店員口上色:デフォルト, "X6")
		ENDIF
		
		RES_NAME '= @"顔絵_%服装%_%表情%_MOB_{デフォルト}"
		SIF !SPRITECREATED(RES_NAME)
			CALL 路人店員画像作成(デフォルト)
		IMG_W_PX = SPRITEWIDTH(RES_NAME) * IMG_H_PX / SPRITEHEIGHT(RES_NAME)
		
		CALL LAYOUT_IMG_TEXT(IMG_HTML, IMG_H_PX, IMG_W_PX, FONTCOLOR, MESSAGE, 整形)
	ENDIF
	
	FLAG:立ち絵種類 = PREV_立ち絵種類
ELSE
	CALL IMG_TALK("", MESSAGE, CID, 0, 100, CUSTOMFONTCOLOR)
ENDIF

;-------------------------------------------------
; 统一排版：LAYOUT_IMG_TEXT
; 概  要：图文混排唯一底层——图像块+文本→并排HTML→打印+换行
;         IMG_TALK 与 QOL_SPTALK 均通过本函数完成最终排版输出
; 参  数：
;   IMG_HTML  : 图像HTML块（<nonbutton><img ...></nonbutton> 或 <button>...</button>）
;   IMG_H_PX  : 图像高度（像素）
;   IMG_W_PX  : 图像宽度（像素）
;   FONTCOLOR : 字体颜色（#RRGGBB 格式）
;   TEXT      : 文本内容（HTML 或纯文本）
;   AUTO_FMT  : 是否开启自动垂直居中整形 (默认1)
;引　用：IMG_TALK, QOL_SPTALK
;-------------------------------------------------
@LAYOUT_IMG_TEXT(IMG_HTML, IMG_H_PX, IMG_W_PX, FONTCOLOR, TEXT, AUTO_FMT = 1)
#DIMS DYNAMIC IMG_HTML
#DIM  DYNAMIC IMG_H_PX
#DIM  DYNAMIC IMG_W_PX
#DIMS DYNAMIC FONTCOLOR
#DIMS DYNAMIC TEXT
#DIM  DYNAMIC AUTO_FMT
#DIM  DYNAMIC LINE_H
#DIM  DYNAMIC ACTUAL_LINES
#DIM  DYNAMIC PADDING_TOP
#DIM  DYNAMIC DIV_W_PX
#DIMS DYNAMIC HTML_STR

LINE_H = GETCONFIG("一行の高さ")
DIV_W_PX = CLIENTWIDTH() - IMG_W_PX - 30

IF AUTO_FMT
	ACTUAL_LINES = STRCOUNT(TEXT, "<br>") + 1
	PADDING_TOP = MAX(0, (IMG_H_PX - ACTUAL_LINES * LINE_H) / 2)
ELSE
	PADDING_TOP = 0
ENDIF

HTML_STR '= IMG_HTML
HTML_STR += @"<div xpos='{20}px' ypos='0px' width='{DIV_W_PX}px' height='{IMG_H_PX}px' padding='{PADDING_TOP}px, 0, 0, 0'>"
HTML_STR += @"<font color='%FONTCOLOR%'>%TEXT%</font>"
HTML_STR += @"</div>"
HTML_PRINT HTML_STR

FOR LOCAL, 0, (IMG_H_PX / LINE_H)
	PRINTL
NEXT

;-------------------------------------------------
; 工具函数：CONVERT_STR_TO_HTML
; 概  述：将@PRINT_STR 专用的 @ 语法分割文本，转译为标准 HTML 标签
; 返回值：纯 HTML 文本
;-------------------------------------------------
@CONVERT_STR_TO_HTML(ARGS)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTIONS
#DIMS DYNAMIC L_TOKENS, 300
#DIM  DYNAMIC L_TOKEN_CNT
#DIMS DYNAMIC RES
#DIMS DYNAMIC TAG_OPEN
#DIMS DYNAMIC TAG_CLOSE
#DIMS DYNAMIC L_PARAMS, 5
#DIM  DYNAMIC L_COLOR

ARGS '= REPLACE(ARGS, "/", "<br>")
SPLIT ARGS, "@", L_TOKENS, L_TOKEN_CNT

FOR LOCAL, 0, L_TOKEN_CNT
	SELECTCASE L_TOKENS:LOCAL
		CASE "CALLNAME:TARGET"
			RES += CALLNAME:TARGET + TAG_CLOSE
			TAG_CLOSE '= ""
			CONTINUE
		CASE "CALLNAME:PLAYER"
			RES += CALLNAME:PLAYER + TAG_CLOSE
			TAG_CLOSE '= ""
			CONTINUE
		CASE "CALLNAME:ASSI"
			RES += CALLNAME:ASSI + TAG_CLOSE
			TAG_CLOSE '= ""
			CONTINUE
		CASE "CALLNAME:MASTER"
			RES += CALLNAME:MASTER + TAG_CLOSE
			TAG_CLOSE '= ""
			CONTINUE
			
		; --- 按钮控制 ---
		CASE "BUTTON"
			LOCAL++
			RES += @"<button value='%L_TOKENS:LOCAL%'>%L_TOKENS:LOCAL%</button>" + TAG_CLOSE
			TAG_CLOSE '= ""
			CONTINUE
		CASE "BUTTONS"
			LOCAL++
			SPLIT L_TOKENS:LOCAL, "|", L_PARAMS
			RES += @"<button value='%L_PARAMS:1%'>%L_PARAMS:0%</button>" + TAG_CLOSE
			TAG_CLOSE '= ""
			CONTINUE
		CASE "BUTTONNUM"
			LOCAL++
			SPLIT L_TOKENS:LOCAL, "|", L_PARAMS
			RES += @"<button value='%L_PARAMS:1%'>%L_PARAMS:0%</button>" + TAG_CLOSE
			TAG_CLOSE '= ""
			CONTINUE
		CASE "NOBUTTON"
			LOCAL++
			RES += L_TOKENS:LOCAL + TAG_CLOSE
			TAG_CLOSE '= ""
			CONTINUE
			
		; --- 样式与颜色 ---
		CASE "-", "STRIKE"
			RES += "<s>"
			TAG_CLOSE '= "</s>" + TAG_CLOSE
			CONTINUE
		CASE "L"
			RES += "<br>" + TAG_CLOSE
			TAG_CLOSE '= ""
			CONTINUE
		CASE "W", "WAIT", "FORCEWAIT"
			; HTML内联不支持等待指令，直接忽略
			CONTINUE
		CASE "H", "HEART", "HPH"
			RES += "<font color='#FFC0CB'>&#x2764;</font>" + TAG_CLOSE
			TAG_CLOSE '= ""
			CONTINUE
		CASE "／／／", "BPB"
			RES += "///" + TAG_CLOSE
			TAG_CLOSE '= ""
			CONTINUE
		CASE "RGB"
			LOCAL++
			SPLIT L_TOKENS:LOCAL, "//", L_PARAMS
			L_COLOR = TOINT(L_PARAMS:0)*65536 + TOINT(L_PARAMS:1)*256 + TOINT(L_PARAMS:2)
			RES += @"<font color='#%TOSTR(L_COLOR, "X6")%'>"
			TAG_CLOSE '= "</font>" + TAG_CLOSE
			CONTINUE
		CASE "HEX"
			LOCAL++
			RES += @"<font color='#%TOSTR(TOINT(L_TOKENS:LOCAL), "X6")%'>"
			TAG_CLOSE '= "</font>" + TAG_CLOSE
			CONTINUE
		CASE "Ｂ", "BOLD"
			RES += "<b>"
			TAG_CLOSE '= "</b>" + TAG_CLOSE
			CONTINUE
		CASE "UNDER"
			RES += "<u>"
			TAG_CLOSE '= "</u>" + TAG_CLOSE
			CONTINUE
		CASE "ITALIC"
			RES += "<i>"
			TAG_CLOSE '= "</i>" + TAG_CLOSE
			CONTINUE
	ENDSELECT

	RES += L_TOKENS:LOCAL + TAG_CLOSE
	TAG_CLOSE '= ""
NEXT

RETURNF RES

