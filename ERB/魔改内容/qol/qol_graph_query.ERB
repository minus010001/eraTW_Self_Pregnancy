;================================================
;@MOVEMENT_DISTANCE(START_POSITION, END_POSITION)
;查询据点内两点间的最短距离。
;参数：START_POSITION = 出发地地点ID, END_POSITION = 目的地地点ID
;返回值：最短跳数（不可达返回 -1，原地返回 0，跨据点返回 -1）
;================================================
@MOVEMENT_DISTANCE(START_POSITION, END_POSITION)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC START_POSITION
#DIM DYNAMIC END_POSITION
#DIM DYNAMIC L_MAPID
#DIM DYNAMIC L_DIST

SIF START_POSITION == END_POSITION
	RETURNF 0

SIF GET_MAPID(START_POSITION) != GET_MAPID(END_POSITION)
	RETURNF -1

L_MAPID = GET_MAPID(START_POSITION)
L_DIST = SQL_P_EXECUTE_SCALAR_LONG(GRAPH_DB_NAME, "SELECT distance FROM GRAPH_DISTANCE WHERE map_id = @0 AND source = @1 AND target = @2", TOSTR(L_MAPID), TOSTR(START_POSITION % 100), TOSTR(END_POSITION % 100))

SIF L_DIST <= 0 || L_DIST == GRAPH_UNREACHABLE
	RETURNF -1

RETURNF L_DIST

;================================================
;@MOVEMENT_NEXT_LOCATIONS(START_POSITION, END_POSITION)
;查询据点内从出发地到目的地的完整路径。
;参数：START_POSITION = 出发地地点ID, END_POSITION = 目的地地点ID
;返回值：RESULT:0 = 第1步地点ID, RESULT:1 = 第2步, ..., 不可达时 RESULT:0 = -1
;
; 路径回溯算法：
;   1. 从终点沿 previous 链向前回溯
;   2. 每步将当前节点写入 RESULT:(distance-1)
;   3. 回溯到源节点时停止
;   4. RESULT 按步数排列：RESULT:0=第1步, RESULT:(dist-1)=终点
;   起点不在 RESULT 中。
;================================================
@MOVEMENT_NEXT_LOCATIONS(START_POSITION, END_POSITION)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC START_POSITION
#DIM DYNAMIC END_POSITION
#DIM DYNAMIC L_MAPID
#DIM DYNAMIC L_SOURCE_IDX
#DIM DYNAMIC L_CURRENT_IDX
#DIM DYNAMIC L_PREV_IDX
#DIM DYNAMIC L_DIST
;前驱数组（从 SQL 批量加载）
#DIM DYNAMIC L_PREV_ARR, GRAPH_NODE_MAX
;距离数组（从 SQL 批量加载）
#DIM DYNAMIC L_DIST_ARR, GRAPH_NODE_MAX
#DIM DYNAMIC L_READER

VARSET RESULT, -1

SIF START_POSITION == END_POSITION
	RETURNF START_POSITION

SIF GET_MAPID(START_POSITION) != GET_MAPID(END_POSITION)
	RETURNF -1

L_MAPID = GET_MAPID(START_POSITION)
L_SOURCE_IDX = START_POSITION % 100

;批量加载：一次 SQL 读取源节点的所有可达目标
VARSET L_PREV_ARR, -1
VARSET L_DIST_ARR, -1
L_READER = SQL_P_EXECUTE_READER(GRAPH_DB_NAME, "SELECT target, distance, previous FROM GRAPH_DISTANCE WHERE map_id = @0 AND source = @1 AND distance != @2", TOSTR(L_MAPID), TOSTR(L_SOURCE_IDX), TOSTR(GRAPH_UNREACHABLE))
WHILE SQL_READER_READ(L_READER)
	L_CURRENT_IDX = SQL_READER_GET_LONG(L_READER, 0)
	L_DIST_ARR:L_CURRENT_IDX = SQL_READER_GET_LONG(L_READER, 1)
	L_PREV_ARR:L_CURRENT_IDX = SQL_READER_GET_LONG(L_READER, 2)
WEND
SQL_READER_CLOSE L_READER

;从终点回溯到起点
L_CURRENT_IDX = END_POSITION % 100
L_DIST = L_DIST_ARR:L_CURRENT_IDX

SIF L_DIST < 0 || L_DIST == -1
	RETURNF -1

WHILE 1
	L_PREV_IDX = L_PREV_ARR:L_CURRENT_IDX
	SIF L_PREV_IDX == -1
		RETURNF -1
	RESULT:(L_DIST - 1) = L_MAPID * 100 + L_CURRENT_IDX
	L_DIST--
	SIF L_PREV_IDX == L_SOURCE_IDX
		BREAK
	L_CURRENT_IDX = L_PREV_IDX
WEND

RETURNF RESULT

;================================================
;@MOVEMENT_CROSS_MAP_DISTANCE(FROM_MAP, TO_MAP, ALLOW_DANGEROUS)
;查询跨地图旅行时间。
;参数：FROM_MAP = 出发据点MAPID, TO_MAP = 目标据点MAPID, ALLOW_DANGEROUS = 是否允许危险路线
;返回值：旅行时间（分钟），不可达返回 -1
;RESULT:1 = 是否危险路线（1=危险）
;RESULT:2 = 安全路线时间（分钟）
;================================================
@MOVEMENT_CROSS_MAP_DISTANCE(FROM_MAP, TO_MAP, ALLOW_DANGEROUS)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC FROM_MAP
#DIM DYNAMIC TO_MAP
#DIM DYNAMIC ALLOW_DANGEROUS
#DIM DYNAMIC L_SAFE_TIME
#DIM DYNAMIC L_DANGER_TIME
#DIM DYNAMIC L_READER

RESULT:1 = 0
RESULT:2 = 0

SIF FROM_MAP == TO_MAP
	RETURNF 0

L_READER = SQL_P_EXECUTE_READER(GRAPH_DB_NAME, "SELECT safe_time, danger_time FROM GRAPH_CROSS_MAP_EDGE WHERE from_map = @0 AND to_map = @1", TOSTR(FROM_MAP), TOSTR(TO_MAP))
SIF !SQL_READER_READ(L_READER)
	SQL_READER_CLOSE L_READER
	RETURNF -1

L_SAFE_TIME = SQL_READER_GET_LONG(L_READER, 0)
L_DANGER_TIME = SQL_READER_GET_LONG(L_READER, 1)
SQL_READER_CLOSE L_READER

RESULT:2 = L_SAFE_TIME

SIF ALLOW_DANGEROUS && L_DANGER_TIME >= 0
	RESULT:1 = 1
	RETURNF L_DANGER_TIME

RETURNF L_SAFE_TIME

;================================================
;@MOVEMENT_NEAREST_VALID(ARG, MINIMUM_DISTANCE)
;查找距角色最近的、角色愿意前往的地点。
;参数：ARG = 角色登记编号, MINIMUM_DISTANCE = 最小距离阈值（默认 1）
;返回值：地点ID（找不到返回 ENTRANCE）
;
; 算法：
;   1. 从 SQL 读取当前据点内从角色位置到所有目标的距离
;   2. 按距离排序（ARRAYMSORT 同时排序距离和节点数组）
;   3. 逐个检查角色是否愿意前往（MOVEMENT_WILLING）
;   4. 返回第一个愿意前往的地点
;================================================
@MOVEMENT_NEAREST_VALID(ARG, MINIMUM_DISTANCE = 1)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC MINIMUM_DISTANCE
;节点ID数组（与 L_DISTANCES 同步排序）
#DIM DYNAMIC L_NODES, GRAPH_NODE_MAX
;距离数组（排序后按距离从近到远排列）
#DIM DYNAMIC L_DISTANCES, GRAPH_NODE_MAX
#DIM DYNAMIC L_MAPID
#DIM DYNAMIC L_CURRENT_IDX
#DIM DYNAMIC L_READER
#DIM DYNAMIC L_I

L_MAPID = GET_MAPID(CFLAG:ARG:現在位置)
L_CURRENT_IDX = CFLAG:ARG:現在位置 % 100

VARSET L_DISTANCES, GRAPH_UNREACHABLE
L_READER = SQL_P_EXECUTE_READER(GRAPH_DB_NAME, "SELECT target, distance FROM GRAPH_DISTANCE WHERE map_id = @0 AND source = @1 AND distance != @2", TOSTR(L_MAPID), TOSTR(L_CURRENT_IDX), TOSTR(GRAPH_UNREACHABLE))
WHILE SQL_READER_READ(L_READER)
	L_I = SQL_READER_GET_LONG(L_READER, 0)
	L_NODES:L_I = L_MAPID * 100 + L_I
	L_DISTANCES:L_I = SQL_READER_GET_LONG(L_READER, 1)
WEND
SQL_READER_CLOSE L_READER

ARRAYMSORT L_DISTANCES, L_NODES

FOR L_I, 0, GRAPH_NODE_MAX
	SIF L_DISTANCES:L_I < MINIMUM_DISTANCE
		CONTINUE
	SIF L_DISTANCES:L_I == GRAPH_UNREACHABLE
		BREAK
	CALL MOVEMENT_WILLING(ARG, L_NODES:L_I)
	SIF RESULT
		RETURN L_NODES:L_I
NEXT

RETURN GET_ENTRANCE(L_MAPID)

;================================================
;@MOVEMENT_WILLING(ARG, LOCATION)
;判定角色是否愿意前往指定地点。
;参数：ARG = 角色登记编号, LOCATION = 目标地点ID
;返回值：1 = 愿意, 0 = 不愿意
;
; 逻辑：
;   1. 先尝试 KOJO_CHECK（角色自定义口上数据）
;   2. KOJO_CHECK 失败则调用 CHARAMOVE_DATA_{NO:ARG}（角色默认移动数据）
;   3. 停留率 > -100 且 MAP_CAN_MOVE 通过则愿意
;================================================
@MOVEMENT_WILLING(ARG, LOCATION)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC LOCATION

RESULT = 0
RESULT:1 = 0

IF ARG > 0
	CALL KOJO_CHECK(ARG, "CHARADATA", "MOVE", 4, LOCATION)
	IF RESULT
		RESULT = RESULT:1
	ELSE
		CALLFORM CHARAMOVE_DATA_{NO:ARG}(4, LOCATION)
	ENDIF
ENDIF

SIF RESULT > -100 && MAP_CAN_MOVE(LOCATION, ARG)
	RETURN 1

;================================================
;@GRAPH_VISIBLE_FROM(PLACE)
;查询哪些地点可以看到指定地点（谁在看我）。
;参数：PLACE = 地点ID
;返回值：RESULT:0~N = 可以看到 PLACE 的地点ID列表，-1 结尾
;================================================
@GRAPH_VISIBLE_FROM(PLACE)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC PLACE
#DIM DYNAMIC L_MAPID
#DIM DYNAMIC L_READER
#DIM DYNAMIC L_I
#DIM DYNAMIC L_RESULT, GRAPH_NODE_MAX

L_MAPID = GET_MAPID(PLACE)
VARSET L_RESULT, -1
L_I = 0

L_READER = SQL_P_EXECUTE_READER(GRAPH_DB_NAME, "SELECT from_node FROM GRAPH_EDGE WHERE map_id = @0 AND to_node = @1 AND can_see = 1", TOSTR(L_MAPID), TOSTR(PLACE % 100))
WHILE SQL_READER_READ(L_READER)
	L_RESULT:L_I = L_MAPID * 100 + SQL_READER_GET_LONG(L_READER, 0)
	L_I++
WEND
SQL_READER_CLOSE L_READER

VARSET RESULT, -1
FOR L_I, 0, GRAPH_NODE_MAX
	SIF L_RESULT:L_I < 0
		BREAK
	RESULT:L_I = L_RESULT:L_I
NEXT

;================================================
;@GRAPH_CAN_SEE_FROM(PLACE)
;查询从指定地点可以看到哪些地点（我能看到谁）。
;参数：PLACE = 地点ID
;返回值：RESULT:0~N = 从 PLACE 可以看到的地点ID列表，-1 结尾
;        返回值（#FUNCTION）= 可见地点数量
;用途：QOL_DISTANT_WATCHERS 远处观察者显示
;================================================
@GRAPH_CAN_SEE_FROM(PLACE)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC PLACE
#DIM DYNAMIC L_MAPID
#DIM DYNAMIC L_READER
#DIM DYNAMIC L_I
#DIM DYNAMIC L_J
#DIM DYNAMIC L_RESULT, GRAPH_NODE_MAX

L_MAPID = GET_MAPID(PLACE)
VARSET L_RESULT, -1
L_I = 0

L_READER = SQL_P_EXECUTE_READER(GRAPH_DB_NAME, "SELECT to_node FROM GRAPH_EDGE WHERE map_id = @0 AND from_node = @1 AND can_see = 1", TOSTR(L_MAPID), TOSTR(PLACE % 100))
WHILE SQL_READER_READ(L_READER)
	L_RESULT:L_I = L_MAPID * 100 + SQL_READER_GET_LONG(L_READER, 0)
	L_I++
WEND
SQL_READER_CLOSE L_READER

VARSET RESULT, -1
FOR L_J, 0, L_I
	RESULT:L_J = L_RESULT:L_J
NEXT

RETURNF L_I

;================================================
;@GRAPH_NODE_EXISTS(PLACE)
;检查地点是否在寻路图中存在（有至少一条移动边）。
;参数：PLACE = 地点ID
;返回值：1 = 存在且有邻居, 0 = 不存在或无邻居
;================================================
@GRAPH_NODE_EXISTS(PLACE)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC PLACE
#DIM DYNAMIC L_COUNT

L_COUNT = SQL_P_EXECUTE_SCALAR_LONG(GRAPH_DB_NAME, "SELECT COUNT(*) FROM GRAPH_EDGE WHERE map_id = @0 AND from_node = @1 AND can_move = 1", TOSTR(GET_MAPID(PLACE)), TOSTR(PLACE % 100))
RETURNF L_COUNT > 0

;================================================
;@GRAPH_DB_DEBUG_DUMP
;调试用：打印所有寻路数据表的统计信息。
;================================================
@GRAPH_DB_DEBUG_DUMP
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC L_READER
#DIM DYNAMIC L_COUNT

PRINTL ===== GRAPH_DB DEBUG DUMP =====

L_COUNT = SQL_P_EXECUTE_SCALAR_LONG(GRAPH_DB_NAME, "SELECT COUNT(*) FROM GRAPH_EDGE")
PRINTFORML GRAPH_EDGE: {L_COUNT} rows

L_COUNT = SQL_P_EXECUTE_SCALAR_LONG(GRAPH_DB_NAME, "SELECT COUNT(*) FROM GRAPH_DISTANCE WHERE distance != @0", TOSTR(GRAPH_UNREACHABLE))
PRINTFORML GRAPH_DISTANCE (reachable): {L_COUNT} rows

L_COUNT = SQL_P_EXECUTE_SCALAR_LONG(GRAPH_DB_NAME, "SELECT COUNT(*) FROM GRAPH_CROSS_MAP_EDGE")
PRINTFORML GRAPH_CROSS_MAP_EDGE: {L_COUNT} rows

L_COUNT = SQL_P_EXECUTE_SCALAR_LONG(GRAPH_DB_NAME, "SELECT COUNT(*) FROM GRAPH_NODE_ATTR")
PRINTFORML GRAPH_NODE_ATTR: {L_COUNT} rows

PRINTL ===== PER-MAP EDGE COUNT =====
L_READER = SQL_EXECUTE_READER(GRAPH_DB_NAME, "SELECT map_id, COUNT(*) FROM GRAPH_EDGE WHERE can_move = 1 GROUP BY map_id ORDER BY map_id")
WHILE SQL_READER_READ(L_READER)
	PRINTFORML MAP {SQL_READER_GET_LONG(L_READER, 0)}: {SQL_READER_GET_LONG(L_READER, 1)} move edges
WEND
SQL_READER_CLOSE L_READER

PRINTL ===== CROSS-MAP EDGES =====
L_READER = SQL_EXECUTE_READER(GRAPH_DB_NAME, "SELECT from_map, to_map, safe_time, danger_time FROM GRAPH_CROSS_MAP_EDGE ORDER BY from_map, to_map")
WHILE SQL_READER_READ(L_READER)
	PRINTFORML MAP {SQL_READER_GET_LONG(L_READER, 0)} → MAP {SQL_READER_GET_LONG(L_READER, 1)}: safe={SQL_READER_GET_LONG(L_READER, 2)}min danger={SQL_READER_GET_LONG(L_READER, 3)}min
WEND
SQL_READER_CLOSE L_READER

PRINTL ===== DONE =====

;================================================
;@连通性遍历
;调试用：遍历当前据点所有地点对，打印距离。
;================================================
@连通性遍历
#LOCALSIZE 3
#LOCALSSIZE 1
FOR LOCAL:0, MAIN_MAP*100, MAXROOM
	SIF NAME_FROM_PLACE(LOCAL:0) == ""
		CONTINUE
	FOR LOCAL:1, LOCAL:0 + 1, MAXROOM
		SIF NAME_FROM_PLACE(LOCAL:1) == ""
			CONTINUE
		LOCAL:2 = MOVEMENT_DISTANCE(LOCAL:0, LOCAL:1)
		PRINTFORML %NAME_FROM_PLACE(LOCAL:1)%{LOCAL:1}到%NAME_FROM_PLACE(LOCAL:0)%{LOCAL:0}的距离是{LOCAL:2}
		SIF LOCAL:2 < 1
			WAIT
		AWAIT
	NEXT
NEXT
