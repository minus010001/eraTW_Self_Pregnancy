;
;Module   :qol_graph_build.ERB
;Facility :据点内邻接表构建——从 CAN_MOVE_X 提取边写入 GRAPH_EDGE
;Licence  :许可证自由(CC0)。
;
; 本模块遍历指定据点的所有节点对，调用 CAN_MOVE 获取连通性，
; 将可移动边（bit 0）和可见边（bit 1）写入 GRAPH_EDGE 表。
;
; CAN_MOVE 语义：
;   bit 0 = 可移动（结构连通性，静态）
;   bit 1 = 可见（结构可见性，静态）
;   返回值 0 = 不可移动不可见, 1 = 可移动不可见, 2 = 不可移动可见, 3 = 可移动可见
;
; 注意：CAN_MOVE 只反映静态结构连通性。运行时条件准入（营业时间/角色关系等）
;       由 MAP_CAN_MOVE / MAP_COMM_X 处理，不参与图构建。
;
;_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/#

;================================================
;@GRAPH_DB_BUILD_MAP(MAPID)
;构建指定据点的邻接表，写入 GRAPH_EDGE。
;双重循环遍历所有节点对，调用 CAN_MOVE 获取连通性。
;参数：MAPID = 据点编号（0-11）
;================================================
@GRAPH_DB_BUILD_MAP(MAPID)
#DIM MAPID
#DIM L_SOURCE
#DIM L_DEST
#DIM L_RESULT

FOR L_SOURCE, MAPID * 100 + 1, (MAPID + 1) * 100
	SIF STR:(8000 + L_SOURCE) == "" && L_SOURCE != MAXROOM
		CONTINUE
	FOR L_DEST, MAPID * 100 + 1, (MAPID + 1) * 100
		SIF L_SOURCE == L_DEST
			CONTINUE
		SIF STR:(8000 + L_DEST) == ""
			CONTINUE
		L_RESULT = CAN_MOVE(L_SOURCE, L_DEST)
		SIF !L_RESULT
			CONTINUE
		SQL_P_EXECUTE_NONQUERY GRAPH_DB_NAME, "INSERT OR REPLACE INTO GRAPH_EDGE (map_id, from_node, to_node, can_move, can_see) VALUES (@0, @1, @2, @3, @4)", TOSTR(MAPID), TOSTR(L_SOURCE % 100), TOSTR(L_DEST % 100), TOSTR(GETBIT(L_RESULT, 0)), TOSTR(GETBIT(L_RESULT, 1))
	NEXT
NEXT
