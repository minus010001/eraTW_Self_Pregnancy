@QOL_DISH_INIT
#LOCALSIZE 2
#LOCALSSIZE 1
IF !MAP_EXIST("QOL_DISH_NAMES")
	MAP_CREATE "QOL_DISH_NAMES"
ENDIF
IF !MAP_EXIST("QOL_DISH_TASTES")
	MAP_CREATE "QOL_DISH_TASTES"
ENDIF
IF !MAP_EXIST("QOL_DISH_COMMENTS")
	MAP_CREATE "QOL_DISH_COMMENTS"
ENDIF
IF !MAP_EXIST("QOL_DISH_INGREDIENTS")
	MAP_CREATE "QOL_DISH_INGREDIENTS"
ENDIF
IF !MAP_EXIST("QOL_DISH_TYPES")
	MAP_CREATE "QOL_DISH_TYPES"
ENDIF
IF !MAP_EXIST("QOL_DISH_TIMES")
	MAP_CREATE "QOL_DISH_TIMES"
ENDIF
IF !MAP_EXIST("QOL_DISH_MAXLIMITS")
	MAP_CREATE "QOL_DISH_MAXLIMITS"
ENDIF
IF !MAP_EXIST("QOL_DISH_SKILL_LVS")
	MAP_CREATE "QOL_DISH_SKILL_LVS"
ENDIF
IF !DT_EXIST("QOL_DISH_DB")
	DT_CREATE "QOL_DISH_DB"
	DT_COLUMN_ADD "QOL_DISH_DB", "dish_id", "int32"
	DT_COLUMN_ADD "QOL_DISH_DB", "dish_name", "string"
	DT_COLUMN_ADD "QOL_DISH_DB", "dish_taste", "string"
	DT_COLUMN_ADD "QOL_DISH_DB", "dish_comment", "string"
	DT_COLUMN_ADD "QOL_DISH_DB", "dish_ing", "string"
	DT_COLUMN_ADD "QOL_DISH_DB", "dish_time", "int32"
	DT_COLUMN_ADD "QOL_DISH_DB", "dish_maxlimit", "int32"
	DT_COLUMN_ADD "QOL_DISH_DB", "typecheck", "string"
	DT_COLUMN_ADD "QOL_DISH_DB", "skill_lv", "int32"
	CALL QOL_DISH_LOAD_XML
	SIF DT_ROW_LENGTH("QOL_DISH_DB") == 0
		CALL QOL_DISH_DATA_REGISTER
ENDIF

@QOL_DISH_LOAD_XML
#LOCALSIZE 3
#LOCALSSIZE 1
#DIMS DYNAMIC schema
#DIMS DYNAMIC data_xml
#DIMS DYNAMIC map_data
schema '= LOADTEXT("plugins/QOL/qol_dish_schema.xml")
data_xml '= LOADTEXT("plugins/QOL/qol_dish_data.xml")
SIF STRLENS(data_xml) == 0
	RETURN
DT_FROMXML "QOL_DISH_DB", schema, data_xml
map_data '= LOADTEXT("plugins/QOL/qol_dish_names.xml")
SIF STRLENS(map_data)
	MAP_FROMXML "QOL_DISH_NAMES", map_data
map_data '= LOADTEXT("plugins/QOL/qol_dish_tastes.xml")
SIF STRLENS(map_data)
	MAP_FROMXML "QOL_DISH_TASTES", map_data
map_data '= LOADTEXT("plugins/QOL/qol_dish_comments.xml")
SIF STRLENS(map_data)
	MAP_FROMXML "QOL_DISH_COMMENTS", map_data
map_data '= LOADTEXT("plugins/QOL/qol_dish_ingredients.xml")
SIF STRLENS(map_data)
	MAP_FROMXML "QOL_DISH_INGREDIENTS", map_data
map_data '= LOADTEXT("plugins/QOL/qol_dish_types.xml")
SIF STRLENS(map_data)
	MAP_FROMXML "QOL_DISH_TYPES", map_data
map_data '= LOADTEXT("plugins/QOL/qol_dish_times.xml")
SIF STRLENS(map_data)
	MAP_FROMXML "QOL_DISH_TIMES", map_data
map_data '= LOADTEXT("plugins/QOL/qol_dish_maxlimits.xml")
SIF STRLENS(map_data)
	MAP_FROMXML "QOL_DISH_MAXLIMITS", map_data
map_data '= LOADTEXT("plugins/QOL/qol_dish_skill_lvs.xml")
SIF STRLENS(map_data)
	MAP_FROMXML "QOL_DISH_SKILL_LVS", map_data
SIF MAP_SIZE("QOL_DISH_NAMES") > 0
	RETURN
FOR LOCAL, 0, DT_ROW_LENGTH("QOL_DISH_DB")
	LOCAL:1 = DT_CELL_GET("QOL_DISH_DB", LOCAL, "dish_id", 0)
	LOCALS '= DT_CELL_GETS("QOL_DISH_DB", LOCAL, "dish_name", 0)
	SIF STRLENS(LOCALS)
		MAP_SET "QOL_DISH_NAMES", TOSTR(LOCAL:1), LOCALS
	LOCALS '= DT_CELL_GETS("QOL_DISH_DB", LOCAL, "dish_taste", 0)
	SIF STRLENS(LOCALS)
		MAP_SET "QOL_DISH_TASTES", TOSTR(LOCAL:1), LOCALS
	LOCALS '= DT_CELL_GETS("QOL_DISH_DB", LOCAL, "dish_comment", 0)
	SIF STRLENS(LOCALS)
		MAP_SET "QOL_DISH_COMMENTS", TOSTR(LOCAL:1), LOCALS
	LOCALS '= DT_CELL_GETS("QOL_DISH_DB", LOCAL, "dish_ing", 0)
	SIF STRLENS(LOCALS)
		MAP_SET "QOL_DISH_INGREDIENTS", TOSTR(LOCAL:1), LOCALS
	LOCALS '= DT_CELL_GETS("QOL_DISH_DB", LOCAL, "typecheck", 0)
	SIF STRLENS(LOCALS)
		MAP_SET "QOL_DISH_TYPES", TOSTR(LOCAL:1), LOCALS
	LOCALS '= DT_CELL_GETS("QOL_DISH_DB", LOCAL, "dish_time", 0)
	SIF STRLENS(LOCALS) && TOINT(LOCALS) > 0
		MAP_SET "QOL_DISH_TIMES", TOSTR(LOCAL:1), LOCALS
	LOCALS '= DT_CELL_GETS("QOL_DISH_DB", LOCAL, "dish_maxlimit", 0)
	SIF STRLENS(LOCALS) && TOINT(LOCALS) > 0
		MAP_SET "QOL_DISH_MAXLIMITS", TOSTR(LOCAL:1), LOCALS
	LOCALS '= DT_CELL_GETS("QOL_DISH_DB", LOCAL, "skill_lv", 0)
	SIF STRLENS(LOCALS) && TOINT(LOCALS) > 0
		MAP_SET "QOL_DISH_SKILL_LVS", TOSTR(LOCAL:1), LOCALS
NEXT

@QOL_DISH_DATA_SET(DISH_ID, DISH_NAME_ARG, DISH_TASTE_ARG, DISH_COMMENT_ARG, DISH_ING_ARG, DISH_TIME_ARG, DISH_MAXLIMIT_ARG, TYPECHECK_ARG, SKILL_LV_ARG)
#LOCALSIZE 2
#LOCALSSIZE 1
#DIM DYNAMIC DISH_ID
#DIMS DYNAMIC DISH_NAME_ARG
#DIMS DYNAMIC DISH_TASTE_ARG
#DIMS DYNAMIC DISH_COMMENT_ARG
#DIMS DYNAMIC DISH_ING_ARG
#DIM DYNAMIC DISH_TIME_ARG
#DIM DYNAMIC DISH_MAXLIMIT_ARG
#DIMS DYNAMIC TYPECHECK_ARG
#DIM DYNAMIC SKILL_LV_ARG
#DIM DYNAMIC HIT_ROWS, 10
#DIM DYNAMIC HIT_COUNT
HIT_COUNT = DT_SELECT("QOL_DISH_DB", @"dish_id = {DISH_ID}", "", HIT_ROWS)
IF HIT_COUNT > 0
	DT_CELL_SET "QOL_DISH_DB", HIT_ROWS:0, "dish_name", DISH_NAME_ARG, 1
	DT_CELL_SET "QOL_DISH_DB", HIT_ROWS:0, "dish_taste", DISH_TASTE_ARG, 1
	DT_CELL_SET "QOL_DISH_DB", HIT_ROWS:0, "dish_comment", DISH_COMMENT_ARG, 1
	DT_CELL_SET "QOL_DISH_DB", HIT_ROWS:0, "dish_ing", DISH_ING_ARG, 1
	DT_CELL_SET "QOL_DISH_DB", HIT_ROWS:0, "dish_time", DISH_TIME_ARG, 1
	DT_CELL_SET "QOL_DISH_DB", HIT_ROWS:0, "dish_maxlimit", DISH_MAXLIMIT_ARG, 1
	DT_CELL_SET "QOL_DISH_DB", HIT_ROWS:0, "typecheck", TYPECHECK_ARG, 1
	DT_CELL_SET "QOL_DISH_DB", HIT_ROWS:0, "skill_lv", SKILL_LV_ARG, 1
ELSE
	DT_ROW_ADD "QOL_DISH_DB", "dish_id", DISH_ID, "dish_name", DISH_NAME_ARG, "dish_taste", DISH_TASTE_ARG, "dish_comment", DISH_COMMENT_ARG, "dish_ing", DISH_ING_ARG, "dish_time", DISH_TIME_ARG, "dish_maxlimit", DISH_MAXLIMIT_ARG, "typecheck", TYPECHECK_ARG, "skill_lv", SKILL_LV_ARG
ENDIF
SIF STRLENS(DISH_NAME_ARG)
	MAP_SET "QOL_DISH_NAMES", TOSTR(DISH_ID), DISH_NAME_ARG
SIF STRLENS(DISH_TASTE_ARG)
	MAP_SET "QOL_DISH_TASTES", TOSTR(DISH_ID), DISH_TASTE_ARG
SIF STRLENS(DISH_COMMENT_ARG)
	MAP_SET "QOL_DISH_COMMENTS", TOSTR(DISH_ID), DISH_COMMENT_ARG
SIF STRLENS(DISH_ING_ARG)
	MAP_SET "QOL_DISH_INGREDIENTS", TOSTR(DISH_ID), DISH_ING_ARG
SIF STRLENS(TYPECHECK_ARG)
	MAP_SET "QOL_DISH_TYPES", TOSTR(DISH_ID), TYPECHECK_ARG
SIF DISH_TIME_ARG > 0
	MAP_SET "QOL_DISH_TIMES", TOSTR(DISH_ID), TOSTR(DISH_TIME_ARG)
SIF DISH_MAXLIMIT_ARG > 0
	MAP_SET "QOL_DISH_MAXLIMITS", TOSTR(DISH_ID), TOSTR(DISH_MAXLIMIT_ARG)
SIF SKILL_LV_ARG > 0
	MAP_SET "QOL_DISH_SKILL_LVS", TOSTR(DISH_ID), TOSTR(SKILL_LV_ARG)

@QOL_DISH_DATA_REGISTER
#LOCALSIZE 3
#LOCALSSIZE 1
#DIM DYNAMIC DISH_ID
#DIMS DYNAMIC ING_STR
#DIM DYNAMIC ING_COUNT
FOR DISH_ID, 101, 400 + CHARANUM
	SIF INRANGE(DISH_ID, 361, 400)
		CONTINUE
	CALL DISHDATA_ORIGINAL(DISH_ID, "", 1, 1)
	SIF DISH_NAME == ""
		CONTINUE
	ING_STR '= ""
	ING_COUNT = 0
	FOR LOCAL, 1, 11
		SIF DISH_ING:LOCAL < 0
			BREAK
		SIF ING_COUNT > 0
			ING_STR += "/"
		ING_STR += ITEMNAME:(DISH_ING:LOCAL)
		ING_COUNT ++
	NEXT
	CALL QOL_DISH_DATA_SET(DISH_ID, DISH_NAME, DISH_TASTE, DISH_COMMENT, ING_STR, DISH_TIME, DISH_MAXLIMIT, TYPECHECK, SKILL_LV)
NEXT
CALL QOL_DISH_SAVE_XML

@QOL_DISH_SAVE_XML
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS DYNAMIC schema_xml
#DIMS DYNAMIC data_xml
data_xml '= DT_TOXML("QOL_DISH_DB", schema_xml)
SAVETEXT schema_xml, "plugins/QOL/qol_dish_schema.xml"
SAVETEXT data_xml, "plugins/QOL/qol_dish_data.xml"
SAVETEXT MAP_TOXML("QOL_DISH_NAMES"), "plugins/QOL/qol_dish_names.xml"
SAVETEXT MAP_TOXML("QOL_DISH_TASTES"), "plugins/QOL/qol_dish_tastes.xml"
SAVETEXT MAP_TOXML("QOL_DISH_COMMENTS"), "plugins/QOL/qol_dish_comments.xml"
SAVETEXT MAP_TOXML("QOL_DISH_INGREDIENTS"), "plugins/QOL/qol_dish_ingredients.xml"
SAVETEXT MAP_TOXML("QOL_DISH_TYPES"), "plugins/QOL/qol_dish_types.xml"
SAVETEXT MAP_TOXML("QOL_DISH_TIMES"), "plugins/QOL/qol_dish_times.xml"
SAVETEXT MAP_TOXML("QOL_DISH_MAXLIMITS"), "plugins/QOL/qol_dish_maxlimits.xml"
SAVETEXT MAP_TOXML("QOL_DISH_SKILL_LVS"), "plugins/QOL/qol_dish_skill_lvs.xml"

