@QOL_DISH_RESOLVE_ING(DISH_ID)
#LOCALSIZE 2
#LOCALSSIZE 1
#DIMS DYNAMIC ING_STR
#DIMS DYNAMIC ING_LIST, 20
#DIM DYNAMIC ING_COUNT
VARSET DISH_ING, -1
SIF !MAP_HAS("QOL_DISH_INGREDIENTS", TOSTR(DISH_ID))
	RETURN
ING_STR '= MAP_GET("QOL_DISH_INGREDIENTS", TOSTR(DISH_ID))
SPLIT ING_STR, "/", ING_LIST
FOR LOCAL, 0, 10
	SIF ING_LIST:LOCAL == ""
		BREAK
	DISH_ING:(LOCAL + 1) = GETNUM(ITEM, ING_LIST:LOCAL)
NEXT
