;================================================
;@QOL_DISH_RESOLVE_ING(DISH_ID) ;从数据库读取食材列表，解析后写入全局 DISH_ING 数组。
;DISH_ID  料理ID
;结果     DISH_ING:1～10 被设置为对应食材的 ITEM 编号（GETNUM），未使用位置为 -1
;SQL: SELECT dish_ing ... WHERE dish_id = @0 → SPLIT by "/" → GETNUM(ITEM, ...)
;================================================
@QOL_DISH_RESOLVE_ING(DISH_ID)
#LOCALSIZE 2
#LOCALSSIZE 1
#DIM DYNAMIC DISH_ID
#DIMS DYNAMIC ING_STR
#DIMS DYNAMIC ING_LIST, 20
VARSET DISH_ING, -1
ING_STR '= SQL_P_EXECUTE_SCALAR_STRING("QOL_DISH_DB", "SELECT dish_ing FROM QOL_DISH_DB WHERE dish_id = @0", TOSTR(DISH_ID))
SIF ING_STR == ""
	RETURN
SPLIT ING_STR, "/", ING_LIST
FOR LOCAL, 0, 10
	SIF ING_LIST:LOCAL == ""
		BREAK
	DISH_ING:(LOCAL + 1) = GETNUM(ITEM, ING_LIST:LOCAL)
NEXT

;================================================
;@QOL_DISH_DYNAMIC(DISH_NUM) ;运行时追加动态口味标签。
;根据当前节日/月份/天气/地点，向 DISH_TASTE 或 DISH_NAME/DISH_COMMENT 追加动态内容。
;动态类型：
;   縁起物  —— 节日限定口味（如年节菜在正月、圣诞蛋糕在圣诞节）
;   旬      —— 应季口味（如竹笋在春季）
;   过季    —— 非应季时的口味标签
;   台風炸丸子 —— 台风天气限定
;   Tarte Lune/Soleil —— 根据地点切换名称和描述
;此函数不操作数据库，仅修改运行时的 DISH_* 全局变量。
;================================================
@QOL_DISH_DYNAMIC(DISH_NUM)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC DISH_NUM
SELECTCASE DISH_NUM
CASE 152
	SIF GET_LOCATION_AREA_TYPHOON() == 1
		DISH_TASTE += "台風炸丸子/"
CASE 214
	SIF GET_MONTH() == "夏之月" && DAY:3 == 25
		DISH_TASTE += "縁起物/"
CASE 287
	SIF GET_MONTH() == "春之月"
		DISH_TASTE += "旬/"
CASE 291
	IF GET_MONTH() == "春之月" && DAY:3 <= 3
		DISH_TASTE += "縁起物/"
	ELSE
		DISH_TASTE += "过季/"
	ENDIF
CASE 292
	IF GET_MONTH() == "春之月" && DAY:3 == 7
		DISH_TASTE += "縁起物/"
	ELSE
		DISH_TASTE += "过季/"
	ENDIF
CASE 293
	IF GET_MONTH() == "冬之月" && DAY:3 == 3
		DISH_TASTE += "縁起物/"
	ELSE
		DISH_TASTE += "过季/"
	ENDIF
CASE 294
	IF FESTIVAL() == "大晦日"
		DISH_TASTE += "縁起物/"
	ELSE
		DISH_TASTE += "过季/"
	ENDIF
CASE 295
	IF FESTIVAL() == "平安夜" || FESTIVAL() == "聖誕節"
		DISH_TASTE += "縁起物/"
	ELSE
		DISH_TASTE += "过季/"
	ENDIF
CASE 341
	IF FESTIVAL() == "十五夜"
		DISH_TASTE += "縁起物/"
	ELSE
		DISH_TASTE += "过季/"
	ENDIF
CASE 342
	IF FESTIVAL() == "萬聖節"
		DISH_TASTE += "縁起物/"
	ELSE
		DISH_TASTE += "过季/"
	ENDIF
CASE 343
	IF FESTIVAL() == "平安夜" || FESTIVAL() == "聖誕節"
		DISH_TASTE += "縁起物/"
	ELSE
		DISH_TASTE += "过季/"
	ENDIF
CASE 345
	IF INRANGE(AT_AREA(), 正門, 地下室 + 1)
		DISH_NAME = Tarte Lune
		DISH_COMMENT = 别名"月亮派"，更适合吸血鬼宝宝体质的，装饰成月亮造型的甜点。
	ELSE
		DISH_NAME = Tarte Soleil
		DISH_COMMENT = 别名"太阳派"，外界很流行的，装饰成太阳造型的甜点。
	ENDIF
CASE 346
	IF FESTIVAL() == "十五夜"
		DISH_TASTE += "縁起物/"
	ELSE
		DISH_TASTE += "过季/"
	ENDIF
;角色专属料理の動的口味
;料理ID = DISH_CHARA_OFFSET(400) + [[角色名]]（编译期常量）
CASE DISH_CHARA_OFFSET + [[千百合]]
	SIF YOUBI_MATCH(DAY, "金")
		DISH_TASTE += "咖喱の日/"
CASE DISH_CHARA_OFFSET + [[诹访子]]
	SIF GROUPMATCH(FESTIVAL(), "盂蘭盆節", "十五夜")
		DISH_TASTE += "縁起物/"
CASE DISH_CHARA_OFFSET + [[慧音]]
	SIF FESTIVAL() == "十五夜"
		DISH_TASTE += "縁起物/"
CASE DISH_CHARA_OFFSET + [[雏]]
	IF FESTIVAL() == "女兒節"
		DISH_TASTE += "縁起物/"
	ELSE
		DISH_TASTE += "过季/"
	ENDIF
CASE DISH_CHARA_OFFSET + [[屠自古]]
	SIF GROUPMATCH(天候, 5, 14) || GROUPMATCH(FLAG:異常気象, 9, 10)
		DISH_TASTE += "縁起物/"
CASE DISH_CHARA_OFFSET + [[舞]]
	IF FESTIVAL() == "七夕"
		DISH_TASTE += "縁起物/"
	ELSE
		DISH_TASTE += "过季/"
	ENDIF
CASE DISH_CHARA_OFFSET + [[魔眼]]
	DISH_TASTE += "縁起物/"
ENDSELECT

