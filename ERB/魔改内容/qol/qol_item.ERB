@QOL_ITEM_SAVE_XML
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS DYNAMIC schema_xml
#DIMS DYNAMIC data_xml
#DIMS DYNAMIC schema_path
#DIMS DYNAMIC data_path
