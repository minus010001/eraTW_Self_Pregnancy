SAVETEXT MAP_TOXML("QOL_ITEM_SHOPS"), "plugins/QOL/qol_item_shops.xml"
SAVETEXT MAP_TOXML("QOL_ITEM_SALES_MODE"), "plugins/QOL/qol_item_sales_mode.xml"
