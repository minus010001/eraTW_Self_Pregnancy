@QOL_ITEM_INIT
#LOCALSIZE 1
#LOCALSSIZE 1
IF !MAP_EXIST("QOL_ITEM_TYPES")
	MAP_CREATE "QOL_ITEM_TYPES"
ENDIF
IF !MAP_EXIST("QOL_ITEM_SHOPS")
	MAP_CREATE "QOL_ITEM_SHOPS"
ENDIF
IF !MAP_EXIST("QOL_ITEM_SALES_MODE")
	MAP_CREATE "QOL_ITEM_SALES_MODE"
ENDIF
IF !MAP_EXIST("QOL_ITEM_SALES_COND")
	MAP_CREATE "QOL_ITEM_SALES_COND"
ENDIF
IF !MAP_EXIST("QOL_ITEM_BUY_FUNC")
	MAP_CREATE "QOL_ITEM_BUY_FUNC"
ENDIF
IF !MAP_EXIST("QOL_ITEM_IS_CUSTOM")
	MAP_CREATE "QOL_ITEM_IS_CUSTOM"
ENDIF
IF !MAP_EXIST("QOL_ITEM_SHOP_COND")
	MAP_CREATE "QOL_ITEM_SHOP_COND"
ENDIF
IF !DT_EXIST("QOL_ITEM_DB")
	DT_CREATE "QOL_ITEM_DB"
	DT_COLUMN_ADD "QOL_ITEM_DB", "item_id", "int32"
	DT_COLUMN_ADD "QOL_ITEM_DB", "types", "string"
	DT_COLUMN_ADD "QOL_ITEM_DB", "shops", "string"
	DT_COLUMN_ADD "QOL_ITEM_DB", "sales_mode", "string"
	DT_COLUMN_ADD "QOL_ITEM_DB", "sales_cond", "string"
	DT_COLUMN_ADD "QOL_ITEM_DB", "buy_func", "string"
	DT_COLUMN_ADD "QOL_ITEM_DB", "is_custom", "int8"
	DT_COLUMN_ADD "QOL_ITEM_DB", "shop_cond", "string"
	CALL QOL_ITEM_LOAD_XML
	SIF DT_ROW_LENGTH("QOL_ITEM_DB") == 0
		CALL QOL_ITEM_DATA_REGISTER
ENDIF

@QOL_ITEM_LOAD_XML
#LOCALSIZE 3
#LOCALSSIZE 1
#DIMS DYNAMIC schema
#DIMS DYNAMIC data_xml
#DIMS DYNAMIC map_data
schema '= LOADTEXT("plugins/QOL/qol_item_schema.xml")
data_xml '= LOADTEXT("plugins/QOL/qol_item_data.xml")
SIF STRLENS(data_xml) == 0
	RETURN
DT_FROMXML "QOL_ITEM_DB", schema, data_xml
map_data '= LOADTEXT("plugins/QOL/qol_item_types.xml")
SIF STRLENS(map_data)
	MAP_FROMXML "QOL_ITEM_TYPES", map_data
map_data '= LOADTEXT("plugins/QOL/qol_item_shops.xml")
SIF STRLENS(map_data)
	MAP_FROMXML "QOL_ITEM_SHOPS", map_data
map_data '= LOADTEXT("plugins/QOL/qol_item_sales_mode.xml")
SIF STRLENS(map_data)
	MAP_FROMXML "QOL_ITEM_SALES_MODE", map_data
map_data '= LOADTEXT("plugins/QOL/qol_item_sales_cond.xml")
SIF STRLENS(map_data)
	MAP_FROMXML "QOL_ITEM_SALES_COND", map_data
map_data '= LOADTEXT("plugins/QOL/qol_item_buy_func.xml")
SIF STRLENS(map_data)
	MAP_FROMXML "QOL_ITEM_BUY_FUNC", map_data
map_data '= LOADTEXT("plugins/QOL/qol_item_is_custom.xml")
SIF STRLENS(map_data)
	MAP_FROMXML "QOL_ITEM_IS_CUSTOM", map_data
map_data '= LOADTEXT("plugins/QOL/qol_item_shop_cond.xml")
SIF STRLENS(map_data)
	MAP_FROMXML "QOL_ITEM_SHOP_COND", map_data
SIF MAP_SIZE("QOL_ITEM_TYPES") > 0
	RETURN
FOR LOCAL, 0, DT_ROW_LENGTH("QOL_ITEM_DB")
	LOCAL:1 = DT_CELL_GET("QOL_ITEM_DB", LOCAL, "item_id", 0)
	LOCALS '= DT_CELL_GETS("QOL_ITEM_DB", LOCAL, "types", 0)
	SIF STRLENS(LOCALS)
		MAP_SET "QOL_ITEM_TYPES", TOSTR(LOCAL:1), LOCALS
	LOCALS '= DT_CELL_GETS("QOL_ITEM_DB", LOCAL, "shops", 0)
	SIF STRLENS(LOCALS)
		MAP_SET "QOL_ITEM_SHOPS", TOSTR(LOCAL:1), LOCALS
	LOCALS '= DT_CELL_GETS("QOL_ITEM_DB", LOCAL, "sales_mode", 0)
	SIF STRLENS(LOCALS)
		MAP_SET "QOL_ITEM_SALES_MODE", TOSTR(LOCAL:1), LOCALS
	LOCALS '= DT_CELL_GETS("QOL_ITEM_DB", LOCAL, "sales_cond", 0)
	SIF STRLENS(LOCALS)
		MAP_SET "QOL_ITEM_SALES_COND", TOSTR(LOCAL:1), LOCALS
	LOCALS '= DT_CELL_GETS("QOL_ITEM_DB", LOCAL, "buy_func", 0)
	SIF STRLENS(LOCALS)
		MAP_SET "QOL_ITEM_BUY_FUNC", TOSTR(LOCAL:1), LOCALS
	LOCAL:2 = DT_CELL_GET("QOL_ITEM_DB", LOCAL, "is_custom", 0)
	SIF LOCAL:2
		MAP_SET "QOL_ITEM_IS_CUSTOM", TOSTR(LOCAL:1), "1"
	LOCALS '= DT_CELL_GETS("QOL_ITEM_DB", LOCAL, "shop_cond", 0)
	SIF STRLENS(LOCALS)
		MAP_SET "QOL_ITEM_SHOP_COND", TOSTR(LOCAL:1), LOCALS
NEXT

@QOL_ITEM_DATA_SET(ITEM_ID, TYPES, SHOPS, SALES_MODE, SALES_COND = "", BUY_FUNC = "", IS_CUSTOM = 0, SHOP_COND = "")
#LOCALSIZE 2
#LOCALSSIZE 1
#DIM DYNAMIC ITEM_ID
#DIMS DYNAMIC TYPES
#DIMS DYNAMIC SHOPS
#DIMS DYNAMIC SALES_MODE
#DIMS DYNAMIC SALES_COND
#DIMS DYNAMIC BUY_FUNC
#DIM DYNAMIC IS_CUSTOM
#DIMS DYNAMIC SHOP_COND
#DIM DYNAMIC HIT_ROWS, 10
#DIM DYNAMIC HIT_COUNT
HIT_COUNT = DT_SELECT("QOL_ITEM_DB", @"item_id = {ITEM_ID}", "", HIT_ROWS)
IF HIT_COUNT > 0
	DT_CELL_SET "QOL_ITEM_DB", HIT_ROWS:0, "types", TYPES, 1
	DT_CELL_SET "QOL_ITEM_DB", HIT_ROWS:0, "shops", SHOPS, 1
	DT_CELL_SET "QOL_ITEM_DB", HIT_ROWS:0, "sales_mode", SALES_MODE, 1
	DT_CELL_SET "QOL_ITEM_DB", HIT_ROWS:0, "sales_cond", SALES_COND, 1
	DT_CELL_SET "QOL_ITEM_DB", HIT_ROWS:0, "buy_func", BUY_FUNC, 1
	DT_CELL_SET "QOL_ITEM_DB", HIT_ROWS:0, "is_custom", IS_CUSTOM, 1
	DT_CELL_SET "QOL_ITEM_DB", HIT_ROWS:0, "shop_cond", SHOP_COND, 1
ELSE
	DT_ROW_ADD "QOL_ITEM_DB", "item_id", ITEM_ID, "types", TYPES, "shops", SHOPS, "sales_mode", SALES_MODE, "sales_cond", SALES_COND, "buy_func", BUY_FUNC, "is_custom", IS_CUSTOM, "shop_cond", SHOP_COND
ENDIF
SIF STRLENS(TYPES)
	MAP_SET "QOL_ITEM_TYPES", TOSTR(ITEM_ID), TYPES
SIF STRLENS(SHOPS)
	MAP_SET "QOL_ITEM_SHOPS", TOSTR(ITEM_ID), SHOPS
SIF STRLENS(SALES_MODE)
	MAP_SET "QOL_ITEM_SALES_MODE", TOSTR(ITEM_ID), SALES_MODE
SIF STRLENS(SALES_COND)
	MAP_SET "QOL_ITEM_SALES_COND", TOSTR(ITEM_ID), SALES_COND
SIF STRLENS(BUY_FUNC)
	MAP_SET "QOL_ITEM_BUY_FUNC", TOSTR(ITEM_ID), BUY_FUNC
SIF IS_CUSTOM
	MAP_SET "QOL_ITEM_IS_CUSTOM", TOSTR(ITEM_ID), "1"
SIF STRLENS(SHOP_COND)
	MAP_SET "QOL_ITEM_SHOP_COND", TOSTR(ITEM_ID), SHOP_COND

