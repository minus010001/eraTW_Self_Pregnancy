;================================================
;@QOL_ITEM_HAS_TAG(ARG, ARGS, ARGS:1 = "TYPE")
;判断物品是否拥有指定标签。
;ARG    物品ID
;ARGS   要查找的标签字符串
;ARGS:1 搜索列名，"TYPE" 查 types 列，"SHOP" 查 shops 列
;RETURNF  有该标签为1，无为0
;SQL: SELECT {types|shops} FROM QOL_ITEM_DB WHERE item_id = {ARG} → STRFIND 查找子串
;================================================
@QOL_ITEM_HAS_TAG(ARG, ARGS, ARGS:1 = "TYPE")
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTION
#DIMS DYNAMIC TAGS
#DIMS DYNAMIC COL_NAME
COL_NAME '= ARGS:1 == "TYPE" ? "types" # "shops"
TAGS '= SQL_P_EXECUTE_SCALAR_STRING("QOL_DISH_DB", @"SELECT %COL_NAME% FROM QOL_ITEM_DB WHERE item_id = {ARG}")
SIF STRLENS(TAGS) && STRFIND(TAGS, ARGS) >= 0
	RETURNF 1
RETURNF 0

;================================================
;@QOL_ITEM_GET_SALES(ARG)
;获取物品的可购买数量。根据 sales_mode 字段决定返回值语义：
;  UNIQUE      → 已拥有返回-1，未拥有返回0（一次性购买）
;  INFINITE    → 返回99（无限购买）
;  STOCK       → 返回 ITEMSALES:ARG（库存数量），无库存返回-1
;  CONDITIONAL → 委托 QOL_ITEM_SALES_COND 判断条件后返回
;  CUSTOM      → 同 CONDITIONAL，委托 QOL_ITEM_SALES_COND
;  NOSALE      → 返回-2（不可购买）
;ARG    物品ID
;RETURNF 可购买数量（0=可买，-1=已拥有/无库存，-2=不可购买，正数=可买数量）
;SQL: SELECT sales_mode FROM QOL_ITEM_DB WHERE item_id = {ARG}
;  → 使用 {} 内嵌整数主键，查询销售模式后进入 SELECTCASE 分支
;================================================
@QOL_ITEM_GET_SALES(ARG)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTION
#DIMS DYNAMIC MODE
MODE '= SQL_P_EXECUTE_SCALAR_STRING("QOL_DISH_DB", @"SELECT sales_mode FROM QOL_ITEM_DB WHERE item_id = {ARG}")
SIF STRLENS(MODE) == 0
	RETURNF -2
SELECTCASE MODE
CASE "UNIQUE"
	RETURNF ITEM:ARG ? -1 # 0
CASE "INFINITE"
	RETURNF 99
CASE "STOCK"
	RETURNF ITEMSALES:ARG > 0 ? ITEMSALES:ARG # -1
CASE "CONDITIONAL"
	RETURNF QOL_ITEM_SALES_COND(ARG)
CASE "CUSTOM"
	RETURNF QOL_ITEM_SALES_COND(ARG)
CASE "NOSALE"
	RETURNF -2
CASEELSE
	RETURNF 0
ENDSELECT

;================================================
;@QOL_ITEM_SALES_COND(ARG)
;根据 sales_cond 条件键判断物品是否可购买。每个条件键对应一段硬编码逻辑。
;常见的条件键及其含义：
;  "媚薬"/"利尿剤"  → 需要教養ABL≥2
;  "禁断的知識"     → 需要MASTER拥有禁断的知識TALENT
;  "技巧UP"/"DOWN"  → 技巧数值上下限判断
;  "薬的材料(双/消)" → 需要禁断的知識+特定性別角色存在
;  "紅色糖果"等     → 需要禁断的知識+特定角色条件
;ARG    物品ID
;RETURNF 0=可购买，-1=已拥有，-2=条件不满足
;SQL: SELECT sales_cond FROM QOL_ITEM_DB WHERE item_id = {ARG}
;  → 查询条件键后进入 SELECTCASE 分支进行游戏逻辑判断
;================================================
@QOL_ITEM_SALES_COND(ARG)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTION
#DIMS DYNAMIC COND_KEY
COND_KEY '= SQL_P_EXECUTE_SCALAR_STRING("QOL_DISH_DB", @"SELECT sales_cond FROM QOL_ITEM_DB WHERE item_id = {ARG}")
SIF STRLENS(COND_KEY) == 0
	RETURNF -2
SELECTCASE COND_KEY
CASE "媚薬"
	RETURNF ABL:MASTER:教養 >= 2 ? 99 # -2
CASE "利尿剤"
	RETURNF ABL:MASTER:教養 >= 2 ? 99 # -2
CASE "禁断的知識"
	RETURNF TALENT:MASTER:禁断的知識 ? -1 # 0
CASE "技巧UP"
	RETURNF ABL:MASTER:技巧 < 5 + 15 * MAGIC_DLC_等级重置 ? 0 # -2
CASE "技巧DOWN"
	RETURNF ABL:MASTER:技巧 ? 0 # -2
CASE "汚臭耐性UP"
	RETURNF TALENT:MASTER:汚臭耐性 < 2 ? 0 # -2
CASE "汚臭耐性DOWN"
	RETURNF TALENT:MASTER:汚臭耐性 > -2 ? 0 # -2
CASE "施虐狂DOWN"
	RETURNF ABL:MASTER:施虐属性 ? 0 # -2
CASE "受虐狂DOWN"
	RETURNF ABL:MASTER:受虐属性 ? 0 # -2
CASE "薬的材料(双)"
	SIF ITEM:ARG
		RETURNF -1
	RETURNF (TALENT:MASTER:禁断的知識 && FINDCHARA(TALENT:性別, 1) != -1) ? 0 # -2
CASE "薬的材料(消)"
	SIF ITEM:ARG
		RETURNF -1
	RETURNF (TALENT:MASTER:禁断的知識 && FINDCHARA(TALENT:性別, 3) != -1) ? 0 # -2
CASE "紅色糖果"
	SIF ITEM:ARG
		RETURNF -1
	RETURNF (TALENT:MASTER:禁断的知識 && !ALLSAMES(-1, FINDCHARA(TALENT:処女, 0), FINDCHARA(TALENT:処女, -1))) ? 0 # -2
CASE "茶色糖果"
	SIF ITEM:ARG
		RETURNF -1
	RETURNF (TALENT:MASTER:禁断的知識 && FINDCHARA(TALENT:動物耳, 0) != -1) ? 0 # -2
CASE "水色糖果"
	SIF ITEM:ARG
		RETURNF -1
	RETURNF (TALENT:MASTER:禁断的知識 && SUMCARRAY(TALENT:動物耳)) ? 0 # -2
CASE "排卵誘発剤"
	SIF ITEM:ARG
		RETURNF -1
	RETURNF TALENT:MASTER:禁断的知識 ? 0 # -2
CASE "兎符"
	RETURNF ITEM:ARG ? -1 # 0
CASE "青色糖果"
	SIF ITEM:ARG
		RETURNF -1
	RETURNF (TALENT:MASTER:禁断的知識 && FINDCHARA(TALENT:母乳体質, 0) != -1) ? 0 # -2
CASE "結婚指輪"
	RETURNF (ITEM:ARG || LEGAL_SPOUSE) ? -1 # 0
ENDSELECT
RETURNF -2

;================================================
;@QOL_ITEM_BUY(ARG, ARG:1)
;购买物品的动态派发入口。从数据库读取 buy_func 字段，若为空则使用默认
;的 ITEM_BUY_UNIQUE 函数。通过 TRYCALLFORM 动态调用对应的购买处理函数。
;ARG    物品ID
;ARG:1  附加参数（通常为购买数量或商店相关参数）
;SQL: SELECT buy_func FROM QOL_ITEM_DB WHERE item_id = {ARG}
;  → 查询购买函数名，空则回退到 "ITEM_BUY_UNIQUE"
;  → TRYCALLFORM %FUNC_NAME%(ARG, ARG:1) 实现动态函数调用
;================================================
@QOL_ITEM_BUY(ARG, ARG:1)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS DYNAMIC FUNC_NAME
FUNC_NAME '= SQL_P_EXECUTE_SCALAR_STRING("QOL_DISH_DB", @"SELECT buy_func FROM QOL_ITEM_DB WHERE item_id = {ARG}")
SIF STRLENS(FUNC_NAME) == 0
	FUNC_NAME '= "ITEM_BUY_UNIQUE"
TRYCALLFORM %FUNC_NAME%(ARG, ARG:1)

@ITEM_BUY_UNIQUE(ARG, ARG:1)
#LOCALSIZE 1
#LOCALSSIZE 1
CALL SHOP_ASK(ARG, ARG:1)
SIF RESULT
	RETURN
ITEM:ARG ++
TRYCALLFORM ITEM_BUY_HOOK_%TOSTR(ARG)%

@ITEM_BUY_NONE
#LOCALSIZE 1
#LOCALSSIZE 1
RETURN

@ITEM_BUY_MATOMEGAI(ARG, ARG:1)
#LOCALSIZE 1
#LOCALSSIZE 1
CALL ITEM_MATOMEGAI(ARG, ARG:1)

@ITEM_BUY_折畳傘(ARG, ARG:1)
#LOCALSIZE 1
#LOCALSSIZE 1
CALL SHOP_ASK(ARG, ARG:1)
IF !RESULT
	ITEM:ARG ++
	PRINTFORMW 因为买了新伞、所以把坏掉的伞处理掉了
	ITEM:壊掉的傘 = 0
ENDIF

@ITEM_BUY_圣诞节禮物(ARG, ARG:1)
#LOCALSIZE 1
#LOCALSSIZE 1
CALL SHOP_ASK(ARG, ARG:1)
IF !RESULT
	ITEM:ARG ++
	PRINTFORMW 限定在冬月24日、约会中送出
ENDIF

@ITEM_BUY_禁断的知識(ARG, ARG:1)
#LOCALSIZE 1
#LOCALSSIZE 1
CALL SHOP_ASK(ARG, ARG:1)
SIF !RESULT
	TALENT:MASTER:禁断的知識 = 1

@ITEM_BUY_技巧UP(ARG, ARG:1)
#LOCALSIZE 1
#LOCALSSIZE 1
CALL SHOP_ASK(ARG, ARG:1)
SIF !RESULT
	ABL:MASTER:技巧 ++

@ITEM_BUY_技巧DOWN(ARG, ARG:1)
#LOCALSIZE 1
#LOCALSSIZE 1
CALL SHOP_ASK(ARG, ARG:1)
SIF !RESULT
	ABL:MASTER:技巧 --

@ITEM_BUY_汚臭耐性UP(ARG, ARG:1)
#LOCALSIZE 1
#LOCALSSIZE 1
CALL SHOP_ASK(ARG, ARG:1)
SIF !RESULT
	TALENT:MASTER:汚臭耐性 ++

@ITEM_BUY_汚臭耐性DOWN(ARG, ARG:1)
#LOCALSIZE 1
#LOCALSSIZE 1
CALL SHOP_ASK(ARG, ARG:1)
SIF !RESULT
	TALENT:MASTER:汚臭耐性 --

@ITEM_BUY_施虐狂DOWN(ARG, ARG:1)
#LOCALSIZE 1
#LOCALSSIZE 1
CALL SHOP_ASK(ARG, ARG:1)
IF !RESULT
	ABL:MASTER:施虐属性 --
	JUEL:MASTER:優越 = 0
	EXP:MASTER:嗜虐快楽経験 = MAX(EXP:MASTER:嗜虐快楽経験 - 200, 0)
ENDIF

@ITEM_BUY_受虐狂DOWN(ARG, ARG:1)
#LOCALSIZE 1
#LOCALSSIZE 1
CALL SHOP_ASK(ARG, ARG:1)
IF !RESULT
	ABL:MASTER:受虐属性 --
	JUEL:MASTER:苦痛 = 0
	EXP:MASTER:苦痛快楽経験 = MAX(EXP:MASTER:苦痛快楽経験 - 200, 0)
ENDIF

@ITEM_BUY_瓶(ARG, ARG:1)
#LOCALSIZE 1
#LOCALSSIZE 1
CALL SHOP_ASK(ARG, ITEM:瓶 ? -(40*(ITEM:瓶)) # 0)
SIF !RESULT
	ITEM:ARG ++

;================================================
;@QOL_ITEMDATA(ARG, ARGS, ARG:1)
;物品数据统一查询入口，根据 ARGS 分发到不同子功能：
;  "SALES"       → 调用 QOL_ITEM_GET_SALES 获取可购买数量
;  "購入"        → 调用 QOL_ITEM_BUY 执行购买
;  "TYPE:xxx"    → 调用 QOL_ITEM_HAS_TAG 检查类型标签
;  "SHOP:xxx"    → 调用 QOL_ITEM_HAS_TAG + QOL_ITEM_SHOP_COND 检查商店标签+条件
;  其他          → 委托 QOL_ITEM_MISC 处理杂项判断
;ARG    物品ID
;ARGS   查询类型字符串
;ARG:1  附加参数
;================================================
@QOL_ITEMDATA(ARG, ARGS, ARG:1)
#LOCALSIZE 1
#LOCALSSIZE 1
SIF ITEMNAME:ARG == ""
	RETURN 0
SELECTCASE ARGS
CASE "SALES"
	RETURN QOL_ITEM_GET_SALES(ARG)
CASE "購入"
	CALL QOL_ITEM_BUY(ARG, ARG:1)
	RETURN RESULT
CASEELSE
	IF STRFIND(ARGS, "TYPE:") == 0
		SIF QOL_ITEM_HAS_TAG(ARG, SUBSTRING(ARGS, 5), "TYPE")
			RETURN 1
	ELSEIF STRFIND(ARGS, "SHOP:") == 0
		SIF QOL_ITEM_HAS_TAG(ARG, SUBSTRING(ARGS, 5), "SHOP") && QOL_ITEM_SHOP_COND(ARG, SUBSTRING(ARGS, 5))
			RETURN 1
	ELSE
		RETURN QOL_ITEM_MISC(ARG, ARGS, ARG:1)
	ENDIF
ENDSELECT

;================================================
;@QOL_ITEM_SHOP_COND(ARG, ARGS)
;判断物品的商店条件是否满足。从数据库读取 shop_cond 字段，
;若为空则无条件通过（返回1）。目前支持的条件：
;  "MAGIC_DLC" → 仅在通信販売商店且 MAGIC_DLC 标志为真时可用
;ARG    物品ID
;ARGS   当前商店名
;RETURNF 1=条件满足/无条件，0=条件不满足
;SQL: SELECT shop_cond FROM QOL_ITEM_DB WHERE item_id = {ARG}
;  → 查询商店条件键后进入 SELECTCASE 判断
;================================================
@QOL_ITEM_SHOP_COND(ARG, ARGS)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTION
#DIMS DYNAMIC COND_KEY
COND_KEY '= SQL_P_EXECUTE_SCALAR_STRING("QOL_DISH_DB", @"SELECT shop_cond FROM QOL_ITEM_DB WHERE item_id = {ARG}")
SIF STRLENS(COND_KEY) == 0
	RETURNF 1
SELECTCASE COND_KEY
CASE "MAGIC_DLC"
	SIF ARGS == "通信販売"
		RETURNF MAGIC_DLC
ENDSELECT
RETURNF 1

;================================================
;@QOL_ITEM_MISC(ARG, ARGS, ARG:1)
;杂项物品判断，处理不属于标准分类的特殊查询。
;  "特殊" → 检查物品是否拥有 "特殊" 类型标签
;  "其他" → 检查物品是否为守矢之守札/壊掉的傘/作業
;ARG    物品ID
;ARGS   查询类型
;ARG:1  附加参数
;RETURNF 1=匹配，0=不匹配
;================================================
@QOL_ITEM_MISC(ARG, ARGS, ARG:1)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTION
SELECTCASE ARGS
CASE "特殊"
	SIF QOL_ITEM_HAS_TAG(ARG, "特殊", "TYPE")
		RETURNF 1
CASE "其他"
	SIF ARG == [[守矢之守札]] || ARG == [[壊掉的傘]] || ARG == [[作業]]
		RETURNF 1
ENDSELECT
RETURNF 0

;================================================
;@QOL_ITEM_DEBUG_DUMP
;调试用：打印 QOL_ITEM_DB 中全部物品数据，包括 item_id、types、shops、
;sales_mode、sales_cond、buy_func、is_custom、shop_cond。
;同时打印 schema 版本号。
;SQL: SELECT ... FROM QOL_ITEM_DB ORDER BY item_id
;  → 使用 SQL_EXECUTE_READER 遍历全表（非参数化，因无 WHERE 条件）
;  → SQL_READER_READ / SQL_READER_GET_* 逐行读取
;  → SQL_READER_CLOSE 关闭游标
;================================================
@QOL_ITEM_DEBUG_DUMP
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC reader
#DIM DYNAMIC row_count
reader = SQL_EXECUTE_READER("QOL_DISH_DB", "SELECT item_id, types, shops, sales_mode, sales_cond, buy_func, is_custom, shop_cond FROM QOL_ITEM_DB ORDER BY item_id")
PRINTFORML ----------------------------------------
PRINTFORML 物品数据库
PRINTFORML ----------------------------------------
row_count = 0
WHILE SQL_READER_READ(reader)
	SIF SQL_READER_ISNULL(reader, COL_ITEM_ID)
		CONTINUE
	row_count ++
	PRINTFORM #{SQL_READER_GET_LONG(reader, COL_ITEM_ID), 5}
	PRINTFORM  %SQL_READER_GET_STRING(reader, COL_ITEM_TYPES), 20%
	PRINTFORM  %SQL_READER_GET_STRING(reader, COL_ITEM_SHOPS), 10%
	PRINTFORM  %SQL_READER_GET_STRING(reader, COL_ITEM_SALES_MODE), 8%
	PRINTFORM  [%SQL_READER_GET_STRING(reader, COL_ITEM_SALES_COND)%]
	LOCALS '= SQL_READER_GET_STRING(reader, COL_ITEM_BUY_FUNC)
	SIF LOCALS != ""
		PRINTFORM  buy:%LOCALS%
	SIF SQL_READER_GET_LONG(reader, COL_ITEM_IS_CUSTOM)
		PRINTFORM  ★
	LOCALS '= SQL_READER_GET_STRING(reader, COL_ITEM_SHOP_COND)
	SIF LOCALS != ""
		PRINTFORM  shop_cond:%LOCALS%
	PRINTL 
WEND
SQL_READER_CLOSE reader
PRINTFORML ----------------------------------------
PRINTFORML 共 {row_count} 条记录
PRINTFORML schema_version: %SQL_P_EXECUTE_SCALAR_STRING("QOL_DISH_DB", "SELECT value FROM _meta WHERE key = 'item_schema_version'")%
PRINTFORML ----------------------------------------
