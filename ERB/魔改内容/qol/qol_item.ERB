@QOL_ITEM_HAS_TAG(ARG, ARGS, ARGS:1 = "TYPE")
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTION
#DIMS DYNAMIC TAGS
#DIMS DYNAMIC MAP_NAME
MAP_NAME '= ARGS:1 == "TYPE" ? "QOL_ITEM_TYPES" # "QOL_ITEM_SHOPS"
IF MAP_HAS(MAP_NAME, TOSTR(ARG))
	TAGS '= MAP_GET(MAP_NAME, TOSTR(ARG))
	SIF STRFIND(TAGS, ARGS) >= 0
		RETURNF 1
ENDIF
RETURNF 0

@QOL_ITEM_GET_SALES(ARG)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTION
#DIMS DYNAMIC MODE
IF !MAP_HAS("QOL_ITEM_SALES_MODE", TOSTR(ARG))
	RETURNF -2
ENDIF
MODE '= MAP_GET("QOL_ITEM_SALES_MODE", TOSTR(ARG))
SELECTCASE MODE
CASE "UNIQUE"
	RETURNF ITEM:ARG ? -1 # 0
CASE "INFINITE"
	RETURNF 99
CASE "STOCK"
	RETURNF ITEMSALES:ARG > 0 ? ITEMSALES:ARG # -1
CASE "CONDITIONAL"
	RETURNF QOL_ITEM_SALES_COND(ARG)
CASE "CUSTOM"
	RETURNF QOL_ITEM_SALES_COND(ARG)
CASE "NOSALE"
	RETURNF -2
CASEELSE
	RETURNF 0
ENDSELECT

@QOL_ITEM_SALES_COND(ARG)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTION
#DIMS DYNAMIC COND_KEY
IF MAP_HAS("QOL_ITEM_SALES_COND", TOSTR(ARG))
	COND_KEY '= MAP_GET("QOL_ITEM_SALES_COND", TOSTR(ARG))
ELSE
	RETURNF -2
ENDIF
SELECTCASE COND_KEY
CASE "媚薬"
	RETURNF ABL:MASTER:教養 >= 2 ? 99 # -2
CASE "利尿剤"
	RETURNF ABL:MASTER:教養 >= 2 ? 99 # -2
CASE "禁断的知識"
	RETURNF TALENT:MASTER:禁断的知識 ? -1 # 0
CASE "技巧UP"
	RETURNF ABL:MASTER:技巧 < 5 + 15 * MAGIC_DLC_等级重置 ? 0 # -2
CASE "技巧DOWN"
	RETURNF ABL:MASTER:技巧 ? 0 # -2
CASE "汚臭耐性UP"
	RETURNF TALENT:MASTER:汚臭耐性 < 2 ? 0 # -2
CASE "汚臭耐性DOWN"
	RETURNF TALENT:MASTER:汚臭耐性 > -2 ? 0 # -2
CASE "施虐狂DOWN"
	RETURNF ABL:MASTER:施虐属性 ? 0 # -2
CASE "受虐狂DOWN"
	RETURNF ABL:MASTER:受虐属性 ? 0 # -2
CASE "薬的材料(双)"
	SIF ITEM:ARG
		RETURNF -1
	RETURNF (TALENT:MASTER:禁断的知識 && FINDCHARA(TALENT:性別, 1) != -1) ? 0 # -2
CASE "薬的材料(消)"
	SIF ITEM:ARG
		RETURNF -1
	RETURNF (TALENT:MASTER:禁断的知識 && FINDCHARA(TALENT:性別, 3) != -1) ? 0 # -2
CASE "紅色糖果"
	SIF ITEM:ARG
		RETURNF -1
	RETURNF (TALENT:MASTER:禁断的知識 && !ALLSAMES(-1, FINDCHARA(TALENT:処女, 0), FINDCHARA(TALENT:処女, -1))) ? 0 # -2
CASE "茶色糖果"
	SIF ITEM:ARG
		RETURNF -1
	RETURNF (TALENT:MASTER:禁断的知識 && FINDCHARA(TALENT:動物耳, 0) != -1) ? 0 # -2
CASE "水色糖果"
	SIF ITEM:ARG
		RETURNF -1
	RETURNF (TALENT:MASTER:禁断的知識 && SUMCARRAY(TALENT:動物耳)) ? 0 # -2
CASE "排卵誘発剤"
	SIF ITEM:ARG
		RETURNF -1
	RETURNF TALENT:MASTER:禁断的知識 ? 0 # -2
CASE "兎符"
	RETURNF ITEM:ARG ? -1 # 0
CASE "青色糖果"
	SIF ITEM:ARG
		RETURNF -1
	RETURNF (TALENT:MASTER:禁断的知識 && FINDCHARA(TALENT:母乳体質, 0) != -1) ? 0 # -2
CASE "結婚指輪"
	RETURNF (ITEM:ARG || LEGAL_SPOUSE) ? -1 # 0
ENDSELECT
RETURNF -2

@QOL_ITEM_BUY(ARG, ARG:1)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS DYNAMIC FUNC_NAME
IF MAP_HAS("QOL_ITEM_BUY_FUNC", TOSTR(ARG))
	FUNC_NAME '= MAP_GET("QOL_ITEM_BUY_FUNC", TOSTR(ARG))
ELSE
	FUNC_NAME '= "ITEM_BUY_UNIQUE"
ENDIF
TRYCALLFORM %FUNC_NAME%(ARG, ARG:1)

@ITEM_BUY_UNIQUE(ARG, ARG:1)
#LOCALSIZE 1
#LOCALSSIZE 1
CALL SHOP_ASK(ARG, ARG:1)
SIF RESULT
	RETURN
ITEM:ARG ++
TRYCALLFORM ITEM_BUY_HOOK_%TOSTR(ARG)%

@ITEM_BUY_NONE
#LOCALSIZE 1
#LOCALSSIZE 1
RETURN

@ITEM_BUY_折畳傘(ARG, ARG:1)
#LOCALSIZE 1
#LOCALSSIZE 1
CALL SHOP_ASK(ARG, ARG:1)
IF !RESULT
	ITEM:ARG ++
	PRINTFORMW 因为买了新伞、所以把坏掉的伞处理掉了
	ITEM:壊掉的傘 = 0
ENDIF

@ITEM_BUY_圣诞节禮物(ARG, ARG:1)
