;
;Module   :qol_item.ERB
;Facility :物品数据的 SQLite 持久化存储与查询接口
;Licence  :许可证自由(CC0)。
;
; 本模块将物品（ITEM）的元数据从硬编码 ERB 迁移至 SQLite 数据库，实现：
;   - 物品类型标签、所属商店、销售模式的集中管理
;   - 销售条件判断（UNIQUE/INFINITE/STOCK/CONDITIONAL/NOSALE）
;   - 购买函数的动态派发（buy_func 字段 → TRYCALLFORM）
;   - 商店条件过滤（如 DLC 限定商品）
;   - 运行时 MAP 缓存（QOL_ITEM_TYPES / QOL_ITEM_SHOPS 等）与数据库双写
;
; 表结构：QOL_ITEM_DB
;   item_id     INTEGER PRIMARY KEY  —— 物品ID
;   types       TEXT                 —— 类型标签（"/"分隔，如 "調教/河童道具/跳蛋"）
;   shops       TEXT                 —— 所属商店（"/"分隔，如 "通信販売/河童の道具屋"）
;   sales_mode  TEXT                 —— 销售模式（UNIQUE/INFINITE/STOCK/CONDITIONAL/CUSTOM/NOSALE）
;   sales_cond  TEXT                 —— 销售条件键（如 "媚薬"、"禁断的知識"）
;   buy_func    TEXT                 —— 购买处理函数名（空则使用默认 ITEM_BUY_UNIQUE）
;   is_custom   INTEGER DEFAULT 0    —— 是否为自定义物品（0/1）
;   shop_cond   TEXT                 —— 商店条件（如 "MAGIC_DLC"）
;
; 共享表：_meta (key TEXT PRIMARY KEY, value TEXT)
;   本模块使用的键：'item_schema_version'
;
; 函数一览：
;   @QOL_ITEM_INIT                          初始化：建表、检查版本、按需注册数据
;   @QOL_ITEM_DATA_SET(...)                 写入/更新一条物品记录，同时写入 MAP 缓存
;   @QOL_ITEM_DATA_REGISTER                 批量注册所有物品数据
;   @QOL_ITEM_HAS_TAG(ARG, ARGS, ARGS:1)    判断物品是否拥有指定标签（类型或商店）
;   @QOL_ITEM_GET_SALES(ARG)                获取物品可购买数量（根据销售模式判断）
;   @QOL_ITEM_SALES_COND(ARG)               根据条件键判断销售条件是否满足
;   @QOL_ITEM_BUY(ARG, ARG:1)               购买物品（动态派发到 buy_func 指定的函数）
;   @QOL_ITEMDATA(ARG, ARGS, ARG:1)         物品数据统一查询入口
;   @QOL_ITEM_SHOP_COND(ARG, ARGS)          判断商店条件是否满足
;   @QOL_ITEM_MISC(ARG, ARGS, ARG:1)        杂项物品判断
;   @QOL_ITEM_DEBUG_DUMP                    调试用：打印全部物品数据
;
; SQL语法说明：
;   本模块同时使用参数化查询（SQL_P_*）和字符串拼接查询（SQL_EXECUTE_*）。
;   参数化查询用于含用户输入的场景，字符串拼接用于固定 SQL（如 CREATE TABLE）。
;   注意：QOL_ITEM_DATA_SET 使用字符串拼接而非参数化，因为 types/shops 等字段
;   包含大量特殊字符，参数化处理更复杂。此处数据来源为硬编码，无 SQL 注入风险。
;
;   INSERT OR REPLACE INTO ... VALUES (id, '%TYPES%', ...)
;     → 使用 %...% 内嵌表达式直接拼接字符串值，单引号包裹。
;     → 适用于数据来源可信、不含单引号的场景。
;
;   SELECT sales_mode FROM QOL_ITEM_DB WHERE item_id = {ARG}
;     → 使用 {} 内嵌表达式拼接整数主键，无需参数化。
;
;_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/#

;================================================
;@QOL_ITEM_INIT
;初始化物品数据库。建表后检查 schema 版本，不匹配则重新注册数据。
;================================================
@QOL_ITEM_INIT
#LOCALSIZE 1
#LOCALSSIZE 1
SQL_CONNECT "QOL_DISH_DB", "Data Source=plugins/qol_data.db"
SQL_EXECUTE_NONQUERY "QOL_DISH_DB", @"CREATE TABLE IF NOT EXISTS QOL_ITEM_DB (item_id INTEGER PRIMARY KEY, types TEXT, shops TEXT, sales_mode TEXT, sales_cond TEXT, buy_func TEXT, is_custom INTEGER DEFAULT 0, shop_cond TEXT)"
SQL_EXECUTE_NONQUERY "QOL_DISH_DB", @"CREATE TABLE IF NOT EXISTS _meta (key TEXT PRIMARY KEY, value TEXT)"
LOCALS '= SQL_P_EXECUTE_SCALAR_STRING("QOL_DISH_DB", "SELECT value FROM _meta WHERE key = 'item_schema_version'")
SIF LOCALS != @"{NOW_VERSION}"
	CALL QOL_ITEM_DATA_REGISTER



;================================================
;@QOL_ITEM_DATA_SET
;写入或更新一条物品记录。同时将数据写入 MAP 缓存（QOL_ITEM_TYPES 等）以加速运行时查询。
;ITEM_ID     物品ID（主键）
;TYPES       类型标签（"/"分隔）
;SHOPS       所属商店（"/"分隔）
;SALES_MODE  销售模式
;SALES_COND  销售条件键
;BUY_FUNC    购买处理函数名
;IS_CUSTOM   是否自定义物品
;SHOP_COND   商店条件
;注意：此处使用字符串拼接而非参数化，因数据来源为硬编码。
;================================================
@QOL_ITEM_DATA_SET(ITEM_ID, TYPES, SHOPS, SALES_MODE, SALES_COND = "", BUY_FUNC = "", IS_CUSTOM = 0, SHOP_COND = "")
#LOCALSIZE 2
#LOCALSSIZE 1
#DIM DYNAMIC ITEM_ID
#DIMS DYNAMIC TYPES
#DIMS DYNAMIC SHOPS
#DIMS DYNAMIC SALES_MODE
#DIMS DYNAMIC SALES_COND
#DIMS DYNAMIC BUY_FUNC
#DIM DYNAMIC IS_CUSTOM
#DIMS DYNAMIC SHOP_COND
SQL_P_EXECUTE_NONQUERY "QOL_DISH_DB", @"INSERT OR REPLACE INTO QOL_ITEM_DB (item_id, types, shops, sales_mode, sales_cond, buy_func, is_custom, shop_cond) VALUES ({ITEM_ID}, '%TYPES%', '%SHOPS%', '%SALES_MODE%', '%SALES_COND%', '%BUY_FUNC%', {IS_CUSTOM}, '%SHOP_COND%')"

