@QOL_ITEMDATA(ARG, ARGS, ARG:1)
#LOCALSIZE 1
#LOCALSSIZE 1
SIF ITEMNAME:ARG == ""
	RETURN 0
SELECTCASE ARGS
CASE "SALES"
	RETURN QOL_ITEM_GET_SALES(ARG)
CASE "購入"
	CALL QOL_ITEM_BUY(ARG, ARG:1)
	RETURN RESULT
CASEELSE
	IF STRFIND(ARGS, "TYPE:") == 0
		SIF QOL_ITEM_HAS_TAG(ARG, SUBSTRING(ARGS, 5), "TYPE")
			RETURN 1
	ELSEIF STRFIND(ARGS, "SHOP:") == 0
		SIF QOL_ITEM_HAS_TAG(ARG, SUBSTRING(ARGS, 5), "SHOP") && QOL_ITEM_SHOP_COND(ARG, SUBSTRING(ARGS, 5))
			RETURN 1
	ELSE
		RETURN QOL_ITEM_MISC(ARG, ARGS, ARG:1)
	ENDIF
ENDSELECT

@QOL_ITEM_SHOP_COND(ARG, ARGS)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTION
#DIMS DYNAMIC COND_KEY
IF MAP_HAS("QOL_ITEM_SHOP_COND", TOSTR(ARG))
	COND_KEY '= MAP_GET("QOL_ITEM_SHOP_COND", TOSTR(ARG))
ELSE
	RETURNF 1
ENDIF
SELECTCASE COND_KEY
CASE "MAGIC_DLC"
	SIF ARGS == "通信販売"
		RETURNF MAGIC_DLC
ENDSELECT
RETURNF 1

@QOL_ITEM_MISC(ARG, ARGS, ARG:1)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTION
SELECTCASE ARGS
CASE "特殊"
	SIF QOL_ITEM_HAS_TAG(ARG, "特殊", "TYPE")
		RETURNF 1
CASE "其他"
	SIF ARG == [[守矢之守札]] || ARG == [[壊掉的傘]] || ARG == [[作業]]
		RETURNF 1
ENDSELECT
RETURNF 0
