;_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/#
;
;Module   :qol_graph.ERH
;Facility :寻路图数据库的全局变量声明
;Licence  :许可证自由(CC0)。
;
; 本文件声明 MOVEMENT_GRAPH SQL 存储系统使用的全局常量和变量。
; 寻路数据是静态数据——图结构由 CAN_MOVE 定义，不随游戏运行时变化。
; 底层存储使用 SQLite（共享 QOL_DISH_DB 连接），替代 ERB 全局变量和字符串邻接表。
;
; 数据库表：
;   GRAPH_EDGE          —— 据点内邻接表（边表）
;   GRAPH_DISTANCE      —— 据点内距离矩阵（全源最短路径）
;   GRAPH_CROSS_MAP_EDGE —— 跨地图虚拟边（ENTRANCE 之间的连接）
;   GRAPH_NODE_ATTR     —— 地点属性（从 ODEKAKEMAP_SETTING 提取）
;
;_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/#

;数据库连接名（与 qol_db.ERB 共享）
#DIMS CONST GRAPH_DB_NAME = "QOL_DISH_DB"

;Schema 版本键（写入 _meta 表）
#DIMS CONST GRAPH_SCHEMA_KEY = "graph_schema_version"

;每个据点最大节点数（区域番号 0-99）
#DIM CONST GRAPH_NODE_MAX = 100

;每个节点最大邻居数（实测全局最大值 = 9，预留余量）
#DIM CONST GRAPH_NEIGHBOR_MAX = 15

;据点总数
#DIM CONST GRAPH_MAP_COUNT = 12

;不可达标记（与 __INT_MAX__ 等价，用于 BFS 初始化）
#DIM CONST GRAPH_UNREACHABLE = 2147483647
