;_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/#
;
;Module   :qol_graph.ERH
;Facility :寻路图数据库的全局常量声明
;Licence  :许可证自由(CC0)。
;
; 寻路数据通过导出函数（CAN_MOVE_FOR_GRAPH / ODEKAKEMAP_SETTING_FOR_GRAPH /
; GET_ENTRANCE_FOR_GRAPH）绕过 MAIN_MAP 守卫，可在 TITLE 阶段初始化。
; GMF 开关切换后需重建图数据（由幻想乡地图重修.ERB 调用 GRAPH_DB_REBUILD_ALL）。
; 底层存储使用 SQLite（共享 QOL_DISH_DB 连接）。
;
; 数据库表：
;   GRAPH_EDGE          —— 据点内邻接表（边表）
;   GRAPH_DISTANCE      —— 据点内距离矩阵（全源最短路径）
;   GRAPH_CROSS_MAP_EDGE —— 跨地图虚拟边（ENTRANCE 之间的连接）
;   GRAPH_NODE_ATTR     —— 地点属性（从 ODEKAKEMAP_SETTING 提取）
;
;_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/#

;数据库连接名（与 qol_db.ERB 共享，SQLite 文件 = plugins/qol_data.db）
#DIMS CONST GRAPH_DB_NAME = "QOL_DISH_DB"

;Schema 版本键（写入 _meta 表，游戏版本更新后自动触发全量重建）
#DIMS CONST GRAPH_SCHEMA_KEY = "graph_schema_version"

;每个据点最大节点数（区域番号 0-99）
#DIM CONST GRAPH_NODE_MAX = 100

;每个节点最大邻居数（实测全局最大值 = 9，预留余量）
#DIM CONST GRAPH_NEIGHBOR_MAX = 15

;据点总数（0-11，对应 GET_EXISTMAP 遍历范围）
#DIM CONST GRAPH_MAP_COUNT = 12

;不可达标记（BFS 初始时所有节点距离设为此值，访问后更新为实际距离）
#DIM CONST GRAPH_UNREACHABLE = 2147483647

;寻路深度限制（COMF400 等消费者使用）
#DIM CONST 最大寻路深度 = 30
#DIM CONST 大地图最大寻路深度 = 60

;地点数上限
#DIM CONST MAX_LOCATIONS = 100
