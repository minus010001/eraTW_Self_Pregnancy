;@QOL_MUSHI_GET_DESC(MUSHI_ID, DESC_NUM)
;获取昆虫图鉴描述的指定行（1～5）。
;MUSHI_ID  昆虫ID
;DESC_NUM  描述行号（1～5，对应 desc1～desc5 列）
;RETURNF   描述文本字符串
;SQL: SELECT desc{N} FROM QOL_MUSHI_DB WHERE mushi_id = @0
;  → 动态拼接列名 desc{DESC_NUM}，通过 %COL_NAME% 内嵌到 SQL
;  → 注意：列名由代码控制，非用户输入，拼接安全
;================================================
@QOL_MUSHI_GET_DESC(MUSHI_ID, DESC_NUM)
#FUNCTIONS
#DIM DYNAMIC MUSHI_ID
#DIM DYNAMIC DESC_NUM
#DIMS DYNAMIC COL_NAME
COL_NAME '= @"desc{DESC_NUM}"
LOCALS '= SQL_P_EXECUTE_SCALAR_STRING("QOL_DISH_DB", @"SELECT %COL_NAME% FROM QOL_MUSHI_DB WHERE mushi_id = @0", TOSTR(MUSHI_ID))
RETURNF LOCALS

;================================================
;@QOL_MUSHI_LOAD(MUSHI_ID)
;从数据库加载昆虫全部属性到全局变量（MUSHI_NAME, MUSHI_RARE 等）。
;使用 SQL_P_EXECUTE_READER 执行多列查询，通过 SQL_READER_READ 逐行读取，
;SQL_READER_GET_STRING/LONG 按列索引取值，最后 SQL_READER_CLOSE 关闭游标。
;MUSHI_ID  昆虫ID
;RETURN    1=加载成功，0=昆虫不存在（名称为空）
;SQL: SELECT name, rare, tribe, type, field, area, favos, size, hp, atk, spd, skl, ...
;     FROM QOL_MUSHI_DB WHERE mushi_id = @0
;  → 参数化 Reader 查询，一次读取多列避免多次单字段查询
;================================================
@QOL_MUSHI_LOAD(MUSHI_ID)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC MUSHI_ID
#DIM DYNAMIC reader
reader = SQL_P_EXECUTE_READER("QOL_DISH_DB", "SELECT mushi_id, name, rare, tribe, type, field, area, favos, size, hp, atk, spd, skl, has_dynamic, gettable, desc1, desc2, desc3, desc4, desc5 FROM QOL_MUSHI_DB WHERE mushi_id = @0", TOSTR(MUSHI_ID))
IF SQL_READER_READ(reader)
	MUSHI_NAME '= SQL_READER_GET_STRING(reader, COL_MUSHI_NAME)
	MUSHI_RARE = SQL_READER_GET_LONG(reader, COL_MUSHI_RARE)
	MUSHI_TRIBE '= SQL_READER_GET_STRING(reader, COL_MUSHI_TRIBE)
	MUSHI_TYPE '= SQL_READER_GET_STRING(reader, COL_MUSHI_TYPE)
	MUSHI_FIELD = SQL_READER_GET_LONG(reader, COL_MUSHI_FIELD)
	MUSHI_SIZE = SQL_READER_GET_LONG(reader, COL_MUSHI_SIZE)
	MUSHI_HP = SQL_READER_GET_LONG(reader, COL_MUSHI_HP)
	MUSHI_ATK = SQL_READER_GET_LONG(reader, COL_MUSHI_ATK)
	MUSHI_SPD = SQL_READER_GET_LONG(reader, COL_MUSHI_SPD)
	MUSHI_SKL '= SQL_READER_GET_STRING(reader, COL_MUSHI_SKL)
ENDIF
SQL_READER_CLOSE reader
SIF MUSHI_NAME == ""
	RETURN 0
RETURN 1

;================================================
;@QOL_MUSHI_DYNAMIC(MUSHI_ID)
;获取角色关联昆虫的动态描述。目前仅 ID 3（拉尔瓦关联蝴蝶）和
;ID 71（莉格露关联蓝色小家伙）有动态描述，描述中包含角色颜色代码。
;MUSHI_ID  昆虫ID
;RESULTS:1～RESULTS:4  动态描述文本（通过 RESULTS 数组返回）
;================================================
@QOL_MUSHI_DYNAMIC(MUSHI_ID)
#LOCALSIZE 2
#LOCALSSIZE 1
#DIM DYNAMIC MUSHI_ID
#DIM DYNAMIC LOCAL_COLOR
#DIM DYNAMIC DYN_COLOR
VARSET RESULTS
SELECTCASE MUSHI_ID
CASE 3
	LOCAL_COLOR = GETCOLOR()
	CALL SET_KOJO_COLOR([[ラルバ]])
	DYN_COLOR = GETCOLOR()
	SIF GETCOLOR() == GETDEFCOLOR()
		DYN_COLOR = 0x6FC0DA
	RESULTS:1 '= @"一种以美丽和尺寸而闻名的蝴蝶。"
	RESULTS:2 '= @"它看起来很像@HEX@{DYN_COLOR}@拉尔瓦@。"
	SETCOLOR LOCAL_COLOR
CASE 71
	LOCAL_COLOR = GETCOLOR()
	CALL SET_KOJO_COLOR([[リグル]])
	DYN_COLOR = GETCOLOR()
	SIF GETCOLOR() == GETDEFCOLOR()
		DYN_COLOR = 0x099674
	RESULTS:1 '= @"根据对@HEX@{DYN_COLOR}@莉格露@的采访，这个蓝色小家伙在定居幻想乡之前经历过许多离奇的冒险。"
	RESULTS:2 '= @"它“目睹了一位算命师被谋杀”，然后凶手“救了它，使它免于被一个孩子压碎”。"
	RESULTS:3 '= @"接着它“拜访了一个住着会说话的动物的岛屿”，并“帮助它在豪宅里的巨型蜜蜂室友保卫一个风之纹章”。"
	RESULTS:4 '= @"……大概只是一堆胡言乱语吧。"
	SETCOLOR LOCAL_COLOR
ENDSELECT

;================================================
;@QOL_MUSHI_GETABLE_SET(COND_KEY, ARG:0, ARG:1, ...)
;批量设置昆虫的捕捉条件。将指定的条件键写入多个昆虫的 gettable 字段。
;COND_KEY  条件键字符串（如 "昼間"、"夏AND夜間"、"0" 等，详见 GET_GETABLE）
;ARG:*     要设置的昆虫ID列表（-1 为终止标记）
;SQL: UPDATE QOL_MUSHI_DB SET gettable = '%COND_KEY%' WHERE mushi_id = {ARG:LOCAL}
;  → 使用字符串拼接更新，因条件键和ID均为可信硬编码数据
;================================================
@QOL_MUSHI_GETABLE_SET(COND_KEY, ARG:0 = -1, ARG:1 = -1, ARG:2 = -1, ARG:3 = -1, ARG:4 = -1, ARG:5 = -1, ARG:6 = -1, ARG:7 = -1, ARG:8 = -1, ARG:9 = -1, ARG:10 = -1, ARG:11 = -1, ARG:12 = -1, ARG:13 = -1, ARG:14 = -1, ARG:15 = -1, ARG:16 = -1, ARG:17 = -1, ARG:18 = -1, ARG:19 = -1, ARG:20 = -1, ARG:21 = -1, ARG:22 = -1, ARG:23 = -1, ARG:24 = -1, ARG:25 = -1, ARG:26 = -1, ARG:27 = -1, ARG:28 = -1, ARG:29 = -1, ARG:30 = -1, ARG:31 = -1, ARG:32 = -1, ARG:33 = -1, ARG:34 = -1, ARG:35 = -1, ARG:36 = -1)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS DYNAMIC COND_KEY
FOR LOCAL, 0, 37
	SIF ARG:LOCAL == -1
		BREAK
	SQL_P_EXECUTE_NONQUERY "QOL_DISH_DB", @"UPDATE QOL_MUSHI_DB SET gettable = '%COND_KEY%' WHERE mushi_id = {ARG:LOCAL}"
NEXT

;==============================================================
; 昆虫捕捉条件注册表（GETABLE）—— 此注释块已在原代码中存在
;==============================================================
;================================================
;@QOL_MUSHI_GET_GETABLE(MUSHI_ID)
;判断当前游戏状态下指定昆虫是否可捕捉。从数据库读取 gettable 条件键，
;根据键值进行时间/天气/季节/地点等判断。
;条件键含义详见上方注释块。
;MUSHI_ID  昆虫ID
;RETURNF   1=可捕捉，0=不可捕捉
;SQL: SELECT gettable FROM QOL_MUSHI_DB WHERE mushi_id = @0
;  → 参数化查询获取条件键字符串，再进入 SELECTCASE 判断游戏逻辑
;================================================
@QOL_MUSHI_GET_GETABLE(MUSHI_ID)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC MUSHI_ID
#DIMS DYNAMIC COND_STR
COND_STR '= SQL_P_EXECUTE_SCALAR_STRING("QOL_DISH_DB", "SELECT gettable FROM QOL_MUSHI_DB WHERE mushi_id = @0", TOSTR(MUSHI_ID))
SELECTCASE COND_STR
CASE "0"
	RETURNF 0
CASE "", "1"
	RETURNF 1
CASE "昼間"
	RETURNF INRANGE(TIME, 360, 1080)
CASE "夜間"
	RETURNF !INRANGE(TIME, 360, 1080)
CASE "深夜"
	RETURNF INRANGE(TIME, 0, 300)
CASE "暁"
	RETURNF INRANGE(TIME, 240, 360) || INRANGE(TIME, 840, 1080)
CASE "春"
	RETURNF GET_MONTH() == "春之月"
CASE "夏"
	RETURNF GET_MONTH() == "夏之月"
CASE "秋"
	RETURNF GET_MONTH() == "秋之月"
CASE "雨天"
	RETURNF GROUPMATCH(天候, 4, 5, 6, 7) || FLAG:異常気象 == 9
CASE "0の付く日"
	RETURNF GROUPMATCH(DAY:3, 10, 20, 30)
CASE "月初め"
	RETURNF GROUPMATCH(DAY:3, 1, 2, 3)
CASE "后户"
	RETURNF IS_HERE(122) || IS_HERE(123) || IS_HERE(124)
CASE "夏AND夜間"
	RETURNF (GET_MONTH() == "夏之月") && !INRANGE(TIME, 360, 1080)
CASE "夏AND深夜"
	RETURNF (GET_MONTH() == "夏之月") && INRANGE(TIME, 0, 300)
CASE "春AND昼間"
	RETURNF (GET_MONTH() == "春之月") && INRANGE(TIME, 360, 1080)
CASE "春AND夜間"
	RETURNF (GET_MONTH() == "春之月") && !INRANGE(TIME, 360, 1080)
CASEELSE
	RETURNF 1
ENDSELECT

