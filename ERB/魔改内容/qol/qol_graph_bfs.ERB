;_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/#
;
;Module   :qol_graph_bfs.ERB
;Facility :据点内全源 BFS——从 GRAPH_EDGE 读取邻接表，计算距离/前驱矩阵写入 GRAPH_DISTANCE
;Licence  :许可证自由(CC0)。
;
; 本模块对指定据点的每个有效节点执行 BFS（边权恒为 1），
; 将最短距离和前驱节点写入 GRAPH_DISTANCE 表。
;
; 算法说明：
;   虽然名为 BFS，但与 Dijkstra 在边权恒为 1 时等价。
;   使用环形缓冲区队列（双指针），避免 ARRAYREMOVE 的 O(N) 开销。
;   邻接表从 SQL 预加载到 ERB 数组，避免 BFS 内循环中的 SQL 查询。
;
;_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/#

;================================================
;@GRAPH_DB_BFS_MAP(MAPID)
;对指定据点执行全源 BFS，结果写入 GRAPH_DISTANCE。
;参数：MAPID = 据点编号（0-11）
;================================================
@GRAPH_DB_BFS_MAP(MAPID)
#DIM MAPID
#DIM L_SOURCE
#DIM L_READER
#DIM L_CURRENT
#DIM L_CURRENT_IDX
#DIM L_NEXT_IDX
#DIM L_DIST
#DIM L_QUEUE_HEAD
#DIM L_QUEUE_TAIL
#DIM L_I
#DIM L_J
#DIM L_EDGE_COUNT
#DIM DYNAMIC L_QUEUE, GRAPH_NODE_MAX
#DIM DYNAMIC L_DISTANCE, GRAPH_NODE_MAX
#DIM DYNAMIC L_PREVIOUS, GRAPH_NODE_MAX
#DIM DYNAMIC L_VALID, GRAPH_NODE_MAX
#DIM DYNAMIC L_NEIGHBORS, GRAPH_NODE_MAX, GRAPH_NEIGHBOR_MAX
#DIM DYNAMIC L_NEIGHBOR_COUNT, GRAPH_NODE_MAX

VARSET L_VALID, 0
VARSET L_NEIGHBOR_COUNT, 0

L_READER = SQL_P_EXECUTE_READER(GRAPH_DB_NAME, "SELECT from_node, to_node FROM GRAPH_EDGE WHERE map_id = @0 AND can_move = 1", TOSTR(MAPID))
WHILE SQL_READER_READ(L_READER)
	L_CURRENT_IDX = SQL_READER_GET_LONG(L_READER, 0)
	L_NEXT_IDX = SQL_READER_GET_LONG(L_READER, 1)
	L_VALID:L_CURRENT_IDX = 1
	L_VALID:L_NEXT_IDX = 1
	L_J = L_NEIGHBOR_COUNT:L_CURRENT_IDX
	IF L_J < GRAPH_NEIGHBOR_MAX
		L_NEIGHBORS:L_CURRENT_IDX:L_J = L_NEXT_IDX
		L_NEIGHBOR_COUNT:L_CURRENT_IDX++
	ENDIF
WEND
SQL_READER_CLOSE L_READER

FOR L_SOURCE, 0, GRAPH_NODE_MAX
	SIF !L_VALID:L_SOURCE
		CONTINUE
	VARSET L_DISTANCE, GRAPH_UNREACHABLE
	VARSET L_PREVIOUS, -1
	VARSET L_QUEUE, 0
	L_QUEUE_HEAD = 0
	L_QUEUE_TAIL = 0
	L_DISTANCE:L_SOURCE = 0
	L_QUEUE:(L_QUEUE_TAIL++) = L_SOURCE

	WHILE L_QUEUE_HEAD < L_QUEUE_TAIL
		L_CURRENT_IDX = L_QUEUE:L_QUEUE_HEAD
		L_QUEUE_HEAD++
		L_DIST = L_DISTANCE:L_CURRENT_IDX + 1

		FOR L_J, 0, L_NEIGHBOR_COUNT:L_CURRENT_IDX
			L_NEXT_IDX = L_NEIGHBORS:L_CURRENT_IDX:L_J
			SIF L_DIST >= L_DISTANCE:L_NEXT_IDX
				CONTINUE
			L_DISTANCE:L_NEXT_IDX = L_DIST
			L_PREVIOUS:L_NEXT_IDX = L_CURRENT_IDX
			L_QUEUE:(L_QUEUE_TAIL++) = L_NEXT_IDX
		NEXT
	WEND

	FOR L_CURRENT, 0, GRAPH_NODE_MAX
		SIF !L_VALID:L_CURRENT
			CONTINUE
		SQL_P_EXECUTE_NONQUERY GRAPH_DB_NAME, "INSERT OR REPLACE INTO GRAPH_DISTANCE (map_id, source, target, distance, previous) VALUES (@0, @1, @2, @3, @4)", TOSTR(MAPID), TOSTR(L_SOURCE), TOSTR(L_CURRENT), TOSTR(L_DISTANCE:L_CURRENT), TOSTR(L_PREVIOUS:L_CURRENT)
	NEXT
NEXT
