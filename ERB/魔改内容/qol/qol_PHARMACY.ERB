@QOL_PHARMACY_INIT
#LOCALSIZE 1
#LOCALSSIZE 1
IF !MAP_EXIST("QOL_PHARMA_RANKS")
	MAP_CREATE "QOL_PHARMA_RANKS"
	CALL QOL_PHARMA_RANK_REGISTER
ENDIF
IF !MAP_EXIST("QOL_CRAFT_COND_TYPE")
	MAP_CREATE "QOL_CRAFT_COND_TYPE"
	MAP_CREATE "QOL_CRAFT_COND_CHARA"
	MAP_CREATE "QOL_CRAFT_COND_VAL"
	CALL QOL_CRAFT_COND_REGISTER
ENDIF
IF !DT_EXIST("QOL_RECIPE_DB")
	DT_CREATE "QOL_RECIPE_DB"
	DT_COLUMN_ADD "QOL_RECIPE_DB", "product_id", "int32"
	DT_COLUMN_ADD "QOL_RECIPE_DB", "recipe_num", "int32"
	DT_COLUMN_ADD "QOL_RECIPE_DB", "ingredients", "string"
	DT_COLUMN_ADD "QOL_RECIPE_DB", "amount", "int32"
	DT_COLUMN_ADD "QOL_RECIPE_DB", "water", "int8"
	DT_COLUMN_ADD "QOL_RECIPE_DB", "lot", "int32"
	DT_COLUMN_ADD "QOL_RECIPE_DB", "is_custom", "int8"
	CALL QOL_RECIPE_LOAD_XML
	SIF DT_ROW_LENGTH("QOL_RECIPE_DB") == 0
		CALL QOL_RECIPE_DATA_REGISTER
ENDIF

