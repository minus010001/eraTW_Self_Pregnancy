@QOL_RECIPE_LOAD_XML
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS DYNAMIC schema
#DIMS DYNAMIC data_xml
schema '= LOADTEXT("plugins/QOL/qol_recipe_schema.xml")
data_xml '= LOADTEXT("plugins/QOL/qol_recipe_data.xml")
SIF STRLENS(data_xml) == 0
	RETURN
DT_FROMXML "QOL_RECIPE_DB", schema, data_xml

