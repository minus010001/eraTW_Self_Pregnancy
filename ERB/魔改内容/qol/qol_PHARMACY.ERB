		SETCOLOR 0x606060
	ENDIF
	PRINTFORML [{PHARMACY_ID}] 晋升魔药Lv{ PHARMACY_ID - 260 }
	RESETCOLOR
	FIRST_ITEM = 0
NEXT

@QOL_PHARMACY_LIST_BUTTON(PHARMACY_ID, LINE_POS, CAN_CRAFT, FIRST_ITEM)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC PHARMACY_ID
#DIM REF LINE_POS, 0
#DIM DYNAMIC CAN_CRAFT
#DIM DYNAMIC FIRST_ITEM
#DIMS DYNAMIC ITEM_NAME
#DIMS DYNAMIC BUTTON_STR
ITEM_NAME '= @"%ITEMNAME_TR(PHARMACY_ID), 24, LEFT%"
BUTTON_STR '= @"[{PHARMACY_ID, 3}] %ITEM_NAME%"
LINE_POS:1 += STRLENS(BUTTON_STR)
SIF LINE_POS:0 < 100
	LINE_POS:1 ++
IF !FIRST_ITEM && LINE_POS:1 > 116
	IF LINE_POS:1 >= 999
	ELSE
		PRINTL
	ENDIF
	LINE_POS:1 = STRLENS(BUTTON_STR)
	SIF LINE_POS:0 < 100
		LINE_POS:1 ++
	PRINT 　
ELSEIF FIRST_ITEM
	LINE_POS:1 = STRLENS(BUTTON_STR)
	SIF LINE_POS:0 < 100
		LINE_POS:1 ++
	PRINT 　
ELSE
ENDIF
IF !CAN_CRAFT
	SETCOLOR 0x666666
ENDIF
PRINTFORM %BUTTON_STR%
RESETCOLOR

