;================================================
;@QOL_PHARMA_DEBUG_DUMP
;调试用：打印 QOL_CRAFT_RECIPE 和 QOL_ITEM_META 中全部数据。
;SQL: SELECT ... FROM QOL_CRAFT_RECIPE ORDER BY product_id, recipe_num
;  → 使用 SQL_EXECUTE_READER 遍历全表
;SQL: SELECT ... FROM QOL_ITEM_META ORDER BY item_id
;  → 同上
;================================================
@QOL_PHARMA_DEBUG_DUMP
#LOCALSIZE 2
#LOCALSSIZE 1
#DIM DYNAMIC reader
#DIM DYNAMIC row_count
reader = SQL_EXECUTE_READER("QOL_DISH_DB", "SELECT product_id, recipe_num, ingredients, amount, water, lot, is_custom FROM QOL_CRAFT_RECIPE ORDER BY product_id, recipe_num")
PRINTFORML ----------------------------------------
PRINTFORML 制药配方数据库 (QOL_CRAFT_RECIPE)
PRINTFORML ----------------------------------------
row_count = 0
WHILE SQL_READER_READ(reader)
	row_count ++
	PRINTFORM #{SQL_READER_GET_LONG(reader, COL_RECIPE_PRODUCT_ID), 5}
	PRINTFORM  No.{SQL_READER_GET_LONG(reader, COL_RECIPE_NUM)}
	PRINTFORM  %SQL_READER_GET_STRING(reader, COL_RECIPE_INGREDIENTS), 30%
	PRINTFORM  x{SQL_READER_GET_LONG(reader, COL_RECIPE_AMOUNT)}
	PRINTFORM  W{SQL_READER_GET_LONG(reader, COL_RECIPE_WATER)}
	PRINTFORM  L{SQL_READER_GET_LONG(reader, COL_RECIPE_LOT)}
	SIF SQL_READER_GET_LONG(reader, COL_RECIPE_IS_CUSTOM)
		PRINTFORM  ★
	PRINTL 
WEND
SQL_READER_CLOSE reader
PRINTFORML ----------------------------------------
PRINTFORML 共 {row_count} 条配方记录
PRINTL 
reader = SQL_EXECUTE_READER("QOL_DISH_DB", "SELECT item_id, rank, cond_type, cond_chara_id, cond_req_val FROM QOL_ITEM_META ORDER BY item_id")
PRINTFORML ----------------------------------------
PRINTFORML 物品元数据 (QOL_ITEM_META)
PRINTFORML ----------------------------------------
row_count = 0
WHILE SQL_READER_READ(reader)
	SIF SQL_READER_ISNULL(reader, COL_META_ITEM_ID)
		CONTINUE
	row_count ++
	PRINTFORM #{SQL_READER_GET_LONG(reader, COL_META_ITEM_ID), 5}
	PRINTFORM  Rank:{SQL_READER_GET_LONG(reader, COL_META_RANK)}
	PRINTFORM  Cond:%SQL_READER_GET_STRING(reader, COL_META_COND_TYPE)%
	LOCAL:1 = SQL_READER_GET_LONG(reader, COL_META_COND_CHARA)
	SIF LOCAL:1 >= 0
		PRINTFORM  Chara:{LOCAL:1}
	LOCAL:1 = SQL_READER_GET_LONG(reader, COL_META_COND_VAL)
	SIF LOCAL:1
		PRINTFORM  Val:{LOCAL:1}
	PRINTL 
WEND
SQL_READER_CLOSE reader
PRINTFORML ----------------------------------------
PRINTFORML 共 {row_count} 条元数据记录
PRINTFORML schema_version: %SQL_P_EXECUTE_SCALAR_STRING("QOL_DISH_DB", "SELECT value FROM _meta WHERE key = 'pharma_schema_version'")%
PRINTFORML ----------------------------------------

