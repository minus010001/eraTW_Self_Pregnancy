;================================================
;@QOL_WOOD_LOAD(W_ID)
;批量加载木材全部属性到全局变量（WoodName, WoodValue_Log 等）。
;使用 Reader 一次查询多列，比多次 GET_* 调用更高效。
;W_ID    木材ID
;RETURN  1=加载成功，0=木材不存在
;SQL: SELECT name, value_log, value_plank, effort, item_id, intro1, intro2, tribe
;     FROM QOL_WOOD_DB WHERE wood_id = @0
;  → 参数化 Reader 查询，SQL_P_EXECUTE_READER 返回句柄
;  → SQL_READER_READ 推进到第一行，SQL_READER_GET_STRING/LONG 按列索引取值
;  → SQL_READER_CLOSE 关闭句柄释放资源
;================================================
@QOL_WOOD_LOAD(W_ID)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC W_ID
#DIM DYNAMIC reader
reader = SQL_P_EXECUTE_READER("QOL_DISH_DB", "SELECT name, value_log, value_plank, effort, item_id, intro1, intro2, tribe FROM QOL_WOOD_DB WHERE wood_id = @0", TOSTR(W_ID))
IF SQL_READER_READ(reader)
	WoodName '= SQL_READER_GET_STRING(reader, COL_WOOD_NAME)
	WoodValue_Log = SQL_READER_GET_LONG(reader, COL_WOOD_VALUE_LOG)
	WoodValue_Plank = SQL_READER_GET_LONG(reader, COL_WOOD_VALUE_PLANK)
	WoodEffort = SQL_READER_GET_LONG(reader, COL_WOOD_EFFORT)
	WoodItem = SQL_READER_GET_LONG(reader, COL_WOOD_ITEM_ID)
	WoodIntro1 '= SQL_READER_GET_STRING(reader, COL_WOOD_INTRO1)
	WoodIntro2 '= SQL_READER_GET_STRING(reader, COL_WOOD_INTRO2)
	WoodTribe '= SQL_READER_GET_STRING(reader, COL_WOOD_TRIBE)
ENDIF
SQL_READER_CLOSE reader
SIF WoodName == ""
	RETURN 0
RETURN 1

;================================================
;@QOL_WOOD_DEBUG_DUMP
;调试用：打印 QOL_WOOD_DB 中全部数据及 schema 版本。
;SQL: SELECT ... FROM QOL_WOOD_DB ORDER BY wood_id
;  → 使用 SQL_EXECUTE_READER（非参数化）遍历全表
;SQL: SELECT value FROM _meta WHERE key = 'wood_schema_version'
;  → 查询版本号
;================================================
@QOL_WOOD_DEBUG_DUMP
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC reader
reader = SQL_EXECUTE_READER("QOL_DISH_DB", "SELECT wood_id, name, value_log, value_plank, effort, item_id, intro1, intro2, tribe FROM QOL_WOOD_DB ORDER BY wood_id")
PRINTFORML ----------------------------------------
PRINTFORML 木材数据库
PRINTFORML ----------------------------------------
PRINTFORML %"ID", 4% %"名称", 10% %"原木价", 8% %"木料价", 8% %"耗时", 6% %"物品", 6% 标签
PRINTFORML %"-" * 80%
WHILE SQL_READER_READ(reader)
	SIF SQL_READER_ISNULL(reader, COL_WOOD_NAME)
		CONTINUE
	PRINTFORM {SQL_READER_GET_LONG(reader, COL_WOOD_ID), 4}
	PRINTFORM  %SQL_READER_GET_STRING(reader, COL_WOOD_NAME), 10%
	PRINTFORM  {SQL_READER_GET_LONG(reader, COL_WOOD_VALUE_LOG), 8}
	PRINTFORM  {SQL_READER_GET_LONG(reader, COL_WOOD_VALUE_PLANK), 8}
	PRINTFORM  {SQL_READER_GET_LONG(reader, COL_WOOD_EFFORT), 6}
	PRINTFORM  {SQL_READER_GET_LONG(reader, COL_WOOD_ITEM_ID), 6}
	PRINTFORML  %SQL_READER_GET_STRING(reader, COL_WOOD_TRIBE)%
WEND
SQL_READER_CLOSE reader
PRINTFORML ----------------------------------------
PRINTFORML schema_version: %SQL_P_EXECUTE_SCALAR_STRING("QOL_DISH_DB", "SELECT value FROM _meta WHERE key = 'wood_schema_version'")%
PRINTFORML ----------------------------------------
