@PRINT_TOUCH_INFO
#LOCALSIZE 1
#LOCALSSIZE 1
CALL INFO_CHARA_TOUCH(MASTER)
SIF TARGET > 0
	CALL INFO_CHARA_TOUCH(TARGET)
SIF ASSI > 0
	CALL INFO_CHARA_TOUCH(ASSI)
WAIT

@INFO_CHARA_TOUCH(C_ID)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM	DYNAMIC	C_ID
#DIM	DYNAMIC	BODY_PARTS
;#DIMS CONST PARTS_NAME = "阴茎", "阴蒂", "指", "口", "胸", "膣", "肛門", "足"
;#DIMS CONST POSITION_NAME = "正常位", "后背位", "骑乘位" , "对面位", "背面位", "小人飞机杯"
PRINTFORML %CALLNAME:C_ID%的接触：
FOR BODY_PARTS, 1, 9
	SIF ADD_SEX_MODULE_PARTNAME(BODY_PARTS) == "阴茎" && !GETBIT(TALENT:C_ID:性別, 1)
		CONTINUE
	PRINTFORM %ADD_SEX_MODULE_PARTNAME(BODY_PARTS), 4, LEFT%　－　
	IF TEQUIP:C_ID:(100 + BODY_PARTS) == 0
		PRINTFORM 无
	ELSE 
		PRINTFORM %ADD_SEX_MODULE_PARTNAME(TEQUIP:C_ID:(100 + BODY_PARTS)), 4, LEFT%
	ENDIF
	PRINTL
NEXT
IF CFLAG:C_ID:诶嘿嘿 > 0
	PRINTFORM %CALLNAME:C_ID%的体位：
	IF TEQUIP:C_ID:体位 > 0
		PRINTFORM %ADD_SEX_MODULE_POSE(TEQUIP:C_ID:体位)%
	ELSE
		PRINTFORM 无
	ENDIF
	PRINTL
ENDIF

;理论受孕概率
@INFO_理论受孕概率(C_ID = -1,ARG = -1)
#LOCALSIZE 6
#LOCALSSIZE 1
#DIM	DYNAMIC	C_ID
SIF C_ID == -1
	C_ID = TARGET
SIF ARG == -1
	ARG = MASTER
IF HAS_VAGINA(C_ID) && (EX:C_ID:膣内精液 || SEMEN_MATRIX:C_ID:ARG:子宫内射精量)
	LOCAL = 验算用宫内精液量(C_ID,ARG)
	LOCAL:1 = 充填率(C_ID,6,,LOCAL)
	IF LOCAL:1 >= 100
		SETCOLOR C_PINK
	ELSEIF LOCAL:1 > 20
		SETCOLOR C_YELLOW
	ENDIF
	LOCAL:3 = 理论受孕概率(C_ID,ARG,LOCAL)
	IF (TALENT:C_ID:幼稚 && !TALENT:C_ID:初潮) || QOL_IS_IN_RECOVERY(C_ID) || CFLAG:C_ID:WithChildCount >= MAXCHILD
		SETCOLOR C_GRAY
		PRINTFORM ※受孕:不可
	ELSEIF (GETBIT(BABYDLC,1) && LOCAL:1 && REAL_ESTRUS_CYCLE(C_ID) > 40)
		CALL PRINT_RAINBOW2,"※受孕:一发入魂"
	ELSE
		LOCAL:4 = LOCAL:3 / 100
		LOCAL:5 = LOCAL:3 % 100
		PRINTFORM 理论受孕概率:{LOCAL:4}.\@ LOCAL:5<10 ? 0 # \@{LOCAL:5}％
	ENDIF
	RESETCOLOR
	PRINT  
ENDIF

;返回理论受孕概率的万分数
@理论受孕概率(C_ID = -1, ARG = -1, 验算用宫内精液量 = -1)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM	DYNAMIC	C_ID
#DIM	DYNAMIC 验算用宫内精液量
SIF C_ID == -1
	C_ID = TARGET
SIF ARG == -1
	ARG = MASTER
SIF 验算用宫内精液量 == -1
	验算用宫内精液量 = 验算用宫内精液量(C_ID,ARG)

SIF (!TALENT:C_ID:初潮 && (TALENT:C_ID:幼稚 || TALENT:C_ID:幼児／幼児退行)) || Qol_IS_IN_RECOVERY(C_ID)
	验算用宫内精液量 = 0
RETURNF 100 * 充填率(C_ID,6,,验算用宫内精液量) * REAL_ESTRUS_CYCLE(C_ID) / 妊娠必要值(C_ID,ARG)

@验算用宫内精液量(C_ID = -1,ARG = -1)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM	DYNAMIC	C_ID
SIF C_ID == -1
	C_ID = TARGET
SIF ARG == -1
	ARG = MASTER
LOCAL = SEMEN_MATRIX:C_ID:ARG:子宫内射精量
LOCAL += SEMEN_MATRIX:C_ID:ARG:膣内射精量 / 中毒補正(C_ID)
SIF LOCAL > SEMEN_MATRIX:C_ID:ARG:膣内射精量
	LOCAL = SEMEN_MATRIX:C_ID:ARG:膣内射精量
RETURNF LOCAL