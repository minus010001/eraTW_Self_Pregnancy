;
;Module   :qol_graph_watchers.ERB
;Facility :远处观察者显示——从寻路图可见性数据检测并显示远处可见的角色
;Licence  :许可证自由(CC0)
;
; 调用位置：ANOTHER_TALK.ERB @情景描写 末尾
;
; 显示逻辑：
;   1. 查询当前位置的可见地点列表（GRAPH_CAN_SEE_FROM）
;   2. 遍历可见地点中的角色
;   3. 根据角色状态（诶嘿嘿/潜伏/无知/恋慕等）生成不同观察文本
;
;_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/_/#

;================================================
;@QOL_DISTANT_WATCHERS
;检测并显示从当前位置可见的远处角色
;
; 守卫条件：
;   - 角色必须在当前据点（GET_MAPID == MAIN_MAP）
;   - 不在招待室（OMANEKIBEYA）
;
; 流程：
;   1. GRAPH_CAN_SEE_FROM → 获取可见地点列表
;   2. 遍历可见地点，收集在场的角色
;   3. 根据角色数量和状态生成观察文本
;================================================
@QOL_DISTANT_WATCHERS
#DIMS DYNAMIC CHARACTERS
#DIM DYNAMIC TOTAL_CHARACTERS
#DIM DYNAMIC LAST_CHARACTER
#DIM DYNAMIC L_VISIBLE_COUNT
#DIM DYNAMIC L_I

SIF GET_MAPID(CFLAG:MASTER:現在位置) != MAIN_MAP || CFLAG:MASTER:現在位置 == OMANEKIBEYA()
	RETURN

;GRAPH_CAN_SEE_FROM 返回可见地点数量，RESULT:0~N 存放場所ID
L_VISIBLE_COUNT = GRAPH_CAN_SEE_FROM(CFLAG:MASTER:現在位置)

FOR L_I, 0, L_VISIBLE_COUNT
	SIF RESULT:L_I < 0
		BREAK
	FOR LOCAL, 1, CHARANUM
		IF CFLAG:LOCAL:現在位置 == RESULT:L_I
			CHARACTERS += @"%CALLNAME:LOCAL%、"
			TOTAL_CHARACTERS++
			LAST_CHARACTER = LOCAL
		ENDIF
	NEXT
NEXT

SIF !TOTAL_CHARACTERS
	RETURN

PRINTFORM ◆
IF CFLAG:MASTER:诶嘿嘿 && GETBIT(FLAG:潜伏,0)
	PRINTFORMDL 你隐约看到远处有%LIST_IN_STRING_CN(CHARACTERS)%的身影
ELSEIF TOTAL_CHARACTERS == 1 && !FLAG:時間停止
	IF CFLAG:MASTER:诶嘿嘿
		IF TALENT:LAST_CHARACTER:無知
			PRINTFORMDL %CALLNAME:LAST_CHARACTER%正一脸好奇地盯着你看
		ELSEIF TALENT:LAST_CHARACTER:無関心 || TALENT:LAST_CHARACTER:感情乏しい
			PRINTFORMDL 你看到%CALLNAME:LAST_CHARACTER%在远处，一副毫无兴趣的样子
		ELSEIF INRANGE(RELATION:LAST_CHARACTER:TARGET, 1, 99)
			PRINTFORMDL 你看到%CALLNAME:LAST_CHARACTER%在远处，满脸厌恶地看着你
		ELSEIF (TALENT:LAST_CHARACTER:思慕 || TALENT:LAST_CHARACTER:恋慕) && GET_UWAKI_HISTORY(LAST_CHARACTER, TARGET) == 2
			PRINTFORMDL 你看到%CALLNAME:LAST_CHARACTER%在远处，脸上带着惆怅的表情
		ELSEIF TALENT:LAST_CHARACTER:恋人 && GET_UWAKI_HISTORY(LAST_CHARACTER, TARGET) < 2
			PRINTFORMDL 你看到%CALLNAME:LAST_CHARACTER%在远处，脸上带着失望的表情
		ELSEIF TALENT:LAST_CHARACTER:思慕 || TALENT:LAST_CHARACTER:恋慕
			PRINTFORMDL 你看到%CALLNAME:LAST_CHARACTER%在远处，脸上带着惆怅的表情
		ELSEIF TALENT:LAST_CHARACTER:セフレ || TALENT:LAST_CHARACTER:愛欲
			PRINTFORMDL 你看到%CALLNAME:LAST_CHARACTER%在远处，一脸兴奋地给你加油
		ELSE
			PRINTFORMDL 你看到%CALLNAME:LAST_CHARACTER%在远处
		ENDIF
	ELSE
		PRINTFORMDL 你看到%CALLNAME:LAST_CHARACTER%在远处
	ENDIF
ELSE
	PRINTFORMDL 你看到远处有%LIST_IN_STRING_CN(CHARACTERS)%的身影
ENDIF
