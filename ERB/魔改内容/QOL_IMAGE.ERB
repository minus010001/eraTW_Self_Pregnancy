;-------------------------------------------------
; 应用：PRINT_STATE_IMAGE
; 概  述：能力信息页面单人立绘显示
; 参  数：iID = 角色ID
;-------------------------------------------------
@QOL_PRINT_STATE_IMAGE(iID)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM iID
#DIMS DYNAMIC HTML_STR
#DIM  DYNAMIC PREV_FACE_TYPE
#DIM  DYNAMIC L_H

SIF !iID && !自机立绘开关
	RETURN RESULT

SIF (CFLAG:iID:別顔有 || CFLAG:iID:別立ち有) && FLAG:画像表示
	PRINTFORMLC [98]立绘包:\@CFLAG:iID:差し替え適用?可选立绘{CFLAG:iID:差し替え適用}#初始立绘\@
PRINTL

SIF !FLAG:画像表示
	RETURN RESULT

; 路人生成
IF iID < CHARANUM && TALENT:iID:路人 && !GCREATED(CFLAG:iID:路人子素材CFLAG開始位置)
	CALL 路人子生成(iID, 0)
	CALL 路人子生成(iID, 1)
ENDIF

L_H = GET_DEFAULT_IMAGE_HEIGHT()
IF iID < CHARANUM
	RESULT = 0
	RESULTS =
	CALL BUILD_CHARA_IMAGE_BLOCK(iID, 0, , , GET_DEFAULT_IMAGE_FLAGS() & ~(1p6), "顔絵", "", "通常")
	HTML_STR += RESULTS
	HTML_STR += @"<shape type='space' param='20px'>" ; 两张图中间留 20px 间隙
	
	RESULTS =
	CALL BUILD_CHARA_IMAGE_BLOCK(iID, 0, , , GET_DEFAULT_IMAGE_FLAGS() & ~(1p6), "立絵", "", "通常")
	HTML_STR += RESULTS
	L_H = RESULT
ELSE
	; 占位符兜底
	HTML_STR += @"<img src='im_av_empty' height='{L_H}px'>"
ENDIF
CALL HTML_PRINTL_PX(HTML_STR, L_H)

RETURN L_H

;-------------------------------------------------
; 应  用：PRINT_SINGLE_CHARA_IMAGE
; 概  述：打印与UI界面显示一致的角色立绘
; 参  数：CHARA = 角色ID, H_PX = 画框像素高度 (默认 UI当前设定)
; 示  例：CALL PRINT_SINGLE_CHARA_IMAGE(TARGET, 400)
;-------------------------------------------------
@PRINT_SINGLE_CHARA_IMAGE(CHARA, H_PX = -1)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM CHARA
#DIM H_PX

SIF !FLAG:画像表示 || CHARA <= 0
	RETURN

CALL BUILD_CHARA_IMAGE_BLOCK(CHARA, 0, H_PX, -1, GET_DEFAULT_IMAGE_FLAGS() & ~(1p6))
CALL HTML_PRINTL_PX, RESULTS, RESULT

;-------------------------------------------------
; 应  用：PrintOnanismImage
; 概  述：自慰事件配图
;-------------------------------------------------
@QOL_PrintOnanismImage(C_ID)
#LOCALSIZE 2
#LOCALSSIZE 1
#DIM C_ID
#DIMS DYNAMIC HTML_STR
#DIM  DYNAMIC PREV_FACE_TYPE
#DIMS DYNAMIC BASE_IMG
#DIMS DYNAMIC EFF_IMGS, 10
#DIMS DYNAMIC HOVER_EFF_IMGS, 10
#DIM  DYNAMIC EFF_CNT
#DIM  DYNAMIC IMG_H_PX
#DIM  DYNAMIC IMG_W_PX

SIF !C_ID || !FLAG:画像表示
	RETURN RESULT

PREV_FACE_TYPE = FLAG:立絵種類
FLAG:立絵種類 = 1

CALL IMAGE_CHARA_OVERRIDE("特殊自慰", C_ID)
IF RESULT:1 && RESULTS:0 != ""
	BASE_IMG '= RESULTS:0
	EFF_CNT = 0
	FOR LOCAL, 0, VARSIZE("EFF_IMGS")
		IF RESULTS:(LOCAL + 1) != "" && SPRITECREATED(RESULTS:(LOCAL + 1))
			EFF_IMGS:EFF_CNT '= RESULTS:(LOCAL + 1)
			HOVER_EFF_IMGS:EFF_CNT '= "" ; 默认无悬停
			EFF_CNT++
		ENDIF
	NEXT
ELSE
	CALL QOL_GET_BASE_RESOURCE(C_ID, "顔絵", "裸")
	BASE_IMG '= RESULTS:0
	
	CALL GET_EFFECT_RESOURCE(C_ID, "吐息", "顔絵", "", "裸")
	LOCAL:1 = RESULT
	FOR LOCAL, 0, LOCAL:1
		EFF_IMGS:EFF_CNT '= RESULTS:LOCAL
		HOVER_EFF_IMGS:EFF_CNT '= FLAG:時間停止 ? "" # RESULTS:(LOCAL + LOCAL:1)
		EFF_CNT++
	NEXT

	TRYCCALLFORM SPECIAL_BASE_IMAGE_{NO:C_ID}
		IF RESULTS == "EagloV"
			CALL GET_EFFECT_RESOURCE(C_ID, "照れ", "顔絵", "", "裸")
			LOCAL:1 = RESULT
			FOR LOCAL, 0, LOCAL:1
				EFF_IMGS:EFF_CNT '= RESULTS:LOCAL
				HOVER_EFF_IMGS:EFF_CNT '= FLAG:時間停止 ? "" # RESULTS:(LOCAL + LOCAL:1)
				EFF_CNT++
			NEXT
		ENDIF
	CATCH
		CALL IMAGE_CHARA_OVERRIDE("自慰エフェクト", C_ID)
		IF RESULT:1
			FOR LOCAL, 0, RESULT
				IF SPRITECREATED(RESULTS:LOCAL)
					EFF_IMGS:EFF_CNT '= RESULTS:LOCAL
					HOVER_EFF_IMGS:EFF_CNT '= ""
					EFF_CNT++
				ENDIF
			NEXT
		ENDIF
	ENDCATCH
ENDIF

IMG_H_PX = GET_DEFAULT_IMAGE_HEIGHT(BASE_IMG)
HTML_STR '= ASSEMBLE_HTML_IMAGE_LAYERS(BASE_IMG, "", EFF_IMGS, HOVER_EFF_IMGS, EFF_CNT, IMG_H_PX)
CALL HTML_PRINTL_PX, HTML_STR, IMG_H_PX

FLAG:立絵種類 = PREV_FACE_TYPE
RETURN RESULT

;=========================================================
;输出层
;=========================================================
;-------------------------------------------------
; 渲染组件：为跨行渲染的HTML格式字符串自动换行
; 概  述：打印传入的 HTML 串，并自动补齐换行，确保后续文字不与图片重叠。
; 参  数：HTML_STR  = 要打印的 HTML 字符串
;         HEIGHT_PX = 该内容向下渲染的总像素高度
;-------------------------------------------------
@HTML_PRINTL_PX(HTML_STR, HEIGHT_PX)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS DYNAMIC HTML_STR
#DIM  DYNAMIC HEIGHT_PX
#DIM  DYNAMIC L_START
#DIM  DYNAMIC LINES_NEEDED
#DIM  DYNAMIC LINES_DRAWN

L_START = LINECOUNT
HTML_PRINT HTML_STR

LINES_NEEDED = (HEIGHT_PX + GETCONFIG("一行の高さ") - 1) / GETCONFIG("一行の高さ")
LINES_DRAWN = LINECOUNT - L_START

FOR LOCAL, 0, MAX(0, LINES_NEEDED - LINES_DRAWN)
	PRINTL 
NEXT

;-------------------------------------------------
; 渲染组件：PRINT_IMAGE_SETTINGS_FOOTER
; 概  述：渲染立绘显示界面底部的控制按钮栏
; 参  数：TARGET_LIST = 当前目标数组，TARGET_NUM = 总人数，CUR_TARGET_IDX = 当前目标在数组中的索引
;-------------------------------------------------
@PRINT_IMAGE_SETTINGS_FOOTER(TARGET_LIST, TARGET_NUM, CUR_TARGET_IDX)
#LOCALSIZE 3
#LOCALSSIZE 1
#DIM REF TARGET_LIST
#DIM  DYNAMIC TARGET_NUM
#DIM  DYNAMIC CUR_TARGET_IDX
#DIMS DYNAMIC sPrint_Text
#DIM  DYNAMIC CHARATRANS

SIF !FLAG:画像表示設定
	RETURN

; 开始构建 HTML
sPrint_Text = <p align='\@FLAG:画像表示位置?left#center\@'>

; --- 第一行：功能开关 ---
sPrint_Text += @"<button value='3105' title='现在：\@FLAG:立絵種類?颜绘#立绘\@'>立绘种类[\@FLAG:立絵種類?颜绘#立绘\@]</button>　"
sPrint_Text += @"<button value='3103' title='现在：\@FLAG:画像表示位置?左对齐#居中对齐\@'>表示位置[\@FLAG:画像表示位置?left#center\@]</button>　"
sPrint_Text += @"<button value='3104' title='现在：\@FLAG:画像枠表示?ON#OFF\@'>边框显示[\@FLAG:画像枠表示?ON#OFF\@]</button>　"
sPrint_Text += @"<button value='3108' title='现在：\@FLAG:巨乳差分表示?ON#OFF\@'>巨乳差分[\@FLAG:巨乳差分表示?ON#OFF\@]</button>　"
sPrint_Text += @"<button value='3109' title='现在：\@CFLAG:通用拟声词?ON#OFF\@'>通用拟声词[\@CFLAG:通用拟声词?ON#OFF\@]</button>　"

; Xray 开关
sPrint_Text += @"<button value='3999' title='现在：\@FLAG:XRay_show?{FLAG:XRay_show}#OFF\@'>"
LOCALS = \@GETBIT(FLAG:XRay_show,0)?Ａ#nA\@\@GETBIT(FLAG:XRay_show,1)?心#胎\@
sPrint_Text += @"XRAY[\@FLAG:XRay_show?%LOCALS%#OFF\@]</button>"

; 变身/差分角色处理
CHARATRANS = TARGET
SIF CFLAG:TARGET:変化先
	CHARATRANS = CFLAG:TARGET:変化先
IF CFLAG:CHARATRANS:別顔有 || CFLAG:CHARATRANS:別立ち有
	sPrint_Text += @"　<button value='3110' title='现在：\@CFLAG:CHARATRANS:差し替え適用?ON#OFF\@'>差分[\@CFLAG:CHARATRANS:差し替え適用?ON({CFLAG:CHARATRANS:差し替え適用})#OFF\@]</button>"
ENDIF
sPrint_Text += "<br>"

; --- 第二行：翻页与缩放控制 ---
; 防越界处理
LOCAL:1 = MAX(CUR_TARGET_IDX - 1, 1)
LOCAL:2 = MIN(CUR_TARGET_IDX + 1, TARGET_NUM)

sPrint_Text += @"<button value='{1000 + TARGET_LIST:(LOCAL:1)}' title='上一角色'>＜＜</button>"
sPrint_Text += @"<button value='3101' title='显示图像人数－'>[－]</button>"
sPrint_Text += @"显示人数[{FLAG:画像表示}]"
sPrint_Text += @"<button value='3102' title='显示图像人数＋'>[＋]</button>"
sPrint_Text += @"<button value='{1000 + TARGET_LIST:(LOCAL:2)}' title='下一角色'>＞＞</button>　"

sPrint_Text += @"<button value='3106' title='统一减小缩放比例'>[－]</button>"
sPrint_Text += @"<button value='3111' title='设定调整缩放比例前的图像尺寸：现在是\@FLAG:多尺寸?图片原始尺寸（※可能出现大小不一）#统一{默认角色画像横幅}px\@'>"
sPrint_Text += @"画像尺寸[\@FLAG:多尺寸?原始尺寸#{默认角色画像横幅}px\@:{100 + isModifier}％]</button>"
sPrint_Text += @"<button value='3107' title='统一增加缩放比例'>[＋]</button>"

HTML_PRINT sPrint_Text

;=========================================================
;构建层
;=========================================================

;-------------------------------------------------
; 核心组件：BUILD_CHARA_IMAGE_BLOCK
; 参  数：CHARA = 角色ID, BTN_VAL = 按钮值, MAX_H_PX = 框高(-1则自动获取), SCALE = 缩放, IMG_FLAGS = 64位标记
;         覆写参数，传入则强制使用，不传则走常规状态机
;         O_STYLE = 强制表示形式 (如 "顔絵")
;         O_CLOTH = 强制服装
;         O_EXPR  = 强制表情
;         O_DIFF  = 强制差分
;         O_EFF   = 附加的特效串 (逗号分隔)
; 返回值：RESULTS = HTML 字符串, RESULT = 最终的画像高度(PX)
; 备  注：取消伪装环境的尝试失败，参数传递最多进入到路由层分发的另一个系统路由，本系统之外的合成层依赖 FLAG:立绘种类 参数进行不同的合成行为。由于无法对所有合成系统进行改造，因此在构建栈内伪装环境目前是必须的
;-------------------------------------------------
@BUILD_CHARA_IMAGE_BLOCK(CHARA, BTN_VAL, MAX_H_PX = -1, SCALE = -1, IMG_FLAGS = -1, O_STYLE="", O_CLOTH="", O_EXPR="", O_DIFF="", O_EFF="", O_ALT_ID=-1, EFFECT_OVERRIDE=0)
#LOCALSIZE 2
#LOCALSSIZE 1
#DIM  DYNAMIC CHARA
#DIM  DYNAMIC VIS_C
#DIM  DYNAMIC BTN_VAL
#DIM  DYNAMIC MAX_H_PX
#DIM  DYNAMIC SCALE
#DIM  DYNAMIC IMG_FLAGS

#DIMS DYNAMIC O_STYLE
#DIMS DYNAMIC O_CLOTH
#DIMS DYNAMIC O_EXPR
#DIMS DYNAMIC O_DIFF
#DIMS DYNAMIC O_EFF
#DIM  DYNAMIC O_ALT_ID
#DIM  DYNAMIC EFFECT_OVERRIDE

#DIMS DYNAMIC BASE_IMG
#DIMS DYNAMIC HOVER_IMG
#DIMS DYNAMIC LAYERS, 30
#DIMS DYNAMIC HOVER_LAYERS, 30 ; [新增] 悬停特效平行数组
#DIM  DYNAMIC LAYER_CNT
#DIMS DYNAMIC HTML_BLOCK
#DIM  DYNAMIC CHARA_W_PX

#DIMS DYNAMIC CUSTOM_EFFS, 100
#DIM  DYNAMIC CUSTOM_EFF_NUM
#DIMS DYNAMIC TEMP_EFF_NAME
#DIMS DYNAMIC RES_NAME
#DIM  DYNAMIC L_CLOTH_NUDE
#DIM  DYNAMIC PREV_立绘种类
#DIM  DYNAMIC PREV_立绘选择
#DIMS DYNAMIC IMAGE_TITLE

VIS_C = CFLAG:CHARA:変化先 > 0 ? CFLAG:CHARA:変化先 # CHARA

SIF SCALE == -1
	SCALE = 100 + isModifier

IF IMG_FLAGS == -1
	IMG_FLAGS = GET_DEFAULT_IMAGE_FLAGS()
ENDIF
PREV_立绘种类 = FLAG:立绘种类
IF O_STYLE == "顔絵"
	FLAG:立绘种类 = 1
ELSEIF O_STYLE == "立絵"
	FLAG:立绘种类 = 0
ENDIF
O_STYLE = %GET_BASESTYLE(VIS_C, O_STYLE)%

PREV_立绘选择 = CFLAG:VIS_C:差し替え適用
SIF O_ALT_ID != -1
	CFLAG:VIS_C:差し替え適用 = LIMIT(O_ALT_ID, 0, CFLAG:VIS_C:別顔有)

VARSET RESULT
VARSET RESULTS
CALL QOL_GET_BASE_RESOURCE(CHARA, O_STYLE, O_CLOTH, O_EXPR, O_EXPR, O_DIFF, GETBIT(IMG_FLAGS, 7))
;DEBUGPRINTFORML block get「%RESULTS:0%/%RESULTS:1%」

IF RESULT == 0 || RESULTS:0 == ""
	BASE_IMG '= @"%O_STYLE%_服_通常_{NO:VIS_C}"
	HOVER_IMG '= ""
	IF !SPRITECREATED(BASE_IMG)
		IF MAX_H_PX == -1
			MAX_H_PX = GET_DEFAULT_IMAGE_HEIGHT(, SCALE)
		ENDIF
		RESULTS '= @"<img src='im_av_empty' width='{MAX_H_PX}px' height='{MAX_H_PX}px'>"
		FLAG:立绘种类 = PREV_立绘种类
		RETURN MAX_H_PX
	ENDIF
ELSE
	BASE_IMG  '= RESULTS:0
	HOVER_IMG '= RESULTS:1
ENDIF

IF MAX_H_PX == -1
	MAX_H_PX = GET_DEFAULT_IMAGE_HEIGHT(BASE_IMG, SCALE)
ENDIF

BASE_IMG  '= IMAGE_COMPONENT_FILTER(BASE_IMG, CHARA, IMG_FLAGS)
HOVER_IMG '= IMAGE_COMPONENT_FILTER(GETBIT(IMG_FLAGS, 5) ? "" # HOVER_IMG, CHARA, IMG_FLAGS)

LAYER_CNT = 0
; 2. 自然特效图层 (受 Bit 1 控制，EFFECT_OVERRIDE 时跳过)
IF GETBIT(IMG_FLAGS, 1) && !EFFECT_OVERRIDE
	CALL GET_EFFECT_RESOURCE(CHARA, "", , O_DIFF, O_CLOTH)
	LOCAL:1 = RESULT ; 捕获特效数量 N
	FOR LOCAL, 0, LOCAL:1
		LAYERS:LAYER_CNT '= IMAGE_COMPONENT_FILTER(RESULTS:LOCAL, CHARA, IMG_FLAGS)
		; 检查是否存在 N 偏移位置的悬停特效，并且非时停状态
		IF RESULTS:(LOCAL + LOCAL:1) != "" && !GETBIT(IMG_FLAGS, 5)
			HOVER_LAYERS:LAYER_CNT '= IMAGE_COMPONENT_FILTER(RESULTS:(LOCAL + LOCAL:1), CHARA, IMG_FLAGS)
		ELSE
			HOVER_LAYERS:LAYER_CNT '= ""
		ENDIF
		LAYER_CNT++
	NEXT
ENDIF

; 2.5. 显式特效图层（通过 GET_EFFECT_RESOURCE 路由，支持 EagloV 等特殊立绘系统）
; EFFECT_OVERRIDE=0 时叠加在自然特效之上，EFFECT_OVERRIDE=1 时仅显示指定特效
IF GETBIT(IMG_FLAGS, 1) && O_EFF != ""
	CALL GET_EFFECT_RESOURCE(CHARA, O_EFF, , O_DIFF, O_CLOTH)
	LOCAL:1 = RESULT
	FOR LOCAL, 0, LOCAL:1
		LOCALS '= IMAGE_COMPONENT_FILTER(RESULTS:LOCAL, CHARA, IMG_FLAGS)
		; 去重：检查 LAYERS 中是否已包含此资源（避免与自然特效重复）
		REPEAT LAYER_CNT
			SIF LAYERS:COUNT == LOCALS
				BREAK
		REND
		SIF COUNT < LAYER_CNT
			CONTINUE
		LAYERS:LAYER_CNT '= LOCALS
		IF RESULTS:(LOCAL + LOCAL:1) != "" && !GETBIT(IMG_FLAGS, 5)
			HOVER_LAYERS:LAYER_CNT '= IMAGE_COMPONENT_FILTER(RESULTS:(LOCAL + LOCAL:1), CHARA, IMG_FLAGS)
		ELSE
			HOVER_LAYERS:LAYER_CNT '= ""
		ENDIF
		LAYER_CNT++
	NEXT
ENDIF

; 3. 追加的强制定制特效
; 此步骤处理剩余的特效（如全局 Sprite），并自动去重
IF GETBIT(IMG_FLAGS, 1) && O_EFF != ""
	; 确认是否是裸体以便拼装前缀
	L_CLOTH_NUDE = (O_CLOTH == "裸" || CHECK_NUDE(CHARA))
	SPLIT O_EFF, ",", CUSTOM_EFFS, CUSTOM_EFF_NUM
	FOR LOCAL, 0, CUSTOM_EFF_NUM
		TEMP_EFF_NAME '= CUSTOM_EFFS:LOCAL
		RES_NAME '= ""
		; 三级查找：O_STYLE_特效 → 裸特效 → 全局Sprite
		IF SPRITECREATED(@"%O_STYLE%_%TEMP_EFF_NAME%_{NO:VIS_C}%O_DIFF%")
			RES_NAME '= @"%O_STYLE%_%TEMP_EFF_NAME%_{NO:VIS_C}%O_DIFF%"
		ELSEIF L_CLOTH_NUDE && SPRITECREATED(@"%O_STYLE%_裸%TEMP_EFF_NAME%_{NO:VIS_C}%O_DIFF%")
			RES_NAME '= @"%O_STYLE%_裸%TEMP_EFF_NAME%_{NO:VIS_C}%O_DIFF%"
		ELSEIF SPRITECREATED(TEMP_EFF_NAME)
			RES_NAME '= TEMP_EFF_NAME
		ENDIF
		; 去重+添加
		IF RES_NAME != ""
			REPEAT LAYER_CNT
				SIF LAYERS:COUNT == RES_NAME
					BREAK
			REND
			SIF COUNT < LAYER_CNT
				CONTINUE
			LAYERS:LAYER_CNT '= RES_NAME
			HOVER_LAYERS:LAYER_CNT '= ""
			LAYER_CNT++
		ENDIF
	NEXT
ENDIF

; 4. 边框图层
IF GETBIT(IMG_FLAGS, 0)
	LAYERS:LAYER_CNT '= IMAGE_COMPONENT_FRAME(CHARA)
	HOVER_LAYERS:LAYER_CNT '= ""
	LAYER_CNT++
ENDIF

; 5. 时停图层
IF GETBIT(IMG_FLAGS, 5)
	LAYERS:LAYER_CNT '= "時間停止"
	HOVER_LAYERS:LAYER_CNT '= ""
	LAYER_CNT++
ENDIF

IF IS_DEBUG()
	IMAGE_TITLE '= @"%BASE_IMG%<br>%HOVER_IMG%"
ELSE
	IMAGE_TITLE '= @"%CALLNAME:CHARA% ID:{CHARA}"
ENDIF
IF GETBIT(IMG_FLAGS, 6)
	HTML_BLOCK '= @"<button value='{BTN_VAL}' title='%IMAGE_TITLE%'>"
ELSE
	HTML_BLOCK '= @"<nonbutton title='%IMAGE_TITLE%'>"
ENDIF

HTML_BLOCK += ASSEMBLE_HTML_IMAGE_LAYERS(BASE_IMG, HOVER_IMG, LAYERS, HOVER_LAYERS, LAYER_CNT, MAX_H_PX, SCALE)
HTML_BLOCK += GETBIT(IMG_FLAGS, 6) ? "</button>" # "</nonbutton>"

; 6. 拼接 Xray 模块
IF GETBIT(IMG_FLAGS, 2)
	CHARA_W_PX = GET_DEFAULT_IMAGE_WIDTH(BASE_IMG, SCALE)
	;HTML_BLOCK += @"<shape type='space' param='5px'>" ;间距，感觉没有会更好
	CALL BUILD_XRAY_IMAGE_BLOCK(CHARA, MAX_H_PX, CHARA_W_PX)
	HTML_BLOCK += RESULTS
ENDIF

RESULTS '= HTML_BLOCK
FLAG:立绘种类 = PREV_立绘种类
CFLAG:VIS_C:差し替え適用 = PREV_立绘选择
RETURN MAX_H_PX

;-------------------------------------------------
; 函数名：BUILD_MOB_IMAGE_BLOCK
; 概  述：构建路人立绘HTML图像块（纯净构建层，专用于无实际CHARA索引实体的路人，支持多层特效叠加、悬停效果、自然/自定义特效、动态资源生成兜底、按钮/非按钮封装）
; 参  数：	MOB_TYPE		 - 路人类型ID（原差分参数，必填）
; 			BTN_VAL			 - 按钮值（默认=0，用于交互触发）
; 			MAX_H_PX		 - 最大高度像素（=-1 表示自动计算）
; 			SCALE			 - 缩放百分比（=-1 表示默认 100 + isModifier）
; 			IMG_FLAGS		 - 图像标志位（=-1 表示 GET_DEFAULT_IMAGE_FLAGS()）
; 			O_STYLE			 - 立绘种类名称（默认 "顔絵"，支持 "立絵"）
; 			O_CLOTH			 - 服装名称（默认 "服"）
; 			O_EXPR			 - 表情名称（默认 "通常"）
; 			O_EFF			 - 追加特效列表（逗号分隔，默认 ""）
; 返回值：	RESULTS			 - 构造好的HTML字符串
;			RESULT			 - 图片的行高（实际 MAX_H_PX）
;-------------------------------------------------
@BUILD_MOB_IMAGE_BLOCK(MOB_TYPE, BTN_VAL = 0, MAX_H_PX = -1, SCALE = -1, IMG_FLAGS = -1, O_STYLE="顔絵", O_CLOTH="服", O_EXPR="通常", O_EFF="")
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS DYNAMIC MOB_TYPE
#DIM  DYNAMIC BTN_VAL
#DIM  DYNAMIC MAX_H_PX
#DIM  DYNAMIC SCALE
#DIM  DYNAMIC IMG_FLAGS

#DIMS DYNAMIC O_STYLE
#DIMS DYNAMIC O_CLOTH
#DIMS DYNAMIC O_EXPR
#DIMS DYNAMIC O_EFF

#DIMS DYNAMIC BASE_IMG
#DIMS DYNAMIC HOVER_IMG
#DIMS DYNAMIC LAYERS, 30
#DIMS DYNAMIC HOVER_LAYERS, 30
#DIM  DYNAMIC LAYER_CNT
#DIMS DYNAMIC HTML_BLOCK

#DIMS DYNAMIC CUSTOM_EFFS, 10
#DIM  DYNAMIC CUSTOM_EFF_NUM
#DIMS DYNAMIC TEMP_EFF_NAME
#DIMS DYNAMIC RES_NAME
#DIM  DYNAMIC PREV_立绘种类

SIF SCALE == -1
	SCALE = 100 + isModifier
SIF IMG_FLAGS == -1
	IMG_FLAGS = GET_DEFAULT_IMAGE_FLAGS()

PREV_立绘种类 = FLAG:立绘种类
IF O_STYLE == "顔絵"
	FLAG:立绘种类 = 1
ELSEIF O_STYLE == "立絵"
	FLAG:立绘种类 = 0
ENDIF

SIF O_EXPR == ""
	O_EXPR = "通常"
SIF O_CLOTH == ""
	O_CLOTH = "服"

BASE_IMG '= @"%O_STYLE%_%O_CLOTH%_%O_EXPR%_MOB_%MOB_TYPE%"
IF !SPRITECREATED(BASE_IMG)
	; 尝试动态生成路人立绘
	CALL 路人店員画像作成(TOINT(MOB_TYPE))
	IF !SPRITECREATED(BASE_IMG)
		BASE_IMG '= @"%O_STYLE%_服_通常_MOB_%MOB_TYPE%"
		; 兜底：生成失败则返回空占位符
		IF !SPRITECREATED(BASE_IMG)
			IF MAX_H_PX == -1
				MAX_H_PX = GET_DEFAULT_IMAGE_HEIGHT(, SCALE)
			ENDIF
			RESULTS '= @"<img src='im_av_empty' width='{MAX_H_PX}px' height='{MAX_H_PX}px'>"
			FLAG:立绘种类 = PREV_立绘种类
			RETURN MAX_H_PX
		ENDIF
	ENDIF
ENDIF
HOVER_IMG '= BASE_IMG ; 路人默认没有Hover差异图片

IF MAX_H_PX == -1
	MAX_H_PX = GET_DEFAULT_IMAGE_HEIGHT(BASE_IMG, SCALE)
ENDIF

BASE_IMG  '= IMAGE_COMPONENT_FILTER(BASE_IMG, 0, IMG_FLAGS)
HOVER_IMG '= IMAGE_COMPONENT_FILTER(GETBIT(IMG_FLAGS, 5) ? "" # HOVER_IMG, 0, IMG_FLAGS)

LAYER_CNT = 0

; 追加的特效处理 (路人特效比较单一)
IF O_EFF != ""
	SPLIT O_EFF, ",", CUSTOM_EFFS, CUSTOM_EFF_NUM
	FOR LOCAL, 0, CUSTOM_EFF_NUM
		TEMP_EFF_NAME '= CUSTOM_EFFS:LOCAL
		RES_NAME '= @"%O_STYLE%_%TEMP_EFF_NAME%_MOB_%MOB_TYPE%"
		IF SPRITECREATED(RES_NAME)
			LAYERS:LAYER_CNT '= RES_NAME
			HOVER_LAYERS:LAYER_CNT '= ""
			LAYER_CNT++
		ELSEIF SPRITECREATED(TEMP_EFF_NAME)
			LAYERS:LAYER_CNT '= TEMP_EFF_NAME
			HOVER_LAYERS:LAYER_CNT '= ""
			LAYER_CNT++
		ENDIF
	NEXT
ENDIF

; 边框处理 (使用默认编号0的边框逻辑)
IF GETBIT(IMG_FLAGS, 0)
	LAYERS:LAYER_CNT '= IMAGE_COMPONENT_FRAME(0)
	HOVER_LAYERS:LAYER_CNT '= ""
	LAYER_CNT++
ENDIF

; 时停图层
IF GETBIT(IMG_FLAGS, 5)
	LAYERS:LAYER_CNT '= "時間停止"
	HOVER_LAYERS:LAYER_CNT '= ""
	LAYER_CNT++
ENDIF

IF GETBIT(IMG_FLAGS, 6)
	HTML_BLOCK '= @"<button value='{BTN_VAL}' title='モブ子'>"
ELSE
	HTML_BLOCK '= @"<nonbutton title='モブ子'>"
ENDIF

HTML_BLOCK += ASSEMBLE_HTML_IMAGE_LAYERS(BASE_IMG, HOVER_IMG, LAYERS, HOVER_LAYERS, LAYER_CNT, MAX_H_PX, SCALE)
HTML_BLOCK += GETBIT(IMG_FLAGS, 6) ? "</button>" # "</nonbutton>"

RESULTS '= HTML_BLOCK
FLAG:立绘种类 = PREV_立绘种类
RETURN MAX_H_PX

;-------------------------------------------------
; 特效图层构建工具 (Effect Builder API)
; 用法示例：
;   CALL CLEAR_CUSTOM_EFFECT()
;   SIF 被打了一拳
;       CALL ADD_CUSTOM_EFFECT("瘀伤")
;   SIF 被泼了水
;       CALL ADD_CUSTOM_EFFECT("水滴")
;   
;   CALL PRINT_FACE(TARGET, "悲伤", "", "", GET_CUSTOM_EFFECT(), , 0)
;其实这部分就是介绍面对对象的写法，帮助脚本创作者理解怎么构建自定义的特征架构，了解如何实现后完全可以用局域的字符变量代替
;-------------------------------------------------
@CLEAR_CUSTOM_EFFECT()
#LOCALSIZE 1
