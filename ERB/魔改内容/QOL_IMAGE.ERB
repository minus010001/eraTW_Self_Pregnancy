;-------------------------------------------------
;接口：打印角色的膝上绘
;补充@PRINT_FACE的遗漏
;-------------------------------------------------
@PRINT_BODY(CID, 表情="", 服装="", 差分="", エフェクト="", 立绘选择 = -1, EFFECT_OVERRIDE = 0)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM  DYNAMIC CID
#DIMS DYNAMIC 表情
#DIMS DYNAMIC 服装
#DIMS DYNAMIC 差分
#DIMS DYNAMIC エフェクト
