;-------------------------------------------------
; 工具函数：背景图片打印
; 概  述：打印背景图片
; 参  数：图片名 = 背景图片资源名 设置为空则清除背景图片
;-------------------------------------------------
@背景图片打印(图片名)
#DIMS 图片名
#DIM 图片长度
#DIM 图片高度
#DIM G_ID
#DIM CN_CM,5,5
CBGCLEAR
GDISPOSE LAST_BGI_GID
TEXT_BGC_OFF
CN_CM:0:0 = 256,  0,  0,  0,  0;R
CN_CM:1:0 =   0,256,  0,  0,  0;G
CN_CM:2:0 =   0,  0,256,  0,  0;B
IF Setting_高亮背景图
	CN_CM:3:0 =   0,  0,  0,256,  0;A
ELSE
	CN_CM:3:0 =   0,  0,  0,128,  0;A
ENDIF
CN_CM:4:0 =   0,  0,  0,  0,256;平行
SIF 图片名 == "" || !SPRITEWIDTH(图片名)
	RETURN
图片长度 = CLIENTWIDTH()
图片高度 = SPRITEHEIGHT(图片名) * 图片长度 / SPRITEWIDTH(图片名)
G_ID = GET_NEXT_GID(G_ID)
LAST_BGI_GID = G_ID
GCREATE G_ID, 图片长度, 图片高度
GDRAWSPRITE G_ID, 图片名, 0, 0,图片长度,图片高度, CN_CM:0:0
CBGSETG G_ID, 0, 0, 1000
SIF Setting_高亮背景图
	TEXT_BGC_ON GET_MAP_WEATHER_BGCOLOR(), 50