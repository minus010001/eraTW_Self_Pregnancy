@COM_ABLE460
#LOCALSIZE 1
#LOCALSSIZE 1
;妄想実行判定
SIF !TFLAG:100
	RETURN 0
SIF FLAG:70
	RETURN 0
SIF CFLAG:MASTER:現在位置 != CFLAG:MASTER:初期位置
	RETURN 0
;SIF GLOBAL_COMABLE(460)
;	RETURN RESULT
SIF TFLAG:妄想中
	RETURN 0
;気力0では不可
SIF BASE:MASTER:気力 <= 0
	RETURN 0
;SIF !Setting_测试妄想自慰
;	RETURN 0
SIF GET_TARGETNUM() > 0
	RETURN 0
;できるのは昼12時～夜0時
;SIF TIME:0 > 0 && TIME:0 < 720
;	RETURN 0
RETURN 1

@妄想自慰设置关系(ARG,ARG:1)
SIF !ARG:1
	RETURN
SIF !ARG
	ARG = CHARANUM - 1
TALENT:ARG:愛欲 = 0
TALENT:ARG:炮友 = 0
TALENT:ARG:恋人 = 0
TALENT:ARG:恋慕 = 0
TALENT:ARG:思慕 = 0
CFLAG:ARG:同行 = 300
SIF ARG:1 == 妄想_恋人
	TALENT:ARG:恋人 = 1
IF GROUPMATCH(ARG:1, 妄想_恋慕, 妄想_恋人)
	TALENT:ARG:恋慕 = 1
	CFLAG:ARG:信赖度 = 1000
	ABL:ARG:親密 = 15
	ABL:ARG:欲望 = 10
	CFLAG:ARG:面識 = 1
	CFLAG:ARG:允许无套 = 2
ELSEIF ARG:1 == 妄想_爱欲
	TALENT:ARG:愛欲 = 1	
	TALENT:ARG:炮友 = 2
	ABL:ARG:親密 = 15
	ABL:ARG:欲望 = 10
	CFLAG:ARG:信赖度 = 500
	CFLAG:ARG:面識 = 1
	CFLAG:ARG:允许无套 = 2
ELSE
	ABL:ARG:親密 = 0
	ABL:ARG:欲望 = 0
	CFLAG:ARG:信赖度 = 0
	CFLAG:ARG:好感度 = 0
ENDIF
SIF GROUPMATCH(ARG:1, 妄想_恋慕, 妄想_恋人, 妄想_爱欲)
	CFLAG:ARG:好感度 = 3000

@妄想自慰备份
FOR LOCAL,0,1000
	BEFORE_MOUSOU_CFLAG:LOCAL = CFLAG:MASTER:LOCAL
NEXT
FOR LOCAL,0,200
	BEFORE_MOUSOU_EXP:LOCAL = EXP:MASTER:LOCAL
NEXT
FOR LOCAL,0,100
	BEFORE_MOUSOU_EX:LOCAL = EX:MASTER:LOCAL
	BEFORE_MOUSOU_CSTR:LOCAL = %CSTR:MASTER:LOCAL%
NEXT



@妄想自慰恢复
FOR LOCAL,0,1000
	CFLAG:MASTER:LOCAL = BEFORE_MOUSOU_CFLAG:LOCAL
NEXT
FOR LOCAL,0,200
	EXP:MASTER:LOCAL = BEFORE_MOUSOU_EXP:LOCAL
NEXT
FOR LOCAL,0,100
	EX:MASTER:LOCAL = BEFORE_MOUSOU_EX:LOCAL
	CSTR:MASTER:LOCAL = %BEFORE_MOUSOU_CSTR:LOCAL%
NEXT
SIF BEFORE_MOUSOU_EXP:29 == 0 && TALENT:MASTER:2 >= 2
	TALENT:MASTER:1 = 0
SIF BEFORE_MOUSOU_EXP:20 == 0 && TALENT:MASTER:2 != 2
	TALENT:MASTER:0 = 1