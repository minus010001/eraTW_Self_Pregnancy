@COM460_DISPLAY
#FUNCTIONS
#LOCALSIZE 1
#LOCALSSIZE 1
TEMP_COM_DISPLAY_COLOR = C_ORANGE

@COM460

;意淫自慰
VARSET LOCAL
CALL Isacc_Index_Initialize()
IF FLAG == 70
	TCVAR:194 = 1
	RETURN 0
ELSEIF GET_TARGETNUM() > 0
	TCVAR:194 = 2
	RETURN 0
ELSE
	TCVAR:194 = 3
	$LOOP_MOUSOU
	SETCOLOR C_PINK
	PRINTL 提示:只有已经见过面的角色可以当做意淫的对象
	RESETCOLOR
	PRINTL 
	FOR LOCAL,1,CHARANUM
		SIF !CFLAG:LOCAL:出禁 && CFLAG:LOCAL:面識
			PRINTFORMLC [{LOCAL,3,LEFT}] %CALLNAME:LOCAL%
	NEXT
	PRINTL
	DRAWLINE
	PRINTL [900] 放弃
	PRINTL 要意淫谁呢？
	INPUT
	SELECTCASE RESULT
	CASE 1 TO CHARANUM - 1
		妄想产物编号 = RESULT
		差分临时储存 = CFLAG:妄想产物编号:差し替え適用
		CFLAG:妄想产物编号:差し替え適用 = Isacc_Index:妄想产物编号:0
		ADDCOPYCHARA 妄想产物编号
		CFLAG:(CHARANUM - 1):差し替え適用 = 差分临时储存
		IF GET_CURRENT_MAP() == 2
			CFLAG:MASTER:現在位置 = 情人旅館
			CFLAG:(CHARANUM - 1):現在位置 = 情人旅館
		ELSE
			CFLAG:MASTER:現在位置 = 情人用宿屋
			CFLAG:(CHARANUM - 1):現在位置 = 情人用宿屋
		ENDIF
		CFLAG:(CHARANUM - 1):约会中 = 2
		CFLAG:MASTER:约会中 = 2
		TFLAG:妄想中 = 1
		MARK:(CHARANUM - 1):快楽刻印 = 3
		MARK:(CHARANUM - 1):不埒刻印 = 3
		CFLAG:(CHARANUM - 1):诶嘿嘿 = 0
		CFLAG:(CHARANUM - 1):睡眠 = 0
		CFLAG:(CHARANUM - 1):行動 = 0
		TALENT:(CHARANUM - 1):妄想的産物 = 1
		BASE:(CHARANUM - 1):工作量 = 0
		PRINTFORMW 和%CALLNAME:RESULT%做爱
		PRINTL 关系要设置成什么呢?
		$INPUT_RELATION
		PRINTL [0] 保持关系 [1] 恋人 [2] 恋慕 [3] 爱欲 [4]陌生人
		INPUT
		SELECTCASE RESULT
			CASE 0
			CASE 1 TO 4
				CALL 妄想自慰设置关系(CHARANUM - 1,RESULT)
			CASEELSE
				GOTO INPUT_RELATION
		ENDSELECT
		$INPUT_EMOTION
		PRINTL 要不要调起对方的情绪呢?
		PRINTL [0] 是 [1] 否
		INPUT
		SELECTCASE RESULT
			CASE 1
			CASE 0
				BASE:(CHARANUM - 1):情緒 = MAXBASE:(CHARANUM - 1):情緒
				BASE:(CHARANUM - 1):理性 = 0
				TCVAR:(CHARANUM - 1):発情 = 1
				PALAM:(CHARANUM - 1):欲情 = PALAMLV:15
				CFLAG:(CHARANUM - 1):积攒度 = MAX_积攒度
			CASEELSE
				GOTO INPUT_EMOTION
		ENDSELECT
		PRINTL 为了在妄想中尽情施展、可以进行是否处女的设定……
		PRINTL 要设为处女吗？
		PRINTL [0]是 [1]否
		$INPUT_VIRGIN
		INPUT
		IF RESULT == 0
			PRINTW 请温柔一点哦
			PRINTW 不过、Ｖ感觉为10了
			CALL SET_VIRGIN_LIGHT(CHARANUM - 1)
			ABL:(CHARANUM - 1):Ｖ感覚 = 10
			EXP:(CHARANUM - 1):精飲経験 = 0
			EXP:(CHARANUM - 1):Ｖ性交経験 = 0
			CSTR:(CHARANUM - 1):0 = 
		ELSEIF RESULT == 1
			PRINTW 就这样开始吧
		ELSE
			GOTO INPUT_VIRGIN
		ENDIF
		PRINTL 话说、你对菊穴有兴趣吗……
		PRINTL [0]有 [1]没有
		$INPUT_ANUS
		INPUT
		IF RESULT == 0
			PRINTW 赋予了敏感度和经验
			ABL:(CHARANUM - 1):Ａ感覚 = 10
			EXP:(CHARANUM - 1):Ａ経験 = 100
			EXP:(CHARANUM - 1):Ａ拡張経験 = 50
		ELSEIF RESULT == 1
			PRINTW 就这样开始吧
		ELSE
			GOTO INPUT_ANUS
		ENDIF
		CALL 妄想自慰备份
	CASE 900
		TCVAR:194 = 4
		RETURN 0
	CASEELSE
		GOTO LOOP_MOUSOU
	ENDSELECT
ENDIF


