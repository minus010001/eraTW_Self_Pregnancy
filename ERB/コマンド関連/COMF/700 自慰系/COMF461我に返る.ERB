@COM461_DISPLAY
#FUNCTIONS
#LOCALSIZE 1
#LOCALSSIZE 1
TEMP_COM_DISPLAY_COLOR = C_ORANGE

@COM461
;意淫自慰を放弃用
VARSET LOCAL

STAIN:MASTER:0 = 0
STAIN:MASTER:4 = 8

IF TALENT:MASTER:2 == 2
	STAIN:MASTER:1 = 6
	STAIN:MASTER:2 = 6
	STAIN:MASTER:5 = 0
ELSEIF TALENT:MASTER:2 == 1
	STAIN:MASTER:1 = 1
	STAIN:MASTER:3 = 1
	STAIN:MASTER:5 = 1
ELSE
	STAIN:MASTER:1 = 7
	STAIN:MASTER:2 = 7
	STAIN:MASTER:3 = 7
	STAIN:MASTER:5 = 7
ENDIF

STAIN:0 = 0
STAIN:1 = 0
STAIN:2 = 2
STAIN:3 = 1
STAIN:4 = 8
STAIN:5 = 0
STAIN:6 = 1
STAIN:7 = 8

CALL 妄想自慰恢复
TFLAG:妄想中 = 2
CFLAG:(CHARANUM - 1):現在位置 = SUKIMA()
CFLAG:(CHARANUM - 1):同行 = 0
CFLAG:(CHARANUM - 1):出禁 = 1
CFLAG:TARGET:约会中 = GET_HOME_MAP()
CFLAG:MASTER:约会中 = GET_HOME_MAP()
SIF MOREDATE
	CALL CLEAN_GROUP_DATES

CFLAG:MASTER:現在位置 = CFLAG:MASTER:初期位置
	FOR LOCAL, 1, CHARANUM
		SIF CFLAG:LOCAL:現在位置 == CFLAG:MASTER:初期位置
			CFLAG:LOCAL:現在位置 = CFLAG:LOCAL:初期位置
	NEXT
TFLAG:妄想中 = 0
;-------------------------------------------------
;実行判定
;-------------------------------------------------
;清醒
@COM_ABLE461
#LOCALSIZE 1
#LOCALSSIZE 1
;現実帰還実行判定
SIF !TFLAG:100
	RETURN 0
SIF TFLAG:妄想中 != 1
	RETURN 0
SIF CFLAG:MASTER:诶嘿嘿
	RETURN 0
RETURN 1

@EVENTCOMEND
#LATER
CALL 清除妄想产物

@清除妄想产物
IF 妄想产物编号 && !TFLAG:妄想中
	SIF TARGET == CHARANUM - 1
		TARGET = 0
	DELCHARA CHARANUM - 1
	CFLAG:妄想产物编号:差し替え適用 = 差分临时储存
	妄想产物编号 = 0
ENDIF

@妄想位置检查()
#FUNCTION
IF GET_CURRENT_MAP() == 2
	RETURNF (CFLAG:MASTER:現在位置 == 情人旅館)
ELSE
	RETURNF (CFLAG:MASTER:現在位置 == 情人用宿屋)
ENDIF