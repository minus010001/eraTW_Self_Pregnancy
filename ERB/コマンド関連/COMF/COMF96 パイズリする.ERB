;-------------------------------------------------
;给对方乳交
;奉仕系指令、レベル3
;-------------------------------------------------
@COM96
;-------------------------------------------------
;COM別FLAGの設定
;-------------------------------------------------
;行為者
TCVAR:116 = PLAYER
;奉仕快楽
TCVAR:PLAYER:108 = 1

CALL DECLARE_EJACULATION(TARGET, 0, 射精箇所_胸, PLAYER, CHARA_NONE, PLAYER, CHARA_NONE, 1200)
;射精快感強度

;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
IF (FLAG:70 == 1 && CFLAG:TARGET:344 == 0)
;	BASE:MASTER:TSP -= 50
	BASE:MASTER:TSP -= 60
	SOURCE:PLAYER:快Ｂ = 150
	SOURCE:快Ｃ = 110
ELSE

	DOWNBASE:体力 += 30
	DOWNBASE:気力 += 80
	SOURCE:快Ｃ = 110
	;性技補正
	SOURCE:快Ｃ += MIN(ABL:PLAYER:胸 * 25,100)
	
	SOURCE:PLAYER:快Ｂ = 50
	SOURCE:露出 = 20
	SOURCE:逸脱 = 20
	SOURCE:反感 = 20

	;-------------------------------------------------
	;特殊ソース処理
	;-------------------------------------------------
	;圧抑、抵抗持ちには、抑鬱ソース追加
	SIF TALENT:自己愛 < 0 || TALENT:抵抗
		SOURCE:鬱屈 += 30
ENDIF
;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;調教者のＢ⇔奴隷のＰ的污垢が移動
STAIN:PLAYER:5 |= STAIN:2
STAIN:2 |= STAIN:PLAYER:5
;-------------------------------------------------
;経験の処理
;-------------------------------------------------

;同性愛　レズなら戻り値1ゲイなら戻り値2
IF (FLAG:70 == 1 && CFLAG:TARGET:344 == 0) || CFLAG:恶作剧
	IF HETEROSEX(TARGET,PLAYER)
		EXP:PLAYER:(50 + HETEROSEX(TARGET,PLAYER)) += 3
	ENDIF
	EXP:PLAYER:乳交経験 += 1
ELSE
	IF HETEROSEX(TARGET,PLAYER)
		EXP:(50 + HETEROSEX(TARGET,PLAYER)) += 3
		EXP:PLAYER:(50 + HETEROSEX(TARGET,PLAYER)) += 3
	ENDIF
	EXP:PLAYER:乳交経験 += 2
	;愛情経験
	SIF TALENT:恋慕 && ASSIPLAY == 0
		EXP:愛情経験 ++
ENDIF
RETURN 1

;-------------------------------------------------
;実行判定
;-------------------------------------------------
@COM_ABLE96
#LOCALSIZE 1
#LOCALSSIZE 1
;乳交実行判定
SIF !TFLAG:100
	RETURN 0
SIF GLOBAL_COMABLE(96)
	RETURN RESULT
;男人か扶她じゃないとダメ
SIF !(HAS_PENIS(TARGET))
	RETURN 0
;調教者が女性か扶她じゃないとダメ
SIF !GETBIT(TALENT:PLAYER:2,0)
	RETURN 0
SIF TEQUIP:継続接吻
	RETURN 0
;上半身着衣
SIF TEQUIP:PLAYER:1 > 1 && TEQUIP:PLAYER:3 == 0
	RETURN 0
RETURN 1

