;-------------------------------------------------
;飛機杯
;道具使用指令、レベル2
;-------------------------------------------------
@COM43_DISPLAY
#FUNCTIONS
#LOCALSIZE 1
#LOCALSSIZE 1
SIF TEQUIP:オナホール
	RETURNF TRAINNAME:43 + "解除"

@COM43
;着脱の処理
TEQUIP:飛機杯 = !TEQUIP:飛機杯

;-------------------------------------------------
;COM別FLAGの設定
;-------------------------------------------------
;行為者
TCVAR:116 = PLAYER
;奉仕快楽フラグ
TCVAR:PLAYER:108 = 1

;TARGETが扶她の場合には射精可能に
CALL DECLARE_EJACULATION(TARGET, 0, 射精箇所_道具, PLAYER, CHARA_NONE, PLAYER, CHARA_NONE, 1000)

;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
IF (FLAG:70 == 1 && CFLAG:TARGET:344 == 0)
	BASE:MASTER:TSP -= 80
	SOURCE:快Ｃ = 200

ELSE

	DOWNBASE:体力 += 10
	DOWNBASE:気力 += 80

	SOURCE:快Ｃ = 200
	SOURCE:露出 = 20
	SOURCE:逸脱 = 30
	SOURCE:反感 = 30


	;-------------------------------------------------
	;特殊ソース処理
	;-------------------------------------------------
	;圧抑、抵抗持ちには、抑鬱ソース追加
	SIF TALENT:自己愛 < 0 || TALENT:抵抗
		SOURCE:鬱屈 += 30
ENDIF
;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;同性愛　レズなら戻り値1ゲイなら戻り値2
IF (FLAG:70 == 1 && CFLAG:TARGET:344 == 0)
	IF HETEROSEX(TARGET,PLAYER)
		EXP:PLAYER:(50 + HETEROSEX(TARGET,PLAYER)) += 1
	ENDIF
ELSE
	IF HETEROSEX(TARGET,PLAYER)
		EXP:(50 + HETEROSEX(TARGET,PLAYER)) += 1
		EXP:PLAYER:(50 + HETEROSEX(TARGET,PLAYER)) += 1
	ENDIF
ENDIF
EXP:PLAYER:道具使用経験 ++

RETURN 1
;-------------------------------------------------
;装着継続の処理
;-------------------------------------------------
@EQUIP_COM43(ARG)
PRINTL ＜飞机杯装备中＞

CALL DECLARE_EJACULATION(ARG, 0, 射精箇所_道具, PLAYER, CHARA_NONE, PLAYER, CHARA_NONE, 1000)
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
IF (FLAG:70 == 1 && CFLAG:ARG:344 == 0)
	BASE:MASTER:TSP -= 20
	SOURCE:ARG:快Ｃ += 100

ELSE

	DOWNBASE:ARG:体力 += 5
	DOWNBASE:ARG:気力 += 20

	SOURCE:ARG:快Ｃ += 100
	SOURCE:ARG:露出 += 10
	SOURCE:ARG:逸脱 += 15
	SOURCE:ARG:反感 += 15
	;-------------------------------------------------
	;経験の処理
	;-------------------------------------------------
ENDIF
RETURN 1

;-------------------------------------------------
;実行判定
;-------------------------------------------------
@COM_ABLE43
#LOCALSIZE 1
#LOCALSSIZE 1
;飛機杯実行判定
SIF !TFLAG:100
	RETURN 0
;一括管理
SIF GLOBAL_COMABLE(43)
	RETURN RESULT
;解除是つでも可能
SIF TEQUIP:12
	RETURN 1
;道具を持っているか、道具無設定でないとダメ
SIF ITEM:3 == 0 && NOITEM == 0
	RETURN 0
;男人や扶她じゃないとダメ
SIF !(HAS_PENIS(TARGET))
	RETURN 0

;下半身着衣
SIF TEQUIP:0 > 1
	RETURN 0
;ASSIの場合、技巧3以上じゃないと使えない。
IF ASSIPLAY
	SIF ABL:ASSI:技巧 < 3
		RETURN 0
ENDIF
;新妻PLAY中はダメ
SIF TEQUIP:33
	RETURN 0
RETURN 1


@COM43_TOUCH(ARG)
#LOCALSIZE 1
#LOCALSSIZE 1

CALL TOUCH_RESET_M(SET_YUBI)
TEQUIP:ARG:Ｃ接触部位 = 0
TEQUIP:ARG:Ｐ接触部位 = 0
