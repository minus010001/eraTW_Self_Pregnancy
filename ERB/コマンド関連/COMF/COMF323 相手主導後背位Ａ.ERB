;-------------------------------------------------
;对方主導後背位肛交
;性交系指令、レベル1
;-------------------------------------------------
@COM323
;-------------------------------------------------
;特殊派生処理
;-------------------------------------------------
;室内でないor浴室ルームで塑料地墊がないと立位に
SIF IS_STANDING_SEX(SELECTCOM) ;addition custom code
	TFLAG:193 = 1

;-------------------------------------------------
;COM別FLAGの設定
;-------------------------------------------------
;行為者
TCVAR:116 = PLAYER
;奉仕快楽フラグ
TCVAR:PLAYER:108 = 1

CALL DECLARE_EJACULATION(PLAYER, 0, 射精箇所_アナル, TARGET, CHARA_NONE, TARGET, CHARA_NONE, 2000)
TCVAR:PLAYER:童貞喪失 = 1
TCVAR:Ａ喪失発生 = 1
;強度

CALL DECLARE_EJACULATION(TARGET, 射精場合_Ａ責め, 0, PLAYER, CHARA_NONE, PLAYER, CHARA_NONE, 1500)
;強度

;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
DOWNBASE:体力 += 60
DOWNBASE:気力 += 60
DOWNBASE:PLAYER:体力 += 30
DOWNBASE:PLAYER:気力 += 50
SOURCE:PLAYER:快Ｃ = 400
SOURCE:快Ａ = 500
SOURCE:情愛 = 300
SOURCE:苦痛 = 900
SOURCE:露出 = 100
SOURCE:逸脱 = 200

;上のほうで計算した汚れデータ
SOURCE:不潔 = Y*10 + 60

;Aへの苦痛は先に処理しておく
CALL PAIN_CHECK_A(TARGET)

;-------------------------------------------------
;汚れの処理
;-------------------------------------------------
;射精に関係なく行われる処理はここから
;奴隷のＡ⇔調教者のＰ的污垢が移動
CALL STAIN_肛門Ｐ挿入

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
EXP:Ａ経験 ++
EXP:PLAYER:挿入経験 ++
SIF TALENT:恋慕 && ASSIPLAY == 0
	EXP:愛情経験 ++
;同性愛　レズなら戻り値1ゲイなら戻り値2
IF (FLAG:70 == 1 && CFLAG:TARGET:344 == 0)
	IF HETEROSEX(TARGET,PLAYER)
		EXP:PLAYER:(50 + HETEROSEX(TARGET,PLAYER)) += 4
	ENDIF
		EXP:PLAYER:時姦経験 += 1
ELSE
	IF HETEROSEX(TARGET,PLAYER)
		EXP:(50 + HETEROSEX(TARGET,PLAYER)) += 4
		EXP:PLAYER:(50 + HETEROSEX(TARGET,PLAYER)) += 4
	ENDIF
	EXP:Ａ性交経験 ++
	;愛情経験
	SIF !ASSIPLAY
		EXP:愛情経験 += TALENT:恋慕
ENDIF
RETURN 1


;-------------------------------------------------
;実行判定
;-------------------------------------------------
@COM_ABLE323
#LOCALSIZE 1
#LOCALSSIZE 1
SIF !TFLAG:100
	RETURN 0
SIF TCVAR:20 != 44
	RETURN 0
;毒人形だと肛門がついてないのでダメ
SIF TALENT:196 == 99
	RETURN 0
;調教者が男人、扶她の場合はある程度勃起てないとダメ
SIF (TALENT:PLAYER:2 & 2) && BASE:PLAYER:勃起 < 1000
	RETURN 0
;肛用振動棒挿入中はダメ
SIF TEQUIP:14
	RETURN 0
;後庭拉珠使用中は不可
SIF TEQUIP:15
	RETURN 0
;普通の浣腸使用中は不可
SIF TEQUIP:21
	RETURN 0
;バルーン使用中は不可
SIF TEQUIP:22
	RETURN 0
;電極使用中は不可
SIF TEQUIP:23
	RETURN 0

;体格差がある場合は経験がないとダメ
SIF 挿入不可(TARGET) == 1 && EXP:Ａ経験 < 50 && !TALENT:PLAYER:禁断的知識
	RETURN 0
;さらに体格差があると禁断的知識が必要
SIF 挿入不可(TARGET) == 2 && (!TALENT:PLAYER:禁断的知識 || EXP:Ａ経験 < 50)
	RETURN 0
SIF 挿入不可(TARGET) == 3
	RETURN 0
;調教者が男人、半人半妖、扶她、もしくは穿戴式假陰茎がないとダメ
SIF !(TALENT:PLAYER:2 & 2) && ITEM:PBAND == 0
	RETURN 0


;対面座位からはダメ
SIF TEQUIP:体位 == 4
	RETURN 0
;下半身着衣
SIF TEQUIP:0 & 4
	RETURN 0
;浴室PLAY中は塑料地墊が無いとダメ
IF TEQUIP:31
	SIF ITEM:20 == 0 && NOITEM == 0
		RETURN 0
ENDIF

RETURN 1

