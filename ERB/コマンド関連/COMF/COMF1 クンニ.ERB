;-------------------------------------------------
;舐陰
;愛撫系指令　レベル1
;-------------------------------------------------
@COM1
;-------------------------------------------------
;COM別FLAGの設定
;-------------------------------------------------
;行為者
TCVAR:116 = PLAYER
;奉仕快楽
TCVAR:PLAYER:108 = 1

CALL DECLARE_EJACULATION(TARGET, 0, 射精箇所_口, PLAYER, CHARA_NONE, PLAYER, CHARA_NONE, 500)
;強度

;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
IF (FLAG:70 == 1 && CFLAG:TARGET:344 == 0)
	BASE:MASTER:TSP -= 20
	SOURCE:快Ｃ = 80
	SOURCE:PLAYER:快Ｍ += 50
	SOURCE:液体 = 1000
	;性技補正
	IF ABL:PLAYER:舌 >= 4
		SOURCE:快Ｃ += 100
		SOURCE:液体 += 400
	ELSE
		SOURCE:快Ｃ += ABL:PLAYER:舌 * 20
		SOURCE:液体 += ABL:PLAYER:舌 * 80
	ENDIF


	IF HETEROSEX(TARGET,PLAYER)
		EXP:PLAYER:(50 + HETEROSEX(TARGET,PLAYER)) += 3
	ENDIF


	;口淫経験
	EXP:PLAYER:口淫経験 ++
;時間停止無
ELSE
	DOWNBASE:体力 += 5
	DOWNBASE:気力 += 50
	SOURCE:PLAYER:快Ｍ += 50
	SOURCE:快Ｃ = 80
	SOURCE:液体 = 1000
	SOURCE:露出 = 10
	SOURCE:逸脱 = 15
	SOURCE:反感 = 15

	;-------------------------------------------------
	;特殊ソース処理
	;-------------------------------------------------
	;圧抑、抵抗持ちには、抑鬱ソース追加
	SIF TALENT:自己愛 < 0 || TALENT:抵抗
		SOURCE:鬱屈 += 20

	;性技補正
	IF ABL:PLAYER:舌 >= 4
		SOURCE:快Ｃ += 100
		SOURCE:液体 += 400
	ELSE
		SOURCE:快Ｃ += ABL:PLAYER:舌 * 20
		SOURCE:液体 += ABL:PLAYER:舌 * 80
	ENDIF

	;-------------------------------------------------
	;経験の処理
	;-------------------------------------------------
	;同性愛　レズなら戻り値1ゲイなら戻り値2
	IF HETEROSEX(TARGET,PLAYER)
		EXP:(50 + HETEROSEX(TARGET,PLAYER)) += 3
		EXP:PLAYER:(50 + HETEROSEX(TARGET,PLAYER)) += 3
	ENDIF

	;口淫経験
	EXP:PLAYER:口淫経験 ++
ENDIF
;-------------------------------------------------
;時間停止分岐終わり、共通する素質補正や汚れの処理
;-------------------------------------------------
;舌を使用調教では、調教者の舌使いによって、快感のソース増加
IF TALENT:PLAYER:舌使い
	TIMES SOURCE:快Ｃ , 1.50
	TIMES SOURCE:液体 , 1.50
ENDIF
;猫舌では減少、調教者に嗜虐快楽経験を追加
IF TALENT:PLAYER:猫舌
	TIMES SOURCE:快Ｃ , 0.75
	EXP:PLAYER:嗜虐快楽経験 += 1
ENDIF

;奴隷のＶ⇔調教者の口的污垢が移動
STAIN:Ｖ |= STAIN:PLAYER:口
STAIN:PLAYER:口 |= STAIN:Ｖ
IF HETEROSEX(TARGET,PLAYER)
	EXP:PLAYER:(50 + HETEROSEX(TARGET,PLAYER)) += 3
ENDIF

RETURN 1

;-------------------------------------------------
;舐陰実行判定
;-------------------------------------------------
@COM_ABLE1
#LOCALSIZE 1
#LOCALSSIZE 1
SIF !TFLAG:100
	RETURN 0
;一括管理
SIF GLOBAL_COMABLE(1)
	RETURN RESULT
;性器が汚れているとPLAYERの場合舐陰はできない（調教者が汚臭無視か愛液、母乳、巧克力のよごれならＯＫ）
SIF STAIN:3 >= 2 && (STAIN:3 != 16 && STAIN:3 != 17 && STAIN:3 != 128 && STAIN:3 != 129 && STAIN:3 != 144 && STAIN:3 != 145) && ASSIPLAY == 0 && TALENT:PLAYER:汚臭耐性 < 2
	RETURN 0
;性器が汚れており、汚臭敏感で従順3以下のASSIの場合舐陰はできない（調教者が汚臭無視か愛液、母乳、巧克力のよごれならＯＫ）
IF STAIN:3 >= 2 && (STAIN:3 != 16 && STAIN:3 != 17 && STAIN:3 != 128 && STAIN:3 != 129 && STAIN:3 != 144 && STAIN:3 != 145) && ASSIPLAY
	SIF ABL:ASSI:従順 <= 3 && TALENT:ASSI:汚臭耐性 < 0
		RETURN 0
ENDIF
;下半身着衣
SIF TEQUIP:0 & 4
	RETURN 0
RETURN 1

@COM1_TAGS
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTION
LOCAL = 0
SETBIT LOCAL, BIT_乳首吸い解除
RETURNF LOCAL

@COM1_TOUCH(ARG)
#LOCALSIZE 1
#LOCALSSIZE 1

