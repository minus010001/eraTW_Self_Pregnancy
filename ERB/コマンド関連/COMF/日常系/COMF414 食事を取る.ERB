#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTION
LOCAL = 0
SETBIT LOCAL, BIT_食事コマンド
SETBIT LOCAL, BIT_料理リセット
SETBIT LOCAL, BIT_家事コマンド
