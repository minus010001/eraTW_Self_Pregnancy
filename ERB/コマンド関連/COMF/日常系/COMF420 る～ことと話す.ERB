		RESETCOLOR

;;;(MAXBASE:LOCAL:酒気 / 10) * 4 

		IF TCVAR:LOCAL:烂醉
			SELECTCASE BASE:LOCAL:酒気
				CASE IS >= (MAXBASE:LOCAL:酒気 / 10) * 4
