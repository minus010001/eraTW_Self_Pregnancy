;-------------------------------------------------
;実行判定
;-------------------------------------------------
;和留琴対話
@COM_ABLE420
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC MAP_ID
;自宅外は不可
SIF AT_HOME(MASTER) == 0
	RETURN 0
;停止中は不可
SIF FLAG:70 == 1
	RETURN 0
;移動実行判定
SIF !TFLAG:100
	RETURN 0
;一括管理
SIF GLOBAL_COMABLE(420)
	RETURN RESULT
MAP_ID = GET_CURRENT_MAP()
SELECTCASE MAP_ID
	CASE 0
		;留琴が寝ていたらダメ
		SIF CFLAG:2:睡眠
			RETURN 0
		;留琴の居る所
		SIF CFLAG:MASTER:現在位置 != CFLAG:2:現在位置
			RETURN 0
	CASE 3
		SIF CFLAG:MASTER:現在位置 != 323
			RETURN 0
	CASE 9
		SIF CFLAG:MASTER:現在位置 != 923
			RETURN 0
	CASEELSE
		RETURN 0
ENDSELECT

SIF CFLAG:诶嘿嘿 == 2
	RETURN 0
RETURN 1

