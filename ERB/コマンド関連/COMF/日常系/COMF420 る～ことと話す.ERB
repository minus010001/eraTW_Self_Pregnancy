@COM420_DISPLAY
#FUNCTIONS
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC MAP_ID
VARSET LOCALS
MAP_ID = GET_CURRENT_MAP()
SELECTCASE MAP_ID
	CASE 0
		LOCALS '= "る～こと"
	CASE 3
		LOCALS '= "メイド妖精"
	CASE 9
		LOCALS '= "ゾンビフェアリー"
ENDSELECT
RETURNF LOCALS + "と話す"

@COM420
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC MAIN_INPUT_LINE
PRINTL 「你有什么事吗？」
PRINTL [0] - 想找人
PRINTL [1] - 想做扫除
PRINTL [2] - 关于git控制系统
PRINTL [100] - 返回
MAIN_INPUT_LINE = LINECOUNT
$MAIN_INPUT
CLEARLINE LINECOUNT - MAIN_INPUT_LINE
INPUT
IF RESULT == 0
	PRINTL 「要寻找谁呢？」
	CALL HITOSAGASI()
ELSEIF RESULT == 1
	CALL OHEYA_CHECK
ELSEIF RESULT == 2
	PRINTDATAL
		DATAFORM 「使用git控制系统的话可以将补丁一次性整合起来哦」
		DATAFORM 「有git控制系统就可以很简单的把握变更的地方」
		DATAFORM 「过去的代码也能很好的得到保存」
	ENDDATA
	PRINTW 好像很厉害的样子
	GOTO MAIN_INPUT
ELSEIF RESULT == 100
	RETURN -1
ELSE
	GOTO MAIN_INPUT
ENDIF
INPUT
IF RESULT == 0
	GOTO MAIN_INPUT
ELSE
	CALL UI_EXECUTE_MOVE(RESULT)
ENDIF
RETURN -1

@OHEYA_CHECK(MAP_ID = -1)
#LOCALSIZE 3
#LOCALSSIZE 1
#DIM MAP_ID
SIF MAP_ID == -1
	MAP_ID = GET_CURRENT_MAP()
VARSET LOCAL
FOR LOCAL, MINROOM(MAP_ID), MAXROOM(MAP_ID)
	LOCALS = %NAME_FROM_PLACE(LOCAL)%
	SIF LOCALS == ""
		CONTINUE
	SIF CFLAG:MASTER:現在位置 == LOCAL
		SETCOLOR C_GREEN
	PRINTFORM [{LOCAL, 3}]%LOCALS, 25, RIGHT%%SEIKETU(LOCAL), 15, RIGHT%
	RESETCOLOR
	LOCAL:1 ++
	IF LOCAL:1 % 2 == 0
		PRINTL
	ELSE
		PRINT 　　
	ENDIF
NEXT
PRINTFORML
DRAWLINE
PRINTFORML [0] 返回
;PRINTBUTTON "[確認終了]", 0

@SEIKETU(ARG)
#FUNCTIONS
#LOCALSIZE 1
#LOCALSSIZE 1
IF OUTROOF(ARG) && DAY:2 == 4
	SELECTCASE YOGORE:ARG
		CASE IS < 100
			SETCOLOR C_GREEN
			RETURNF "积雪量:干净"
		CASE IS < 500
			SETCOLOR C_M_GREEN
			RETURNF "积雪量:小"
		CASE IS < 1000
			SETCOLOR C_P_GREEN
			RETURNF "积雪量:较小"
		CASE IS < 2000
			SETCOLOR 0xFFFFFF
			RETURNF "积雪量:中"
		CASE IS < 3500
			SETCOLOR 0xFFFFFF
			RETURNF "积雪量:较大"
		CASE IS < 5000
			SETCOLOR 0xFFFFFF
			RETURNF "积雪量:大"
		CASEELSE
			SETCOLOR 0xFFFFFF
			RETURNF "积雪量:雪山"
	ENDSELECT
ELSE
	SELECTCASE YOGORE:ARG
		CASE IS < 100
			SETCOLOR C_GREEN
			RETURNF "清洁度:最高"
		CASE IS < 500
			SETCOLOR C_M_GREEN
			RETURNF "清洁度:高"
		CASE IS < 1000
			SETCOLOR C_P_GREEN
			RETURNF "清洁度:较高"
		CASE IS < 2000
			SETCOLOR C_YELLOW
			RETURNF "清洁度:中"
		CASE IS < 3500
			SETCOLOR C_V_PINK
			RETURNF "清洁度:较低"
		CASE IS < 5000
			SETCOLOR C_RED
			RETURNF "清洁度:低"
		CASEELSE
			SETCOLOR C_RED
			RETURNF "清洁度:垃圾山"
	ENDSELECT
ENDIF

@HITOSAGASI(ARG, ARG:2=0)
#LOCALSIZE 1
#LOCALSSIZE 1
;GMF：HITOSAGASI_2已函数化MAP_ID参数，无需栈路由
CALL HITOSAGASI_2(1)
CALL HITOSAGASI_2(2)
;custom code
PRINTBUTTON "[返回]", 0
;Qol custom code
IF ARG:2 == 1
	PRINTL
	PRINTBUTTON "[查看其他区域]", -1
	PRINTL
ENDIF

;ARG=何回目の表示か(1or2)
@HITOSAGASI_2(ARG, MAP_ID = -1)
#LOCALSIZE 12
#LOCALSSIZE 1
#DIM MAP_ID
SIF MAP_ID == -1
	MAP_ID = GET_CURRENT_MAP()
SIF FLAG:並び替え
	CALL CHARASORT_EX
FOR LOCAL:1, 1, EX_CHARANUM
	IF FLAG:並び替え
		LOCAL = RESULT:(LOCAL:1)
		SIF LOCAL < 0
			CONTINUE
	ELSE
		LOCAL = LOCAL:1
		SIF LOCAL >= CHARANUM
			BREAK
	ENDIF
	SIF AT_HOME(LOCAL) == 0
		CONTINUE
	SIF CFLAG:LOCAL:現在位置 < MINROOM(MAP_ID)
		CONTINUE
	SIF CFLAG:LOCAL:現在位置 == MAXROOM(MAP_ID) && CFLAG:LOCAL:睡眠
		CONTINUE
	IF ARG == 1
		SIF !CFLAG:LOCAL:神社在住
			CONTINUE
		SETCOLOR C_S_BLUE
	ELSEIF ARG == 2
		SIF CFLAG:LOCAL:神社在住
			CONTINUE
	ENDIF
	PRINTFORM %CALLNAME:LOCAL,11,Left%
	RESETCOLOR
;qol委托提示
IF CFLAG:LOCAL:404 % 100 == 15
	IF CFLAG:LOCAL:403 == 1
		CALL COLORMESSAGE(@"！",C_V_PINK, 0)
	ELSEIF CFLAG:LOCAL:403 == 2
		CALL COLORMESSAGE(@"？",C_V_PINK, 0)
	ELSE
		PRINT 　
	ENDIF
ELSE
	IF CFLAG:LOCAL:403 == 1
		;任务不满 且 能接任务
		IF SEARCH_IRAI_EMPTY() && INT_DATA_IRAI(CFLAG:LOCAL:依頼内容, OPR_委托受託可能条件, LOCAL)
			CALL COLORMESSAGE(@"！",C_YELLOW, 0)
		ELSEIF INT_DATA_IRAI(CFLAG:LOCAL:依頼内容, OPR_委托受託可能条件, LOCAL)
			IF !SEARCH_IRAI_EMPTY()
				CALL COLORMESSAGE(@"！",C_GRAY, 0)
			ELSE
				PRINT 　
			ENDIF
		ELSE
			PRINT 　
		ENDIF
	ELSEIF CFLAG:LOCAL:403 == 2
		CALL COLORMESSAGE(@"？",C_GRAY, 0)
	ELSEIF CFLAG:LOCAL:403 == 3
		CALL COLORMESSAGE(@"？",C_YELLOW, 0)
	ELSE
		PRINT 　
	ENDIF
ENDIF

;交互角色
