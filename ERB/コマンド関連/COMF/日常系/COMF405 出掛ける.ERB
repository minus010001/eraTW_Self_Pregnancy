;-------------------------------------------------
;外出
;日常系指令、レベル1
;-------------------------------------------------
@COM405
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC 同行者数
#DIM DYNAMIC 衰弱同行者数
#DIM DYNAMIC 工作同行者数
#DIM DYNAMIC 委托拒否数
#DIM DYNAMIC 口上拒否数
#DIM DYNAMIC 出口遭遇角色
#DIM DYNAMIC LOCAL_MAP
#DIM DYNAMIC LOCAL_ENTRANCE
#DIM DYNAMIC 外出先
SIF Setting_背景图片
	CALL 背景图片打印()
;GMF：用局部变量替代轻量级上下文切换
;MAIN_MAP/ENTRANCE不再全局替换，改为局部变量传递
IF GMF_IS_ODEKAKE()
	PRINTFORML 当前处于外出地图模式，将先转为据点地图模式进行外出。
	CALL GMF_604_TO_400
ENDIF
LOCAL_MAP = GET_CURRENT_MAP()
LOCAL_ENTRANCE = GET_ENTRANCE(LOCAL_MAP)
VARSET LOCAL
FOR LOCAL,1,CHARANUM
	IF CFLAG:(LOCAL):同行
		同行者数 ++
		SIF CFLAG:LOCAL:衰弱 || BASE:LOCAL:気力 == 0
			衰弱同行者数++
		IF !CHARA_HOLIDAY(LOCAL) && BASE:LOCAL:工作量
			PRINTFORML %CALLNAME:(LOCAL)%需要完成{BASE:LOCAL:工作量}的工作。
			工作同行者数++
		ENDIF
		SIF CFLAG:LOCAL:態度 < 1 && CAN_IRAI_CHARA_GO_TOGATHER(LOCAL) && !Add_CAN_IRAI_CHARA_GO_OUT_ALWAYS(LOCAL) ;魔改内容，新增可以带出据点的委托人
			委托拒否数++
		;QOL,新增剧本侧判定，所有同行者均可自定义拒绝邀约
		TFLAG:192 = 0
		CALL KOJO_MESSAGE_SEND("SUCCESS",-1,LOCAL,-1,-1)
		SIF TFLAG:192 < 0
			口上拒否数++
	ENDIF
NEXT
IF NEMUKE() >= 720 && IsRefreshed()
	TFLAG:193 = 1
ELSEIF 同行者数 > 1 && !MOREDATE
	TFLAG:193 = 2
ELSEIF 衰弱同行者数 || BASE:MASTER:気力 == 0
	TFLAG:193 = 3
ELSEIF 工作同行者数 && FESTIVAL() == ""
	TFLAG:193 = 4
ELSEIF 委托拒否数
	TFLAG:193 = 5
;(天候パッチ)悪天候時も外出可能に
;ELSEIF TIME:5 == 9 || TIME:5 == 5 || WIND_VELOCITY >= 2
;	DRAWLINE
;	PRINTL 因为天气恶劣所以无法外出
;	RETURN -1
;	TFLAG:193 = 6
ELSEIF TALENT:MASTER:100 < -4
	TFLAG:193 = 7
ELSEIF 口上拒否数
	TFLAG:193 = 99
ENDIF
IF TFLAG:193
	FOR LOCAL, 1, GET_TARGETNUM() + 1
		IF CFLAG:(TARGET:LOCAL):同行
			CALL KOJO_MESSAGE_SEND("CUSTOM_EVENT",2,TARGET:LOCAL)
		ENDIF
	NEXT
RESULT = -1
GOTO COM405_END
ENDIF
IF !CHK_ENTRANCE(CFLAG:MASTER:現在位置, LOCAL_MAP)
	PRINTFORML 首先往%NAME_FROM_PLACE(LOCAL_ENTRANCE)%走去
	;-----------------------------
	;移动不可需要弹出
	IF MAP_CAN_MOVE(LOCAL_ENTRANCE) == 0
		CALL CANNOT_MOVE_MESSAGE(LOCAL_ENTRANCE)
	ELSE
		CALL SKIP_MOVE(CFLAG:MASTER:現在位置, LOCAL_ENTRANCE)
	ENDIF
	IF !CHK_ENTRANCE(CFLAG:MASTER:現在位置, LOCAL_MAP) ;SKIP_MOVE中玩家选择停下了，无事发生
		TFLAG:193 = 8
		FOR LOCAL, 1, GET_TARGETNUM() + 1
			IF CFLAG:(TARGET:LOCAL):同行
				CALL KOJO_MESSAGE_SEND("CUSTOM_EVENT",2,TARGET:LOCAL)
			ENDIF
		NEXT
	ENDIF
	;qol，允许玩家在地图出入口触发移动时遭遇事件和选择中止外出
	出口遭遇角色 = 0
	FOR LOCAL,1,CHARANUM
		IF CFLAG:LOCAL:現在位置 == LOCAL_ENTRANCE
			出口遭遇角色 = LOCAL
			BREAK
		ENDIF
	NEXT
	IF 出口遭遇角色
		CALL KOJO_ACTIVE_INFO(出口遭遇角色)
		PRINTFORML 经过%NAME_FROM_PLACE(LOCAL_ENTRANCE)%时遇上了%CALLNAME:(出口遭遇角色)%。
		IF FLAG:停下脚步 == 2
			;立ち止まらない
		ELSEIF FLAG:停下脚步 == 1 && !RESULT
			;口上がある場合のみ
		ELSE
			CALL ASK_M("打声招呼后继续移动",!FLAG:70,"无视",1,"停下来",1)
			IF RESULT == 2
				CALL KOJO_MESSAGE_SEND("EVENT",4,出口遭遇角色,1,0)
				TFLAG:193 = 8
				FOR LOCAL, 1, GET_TARGETNUM() + 1
					IF CFLAG:(TARGET:LOCAL):同行
						CALL KOJO_MESSAGE_SEND("CUSTOM_EVENT",2,TARGET:LOCAL)
					ENDIF
				NEXT
				RESULT = -1
				GOTO COM405_END
			ELSEIF RESULT == 1
				CALL KOJO_MESSAGE_SEND("EVENT",4,出口遭遇角色,3,0)
			ELSE
				CALL KOJO_MESSAGE_SEND("EVENT",4,出口遭遇角色,2,0)
			ENDIF
		ENDIF
	ENDIF
ENDIF
DRAWLINE
CALL OTHERREGIONS("外出")
外出先 = RESULT
IF 外出先 == LOCAL_MAP || 外出先 == 100
	FLAG:约会的对象 = 0
	SIF MOREDATE
		CALL CLEAN_GROUP_DATES
	TFLAG:193 = 8
	FOR LOCAL, 1, GET_TARGETNUM() + 1
		IF CFLAG:(TARGET:LOCAL):同行
			CALL KOJO_MESSAGE_SEND("CUSTOM_EVENT",2,TARGET:LOCAL)
		ENDIF
	NEXT
	RESULT = -1
	GOTO COM405_END
ENDIF
RESULT = 0
$COM405_END
RETURN RESULT

@COM_ABLE405
#LOCALSIZE 1
#LOCALSSIZE 1
SIF !TFLAG:100
	RETURN 0
;一括管理
SIF IS_GAP_GUEST(MASTER)
	RETURN 0
SIF GLOBAL_COMABLE(405)
	RETURN RESULT
;携带中は不可
SIF TFLAG:運搬
	RETURN 0
SIF CFLAG:MASTER:陪睡中
	RETURN 0
SIF CFLAG:诶嘿嘿 == 2
	RETURN 0
SIF CFLAG:MASTER:恶作剧
	RETURN 0
;参道設定
;SIF !CHK_ENTRANCE(CFLAG:MASTER:現在位置, MAIN_MAP)
;	RETURN 0
;GMF 现在全地图可以外出
SIF !AT_HOME(MASTER)
	RETURN 0
RETURN 1

;-------------------------------------------------
;触发事件-邀请外出失败
;成功时会进入剧本的对应指令文本函数
;-------------------------------------------------
@CUSTOM_EVENT_MESSAGE_2(ARG,ARG:1,ARG:2,ARG:3)
#LOCALSIZE 1
#LOCALSSIZE 1
SELECTCASE TFLAG:193
	CASE 0
		;外出成功，情景信息在@OTHERREGIONS里
	CASE 1
		PRINTL 在睡意来袭时还是别外出比较好吧
	CASE 2
		PRINTL 未在设置中开启多人约会功能
	CASE 3
		PRINTFORML \@ BASE:MASTER:気力 == 0 ? 因为身体不适所以无法外出 # 不要带身体不适的人外出比较好吧\@
	CASE 4
		PRINTL 因为同行者处于工作日所以无法外出
	CASE 5
		PRINTL 被说了有时间出门不如早点完成委托…
	CASE 6
		PRINTL 以这样的身体出远门是很危险的
	CASE 99
		PRINTFORML 邀约被拒绝了
ENDSELECT
