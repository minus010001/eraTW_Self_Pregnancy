;-----------------------------------------------------------
;调合配方数据的设定与输出函数
;R_ID   配方编号（产品ID*10 + 配方号）
;TYPE   0~5=素材编号, 6=产出量, 7=是否需要水, 8=素材总数
;导出模式  0=通常（路由到QOL层）, 1=将纯数据属性输出到全局变量
;
;[QOL] 通常模式路由到 QOL_RECIPE_DATA
;导出模式时，设置以下全局变量：
;  RECIPE_ORIG_ING:0~5  — 素材物品ID（-1=未设置）
;  RECIPE_ORIG_AMT      — 产出量
;  RECIPE_ORIG_WATER    — 是否需要水（0/1）
;  RECIPE_ORIG_LOT      — 素材总数
;-----------------------------------------------------------
@RECIPE_DATA(R_ID, TYPE, 导出模式)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTION
#DIM DYNAMIC TYPE
#DIM DYNAMIC ING, QOL_MAX_INGREDIENTS
#DIM DYNAMIC AMT
#DIM DYNAMIC WATER
#DIM DYNAMIC R_ID
#DIM DYNAMIC LOT
#DIM DYNAMIC 导出模式
SIF !导出模式 && INRANGE(TYPE, 0, 8)
	RETURNF QOL_RECIPE_DATA(R_ID, TYPE)

IF 导出模式
	VARSET RECIPE_ORIG_ING
	RECIPE_ORIG_AMT = 0
	RECIPE_ORIG_WATER = 0
	RECIPE_ORIG_LOT = 0
ENDIF
VARSET ING
AMT = 0		;一次能做出来几份
WATER = 0	;需不需要加水（从各处的井里挑）
LOT = 0		;需要的素材总量（具体啥素材要多少可以自己配...大概？）

