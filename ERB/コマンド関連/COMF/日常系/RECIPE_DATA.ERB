;-----------------------------------------------------------
;返回物品编号ARG:0的调合难度的函数
;（兼用于判断是否为可调合物品）
;ARG:0     物品ID
;导出模式  0=通常（路由到QOL层）, 1=从原始数据直接获取
;RETURNF   0=不可调合, 1～5=调合难度
;COMMENT   添加物品时，请在CASE中追加
;-----------------------------------------------------------
@PHARMACY_RANK(ARG:0, 导出模式)
#FUNCTION
#DIM DYNAMIC 导出模式
SIF !导出模式
	RETURNF QOL_PHARMACY_RANK(ARG:0)
SELECTCASE ARG
	;(酿酒补丁)追加酒的调合难度为1
	;自定义代码，添加了熟成前弗拉戈利诺
	CASE [[晋升魔药Lv1]], [[晋升魔药Lv2]], [[触媒lv1]], [[触媒lv2]], [[潤滑液]], [[避孕套]], [[蒸馏酒]], [[アイス]], [[糖]], [[青汁]], [[薬水]], [[姜黄飲料]], [[蝦蟇の油]], [[鱼粕]], [[肉骨粉]], [[烧酒]], [[陈酿前的莓子酒]], [[陈酿前的朗姆酒]], [[陈酿前的白兰地]], [[果渣白兰地]], [[草木灰]], [[ITEM_墨西哥卷饼]], [[酒粕烧酒]], [[甘酒]], [[熟成前フラゴリーノ]], [[符咒]]
		RETURNF 1
	;(酿酒补丁)灰汁卷的调合难度为2
	;自定义代码，添加了南瓜烧酒
	CASE [[晋升魔药Lv3]], [[晋升魔药Lv4]], [[触媒lv3]], [[触媒lv4]],[[利尿剤]], [[药酒]], [[肥料]], [[紅茶]], [[营养饮料]], [[精力剤]], [[破眠薬水]], [[栄養強化剤]], [[弹力薬]], [[冰柱爆弹]], [[墓志铭]], [[灰汁卷]], [[カボチャ焼酎]]
		RETURNF 2
	;Custom code, added アドヴォカート (advocaat)
	CASE [[晋升魔药Lv5]], [[晋升魔药Lv6]], [[触媒lv5]],[[媚薬]], [[催情薬]], [[睡眠薬]], [[大回復薬]], [[精力剤『天元凸破』]], [[魔法薬水]], [[一夜奇稻田]], [[绯红之王]], [[蛋黄酒]]
		RETURNF 3
	CASE [[晋升魔药Lv7]], [[晋升魔药Lv8]],[[薬的材料(双)]], [[薬的材料(消)]], [[排卵誘発剤]], [[流星群Ｘ]], [[万能药]], [[国士無双の薬]], [[毒气花园]], [[太乙の火種]], [[魅惑的饵种]], [[弹丸魔像]], [[命の卡片]], [[スペルの卡片]], [[魔人经卷（仿）]]
		RETURNF 4
	;Custom code, added 精米 (polished rice)
	CASE [[晋升魔药Lv9]], [[晋升魔药Lv10]],[[紅色糖果]], [[茶色糖果]], [[水色糖果]], [[奇跡之石]], [[リバースフェザー]], [[仙丹]], [[仙香玉兎]], [[劇毒身軀]], [[賢者の石]], [[神奇蘑菇]], [[精米]]
		RETURNF 5
ENDSELECT
RETURNF 0
