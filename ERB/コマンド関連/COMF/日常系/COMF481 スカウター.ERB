;-------------------------------------------------
;测定仪
;道具使用指令、レベル1
;-------------------------------------------------
@COM481
PRINTFORML 要测定谁的女子力呢？
FOR LOCAL,0,CHARANUM
	SIF CFLAG:LOCAL:現在位置 !=  CFLAG:MASTER:現在位置
		CONTINUE
	PRINTFORML [{LOCAL}] - %CALLNAME:LOCAL%
NEXT
DRAWLINE
PRINTFORML [999] - 放弃
INPUT
IF RESULT == 999
	RETURN -1
ELSE
	CALL EVALUATE_GIRLPOWER(RESULT)
	SIF !FLAG:70
		TIME += 3
	TFLAG:102 = 0
	RETURN 0
ENDIF
;-------------------------------------------------
;COM別FLAGの設定
;-------------------------------------------------
;行為者
TCVAR:116 = PLAYER

RETURN 0

