;@醸造できた量(ARG)


;-------------------------------------------------
;发酵检查（每日/时间加速时调用）
;-------------------------------------------------
;检查当前瓶中酒是否已完成发酵：
;  - DAY:10 递增1
;  - 如果经过天数 >= 醸造日数，则触发変化先变化
;  - 酒造家Lv2以上且天数>2时，实际所需天数-1
;
;副作用：
;  - DAY:10 递增
;  - 发酵完成时更新 VAR_FERMENT 和 DAY:10
;-------------------------------------------------
@酒造
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS DYNAMIC ALTER
DAY:10 ++
LOCAL = GETMETH_INT(0, "酒データ", ALC_ID(), "醸造日数")
;speed up from brewer talent
SIF TALENT:MASTER:酒造家 >= 2 && LOCAL > 2
	LOCAL--
IF LOCAL > 0 && LOCAL <= DAY:10
	ALTER = %GETMETH_STR(0, "酒データ", ALC_ID(), "変化先")%
	CALL COLORMESSAGE(@"酒虫之瓶中的%VAR_FERMENT%变成了%ALTER%",C_YELLOW, 2)
	DAY:10 = 0
	VAR_FERMENT = %ALTER%
	CALL BREWING_GUIDE_MAKE_KNOWN(VAR_FERMENT)
ENDIF

;-------------------------------------------------
;饮酒处理（增加酒气）
;-------------------------------------------------
;参数：
;  C_ID    - 角色ID
;  itemnum - 物品ID
;
;酒気増加量受酒耐性天赋影响：
;  -1(弱) → ×1.2, 1 → ×0.9, 2 → ×0.75, 3 → ×0.5
;  -2(极弱) → 根据"不会喝酒"计数额外加成
;主角额外受醒酒药(TFLAG:醒酒药)减免
;-------------------------------------------------
@DRUNKEN(C_ID, itemnum)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM C_ID
#DIM 酒ID
#DIM itemnum
#DIM 酒気増加量

LOCALS = %ITEMNAME:itemnum%

酒ID = ALC_ID(LOCALS)

酒気増加量 = GETMETH_INT(C_ID, "酒データ", 酒ID, "酒気増加量")
;一夜奇稻田を除く
IF LOCALS != "一夜奇稻田"
	IF TALENT:C_ID:酒耐性 == -1
		TIMES 酒気増加量, 1.2
	ELSEIF TALENT:C_ID:酒耐性 == 1
		TIMES 酒気増加量, 0.9
	ELSEIF TALENT:C_ID:酒耐性 == 2
		TIMES 酒気増加量, 0.75
	ELSEIF TALENT:C_ID:酒耐性 == 3
		TIMES 酒気増加量, 0.5
	ELSEIF TALENT:C_ID:酒耐性 == -2
		IF CFLAG:C_ID:不會喝酒 >= 5
			TIMES 酒気増加量, 2.0
		ELSEIF CFLAG:C_ID:不會喝酒 >= 2
			TIMES 酒気増加量, 1.5
		ELSE
			TIMES 酒気増加量, 1.0
		ENDIF
	ENDIF
ENDIF
SIF C_ID == MASTER
	酒気増加量 = 酒気増加量 / (1 + TFLAG:醒酒药)
BASE:C_ID:酒気 = MIN(BASE:C_ID:酒気 + 酒気増加量 ,MAXBASE:C_ID:酒気)
