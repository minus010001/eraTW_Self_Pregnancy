@F酒データ_WATER_GENERAL(ARG, O_DATA, V_NAME)
#FUNCTIONS
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
	;shared with other water
	CASE "ITEM：马铃薯"
		RETURNF "薯类酒曲"
	CASE "QUANTITY：马铃薯"
		RETURNF "10"
	;Custom data, pumpkins to pumpkin water
	CASE "ITEM：南瓜"
		RETURNF "南瓜水"
	CASE "QUANTITY：南瓜"
		RETURNF "10"

	;Custom data, barley to malted barley
	CASE "ITEM：大麦"
		RETURNF "麦芽汁"
	CASE "QUANTITY：大麦"
		RETURNF "10"

	CASE "ITEM：蜂蜜"
		RETURNF "蜂蜜水"
	CASE "QUANTITY：蜂蜜"
		RETURNF "10"

	CASE "ITEM：树莓"
		RETURNF "树莓汁"
	CASE "QUANTITY：树莓"
		RETURNF "20"
	CASE "EXTRA：树莓"
		SIF MAGIC_DLC
			RETURNF "果渣"
	CASE "EXTRAQUANTITY：树莓"
		SIF MAGIC_DLC
			RETURNF "1"
	;Custom data, strawberries to strawberry juice
	CASE "ITEM：草莓"
		RETURNF "草莓汁"
	CASE "QUANTITY：草莓"
		RETURNF "20"
	CASE "EXTRA：草莓"
		SIF MAGIC_DLC
			RETURNF "果渣"
	CASE "EXTRAQUANTITY：草莓"
		SIF MAGIC_DLC
			RETURNF "1"

	;Custom data, watermelons to watermelon juice
	CASE "ITEM：西瓜"
		RETURNF "西瓜汁"
	CASE "QUANTITY：西瓜"
		RETURNF "20"
	CASE "EXTRA：西瓜"
		SIF MAGIC_DLC
			RETURNF "果渣"
	CASE "EXTRAQUANTITY：西瓜"
		SIF MAGIC_DLC
			RETURNF "1"

	;Custom data, apple to apple juice
	CASE "ITEM：苹果"
		RETURNF "苹果汁"
	CASE "QUANTITY：苹果"
		RETURNF "20"

	;Custom data, ume to ume water
	CASE "ITEM：梅"
		RETURNF "梅子加井水"
	CASE "QUANTITY：梅"
		RETURNF "20"

	;Custom data, nuts to macerated almond
	CASE "ITEM：坚果"
		RETURNF "杏仁水"
	CASE "QUANTITY：坚果"
		RETURNF "20"

	;Custom data, akebia to akebia water
	CASE "ITEM：木通果"
		RETURNF "木通果汁"
	CASE "QUANTITY：木通果"
		RETURNF "10"
	CASE "EXTRA：木通果"
		SIF MAGIC_DLC
			RETURNF "果渣"
	CASE "EXTRAQUANTITY：木通果"
		SIF MAGIC_DLC
			RETURNF "1"

	CASE "ITEM：山葡萄"
		RETURNF "葡萄汁"
	CASE "QUANTITY：山葡萄"
		RETURNF "20"
	CASE "EXTRA：山葡萄"
		RETURNF "果渣"
	CASE "EXTRAQUANTITY：山葡萄"
		RETURNF "1"

	CASE "ITEM：发霉葡萄"
		RETURNF "贵腐葡萄汁"
	CASE "QUANTITY：发霉葡萄"
		RETURNF "20"
	CASE "EXTRA：发霉葡萄"
		RETURNF "果渣"
	CASE "EXTRAQUANTITY：发霉葡萄"
		RETURNF "1"

	CASE "ITEM：甜味料"
		RETURNF "糖水"
	CASE "QUANTITY：甜味料"
		RETURNF "10"

	CASE "ITEM：陈酿前的朗姆酒"
		RETURNF "陈酿前的朗姆酒"
	CASE "QUANTITY：陈酿前的朗姆酒"
		RETURNF "1"

	CASE "ITEM：陈酿前的莓子酒"
		RETURNF "陈酿前的莓子酒"
	CASE "QUANTITY：陈酿前的莓子酒"
		RETURNF "1"
	;Custom data, unaged fragolino
	CASE "ITEM：陈酿前的草莓白兰地"
		RETURNF "陈酿前的草莓白兰地"
	CASE "QUANTITY：陈酿前的草莓白兰地"
		RETURNF "1"

	CASE "ITEM：陈酿前的白兰地"
		RETURNF "陈酿前的白兰地"
	CASE "QUANTITY：陈酿前的白兰地"
		RETURNF "1"

	CASE "ITEM：优质食材"
		RETURNF "大米酒曲"
	CASE "QUANTITY：优质食材"
		RETURNF "1"
	;Custom data, medicinal herbs to herbaceous water
	CASE "ITEM：药草"
		RETURNF "草药汁"
	CASE "QUANTITY：药草"
		RETURNF "20"

	;Custom data, milk bottle to kefir grains
	CASE "ITEM：奶瓶"
		RETURNF "开菲尔种菌"
	CASE "QUANTITY：奶瓶"
