;-------------------------------------------------
;フィールドタイプのbitを入れて返す関数
;@AREA_SETBITと同様
;"全て"を入れると全てを入れた数値(2^8 - 1)を返す、が、おそらく不使用（月があるので）
;"以外"を入れると反転する
;-------------------------------------------------
@FIELD_SETBIT(ARGS)
#LOCALSIZE 2
#LOCALSSIZE 1
#FUNCTION
VARSET LOCAL
SIF STRCOUNT(ARGS, "全て")
	RETURNF POWER(2, MUSHI_MAXFIELDTYPE) - 1

SIF STRCOUNT(ARGS, "草")
	SETBIT LOCAL, 0
SIF STRCOUNT(ARGS, "花")
	SETBIT LOCAL, 1
SIF STRCOUNT(ARGS, "樹")
	SETBIT LOCAL, 2
SIF STRCOUNT(ARGS, "土")
	SETBIT LOCAL, 3
SIF STRCOUNT(ARGS, "水")
	SETBIT LOCAL, 4
SIF STRCOUNT(ARGS, "岩")
	SETBIT LOCAL, 5
SIF STRCOUNT(ARGS, "家")
	SETBIT LOCAL, 6
SIF STRCOUNT(ARGS, "月")
	SETBIT LOCAL, 7
SIF STRCOUNT(ARGS, "圣")
	SETBIT LOCAL, 8
SIF STRCOUNT(ARGS, "魔")
	SETBIT LOCAL, 9

IF STRCOUNT(ARGS, "以外")
	FOR LOCAL:1, 0, MUSHI_MAXFIELDTYPE
		INVERTBIT LOCAL:1, LOCAL
	NEXT
ENDIF
RETURNF LOCAL

;-------------------------------------------------
;ムシの名前をＧＸ付きで表示する関数
;ARG    空きスペース数
;ARG:1  RIGHT
;-------------------------------------------------
@PRINT_MUSHINAME(ARGS, MUSHI_ID, ARG, ARG:1)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM MUSHI_ID
#DIM Ｇ型
#DIM Ｘ型
Ｇ型 = GET_MUSHIDATA(MUSHI_ID, MUSHI_GETDATA_GTYPE)
Ｘ型 = GET_MUSHIDATA(MUSHI_ID, MUSHI_GETDATA_XTYPE)
LOCAL = MAX(ARG - STRLENS(ARGS) - Ｇ型 * 2 - Ｘ型 * 2, 0)
SIF ARG:1
	PRINTFORM %" " * LOCAL%
PRINTFORM %ARGS%
IF  Ｇ型 && Ｘ型
	CALL COLORMESSAGE(@"ＧＸ", 0xffff78)
ELSEIF Ｇ型
	CALL COLORMESSAGE(@"Ｇ", 0xff5a5a)
ELSEIF Ｘ型
	CALL COLORMESSAGE(@"Ｘ", 0x64c8ff)
ENDIF
SIF !ARG:1
	PRINTFORM %" " * LOCAL%

