@SHOW_COLLECTION_MUSHI
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM 页头番号,20
#DIM DYNAMIC 当前页
#DIM DYNAMIC 最末页
#DIM DYNAMIC MUSHI_ID
#DIMS DYNAMIC QOL_NAME
#DIM DYNAMIC QOL_RARE
#DIM DYNAMIC INPUT_LOOP_LINE,2
#DIM DYNAMIC 行计数
#DIM DYNAMIC 页计数
#DIM DYNAMIC 最后番号
#DIM DYNAMIC 选择番号
IF !页头番号
	[IF_DEBUG]
		FOR LOCAL, 1, MAXMUSHI
			MUSHI_COLLECT:LOCAL = 1
		NEXT
	[ENDIF]
	FOR LOCAL, 1, MAXMUSHI
		SIF !QOL_MUSHI_HAS_DATA(LOCAL)
			CONTINUE
		行计数 ++
		IF 行计数 == 21
			页计数 ++
			页头番号:页计数 = LOCAL
			行计数 = 1
		ENDIF
		最后番号 = LOCAL
	NEXT
	页头番号 = 1
	当前页 = 1
	最末页 = 页计数 + 1
	页头番号:最末页 = 最后番号 + 1
ENDIF
INPUT_LOOP_LINE:0 = LINECOUNT
$INPUT_LOOP00
CLEARLINE LINECOUNT - INPUT_LOOP_LINE:0
行计数 = 0
PRINTFORML ◆捕虫列表 PAGE.{当前页}
DRAWLINE
FOR LOCAL, 页头番号, 页头番号:当前页
	SIF !QOL_MUSHI_HAS_DATA(LOCAL)
		CONTINUE
	QOL_RARE = QOL_MUSHI_GET_RARE(LOCAL)
	MUSHI_ID = QOL_RARE * 1000 + LOCAL
	CALL SHOW_MUSHI_DATA(MUSHI_ID, "図鑑一覧")
	行计数 ++
NEXT
WHILE 行计数 < 20
	PRINTL 
	行计数 ++
WEND
DRAWLINE
PRINTL [998] 上一页
PRINTL [999] 下一页
PRINTL [  0] 返回
INPUT
IF !RESULT
	VARSET 页头番号
	RETURN
ELSEIF RESULT == 999
	当前页 ++
	IF 当前页 > 最末页
		当前页 = 1
		页头番号 = 1
	ELSE
		页头番号 = 页头番号:(当前页 - 1)
	ENDIF
	GOTO INPUT_LOOP00
ELSEIF RESULT == 998
	当前页 --
	IF 当前页 < 1
		当前页 = 最末页
		页头番号 = 页头番号:(最末页 - 1)
	ELSEIF 当前页 == 1
		页头番号 = 1
	ELSE
		页头番号 = 页头番号:(当前页 - 1)
	ENDIF
	GOTO INPUT_LOOP00
ELSEIF INRANGE(RESULT, 1, MAXMUSHI) && MUSHI_COLLECT:RESULT
	选择番号 = RESULT
	QOL_RARE = QOL_MUSHI_GET_RARE(选择番号)
	MUSHI_ID = 39 * 10000 + QOL_RARE * 1000 + 选择番号
	INPUT_LOOP_LINE:1 = LINECOUNT
	$INPUT_LOOP01
	CLEARLINE LINECOUNT - INPUT_LOOP_LINE:1
	CALL SHOW_MUSHI_DATA(MUSHI_ID, "図鑑")
	DRAWLINE
	PRINTL [  0] 返回
	INPUT
	IF !RESULT
		GOTO INPUT_LOOP00
	ELSE
		GOTO INPUT_LOOP01
	ENDIF
ELSE
	GOTO INPUT_LOOP00
ENDIF

@SELECT_RANDOM_MUSHI_FIELD(LOCATION)
#FUNCTION
#DIM LOCATION
#DIM DYNAMIC FIELDS, MUSHI_MAXFIELDTYPE

LOCAL:1 = MUSHITORI_SPOT(LOCATION)
IF !(LOCAL:1 & (POWER(2, MUSHI_MAXFIELDTYPE) - 1))
	PRINTFORMDL ＊WARNING＊: %NAME_FROM_PLACE(LOCATION)%没有有效的字段，默认为草地。
	RETURNF 1
ENDIF

FOR LOCAL, 0, MUSHI_MAXFIELDTYPE
	SIF GETBIT(LOCAL:1, LOCAL)
		FIELDS:LOCAL = 1
NEXT
;return with correct bit set
LOCAL = 0
SETBIT LOCAL, ARRAY_HIT(FIELDS, MUSHI_MAXFIELDTYPE)
RETURNF LOCAL
