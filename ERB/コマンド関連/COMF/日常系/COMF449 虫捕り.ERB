;捕虫
@COM449
#DIM CHARA
#DIM ラックM
#DIM ラックT
#DIM パワーM
#DIM パワーT
#DIM 相方が捕った
相方が捕った = 0

;参加者判定
IF FLAG:约会的对象 && (!FLAG:70 || CFLAG:TARGET:344 == 1)
	;Group date stuff, prioritize target date instead of lastest date invite
	IF IS_DATING_WITH_PLAYER(TARGET)
		CHARA = TARGET
	ELSE
		CHARA = FLAG:デート相手
	ENDIF
;仕事中はダメ
ELSEIF TARGET && ABL:TARGET:親密 >= 5 - TALENT:TARGET:採集Lv && SHIRAHU(TARGET) && CFLAG:行動 != 5
	CHARA = TARGET
ELSE
	CHARA = 0
ENDIF

;ラック=10～1000
ラックM = LIMIT((CFLAG:MASTER:今日の運勢 + 1 + (TFLAG:幸運補正 * 100)), 10, 1000)
SIF CHARA
	ラックT = MAX(CFLAG:CHARA:今日の運勢 + 1, 10)
;最低1,最大10
パワーM = LIMIT(ラックM / 200 + TALENT:MASTER:採集Lv + (MAGIC_DLC * TALENT:MASTER:神性), 1, 10)
SIF CHARA
	パワーT = LIMIT(ラックT / 200 + TALENT:CHARA:採集Lv, 1, 10)

FOR LOCAL, 0, 5
	REUSELASTLINE  \@ CHARA ? 和%CALLNAME:CHARA%一起 #  \@捕虫中.%"." * LOCAL%
	TWAIT 40, 1
NEXT

;捕獲判定
IF RAND:パワーM < 2
	MUSHI_CAGE = 0
	IF CHARA
		IF RAND:パワーT < 2
			MUSHI_CAGE = 0
		ELSE
			CALL MUSHITORI(パワーT, ラックT)
			MUSHI_CAGE = RESULT
			相方が捕った = 1
		ENDIF
	ENDIF
ELSE
	CALL MUSHITORI(パワーM, ラックM)
	MUSHI_CAGE = RESULT
ENDIF

;基本経験値
EXP:MASTER:採集経験 ++
SIF CHARA
	EXP:CHARA:採集経験 ++
;捕った人の追加経験値
IF MUSHI_CAGE
	IF 相方が捕った
		EXP:CHARA:採集経験 ++
	ELSE
		EXP:MASTER:採集経験 ++
	ENDIF
ENDIF
;約會経験
IF IS_DATING_WITH_PLAYER(CHARA) && CHARA
	EXP:MASTER:約會経験 ++
	EXP:CHARA:約會経験 ++
ENDIF

;成果に関わらず気力体力減少
DOWNBASE:MASTER:体力 = 150
DOWNBASE:MASTER:気力 = 200
IF CHARA
	DOWNBASE:CHARA:体力 = 150
	DOWNBASE:CHARA:気力 = 200
ENDIF

IF MUSHI_CAGE
	;処理の関係でここで捕獲メッセージを流す,
	IF 相方が捕った
		CALL SHOW_MUSHI_DATA(MUSHI_CAGE)
		DRAWLINE
		PRINTFORML %CALLNAME:CHARA%捕获了%MUSHI_NAME%！
		;＠口上を挟むかも
		PRINTL [ 1] 这相当不错嘛
		;出自浪漫沙加https://dic.pixiv.net/a/殺してでもうばいとる
		CALL COLORMESSAGE(@"[ 2] 即使杀了你　也要抢走", C_RED, 1)
		PRINTL [ 3] 请让给我　拜托了！！
		INPUT
		;结果はメッセージの方で
		IF RESULT == 3
			IF ABL:CHARA:従順 < 6 || ABL:CHARA:親密 < 6 || MARK:CHARA:反発刻印 || TALENT:CHARA:心情 < 0
				TFLAG:193 = -1
			ELSEIF ABL:CHARA:従順 < 8 || ABL:CHARA:親密 < 8
				TFLAG:193 = 3
			ELSE
				TFLAG:193 = 4
			ENDIF
		ELSEIF RESULT == 2
			TFLAG:193 = -2
		ELSE
			TFLAG:193 = 2
		ENDIF
	ELSE
		CALL SHOW_MUSHI_DATA(MUSHI_CAGE)
		PRINTFORML 捕获了%MUSHI_NAME%！
		TFLAG:193 = 1
	ENDIF
ELSE
	TFLAG:193 = 0
ENDIF

;参加者のソース,同一指令制限を受けないので控えめに,ただし捕まえられないと毎回半減
IF CHARA
	;固定で獲得するソース
	SOURCE:CHARA:歓楽 = 400
	SOURCE:CHARA:情愛 = 50
	
	;ABL:従順をみる
	IF ABL:従順 <= 1
		SOURCE:CHARA:歓楽 += (ABL:従順 * 40)
		SOURCE:CHARA:情愛 += (ABL:親密 * 20)
	ELSEIF ABL:従順 <= 3
		SOURCE:CHARA:歓楽 += 200 + (ABL:従順 * 40)
		SOURCE:CHARA:情愛 += 50 + (ABL:親密 * 30)
	ELSEIF ABL:従順 <= 5
		SOURCE:CHARA:歓楽 += 500 + (ABL:従順 * 40)
		SOURCE:CHARA:情愛 += 200 + (ABL:親密 * 30)
	ELSEIF ABL:従順 <= 8
		SOURCE:CHARA:歓楽 += 750 + (ABL:従順 * 60)
		SOURCE:CHARA:情愛 += 300 + (ABL:親密 * 40)
	ELSEIF ABL:従順 <= 11
		SOURCE:CHARA:歓楽 += 1000 + (ABL:従順 * 60)
		SOURCE:CHARA:情愛 += 600 + (ABL:親密 * 40)
	ELSE
		SOURCE:CHARA:歓楽 += 1600 + (ABL:従順 * 30)
		SOURCE:CHARA:情愛 += 1000 + (ABL:親密 * 20)
	ENDIF
	SIF IS_DATING_WITH_PLAYER(CHARA)
		SOURCE:CHARA:情愛 = 0
	
	SOURCE:CHARA:受動 = 200 + 100 * ABL:従順
	SOURCE:CHARA:征服 = 200 + 100 * ABL:施虐属性
	
	;面倒なので[釣魚]をトレースして2倍（時間効率で等倍）
	TIMES SOURCE:CHARA:歓楽 , 2.00
	TIMES SOURCE:CHARA:受動 , 2.00
	TIMES SOURCE:CHARA:征服 , 2.00
	TIMES SOURCE:CHARA:情愛 , 2.00
	
	;結果による補正
	SELECTCASE TFLAG:193
	;殺してでもうばいとる
	CASE -2
		TIMES SOURCE:CHARA:歓楽 , 0.50
		TIMES SOURCE:CHARA:受動 , 0.50
		TIMES SOURCE:CHARA:征服 , 0.50
		SOURCE:CHARA:反感 = 500
		DOWNBASE:MASTER:体力 += 150
		DOWNBASE:MASTER:気力 += 200
		IF CHARA
			DOWNBASE:CHARA:体力 += 150
			DOWNBASE:CHARA:気力 += 200
		ENDIF
	;ゆずってくれ→拒否された
	CASE -1
		SOURCE:CHARA:反感 = 50
	;捕獲失敗
	CASE 0
		TIMES SOURCE:CHARA:歓楽 , 0.50
		TIMES SOURCE:CHARA:受動 , 0.50
		TIMES SOURCE:CHARA:征服 , 0.50
	;MASTERが捕まえた,補正無
	CASE 1
	;なかなかやるじゃん
	CASE 2
		TIMES SOURCE:CHARA:歓楽 , 1.50
		TIMES SOURCE:CHARA:受動 , 1.50
		TIMES SOURCE:CHARA:征服 , 1.50
	;ゆずってくれ→渋々オッケー
	CASE 3
		TIMES SOURCE:CHARA:受動 , 1.50
	;ゆずってくれ→オールオッケー
	CASE 4
		TIMES SOURCE:CHARA:歓楽 , 1.50
		TIMES SOURCE:CHARA:受動 , 1.50
		TIMES SOURCE:CHARA:情愛 , 1.50
	ENDSELECT

	;其他の補正
	;虫の妖怪は喜ぶ
	IF GET_TRIBENAME(CHARA, GETNUM(TALENT, "妖怪")) == "妖虫"
		TIMES SOURCE:CHARA:歓楽 , 2.00
		TIMES SOURCE:CHARA:受動 , 2.00
		TIMES SOURCE:CHARA:征服 , 2.00
		TIMES SOURCE:CHARA:情愛 , 2.00
	;チョウチョウはハッピー
	ELSEIF STRCOUNT(MUSHI_TRIBE, "蝶/")
		IF CHARA == [[拉尔瓦]]
			TIMES SOURCE:CHARA:歓楽 , 2.00
			TIMES SOURCE:CHARA:受動 , 2.00
			TIMES SOURCE:CHARA:征服 , 2.00
		ELSE
			TIMES SOURCE:CHARA:歓楽 , 1.50
			TIMES SOURCE:CHARA:受動 , 1.50
			TIMES SOURCE:CHARA:征服 , 1.50
		ENDIF
	;兜蟲・锹形虫もハッピー
	ELSEIF STRCOUNT(MUSHI_TRIBE, "(兜虫|锹形虫)")
		TIMES SOURCE:CHARA:歓楽 , 1.50
		TIMES SOURCE:CHARA:受動 , 1.50
		TIMES SOURCE:CHARA:征服 , 1.50
	ELSEIF MUSHI_RARE <= 3
	;レア度4～7
	ELSEIF MUSHI_RARE <= 7
		TIMES SOURCE:CHARA:歓楽 , 1.50
		TIMES SOURCE:CHARA:受動 , 1.50
		TIMES SOURCE:CHARA:征服 , 1.50
	;レア度8～9
	ELSE
		TIMES SOURCE:CHARA:歓楽 , 2.00
		TIMES SOURCE:CHARA:受動 , 2.00
		TIMES SOURCE:CHARA:征服 , 2.00
	ENDIF
	;跳蛋
	SIF MUSHI_NAME == "跳蛋"
		SOURCE:CHARA:欲情 = 500
ENDIF

;時間経過
TIME += 40
M_TFLAG:时间因子类型 = TimeFactor_采集

;フラグ引き渡し
TFLAG:194 = CHARA

RETURN 1


;-------------------------------------------------
;実行可能判定
;-------------------------------------------------
;捕虫
@COM_ABLE449
#LOCALSIZE 1
#LOCALSSIZE 1
SIF !TFLAG:100
	RETURN 0
;一括管理
SIF GLOBAL_COMABLE(449)
	RETURN RESULT
;昆虫採集套装がない
SIF !ITEM:昆虫採集套装
	RETURN 0
;昆虫採集できる場所である
SIF !MUSHITORI_SPOT(CFLAG:MASTER:現在位置)
	RETURN 0
;冬の間はおやすみ
SIF GET_MONTH() == "冬之月"
	RETURN 0
;约会中は约会的对象とだけ
SIF FLAG:デート相手 && !IS_DATING_WITH_PLAYER(TARGET)
	RETURN 0
;陪睡中
SIF CFLAG:MASTER:陪睡中
	RETURN 0
;诶嘿嘿中
SIF CFLAG:MASTER:诶嘿嘿
	RETURN 0
;睡眠中
SIF CFLAG:MASTER:睡眠
	RETURN 0
;時間停止中
SIF FLAG:時間停止
	RETURN 0
;体力・気力不足
SIF BASE:MASTER:気力 < 800 || BASE:MASTER:体力 < 800
	RETURN 0
RETURN 1

;-------------------------------------------------
;ムシを捕まえる関数
;-------------------------------------------------
@MUSHITORI(パワー, ラック)
#DIM パワー
#DIM ラック
#DIM レアリティ指定
#DIM ランク
#DIM Ｇ型
#DIM Ｘ型
#DIM MUSHI_ID
レアリティ指定 = RAND:パワー
Ｇ型 = 0
Ｘ型 = 0
MUSHI_ID = 0
;ムシを抽選,見つからない場合はレアリティ指定をひとつ下げる
RESULT = 0
WHILE レアリティ指定 >= 0
	CALL DRAW_MUSHI("捕虫", CFLAG:MASTER:現在位置, レアリティ指定)
	IF RESULT
		MUSHI_CAPTURE ++
		;ランク判定
		ランク = MIN(RAND:(ラック / 10), 99)
		SIF RAND:100 < (パワー / 2)
			Ｇ型 = 1
		SIF RAND:100 < (パワー / 2)
			Ｘ型 = 1
		;ID設定
		MUSHI_ID = MUSHI_CAPTURE * 1000000000000 + DAY * 1000000000000 + CFLAG:MASTER:現在位置 * 100000000 + ランク * 10000 + MUSHI_RARE * 1000 + RESULT
		SIF Ｇ型
			MUSHI_ID += 1000000
		SIF Ｘ型
			MUSHI_ID += 10000000
		BREAK
	ELSE
		レアリティ指定 --
	ENDIF
WEND
RETURN MUSHI_ID

;-------------------------------------------------
;ムシを抽選する関数
;SPOT = 0だと分布無視（出現地形・出現地域）
;-------------------------------------------------
@DRAW_MUSHI(ARGS, SPOT, レアリティ指定)
#DIM SPOT
#DIM レアリティ指定
#DIM MUSHI_RESULT
#DIMS DYNAMIC QOL_NAME
#DIM DYNAMIC QOL_RARE
#DIMS DYNAMIC QOL_FAVOS
MUSHI_RESULT = 0
CALL FISHER_YATES_SHAFFLE(MAXMUSHI)
FOR LOCAL, 1, MAXMUSHI
	;CALL MUSHI_DATA(SHAFFLE_ARRAY:LOCAL, SPOT) ;qol code
	;SIF !RESULT ;qol code
	SIF !QOL_MUSHI_HAS_DATA(SHAFFLE_ARRAY:LOCAL)
		CONTINUE
	QOL_NAME '= QOL_MUSHI_GET_NAME(SHAFFLE_ARRAY:LOCAL)
	QOL_RARE = QOL_MUSHI_GET_RARE(SHAFFLE_ARRAY:LOCAL)
	SIF INRANGE(レアリティ指定, 0, 9) && レアリティ指定 != QOL_RARE
		CONTINUE
	IF ARGS == "捕虫"
		SIF !QOL_MUSHI_GET_GETABLE(SHAFFLE_ARRAY:LOCAL)
			CONTINUE
	ELSEIF ARGS == "昆虫诱捕装置特定好物"
		QOL_FAVOS '= QOL_MUSHI_GET_FAVOS(SHAFFLE_ARRAY:LOCAL)
		SIF QOL_FAVOS == "" || QOL_FAVOS == "無し"
			CONTINUE
		SIF !STRCOUNT(QOL_FAVOS, ITEMNAME:GET_MUSHIDATA(MUSHI_TRAP, MUSHI_GETDATA_DATE))
			CONTINUE
	ELSEIF ARGS == "昆虫诱捕装置"
		QOL_FAVOS '= QOL_MUSHI_GET_FAVOS(SHAFFLE_ARRAY:LOCAL)
		SIF QOL_FAVOS == "" || QOL_FAVOS == "無し"
			CONTINUE
		IF QOL_FAVOS != "全部"
			RESULTS '= QOL_FAVOS
			CALLF MUSHI_ESA_DATA(GET_MUSHIDATA(MUSHI_TRAP, MUSHI_GETDATA_DATE))
			SIF !STR_MULTI_COUNT(QOL_FAVOS, RESULTS:10)
				CONTINUE
		ENDIF
	ENDIF
	MUSHI_RARE = QOL_RARE ;qol code
	MUSHI_NAME '= QOL_NAME ;qol code
	MUSHI_RESULT = SHAFFLE_ARRAY:LOCAL
	BREAK
NEXT
RETURN MUSHI_RESULT

;-------------------------------------------------
;指定条件のムシを抽選する、IDを生成する関数
;-------------------------------------------------
@QOL_DRAW_MUSHI_DESIGN(CHARA, RARE_MIN, RARE_MAX, RANK_MIN, RANK_MAX, D_MUTA, D_FIELD, D_AREA, D_TRIBE, D_TYPE)
#FUNCTION
#DIM CHARA
#DIM RARE_MIN
#DIM RARE_MAX
#DIM RANK_MIN
#DIM RANK_MAX
#DIM D_MUTA
#DIM D_FIELD
#DIM D_AREA
#DIMS D_TRIBE
#DIMS D_TYPE
#DIM MUSHI_RESULT
#DIM MUSHI_ID
#DIM DYNAMIC QOL_RARE
#DIM DYNAMIC QOL_FIELD
#DIM DYNAMIC QOL_AREA
#DIMS DYNAMIC QOL_TRIBE
#DIMS DYNAMIC QOL_TYPE
#DIMS DYNAMIC QOL_NAME
#DIM DYNAMIC SHAFFLE_BUF, 1000
MUSHI_RESULT = 0
SIF RARE_MAX < RARE_MIN || !INRANGE(RARE_MAX, 0, 9)
	THROW
SIF RANK_MAX < RANK_MIN || !INRANGE(RANK_MAX, 0, 100)
	THROW
FOR LOCAL, 0, MAXMUSHI
	SHAFFLE_BUF:LOCAL = LOCAL
NEXT
CALLF FUNC_FISHER_YATES_SHAFFLE(SHAFFLE_BUF, MAXMUSHI)
FOR LOCAL, 1, MAXMUSHI
	SIF !QOL_MUSHI_HAS_DATA(SHAFFLE_BUF:LOCAL)
		CONTINUE
	QOL_RARE = QOL_MUSHI_GET_RARE(SHAFFLE_BUF:LOCAL)
	SIF RARE_MAX && !INRANGE(QOL_RARE, RARE_MIN, RARE_MAX)
		CONTINUE
	QOL_FIELD = QOL_MUSHI_GET_FIELD(SHAFFLE_BUF:LOCAL)
	SIF D_FIELD && !(QOL_FIELD & D_FIELD)
		CONTINUE
	QOL_AREA = QOL_MUSHI_GET_AREA(SHAFFLE_BUF:LOCAL)
	SIF D_AREA && !(QOL_AREA & D_AREA)
		CONTINUE
	QOL_TRIBE '= QOL_MUSHI_GET_TRIBE(SHAFFLE_BUF:LOCAL)
	SIF D_TRIBE != "" && !STRCOUNT(QOL_TRIBE, D_TRIBE)
		CONTINUE
	QOL_TYPE '= QOL_MUSHI_GET_TYPE(SHAFFLE_BUF:LOCAL)
	SIF D_TYPE != "" && !STRCOUNT(QOL_TYPE, D_TYPE)
		CONTINUE
	QOL_NAME '= QOL_MUSHI_GET_NAME(SHAFFLE_BUF:LOCAL)
	SIF GROUPMATCH(QOL_NAME, "那个", "蚰蜒", "蝇", "蚊", "跳蚤")
		CONTINUE
	IF CHARA == 999
	ELSEIF GET_TRIBENAME(CHARA, GETNUM(TALENT, "人类")) == "月人"
		IF !GROUPMATCH(CHARA, [[輝夜]], [[永琳]])
			SIF !STRCOUNT(QOL_TRIBE, "機械")
				CONTINUE
		ENDIF
	ELSEIF GET_TRIBENAME(CHARA, GETNUM(TALENT, "妖怪")) != "河童"
		SIF STRCOUNT(QOL_TRIBE, "機械")
			CONTINUE
	ENDIF
	MUSHI_RESULT = SHAFFLE_BUF:LOCAL
	BREAK
NEXT
IF !MUSHI_RESULT
	PRINTL 没有符合条件的昆虫！
	THROW
ENDIF
MUSHI_RANK = -1
IF RANK_MAX
	WHILE MUSHI_RANK < RANK_MIN
		MUSHI_RANK = RAND:RANK_MAX
	WEND
ELSE
	MUSHI_RANK = RAND:100
ENDIF
VARSET RESULT
IF D_MUTA
	SIF RAND:100 < D_MUTA
		RESULT:1 = 1
	SIF RAND:100 < D_MUTA
		RESULT:2 = 1
ELSE
	SIF RAND:100 < 3
		RESULT:1 = 1
	SIF RAND:100 < 3
		RESULT:2 = 1
ENDIF
MUSHI_NAME '= QOL_MUSHI_GET_NAME(MUSHI_RESULT) ;qol code
MUSHI_RARE = QOL_RARE ;qol code
MUSHI_ID = MUSHI_RANK * 10000 + QOL_RARE * 1000 + MUSHI_RESULT
SIF RESULT:1
	MUSHI_ID += 1000000
SIF RESULT:2
	MUSHI_ID += 10000000
MUSHI_ID += RAND:1000000  * 100000000
RETURNF MUSHI_ID

;-------------------------------------------------
;ムシを捕まえた後処理の関数
;-------------------------------------------------
@MUSHI_CAPTURE(MUSHI_ID)
#DIM MUSHI_ID
#DIM 保管
#DIM 結果保存
保管 = 0
;捕まえた時点で図鑑登録,相方が捕まえただけではダメ
MUSHI_COLLECT:GET_MUSHIDATA(MUSHI_ID, MUSHI_GETDATA_NUM) = 1
;空きに登録する
FOR LOCAL, 1, MUSHI_MAXCAGE + 1
	IF !MUSHI_CAGE:LOCAL
		MUSHI_CAGE:LOCAL = MUSHI_ID
		保管 = LOCAL
		BREAK
	ENDIF
NEXT
IF 保管
	;WAITは外に任せる
	PRINTFORML %MUSHI_NAME%进入了虫笼【%TOFULL(TOSTR(保管))%】！
;空きがない場合
ELSE
	PRINTFORMW 虫笼已经满员了！
	FOR LOCAL, 1, MUSHI_MAXCAGE + 1
		PRINTFORM [{LOCAL + 10}]放生　[{LOCAL + 20}]做成素材　│【%TOFULL(TOSTR(LOCAL))%】
		CALL SHOW_MUSHI_DATA(MUSHI_CAGE:LOCAL, "一行")
		PRINTL 
		MUSHI_NAME:LOCAL = %MUSHI_NAME%
		MUSHI_RARE:LOCAL = MUSHI_RARE
		MUSHI_TRIBE:LOCAL = %MUSHI_TRIBE%
	NEXT
	DRAWLINE
	;今捕まえたムシ,LOCALはMAXCAGE+1になってる
	PRINTFORM [{LOCAL + 10}]放生　[{LOCAL + 20}]做成素材　│【　】
	CALL SHOW_MUSHI_DATA(MUSHI_ID, "一行")
	PRINTL 
	MUSHI_NAME:LOCAL = %MUSHI_NAME%
	MUSHI_RARE:LOCAL = MUSHI_RARE
	MUSHI_TRIBE:LOCAL = %MUSHI_TRIBE%
	INPUT
	結果保存 = RESULT
	;素材にする
	IF INRANGE(結果保存, 21, 21 + MUSHI_MAXCAGE)
		PRINTFORM %MUSHI_NAME:(結果保存 % 10)%
		;油库里洗跌一跌捏~
		IF STRCOUNT(MUSHI_NAME:(結果保存 % 10),"油库里")
			PRINTFORMW 「油咿咿咿咿咿——」
			PRINTFORMW 「人类先生，人类先生不要把油库里变成素材油哦哦——」
			PRINTFORMW 「人类先生应该给油库里好甜好甜然后让油库里变得很能油库气才对啊油——」
			PRINTFORMW 油库里在%CALLNAME:MASTER%手中痛苦地挣扎……
			CALL ASK_M("放生",1,"做成素材",1)
			SELECTCASE RESULT
			CASE 0
				PRINTFORMW ……
				PRINTFORMW ……于心不忍的%CALLNAME:MASTER%终于还是把油库里放走了。
				PRINTFORMW 「人类先生……」
				PRINTFORMW 「……果然是怕了本油吧！哼哼，识相的话就快把好甜好甜什么的交出来！」
				PRINTFORMW 「如果本油高兴的话让人类先生当本油的嗯嗯奴隶什么的也是可以的——」
				PRINTFORMW 哦哦，听闻此话的%CALLNAME:MASTER%，青筋暴起！
				CALL ASK_M("放生",1,"做成素材",1)
				SELECTCASE RESULT
				CASE 0
					PRINTFORMW ……
					PRINTFORMW 南无三，何等冷静，%CALLNAME:MASTER%，竟然忍住了没有一脚把油库里踩死的冲动！
					PRINTFORMW %CALLNAME:MASTER%强忍着怒火，斥令油库里有多远滚多远。
					PRINTFORMW 「人类先生的脑子是嗯嗯做的嘛？竟然敢骂伟大的油库里大人？」
					PRINTFORMW 「算了，本油大油有大量，要靠本油超快的脚脚先生离开这里了油——」
					PRINTFORMW 「至于人类先生……吃嗯嗯去吧！」
					PRINTFORMW 油库里屁颠屁颠地走了，只留下了地上的油库里嗯嗯……
					PRINTFORMW 不过……似乎勉强可以当糖用的样子……
					CALL GET_ITEM("糖", 1, 1)
				CASE 1
					PRINTFORMW 开什么玩笑啊混账！宰了你啊混账！
					PRINTFORMW %CALLNAME:MASTER%一把抓住刚刚放生了的油库里。
					PRINTFORMW 这下不管它怎么求饶都没有作用了……
					GOTO ABSOLUTELY_GOOD_ENDING
				ENDSELECT
			CASE 1
				PRINTFORMW ……
				PRINTFORMW ……但是，油库里的求饶，没有作用！
				$ABSOLUTELY_GOOD_ENDING
				PRINTFORMW 「油叽——」
				PRINTFORMW 「还想……继续……油库里……」
				PRINTFORMW	……油库里，变成素材了……
				CALL GET_ITEM("甜味料", 1, 1)
			ENDSELECT
		;レア度6以上は稀有昆虫
		ELSEIF MUSHI_RARE:(結果保存 % 10) > 5
			PRINTFORMW 稀有昆虫，变成素材了……
			IF STRCOUNT(MUSHI_TRIBE:(結果保存 % 10), "青蛙")
				CALL GET_ITEM("青蛙", 1, 1)
			ELSEIF STRCOUNT(MUSHI_TRIBE:(結果保存 % 10), "爬虫類")
				CALL GET_ITEM("來歷不明的肉", 1, 1)
			ELSEIF STRCOUNT(MUSHI_TRIBE:(結果保存 % 10), "機械")
				IF STRCOUNT(MUSHI_NAME:(結果保存 % 10),"跳蛋")
					CALL GET_ITEM("跳蛋", 1, 1)
				ELSEIF STRCOUNT(MUSHI_NAME:(結果保存 % 10),"异变敌")
					CALL GET_ITEM("龍珠", 1, 1)
				ELSE
					CALL GET_MONEY_CM(RAND(3,6),1)
				ENDIF
			ELSE
				CALL GET_ITEM("稀有昆虫", 1, 1)
			ENDIF
		;レア度5以下
		ELSE
			PRINTFORMW 变成素材了……
			;青蛙は青蛙に
			IF STRCOUNT(MUSHI_TRIBE:(結果保存 % 10), "青蛙")
				CALL GET_ITEM("青蛙", 1, 1)
			ELSEIF STRCOUNT(MUSHI_TRIBE:(結果保存 % 10), "爬虫類")
				CALL GET_ITEM("來歷不明的肉", 1, 1)
			ELSEIF STRCOUNT(MUSHI_TRIBE:(結果保存 % 10), "機械")
				IF STRCOUNT(MUSHI_NAME:(結果保存 % 10),"跳蛋")
					CALL GET_ITEM("跳蛋", 1, 1)
				ELSEIF STRCOUNT(MUSHI_NAME:(結果保存 % 10),"异变敌")
					CALL GET_ITEM("龍珠", 1, 1)
				ELSE
					CALL GET_ITEM("潤滑液", 1, 1)
				ENDIF
			ELSE
				CALL GET_ITEM("虫", 1, 1)
			ENDIF
		ENDIF
	;逃がす
	ELSEIF INRANGE(結果保存, 11, 11 + MUSHI_MAXCAGE)
		PRINTFORMW %MUSHI_NAME:(結果保存 % 10)%被放生野外了…
	;適当な数値を入力したら逃がす
	ELSE
		結果保存 = 11 + MUSHI_MAXCAGE
		PRINTFORMW %MUSHI_NAME:(結果保存 % 10)%被放生野外了…
	ENDIF
	;入れ替えた
	IF INRANGE(結果保存 % 10, 1, MUSHI_MAXCAGE)
		MUSHI_CAGE:(結果保存 % 10) = MUSHI_ID
		PRINTFORML %MUSHI_NAME%进入了虫笼【%TOFULL(TOSTR(結果保存 % 10))%】！
	ENDIF
ENDIF

;-------------------------------------------------
;ムシデータを抽出する関数
;-------------------------------------------------
@GET_MUSHIDATA(MUSHI_ID, DATA_TYPE)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTION
#DIM MUSHI_ID
#DIM DATA_TYPE
SELECTCASE DATA_TYPE
CASE MUSHI_GETDATA_COUNT
	RETURNF MUSHI_ID / 1000000000000000000
CASE MUSHI_GETDATA_DATE
	RETURNF MUSHI_ID / 1000000000000 % 100000
CASE MUSHI_GETDATA_PLACE
	RETURNF MUSHI_ID / 100000000 % 10000
CASE MUSHI_GETDATA_XTYPE
	RETURNF MUSHI_ID / 10000000 % 10
CASE MUSHI_GETDATA_GTYPE
	RETURNF MUSHI_ID / 1000000 % 10
CASE MUSHI_GETDATA_RANK
	RETURNF MUSHI_ID / 10000 % 100
CASE MUSHI_GETDATA_RARITY
	RETURNF MUSHI_ID / 1000 % 10
CASE MUSHI_GETDATA_NUM
	RETURNF MUSHI_ID % 1000
ENDSELECT

;-------------------------------------------------
;ムシデータを表示する関数
;-------------------------------------------------
@SHOW_MUSHI_DATA(MUSHI_ID, DISP_TYPE)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC MUSHI_ID
#DIMS DYNAMIC DISP_TYPE
#DIM DYNAMIC MUSHI_NUM
#DIM DYNAMIC MUSHI_RANK_VAL
#DIM DYNAMIC MUSHI_RARE_VAL
#DIM DYNAMIC MUSHI_X_TYPE
#DIM DYNAMIC MUSHI_G_TYPE
#DIMS DYNAMIC ELM_LIST, 100
#DIM  DYNAMIC ELM_CNT,  100
#DIM  DYNAMIC ELM_NUM
#DIMS DYNAMIC QOL_DESC, 6
MUSHI_NUM = GET_MUSHIDATA(MUSHI_ID, MUSHI_GETDATA_NUM)
MUSHI_RANK_VAL = GET_MUSHIDATA(MUSHI_ID, MUSHI_GETDATA_RANK)
MUSHI_RARE_VAL = GET_MUSHIDATA(MUSHI_ID, MUSHI_GETDATA_RARITY)
MUSHI_X_TYPE = GET_MUSHIDATA(MUSHI_ID, MUSHI_GETDATA_XTYPE)
MUSHI_G_TYPE = GET_MUSHIDATA(MUSHI_ID, MUSHI_GETDATA_GTYPE)
CALL MUSHI_PALAM(MUSHI_ID)
IF DISP_TYPE == "一行"
	IF MUSHI_RANK_VAL >= 90
		CALL COLORMESSAGE(@"★", C_ORANGE, 0, 1)
	ELSEIF MUSHI_RANK_VAL >= 80
		CALL COLORMESSAGE(@"★", C_YELLOW, 0, 1)
	ELSEIF MUSHI_RANK_VAL >= 60
		CALL COLORMESSAGE(@"★", C_WHITE, 0, 1)
	ELSE
		PRINT 　
	ENDIF
	CALL PRINT_MUSHINAME(MUSHI_NAME, MUSHI_ID, 40)
	CALL MUSHI_TYPE_PRINT(MUSHI_TYPE)
	PRINTFORM ／
	CALL PRINT_ALPHABET(9 - MUSHI_RARE_VAL, 10, 1)
ELSEIF DISP_TYPE == "図鑑一覧"
	IF MUSHI_COLLECT:MUSHI_NUM
		PRINTFORM [{MUSHI_NUM, 3}] %MUSHI_NAME, 30, LEFT%
		CALL PRINT_ALPHABET(9 - MUSHI_RARE_VAL, 10, 1)
	ELSE
		PRINTPLAINFORM [{MUSHI_NUM, 3}] %"？" * (STRLENS(MUSHI_NAME) / 2), 30, LEFT%
		CALL PRINT_ALPHABET(9 - MUSHI_RARE_VAL, 10, 1)
	ENDIF
	PRINTL 
ELSE
	PRINTFORML %"━" * 50%
	PRINTFORM 　 No.{MUSHI_NUM, 3, LEFT}
	IF DISP_TYPE == "図鑑"
		PRINT 　
	ELSE
		IF MUSHI_RANK_VAL >= 90
			CALL COLORMESSAGE(@"★", C_ORANGE, 0, 1)
		ELSEIF MUSHI_RANK_VAL >= 80
			CALL COLORMESSAGE(@"★", C_YELLOW, 0, 1)
		ELSEIF MUSHI_RANK_VAL >= 60
			CALL COLORMESSAGE(@"★", C_WHITE, 0, 1)
		ELSE
			PRINT 　
		ENDIF
	ENDIF
	CALL PRINT_MUSHINAME(MUSHI_NAME, MUSHI_ID)
	PRINTL 
	PRINTFORML %"━" * 50%
	PRINTFORM 　　稀有度：
	CALL PRINT_ALPHABET(9 - MUSHI_RARE_VAL, 10, 1)
	PRINT ／
	CALL COLOR_STAMP(MUSHI_RARE_VAL + 1, 0, "★", RANKCOLOR(MUSHI_RARE_VAL + 1), 1)
	PRINTL 
	PRINTFORM 　　　属性：
	CALL MUSHI_TYPE_PRINT(MUSHI_TYPE)
	PRINTL 
	PRINTFORML 　　　种族：%MUSHI_TRIBE%
	PRINTFORML 　　　尺寸：{MUSHI_SIZE / 100}.{MUSHI_SIZE % 100}mm
	PRINTFORM 　得意地形：
	CALL PRINT_FIELDTYPE(MUSHI_FIELD)
	PRINTL 
	PRINTFORML 　　　　HP：{MUSHI_HP, 6, LEFT}
	PRINTFORML 　　　 ATK：{MUSHI_ATK, 6, LEFT}
	PRINTFORML 　　　 SPD：{MUSHI_SPD, 6, LEFT}
	PRINTFORML 　　　技能：%MUSHI_SKL%
	PRINTFORML %"--" * 50%
	IF QOL_MUSHI_HAS_DYNAMIC(MUSHI_NUM)
		CALL QOL_MUSHI_DYNAMIC(MUSHI_NUM)
		FOR LOCAL, 1, 6
			SIF RESULTS:LOCAL != ""
				CALL PRINT_STRL, RESULTS:LOCAL
		NEXT
	ELSE
		FOR LOCAL, 1, 6
			QOL_DESC:LOCAL '= QOL_MUSHI_GET_DESC(MUSHI_NUM, LOCAL)
			SIF QOL_DESC:LOCAL != ""
				CALL PRINT_STRL, QOL_DESC:LOCAL
		NEXT
	ENDIF
ENDIF
;WAITは外に任せる
;-------------------------------------------------
;虫カゴを確認する関数
;[道具]から転送
;-------------------------------------------------
@SHOW_MUSHI_CAGE
#DIM 並び替えモード
#DIM 並び替え対象
IF 並び替えモード
	CALL COLORMESSAGE(@"请选择目标来进行排序", C_AQUA, 1)
ELSE
	PRINTFORML ◆%CALLNAME:MASTER%的虫笼◆
ENDIF
DRAWLINE
FOR LOCAL, 1, MUSHI_MAXCAGE + 1
	IF MUSHI_CAGE:LOCAL
		SIF 並び替え対象 == LOCAL
			SETCOLOR C_AQUA
		PRINTFORM [{LOCAL, 2}] 
		CALL SHOW_MUSHI_DATA(MUSHI_CAGE:LOCAL, "一行")
		PRINTL 
		MUSHI_NAME:LOCAL = %MUSHI_NAME%
	ELSE
		PRINTPLAINFORM [{LOCAL, 2}] 空
		PRINTL 
	ENDIF
NEXT
DRAWLINE
SIF 並び替えモード
	SETCOLOR C_AQUA
PRINTL [99] 重新排序
RESETCOLOR
PRINTL [ 0] 返回
INPUT
IF INRANGE(RESULT, 1, MUSHI_MAXCAGE)
	IF 並び替えモード
		IF !MUSHI_CAGE:RESULT
			並び替え対象 = 0
		ELSEIF !並び替え対象
			並び替え対象 = RESULT
		ELSEIF 並び替え対象 == RESULT
			並び替え対象 = 0
		ELSE
			SWAP MUSHI_CAGE:並び替え対象, MUSHI_CAGE:RESULT
			並び替え対象 = 0
		ENDIF
	ELSE
		CALL SHOW_MUSHI_CAGE_2(RESULT)
		RESTART
	ENDIF
ELSEIF RESULT == 99
	並び替えモード = !並び替えモード
	SIF !並び替えモード
		並び替え対象 = 0
ELSE
	並び替えモード = 0
	並び替え対象 = 0
	RETURN 
ENDIF
CLEARLINE 12
RESTART

;-------------------------------------------------
;虫カゴを確認する関数２
;ARG = 虫カゴ番号
;-------------------------------------------------
@SHOW_MUSHI_CAGE_2(ARG)
#DIM LINE
LINE = 24
PRINTFORML 虫笼【%TOFULL(TOSTR(ARG))%】
CALL SHOW_MUSHI_DATA(MUSHI_CAGE:ARG)
DRAWLINE
PRINTL [ 1] 下一个笼子
PRINTL [ 2] 前一个笼子
PRINTL [ 0] 返回
INPUT
IF RESULT == 1
	FOR LOCAL, ARG + 1, MUSHI_MAXCAGE + 1 
		IF MUSHI_CAGE:LOCAL
			ARG = LOCAL
			CLEARLINE LINE
			RESTART
		ENDIF
	NEXT
	FOR LOCAL, 1, ARG + 1
		IF MUSHI_CAGE:LOCAL
			ARG = LOCAL
			CLEARLINE LINE
			RESTART
		ENDIF
	NEXT
ELSEIF RESULT == 2
	FOR LOCAL, 1, ARG
		LOCAL:1 = ARG - LOCAL
		IF MUSHI_CAGE:(LOCAL:1)
			ARG = LOCAL:1
			CLEARLINE LINE
			RESTART
		ENDIF
	NEXT
	FOR LOCAL, 1, MUSHI_MAXCAGE + 1 
		LOCAL:1 = MUSHI_MAXCAGE + 1 - LOCAL
		IF MUSHI_CAGE:(LOCAL:1)
			ARG = (LOCAL:1)
			CLEARLINE LINE
			RESTART
		ENDIF
	NEXT
ELSE
	RETURN
ENDIF
RESTART


;================================================
;@MUSHI_PALAM(MUSHI_ID, BONUS, CUR_HP, STATUS)
;计算昆虫战斗参数。根据等级（MUSHI_RANK）和加成值修正 HP/ATK/SPD/SIZE，
;并根据状态标签（如 <得意季節>、<大将>、<悪臭> 等）应用额外倍率。
;MUSHI_ID  昆虫实例ID（含等级/编号/变异编码）
;BONUS     额外加成值
;CUR_HP    当前HP（0=使用计算后的最大HP）
;STATUS    状态标签字符串（含 <得意季節>、<高揚>、<悪臭> 等标记）
;================================================
@MUSHI_PALAM(MUSHI_ID, BONUS, CUR_HP, STATUS)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM MUSHI_ID
#DIM BONUS
#DIM CUR_HP
#DIMS STATUS
#DIM DYNAMIC MUSHI_NUM
#DIM DYNAMIC CORRECTION
#DIM DYNAMIC G_TYPE
#DIM DYNAMIC X_TYPE
MUSHI_RANK = GET_MUSHIDATA(MUSHI_ID, MUSHI_GETDATA_RANK)
MUSHI_NUM = GET_MUSHIDATA(MUSHI_ID, MUSHI_GETDATA_NUM)
G_TYPE = GET_MUSHIDATA(MUSHI_ID, MUSHI_GETDATA_GTYPE)
X_TYPE = GET_MUSHIDATA(MUSHI_ID, MUSHI_GETDATA_XTYPE)
CALL QOL_MUSHI_LOAD(MUSHI_NUM)
CORRECTION = 80 + ((MUSHI_RANK + 1) / 2) + BONUS
MUSHI_MAXHP = MUSHI_HP * CORRECTION / 100
MUSHI_ATK = MUSHI_ATK * CORRECTION / 100
MUSHI_SPD = MUSHI_SPD * CORRECTION / 100
MUSHI_SIZE = MUSHI_SIZE * CORRECTION / 100
IF G_TYPE
	TIMES MUSHI_MAXHP, 1.50
	TIMES MUSHI_ATK, 1.50
	TIMES MUSHI_SIZE, 2.00
ENDIF
IF X_TYPE
	TIMES MUSHI_SPD, 1.50
	TIMES MUSHI_SIZE, 0.50
ENDIF
IF STRCOUNT(STATUS, "<得意季節>")
	TIMES MUSHI_ATK, 1.20
	TIMES MUSHI_SPD, 1.20
ENDIF
IF STRCOUNT(STATUS, "<得意地形>")
	TIMES MUSHI_ATK, 1.20
	TIMES MUSHI_SPD, 1.20
ENDIF
IF STRCOUNT(STATUS, "<大将>")
	TIMES MUSHI_ATK, 1.20
	TIMES MUSHI_SPD, 1.20
ENDIF
IF STRCOUNT(STATUS, "<高揚>")
	TIMES MUSHI_ATK, 1.50
	TIMES MUSHI_SPD, 1.50
ENDIF
IF STRCOUNT(STATUS, "<逆襲>")
	TIMES MUSHI_ATK, 1.50
	TIMES MUSHI_SPD, 1.50
ENDIF
SIF STRCOUNT(STATUS, "<悪臭>")
	TIMES MUSHI_ATK, 0.50
SIF STRCOUNT(STATUS, "<麻痹>")
	TIMES MUSHI_SPD, 0.50
SIF STRCOUNT(STATUS, "<緩慢>")
	TIMES MUSHI_SPD, 0.50
IF CUR_HP
	MUSHI_HP = CUR_HP
ELSE
	MUSHI_HP = MUSHI_MAXHP
ENDIF

