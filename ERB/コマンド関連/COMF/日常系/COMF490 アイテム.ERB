@薬の知識(ARG)
#FUNCTION
#DIM 回復量
#DIM 強化回数
回復量 = ARG
;回復量 = 基準値 * (1.1 ^ (調合Lv + 薬に関係しそうな知識))
強化回数 = TALENT:MASTER:調合Lv + TALENT:MASTER:禁断的知識 + TALENT:MASTER:調合知識
WHILE 強化回数 > 0
	TIMES 回復量, 1.1
	強化回数 --
WEND
RETURNF 回復量

;味覚所获得的恢复補正
;満腹度が上がらない食品は気力のみ補正
@ITEM_TASTE(CHARA, 基準値, 食品特徴)
#FUNCTION
#DIM CHARA
#DIM 基準値
#DIMS 食品特徴
#DIMS TASTE_CHARA_GOOD
#DIMS TASTE_CHARA_BAD
#DIM 回復量
TASTE_CHARA_GOOD = %GETMETH_STR(, "キャラデータ", CHARA, "料理：喜欢的味道")%
TASTE_CHARA_BAD = %GETMETH_STR(, "キャラデータ", CHARA, "料理：讨厌的味道")%

回復量 = 基準値 + (TASTE_MULTI_COUNT(TASTE_CHARA_GOOD, 食品特徴) - TASTE_MULTI_COUNT(TASTE_CHARA_BAD, 食品特徴)) * 10

;旬など季節に応じた補正
SELECTCASE GET_MONTH()
	CASE "春之月"
		IF STRCOUNT(食品特徴, "春物/") && !STRCOUNT(TASTE_CHARA_BAD, "春物/")
			TIMES 回復量, 1.3
		ENDIF
	CASE "夏之月"
		;夏は冰淇淋が2.0倍（嫌いじゃなければ）
		IF STRCOUNT(食品特徴, "冰淇淋/") && !STRCOUNT(TASTE_CHARA_BAD, "冰淇淋/")
			TIMES 回復量, 2.0
		ELSEIF STRCOUNT(食品特徴, "西瓜/")
			TIMES 回復量, 1.3
		ENDIF
	CASE "秋之月"
		IF STRCOUNT(食品特徴, "木通果/")
			TIMES 回復量, 1.3
		ENDIF
	CASE "冬之月"
		;冬は冰淇淋が0.5倍（好きじゃなければ）
		IF STRCOUNT(食品特徴, "冰淇淋/") && !STRCOUNT(TASTE_CHARA_GOOD, "冰淇淋/")
			TIMES 回復量, 0.5
		ENDIF
ENDSELECT

RETURNF 回復量

