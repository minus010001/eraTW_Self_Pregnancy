		CALL RECOVER(対象,100, "体力", "青汁的恢复")
		CALL RECOVER(対象, ITEM_TASTE(対象, 200, 食品特徴), "気力", "青汁的恢复")
		LOCAL:1 ++
	CASE 501	;营养饮料
		PRINTFORML 喝%ITEMNAME_TR(使用道具)%
		CALL RECOVER(対象, 薬の知識(200), "体力", "营养饮料的恢复")
		CALL RECOVER(対象, 薬の知識(100), "気力", "营养饮料的恢复")
		CFLAG:対象:清醒劑 = MAX(薬の知識(20), CFLAG:対象:清醒劑)
		TCVAR:対象:薬 = 1
		LOCAL:1 ++
	CASE 502	;精力剤
