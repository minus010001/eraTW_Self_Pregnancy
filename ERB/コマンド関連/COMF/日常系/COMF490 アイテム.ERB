		食品特徴 = %ITEMNAME:使用道具%/甜/
		CALL RECOVER(対象, ITEM_TASTE(対象, 100, 食品特徴), "体力", "槲叶糕的恢复")
		CALL RECOVER(対象, ITEM_TASTE(対象,   0, 食品特徴), "気力", "槲叶糕的恢复")
		CALL 満腹度上昇(対象, "甜点")
	CASE 213	;冰淇淋
		SIF TARGET && SHIRAHU(TARGET)
			PRINT 二人坐在一起吃着
		PRINTDATA
			DATAFORM 『冰淇淋』
			DATAFORM 『冷冻蜜柑』
			DATAFORM 『带两个柄的苏打冰淇淋』
			DATAFORM 『二个一组的蛋蛋冰淇淋』
			DATAFORM 『棒棒冰』
			DATAFORM 『papico冰棒』
			DATAFORM 『涂练乳的牛奶冰棒』
			DATAFORM 『红豆冰棒』
			DATAFORM 『西瓜冰棒』
			DATAFORM 『蜜柑冰棒』
			DATAFORM 『黑雷神巧克力冰棒』
			DATAFORM 『雪见大福』
		ENDDATA
		PRINTFORML 。
		食品特徴 = %ITEMNAME:使用道具%/冷/甜/
		CALL RECOVER(MASTER, ITEM_TASTE(MASTER, 150, 食品特徴), "気力", "冰淇淋的恢复")
		CALL 満腹度上昇(MASTER, "甜点")
		IF  TARGET && SHIRAHU(TARGET)
			CALL RECOVER(TARGET, ITEM_TASTE(TARGET, 150, 食品特徴), "気力", "冰淇淋的恢复")
			CALL 満腹度上昇(TARGET, "甜点")
		ENDIF
		LOCAL:1 ++
	CASE 215	;紅茶
		PRINTFORML 使用%ITEMNAME_TR(使用道具)%
		SETBIT TCVAR:MASTER:特別的茶水, 0
		LOCAL:1 ++
	CASE 216	;糖
		IF 対象 == MASTER
			PRINTFORML 剥开一颗硬糖含着。
			PRINTFORML 可以感受到丝丝甜味！
		ELSE
			PRINTFORML 剥开一颗硬糖给%CALLNAME:TARGET%吃。
			PRINTFORML MGMG…好甜！
		ENDIF
			TCVAR:対象:糖 = 20
			LOCAL:1 ++
	CASE 271	;触媒lv1
		IF !TALENT:MASTER:禁断的知識 && ABL:MASTER:TSLv <= 0
			PRINTL 理解不了这种东西的运作原理
			GOTO LOOP
		ELSE
			PRINTL 使用了触媒lv1，今日内可以使用TSLv1的魔法了
			SETBIT M_TFLAG:代替魔法等级, 1
			LOCAL:1 ++
		ENDIF
	CASE 272	;触媒lv2
		IF !TALENT:MASTER:禁断的知識 && ABL:MASTER:TSLv <= 1
