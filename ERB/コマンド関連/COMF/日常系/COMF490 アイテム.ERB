			食品特徴 = %ITEMNAME:使用道具%/愛情/甜/
			CALL RECOVER(MASTER, ITEM_TASTE(MASTER, 1000, 食品特徴), "体力", "巧克力的恢复")
			CALL RECOVER(MASTER, ITEM_TASTE(MASTER, 1000, 食品特徴), "気力", "巧克力的恢复")
			CALL 満腹度上昇(対象, "甜点")
			LOCAL:1 ++
		ENDIF
	CASE 212	;槲葉糕
