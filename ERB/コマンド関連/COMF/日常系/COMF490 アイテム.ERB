		ENDIF
	CASE 274	;触媒lv4
		IF !TALENT:MASTER:禁断的知識 && ABL:MASTER:TSLv <= 3
			PRINTL 理解不了这种东西的运作原理
			GOTO LOOP
		ELSE
			PRINTL 使用了触媒lv4，今日内可以使用TSLv4的魔法了
			SETBIT M_TFLAG:代替魔法等级, 4
			LOCAL:1 ++
		ENDIF
	CASE 275	;触媒lv5
		IF !TALENT:MASTER:禁断的知識 && ABL:MASTER:TSLv <= 4
			PRINTL 理解不了这种东西的运作原理
			GOTO LOOP
		ELSE
			PRINTL 使用了触媒lv5，今日内可以使用TSLv5的魔法了
			SETBIT M_TFLAG:代替魔法等级, 5
			LOCAL:1 ++
		ENDIF
	CASE 276	;符咒
		IF !TALENT:MASTER:禁断的知識 && ABL:MASTER:TSLv <= 0
			PRINTL 理解不了这种东西的运作原理
			GOTO LOOP
		ELSE
			M_TFLAG:BUFF标记 = 1
			CALL BUFF_BASE(対象, BASE_法力, 50, 1)
			CALL RECOVER(対象, 50 +SQRT(MAXBASE:対象:法力), "法力","符咒的回复")
			LOCAL:1 ++
		ENDIF
	CASE 277
		IF !TALENT:MASTER:神性 && TALENT:MASTER:高难开局 && !TALENT:MASTER:禁断的知識
			PRINTL 可恶, 似乎被什么封印了, 无论如何都打不开
			GOTO LOOP
		ELSE
			PRINTFORML 要开启几个宝藏袋？
			PRINTFORML [1]  开启1个
			SIF ITEM:宝藏袋 >= 5
				PRINTFORML [5]  开启5个
			SIF ITEM:宝藏袋 >= 10
				PRINTFORML [10] 开启10个
			SIF ITEM:宝藏袋 < 10
				PRINTFORML [998] 开启剩余所有
			PRINTFORML [999] 放弃
			INPUT
			IF RESULT == 999
				GOTO LOOP
			ELSEIF RESULT >= 1 && RESULT <= 10
				CALL GACHAPON(RESULT)
				LOCAL:1 ++
			ELSEIF RESULT == 998
				CALL GACHAPON(ITEM:宝藏袋)
				LOCAL:1 ++
			ENDIF
		ENDIF
	CASE 352	;草莓
		PRINTFORML 吃%ITEMNAME_TR(使用道具)%
		食品特徴 = %ITEMNAME:使用道具%/野菜/果物/甜/
		CALL RECOVER(対象, ITEM_TASTE(対象, 50, 食品特徴), "気力", "草莓的恢复")
		LOCAL:1 ++
	CASE 364	;西瓜
		食品特徴 = %ITEMNAME:使用道具%/野菜/果物/甜/
		IF FLAG:70 == 1
			PRINTFORML 吃%ITEMNAME_TR(使用道具)%
			CALL RECOVER(対象, ITEM_TASTE(対象, 100, 食品特徴), "気力", "西瓜的恢复")
		ELSE
			IF TARGET != MASTER
				IF GET_TARGETNUM() > 1
					PRINTFORM 大家一起
				ELSEIF SHIRAHU(TARGET)
					PRINTFORM 和%CALLNAME:TARGET%一起
				ENDIF
			ENDIF
			PRINTFORML 吃%ITEMNAME_TR(使用道具)%
			CALL RECOVER(MASTER, ITEM_TASTE(MASTER, 100, 食品特徴), "気力", "西瓜的恢复")
			FOR 全員, 1, GET_TARGETNUM() + 1
				SIF TARGET:全員 <= 0
					CONTINUE
				SIF !SHIRAHU(TARGET:全員)
					CONTINUE
				CALL RECOVER(TARGET:全員, ITEM_TASTE(TARGET:全員, 100, 食品特徴), "気力", "西瓜的恢复")
			NEXT
		ENDIF
		LOCAL:1 ++
	;CASE 400
	;	;PRINTFORML %CALLNAME:MASTER%は%ITEMNAME:使用道具%を開いた
	;	PRINTFORML %CALLNAME:MASTER%打开了%ITEMNAME:使用道具%
	;	CALL COM401
	;	LOCAL:1 ++
	CASE 500	;青汁
		PRINTFORML 喝%ITEMNAME_TR(使用道具)%
