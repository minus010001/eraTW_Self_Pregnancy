@SET_MIRADA
PRINTFORML 请选择対象。
PRINTFORML 黄色为已经有效、粉色为已经陷落的角色。
SIF FLAG:並び替え
	CALL CHARASORT_EX
FOR LOCAL:1, 1, EX_CHARANUM + 1
	IF FLAG:並び替え
		LOCAL = RESULT:(LOCAL:1)
		SIF LOCAL < 0
			CONTINUE
	ELSE
		LOCAL = LOCAL:1
		SIF LOCAL >= CHARANUM
			BREAK
	ENDIF
	;SIF TALENT:LOCAL:路人
	;	CONTINUE
	SIF CFLAG:LOCAL:出禁
		CONTINUE
	SIF CFLAG:LOCAL:体目当て
		SETCOLOR C_YELLOW
	SIF TALENT:LOCAL:炮友 || TALENT:LOCAL:恋慕
		SETCOLOR C_PINK
	PRINTFORMLC [{LOCAL, 3}] %CALLNAME:LOCAL%
	RESETCOLOR
NEXT
PRINTFORML 
DRAWLINE
PRINTFORML [999] 放弃
INPUT
SIF !INRANGE(RESULT,1,CHARANUM)
	RETURN -1
SIF CFLAG:RESULT:体目当て
	RETURN -1
IF TALENT:RESULT:炮友 || TALENT:RESULT:恋慕
	TCVAR:RESULT:発情 = 1
ELSE
	CFLAG:RESULT:体目当て = 1
ENDIF
PRINTFORMW 你想着%CALLNAME:RESULT%的样子用力握紧了奇迹之石、石头发出了淡淡的光芒
RETURN 1

@使用可能道具(ARG)
;1だとMASTERのみ、2だと你以外にも使える
#FUNCTION

SIF CFLAG:MASTER:诶嘿嘿 && !ITEMTYPE_DRUG(ARG)
	RETURNF 0
;(酒造パッチ)灰汁卷と山葡萄、墨西哥巻餅
;SELECTCASE ARG
;	CASE 121 TO 123, 215, 364, 500, 510, 514, 515, 516, 517, 520, 521, 530
;		RETURNF 1
;	CASE 120, 212, 213, 352, 501, 503, 505 TO 509, 511, 512, 550, 576, 626, 628, 630, 665, 669
;		RETURNF 2
;	CASE 502
;		SIF HAS_PENIS(TARGET)
;			RETURNF 2
;		RETURNF 1
;	CASEELSE
;		RETURNF 0
;ENDSELECT
SELECTCASE ITEMTYPE(ARG)
	CASE 1, 2, 3, 4, 5
		IF GROUPMATCH(ITEMNAME:ARG, "国士無双の薬", "巧克力", "高級巧克力", "本命巧克力", "青汁")
			RETURNF 1
		ENDIF
		RETURNF 2
	CASE 6
		IF GROUPMATCH(ITEMNAME:ARG, "糖")
			RETURNF 2
		ENDIF
		RETURNF 1
	CASEELSE
		RETURNF 0
ENDSELECT

