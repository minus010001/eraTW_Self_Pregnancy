			PRINTL 使用了触媒lv2，今日内可以使用TSLv2的魔法了
			SETBIT M_TFLAG:代替魔法等级, 2
			LOCAL:1 ++
		ENDIF
	CASE 273	;触媒lv3
		IF !TALENT:MASTER:禁断的知識 && ABL:MASTER:TSLv <= 2
			PRINTL 理解不了这种东西的运作原理
