		SIF MAGIC_DLC
			CALL RECOVER(対象, 薬の知識(400), "法力", "大回復薬的回復")
		CFLAG:対象:清醒劑 = MAX(薬の知識(60), CFLAG:対象:清醒劑)
		TCVAR:対象:薬 = 1
		LOCAL:1 ++
	;CASE 504
	;		IF FLAG:70
	;			PRINTFORML 請解除時間停止後使用
	;			GOTO LOOP
	;		ENDIF
