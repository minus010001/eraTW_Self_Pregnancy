;-------------------------------------------------
;道具画面
;-------------------------------------------------
@COM490
#DIM 対象
#DIM 全員
#DIM CLIENT_ID
#DIM 虚無への回帰
#DIM 使用道具
#DIM 表示道具種別
#DIMS 食品特徴
VARSET LOCAL
VARSET LOCALS
対象 = MASTER
虚無への回帰 = 0
表示道具種別 = 0
PRINTL 要使用什么呢？
$LOOP
;qol custom code
GOTO QOL
DRAWLINE
FOR LOCAL,120, 699
	SIF 表示道具種別 != 0 && ITEMTYPE(LOCAL) != 表示道具種別
		CONTINUE
	IF 対象 != MASTER
		IF 使用可能道具(LOCAL) == 2 && ITEM:LOCAL
			CALL PRINT_ITEM_EXPLANATION(LOCAL)
		ENDIF
	ELSE
		IF 使用可能道具(LOCAL) && ITEM:LOCAL
			CALL PRINT_ITEM_EXPLANATION(LOCAL)
		ENDIF
	ENDIF
NEXT
PRINTL
DRAWLINE
CALL PRINTBUTTON_EX("[全表示]", 2000, 表示道具種別 != 0, 表示道具種別 == 0)
CALL PRINTBUTTON_EX("[恢复药]", 2001, 表示道具種別 != 1, 表示道具種別 == 1)
CALL PRINTBUTTON_EX("[Buff药]", 2002, 表示道具種別 != 2, 表示道具種別 == 2)
CALL PRINTBUTTON_EX("[食　品]", 2003, 表示道具種別 != 3, 表示道具種別 == 3)
CALL PRINTBUTTON_EX("[点　心]", 2004, 表示道具種別 != 4, 表示道具種別 == 4)
CALL PRINTBUTTON_EX("[果　物]", 2005, 表示道具種別 != 5, 表示道具種別 == 5)
CALL PRINTBUTTON_EX("[其　他]", 2006, 表示道具種別 != 6, 表示道具種別 == 6)
RESETCOLOR
PRINTL
DRAWLINE
SIF ITEM:昆虫採集套装
	PRINTFORML [901] 确认虫笼
PRINTFORML [900] 收集的胖次自动进入间隙的开关（现在\@ FLAG:C隙間自動仕様 ? ON# OFF\@）
IF TARGET && SHIRAHU(TARGET)
	SIF 対象 != MASTER
		SETCOLOR C_YELLOW
	PRINTFORML [998] 用于%CALLNAME:TARGET%
	RESETCOLOR
ENDIF

PRINTL [999] 算了
INPUT
$QOL
CALL QoL_490_ITEMMENU(対象)
使用道具 = RESULT
;道具以外の処理
SELECTCASE RESULT
	CASE 999
		RETURN -1
	CASE 900
		FLAG:C隙間自動仕様 = !FLAG:C隙間自動仕様
		PRINTFORMW 把自动收纳设为了\@ FLAG:C隙間自動仕様 ? ON# OFF\@
		GOTO LOOP
	CASE 901
		;[捕虫をする]へ転送
		CALL SHOW_MUSHI_CAGE
		GOTO LOOP
	CASE 998
		IF 対象 != MASTER
			対象 = MASTER
		ELSEIF SHIRAHU(TARGET) && TARGET
			対象 = TARGET
		ENDIF
		GOTO LOOP
	CASE 2000 TO 2006
		表示道具種別 = RESULT % 2000
		GOTO LOOP
ENDSELECT

;使用可能道具以外の入力、または道具未所持の場合は再入力
IF 使用可能道具(使用道具) == 0 || ITEM:使用道具 <= 0
	GOTO LOOP
ENDIF
;相手使用時にMASTERのみ道具の選択は再入力
IF 対象 != MASTER && 使用可能道具(使用道具) == 1
	GOTO LOOP
ENDIF
;IF ITEMTYPE_DRUG(使用道具,対象) && TCVAR:(ARG:1):薬
;	PRINTL 已经服用过薬了所以今天还是算了吧
;	GOTO LOOP
;ENDIF
IF ITEMTYPE_FOOD(使用道具) && !TIME_PROGRESS(TCVAR:対象:空腹時刻)
	PRINTFORML %CALLNAME:対象%的肚子还不饿
	GOTO LOOP
ENDIF
IF ITEMTYPE_SWEETS(使用道具) && !TIME_PROGRESS(TCVAR:対象:甜点空腹時刻)
	PRINTL 现在还不想吃零食
	GOTO LOOP
ENDIF
TFLAG:193 = 使用道具
TFLAG:194 = 対象 == MASTER ? MASTER # 1
SELECTCASE 使用道具
	CASE 120	;黑雷神巧克力
		PRINTFORML 吃%ITEMNAME_TR(使用道具)%
		SIF 対象 == MASTER
			PRINTL ……一股廉价的味道
		食品特徴 = %ITEMNAME:使用道具%/甜/ジャンキー/サクサク/
		CALL RECOVER(対象, ITEM_TASTE(対象, 50, 食品特徴), "体力", "巧克力的恢复")
		CALL RECOVER(対象, ITEM_TASTE(対象, 50, 食品特徴), "気力", "巧克力的恢复")
		CALL 満腹度上昇(対象, "甜点", 60)
		LOCAL:1 ++
	CASE 121	;巧克力
		IF 対象 == MASTER
			PRINTFORML 吃%ITEMNAME_TR(使用道具)%
			食品特徴 = %ITEMNAME:使用道具%/甜/
			CALL RECOVER(MASTER, ITEM_TASTE(MASTER, 300, 食品特徴), "体力", "巧克力的恢复")
			CALL RECOVER(MASTER, ITEM_TASTE(MASTER, 300, 食品特徴), "気力", "巧克力的恢复")
			CALL 満腹度上昇(対象, "甜点")
			LOCAL:1 ++
		ENDIF
	CASE 122	;高級巧克力
		IF 対象 == MASTER
			PRINTFORML 吃%ITEMNAME_TR(使用道具)%
			PRINTFORML 好吃！
			食品特徴 = %ITEMNAME:使用道具%/甜/上品/豪華/高级食材/
			CALL RECOVER(MASTER, ITEM_TASTE(MASTER, 500, 食品特徴), "体力", "巧克力的恢复")
			CALL RECOVER(MASTER, ITEM_TASTE(MASTER, 500, 食品特徴), "気力", "巧克力的恢复")
			CALL 満腹度上昇(対象, "甜点")
			LOCAL:1 ++
		ENDIF
	CASE 123	;本命巧克力
		IF 対象 == MASTER
			PRINTFORML 吃%ITEMNAME_TR(使用道具)%
