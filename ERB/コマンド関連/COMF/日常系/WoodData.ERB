;logging patch custom code
@WoodData(W_ID, IMPORT_MODE = 0)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC W_ID
#DIM DYNAMIC IMPORT_MODE

;WoodName = 名称
;WoodValue_Log = 原木出售（人里材木店）的基础价格
;WoodValue_Plank = 木材出售（山间锯木厂）的基础价格
;WoodEffort = 伐木所需时间 TSP消耗量
;WoodItem = 直接获得的物品 644=原木 645=青竹（可多持） 646=香木
;WoodIntro = 说明文
;WoodTribe = 分布・树种・特征标签

IF !IMPORT_MODE
	CALL QOL_WOOD_LOAD(W_ID)
ENDIF
SIF WoodName != ""
	RETURN 0

SELECTCASE W_ID
	CASE 1
		WoodName = 杉木
		WoodValue_Log = 2500
		WoodValue_Plank = 2000
		WoodEffort = 800
		WoodItem = 644
		WoodIntro1 = 日本柳杉（Cryptomeria japonica），柏科柳杉属中的唯一一种，日本特有树种，象征着日本的木材文化。易于加工，木材不会变得很坚硬。
		WoodIntro2 = 幻想乡最常见的树种，栖息地面积位居榜首。\n　因此，初春时节这些树木释放到空气中的大量花粉令人担忧。
		WoodTribe = 博/森/深/山/常緑/針葉/湿潤/軟質/
	CASE 2
		WoodName = 桧木
		WoodValue_Log = 3750
		WoodValue_Plank = 3000
		WoodEffort = 800
		WoodItem = 644
		WoodIntro1 = 日本扁柏（Chamaecyparis obtusa）柏科扁柏属，一种因其卓越的建筑品质而被广泛使用的树木。坚固耐用，即使经过1000多年也不会腐烂。
		WoodIntro2 = 它具有良好的颜色、光泽、易加工性和独特的香气，所有这些都使其当之无愧地被称为最优秀的建筑材料。
		WoodTribe = 博/森/深/山/常緑/針葉/乾湿/軟質/
	CASE 3
		WoodName = 松木
		WoodValue_Log = 3750
		WoodValue_Plank = 3000
		WoodEffort = 1000
		WoodItem = 644
		WoodIntro1 = 松科松属的多种大型乔木的统称，一种生长在山脊等阳光充足之处的吉祥树。树干弯曲，不适合用作柱子等，\n　但它非常坚固，常用于横梁或其他支撑结构。
		WoodIntro2 = 与松茸共生，其油性干柴曾被视为高质量燃料而备受珍视。
		WoodTribe = 博/深/山/常緑/針葉/乾燥/中硬/
	CASE 4
		WoodName = 青冈木
		WoodValue_Log = 5000
		WoodValue_Plank = 4200
		WoodEffort = 1800
		WoodItem = 644
		WoodIntro1 = 壳斗科栎属青刚栎亚属多种大型乔木的统称，以其橡子闻名。作为材料非常坚硬，是日本最坚硬的木材之一。
		WoodIntro2 = 广泛用作需要卓越耐用性的部件，如长矛和斧柄、刨子外壳、算盘珠、木剑以及优质木炭的材料。
		WoodTribe = 博/森/深/山/落葉/広葉/乾湿/硬質/
	CASE 5
		WoodName = 山毛榉
		WoodValue_Log = 2500
		WoodValue_Plank = 2000
		WoodEffort = 1400
		WoodItem = 644
		WoodIntro1 = 壳斗科水青冈属（山毛榉属）多种大型乔木的统称，广泛分布于北方凉温带落叶阔叶林的主要树种。它既可作木材，也可作木炭。
		WoodIntro2 = 在日本专指圆齿山毛榉（Fagus crenata），也被称为白山毛榉，日本特有树种，\n与水稻种植相关的里山林地和常绿森林文化相比，深山山毛榉林的丰饶滋养了多种多样的物种，并催生了独特的习俗，例如东北地方的传统又鬼。
		WoodTribe = 深/山/落葉/広葉/湿潤/中硬/
	CASE 6
		WoodName = 银杏木
		WoodValue_Log = 3750
		WoodValue_Plank = 3000
		WoodEffort = 1000
		WoodItem = 644
		WoodIntro1 = 银杏（Ginkgo biloba），中国原生树种，被称为植物界的『活化石』，是自侏罗纪流传至今的银杏门银杏纲银杏目的唯一现存物种。\n　这种树的独特之处在于它作为种子植物仍能产生游动的精子进行繁殖。
		WoodIntro2 = 其木材洁白、致密且美观，用于制作木鱼、围棋盘、砧板和漆器。
		WoodTribe = 博/森/落葉/広葉/乾湿/中硬/
	CASE 7
		WoodName = 榉木
		WoodValue_Log = 8000
		WoodValue_Plank = 7100
		WoodEffort = 1800
		WoodItem = 644
		WoodIntro1 = 榉木（Zelkova serrata）榆科榉属。\n生长迅速且寿命长，许多大型和巨型个体可在不同地域找到，常被视为神圣之物。
		WoodIntro2 = 这种木材具有卓越的强度和耐用性，其纹理也同样美丽；是最优质的硬木之一，用于建筑、家具和雕塑等多种用途。
		WoodTribe = 博/森/深/落葉/広葉/乾湿/硬質/
	CASE 8
		WoodName = 桐木
		WoodValue_Log = 5400
		WoodValue_Plank = 4700
		WoodEffort = 600
		WoodItem = 644
		WoodIntro1 = 毛泡桐（Paulownia tomentosa）泡桐科泡桐属。\n因为它生长迅速、材质轻且不易变形，所以广泛用于制作高档箱柜、木屐、古筝、能剧面具和桐木盒。
		WoodIntro2 = 它也用于保险箱内衬，因为它在点燃时能迅速烧焦并碳化表面，从而阻止内部进一步燃烧。
		WoodTribe = 博/森/深/落葉/広葉/乾湿/軟質/
	CASE 9
		WoodName = 栎木
		WoodValue_Log = 4050
		WoodValue_Plank = 3400
		WoodEffort = 1400
		WoodItem = 644
		WoodIntro1 = 壳斗科栎属栎亚属多种大型乔木的统称，被称为尽管生长缓慢且难以通过再造林补充，但其木材沉重坚硬，径切纹理具有美丽的图案。
		WoodIntro2 = 东亚常见麻栎、槲栎、水栎、枹栎等，欧美常见种被称为橡木，广泛用作高档家具和室内装饰材料，也用作酿酒的木桶。
		WoodTribe = 博/森/深/山/落葉/広葉/乾湿/硬質/
	CASE 10
		WoodName = 枫木
		WoodValue_Log = 4050
		WoodValue_Plank = 3400
		WoodEffort = 1000
		WoodItem = 644
		WoodIntro1 = 无患子科枫属的总称。语源是『蝦手 (かへるで)』，因其叶子的形状像青蛙手部。
		WoodIntro2 = 它的树液被称为枫糖浆。这种木材坚硬耐用，广泛用于乐器和家具。
		WoodTribe = 博/深/山/落葉/広葉/乾湿/硬質/
	CASE 11
		WoodName = 桦木
		WoodValue_Log = 4800
		WoodValue_Plank = 4000
		WoodEffort = 1000
		WoodItem = 644
		WoodIntro1 = 岳桦（Betula ermanii）桦木科桦木属。\n一种常生长在高海拔地区的树种，充满活力且足够坚韧以承受积雪的重量。
		WoodIntro2 = 其带红色的树皮常被用作引火物和鞣革；木材具有独特的光泽和质地，使其作为家具材料具有价值。
		WoodTribe = 山/落葉/広葉/乾湿/中硬/
	CASE 12
		WoodName = 竹子
		WoodValue_Log = 500
		WoodValue_Plank = 300
		WoodEffort = 300
		WoodItem = 645
		WoodIntro1 = 一种禾本科植物。\n　一种外观类似树木的多年生草本植物，但据说每隔几十年开花一次，然后就会枯萎。
		WoodIntro2 = 竹子在水平方向上坚固且柔韧，但在垂直方向上容易劈裂，\n　使其可用作各种竹制品的材料。
		WoodTribe = 竹/常緑/広葉/乾湿/軟質/サイズ無視/
	CASE 13
		WoodName = 香木
		WoodValue_Log = 15000
		WoodValue_Plank = 15000
		WoodEffort = 600
		WoodItem = 646
		WoodIntro1 = 分泌含有芳香成分的特殊树脂或精油的树木的统称。主要指檀香属白檀、沉香属数种、龙脑香属数种乔木。
		WoodIntro2 = 多为南亚传入，在室温下散发香味，用于佛珠、佛像、香囊等。
		WoodTribe = 竹/深/常緑/広葉/湿潤/軟質/希少/サイズ無視/
	CASEELSE
		WoodValue_Log = 0
		WoodValue_Plank = 0
ENDSELECT
