;进行调合
@COM446
#LOCALSIZE 2
#LOCALSSIZE 1
#DIM DYNAMIC 调合物
#DIM DYNAMIC 调合候补
#DIM DYNAMIC 选择レシピ
#DIM DYNAMIC 调合件数
#DIM DYNAMIC 调合パワー
#DIM DYNAMIC 调合パワーM
#DIM DYNAMIC 调合パワーT
#DIM DYNAMIC CHARA
#DIM DYNAMIC R_ID
#DIM DYNAMIC PRODUCTION
#DIM DYNAMIC 体力消费
#DIM DYNAMIC 气力消费
#DIM DYNAMIC INPUT_LOOP_LINE,4

;参加者判定
IF TARGET && ABL:TARGET:親密 >= 5 && SHIRAHU(TARGET) && CFLAG:TARGET:行動 != 5
	CHARA = TARGET
ELSE
	CHARA = 0
ENDIF

;调合パワー设定 调合知识と教养、药学教本を持っていると加算
IF !MAGIC_DLC
	调合パワーM = TALENT:MASTER:調合Lv * 15 + ABL:MASTER:教養 * 5 + TFLAG:幸運補正 * 5 + TALENT:MASTER:調合知識 * 30
ELSE
	调合パワーM = TALENT:MASTER:調合Lv * 15 + ABL:MASTER:教養 * 5 + MAGIC_SuccessRate() / 4 + TALENT:MASTER:調合知識 * 30 + TALENT:MASTER:神性 * 10
ENDIF
SIF ITEM:薬学教本
	调合パワーM += 10
SIF CHARA
	调合パワーT = TALENT:CHARA:調合Lv * 15 + ABL:CHARA:教養 * 5 + TALENT:CHARA:調合知識 * 30
;参加者で最もパワーが高いものを基准に、1/2したもう１人のパワーを足す
IF 调合パワーM >= 调合パワーT
	调合パワー = 调合パワーM + (调合パワーT / 2)
ELSE
	调合パワー = 调合パワーT + (调合パワーM / 2)
ENDIF

INPUT_LOOP_LINE:0 = LINECOUNT
$INPUT_LOOP00
CLEARLINE LINECOUNT - INPUT_LOOP_LINE:0
;①调合物选择列表画面描画、调合候补を选择
CALL PHARMACY_LIST
INPUT_LOOP_LINE:1 = LINECOUNT
$INPUT_LOOP01
CLEARLINE LINECOUNT - INPUT_LOOP_LINE:1
INPUT
SIF RESULT == 1000
	RETURN -1
调合候补 = RESULT

;②调合物选择列表内の能力によるレシピ解放・调合可能かを判定
IF !INRANGE(调合候补,261,270)
	SELECTCASE PHARMACY_RANK(调合候补)
		CASE 0
			GOTO INPUT_LOOP01
		CASE 1
			;无条件解放
		CASE 2, 3
			IF TALENT:MASTER:調合Lv < (PHARMACY_RANK(调合候补) - 1) && ITEM:109 == 0
				GOTO INPUT_LOOP01
			ENDIF
		CASE 4, 5
			IF TALENT:MASTER:調合Lv < (PHARMACY_RANK(调合候补) - 1)
				GOTO INPUT_LOOP01
			ENDIF
	ENDSELECT
ENDIF
;体质变化药は【禁断的知识】所有时のみ可
IF PHARMA_VOLATILE(调合候补) && !TALENT:MASTER:禁断的知識 && !INRANGE(调合候补,261,270)
	GOTO INPUT_LOOP01
ENDIF

;③调合レシピ列表を出力
DRAWLINE
;★ここに道具列表を出す？

;道具解说.ERBから说明文を表记
SETCOLOR 0x00FF00
PRINTFORML ●%ITEMNAME_TR(调合候补)%　（所持数：{ITEM:调合候补}）
PRINTFORML 　%ITEM_EXPLANATION(调合候补)% 
RESETCOLOR
PRINTL 
PRINTL 要用哪个配方进行调合？
DRAWLINE
CALL PHARMACY_RECIPELIST(调合候补)

;④レシピ番号を入力、实行可否を判定
INPUT_LOOP_LINE:2 = LINECOUNT
$INPUT_LOOP02
CLEARLINE LINECOUNT - INPUT_LOOP_LINE:2
INPUT
SIF RESULT == 0
	GOTO INPUT_LOOP00
选择レシピ = RESULT
R_ID = 调合候补 * 10 + 选择レシピ
IF !CAN_PHARMA(R_ID)
	GOTO INPUT_LOOP02
ENDIF

;⑤调合回数を入力、可否を判定
PRINTFORML 用这个配方调合多少次%ITEMNAME_TR(调合候补)%？(输入1～的个数、0为返回)
;そのレシピで消费する素材の现在的所持数を表记
PRINT 　消费素材的持有数：

CALL PHARMACY_CONSUME(R_ID, 0, 1)

PRINTBUTTON "[0] 放弃", 0
PRINT     
PRINTBUTTON "[1] 1次", 1
PRINT     
IF CAN_PHARMA(R_ID, 5)
	PRINTBUTTON "[5] 5次", 5
	PRINT   
ENDIF
IF CAN_PHARMA(R_ID, 10)
	PRINTBUTTON "[10] 10次", 10
	PRINT   
ENDIF

INPUT_LOOP_LINE:3 = LINECOUNT
$INPUT_LOOP03
CLEARLINE LINECOUNT - INPUT_LOOP_LINE:3
INPUT
调合件数 = RESULT
SIF RESULT == 0
	GOTO INPUT_LOOP00
PRODUCTION = CAN_PHARMA(R_ID, 调合件数)
IF PRODUCTION && 调合件数 <= 10
	CLEARLINE 1
	PRINTFORML 制定了用第{选择レシピ}号配方来调合{PRODUCTION}个%ITEMNAME_TR(调合候补)%的方案
	;调合时前后での消费道具の数を表记
	PRINT 　消费的素材：
	CALL PHARMACY_CONSUME(R_ID, 调合件数, 1)
	;调合成功时道具个数が999を超える场合は警告を出す
	IF ITEM:(调合候补) + PRODUCTION > 999
		PRINTFORML 　这个方案会超出%ITEMNAME_TR(调合候补)%的存储上限、浪费掉{PRODUCTION - 999}个
	ELSE
		PRINTFORML 　调合成功时%ITEMNAME_TR(调合候补)%的个数：（{ITEM:调合候补}→{ITEM:调合候补 + PRODUCTION}）
	ENDIF
	IF PHARMACY_RANK(调合候补) == 1
		PRINTL 怎么看都不可能会失败吧…
	ELSEIF PHARMACY_RANK(调合候补) >= 2
		SELECTCASE (调合パワー - (PHARMACY_RANK(调合候补) * 20))
			CASE IS <= -100
				PRINTL 虽然配方知道了、但是未知的要素太多了…应该会失败吧
			CASE -99 TO -50
				PRINTL 不得不说想让这次调合成功的话会非常困难…
			CASE -49 TO -30
				PRINTL 这次调合的失败率挺高的…
			CASE -29 TO -10
				PRINTL 这次调合有失败的风险…
			CASE -9 TO -1
				PRINTL 这次调合基本上来说应该是会成功的…
			CASEELSE
				PRINTL 怎么看都不可能会失败吧…
		ENDSELECT
	ENDIF
	PRINT 要调合吗？
	PRINTL 
	CALL ASK_YN
	IF !RESULT
	;先に进む
	ELSE
		调合件数 = 0
		RETURN -1
	ENDIF
ELSE
	调合件数 = 0
	GOTO INPUT_LOOP03
ENDIF

;ここまでで条件を全部クリアしている场合は以下に进行
REPEAT 5
	REUSELASTLINE  \@ CHARA ? 和%CALLNAME:CHARA%一起 #  \@调合中.%"." * COUNT%
	TWAIT 30, 1
REND
R_ID = 调合物 * 10 + 选择レシピ
;⑥调合の成功判定
IF PHARMACY_RANK(调合候补) != 1
	IF 调合パワー >= RAND:(PHARMACY_RANK(调合候补) * 20)
		PRINTFORML 调合成功了！
		调合物 = 调合候补
		;调合后入手个数を流し込む
		TFLAG:194 = PRODUCTION
	ELSE
		PRINTFORML 调合失败了…
		调合物 = 0
	ENDIF
;调合LV1レシピは100％成功
ELSE
	PRINTFORML 调合成功了！
	调合物 = 调合候补
	;调合后入手个数を流し込む
	TFLAG:194 = PRODUCTION
ENDIF

;素材道具消费处理をここで
PRINT 　本次消费的素材：
R_ID = (调合候补 * 10 + 选择レシピ)
CALL PHARMACY_CONSUME(R_ID, 调合件数)

;⑦道具入手处理 999个以上にならないようにする
;  体质改变药も入手处理に変更（使用は道具メニューから行う）
IF 调合物 != 0
	IF ITEM:(调合物) + TFLAG:194 > 999
		ITEM:(调合物) = 999
	ELSE
		ITEM:(调合物) += TFLAG:194
	ENDIF
	SIF BREWING_GUIDE_CAN_DRINK(ITEMNAME:调合物)
		CALL BREWING_GUIDE_CONSUME(ITEMNAME:调合物)
ENDIF

;⑧経験加算 调合成功时は调合难易度×调合件数の経験
EXP:MASTER:調合経験 += PHARMACY_EXP(调合候补, 调合件数, 调合物)
SIF CHARA
	EXP:CHARA:調合経験 += PHARMACY_EXP(调合候补, 调合件数, 调合物)
;药学教本持っていると追加
SIF ITEM:109
	EXP:MASTER:調合経験 += MAGIC_DLC_等级重置 ? RANDSF(1,调合件数) # MAX(RAND:(调合件数), 1)

;能力差で教えてもらう・进行解答
IF !MAGIC_DLC_等级重置
	IF 调合パワーM >= 调合パワーT && CHARA
		EXP:CHARA:調合経験 ++
	ELSEIF CHARA
		EXP:MASTER:調合経験 ++
	ENDIF
ELSE
	IF TALENT:MASTER:調合Lv > TALENT:CHARA:調合Lv
		EXP:CHARA:調合経験 += (TALENT:MASTER:調合Lv - TALENT:CHARA:調合Lv + 2) * 调合件数
	ELSEIF TALENT:MASTER:調合Lv < TALENT:CHARA:調合Lv
		EXP:MASTER:調合経験 += (TALENT:CHARA:調合Lv - TALENT:MASTER:調合Lv + 2) * 调合件数
	ELSE
		EXP:CHARA:調合経験 += 调合件数
		EXP:MASTER:調合経験 += 调合件数
	ENDIF
ENDIF

IF !GETBIT(M_CFLAG:CHARA:魔法奖励获得, 3) && ABL:CHARA:親密 >= 5 && TALENT:CHARA:調合Lv >= 4 && MAGIC_DLC
	LOCAL:1 = 0
	LOCAL:1 = RANDSF((TALENT:CHARA:調合Lv - 2 + MAGIC_LoveFactor(CHARA)),调合件数)
	M_CFLAG:CHARA:魔法奖励EXP += LOCAL:1 * 10000
	SIF LOCAL:1
		PRINTFORML 与%CALLNAME:CHARA%的共同調合让你收获颇丰。
	IF GET_MAGIC_EXP_BIT(M_CFLAG:CHARA:魔法奖励EXP, 2) >= 15 && TALENT:MASTER:調合Lv >= 3
		SETBIT M_CFLAG:CHARA:魔法奖励获得, 3 ; 设置调和位
		ITEM:957 += 1
		SIF ITEM:957 >=4
			ITEM:958 = 1
		CALL COLORMESSAGE(@"灵光一闪",C_GREEN,1)
		IF ITEM:957 == 2
			CALL COLORMESSAGE(@"你学会了解酒魔法Lv1!",C_BLUE,1)
			SIF ABL:MASTER:TSLv < 2
				CALL COLORMESSAGE(@"升级TSLv至2级,或者使用触媒Lv2后可以使用",C_BLUE,1)
		ELSEIF ITEM:957 == 4
			CALL COLORMESSAGE(@"你学会了解酒魔法Lv2!",C_BLUE,1)
			SIF ABL:MASTER:TSLv < 3
				CALL COLORMESSAGE(@"升级TSLv至3级,或者使用触媒Lv3后可以使用",C_BLUE,1)
		ELSEIF ITEM:957 == 6
			CALL COLORMESSAGE(@"解酒魔法Lv2可以进行群体解酒了!",C_BLUE,1)
		ENDIF
	ENDIF
ENDIF

;⑨时间经过 调合难易度と调合件数によって补正
TIME += PHARMACY_TIME(调合候补, 调合件数)
M_TFLAG:时间因子类型 = TimeFactor_调合

;⑩体力・气力减少处理
体力消费 = 30 * SQRT(调合件数)
气力消费 = MAX((((50 * PHARMACY_RANK(调合候补)) - (15 * TALENT:MASTER:調合知識 + 10 * TALENT:MASTER:調合Lv))), 30) * SQRT(调合件数)
;自室かつ机椅子があると体力气力消费低减
IF CFLAG:MASTER:現在位置 == CFLAG:MASTER:初期位置 && ITEM:榉木桌椅
	SELECTCASE ITEM:榉木桌椅
		CASE 1
			TIMES 体力消费, 0.9
			TIMES 气力消费, 0.9
		CASE 2
			TIMES 体力消费, 0.85
			TIMES 气力消费, 0.85
		CASE 3
			TIMES 体力消费, 0.8
			TIMES 气力消费, 0.8
	ENDSELECT
	PRINTFORML 桌子上经常整理整顿、能够高效率地进行调合
ENDIF
DOWNBASE:MASTER:体力 = 体力消费
DOWNBASE:MASTER:気力 = 气力消费

;参加者のソース,同一指令制限を受けないので控えめに、调合失败は半减
IF CHARA > 0
	;固定で获得するソース
	SOURCE:CHARA:歓楽 = 200
	SOURCE:CHARA:情愛 = 50
	
	;ABL:従順をみる
	IF ABL:従順 <= 1
		SOURCE:CHARA:歓楽 += (ABL:従順 * 40)
		SOURCE:CHARA:情愛 += (ABL:親密 * 20)
	ELSEIF ABL:従順 <= 3
		SOURCE:CHARA:歓楽 += 200 + (ABL:従順 * 40)
		SOURCE:CHARA:情愛 += 50 + (ABL:親密 * 30)
	ELSEIF ABL:従順 <= 5
		SOURCE:CHARA:歓楽 += 500 + (ABL:従順 * 40)
		SOURCE:CHARA:情愛 += 200 + (ABL:親密 * 30)
	ELSEIF ABL:従順 <= 8
		SOURCE:CHARA:歓楽 += 750 + (ABL:従順 * 60)
		SOURCE:CHARA:情愛 += 300 + (ABL:親密 * 40)
	ELSEIF ABL:従順 <= 11
		SOURCE:CHARA:歓楽 += 1000 + (ABL:従順 * 60)
		SOURCE:CHARA:情愛 += 600 + (ABL:親密 * 40)
	ELSE
		SOURCE:CHARA:歓楽 += 1600 + (ABL:従順 * 30)
		SOURCE:CHARA:情愛 += 1000 + (ABL:親密 * 20)
	ENDIF
	
	;好感度はみない
	
	SOURCE:CHARA:受動 = 200 + 100 * ABL:従順
	SOURCE:CHARA:征服 = 200 + 100 * ABL:施虐属性
	
	;调合成果をみる、调合难易度で设定
	IF 调合物
		SELECTCASE PHARMACY_RANK(调合物)
			CASE 1
				TIMES SOURCE:CHARA:歓楽 , 1.00
				TIMES SOURCE:CHARA:受動 , 1.00
				TIMES SOURCE:CHARA:征服 , 1.00
				SOURCE:CHARA:達成 = 80
			CASE 2
				TIMES SOURCE:CHARA:歓楽 , 1.25
				TIMES SOURCE:CHARA:受動 , 1.25
				TIMES SOURCE:CHARA:征服 , 1.15
				SOURCE:CHARA:達成 = 125
			CASE 3
				TIMES SOURCE:CHARA:歓楽 , 1.50
				TIMES SOURCE:CHARA:受動 , 1.50
				TIMES SOURCE:CHARA:征服 , 1.25
				SOURCE:CHARA:達成 = 150
			CASE 4
				TIMES SOURCE:CHARA:歓楽 , 1.75
				TIMES SOURCE:CHARA:受動 , 1.75
				TIMES SOURCE:CHARA:征服 , 1.50
				SOURCE:CHARA:達成 = 200
			CASE 5
				TIMES SOURCE:CHARA:歓楽 , 2.00
				TIMES SOURCE:CHARA:受動 , 2.00
				TIMES SOURCE:CHARA:征服 , 1.75
				SOURCE:CHARA:達成 = 300
			CASEELSE
				TIMES SOURCE:CHARA:歓楽 , 2.25
				TIMES SOURCE:CHARA:受動 , 2.25
				TIMES SOURCE:CHARA:征服 , 2.00
				SOURCE:CHARA:達成 = 350
		ENDSELECT
	;调合失败
	ELSE
		TIMES SOURCE:CHARA:歓楽 , 0.50
		TIMES SOURCE:CHARA:受動 , 0.50
		TIMES SOURCE:CHARA:征服 , 0.50
	ENDIF
ENDIF

;フラグ引き渡し
TFLAG:SELECTCOM的分岐 = 调合物

RETURN 1

