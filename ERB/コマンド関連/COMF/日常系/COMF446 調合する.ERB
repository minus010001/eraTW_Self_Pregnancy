;-----------------------------------------------------------
;レシピ列表用ボタン作成・改行
;ARGS:0レシピ名（文字列）、ARG:1レシピ番号、ARG:2道具番号
;PHARMACY函数で判定し素材が不足している场合、ボタンを无效(灰色)に
;-----------------------------------------------------------
@BUTTON_RECIPE(ARGS:0, ARG:1, ARG:2)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC R_ID
R_ID = ARG:2 * 10 + ARG:1
IF !CAN_PHARMA(R_ID)
	SETCOLOR 0x606060
	PRINTPLAINFORM [{ARG:1}] %ARGS:0%
	RESETCOLOR
ELSE
	PRINTBUTTON @"[{ARG:1}] %ARGS:0%", ARG:1
ENDIF
PRINTL 

;-----------------------------------------------------------
;レシピを文本化し表示する
;-----------------------------------------------------------
@TEXT_FOR_RECIPEBUTTON(R_ID)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC R_ID
#DIM DYNAMIC INGREDIENT
;qol, replaced
JUMP QOL_TEXT_FOR_RECIPEBUTTON(R_ID)


VARSET LOCALS
;单一素材复数使用レシピは×いくつ表记で省略する
IF RECIPE_DATA(R_ID, 8)
	LOCALS += ITEMNAME_TR(RECIPE_DATA(R_ID, 0))
	LOCALS += "("
	LOCALS += TOSTR(ITEM:RECIPE_DATA(R_ID, 0))
	LOCALS += ")×"
	LOCALS += TOSTR(RECIPE_DATA(R_ID, 8))
	LOCALS += " "
ELSE
	FOR LOCAL,0,6
		INGREDIENT = RECIPE_DATA(R_ID, LOCAL)
		SIF !INGREDIENT
			BREAK
		LOCALS += ITEMNAME_TR(INGREDIENT)
		LOCALS += "("
		LOCALS += TOSTR(ITEM:INGREDIENT)
		LOCALS += ")"
		LOCALS += " "
	NEXT
ENDIF
SIF RECIPE_DATA(R_ID, 7)
	LOCALS += "水"
LOCALS += "→（"
LOCALS += TOSTR(RECIPE_DATA(R_ID, 6))
LOCALS += "）"
CALL BUTTON_RECIPE(@"%LOCALS%", R_ID % 10, R_ID / 10)

;-----------------------------------------------------------
;アイテム番号ARG:0の調合レシピをボタン形式でリスト化し描画する
;STOPPPP
;-----------------------------------------------------------
@PHARMACY_RECIPELIST(ARG:0)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC R_ID
#DIM DYNAMIC CanCraft; new player guide custom code

FOR LOCAL,1,6
	R_ID = ARG:0 * 10 + LOCAL
	SIF RECIPE_DATA(R_ID) == -1
		BREAK
	; new player guide custom code
	SIF !CanCraft
	CALL CraftingDenyReason(R_ID, "", 1)
	IF !RESULT && !CanCraft
		GOTO BYPASS
	ELSE
		CanCraft = 1
	ENDIF
	;=============================
	CALL TEXT_FOR_RECIPEBUTTON(R_ID)
NEXT
; new player guide custom code
$BYPASS
PRINTL [0] 放弃

;-----------------------------------------------------------
;道具番号*10 + レシピ番号 = ARG:0をARG:1回作成した场合に
;既定量の素材道具を减少させ、消费数の文本を流す
;ARG:2が1のときは道具の减少はしない（消费予定の文本のみ流す）
;さらにARG:1が0のときは、必要素材の现所持数のみを文本表记
;ARG:2は未入力なら0
;COMMENT	道具やレシピを追加した场合は、RECIPE_DATAに追记
;-----------------------------------------------------------
@PHARMACY_CONSUME(ARG:0, ARG:1, ARG:2 = 0)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC CONSUMED_ITEM
#DIM DYNAMIC ING, 6
JUMP QOL_PHARMACY_CONSUME(ARG:0, ARG:1, ARG:2)

FOR LOCAL,0,6
	ING:LOCAL = RECIPE_DATA(ARG:0, LOCAL)
NEXT

;CALL QOL_PHARMACY_CONSUME_T(ARG:0, ARG:1) ;qol custom code
;单一素材复数利用型レシピの场合は表记を变える
;IF RECIPE_DATA(ARG:0, 8)
;	CALL PHARMACY_CONSUME_T_LOT(ING:0, ARG:1, RECIPE_DATA(ARG:0, 8))
;ELSE
;	CALL PHARMACY_CONSUME_T(ING:0, ARG:1, ING:1, ARG:1, ING:2, ARG:1, ING:3, ARG:1, ING:4, ARG:1, ING:5, ARG:1)
;ENDIF
;;单一素材复数利用の时になぜか素材の消耗がおかしくなるため修正
IF ARG:2 == 0
	IF RECIPE_DATA(ARG:0, 8)
		ITEM:(ING:0) -=  (ARG:1)*RECIPE_DATA(ARG:0, 8)
	ELSE
		FOR LOCAL,0,6
			CONSUMED_ITEM = ING:LOCAL
			SIF !CONSUMED_ITEM
				BREAK
			ITEM:CONSUMED_ITEM -= ARG:1
		NEXT
	ENDIF
ENDIF
;打水フラグを0にするのは、ARG:2が0の时（实际に调合が行われた时）のみ
IF RECIPE_DATA(ARG:0, 7) && ARG:2 == 0
	;TFLAG:水汲み = 0
	IF GETBIT(FLAG:プール, 2) ;addition custom code
		PRINTFORML +++直接从泳池取水。科学的力量真伟大。
	ELSE
		VAR_WATER =
	ENDIF
ENDIF
;-----------------------------------------------------------
;道具を调合したときの素材消费量を文章で表记する
;（素材は水を除いて６种が上限）
;ARG:0,2,4,6,8,10には素材の道具番号、
;ARG:1,3,5,7,9,11には必要素材个数を入力
;ARG;2以降は入力しなければスキップされる
;ARG:1が0の时は、素材の现所持量のみが表记される
;-----------------------------------------------------------
@PHARMACY_CONSUME_T(ARG:0, ARG:1, ARG:2 = 0, ARG:3 = 0, ARG:4 = 0, ARG:5 = 0, ARG:6 = 0, ARG:7 = 0, ARG:8 = 0, ARG:9 = 0, ARG:10 = 0, ARG:11 = 0)
#LOCALSIZE 1
#LOCALSSIZE 1

IF ARG:1 > 0
	PRINTFORM %ITEMNAME_TR(ARG:0)%({ITEM:(ARG:0)}→{ITEM:(ARG:0) - ARG:1})
	SIF ARG:2
		PRINTFORM 　%ITEMNAME_TR(ARG:2)%({ITEM:(ARG:2)}→{ITEM:(ARG:2) - ARG:3})
	SIF ARG:4
		PRINTFORM 　%ITEMNAME_TR(ARG:4)%({ITEM:(ARG:4)}→{ITEM:(ARG:4) - ARG:5})
	SIF ARG:6
		PRINTFORM 　%ITEMNAME_TR(ARG:6)%({ITEM:(ARG:6)}→{ITEM:(ARG:6) - ARG:7})
	SIF ARG:8
		PRINTFORM 　%ITEMNAME_TR(ARG:8)%({ITEM:(ARG:8)}→{ITEM:(ARG:8) - ARG:9})
	SIF ARG:10
		PRINTFORM 　%ITEMNAME_TR(ARG:10)%({ITEM:(ARG:10)}→{ITEM:(ARG:10) - ARG:11})
ELSE
	PRINTFORM %ITEMNAME_TR(ARG:0)%({ITEM:(ARG:0)})
	SIF ARG:2
		PRINTFORM 　%ITEMNAME_TR(ARG:2)%({ITEM:(ARG:2)})
	SIF ARG:4
		PRINTFORM 　%ITEMNAME_TR(ARG:4)%({ITEM:(ARG:4)})
	SIF ARG:6
		PRINTFORM 　%ITEMNAME_TR(ARG:6)%({ITEM:(ARG:6)})
	SIF ARG:8
		PRINTFORM 　%ITEMNAME_TR(ARG:8)%({ITEM:(ARG:8)})
	SIF ARG:10
		PRINTFORM 　%ITEMNAME_TR(ARG:10)%({ITEM:(ARG:10)})
ENDIF
PRINTL 
;-----------------------------------------------------------
;道具を调合したときの素材消费量を文章で表记する
;同一素材复数必要利用型レシピの表记
;ARG:0に必要素材道具番号、ARG:1に必要素材个数を入力
;ARG:2にはRECIPE_DATA(ARG:0, 8)のLOT数を入力する
;现状のレシピでは１种の素材のみを复数个用意すればいいので、とりあえず简略化
;ARG:1が0の时は、素材の现所持量のみが表记される
;-----------------------------------------------------------
@PHARMACY_CONSUME_T_LOT(ARG:0, ARG:1, ARG:2)
#LOCALSIZE 1
#LOCALSSIZE 1

IF ARG:1 > 0
	PRINTFORM %ITEMNAME_TR(ARG:0)%({ITEM:(ARG:0)}→{ITEM:(ARG:0) - (ARG:1 * ARG:2)})
ELSE
	PRINTFORM %ITEMNAME_TR(ARG:0)%({ITEM:(ARG:0)})
ENDIF
PRINTL 
;-----------------------------------------------------------
;ARG:0番の道具の调合にかかる时间を算出する函数
;ARG:1に调合件数を入力、件数が多ければ补正をかける
;-----------------------------------------------------------
@PHARMACY_TIME(ARG:0, ARG:1)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTION

SELECTCASE PHARMACY_RANK(ARG:0)
	CASE 1
		LOCAL:0 = 30
	CASE 2
		LOCAL:0 = 40
	CASE 3
		LOCAL:0 = 50
	CASE 4
		LOCAL:0 = 65
	CASE 5
		LOCAL:0 = 80
ENDSELECT
;自室かつ机椅子があると时间短缩
IF CFLAG:MASTER:現在位置 == CFLAG:MASTER:初期位置 && ITEM:榉木桌椅
	SELECTCASE ITEM:榉木桌椅
		CASE 1
			TIMES LOCAL:0, 0.90
		CASE 2
			TIMES LOCAL:0, 0.85
		CASE 3
			TIMES LOCAL:0, 0.80
	ENDSELECT
ENDIF
;√调合件数をかける
SELECTCASE ARG:1
	CASE 1
		TIMES LOCAL:0, 1
	CASE 2
		TIMES LOCAL:0, 1.4
	CASE 3
		TIMES LOCAL:0, 1.7
	CASE 4
		TIMES LOCAL:0, 2
	CASE 5
		TIMES LOCAL:0, 2.2
	CASE 6
		TIMES LOCAL:0, 2.4
	CASE 7
		TIMES LOCAL:0, 2.6
	CASE 8
		TIMES LOCAL:0, 2.8
	CASE 9
		TIMES LOCAL:0, 3
	CASE 10
		TIMES LOCAL:0, 3.1
ENDSELECT
RETURNF LOCAL:0

;-----------------------------------------------------------
;ARG:0番の道具の调合で得られる経験值を算出する函数
;ARG:1に调合件数、ARG:2に调合结果を入力
;-----------------------------------------------------------
@PHARMACY_EXP(ARG:0, ARG:1, ARG:2)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTION
;成功时
IF ARG:2
	SELECTCASE PHARMACY_RANK(ARG:0)
		CASE 1
			LOCAL:0 = 1
		CASE 2
			LOCAL:0 = 1
		CASE 3
			LOCAL:0 = 2
		CASE 4
			LOCAL:0 = 2
		CASE 5
			LOCAL:0 = 3
	ENDSELECT
ELSE
;失败时
	SELECTCASE PHARMACY_RANK(ARG:0)
		CASE 1
			LOCAL:0 = 2
		CASE 2
			LOCAL:0 = 2
		CASE 3
			LOCAL:0 = 3
		CASE 4
			LOCAL:0 = 5
		CASE 5
			LOCAL:0 = 10
	ENDSELECT
ENDIF
;调合件数をかける
RETURNF (LOCAL:0 * ARG:1)

