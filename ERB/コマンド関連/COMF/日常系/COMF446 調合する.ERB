;进行调合
@COM_ABLE446
#LOCALSIZE 1
#LOCALSSIZE 1
SIF !TFLAG:100
	RETURN 0
;批量管理
SIF GLOBAL_COMABLE(446)
	RETURN RESULT
;调合できる场所でない
SIF !PHARMACY_SPOT(CFLAG:MASTER:現在位置)
	RETURN 0
;调合用品一式を持っておらず、特殊调合スポットでない
SIF ITEM:(29) == 0 && PHARMACY_SPOT(CFLAG:MASTER:現在位置) == 1
	RETURN 0
;睡眠中
SIF CFLAG:MASTER:睡眠
	RETURN 0
SIF CFLAG:诶嘿嘿
	RETURN 0
;气力０
SIF BASE:MASTER:気力 <= 0
	RETURN 0
;时间停止中
SIF FLAG:70
	RETURN 0
RETURN 1

;-----------------------------------------------------------
;调合可能スポットかどうかを判定する函数
;ARG		现在位置
;RETURN		0 不可	1 可	2 调合セットなくても可（特殊调合ｽﾎﾟｯﾄ）
;COMMENT	基本は初期位置、それっぽい场所があるときはそちらも。
;			场所を追加した场合、CASEを变更の事
;-----------------------------------------------------------
@PHARMACY_SPOT(ARG)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTION
#DIM DYNAMIC MAP_ID

SIF IS_GAP_GUEST(MASTER)
	RETURNF 1
SIF ARG == CFLAG:MASTER:初期位置
	RETURNF 1
;特殊调合スポット、メインMapでの判定
MAP_ID = GET_CURRENT_MAP()
SELECTCASE MAP_ID
	CASE 0
		;博灵神社：无限遗迹・研究室
		SIF GROUPMATCH(ARG, 49)
			RETURNF 2
	CASE 1
		;命莲寺：调药室
		SIF GROUPMATCH(ARG, 132)
			RETURNF 2
	CASE 4
		;永远亭：配药室
		SIF GROUPMATCH(ARG, 405)
			RETURNF 2
	CASE 5
		;魔法之森：魔理沙宅・研究房间、人偶洋馆・研究室
		SIF GROUPMATCH(ARG, 513, 524)
			RETURNF 2
	CASE 6
		;冥界：袿姬的房间
		SIF GROUPMATCH(ARG, 644)
			RETURNF 2
	CASE 7
		;妖怪之山山麓：河童的宣传站
		SIF GROUPMATCH(ARG, 704)
			RETURNF 2
	CASE 8
		;妖怪之山山顶：工作间
		SIF GROUPMATCH(ARG, P871工作间)
			RETURNF 2
	CASE 11
		;魔界：朝仓工作间的总实验室
		SIF GROUPMATCH(ARG, 1134)
			RETURNF 2
ENDSELECT

RETURNF 0


