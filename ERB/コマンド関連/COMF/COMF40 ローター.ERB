;-------------------------------------------------
;跳蛋
;道具使用指令、レベル1
;-------------------------------------------------
@COM40
;-------------------------------------------------
;特殊派生処理
;-------------------------------------------------
STR:0 = 跳蛋
;-------------------------------------------------
;COM別FLAGの設定
;-------------------------------------------------
;行為者
TCVAR:116 = PLAYER
;奉仕快楽フラグ
TCVAR:PLAYER:108 = 1

;TARGETが扶她の場合には射精可能に
CALL DECLARE_EJACULATION(TARGET, 射精場合_道具, 射精箇所_道具, PLAYER, CHARA_NONE, PLAYER, CHARA_NONE, 1000)
;強度

;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
IF (FLAG:70 == 1 && CFLAG:TARGET:344 == 0)
	BASE:MASTER:TSP -= 80
	SOURCE:快Ｃ = 250

ELSE

	DOWNBASE:体力 += 10
	DOWNBASE:気力 += 80

	SOURCE:快Ｃ = 250
	SOURCE:露出 = 20
	SOURCE:逸脱 = 30
	SOURCE:反感 = 30
	;-------------------------------------------------
	;特殊ソース処理
	;-------------------------------------------------
	;圧抑、抵抗持ちには、抑鬱ソース追加
	SIF TALENT:自己愛 < 0 || TALENT:抵抗
		SOURCE:鬱屈 += 30
ENDIF
;-------------------------------------------------
;経験の処理
;-------------------------------------------------
;同性愛　レズなら戻り値1ゲイなら戻り値2
IF (FLAG:70 == 1 && CFLAG:TARGET:344 == 0)
	IF HETEROSEX(TARGET,PLAYER)
		EXP:PLAYER:(50 + HETEROSEX(TARGET,PLAYER)) += 1
	ENDIF
ELSE
	IF HETEROSEX(TARGET,PLAYER)
		EXP:(50 + HETEROSEX(TARGET,PLAYER)) += 1
		EXP:PLAYER:(50 + HETEROSEX(TARGET,PLAYER)) += 1
	ENDIF
ENDIF
EXP:PLAYER:道具使用経験 ++
RETURN 1

;-------------------------------------------------
;実行判定
;-------------------------------------------------
@COM_ABLE40
#LOCALSIZE 1
#LOCALSSIZE 1
;跳蛋実行判定
SIF !TFLAG:100
	RETURN 0
;一括管理
SIF GLOBAL_COMABLE(40)
	RETURN RESULT
;道具を持っているか、道具無設定でないとダメ
SIF ITEM:0 == 0 && NOITEM == 0
	RETURN 0

;下半身着衣
SIF TEQUIP:0 & 8
	RETURN 0
RETURN 1


@COM40_TOUCH(ARG)
#LOCALSIZE 1
#LOCALSSIZE 1

CALL TOUCH_RESET_M(SET_YUBI)
TEQUIP:ARG:Ｃ接触部位 = 0
TEQUIP:ARG:Ｐ接触部位 = 0
