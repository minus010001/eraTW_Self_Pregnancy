;-------------------------------------------------
;喝套内精液
;道具使用指令、レベル2
;-------------------------------------------------
@COM89
;-------------------------------------------------
;COM別FLAGの設定
;-------------------------------------------------
;行為者
TCVAR:116 = PLAYER
;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
SELECTCASE TCVAR:PLAYER:套套内
	CASE IS > 300
		EXP:精液経験 += 8
	CASE IS > 150
		EXP:精液経験 += 5
	CASEELSE
		EXP:精液経験 += 3
ENDSELECT
STAIN:口 |= 4
IF FLAG:時間停止 == 1
	CFLAG:口内精液 = 2
ELSE
	CFLAG:口内精液 = 1
ENDIF
CFLAG:累計精飲 += TCVAR:PLAYER:套套内
TFLAG:193 = TCVAR:PLAYER:套套内

;消費体力、気力
IF (FLAG:70 == 1 && CFLAG:TARGET:344 == 0)
	BASE:MASTER:TSP -= 50
ELSE

	DOWNBASE:気力 += 100

	SOURCE:情愛 = TCVAR:PLAYER:套套内 / 2
	SOURCE:性行動 = TCVAR:PLAYER:套套内 / 2
	SOURCE:達成 = TCVAR:PLAYER:套套内 / 2
	SOURCE:屈従 = TCVAR:PLAYER:套套内 * 2
	SOURCE:不潔 = TCVAR:PLAYER:套套内 * 2
	SOURCE:反感 = TCVAR:PLAYER:套套内

;-------------------------------------------------
;特殊ソース処理
;-------------------------------------------------
;圧抑、抵抗持ちには、抑鬱ソース追加
	SIF TALENT:自己愛 < 0 || TALENT:抵抗
		SOURCE:鬱屈 += 400
ENDIF
;专门设计了一个隔空吸掉套套内精液，但套套仍然戴着的流程函数，纯属搞笑
;CALL CONDOM_CLEAR(PLAYER)
CALL CONDOM_REMOVE(PLAYER)
RETURN 1

;-------------------------------------------------
;実行判定
;-------------------------------------------------
;喝套内精液
@COM_ABLE89
#LOCALSIZE 1
#LOCALSSIZE 1
;実行判定
SIF !TFLAG:100
	RETURN 0
;一括管理
SIF GLOBAL_COMABLE(89)
	RETURN RESULT
SIF !TCVAR:PLAYER:套套内
	RETURN 0
;口球使用中は不可
SIF TEQUIP:口球
	RETURN 0
SIF ABL:精液中毒 < 3 && (!FLAG:70 || CFLAG:TARGET:344 == 1)
	RETURN 0
RETURN 1

@COM89_TAGS
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTION
LOCAL = 0
SETBIT LOCAL, BIT_USED_CONDOM_ALLOWED
SETBIT LOCAL, BIT_乳首吸い解除
SETBIT LOCAL, BIT_オート喘ぎ禁止
RETURNF LOCAL