;存否関数
;F関数はTRYCALL系が使えないので通常関数で存否配列を作っちゃう
@EXIST_一般依頼2
#LOCALSIZE 1
#LOCALSSIZE 1

;オブジェクト本体
@F一般依頼2(ARG, O_DATA, V_NAME)
#FUNCTIONS
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE OPR_委托名
	RETURNF "给花浇水"
CASE OPR_委托内容表示
	RETURNF @"为%CALLNAME:ARG%自宅的草木浇水"
CASE OPR_委托报酬表示
	RETURNF @"%金額表示(500)%"
CASE OPR_委托报告不要
	RETURNF "无需报告（但报告了才能领取报酬）"
CASE OPR_委托实行指令名
	RETURNF "浇水"

CASE OPR_委托内容
	RETURNF @"{MAKE_IRAI_DATA(GET_CHARAHOME(ARG), OPR_传令场所)}"
CASE OPR_委托子项
CASE OPR_委托期限
;発生時ではなく受託時に確定します
CASE OPR_委托发生率
;これは他の一般依頼との相対確率なんで15％ではありません
	RETURNF @"{15}"
CASE OPR_委托发生条件
;自宅が你と同一Mapの角色のみ
	SIF MAIN_MAP == GET_MAPID(GET_CHARAHOME(ARG)) && MAP_CAN_MOVE(GET_CHARAHOME(ARG), MASTER) && ABL:ARG:親密 >= 2 && !(ROOMDATA:(GET_CHARAHOME(ARG) % 100) & 場所_花园禁用)
		RETURNF @"{1}"
CASE OPR_委托受託可能条件
;その依頼者の自宅にいるとき
	SIF MAIN_MAP == GET_MAPID(GET_CHARAHOME(ARG)) && MAP_CAN_MOVE(GET_CHARAHOME(ARG), MASTER)
		RETURNF @"{1}"
CASE OPR_委托实行可能条件
		RETURNF @"{1}"
;成功/失敗処理はCARRYOUTで直接書く
;SOURCEやITEM入手、消費が煩雑になるので
CASE OPR_委托消灭条件
	SIF RAND:100 < 30
		RETURNF @"{1}"
ENDSELECT



@IRAI_一般2(CHARA, IRAI_ID, SCENE)
#DIM  CHARA
#DIM  IRAI_ID
#DIMS SCENE
#DIM  CLIENT_ID
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
SELECTCASE SCENE
CASE OPR_委托条件表示
;何か専用の表示情報を設けたい時用
;受託済みの依頼表示で使用されます
;
;PRINT系だけでSOURCEとかは入れちゃダメ、WAITも無しで
;ここ以外の表示項目は
;PRINTFORML 　　　　　：
;となっているのでスペースを揃えたほうが見栄えが良いです

CASE OPR_委托实行时
;このCASEに限り、RESULTが意味を持ちます
;依頼実行時のRESULTにはIRAI_CONST_RESULT()を使用してください
;可能な引数は"中止", "実行して成功", "実行して失敗", "実行して未解決"です
;独自処理を仕込みたい時は"実行して未解決"で先延ばしするなりしてください
	PRINTFORMW %CALLNAME:MASTER%给%CALLNAME:CLIENT_ID%家里的盆栽和植物浇了水
	PRINTFORML 
	RETURN IRAI_CONST_RESULT("実行して成功")
CASE OPR_委托成功时
;成功報告時の報酬など
	CALL CHANGE_CFLAG(2, TARGET, 20)
	CALL CHANGE_CFLAG(4, TARGET, 15)
	CALL GET_MONEY_YEN(500, 2)
CASE OPR_委托失败时
;失敗報告時の処理
	CALL CHANGE_CFLAG(2, TARGET, -10)
	CALL CHANGE_CFLAG(4, TARGET, -5)
ENDSELECT
