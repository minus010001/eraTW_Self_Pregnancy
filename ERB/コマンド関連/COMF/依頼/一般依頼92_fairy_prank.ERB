;添加新场景的基本步骤：
;1. 在 @IRAI_一般92_Select_Target 的 VICTIM_WEIGHTS 数组中添加目标角色（如果还没添加过）
;2. 在 @IRAI_一般92_Select_Scenario 中添加场景ID和相应条件
;3. 在 Add_一般依頼92_fairy_prank_scenarios.ERB 中添加 @PRANK_SCENARIO_[场景ID](STATE) 函数（参考 @PRANK_SCENARIO_clownpiece_madness）
;   - "prank" 和 "failure" 状态是必须的，每个场景都应添加
;   - "success" 和 "punishment" 是可选的。适当时可添加特定对话
;   - 如果没有设置 "success" 和 "punishment" 状态，该角色的对话应添加到 @IRAI_一般92_Success_Message 和 @IRAI_一般92_Punishment_Message（如果还没有的话）
;   - 这些函数允许对话在多个场景中复用

;存否関数
;F関数はTRYCALL系が使えないので通常関数で存否配列を作っちゃう
@EXIST_一般依頼92
#LOCALSIZE 1
#LOCALSSIZE 1

;オブジェクト本体
;ここでARGで渡されるのはCLIENT_IDです
@F一般依頼92(ARG, O_DATA, V_NAME)
#FUNCTIONS
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE OPR_委托名
	RETURNF "赌上性命的恶作剧"
CASE OPR_委托内容表示
	IF CFLAG:ARG:依頼状況 > 1
		RETURNF @"对%CALLNAME:IRAI_SLOT_TO_PERSON(SEARCH_IRAI_SLOT(CFLAG:ARG:依頼内容))%搞个大恶作剧"
	ELSE
		RETURNF @"去别人家里搞个大恶作剧"
	ENDIF
CASE OPR_委托报酬表示
	RETURNF @"随机技能的经验"
CASE OPR_委托实行指令名
	RETURNF @"开始恶作剧：%CALLNAME:IRAI_SLOT_TO_PERSON(SEARCH_IRAI_SLOT(CFLAG:ARG:依頼内容))%"
CASE OPR_委托内容
	RETURNF @"{MAKE_IRAI_DATA(IRAI_一般92_Select_Target(ARG), OPR_恶作剧)}"
CASE OPR_委托子项
	RETURNF @"{0}"
CASE OPR_委托期限
	RETURNF @"{10}"
CASE OPR_委托发生率
	RETURNF @"{30}"
CASE OPR_委托发生条件
	IF nRequestDisable:req_Pranks
	ELSE
		SIF TALENT:ARG:妖精
			RETURNF @"{1}"
	ENDIF
CASE OPR_委托受託可能条件
	RETURNF @"{1}"
CASE OPR_委托实行可能条件
	SIF !FLAG:70
		RETURNF @"{1}"
CASE OPR_委托消灭条件
	SIF nRequestDisable:req_Pranks
		RETURNF @"{1}"
ENDSELECT

@IRAI_一般92(CHARA, IRAI_ID, SCENE)
#DIM  CHARA
#DIM  IRAI_ID
#DIMS SCENE
#DIM  CLIENT_ID
#DIM  TARGET_ID
#DIM  PRANK_RESULT
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
TARGET_ID = IRAI_SLOT_TO_PERSON(SEARCH_IRAI_SLOT(IRAI_ID))
SELECTCASE SCENE
CASE OPR_委托条件表示
CASE OPR_委托实行时
	IF Add_Fairy_Prank_Evil_Shenanigans == -1
		PRINTFORML 是否启用稍微恶劣一点的恶作剧？
		PRINTFORML 包含适当的严厉惩罚！
		PRINTFORML 之后可以在主菜单的[160]委托设置中更改。

		CALL ASK_YN("只要不造成永久伤害就行", "不要")
		SELECTCASE RESULT
			CASE 0
				PRINTFORMW 毕竟这里的人彼此之间都挺混蛋的。
				Add_Fairy_Prank_Evil_Shenanigans = 1
			CASE 1
				IF EXP:MASTER:時姦経験 > 0
					PRINTFORMW 在这个时停强奸游戏里一切都应该是轻松愉快的。
				ELSE
					PRINTFORMW 恶作剧已设置为仅限温和类型。
				ENDIF
				Add_Fairy_Prank_Evil_Shenanigans = 0
		ENDSELECT
		PRINTW
	ENDIF

	DEBUGPRINTFORML IRAI_ID = {IRAI_ID}|CLIENT_ID = {CLIENT_ID} (%CALLNAME:CLIENT_ID%)| TARGET_ID = {TARGET_ID} (%CALLNAME:TARGET_ID%)
	Add_CULPRIT = CLIENT_ID
	Add_VICTIM = TARGET_ID
	VARSET Add_ACCOMPLICES
	Add_ACCOMPLICECOUNT = 0

	IF STRLENS(Add_Fairy_Prank_Debug_Scenario)
		SIF Add_SCENARIO == "kojo"
			CALL KOJO_MESSAGE_SEND("EVENT", 0, Add_VICTIM, 0, 0, "FAIRY_PRANK", "scenarios")
		Add_SCENARIO '= Add_Fairy_Prank_Debug_Scenario
	ELSE
		CALL KOJO_MESSAGE_SEND("EVENT", 0, Add_VICTIM, 0, 0, "FAIRY_PRANK", "scenarios")
		Add_SCENARIO '= IRAI_一般92_Select_Scenario(RESULT)
	ENDIF

	CALL IRAI_一般92_Find_Accomplices
	PRANK_RESULT = IRAI_一般92_Determine_Success()
	DEBUGPRINTFORML Prank scenario: '%Add_SCENARIO%' Result: {PRANK_RESULT}
	TIME += 25
	Add_Temp_Fairy_Prank_Resolution = -1
	SELECTCASE PRANK_RESULT
		CASE -1
			TRYCALLFORM PRANK_SCENARIO_%Add_SCENARIO%("failure")
			SIF !RESULT
				PRINTFORMW 错误：场景 %Add_SCENARIO% 的恶作剧失败未实现。
			Add_Temp_Fairy_Prank_Resolution = 1
			RETURN IRAI_CONST_RESULT("実行して失敗")
		CASE 0
			TRYCALLFORM PRANK_SCENARIO_%Add_SCENARIO%("prank")
			SIF !RESULT
				PRINTFORMW 错误：场景 %Add_SCENARIO% 的恶作剧未实现。
			PRINTW
			PRINTFORML 不幸的是，%CALLNAME:TARGET_ID%在你逃跑时抓住了你。
			IF CLIENT_ID == 6 && !RAND:3 ;露娜非常笨拙
				PRINTFORML 当你试图逃跑时，你看到%CALLNAME:CLIENT_ID%被%SPLIT_G(@"一根树枝:一块石头:%HE_SHE_CN(CLIENT_ID)%自己的脚:空气")%绊倒摔在了地上。
				PRINTFORML 你要回去帮%HE_SHE_CN(CLIENT_ID)%站起来吗？
				CALL ASK_YN
				SELECTCASE RESULT
					CASE 0
						IF RAND:40 < ((ABL:MASTER:戦闘能力+TALENT:MASTER:伐採Lv+TALENT:MASTER:釣りLv+TALENT:MASTER:採集Lv+TALENT:MASTER:調合Lv)/2)
							PRINTFORML 凭借你惊人的才能，你成功扶起%CALLNAME:CLIENT_ID%并在%CALLNAME:TARGET_ID%追上来之前逃走了。
							PRINTFORML 这就是你是最棒的原因。
							CALL CHANGE_CFLAG(2, CLIENT_ID, 100)
							CALL CHANGE_CFLAG(4, CLIENT_ID, 100)
							Add_Temp_Fairy_Prank_Resolution = 4
							Add_Fairy_Prank_Success++ ;额外加一分
							RETURN IRAI_CONST_RESULT("実行して成功")
						ELSE
							PRINTFORML %CALLNAME:CLIENT_ID%多亏了你的帮助成功逃走了，但不幸的是你失去了自己逃跑的机会。
							CALL CHANGE_CFLAG(2, CLIENT_ID, 100)
							CALL CHANGE_CFLAG(4, CLIENT_ID, 100)
							Add_Temp_Fairy_Prank_Resolution = 5
						ENDIF
					CASE 1
						PRINTFORML 人人为自己（妖精也不例外），你把%CALLNAME:CLIENT_ID%留给%HE_SHE_CN(CLIENT_ID)%悲惨的命运处置，自己逃走了。
						CALL CHANGE_CFLAG(2, CLIENT_ID, -5) ;她因为被丢下有点不高兴，但还没到觉得被背叛的程度
						CALL CHANGE_CFLAG(4, CLIENT_ID, -2)
						Add_Temp_Fairy_Prank_Resolution = 6
						RETURN IRAI_CONST_RESULT("実行して成功")
				ENDSELECT
			ELSEIF ABL:MASTER:戦闘能力 > ABL:CLIENT_ID:戦闘能力
				PRINTFORML 要把%CALLNAME:CLIENT_ID%推出去当挡箭牌吗？
				CALL ASK_YN
				SELECTCASE RESULT
				CASE 0 ;希望你喜欢你的三十枚银币
					IF RAND:(ABL:MASTER:戦闘能力 - ABL:CLIENT_ID:戦闘能力 + 1)
						PRINTFORML 认为自己的命比%HE_SHE_CN(CLIENT_ID)%更重要的你，用力推了%CALLNAME:CLIENT_ID%一把，让%HE_SHE_CN(CLIENT_ID)%摔倒在地，为自己争取了逃跑的机会。
						PRINTFORML %HE_SHE_CN(CLIENT_ID, 1)%听起来相当生气，但你认为这是为了更伟大的善而必要的牺牲。
						CALL CHANGE_CFLAG(2, CLIENT_ID, -500)
						CALL CHANGE_CFLAG(4, CLIENT_ID, -200)
						Add_Temp_Fairy_Prank_Resolution = 7
					ELSE
						PRINTFORML %CALLNAME:CLIENT_ID%看穿了你把%HE_SHE_CN(CLIENT_ID)%推出去当替罪羊的企图，反而绊倒了你，让%HE_SHE_CN(CLIENT_ID)%自己逃走了。
						PRINTFORML 你现在无路可逃了。
						CALL CHANGE_CFLAG(2, CLIENT_ID, -200)
						CALL CHANGE_CFLAG(4, CLIENT_ID, -100)
						Add_Temp_Fairy_Prank_Resolution = 8
						TRYCALLFORM PRANK_SCENARIO_%Add_SCENARIO%("punishment")
						SIF !RESULT
							CALL IRAI_一般92_Punishment_Message
					ENDIF
					Add_Fairy_Prank_Betrayal++
					RETURN IRAI_CONST_RESULT("実行して失敗")
				CASE 1
					IF RAND:30 < ((ABL:MASTER:戦闘能力+TALENT:MASTER:伐採Lv+TALENT:MASTER:釣りLv+TALENT:MASTER:採集Lv+TALENT:MASTER:調合Lv)/2)
						PRINTFORML 用你多种技能的创意方式，你在%CALLNAME:TARGET_ID%追上来之前成功逃走了。
						PRINTFORML 你可以把这看作一次完美执行的行动。
						CALL CHANGE_CFLAG(2, TARGET_ID, -20)
						CALL CHANGE_CFLAG(4, TARGET_ID, -10)
						Add_Temp_Fairy_Prank_Resolution = 2
						RETURN IRAI_CONST_RESULT("実行して成功")
					ENDIF
				ENDSELECT
			ENDIF
			SIF Add_Temp_Fairy_Prank_Resolution == -1 ;only set here if not set during escape
				Add_Temp_Fairy_Prank_Resolution = 3

			TRYCALLFORM PRANK_SCENARIO_%Add_SCENARIO%("punishment")
			SIF !RESULT
				CALL IRAI_一般92_Punishment_Message
		CASE 1
			TRYCALLFORM PRANK_SCENARIO_%Add_SCENARIO%("prank")
			SIF !RESULT
				PRINTFORMW 错误：场景 %Add_SCENARIO% 的恶作剧未实现。
			PRINTW
			TRYCALLFORM PRANK_SCENARIO_%Add_SCENARIO%("success")
			SIF !RESULT
				CALL IRAI_一般92_Success_Message
			PRINTW
			Add_Temp_Fairy_Prank_Resolution = 0
			TIME += 30
		CASEELSE
			PRINTFORMW 无效的恶作剧结果。请报告。({PRANK_RESULT})
	ENDSELECT
	RETURN IRAI_CONST_RESULT("実行して成功")
CASE OPR_委托成功时
	SIF !RAND:2
		EXP:MASTER:会話経験 += 5
	SIF !RAND:2
		EXP:MASTER:学習経験 += 5
	SIF !RAND:2
		EXP:MASTER:料理経験 += 5
	SIF !RAND:2
		EXP:MASTER:調合経験 += 5
	SOURCE:恭順 = 1500
	SOURCE:歓楽 = 1000
	CALL CHANGE_CFLAG(2, CLIENT_ID, 25)
	CALL CHANGE_CFLAG(4, CLIENT_ID, 20)
	CALL KIGEN_CHANGE(CLIENT_ID, 100, 2)
	Add_Fairy_Prank_Success++

	SELECTCASE Add_Temp_Fairy_Prank_Resolution
		CASE 0
			PRINTFORM %CALLNAME:CLIENT_ID%
		CASE 2
			PRINTFORML %CALLNAME:CLIENT_ID%似乎很高兴你们两个都成功逃走了。
			PRINTFORM %HE_SHE_CN(CLIENT_ID, 1)%
		CASE 3
			PRINTFORML %CALLNAME:CLIENT_ID%问你是否没事，因为%HE_SHE_CN(CLIENT_ID)%在逃跑时和你走散了。
			PRINTFORM %HE_SHE_CN(CLIENT_ID, 1)%
		CASE 4
			PRINTFORML %CALLNAME:CLIENT_ID%似乎非常感激你救了%HE_SHE_CN(CLIENT_ID)%。
			PRINTFORM %HE_SHE_CN(CLIENT_ID, 1)%
		CASE 5
			PRINTFORML %CALLNAME:CLIENT_ID%似乎非常感激你救了%HE_SHE_CN(CLIENT_ID)%，但也因为把你留下而感到非常内疚。
			PRINTFORM %HE_SHE_CN(CLIENT_ID, 1)%
		CASE 6
			PRINTFORML %CALLNAME:CLIENT_ID%看起来因为被丢下而相当不高兴，但似乎并没有因此怪你。
			PRINTFORM 不管发生了什么，%HE_SHE_CN(CLIENT_ID)%
	ENDSELECT

	PRINTFORM 告诉你%HE_SHE_CN(CLIENT_ID)%有多高兴能和你一起搞这个恶作剧，并且
	IF (TALENT:CLIENT_ID:恋慕 || TALENT:CLIENT_ID:思慕) && CFLAG:CLIENT_ID:溜まってる度 < 500
		PRINTFORMW 在你的脸颊上轻轻亲了一下。
	ELSEIF (CFLAG:CLIENT_ID:既成事実 & 合意_うふふ) && CFLAG:CLIENT_ID:溜まってる度 >= 500
		PRINTFORMW 满脸通红地问你是否想要另一种奖励。
		BASE:CLIENT_ID:ムード += 600
		CFLAG:CLIENT_ID:溜まってる度  += 300
		PALAM:CLIENT_ID:欲情 += 5000
	ELSE
		PRINTFORMW %SPLIT_G(@"和你击了个掌:为你鼓了鼓掌:向你行了个屈膝礼")%。
	ENDIF
	CALL IRAI_一般92_Title_Progress
CASE OPR_委托失败时
	CALL CHANGE_CFLAG(2, CLIENT_ID, -10)
	CALL CHANGE_CFLAG(4, CLIENT_ID, -5)
	CALL KIGEN_CHANGE(CLIENT_ID, 100, -1)
	SELECTCASE Add_Temp_Fairy_Prank_Resolution
		CASE 1
			PRINTFORMW %CALLNAME:CLIENT_ID%对恶作剧的失败感到失望，并因此责怪了你。
		CASE 7
			PRINTFORMW 看来%CALLNAME:CLIENT_ID%对你背后捅刀子的行为非常愤怒。
		CASE 8
			PRINTFORMW 尽管%HE_SHE_CN(CLIENT_ID)%占了上风，但%CALLNAME:CLIENT_ID%似乎对你企图背叛的行为仍然非常愤怒。
	ENDSELECT

	CALL IRAI_一般92_Title_Progress
ENDSELECT

@IRAI_一般92_Select_Target(CULPRIT)
#FUNCTION
#DIM CULPRIT
#DIM VICTIM_WEIGHTS, キャラクタ数上限 ;potential targets and their weights

;set up defaults
VICTIM_WEIGHTS:1 = 1
VICTIM_WEIGHTS:15 = 1
VICTIM_WEIGHTS:17 = 1
VICTIM_WEIGHTS:26 = 1
VICTIM_WEIGHTS:30 = 1
VICTIM_WEIGHTS:60 = 1
VICTIM_WEIGHTS:64 = 1
VICTIM_WEIGHTS:68 = 1
VICTIM_WEIGHTS:71 = 1
VICTIM_WEIGHTS:72 = 1
VICTIM_WEIGHTS:80 = 2
VICTIM_WEIGHTS:99 = 1

CALLF IRAI_一般92_Adjust_Weights_Per_Culprit(CULPRIT, VICTIM_WEIGHTS)

;remove inaccessible characters from the list
FOR LOCAL, 1, CHARANUM - 1
	SIF CFLAG:LOCAL:出禁
		VICTIM_WEIGHTS:LOCAL = 0
	SIF VICTIM_WEIGHTS:LOCAL < 0 ;should never happen, but would fuck with ARRAY_HIT if it occurs
		THROW Victim weight for {LOCAL} is a negative value ({VICTIM_WEIGHTS:LOCAL})
NEXT

LOCAL = ARRAY_HIT(VICTIM_WEIGHTS, CHARANUM - 1)
IF LOCAL < 0
	PRINTFORML 警告：没有可用的有效目标。
	PRINTFORML 默认选择%CALLNAME:1%。
	;not ideal, but shouldn't cause issues
	RETURNF 1
ENDIF
RETURNF LOCAL

@IRAI_一般92_Adjust_Weights_Per_Culprit(CULPRIT, VICTIM_WEIGHTS)
#FUNCTION
#DIM CULPRIT
#DIM REF VICTIM_WEIGHTS

;mostly targets close to their home get higher weights
SELECTCASE CULPRIT
	CASE 5
		VICTIM_WEIGHTS:1 = 3
		VICTIM_WEIGHTS:17 = 2
	CASE 6
		VICTIM_WEIGHTS:1 = 3
		VICTIM_WEIGHTS:17 = 2
	CASE 7
		VICTIM_WEIGHTS:1 = 3
		VICTIM_WEIGHTS:17 = 2
	CASE 13 ;no adjustments
	CASE 14
		VICTIM_WEIGHTS:15 = 3
	CASE 18 ;no adjustments
	CASE 19 ;no adjustments
	CASE 111
		VICTIM_WEIGHTS:99 = 5
	CASE 118
		VICTIM_WEIGHTS:68 = 0 ;doesn't start shit at home
ENDSELECT

@IRAI_一般92_Select_Scenario(CUSTOM_COUNT)
#FUNCTIONS
#DIM CUSTOM_COUNT
#DIMS VALID_SCENARIOS, 20 ;increase if needed
#DIM SCENARIO_INDEX

SCENARIO_INDEX = 0

SELECTCASE Add_CULPRIT
	CASE 5
		VALID_SCENARIOS:(SCENARIO_INDEX++) = sunny_light_bending
	CASE 14
		VALID_SCENARIOS:(SCENARIO_INDEX++) = cirno_freezing
	CASE 111
		VALID_SCENARIOS:(SCENARIO_INDEX++) = clownpiece_madness
ENDSELECT

SIF OUTROOF(CFLAG:MASTER:現在位置)
	VALID_SCENARIOS:(SCENARIO_INDEX++) = generic_pitfall

IF CUSTOM_COUNT
	FOR LOCAL, 0, RESULT ;allow adding it multiple times to keep the chance correct
		VALID_SCENARIOS:(SCENARIO_INDEX++) = kojo
	NEXT
	GOTO SKIPSCENARIOCHECK
ENDIF

SELECTCASE Add_VICTIM
	CASE 1
		SIF DAY:2 == 4
			VALID_SCENARIOS:(SCENARIO_INDEX++) = reimu_snowman
		VALID_SCENARIOS:(SCENARIO_INDEX++) = reimu_offerings
	CASE 15
		VALID_SCENARIOS:(SCENARIO_INDEX++) = sakuya_fairy_rebellion
		VALID_SCENARIOS:(SCENARIO_INDEX++) = sakuya_wine
	CASE 17
		VALID_SCENARIOS:(SCENARIO_INDEX++) = alice_doll_makeover
		VALID_SCENARIOS:(SCENARIO_INDEX++) = alice_doll_enlargement
	CASE 26
		VALID_SCENARIOS:(SCENARIO_INDEX++) = yukari_hag
		VALID_SCENARIOS:(SCENARIO_INDEX++) = yukari_wine
	CASE 30
		SIF Add_Fairy_Prank_Evil_Shenanigans
			VALID_SCENARIOS:(SCENARIO_INDEX++) = eiki_stamp_swap
		VALID_SCENARIOS:(SCENARIO_INDEX++) = eiki_trendy_hat
	CASE 60
		VALID_SCENARIOS:(SCENARIO_INDEX++) = parsee_bridge_waxing
	CASE 64
		VALID_SCENARIOS:(SCENARIO_INDEX++) = yuugi_concoction
	CASE 68
		VALID_SCENARIOS:(SCENARIO_INDEX++) = yuuka_scarecrow
	CASE 71
		IF Add_Fairy_Prank_Evil_Shenanigans
			VALID_SCENARIOS:(SCENARIO_INDEX++) = shinmyoumaru_shake
			VALID_SCENARIOS:(SCENARIO_INDEX++) = shinmyoumaru_spider
		ENDIF
		VALID_SCENARIOS:(SCENARIO_INDEX++) = shinmyoumaru_bowl
	CASE 72
		VALID_SCENARIOS:(SCENARIO_INDEX++) = eirin_chemicals
	CASE 80
		VALID_SCENARIOS:(SCENARIO_INDEX++) = akyuu_ink
		VALID_SCENARIOS:(SCENARIO_INDEX++) = akyuu_fairyfication
		VALID_SCENARIOS:(SCENARIO_INDEX++) = akyuu_snack_theft
		SIF Add_Fairy_Prank_Evil_Shenanigans
			VALID_SCENARIOS:(SCENARIO_INDEX++) = akyuu_ridicule
	CASE 99
		VALID_SCENARIOS:(SCENARIO_INDEX++) = toyohime_astronauts
ENDSELECT

$SKIPSCENARIOCHECK
SIF SCENARIO_INDEX == 0
	THROW No valid prank scenario for %CALLNAME:Add_VICTIM%

RETURNF VALID_SCENARIOS:(RAND:SCENARIO_INDEX)

@IRAI_一般92_Find_Accomplices()
#DIM NUM_TARGET
NUM_TARGET = GET_TARGETNUM()

FOR LOCAL, 1, NUM_TARGET + 1
	LOCAL:1 = TARGET:LOCAL
	SIF !SHIRAHU(LOCAL:1)
		CONTINUE
	SIF Add_VICTIM == LOCAL:1
		CONTINUE
	SIF Add_CULPRIT == LOCAL:1
		CONTINUE

	;other fairies, Suwako, Nue, Tewi, Shinmyoumaru, Seija
	IF TALENT:(LOCAL:1):妖精 || GROUPMATCH(LOCAL:1, 33, 41, 53, 71, 97)
		PRINTFORML %CALLNAME:(LOCAL:1)%注意到了你们的阴谋并决定加入。
		Add_ACCOMPLICES:(Add_ACCOMPLICECOUNT++) = LOCAL:1
		SIF Add_ACCOMPLICECOUNT >= 3
			BREAK
	ENDIF
NEXT

@IRAI_一般92_Determine_Success()
#FUNCTION
#DIM ACCOMPLICESCORE
#DIM PRANK_RESULT
#DIM MAX_CHANCE
MAX_CHANCE = 25 + CFLAG:MASTER:今日の運勢 / 100
SELECTCASE RAND:MAX_CHANCE
	CASE 0 TO 1
		DEBUGPRINTFORML Crit fail
		RETURNF -1 ;crit fail
	CASE 2 TO 3
		DEBUGPRINTFORML Crit partial
		RETURNF 0 ;partial success
	CASE 4 TO (4+MAX_CHANCE / 15)
		DEBUGPRINTFORML Crit success
		RETURNF 1 ;crit success
	CASEELSE
		ACCOMPLICESCORE = 0
		FOR LOCAL, 0, Add_ACCOMPLICECOUNT
			SIF Add_ACCOMPLICES:LOCAL > 0
				ACCOMPLICESCORE++
		NEXT
		;check player and fairy knowledge against victim's knowledge + combat, plus accomplices, plus random factor, plus bonus for sleeping victim
		;possibly adjust difficulty based on prank?
		LOCAL:1 = ABL:MASTER:教養 + ABL:Add_CULPRIT:教養 + ACCOMPLICESCORE + (SHIRAHU(Add_VICTIM) != 1 ? 2 # 0) + RAND:6
		LOCAL:2 = (ABL:Add_VICTIM:戦闘能力 + ABL:Add_VICTIM:教養)

		DEBUGPRINTFORML Prank score: {LOCAL:1}
		DEBUGPRINTFORML Prank difficulty: {LOCAL:2}
		PRANK_RESULT = LOCAL:1 - LOCAL:2

		IF PRANK_RESULT > 0
			RETURNF 1
		ELSEIF PRANK_RESULT > -2
			RETURNF 0
		ELSE
			RETURNF -1
		ENDIF
ENDSELECT

@IRAI_一般92_Success_Message
SELECTCASE Add_VICTIM
	CASE 1
	CASE 15
	CASE 17
	CASE 26
