SELECTCASE NEW_RANK
	CASE -5
		PRINTFORML 经过无数次背叛，你的名字已经成为妖精口中的诅咒，一个只有在极度厌恶时才会说出口的词。
		PRINTFORML 你现在被认为是[%IRAI_一般92_Get_Title_Name(GETNUM(TALENT, "FAIRY_FRIEND"), NEW_RANK, MASTER)%]。
	CASE -4
		PRINTFORML 无论你去哪里，妖精们一看到你就转身迅速离开，害怕你的存在。
		PRINTFORML 你现在被认为是[%IRAI_一般92_Get_Title_Name(GETNUM(TALENT, "FAIRY_FRIEND"), NEW_RANK, MASTER)%]。
	CASE -3 TO -2
		PRINTFORML 你不断的背叛在妖精中间并非无人注意。
		PRINTFORML 你现在被认为是[%IRAI_一般92_Get_Title_Name(GETNUM(TALENT, "FAIRY_FRIEND"), NEW_RANK, MASTER)%]。
	CASE -1
		PRINTFORML 背叛了妖精的信任后，你现在被认为是[%IRAI_一般92_Get_Title_Name(GETNUM(TALENT, "FAIRY_FRIEND"), NEW_RANK, MASTER)%]。
	CASE 0
		PRINTFORML 鉴于你的背叛，妖精们对你的好感已经消失了。
		PRINTFORML 你不再被认为是[%IRAI_一般92_Get_Title_Name(GETNUM(TALENT, "FAIRY_FRIEND"), 1, MASTER)%]了。
	CASE 1 TO 7
		PRINTFORML 鉴于你的背叛，妖精们对你的好感减少了。
		PRINTFORML 你现在仅仅被认为是[%IRAI_一般92_Get_Title_Name(GETNUM(TALENT, "FAIRY_FRIEND"), NEW_RANK, MASTER)%]。
	CASEELSE
		PRINTFORML 鉴于你的背叛，妖精们对你的好感减少了。
		PRINTFORML 你现在仅仅被认为是[%IRAI_一般92_Get_Title_Name(GETNUM(TALENT, "FAIRY_FRIEND"), NEW_RANK, MASTER)%]。
ENDSELECT
TALENT:MASTER:FAIRY_FRIEND = NEW_RANK

@IRAI_一般92_Get_Title_Name(TALENT_NUM, RANK, CHARA = -1)
#FUNCTIONS
#DIM TALENT_NUM
#DIM RANK
#DIM CHARA
SELECTCASE RANK
	CASE -5
		RETURNF "妖精族最大最可怕的敌人"
	CASE -4
		RETURNF "妖精族的大敌"
	CASE -3
		RETURNF "妖精克星"
	CASE -2
		RETURNF "妖精背叛者"
	CASE -1
		RETURNF "妖精之耻"
	CASE 0
		RETURNF "中立"
	CASE 1
		RETURNF "妖精之友"
	CASE 2
		RETURNF "妖精挚友"
	CASE 3
		RETURNF "超级妖精挚友"
	CASE 4
		RETURNF "超级终极妖精挚友"
	CASE 5
		RETURNF "妖精死党"
	CASE 6
		RETURNF "妖精冠军"
	CASE 7
		RETURNF "妖精大冠军"
	CASE 8
		RETURNF "永恒的妖精冠军"
	CASE 9
		RETURNF "妖精友谊的理想化身"
	CASE 10
		IF CHARA >= 0 && IS_MALE(CHARA)
			RETURNF "妖精之王"
		ELSE
			RETURNF "妖精女王"
		ENDIF
ENDSELECT
RETURNF "???"

@IRAI_一般92_Title_Score
#FUNCTION
RETURNF (Add_Fairy_Prank_Betrayal * -5) + Add_Fairy_Prank_Success

@IRAI_一般92_Fairy_Fucker
#FUNCTION
LOCAL:1 = 0
FOR LOCAL, 1, CHARANUM - 1
	SIF CFLAG:LOCAL:出禁 ;disabled
		CONTINUE
	IF TALENT:LOCAL:妖精
		SIF !(TALENT:LOCAL:恋慕 || TALENT:LOCAL:愛欲) || !(CFLAG:LOCAL:既成事実 & 合意_うふふ)
			RETURNF 0 ;not yet conquered
		LOCAL:1 = 1 ;at least one fairy exists
	ENDIF
NEXT

RETURNF LOCAL:1

;gives chance to boost foraging/fishing/cleaning/logging/gardening, depending on title rank
@Add_Apply_Fairy_Title_Bonus(TASK)
#FUNCTION
#DIMS TASK
SIF TALENT:MASTER:FAIRY_FRIEND < 1
	RETURNF 0
SIF (CFLAG:MASTER:現在位置 / 100) == 10 ;insufficient fairy presence on the moon
	RETURNF 0
SIF RAND:10 > TALENT:MASTER:FAIRY_FRIEND
	RETURNF 0
SIF FLAG:70
	RETURNF 0

SELECTCASE TASK
	CASE "foraging"
		PRINTFORML 当你采集时，一群妖精加入了你。
		PRINTFORML 在它们的帮助下，你轻松了许多。
		RETURNF TALENT:MASTER:FAIRY_FRIEND * 2
	CASE "fishing"
		PRINTFORML 当你钓鱼时，几只妖精加入了你。
		PRINTFORML 它们的存在刺激了水面，让鱼更容易上钩。
		RETURNF TALENT:MASTER:FAIRY_FRIEND
	CASE "cleaning"
		PRINTFORML 当你打扫时，一群妖精决定加入你。
		PRINTFORML 它们大多只是在玩耍，但它们的帮助仍然值得感激。
		RETURNF MAX(1, TALENT:MASTER:FAIRY_FRIEND / 2)
	CASE "logging"
		PRINTFORML 当你工作时，一群妖精开始为你加油。
		PRINTFORML 受到它们欢呼声的鼓舞，你发现工作比平时更轻松了。
		RETURNF MAX(1, TALENT:MASTER:FAIRY_FRIEND / 3)
	CASE "gardening"
		PRINTFORML 当你在花园工作时，一群妖精开始在附近玩耍。
		PRINTFORML 它们的存在刺激了花园，植物看起来明显更健康了。
		RETURNF 0 ;just a flavor message
	CASE "farming"
		PRINTFORML 当你在田间工作时，一些妖精在庄稼间玩耍。
		PRINTFORML 得益于它们与自然的亲和力，今天的照料更加成功。
		RETURNF MAX(1, TALENT:MASTER:FAIRY_FRIEND / 3)
	CASE "harvesting20"
		PRINTFORML 得益于妖精的影响，你的收成增加了。
		RETURNF RAND:(2+(TALENT:MASTER:FAIRY_FRIEND/2)) + 2
	CASE "harvesting14"
		PRINTFORML 得益于妖精的影响，你的收成增加了。
		RETURNF RAND:(1+(TALENT:MASTER:FAIRY_FRIEND/3)) + 1
	CASE "harvesting7"
		PRINTFORML 得益于妖精的影响，你的收成增加了。
		RETURNF RAND:(1+(TALENT:MASTER:FAIRY_FRIEND/4)) + 1
	CASE "harvesting5"
		PRINTFORML 得益于妖精的影响，你的收成增加了。
		RETURNF RAND:(1+(TALENT:MASTER:FAIRY_FRIEND/5)) + 1
ENDSELECT
RETURNF 0

