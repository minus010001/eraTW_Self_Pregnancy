@F固有依頼15(ARG, O_DATA, V_NAME)
#FUNCTIONS
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE ARG % 1000
;ID101：美鈴的慰勞品
CASE 101
	SELECTCASE O_DATA
	CASE OPR_委托名
		RETURNF "美铃的慰劳品"
	CASE OPR_委托内容表示
		RETURNF "把慰劳品送给美铃"
	CASE OPR_委托报酬表示
		RETURNF @"%金額表示(1000)%"
	CASE OPR_委托报告不要
		RETURNF "无需报告（不需报告也可获得报酬）"
	CASE OPR_委托实行指令名
		RETURNF "送出慰劳品"
		
	CASE OPR_委托内容
		RETURNF @"{MAKE_IRAI_DATA([[美鈴]], OPR_传令人物)}"
	CASE OPR_委托子项
	CASE OPR_委托期限
	CASE OPR_委托发生率
	;これは他の固有依頼との相対確率なんで10％ではありません
		RETURNF @"{10}"
	CASE OPR_委托发生条件
		SIF CAN_MEET([[美鈴]])
			RETURNF @"{1}"
	CASE OPR_委托受託可能条件
	;受託可能は@COM_ABLE366も確認のこと
	;ここを参照するのは依頼人をTARGETにしてる時なので素通しでよし
		IF !IS_WEEKDAY(DAY)
		ELSEIF !INRANGE(TIME / 60, 7, 11)
		ELSE
			RETURNF @"{1}"
		ENDIF
	CASE OPR_委托实行可能条件
	;実行可能は@COM_ABLE367も確認のこと
		RETURNF @"{1}"
	;成功/失敗処理はCARRYOUTで直接書く
	;SOURCEやITEM入手など、内容が複雑なので
	CASE OPR_委托消灭条件
	;30％で消失
		SIF RAND:100 < 30
			RETURNF @"{1}"
	ENDSELECT
ENDSELECT



;固有依頼の設定用
;この関数は実行/成功/失敗時の
;報酬とペナルティと地の文のみを扱います
;各角色のメッセージは別所にて
@IRAI_固有15(CHARA, IRAI_ID, SCENE)
#DIM  CHARA
#DIM  IRAI_ID
#DIMS SCENE
#DIM  CLIENT_ID
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
SELECTCASE STR_DATA_IRAI(IRAI_ID, OPR_委托名, CLIENT_ID)
;个々の依頼名で分岐
CASE "美铃的慰劳品"
	SELECTCASE SCENE
	CASE OPR_委托条件表示
	;何か専用の表示情報を設けたい時用
	;受託済みの依頼表示で使用されます
	;
	;PRINT系だけでSOURCEとかは入れちゃダメ、WAITも無しで
	;ここ以外の表示項目は
	;PRINTFORML 　　　　　：
	;となっているのでスペースを揃えたほうが見栄えが良いです
	
	CASE OPR_委托实行时
	;このCASEに限り、RESULTが意味を持ちます
	;依頼実行時のRESULTにはIRAI_CONST_RESULT()を使用してください
	;可能な引数は"中止", "実行して成功", "実行して失敗", "実行して未解決"です
	;独自処理を仕込みたい時は"実行して未解決"で先延ばしするなりしてください
		SOURCE:歓楽 = 500
		PRINTFORMW %CALLNAME:MASTER%把%CALLNAME:15%提供的慰劳品送给了%CALLNAME:TARGET%
		PRINTFORMW %CALLNAME:TARGET%高兴的收下了
		PRINTL
		CALL CHANGE_CFLAG(2, TARGET, 30)
		CALL CHANGE_CFLAG(4, TARGET, 15)
		TALENT:心情 = LIMIT(TALENT:心情 + 1, -1, 1)
		RETURN IRAI_CONST_RESULT("実行して成功")
	CASE OPR_委托成功时
	;成功報告時の報酬など
		CALL CHANGE_CFLAG(2, TARGET, 20)
		CALL CHANGE_CFLAG(4, TARGET, 10)
		CALL GET_MONEY_YEN(1000, 2)
	CASE OPR_委托报告不要
	;達成後に報告をしなかった場合、多少減らす
		PRINTFORML 完成委托后%CALLNAME:CHARA%的%金额表示(1000)%回礼摆放在%CALLNAME:MASTER%的房间里
		CALL GET_MONEY_YEN(1000, 1)
		CALL CHANGE_CFLAG(2, CHARA, 15)
		CALL CHANGE_CFLAG(4, CHARA, 7)
	CASE OPR_委托失败时
	;失敗報告時の処理
	ENDSELECT
ENDSELECT
