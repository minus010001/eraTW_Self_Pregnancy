;存否関数
;F関数はTRYCALL系が使えないので通常関数で存否配列を作っちゃう
@EXIST_一般依頼6
#LOCALSIZE 1
#LOCALSSIZE 1

;オブジェクト本体
;ここでARGで渡されるのはCLIENT_IDです
@F一般依頼6(ARG, O_DATA, V_NAME)
#FUNCTIONS
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE OPR_委托名
	RETURNF "谁来告诉我！"
CASE OPR_委托内容表示
	RETURNF @"回答%CALLNAME:ARG%的疑问"
CASE OPR_委托报酬表示
	RETURNF @"%金額表示(500)%"
CASE OPR_委托实行指令名
	IF IS_LIBRARY(CFLAG:MASTER:現在位置)
		RETURNF "查资料"
	ELSE
		RETURNF "进行解答"
	ENDIF
CASE OPR_委托内容
	RETURNF @"{MAKE_IRAI_DATA(0, OPR_其他)}"
CASE OPR_委托子项
	RETURNF @"{(ABL:ARG:教養 + RAND(1, 10)) * 10}"
CASE OPR_委托期限
;発生時ではなく受託時に確定します
CASE OPR_委托发生率
;これは他の一般依頼との相対確率なんで10％ではありません
	RETURNF @"{10}"
CASE OPR_委托发生条件
	SIF ABL:ARG:教養 <= ABL:MASTER:教養
		RETURNF @"{1}"
CASE OPR_委托受託可能条件
	RETURNF @"{1}"
CASE OPR_委托实行可能条件
	;查資料是つでも
	IF FLAG:70
	ELSEIF IS_LIBRARY(CFLAG:MASTER:現在位置)
		RETURNF @"{1}"
	;教えるのはCLIENTをTARGETにする必要がある
	ELSEIF TARGET == ARG && SHIRAHU(ARG)
		RETURNF @"{1}"
	ENDIF
;成功/失敗処理はCARRYOUTで直接書く
;SOURCEやITEM入手、消費が煩雑になるので
CASE OPR_委托消灭条件
	SIF RAND:100 < 30
		RETURNF @"{1}"
CASE OPR_委托人带出可能
	RETURNF @"{1}"
ENDSELECT



@IRAI_一般6(CHARA, IRAI_ID, SCENE)
#DIM  CHARA
#DIM  IRAI_ID
#DIMS SCENE
#DIM  CLIENT_ID
#DIM  LIBRARY_ID
#DIMS LIBRARY_NAME
#DIM  CHK_SLOT
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
CHK_SLOT  = SEARCH_IRAI_SLOT(IRAI_ID)
SELECTCASE SCENE
CASE OPR_委托条件表示
PRINTFORML 　　理解度：%IRAI_一般6_DIFFICULTY(CHK_SLOT)%
;何か専用の表示情報を設けたい時用
;受託済みの依頼表示で使用されます
;
;PRINT系だけでSOURCEとかは入れちゃダメ、WAITも無しで
;ここ以外の表示項目は
;PRINTFORML 　　　　　：
;となっているのでスペースを揃えたほうが見栄えが良いです

CASE OPR_委托实行时
;依頼実行時にはRESULTが意味を持ちます
;このCASEに限り、RESULTが意味を持ちます
;依頼実行時のRESULTにはIRAI_CONST_RESULT()を使用してください
;可能な引数は"中止", "実行して成功", "実行して失敗", "実行して未解決"です
;独自処理を仕込みたい時は"実行して未解決"で先延ばしするなりしてください
	LIBRARY_ID = IS_LIBRARY(CFLAG:MASTER:現在位置)
	IF LIBRARY_ID
		IF INRANGE(LIBRARY_ID, 1, 99)
			LIBRARY_NAME '= STR_TR(LIBRARY_ID)
		ELSE
			LIBRARY_NAME '= STR_TR(8000 + LIBRARY_ID)
		ENDIF
		IF TARGET == CLIENT_ID
			PRINTFORML %CALLNAME:MASTER%为了回答%CALLNAME:TARGET%的疑问访问了%LIBRARY_NAME%
			PRINTFORML 在那里找到了有用的资料
			CALL ASK_M("停止", 1, "调查", 1, "试着回答", 1)
			SELECTCASE RESULT
			CASE 0
				RETURN IRAI_CONST_RESULT("中止")
			CASE 1
				PRINTFORMW %CALLNAME:MASTER%和%CALLNAME:TARGET%在%LIBRARY_NAME%做着调查
				EXP:MASTER:学習経験 ++
				EXP:TARGET:学習経験 ++
				IRAI_SUB:CHK_SLOT -= ABL:MASTER:教養 + ABL:TARGET:教養 + 5
				IRAI_SUB:CHK_SLOT = MAX(IRAI_SUB:CHK_SLOT, 1)
				TIME += 30
			CASE 2
				GOTO ANSWER
			ENDSELECT
		ELSE
			PRINTFORML %CALLNAME:MASTER%在%LIBRARY_NAME%做着调查
			EXP:MASTER:学習経験 ++
			IRAI_SUB:CHK_SLOT -= ABL:MASTER:教養 + 3
			IRAI_SUB:CHK_SLOT = MAX(IRAI_SUB:CHK_SLOT, 1)
		ENDIF
		PRINTFORML 现在你的理解度
		PRINTFORMW 　%IRAI_一般6_DIFFICULTY(CHK_SLOT)%
		RETURN IRAI_CONST_RESULT("実行して未解決")
	ELSE
		$ANSWER
		PRINTFORML %CALLNAME:MASTER%回答了%CALLNAME:TARGET%的疑问
		IF IRAI_一般6_SUCCESS(CHK_SLOT)
			PRINTFORMW %CALLNAME:TARGET%的疑问冰消瓦解了！
			SOURCE:歓楽 = 300
			EXP:MASTER:学習経験 += ABL:TARGET:教養 * 5
			EXP:TARGET:学習経験 += ABL:TARGET:教養 * 5
			IF ITEM:103
				EXP:MASTER:学習経験 ++
				EXP:TARGET:学習経験 ++
			ENDIF
			DOWNBASE:MASTER:体力 = 70
			DOWNBASE:MASTER:気力 = 100
			DOWNBASE:体力 = 50
			DOWNBASE:気力 = 70
			TIME += 30
			RETURN IRAI_CONST_RESULT("実行して成功")
		ELSE
			PRINTFORMW %CALLNAME:TARGET%好像没能理解……
			RETURN IRAI_CONST_RESULT("実行して失敗")
		ENDIF
	ENDIF
CASE OPR_委托成功时
;成功報告時の報酬など
	CALL CHANGE_CFLAG(2, TARGET, 50)
	CALL CHANGE_CFLAG(4, TARGET, 30)
	CALL KIGEN_CHANGE(TARGET,100,1)
	CALL GET_MONEY_YEN(500, 2)
CASE OPR_委托失败时
;失敗報告時の処理
	CALL CHANGE_CFLAG(2, TARGET, -10)
	CALL CHANGE_CFLAG(4, TARGET, -10)
ENDSELECT

@IRAI_一般6_SUCCESS(CHK_SLOT)
#FUNCTION
#DIM CHK_SLOT
SIF RAND:MAX(1, IRAI_SUB:CHK_SLOT) <= (1 + ABL:MASTER:教養) * 20
	RETURNF 1


@IRAI_一般6_DIFFICULTY(CHK_SLOT)
#FUNCTIONS
#DIM CHK_SLOT
SIF IRAI_SUB:CHK_SLOT <= (1 + ABL:MASTER:教養) * 20
	RETURNF "非常完美的让对方理解了"
;難易度全体で差分をパーセント化したもの
SELECTCASE (IRAI_SUB:CHK_SLOT - ((1 + ABL:MASTER:教養) * 20)) * 100 / IRAI_SUB:CHK_SLOT
CASE 0, 1, 2, 3
	RETURNF "好像可以给出高明的回答"
CASE 4, 5, 6
	RETURNF "已经可以回答了"
CASE 7 TO 10
	RETURNF "能够回答出来吧"
CASE 11 TO 33
	RETURNF "这样算是理解了么"
CASE 34 TO 50
	RETURNF "一定会有办法的、大概"
CASE 51 TO 70
	RETURNF "很难的疑问"
CASEELSE
	RETURNF "完全无法推测"
ENDSELECT


