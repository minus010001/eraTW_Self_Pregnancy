;オブジェクト本体
;ここでARGで渡されるのはIRAI_SLOTの中身（依頼ID + 依頼者登録番号 * 1000）です
;関数名の@固有依頼XのXは角色番号（霊夢の依頼）ね
;こいつは@EXIST関数不要でよし（ということにする）
;上流、キャラデータ側で依頼IDの範囲を記述するのが存否の確認を兼ねる
;関数名etcをミスったらエラー吐いてくれるしわかるだろ
@F固有依頼1(ARG, O_DATA, V_NAME)
#FUNCTIONS
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE ARG % 1000
;ID101：揉肩
CASE 101
	SELECTCASE O_DATA
	CASE OPR_委托名
		RETURNF "揉肩"
	CASE OPR_委托内容表示
		RETURNF "为灵梦揉肩"
	CASE OPR_委托报酬表示
		RETURNF "青汁"
	CASE OPR_委托实行指令名
		RETURNF "揉肩"
		
	CASE OPR_委托内容
		RETURNF @"{MAKE_IRAI_DATA(0, OPR_作业)}"
	CASE OPR_委托子项
	CASE OPR_委托期限
	;発生時ではなく受託時に確定します
	CASE OPR_委托发生率
	;これは他の固有依頼との相対確率なんで10％ではありません
		RETURNF @"{10}"
	CASE OPR_委托发生条件
		RETURNF @"{1}"
	CASE OPR_委托受託可能条件
	;受託可能は@COM_ABLE366も確認のこと
	;ここを参照するのは依頼人をTARGETにしてる時なので素通しでよし
		RETURNF @"{1}"
	CASE OPR_委托实行可能条件
	;実行可能は@COM_ABLE367も確認のこと
	;素通しでよし
		RETURNF @"{1}"
	;成功/失敗処理はCARRYOUTで直接書く
	;SOURCEやITEM入手など、内容が複雑なので
	CASE OPR_委托消灭条件
	;30％で消失
		SIF RAND:100 < 30
			RETURNF @"{1}"
	ENDSELECT

;ID102：魔理沙的遗失物
CASE 102
	SELECTCASE O_DATA
	CASE OPR_委托名
		RETURNF "魔理沙的遗失物"
	CASE OPR_委托内容表示
		RETURNF "把遗失物交给魔理沙"
	CASE OPR_委托报酬表示
		RETURNF @"%金額表示(500)%"
	CASE OPR_委托报告不要
		RETURNF "无需报告（但报告了才能领取报酬）"
	CASE OPR_委托实行指令名
		RETURNF "送回遗失物"
		
	CASE OPR_委托内容
		RETURNF @"{MAKE_IRAI_DATA(11, OPR_传令人物)}"
	CASE OPR_委托子项
	CASE OPR_委托期限
		RETURNF @"{7}"
	;発生時ではなく受託時に確定します
	CASE OPR_委托发生率
	;これは他の固有依頼との相対確率なんで10％ではありません
		RETURNF @"{10}"
	CASE OPR_委托发生条件
		SIF GET_MAPID(CFLAG:11:現在位置) != 0 && CAN_MEET(11)
			RETURNF @"{1}"
	CASE OPR_委托受託可能条件
	;受託可能は@COM_ABLE366も確認のこと
	;ここを参照するのは依頼人をTARGETにしてる時なので素通しでよし
		RETURNF @"{1}"
	CASE OPR_委托实行可能条件
	;実行可能は@COM_ABLE367/@CAN_IRAI_SLOT_DOも確認のこと
	;素通しでよし
		RETURNF @"{1}"
	;成功/失敗処理はCARRYOUTで直接書く
	;SOURCEやITEM入手など、内容が複雑なので
	CASE OPR_委托消灭条件
	;30％で消失
		SIF RAND:100 < 30
			RETURNF @"{1}"
	ENDSELECT

;ID103：宴会用的酒
CASE 103
	SELECTCASE O_DATA
	CASE OPR_委托名
		RETURNF "宴会用的酒"
	CASE OPR_委托内容表示
		RETURNF "提供酒水(10份)"
	CASE OPR_委托报酬表示
		RETURNF "提升宴会规模"
	CASE OPR_委托实行指令名
		RETURNF "送出酒水"
		
	;対象のITEM_IDが選択可能なのでとりあえず作業分類に
	CASE OPR_委托内容
		RETURNF @"{MAKE_IRAI_DATA(0, OPR_作业)}"
	CASE OPR_委托子项
	CASE OPR_委托期限
	;発生時ではなく受託時に確定します
	CASE OPR_委托发生率
	;条件を満たすのが稀だと思うので高めにしましょう
		RETURNF @"{100}"
	CASE OPR_委托发生条件
		SIF FLAG:宴会開催FLAG == 1
			RETURNF @"{1}"
	CASE OPR_委托受託可能条件
	;受託可能は@COM_ABLE366も確認のこと
	;ここを参照するのは依頼人をTARGETにしてる時なので素通しでよし
		RETURNF @"{1}"
	CASE OPR_委托实行可能条件
	;実行可能は@COM_ABLE367も確認のこと
		;SIF MAX(ITEM:51, ITEM:52, ITEM:53) >= 10
			RETURNF @"{1}"
	;成功/失敗処理はCARRYOUTで直接書く
	;SOURCEやITEM入手など、内容が複雑なので
	CASE OPR_委托消灭条件
		SIF FLAG:宴会開催FLAG == 1 && !(DAY % 7)
			RETURNF @"{1}"
	ENDSELECT
ENDSELECT



;固有依頼の実処理用
;この関数は実行/成功/失敗時の
;報酬とペナルティと地の文のみを扱います
;各角色のメッセージは別所にて
@IRAI_固有1(CHARA, IRAI_ID, SCENE)
#DIM  CHARA
#DIM  IRAI_ID
#DIMS SCENE
#DIM  CLIENT_ID
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
SELECTCASE STR_DATA_IRAI(IRAI_ID, OPR_委托名, CLIENT_ID)
;个々の依頼名で分岐
CASE "揉肩"
	SELECTCASE SCENE
	CASE OPR_委托条件表示
	;何か専用の表示情報を設けたい時用
	;受託済みの依頼表示で使用されます
	;
	;PRINT系だけでSOURCEとかは入れちゃダメ、WAITも無しで
	;ここ以外の表示項目は
	;PRINTFORML 　　　　　：
	;となっているのでスペースを揃えたほうが見栄えが良いです
	
	CASE OPR_委托实行时
	;依頼実行時にはRESULTが意味を持ちます
	;このCASEに限り、RESULTが意味を持ちます
	;依頼実行時のRESULTにはIRAI_CONST_RESULT()を使用してください
	;可能な引数は"中止", "実行して成功", "実行して失敗", "実行して未解決"です
	;独自処理を仕込みたい時は"実行して未解決"で先延ばしするなりしてください
	;
	;・実行時/成功報告/失敗報告で地の文をつけるとき是ずれも最後にWAITつけたほうがいい
	;・ただし、@CHANGE_CFLAGを使用と関数側でPRINTFORMWしてWAITが入る
		SOURCE:歓楽 = 1000
		SOURCE:情愛 = 300
		SOURCE:露出 = 20
		DOWNBASE:気力 += 50
		DOWNBASE:MASTER:気力 += 50
		PRINTFORMW %CALLNAME:MASTER%给%CALLNAME:TARGET%揉了揉肩
		;これは追加の10分
		TIME += 10
		;四割の確率でもっとやって！分岐
		IF RAND:100 < 60
			RETURN IRAI_CONST_RESULT("実行して未解決")
		ELSE
			RETURN IRAI_CONST_RESULT("実行して成功")
		ENDIF
	CASE OPR_委托成功时
	;成功報告時の報酬など
		SOURCE:歓楽 += 1000
		CALL CHANGE_CFLAG(2, 1, 20)
		CALL CHANGE_CFLAG(4, 1, 5)
		CALL GET_ITEM("青汁", 1, 2)
	CASE OPR_委托失败时
	;失敗報告時の処理
		CALL CHANGE_CFLAG(2, 1, -5)
		CALL CHANGE_CFLAG(4, 1, -3)
	ENDSELECT

CASE "魔理沙的遗失物"
	SELECTCASE SCENE
	CASE OPR_委托条件表示
	CASE OPR_委托实行时
		SOURCE:歓楽 = 500
		PRINTFORMW %CALLNAME:MASTER%把遗落的东西送到了%CALLNAME:11%手上
		;システムメッセージつき好感度変化
		;最後の引数だけ好感度が変化
		CALL CHANGE_CFLAG(2, 11, 20)
		CALL CHANGE_CFLAG(4, 11, 10)
		RETURN IRAI_CONST_RESULT("実行して成功")
	CASE OPR_委托成功时
		SOURCE:TARGET:歓楽 += 1000
		;システムメッセージつき好感度変化
		;最後の引数だけ好感度が変化
		CALL CHANGE_CFLAG(2, TARGET, 20)
		;システムメッセージつき信赖度変化
		;最後の引数だけ信赖度が変化
		CALL CHANGE_CFLAG(4, TARGET, 10)
		CALL GET_MONEY_YEN(500, 2)
	CASE OPR_委托失败时
		CALL CHANGE_CFLAG(2, TARGET, -10)
		CALL CHANGE_CFLAG(4, TARGET, -10)
	ENDSELECT

CASE "宴会用的酒"
	SELECTCASE SCENE
	CASE OPR_委托条件表示
	CASE OPR_委托实行时
		PRINTL 要交出哪种酒（十瓶）呢？
		CALL 酒一覧表示(10)
		;只允许最老的三种酒
		;IF INRANGE(RESULT, 51, 53)
		IF IS_ALC(RESULT)
			PRINTFORMW %CALLNAME:MASTER%把酒交给了%CALLNAME:TARGET%
			ITEM:RESULT -= 10
			FLAG:宴会差し入れ = RESULT
			;addition custom code
			IF ADD_BANQUET_INDEX(1) >= 0
				SELECTCASE FLAG:宴会差し入れ
					CASE 51
						ADD_BANQUETS_SCALE:ADD_BANQUET_INDEX(1) += RAND:1000
					CASE 52
						ADD_BANQUETS_SCALE:ADD_BANQUET_INDEX(1) += RAND:2000
				ENDSELECT
			ENDIF
			RETURN IRAI_CONST_RESULT("実行して成功")
		ELSE
			RETURN IRAI_CONST_RESULT("中止")
		ENDIF
	CASE OPR_委托成功时
		;システムメッセージつき好感度変化
		;最後の引数だけ好感度が変化
		CALL CHANGE_CFLAG(2, TARGET, 50)
		;システムメッセージつき信赖度変化
		;最後の引数だけ信赖度が変化
		CALL CHANGE_CFLAG(4, TARGET, 20)
	CASE OPR_委托失败时
		;システムメッセージつき好感度変化
		;最後の引数だけ好感度が変化
		CALL CHANGE_CFLAG(2, TARGET, -30)
		;システムメッセージつき信赖度変化
		;最後の引数だけ信赖度が変化
		CALL CHANGE_CFLAG(4, TARGET, -10)
	ENDSELECT

ENDSELECT



