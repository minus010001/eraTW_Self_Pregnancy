;存否関数
;F関数はTRYCALL系が使えないので通常関数で存否配列を作っちゃう
@EXIST_一般依頼13
#LOCALSIZE 1
#LOCALSSIZE 1

;オブジェクト本体
;ここでARGで渡されるのはCLIENT_IDです
@F一般依頼13(ARG, O_DATA, V_NAME)
#FUNCTIONS
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE OPR_委托名
	RETURNF "想吃美味的鱼"
CASE OPR_委托内容表示
	RETURNF @"交出美味的鱼"
CASE OPR_委托报酬表示
	RETURNF @"高级食材３个"
CASE OPR_委托实行指令名
	RETURNF "交出美味的鱼"
CASE OPR_委托内容
	RETURNF @"{MAKE_IRAI_DATA(GETNUM(ITEM, "好吃的魚"), OPR_调达)}"
CASE OPR_委托子项
	RETURNF @"{1}"
CASE OPR_委托期限
;発生時ではなく受託時に確定します
	RETURNF @"{5}"
CASE OPR_委托发生率
;これは他の一般依頼との相対確率なんで10％ではありません
	RETURNF @"{3}"
CASE OPR_委托发生条件
;魚料理が嫌いなキャラ以外
	SIF !STRCOUNT(GETMETH_STR(, "キャラデータ", ARG, "料理：讨厌的味道"), "魚/")
		RETURNF @"{1}"
CASE OPR_委托受託可能条件
;釣魚竿を持ってる
	SIF ITEM:釣魚竿
		RETURNF @"{1}"
CASE OPR_委托实行可能条件
	RETURNF @"{1}"
;成功/失敗処理はCARRYOUTで直接書く
;SOURCEやITEM入手、消費が煩雑になるので
CASE OPR_委托消灭条件
	SIF RAND:100 < 30
		RETURNF @"{1}"
CASE OPR_委托人带出可能
ENDSELECT



@IRAI_一般13(CHARA, IRAI_ID, SCENE)
#DIM  CHARA
#DIM  IRAI_ID
#DIMS SCENE
#DIM  CLIENT_ID
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
SELECTCASE SCENE
CASE OPR_委托条件表示
;何か専用の表示情報を設けたい時用
;受託済みの依頼表示で使用されます
;
;PRINT系だけでSOURCEとかは入れちゃダメ、WAITも無しで
;ここ以外の表示項目は
;PRINTFORML 　　　　　：
;となっているのでスペースを揃えたほうが見栄えが良いです

CASE OPR_委托实行时
;このCASEに限り、RESULTが意味を持ちます
;依頼実行時のRESULTにはIRAI_CONST_RESULT()を使用してください
;可能な引数は"中止", "実行して成功", "実行して失敗", "実行して未解決"です
;独自処理を仕込みたい時は"実行して未解決"で先延ばしするなりしてください
	SOURCE:TARGET:歓楽 += 1000
	PRINTFORML %CALLNAME:MASTER%把美味的鱼交给了%CALLNAME:TARGET%
	PRINTFORML 总感觉活下去的希望涌出来了。
	CALL LOST_ITEM("好吃的魚", 1, 2)
	RETURN IRAI_CONST_RESULT("実行して成功")
CASE OPR_委托成功时
;成功報告時の報酬など
	CALL CHANGE_CFLAG(2, TARGET, 30)
	CALL CHANGE_CFLAG(4, TARGET, 20)
	TALENT:心情 = LIMIT(TALENT:心情 + 1, -1, 1)
	CALL GET_ITEM("高级食材", 3, 2)
CASE OPR_委托失败时
;失敗報告時の処理
	CALL CHANGE_CFLAG(2, TARGET, -5)
	CALL CHANGE_CFLAG(4, TARGET, -5)
ENDSELECT
