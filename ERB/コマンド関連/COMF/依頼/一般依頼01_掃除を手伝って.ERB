;存否関数
;F関数はTRYCALL系が使えないので通常関数で存否配列を作っちゃう
@EXIST_一般依頼1
#LOCALSIZE 1
#LOCALSSIZE 1

;オブジェクト本体
;ここでARGで渡されるのはCLIENT_IDです
@F一般依頼1(ARG, O_DATA, V_NAME)
#FUNCTIONS
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE OPR_委托名
	RETURNF "帮忙做扫除"
CASE OPR_委托内容表示
	RETURNF @"帮%CALLNAME:ARG%扫除房间"
CASE OPR_委托报酬表示
	RETURNF @"低级素材"
CASE OPR_委托实行指令名
	IF YOGORE:(GET_CHARAHOME(ARG)) < 1000
		RETURNF "完成扫除"
	ELSE
		RETURNF "开始扫除"
	ENDIF
CASE OPR_委托内容
	RETURNF @"{MAKE_IRAI_DATA(0, OPR_作业)}"
CASE OPR_委托子项
CASE OPR_委托期限
;発生時ではなく受託時に確定します
CASE OPR_委托发生率
;これは他の一般依頼との相対確率なんで10％ではありません
	RETURNF @"{10}"
CASE OPR_委托发生条件
;自宅が你と同一Mapの角色のみ
	SIF MAIN_MAP == GET_MAPID(GET_CHARAHOME(ARG))
		RETURNF @"{1}"
CASE OPR_委托受託可能条件
;その依頼者の自宅近辺にいるとき
;（基本条件としてまず依頼者と你が同一地点にいるはずなのでこれでよい）
	IF MAIN_MAP != GET_MAPID(GET_CHARAHOME(ARG))
	ELSEIF CFLAG:ARG:宴会参加
	ELSEIF YOGORE:(GET_CHARAHOME(ARG)) < 1000
	ELSEIF AT_HOME(MASTER)
		RETURNF @"{1}"
	ENDIF
CASE OPR_委托实行可能条件
;依頼者とTARGETが同一であり、その依頼者の自宅にいるとき
;（基本条件としてまず依頼者と你が同一地点にいるはずなのでこれでよい）
	IF MAIN_MAP != GET_MAPID(GET_CHARAHOME(ARG))
	ELSEIF CFLAG:ARG:宴会参加
	ELSEIF CFLAG:ARG:現在位置 == GET_CHARAHOME(ARG)
		RETURNF @"{1}"
	ENDIF
;成功/失敗処理はCARRYOUTで直接書く
;SOURCEやITEM入手、消費が煩雑になるので
CASE OPR_委托消灭条件
	SIF RAND:100 < 30
		RETURNF @"{1}"
CASE OPR_委托人带出可能
	RETURNF @"{1}"
ENDSELECT



@IRAI_一般1(CHARA, IRAI_ID, SCENE)
#DIM  CHARA
#DIM  IRAI_ID
#DIMS SCENE
#DIM  CLIENT_ID
#DIM  SWEEP_ID
#DIM  SWEEP_POWER
#DIM  SWEEP_YOGORE
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
SELECTCASE SCENE
CASE OPR_委托条件表示
;何か専用の表示情報を設けたい時用
;受託済みの依頼表示で使用されます
;
;PRINT系だけでSOURCEとかは入れちゃダメ、WAITも無しで
;ここ以外の表示項目は
;PRINTFORML 　　　　　：
;となっているのでスペースを揃えたほうが見栄えが良いです

CASE OPR_委托实行时
;このCASEに限り、RESULTが意味を持ちます
;依頼実行時のRESULTにはIRAI_CONST_RESULT()を使用してください
;可能な引数は"中止", "実行して成功", "実行して失敗", "実行して未解決"です
;独自処理を仕込みたい時は"実行して未解決"で先延ばしするなりしてください
;
;OPR_委托实行时に限っていえば、CHARAはTARGETと同一であり、必ずしもCLIENT_IDと一致するとは限りません
;个々のケースで確認する必要があります
;この依頼は「作業」扱いであり、CLIENTがTARGETになっている時のみ実行できます
;
;
;ほぼ掃除指令のコピーだが必ず手伝ってくれて掃除効果が高い
	IF YOGORE:(GET_CHARAHOME(TARGET)) < 1000
		PRINTFORMW %CALLNAME:TARGET%的房间变得十分干净
		TIME += 3
	ELSE
		PRINTFORMW %CALLNAME:MASTER%和%CALLNAME:TARGET%一起清扫了房间
		PRINTFORML 
		SWEEP_ID = CFLAG:MASTER:現在位置
		SWEEP_POWER = SWEEP_POWER_CALC(TARGET)
		SWEEP_YOGORE = YOGORE:SWEEP_ID - YOGORE:SWEEP_ID / (SWEEP_POWER * (SWEEP_ID == P54小人的虫籠 ? 5 # 1) + 1)
		YOGORE:SWEEP_ID -= SWEEP_YOGORE
		IF GROUPMATCH(SWEEP_ID, P9居間, P10走廊) && (TALENT:MASTER:体型 > -5 || TALENT:体型 > -5)
			SWEEP_YOGORE += YOGORE:P54小人的虫籠 / 5
			YOGORE:P54小人的虫籠 = 0
			;PRINTFORML 顺手把虫笼也清扫干净了
			;PRINTFORML 因为只要挪开针妙丸的私人物品再倒过来抖一抖就行了所以很简单
		ENDIF
		EX:MASTER:今日的掃除回数 += SWEEP_YOGORE
		SIF GMF_GETBIT("幻想乡大地图")
			GMF_MAP_SWEEP_VALUE:(GET_MAPID(SWEEP_ID)) += SWEEP_YOGORE
		EXP:清掃経験 ++
		EXP:MASTER:清掃経験 ++

		DOWNBASE:MASTER:体力 = 50
		DOWNBASE:MASTER:気力 = 100
		DOWNBASE:気力 = 100
		TIME += 20
	ENDIF
	SOURCE:歓楽 = 500
	SOURCE:征服 = 200
	RETURN IRAI_CONST_RESULT("実行して成功")
CASE OPR_委托成功时
;成功報告時の報酬など
	CALL CHANGE_CFLAG(2, TARGET, 20)
	CALL CHANGE_CFLAG(4, TARGET, 10)
		CALL GetRandMaterial(1, 1000)
CASE OPR_委托失败时
;失敗報告時の処理
	CALL CHANGE_CFLAG(2, TARGET, -10)
	CALL CHANGE_CFLAG(4, TARGET, -10)
ENDSELECT
