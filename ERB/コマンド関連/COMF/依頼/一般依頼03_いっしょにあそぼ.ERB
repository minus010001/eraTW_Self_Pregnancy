;存否関数
;F関数はTRYCALL系が使えないので通常関数で存否配列を作っちゃう
@EXIST_一般依頼3
#LOCALSIZE 1
#LOCALSSIZE 1

;オブジェクト本体
;ここでARGで渡されるのはCLIENT_IDです
@F一般依頼3(ARG, O_DATA, V_NAME)
#FUNCTIONS
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE OPR_委托名
	RETURNF "一起玩吧"
CASE OPR_委托内容表示
	RETURNF @"和%CALLNAME:ARG%一起玩"
CASE OPR_委托报酬表示
	RETURNF "关系变好"
CASE OPR_委托实行指令名
	RETURNF "玩游戏"

CASE OPR_委托内容
	RETURNF @"{MAKE_IRAI_DATA(0, OPR_作业)}"
CASE OPR_委托子项
CASE OPR_委托期限
;発生時ではなく受託時に確定します
CASE OPR_委托发生率
;これは他の一般依頼との相対確率なんで15％ではありません
	RETURNF @"{15}"
CASE OPR_委托发生条件
;幼稚角色限定
;蕾米莉亜と帝でも発生してしまうが気にするな
	SIF TALENT:ARG:幼稚
		RETURNF @"{1}"
CASE OPR_委托受託可能条件
	RETURNF @"{1}"
CASE OPR_委托实行可能条件
	RETURNF @"{1}"
;成功/失敗処理はCARRYOUTで直接書く
;SOURCEやITEM入手、消費が煩雑になるので
CASE OPR_委托消灭条件
	SIF RAND:100 < 30
		RETURNF @"{1}"
ENDSELECT



@IRAI_一般3(CHARA, IRAI_ID, SCENE)
#DIM  CHARA
#DIM  IRAI_ID
#DIMS SCENE
#DIM  CLIENT_ID
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
SELECTCASE SCENE
CASE OPR_委托条件表示
;何か専用の表示情報を設けたい時用
;受託済みの依頼表示で使用されます
;
;PRINT系だけでSOURCEとかは入れちゃダメ、WAITも無しで
;ここ以外の表示項目は
;PRINTFORML 　　　　　：
;となっているのでスペースを揃えたほうが見栄えが良いです

CASE OPR_委托实行时
;このCASEに限り、RESULTが意味を持ちます
;依頼実行時のRESULTにはIRAI_CONST_RESULT()を使用してください
;可能な引数は"中止", "実行して成功", "実行して失敗", "実行して未解決"です
;独自処理を仕込みたい時は"実行して未解決"で先延ばしするなりしてください
;
;OPR_委托实行时に限っていえば、CHARAはTARGETと同一であり、必ずしもCLIENT_IDと一致するとは限りません
;个々のケースで確認する必要があります
;この依頼は「作業」扱いであり、CLIENTがTARGETになっている時のみ実行できます
;
;
	SOURCE:歓楽 = 1500
	PRINTFORMW %CALLNAME:MASTER%陪%CALLNAME:TARGET%一起玩
	PRINTFORML 
	TIME += 20
	DOWNBASE:体力 = 150
	DOWNBASE:気力 = 100
	DOWNBASE:MASTER:体力 = 150
	DOWNBASE:MASTER:気力 = 100
	RETURN IRAI_CONST_RESULT("実行して成功")
CASE OPR_委托成功时
;成功報告時の報酬など
	TALENT:TARGET:心情 = LIMIT(TALENT:心情 + 1, -1, 1)
	CALL CHANGE_CFLAG(2, TARGET, 30)
	CALL CHANGE_CFLAG(4, TARGET, 5)
CASE OPR_委托失败时
;失敗報告時の処理
	CALL CHANGE_CFLAG(2, TARGET, -10)
	CALL CHANGE_CFLAG(4, TARGET, -5)
ENDSELECT
