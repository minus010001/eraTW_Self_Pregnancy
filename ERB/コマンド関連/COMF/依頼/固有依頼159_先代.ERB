;オブジェクト本体
;ここでARGで渡されるのはIRAI_SLOTの中身（依頼ID + 依頼者登録番号 * 1000）です
;関数名の@固有依頼XのXは角色番号（霊夢の依頼）ね
;こいつは@EXIST関数不要でよし（ということにする）
;上流、キャラデータ側で依頼IDの範囲を記述するのが存否の確認を兼ねる
;関数名etcをミスったらエラー吐いてくれるしわかるだろ
@F固有依頼159(ARG, O_DATA, V_NAME)
#FUNCTIONS
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE ARG % 1000
;ID158：一起看风景
CASE 101
	SELECTCASE O_DATA
	CASE OPR_委托名
		RETURNF "一起看风景"
	CASE OPR_委托内容表示
		RETURNF "坐下来和先代一起看风景"
	CASE OPR_委托报酬表示
		RETURNF "？？？"
	CASE OPR_委托实行指令名
		RETURNF "一起看风景"
		
	CASE OPR_委托内容
		RETURNF @"{MAKE_IRAI_DATA(0, OPR_作业)}"
	CASE OPR_委托子项
	CASE OPR_委托期限
	;発生時ではなく受託時に確定します
	CASE OPR_委托发生率
	;これは他の固有依頼との相対確率なんで10％ではありません
		RETURNF @"{10}"
	CASE OPR_委托发生条件
		RETURNF @"{1}"
	CASE OPR_委托受託可能条件
	;受託可能は@COM_ABLE366も確認のこと
	;ここを参照するのは依頼人をTARGETにしてる時なので素通しでよし
		RETURNF @"{1}"
	CASE OPR_委托实行可能条件
	;実行可能は@COM_ABLE367も確認のこと
	;素通しでよし
		RETURNF @"{1}"
	;成功/失敗処理はCARRYOUTで直接書く
	;SOURCEやITEM入手など、内容が複雑なので
	CASE OPR_委托消灭条件
	;30％で消失
		SIF RAND:100 < 30
			RETURNF @"{1}"
	ENDSELECT

;ID159：灵梦的遗失物
CASE 102
	SELECTCASE O_DATA
	CASE OPR_委托名
		RETURNF "灵梦的遗失物"
	CASE OPR_委托内容表示
		RETURNF "把遗失物交给灵梦"
	CASE OPR_委托报酬表示
		RETURNF @"%金額表示(500)%"
	CASE OPR_委托报告不要
		RETURNF "无需报告（但报告了才能领取报酬）"
	CASE OPR_委托实行指令名
		RETURNF "送回遗失物"
		
	CASE OPR_委托内容
		RETURNF @"{MAKE_IRAI_DATA(1, OPR_传令人物)}"
	CASE OPR_委托子项
	CASE OPR_委托期限
		RETURNF @"{7}"
	;発生時ではなく受託時に確定します
	CASE OPR_委托发生率
	;これは他の固有依頼との相対確率なんで10％ではありません
		RETURNF @"{10}"
	CASE OPR_委托发生条件
		SIF GET_MAPID(CFLAG:11:現在位置) != 0 && CAN_MEET(11)
			RETURNF @"{1}"
	CASE OPR_委托受託可能条件
	;受託可能は@COM_ABLE366も確認のこと
	;ここを参照するのは依頼人をTARGETにしてる時なので素通しでよし
		RETURNF @"{1}"
	CASE OPR_委托实行可能条件
	;実行可能は@COM_ABLE367/@CAN_IRAI_SLOT_DOも確認のこと
	;素通しでよし
		RETURNF @"{1}"
	;成功/失敗処理はCARRYOUTで直接書く
	;SOURCEやITEM入手など、内容が複雑なので
	CASE OPR_委托消灭条件
	;30％で消失
		SIF RAND:100 < 30
			RETURNF @"{1}"
	ENDSELECT
ENDSELECT

;固有依頼の実処理用
;この関数は実行/成功/失敗時の
;報酬とペナルティと地の文のみを扱います
;各角色のメッセージは別所にて
@IRAI_固有159(CHARA, IRAI_ID, SCENE)
#DIM  CHARA
#DIM  IRAI_ID
#DIMS SCENE
#DIM  CLIENT_ID
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
SELECTCASE STR_DATA_IRAI(IRAI_ID, OPR_委托名, CLIENT_ID)
;个々の依頼名で分岐
CASE "一起看风景"
	SELECTCASE SCENE
	CASE OPR_委托条件表示
	;何か専用の表示情報を設けたい時用
	;受託済みの依頼表示で使用されます
	;
	;PRINT系だけでSOURCEとかは入れちゃダメ、WAITも無しで
	;ここ以外の表示項目は
	;PRINTFORML 　　　　　：
	;となっているのでスペースを揃えたほうが見栄えが良いです
	
	CASE OPR_委托实行时
	;依頼実行時にはRESULTが意味を持ちます
	;このCASEに限り、RESULTが意味を持ちます
	;依頼実行時のRESULTにはIRAI_CONST_RESULT()を使用してください
	;可能な引数は"中止", "実行して成功", "実行して失敗", "実行して未解決"です
	;独自処理を仕込みたい時は"実行して未解決"で先延ばしするなりしてください
	;
	;・実行時/成功報告/失敗報告で地の文をつけるとき是ずれも最後にWAITつけたほうがいい
	;・ただし、@CHANGE_CFLAGを使用と関数側でPRINTFORMWしてWAITが入る
		SOURCE:歓楽 = 1000
		SOURCE:情愛 = 300
		SOURCE:露出 = 20
		DOWNBASE:気力 += 50
        DOWNBASE:MASTER:気力 += 100
        PRINTFORMW %CALLNAME:TARGET%有意无意地散发着波纹能量，
        PRINTFORMW  让%CALLNAME:MASTER%就像沐浴在阳光里一样。
        PRINTFORMW  远方的云正在慢慢飘动着。
		;これは追加の10分
		TIME += 10
		;四割の確率でもっとやって！分岐
		IF RAND:100 < 60
			RETURN IRAI_CONST_RESULT("実行して未解決")
		ELSE
			RETURN IRAI_CONST_RESULT("実行して成功")
		ENDIF
	CASE OPR_委托成功时
	;成功報告時の報酬など
		SOURCE:歓楽 += 1000
		CALL CHANGE_CFLAG(2, TARGET, 20)
		CALL CHANGE_CFLAG(4, TARGET, 5)
		CALL GET_ITEM("大回復薬", 1, 2)
	CASE OPR_委托失败时
	;失敗報告時の処理
		CALL CHANGE_CFLAG(2, TARGET, -5)
		CALL CHANGE_CFLAG(4, TARGET, -3)
	ENDSELECT

CASE "灵梦的遗失物"
	SELECTCASE SCENE
	CASE OPR_委托条件表示
	CASE OPR_委托实行时
		SOURCE:歓楽 = 500
		PRINTFORMW %CALLNAME:MASTER%把遗落的东西送到了%CALLNAME:1%手上
		;システムメッセージつき好感度変化
		;最後の引数だけ好感度が変化
		CALL CHANGE_CFLAG(2, TARGET, 20)
		CALL CHANGE_CFLAG(4, TARGET, 10)
		RETURN IRAI_CONST_RESULT("実行して成功")
	CASE OPR_委托成功时
		SOURCE:TARGET:歓楽 += 1000
		;システムメッセージつき好感度変化
		;最後の引数だけ好感度が変化
		CALL CHANGE_CFLAG(2, TARGET, 20)
		;システムメッセージつき信赖度変化
		;最後の引数だけ信赖度が変化
		CALL CHANGE_CFLAG(4, TARGET, 10)
		CALL GET_MONEY_YEN(500, 2)
	CASE OPR_委托失败时
		CALL CHANGE_CFLAG(2, TARGET, -10)
		CALL CHANGE_CFLAG(4, TARGET, -10)
	ENDSELECT

ENDSELECT


