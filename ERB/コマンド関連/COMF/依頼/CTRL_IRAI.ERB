			ENDIF
		ENDIF
	CASE 4
		IF GET_MAPID(PLACE) == MAIN_MAP
			LOCALS += "好像在永远亭附近丢了。"
;		ELSEIF 洞察力>= 5
;			LOCALS += "永遠亭に行った日に失くしたらしい。"
		ELSEIF 洞察力 >= 3
			IF パターン == 1
				LOCALS += "好象在黑暗中丢了。"
			ELSE
				LOCALS += "好象在迷路的时候丢了。"
			ENDIF
		ENDIF
	CASE 5
		IF GET_MAPID(PLACE) == MAIN_MAP
			LOCALS += "好像在魔法之森丢了。"
;		ELSEIF 洞察力>= 5
;			LOCALS += "魔法之森に行った日に失くしたらしい。"
		ELSEIF 洞察力 >= 3
			IF パターン == 1
