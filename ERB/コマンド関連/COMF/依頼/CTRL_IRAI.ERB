;----------------------------------------------------------------------------------------------------
;依頼情報表示関数
;依頼ID単体でも使用できるが受託済みの場合は簡略化のためにSLOT番号を渡す
;フルネーム表記なのはわざとです（そのほうがお硬い文面っぽく見えるので）
;----------------------------------------------------------------------------------------------------
@SHOW_IRAI_DATA(IRAI_ID, CHK_SLOT)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM IRAI_ID   ;対象の依頼ID（依頼人情報含む）
#DIM CHK_SLOT  ;判定対象とする委托接口、未受託の状態では0で読んで下さい
#DIM CLIENT_ID ;依頼人ID
#DIM CHK_ID    ;依頼自体のID
#DIM DEAD_LINE ;期限日数
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
CHK_ID    = IRAI_ID % 1000
DEAD_LINE = INT_DATA_IRAI(IRAI_ID, OPR_委托期限, CLIENT_ID)
SIF CHK_SLOT
	PRINTFORML 委托%TOFULL(TOSTR(CHK_SLOT))%
PRINTFORML 　＜%STR_DATA_IRAI(IRAI_ID, OPR_委托名, CLIENT_ID)%＞
PRINTFORML 　　委托者：%NAME:CLIENT_ID%    -    %NAME_FROM_PLACE(CFLAG:CLIENT_ID:現在位置)%
PRINTFORML 　委托内容：%STR_DATA_IRAI(IRAI_ID, OPR_委托内容表示, CLIENT_ID)%
PRINTFORML 　　　报酬：%STR_DATA_IRAI(IRAI_ID, OPR_委托报酬表示, CLIENT_ID)%
SIF STRLENS(STR_DATA_IRAI(IRAI_ID, OPR_委托报告不要, CLIENT_ID))
	PRINTFORML 　　　报告：%STR_DATA_IRAI(IRAI_ID, OPR_委托报告不要, CLIENT_ID)%
SIF STRLENS(STR_DATA_IRAI(IRAI_ID, "依頼備考表示", CLIENT_ID))
	PRINTFORML 　　　备注：%STR_DATA_IRAI(IRAI_ID, "依頼備考表示", CLIENT_ID)%
;#;PRINTFORML 　　依頼ID：{IRAI_ID}　CLIENT_ID{CLIENT_ID}

;未受託の場合は期限のみ表示しておしまい
IF !CHK_SLOT
	IF !DEAD_LINE
		PRINTFORML 　　　期限：今日内
	ELSE
		PRINTFORML 　　　期限：{DEAD_LINE}日以内
	ENDIF
	RETURN
ELSE
	PRINTFORML 　　　期限：还有{IRAI_DEADLINE:CHK_SLOT - DAY}日
ENDIF

;ここから受託済み、業種別の表示
SELECTCASE IRAI_SLOT_TO_TASKNAME(CHK_SLOT)
CASE OPR_调达
	PRINTFORML 　　要求品：%ITEMNAME_TR((IRAI_SLOT_TO_ITEM(CHK_SLOT)))%×{IRAI_SUB:CHK_SLOT}
	SIF ITEMNAME:IRAI_SLOT_TO_ITEM(CHK_SLOT) == "好吃的魚"
		PRINTFORML 　　　　　（虹鳟・鲑鱼・西太公鱼・八目鳗・雷鱼）
CASE OPR_传令人物
	PRINTFORML 　目标人物：%NAME:(IRAI_SLOT_TO_PERSON(CHK_SLOT))%    -    %NAME_FROM_PLACE(CFLAG:(IRAI_SLOT_TO_PERSON(CHK_SLOT)):現在位置)%
	;PRINTFORML 　現在位置：%NAME_FROM_PLACE(CFLAG:(IRAI_SLOT_TO_PERSON(CHK_SLOT)):現在位置)% 
	PRINTFORML 　作息时间：{CFLAG:(IRAI_SLOT_TO_PERSON(CHK_SLOT)):就寝時間 / 60,2,RIGHT}～{CFLAG:(IRAI_SLOT_TO_PERSON(CHK_SLOT)):起床時間 / 60,2,RIGHT}时

CASE OPR_传令场所
	PRINTFORML 　　目的地：%COND_STR(@"%GET_MAPNAME(GET_MAPID(IRAI_SLOT_TO_PLACE(CHK_SLOT)))% - ", !IN_HOME(IRAI_SLOT_TO_PLACE(CHK_SLOT)))%%GET_PLACENAME(IRAI_SLOT_TO_PLACE(CHK_SLOT))%
;納茲琳に聞いても忘れる你(わたし)へ
CASE OPR_搜索人物
	IF IRAI_EX:CHK_SLOT
		PRINTFORML 　参考人物：%CALLNAME:(IRAI_EX:CHK_SLOT)%    -    %NAME_FROM_PLACE(CFLAG:(IRAI_SLOT_TO_PERSON(CHK_SLOT)):現在位置)%
		;PRINTFORML 　現在位置：%NAME_FROM_PLACE(CFLAG:(IRAI_EX:CHK_SLOT):現在位置)% 
		PRINTFORML 　作息时间：{CFLAG:(IRAI_EX:CHK_SLOT):就寝時間 / 60,2,RIGHT}～{CFLAG:(IRAI_EX:CHK_SLOT):起床時間 / 60,2,RIGHT}时
	ELSE
		PRINTFORM 　线索：
		CALL SHOW_IRAI_HINT(OPR_搜索人物, IRAI_SLOT_TO_PERSON(CHK_SLOT), IRAI_SUB:CHK_SLOT)
	ENDIF
CASE OPR_搜索场所
	IF IRAI_EX:CHK_SLOT > 5000
		PRINTFORML 　　推定地：%STR_TR(5000 + GET_MAPID(IRAI_EX:CHK_SLOT-5000))%
	ELSEIF IRAI_EX:CHK_SLOT
		PRINTFORML 　　推定地：%STR_TR(5000 + GET_MAPID(IRAI_EX:CHK_SLOT))%的%GET_PLACENAME(IRAI_EX:CHK_SLOT)%
	ELSE
		PRINTFORM 　线索：
		CALL SHOW_IRAI_HINT(OPR_搜索场所, IRAI_SLOT_TO_PLACE(CHK_SLOT), IRAI_SUB:CHK_SLOT)
	ENDIF
CASE OPR_讨伐
	PRINTFORML 　讨伐对象：%NAME:(IRAI_SLOT_TO_PERSON(CHK_SLOT))%    -    %NAME_FROM_PLACE(CFLAG:(IRAI_SLOT_TO_PERSON(CHK_SLOT)):現在位置)%
	PRINTFORM 　战力指数：
	CALL PRINT_RANK(ABL:IRAI_SLOT_TO_PERSON(CHK_SLOT):戦闘能力, "MAX_6")
	PRINTL
	;PRINTFORML 　現在位置：%NAME_FROM_PLACE(CFLAG:(IRAI_SLOT_TO_PERSON(CHK_SLOT)):現在位置)% 
	;PRINTFORML 　就寝時間：{CFLAG:(IRAI_SLOT_TO_PERSON(CHK_SLOT)):就寝時間 / 60,2,RIGHT}時 
	PRINTFORML 　作息时间：{CFLAG:(IRAI_SLOT_TO_PERSON(CHK_SLOT)):就寝時間 / 60,2,RIGHT}～{CFLAG:(IRAI_SLOT_TO_PERSON(CHK_SLOT)):起床時間 / 60,2,RIGHT}时
ENDSELECT
CALL IRAI_CARRYOUT(CLIENT_ID, IRAI_ID, OPR_委托条件表示)

;確定してる場合はその旨を表示しておしまい
IF GROUPMATCH(IRAI_CHARA_TO_PROGRESS(CLIENT_ID), OPR_期限切れ, OPR_报告忘れ, OPR_委托失败)
	PRINTFORML 　达成状况：失败
	RETURN
ELSEIF GROUPMATCH(IRAI_CHARA_TO_PROGRESS(CLIENT_ID), OPR_委托达成)
	PRINTFORML 　达成状况：已达成（未报告）
ENDIF
IF DAY == IRAI_DEADLINE:CHK_SLOT || IRAI_DEADLINE:CHK_SLOT - DAY <= 0
	PRINTFORML 　　　期限：今日内
ELSEIF IRAI_DEADLINE:CHK_SLOT > DAY
	PRINTFORML 　　　期限：还剩{IRAI_DEADLINE:CHK_SLOT - DAY}日
ELSE
	PRINTFORML 　　　期限：今日内
ENDIF

;----------------------------------------------------------------------------------------------------
;依頼情報内のヒント表示
;DYNAMIC部分はSHOW_TASTEを参考,助手効果のデータだけを抽出する
;----------------------------------------------------------------------------------------------------
@SHOW_IRAI_HINT(TASKNAME, ARG, パターン)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS TASKNAME
#DIM CHARA
#DIM PLACE
#DIM パターン
#DIM 洞察力
#DIMS DYNAMIC LIST, 100 ;列表
#DIM  DYNAMIC CNT,  100 ;列表各要素の重複个数
#DIM  DYNAMIC NUM       ;種類の総数
;◆洞察力に関して
;元々はEXP:依頼達成経験とABL:依頼こ無レベルを設定して、依頼をこなすほど洞察力(=依頼レベル)が増えるという風にしようと思っていた
;が、わざわざ作らなくてもプレイヤー側のリアル洞察力の方が必要なので凍結させました。
LOCALS = 
;持ち主を推定する,現状パターンは1～3,パターン0は場所の方へ
IF TASKNAME == OPR_搜索人物 && パターン > 0
	CHARA = ARG
	洞察力 = 100
	CALL DISH_TASTE_FROM_CHARA(CHARA, "OUTPUT")
	CALLF CNT_SPLIT(RESULTS, LIST, CNT, NUM)
	FOR LOCAL, 0, NUM
		SELECTCASE LIST:LOCAL
		CASE "神力"
