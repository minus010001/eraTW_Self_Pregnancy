			LOCALS += "好像在红魔馆附近丢了。"
;		ELSEIF 洞察力>= 4
;			LOCALS += "紅魔館に行った日に失くしたらしい。"
		ELSEIF 洞察力 >= 2
			IF パターン == 1
				LOCALS += "好像是宴会的那天丢了。"
			ELSE
