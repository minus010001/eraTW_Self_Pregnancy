;----------------------------------------------------------------------------------------------------
;依頼関連の口上呼び出し関数
;----------------------------------------------------------------------------------------------------
@SHOW_IRAI_MESSAGE(CHARA, IRAI_ID, SCENE)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM  CHARA
#DIM  IRAI_ID
#DIMS SCENE
RESULTS =
IF SCENE == OPR_委托报告不要
	CALL KOJO_MESSAGE_SEND("IRAI", CHARA, IRAI_ID, 0, 0, OPR_无需报告, SCENE)
ELSEIF CHARA == IRAI_ID_TO_CLIENT(IRAI_ID)
;対象が依頼者である
	CALL KOJO_MESSAGE_SEND("IRAI", CHARA, IRAI_ID, 0, 0, OPR_委托人, SCENE)
ELSE
;この場合はおおむねSCENEはOPR_委托实行时になるが一応渡す
	CALL KOJO_MESSAGE_SEND("IRAI", CHARA, IRAI_ID, 0, 0, OPR_目标, SCENE)
ENDIF
