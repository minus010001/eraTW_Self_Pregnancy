;----------------------------------------------------------------------------------------------------
;依頼受託処理
;----------------------------------------------------------------------------------------------------
@SET_IRAI_SLOT(CHARA)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM CHARA
#DIM IRAI_ID
#DIM CHK_SLOT
IRAI_ID = CFLAG:CHARA:依頼内容
CHK_SLOT = SEARCH_IRAI_EMPTY()
SIF !CHK_SLOT
	RETURN
IRAI_SLOT:CHK_SLOT     = IRAI_ID
IRAI_DATA:CHK_SLOT     = INT_DATA_IRAI(IRAI_ID, OPR_委托内容,     CHARA)
IRAI_SUB:CHK_SLOT      = INT_DATA_IRAI(IRAI_ID, OPR_委托子项,     CHARA)
IRAI_DEADLINE:CHK_SLOT = INT_DATA_IRAI(IRAI_ID, OPR_委托期限, CHARA) + DAY
CALL SET_IRAI_PROGRESS(CHARA, OPR_委托中)

;----------------------------------------------------------------------------------------------------
;依頼終了処理
;----------------------------------------------------------------------------------------------------
@CLEAR_IRAI_SLOT(CHARA, CHK_SLOT, SCENE)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM  CHARA
#DIM  IRAI_ID
#DIM  CHK_SLOT
#DIMS SCENE
ARRAYREMOVE IRAI_SLOT,     CHK_SLOT, 1
ARRAYREMOVE IRAI_DATA,     CHK_SLOT, 1
ARRAYREMOVE IRAI_SUB,      CHK_SLOT, 1
ARRAYREMOVE IRAI_EX,       CHK_SLOT, 1
ARRAYREMOVE IRAI_DEADLINE, CHK_SLOT, 1
ARRAYREMOVE IRAI_STR,      CHK_SLOT, 1
CALL SET_IRAI_PROGRESS(CHARA, SCENE)



;----------------------------------------------------------------------------------------------------
;依頼発生処理
;随意10角色見繕って依頼を作るよ
;----------------------------------------------------------------------------------------------------
@IRAI_HAPPEN
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM CHARA_ID, 10
#DIM CONST NEW_IRAI_NUM = 10
;委托debug
[IF DEBUG]
	;#;PRINTFORMW 依頼生成処理（全角色実行、ログをデバッグウインドウに表示）
	;#;DEBUGCLEAR
	FOR LOCAL:0, 1, 人物数量上限
		SIF !CAN_MEET(LOCAL:0)
			CONTINUE
		SIF CFLAG:(LOCAL:0):依頼状況
			CONTINUE
		CALL SET_NEW_IRAI(LOCAL:0)
	NEXT
	;#;PRINTFORML 委托生成完了、デバッグ文を削除します
	;#;FORCEWAIT
	;#;DEBUGCLEAR
	RETURN
[ENDIF]
CALL ARRAY_RAND(CHARA_ID, NEW_IRAI_NUM, 1, 人物数量上限)
FOR LOCAL:0, 0, NEW_IRAI_NUM
	SIF !CAN_MEET(CHARA_ID:(LOCAL:0))
		CONTINUE
	SIF CFLAG:(CHARA_ID:(LOCAL:0)):依頼状況
		CONTINUE
	CALL SET_NEW_IRAI(CHARA_ID:(LOCAL:0))
NEXT



;----------------------------------------------------------------------------------------------------
;各角色の依頼発生処理
;依頼無/一般依頼/固有依頼
;----------------------------------------------------------------------------------------------------
@SET_NEW_IRAI(CHARA)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM CHARA
CALL IRAI_HIT(CHARA, "HAPPEN")
SELECTCASE RESULT
CASE IS <= 0
	RETURN
CASE 1
	CALL IRAI_HIT(CHARA, "COMMON")
	LOCAL = RESULT
	SIF !LOCAL
		RETURN
CASE 2
	CALL IRAI_HIT(CHARA, "UNIQUE")
	LOCAL = RESULT
	SIF LOCAL <= 100
		RETURN
ENDSELECT
CALL SET_IRAI_PROGRESS(CHARA, OPR_委托发生直后)
CFLAG:CHARA:依頼内容 = MAKE_IRAI_ID(CHARA, LOCAL)



;----------------------------------------------------------------------------------------------------
;依頼抽選処理はまとめてここに
;----------------------------------------------------------------------------------------------------
@IRAI_HIT(CHARA, TYPE)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM  CHARA
#DIMS TYPE
#DIM CONST LAST_COMMON = 99 ;一般依頼IDの末端
#DIM       LAST_UNIQUE      ;その角色に実装されている固有依頼IDの末端
#DIM       HIT_LIST, 100    ;抽選確率配列
#DIM       ID_LIST,  100    ;抽選を対象依頼IDの一覧
#DIM       CNT_LIST         ;抽選対象となる依頼の数
DEBUGPRINTFORML ＞IRAI_HIT{CHARA}　%TYPE%
SELECTCASE TYPE
CASE "HAPPEN"
;依頼発生抽選
	HIT_LIST:0 = GETMETH_INT(0, "キャラデータ", CHARA, "没有依頼発生率")
	HIT_LIST:1 = GETMETH_INT(0, "キャラデータ", CHARA, "一般依頼発生率")
	HIT_LIST:2 = GETMETH_INT(0, "キャラデータ", CHARA, "固有依頼発生率")
	SIF !SUMARRAY(HIT_LIST, 0, 3)
		HIT_LIST = 7, 3, 0
	DEBUGPRINTFORML ＞IRAI_HIT{CHARA}　{HIT_LIST:0}/{HIT_LIST:1}/{HIT_LIST:2}
	RETURN ARRAY_HIT(HIT_LIST, 3)
CASE "COMMON"
;一般依頼の抽選
	VARSET HIT_LIST
	VARSET ID_LIST
	VARSET CNT_LIST
	FOR LOCAL:0, 1, LAST_COMMON + 1
		SIF !INT_DATA_IRAI(MAKE_IRAI_ID(CHARA, LOCAL:0), OPR_委托发生条件, CHARA)
			CONTINUE
		CALL KOJO_CHECK(CHARA, "IRAI_BLOCKED",,LOCAL:0)
		SIF RESULT
			CONTINUE

		ID_LIST:CNT_LIST  = LOCAL:0
		HIT_LIST:CNT_LIST = INT_DATA_IRAI(MAKE_IRAI_ID(CHARA, LOCAL:0), OPR_委托发生率, CHARA)
		CNT_LIST ++
	NEXT
	SIF !CNT_LIST
		RETURN 0
	RETURN ID_LIST:(ARRAY_HIT(HIT_LIST, CNT_LIST))
CASE "UNIQUE"
;固有依頼の抽選
	VARSET HIT_LIST
	VARSET ID_LIST
	VARSET CNT_LIST
	LAST_UNIQUE = GETMETH_INT(0, "キャラデータ", CHARA, "固有依頼最終要素")
	FOR LOCAL:0, 101, LAST_UNIQUE + 1
		SIF !INT_DATA_IRAI(MAKE_IRAI_ID(CHARA, LOCAL:0), OPR_委托发生条件, CHARA)
			CONTINUE
		CALL KOJO_CHECK(CHARA, "IRAI_BLOCKED",,LOCAL:0)
		SIF RESULT
			CONTINUE
		ID_LIST:CNT_LIST  = LOCAL:0
		HIT_LIST:CNT_LIST = INT_DATA_IRAI(MAKE_IRAI_ID(CHARA, LOCAL:0), OPR_委托发生率, CHARA)
		CNT_LIST ++
	NEXT
	SIF !CNT_LIST
		RETURN 0
	RETURN ID_LIST:(ARRAY_HIT(HIT_LIST, CNT_LIST))
ENDSELECT



;----------------------------------------------------------------------------------------------------
;依頼消滅処理
;全角色が対象となり大規模化した
;----------------------------------------------------------------------------------------------------
@IRAI_VANISH
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM CHK_SLOT
#DIM CHARA
;PRINTFORMW 委托经过处理（所有角色执行，日志显示在调试窗口）
;DEBUGCLEAR
;全角色対象、受託前の/既に報告の終わった依頼の処理
FOR CHARA, 1, CHARANUM
	SELECTCASE IRAI_CHARA_TO_PROGRESS(CHARA)
	;これらはまだ委托接口に入っていない
	CASE OPR_委托发生直后
		CALL SET_IRAI_PROGRESS(CHARA, OPR_委托未受託)
		
	CASE OPR_委托未受託
		SIF INT_DATA_IRAI(CFLAG:CHARA:依頼内容, OPR_委托消灭条件, CHARA)
			CALL SET_IRAI_PROGRESS(CHARA, OPR_委托消灭)
	[SKIPSTART]
	依頼中のケースは委托接口見たほうがはやい
	CASE OPR_委托中
	
	基本的にこの4段階は未報告状態、依頼主のリアクション待ちです（報告必须）
	CASE OPR_委托达成
	CASE OPR_期限切れ
	CASE OPR_报告忘れ
	CASE OPR_委托失败
	[SKIPEND]
	CASE OPR_委托终了成功, OPR_委托终了期限切れ, OPR_委托终了报告忘れ, OPR_委托终了失败
	;依頼が終了し、依頼人に報告を行なったパターン（スロットに入ってない）
		CALL SET_IRAI_PROGRESS(CHARA, OPR_委托消灭)
	ENDSELECT
NEXT
;PRINTFORML 委托经过处理完成，删除调试语句
;FORCEWAIT
;DEBUGCLEAR

SIF !COUNT_IRAI_SLOT()
	RETURN

;PRINTFORMW 委托期限处理（全角色执行，日志显示在调试窗口）
;依頼の期限判定
;スロットは空けないことにした（依頼主への報告を強制させる）
;依頼報告不要時にスロットを空ける処理が必要になった
;スロット1から見ていくと依頼のリセットによってIDズレが発生するので末尾からチェックする
FOR CHK_SLOT, COUNT_IRAI_SLOT(), 0, -1
	CHARA = IRAI_SLOT_TO_CLIENT(CHK_SLOT)
	;期限による依頼の失敗判定
	;期限が残ってるならスルー
	SIF IRAI_DEADLINE:CHK_SLOT && DAY <= IRAI_DEADLINE:CHK_SLOT
		CONTINUE
	SELECTCASE IRAI_CHARA_TO_PROGRESS(CHARA)
	CASE OPR_委托中
		CALL SET_IRAI_PROGRESS(CHARA, OPR_期限切れ)
	CASE OPR_委托达成
		IF STRLENS(STR_DATA_IRAI(IRAI_SLOT:CHK_SLOT, OPR_委托报告不要, CHARA))
			CALL IRAI_CARRYOUT(CHARA, IRAI_SLOT:CHK_SLOT, OPR_委托报告不要)
			CALL SHOW_IRAI_MESSAGE(CHARA, IRAI_SLOT:CHK_SLOT, OPR_委托报告不要)
			CALL CLEAR_IRAI_SLOT(CHARA, CHK_SLOT, OPR_委托消灭)
		ELSE
			CALL SET_IRAI_PROGRESS(CHARA, OPR_报告忘れ)
		ENDIF
	ENDSELECT
NEXT
;PRINTFORML 委托期限处理完成，删除调试语句
;FORCEWAIT
;DEBUGCLEAR


;----------------------------------------------------------------------------------------------------
;依頼内容の実行処理
;実行時のSOURCEの変化の他、報酬や失敗による処理も含む
;----------------------------------------------------------------------------------------------------
@IRAI_CARRYOUT(CHARA, IRAI_ID, SCENE)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM  CHARA
#DIM  IRAI_ID
#DIMS SCENE
RESULT = 0
IF IS_COMMON_IRAI(IRAI_ID)
	TRYCCALLFORM IRAI_一般{IRAI_ID % 1000}(CHARA, IRAI_ID, SCENE)
	CATCH
		PRINTFORML ＊发生错误＊
		PRINTFORML 　CHARA:{CHARA}　SCENE:%SCENE%　IRAI_ID:{IRAI_ID}
		PRINTFORML 　指定的函数 @IRAI_一般{IRAI_ID % 1000}不存在
		PRINTFORML 　请复制粘贴错误日志并报告
		PRINTFORML 
		PRINTFORMW 　等待输入
	ENDCATCH
ELSE
	TRYCCALLFORM IRAI_固有{IRAI_ID_TO_CLIENT(IRAI_ID)}(CHARA, IRAI_ID, SCENE)
	CATCH
		PRINTFORML ＊发生错误＊
		PRINTFORML 　CHARA:{CHARA}　SCENE:%SCENE%　IRAI_ID:{IRAI_ID}
		PRINTFORML 　指定的函数 @IRAI_固有{IRAI_ID_TO_CLIENT(IRAI_ID)}不存在
		PRINTFORML 　请复制粘贴错误日志并报告
		PRINTFORML 
		PRINTFORMW 　等待输入
	ENDCATCH
ENDIF
RETURN RESULT
;RESULTと依頼実行判定結果の対応はIRAI_CONST_RESULT(TYPE)を参照のこと



