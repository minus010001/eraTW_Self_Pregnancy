@F固有依頼14(ARG, O_DATA, V_NAME)
#FUNCTIONS
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE ARG % 1000
;ID101：来ー！玩ー！吧ー！
CASE 101
	SELECTCASE O_DATA
	CASE OPR_委托名
		RETURNF "来ー！玩ー！吧ー！"
	CASE OPR_委托内容表示
		RETURNF "一起玩"
	CASE OPR_委托报酬表示
		RETURNF "好东西"
	CASE OPR_委托实行指令名
		RETURNF "陪着玩"
		
	CASE OPR_委托内容
		RETURNF @"{MAKE_IRAI_DATA(0, OPR_作业)}"
	CASE OPR_委托子项
	CASE OPR_委托期限
	CASE OPR_委托发生率
	;これは他の固有依頼との相対確率なんで10％ではありません
		RETURNF @"{10}"
	CASE OPR_委托发生条件
		RETURNF @"{1}"
	CASE OPR_委托受託可能条件
	;受託可能は@COM_ABLE366も確認のこと
	;ここを参照するのは依頼人をTARGETにしてる時なので素通しでよし
		RETURNF @"{1}"
	CASE OPR_委托实行可能条件
	;実行可能は@COM_ABLE367も確認のこと
		IF SHIRAHU(TARGET) != 1
		ELSE
			RETURNF @"{1}"
		ENDIF
	;成功/失敗処理はCARRYOUTで直接書く
	;SOURCEやITEM入手など、内容が複雑なので
	CASE OPR_委托消灭条件
	;30％で消失
		SIF RAND:100 < 30
			RETURNF @"{1}"
	ENDSELECT
ENDSELECT



;固有依頼の設定用
;この関数は実行/成功/失敗時の
;報酬とペナルティと地の文のみを扱います
;各角色のメッセージは別所にて
@IRAI_固有14(CHARA, IRAI_ID, SCENE)
#DIM  CHARA
#DIM  IRAI_ID
#DIMS SCENE
#DIM  CLIENT_ID
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
SELECTCASE STR_DATA_IRAI(IRAI_ID, OPR_委托名, CLIENT_ID)
;个々の依頼名で分岐
CASE "来ー！玩ー！吧ー！"
	SELECTCASE SCENE
	CASE OPR_委托条件表示
	;何か専用の表示情報を設けたい時用
	;受託済みの依頼表示で使用されます
	;
	;PRINT系だけでSOURCEとかは入れちゃダメ、WAITも無しで
	;ここ以外の表示項目は
	;PRINTFORML 　　　　　：
	;となっているのでスペースを揃えたほうが見栄えが良いです
	
	CASE OPR_委托实行时
	;このCASEに限り、RESULTが意味を持ちます
	;依頼実行時のRESULTにはIRAI_CONST_RESULT()を使用してください
	;可能な引数は"中止", "実行して成功", "実行して失敗", "実行して未解決"です
	;独自処理を仕込みたい時は"実行して未解決"で先延ばしするなりしてください
		SOURCE:歓楽 = 1500
		PRINTFORMW %CALLNAME:MASTER%和%CALLNAME:TARGET%玩了投接球游戏
		PRINTFORMW %CALLNAME:TARGET%终始带着天真的笑容
		PRINTL
		TIME += 20
		DOWNBASE:体力 = 150
		DOWNBASE:気力 = 100
		DOWNBASE:MASTER:体力 = 150
		DOWNBASE:MASTER:気力 = 100
		RETURN IRAI_CONST_RESULT("実行して成功")
	CASE OPR_委托成功时
	;成功報告時の報酬など
		TALENT:TARGET:心情 = LIMIT(TALENT:心情 + 1, -1, 1)
		CALL CHANGE_CFLAG(2, 14, 30)
		CALL CHANGE_CFLAG(4, 14, 15)
		CALL GET_ITEM("青蛙", 1, 1)
		PRINTFORMW ……这个青蛙、要怎么办？
	CASE OPR_委托失败时
	;失敗報告時の処理
	ENDSELECT
ENDSELECT
