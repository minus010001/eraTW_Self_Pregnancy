;-------------------------------------------------
;実行判定
;-------------------------------------------------
@COM_ABLE366
#LOCALSIZE 1
#LOCALSSIZE 1
SIF !TFLAG:100
	RETURN 0
SIF TARGET <= 0
	RETURN 0
;時間停止/睡眠/添い寝/诶嘿嘿中は不可
SIF SHIRAHU(TARGET) != 1
	RETURN 0
;一括管理
SIF GLOBAL_COMABLE(366)
	RETURN RESULT

SELECTCASE IRAI_CHARA_TO_PROGRESS(TARGET)
CASE OPR_委托未受託
;空きスロットが無いなら不可
	SIF !SEARCH_IRAI_EMPTY()
		RETURN 0
;個々に指定された条件をみたさない時
	IF !IS_DEBUG_IRAI(TARGET)
		SIF !INT_DATA_IRAI(CFLAG:TARGET:依頼内容, OPR_委托受託可能条件, TARGET)
			RETURN 0
	ENDIF
CASE OPR_委托中
;依頼確認/破棄が可能
CASE OPR_委托达成
;成功報告可能
CASE OPR_期限切れ, OPR_报告忘れ, OPR_委托失败
;失敗報告
CASE OPR_委托终了成功, OPR_委托终了期限切れ, OPR_委托终了报告忘れ, OPR_委托终了失败
;ここは依頼フラグの消滅待ちなんで触らない
		RETURN 0
CASEELSE
	;魔改内容，诱导逆推
	SIF CFLAG:TARGET:依頼状況 == 0 && GETBIT(诱导逆推_进程:TARGET:0, 0) && 诱导逆推_开关
		RETURN 1

		RETURN 0
ENDSELECT
RETURN 1

@COM366_DISPLAY
#FUNCTIONS
#LOCALSIZE 1
#LOCALSSIZE 1
;魔改功能，诱导逆推
IF (GROUPMATCH(IRAI_CHARA_TO_PROGRESS(TARGET), OPR_委托达成, OPR_委托失败) || (CFLAG:TARGET:依頼状況 == 0 && GETBIT(诱导逆推_进程:TARGET:0, 10) && 诱导逆推_目前不可进行(TARGET) && 诱导逆推_开关))
	TEMP_COM_DISPLAY_COLOR = C_GREEN
	RETURNF "依頼の報告"
;魔改功能，诱导逆推
ELSEIF (GROUPMATCH(IRAI_CHARA_TO_PROGRESS(TARGET), OPR_委托未受託) || (CFLAG:TARGET:依頼状況 == 0 && GETBIT(诱导逆推_进程:TARGET:0, 0) && 诱导逆推_开关))
	TEMP_COM_DISPLAY_COLOR = C_GREEN
	RETURNF "依頼を聞く"
ENDIF

@COM366
#LOCALSIZE 1
#LOCALSSIZE 1
;魔改内容，诱导逆推
IF CFLAG:TARGET:依頼状況 == 0 && GETBIT(诱导逆推_进程:TARGET:0, 10)
	CALL 诱导逆推_强行结束(TARGET)
	RETURN RESULT
ENDIF
IF CFLAG:TARGET:依頼状況 == 0 && GETBIT(诱导逆推_进程:TARGET:0, 0)
	CALL 诱导逆推_询问(TARGET)
	RETURN RESULT
ENDIF

SELECTCASE IRAI_CHARA_TO_PROGRESS(TARGET)
CASE OPR_委托未受託
	CALL IRAI_START(TARGET)
	RETURN RESULT
CASE OPR_委托中
	CALL IRAI_LOOK(TARGET)
	RETURN RESULT
CASE OPR_委托达成, OPR_期限切れ, OPR_报告忘れ, OPR_委托失败
	CALL IRAI_REPORT(TARGET)
	RETURN 1
ENDSELECT



;-------------------------------------------------
;依頼受託
;21/08/25 受諾時に一部依頼内容を表示するように変更
;-------------------------------------------------
@IRAI_START(CHARA)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC CHARA
#DIM DYNAMIC 受諾		;受託依頼が入ったスロット番号
#DIM DYNAMIC 依頼ＩＤ	;依頼自体のID
#DIMS DYNAMIC 味タグ一覧, 50
#DIM DYNAMIC 味タグ数
#DIM DYNAMIC 味タグ位置
;依頼提示時
PRINTFORMW %CALLNAME:CHARA%好像有事想要拜托%CALLNAME:MASTER%
CALL SHOW_IRAI_MESSAGE(CHARA, CFLAG:CHARA:依頼内容, OPR_委托提示时)
CALL SHOW_IRAI_DATA(CFLAG:CHARA:依頼内容, 0)
CALL ASK_YN("接受委托", "拒绝")
IF RESULT
	PRINTFORML %CALLNAME:MASTER%婉言拒绝了
	CALL SHOW_IRAI_MESSAGE(CHARA, CFLAG:CHARA:依頼内容, OPR_委托非受託时)
	PRINTFORMW %CALLNAME:CHARA%看起来很可惜的样子
	RETURN -1
ELSE
	受諾 = SEARCH_IRAI_EMPTY()
	CALL SET_IRAI_SLOT(CHARA)
	依頼ＩＤ = (CFLAG:CHARA:依頼内容) % 1000
	PRINTFORML %CALLNAME:MASTER%接受了%CALLNAME:CHARA%的委托
	SELECTCASE IRAI_SLOT_TO_TASKNAME(受諾)
		CASE OPR_传令人物
			;固有依頼は提示済なのでカット
			SIF 依頼ＩＤ < 100
				PRINTFORML 得到了一封写给%CALLNAME:(IRAI_SLOT_TO_PERSON(受諾))%的信
		CASE OPR_搜索人物
			IF 依頼ＩＤ == 9
				PRINTFORML %CALLNAME:CHARA%将失物递过来了
				PRINTFORM 物品的特征：
			ELSE
				PRINTFORM 线索：
			ENDIF
			CALL SHOW_IRAI_HINT(OPR_搜索人物, IRAI_SLOT_TO_PERSON(受諾), IRAI_SUB:受諾)
		CASE OPR_搜索场所
			PRINTFORM 线索：
			CALL SHOW_IRAI_HINT(OPR_搜索场所, IRAI_SLOT_TO_PLACE(受諾), IRAI_SUB:受諾)
		CASE OPR_讨伐
			PRINTFORML 弾幕勝負的对手是%CALLNAME:(IRAI_SLOT_TO_PERSON(受諾))%
		CASE OPR_其他
			IF 依頼ＩＤ == 17
				IF STRLENS(IRAI_STR:受諾) == 0
					IRAI_STR:受諾 = %IRAI_一般17_味設定(CHARA)%
				ENDIF
				SPLIT IRAI_STR:受諾, "/", 味タグ一覧, 味タグ数
				RESULTS:0 = 
				FOR 味タグ位置, 0, 味タグ数
					SIF STRLENS(味タグ一覧:味タグ位置) == 0
						CONTINUE
					RESULTS:0 += TASTE_TR(味タグ一覧:味タグ位置)
					SIF 味タグ位置 < 味タグ数 - 1
						RESULTS:0 += "、"
				NEXT
				PRINTFORML 大概是一道有%RESULTS:0%味道的菜肴
				RESULTS:0 =
			ELSEIF 依頼ＩＤ == 18
				CALL IRAI_CARRYOUT(CHARA, 依頼ＩＤ, OPR_委托条件表示)
			ENDIF
	ENDSELECT
	WAIT
	CALL SHOW_IRAI_MESSAGE(CHARA, CFLAG:CHARA:依頼内容, OPR_委托受託时)
	RETURN 1
ENDIF



;-------------------------------------------------
;依頼確認/破棄
;-------------------------------------------------
@IRAI_LOOK(CHARA)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC CHARA
#DIM DYNAMIC CHK_SLOT
CHK_SLOT = SEARCH_IRAI_SLOT(CFLAG:CHARA:依頼内容)
CALL SHOW_IRAI_MESSAGE(CHARA, CFLAG:CHARA:依頼内容, OPR_委托确认时)
CALL SHOW_IRAI_DATA(CFLAG:CHARA:依頼内容, CHK_SLOT)
CALL ASK_YN("确认", "破弃")
SIF !RESULT
	RETURN -1
PRINTFORML 真的么？
CALL ASK_YN
SIF RESULT
	RETURN -1
CALL SHOW_IRAI_MESSAGE(CHARA, CFLAG:CHARA:依頼内容, OPR_委托破棄时)
PRINTFORMW 放弃了委托。
CALL CLEAR_IRAI_SLOT(CHARA, CHK_SLOT, OPR_委托终了失败)



;-------------------------------------------------
;依頼報告
;-------------------------------------------------
@IRAI_REPORT(CHARA)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC CHARA
#DIM DYNAMIC CHK_SLOT
CHK_SLOT = SEARCH_IRAI_SLOT(CFLAG:CHARA:依頼内容)
;依頼成功時
;依頼失敗時
SELECTCASE IRAI_CHARA_TO_PROGRESS(CHARA)
CASE OPR_委托达成
	CALL SHOW_IRAI_MESSAGE(CHARA, CFLAG:CHARA:依頼内容, OPR_成功报告时)
	CALL IRAI_CARRYOUT(CHARA, CFLAG:CHARA:依頼内容, OPR_委托成功时)
	SIF MAGIC_DLC_宝藏袋
		CALL GET_ITEM("宝藏袋", 10 + TALENT:MASTER:黄金律 * MAGIC_DLC_魔法成就 * 3, 1)
CASE OPR_期限切れ, OPR_报告忘れ, OPR_委托失败
	CALL SHOW_IRAI_MESSAGE(CHARA, CFLAG:CHARA:依頼内容, OPR_失败报告时)
	CALL IRAI_CARRYOUT(CHARA, CFLAG:CHARA:依頼内容, OPR_委托失败时)
ENDSELECT

;乐谱入手処理
SELECTCASE IRAI_CHARA_TO_PROGRESS(CHARA)
CASE OPR_委托达成
	PRINTL
	SELECTCASE CHARA
	CASE 5,6,7,13,14
		RESULT = 乐谱入手_特殊条件(乐谱入手方法：妖精依頼成功)
	CASE 29
		RESULT = 乐谱入手_特殊条件(乐谱入手方法：文依頼成功)
	CASE 42
		RESULT = 乐谱入手_特殊条件(乐谱入手方法：極依頼成功)
	ENDSELECT
CASE OPR_委托失败
	IF (RAND:(100) < 30)
		PRINTL
		RESULT = 乐谱入手_特殊条件(乐谱入手方法：依赖失敗時)
	ENDIF
ENDSELECT

SELECTCASE IRAI_CHARA_TO_PROGRESS(CHARA)
CASE OPR_委托达成
	CALL CLEAR_IRAI_SLOT(CHARA, CHK_SLOT, OPR_委托终了成功)
CASE OPR_期限切れ
	CALL CLEAR_IRAI_SLOT(CHARA, CHK_SLOT, OPR_委托终了期限切れ)
CASE OPR_报告忘れ
	CALL CLEAR_IRAI_SLOT(CHARA, CHK_SLOT, OPR_委托终了报告忘れ)
CASE OPR_委托失败
	CALL CLEAR_IRAI_SLOT(CHARA, CHK_SLOT, OPR_委托终了失败)
ENDSELECT
