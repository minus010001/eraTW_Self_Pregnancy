@F固有依頼139(ARG, O_DATA, V_NAME)
#FUNCTIONS
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE ARG % 1000
;ID101：分一些精液
CASE 101
	SELECTCASE O_DATA
	CASE OPR_委托名
		RETURNF "分一些精液"
	CASE OPR_委托内容表示
		RETURNF "提供浓厚的精液"
	CASE OPR_委托报酬表示
		RETURNF @"%金額表示(50000)%"
	CASE OPR_委托实行指令名
		RETURNF "采集精液"
		
	CASE OPR_委托内容
		RETURNF @"{MAKE_IRAI_DATA(0, OPR_作业)}"
	CASE OPR_委托子项
	CASE OPR_委托期限
	;発生時ではなく受託時に確定します
		RETURNF @"{30}"
	CASE OPR_委托发生率
	;これは他の固有依頼との相対確率なんで10％ではありません
		IF TCVAR:[[典]]:発情 || CFLAG:[[典]]:溜まってる度 >= 750
			RETURNF @"{100}"
		ELSE
			RETURNF @"{20}"
		ENDIF
	CASE OPR_委托发生条件
	SIF EXP:[[典]]:精液経験 > 0 && HAS_PENIS(MASTER)
		RETURNF @"{1}"
	CASE OPR_委托受託可能条件
	;受託可能は@COM_ABLE366も確認のこと
	;ここを参照するのは依頼人をTARGETにしてる時なので素通しでよし
		RETURNF @"{1}"
	CASE OPR_委托实行可能条件
	;実行可能は@COM_ABLE367も確認のこと
		IF FLAG:70
		ELSE
			;SIF TALENT:MASTER:濃厚精液
			RETURNF @"{1}"
		ENDIF
	;成功/失敗処理はCARRYOUTで直接書く
	;SOURCEやITEM入手など、内容が複雑なので
	CASE OPR_委托消灭条件
	;30％で消失
		SIF RAND:100 < 30
			RETURNF @"{1}"
	ENDSELECT
ENDSELECT



;固有依頼の設定用
;この関数は実行/成功/失敗時の
;報酬とペナルティと地の文のみを扱います
;各角色のメッセージは別所にて
@IRAI_固有139(CHARA, IRAI_ID, SCENE)
#DIM  CHARA
#DIM  IRAI_ID
#DIMS SCENE
#DIM  CLIENT_ID
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
SELECTCASE STR_DATA_IRAI(IRAI_ID, OPR_委托名, CLIENT_ID)
	
CASE "分一些精液"
	SELECTCASE SCENE
	CASE OPR_委托条件表示
	;何か専用の表示情報を設けたい時用
	;受託済みの依頼表示で使用されます
	;
	;PRINT系だけでSOURCEとかは入れちゃダメ、WAITも無しで
	;ここ以外の表示項目は
	;PRINTFORML 　　　　　：
	;となっているのでスペースを揃えたほうが見栄えが良いです
	
	CASE OPR_委托实行时
	;このCASEに限り、RESULTが意味を持ちます
	;依頼実行時のRESULTにはIRAI_CONST_RESULT()を使用してください
	;可能な引数は"中止", "実行して成功", "実行して失敗", "実行して未解決"です
	;独自処理を仕込みたい時は"実行して未解決"で先延ばしするなりしてください
		DOWNBASE:MASTER:気力 += 50
		DOWNBASE:MASTER:精力 += 250
		IF TALENT:139:処女 == 1
			IF EXP:口淫経験 > 0
				PRINTFORMW %CALLNAME:MASTER%一边想象着典用嘴拔蘑菇的情景、一边撸着…
			ELSE
				PRINTFORMW %CALLNAME:MASTER%一边想象着典的裸体、一边撸着…
			ENDIF
		ELSE
			PRINTFORMW %CALLNAME:MASTER%一边回想着与典的性交、一边撸着…
		ENDIF
		TIME += 10
			IF TALENT:MASTER:濃厚精液
				PRINTFORML 在典给予的试管里、注入了满满的浓如浆糊的精液…
				PRINTFORML 无论是量还是黏度都无可挑剔吧
				PRINTW 
				RETURN IRAI_CONST_RESULT("実行して成功")
			ELSE
				PRINTFORML 在典给予的试管里、注满了精液…
				PRINTFORML 但是、典的委托索要的精液需要是浓厚的
				PRINTFORML 这种的话应该不会被接受吧
				PRINTL 
				PRINTFORML ※还是改日等在[浓厚精液]状态下再进行吧
				PRINTW 
				RETURN IRAI_CONST_RESULT("実行して未解決")
			ENDIF
			SOURCE:MASTER:達成 = 500
	CASE OPR_委托成功时
	;成功報告時の報酬など
		CALL KIGEN_CHANGE(TARGET, 100, 1)
		SOURCE:TARGET:歓楽 = 1000
		SOURCE:TARGET:征服 = 500
		SOURCE:TARGET:達成 = 500
		SOURCE:TARGET:欲情 = 3000
		SOURCE:MASTER:欲情 = 1000
		;システムメッセージつき好感度変化
		;最後の引数だけ好感度が変化
		CALL CHANGE_CFLAG(2, TARGET, 40)
		;システムメッセージつき信赖度変化
		;最後の引数だけ信赖度が変化
		CALL CHANGE_CFLAG(4, TARGET, 25)
		CALL GET_MONEY_YEN(50000, 2)
	CASE OPR_委托失败时
	;失敗報告時の処理
		;システムメッセージつき好感度変化
		;最後の引数だけ好感度が変化
		CALL CHANGE_CFLAG(2, TARGET, -20)
		;システムメッセージつき信赖度変化
		;最後の引数だけ信赖度が変化
		CALL CHANGE_CFLAG(4, TARGET, -10)
	ENDSELECT
ENDSELECT
