;FileName_USERCOM.ERB ------------------------------ Rev1.00
;指令判定処理
;CALL		SYSTEM
;ARG		VOID
;RETURN		VOID
;COMMENT	
;-----------------------------------------------------------
@USERCOM
#DIM DYNAMIC 能力表示用ダミー
#DIM DYNAMIC 装備部位
#DIM DYNAMIC 胖次消費
#DIM DYNAMIC なだめ判定
#DIM DYNAMIC CAN_BE_UNLOKED_ROOM_SAVE

;addition custom code, handle custom COM values
CALL Add_Custom_USERCOM(RESULT)
IF RESULT == -1
	RETURN 0
ENDIF
;qol custom code
IF TARGET
	LOCAL = RESULT
	CALL KOJO_CHECK(TARGET, "COM_BLOCKED",,LOCAL)
	SIF RESULT
		RETURN 0
