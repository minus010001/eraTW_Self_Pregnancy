	TFLAG:3 = SELECTCOM
	DOTRAIN 999
;居場所察知----------------------------
ELSEIF RESULT == 811 && ((TALENT:MASTER:居場所察知 && (GETBIT(TALENT:MASTER:居場所察知, 1) || !(CFLAG:诶嘿嘿 || CFLAG:恶作剧 || CFLAG:陪睡中))) || MAGIC_IS_CLAIR())
