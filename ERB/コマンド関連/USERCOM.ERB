	;はだけフラグをオフ
	;TEQUIP:2 = 0
	TEQUIP:上半身裸露状態 = 0
	;角色全員の服再セッティング
	FOR LOCAL,0,CHARANUM
		CALL CLOTHES_SETTING_TRAIN(LOCAL)
		;上衣脱衣完毕フラグをオフ
		TEQUIP:LOCAL:5 = 0
	NEXT
	RETURN 1
;约会終了
ELSEIF RESULT == 999 && CHK_DATENOW(CFLAG:MASTER:约会中) && CFLAG:MASTER:現在位置 != OMANEKIBEYA()
	;PRINTL 要回去吗？
	;PRINTL [1] - 回家
	;PRINTL [0] - 不回去
	;INPUT
	;IF !RESULT
	;	RETURN 0
	;ELSE
	CALL 从外面回家
	;ENDIF
	RETURN 1
ELSEIF RESULT == 3000
	TFLAG:PALAM非表示 = !TFLAG:PALAM非表示
ELSEIF RESULT == 3001
	TFLAG:Status非表示 = !TFLAG:Status非表示
ELSEIF RESULT == 3002
