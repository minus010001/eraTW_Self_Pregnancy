ELSEIF RESULT == 812 && ((TALENT:MASTER:汚部屋察知 && AT_HOME(MASTER) && !(CFLAG:诶嘿嘿 || CFLAG:恶作剧 || CFLAG:陪睡中))  || MAGIC_IS_CLAIR())
