ELSEIF RESULT == 999 && CFLAG:恶作剧 && !CFLAG:诶嘿嘿
	FOR LOCAL,0,CHARANUM
		CALL SET_PRANK(0,LOCAL,1)
	NEXT
	;MASTERとの接触位置をリセット
