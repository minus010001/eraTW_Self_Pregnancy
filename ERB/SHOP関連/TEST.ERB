@料理标签DEBUG
#LOCALSIZE 3
#DIMS DYNAMIC L_TAGS, 100
#DIM DYNAMIC L_TAG_COUNT
#DIM DYNAMIC L_DISHTAG
#DIMS DYNAMIC L_KEYS, 1000
#DIM DYNAMIC L_UNIQUE_COUNT
#DIMS DYNAMIC L_MAP = "DEBUG_TASTE_MAP"

MAP_CREATE L_MAP

PRINTL [DEBUG] 正在扫描所有料理数据并收集品味标签...

FOR LOCAL, 101, 400 + CHARANUM
	CALL DISHDATA, LOCAL, "DEBUG", 1, 1
	SIF DISH_NAME == ""
		CONTINUE
	CALL SET_DEBUGMAP_UPDATE(L_MAP,DISH_TASTE)
NEXT
MAP_GETKEYS L_MAP, L_KEYS, 1
L_UNIQUE_COUNT = MAP_SIZE(L_MAP)

DRAWLINE
PRINTFORML 料理标签统计结果汇总 (共计 {L_UNIQUE_COUNT} 种标签)
DRAWLINE
FOR LOCAL, 0, L_UNIQUE_COUNT
	LOCALS = {LOCAL},%L_KEYS:LOCAL%,%TASTE_TR(L_KEYS:LOCAL)%,%MAP_GET(L_MAP, L_KEYS:LOCAL)%
	PRINTFORML %LOCALS%
NEXT
DRAWLINE
L_DISHTAG = L_UNIQUE_COUNT
FOR LOCAL, 1, CHARANUM
	CALL SET_DEBUGMAP_UPDATE(L_MAP,GETMETH_STR(, "キャラデータ", LOCAL, "料理：喜欢的味道"))
	CALL SET_DEBUGMAP_UPDATE(L_MAP,GETMETH_STR(, "キャラデータ", LOCAL, "料理：讨厌的味道"))
	CALL SET_DEBUGMAP_UPDATE(L_MAP,GETMETH_STR(, "キャラデータ", LOCAL, "料理：助手効果"))
NEXT
MAP_GETKEYS L_MAP, L_KEYS, 1
L_UNIQUE_COUNT = MAP_SIZE(L_MAP)

PRINTFORML 角色标签统计结果汇总 (共计 {L_UNIQUE_COUNT-L_DISHTAG} 种标签)
DRAWLINE
FOR LOCAL, L_DISHTAG, L_UNIQUE_COUNT
	LOCALS = {LOCAL},%L_KEYS:LOCAL%,%TASTE_TR(L_KEYS:LOCAL)%,%MAP_GET(L_MAP, L_KEYS:LOCAL)%
	PRINTFORML %LOCALS%
NEXT
DRAWLINE

PRINTFORMW 统计结束。


@SET_DEBUGMAP_UPDATE(L_MAP,L_STR)
#LOCALSIZE 3
#DIMS DYNAMIC L_TAGS, 100
#DIM DYNAMIC L_TAG_COUNT
#DIMS DYNAMIC L_MAP
#DIMS DYNAMIC L_STR

VARSET L_TAGS
SPLIT L_STR, "/", L_TAGS, L_TAG_COUNT

FOR LOCAL:1, 0, L_TAG_COUNT
	SIF L_TAGS:(LOCAL:1) == ""
		CONTINUE
	IF MAP_HAS(L_MAP, L_TAGS:(LOCAL:1)) <= 0
		MAP_SET L_MAP, L_TAGS:(LOCAL:1), "1"
	ELSE
		LOCAL:2 = TOINT(MAP_GET(L_MAP, L_TAGS:(LOCAL:1))) + 1
		MAP_SET L_MAP, L_TAGS:(LOCAL:1), TOSTR(LOCAL:2)
	ENDIF
NEXT

@喜好标签DEBUG
#LOCALSIZE 3
#DIMS DYNAMIC L_TAGS, 100
#DIM DYNAMIC L_TAG_COUNT
#DIM DYNAMIC L_ITEM_TAG_SIZE
#DIM DYNAMIC L_ADJ_TAG_SIZE
#DIMS DYNAMIC L_KEYS, 10000
#DIM DYNAMIC L_UNIQUE_COUNT
#DIMS DYNAMIC L_MAP = "DEBUG_SENSE_MAP"

MAP_CREATE L_MAP

PRINTL [DEBUG] 正在扫描主物品(GIFTDATA_MAIN)标签...
FOR LOCAL, 1, 1000
	CALL GIFTDATA_MAIN(LOCAL, 99)
	SIF RESULT == 0 || RESULTS:1 == ""
		CONTINUE
	CALL SET_DEBUGMAP_UPDATE(L_MAP, RESULTS:1)
NEXT

L_ITEM_TAG_SIZE = MAP_SIZE(L_MAP)
MAP_GETKEYS L_MAP, L_KEYS, 1

DRAWLINE
PRINTFORML 主物品标签统计汇总 (共计 {L_ITEM_TAG_SIZE} 种)
DRAWLINE
FOR LOCAL, 0, L_ITEM_TAG_SIZE
	LOCALS = {LOCAL, 3},%L_KEYS:LOCAL%,%TASTE_TR(L_KEYS:LOCAL)%,%MAP_GET(L_MAP, L_KEYS:LOCAL)%
	PRINTFORML %LOCALS%
NEXT

; -------------------------------------------------
; 2. 扫描修饰语数据 (GIFTDATA_ADJECT)
; -------------------------------------------------
PRINTL 
PRINTL [DEBUG] 正在扫描词缀标签...
FOR LOCAL, 100, 10000
	CALL GIFTDATA_ADJECT(LOCAL, 99, "")
	SIF RESULT == 0 || RESULTS:1 == ""
		CONTINUE
	CALL SET_DEBUGMAP_UPDATE(L_MAP, RESULTS:1)
NEXT

L_ADJ_TAG_SIZE = MAP_SIZE(L_MAP)
MAP_GETKEYS L_MAP, L_KEYS, 1

DRAWLINE
PRINTFORML 累计词缀标签统计 (新增 {L_ADJ_TAG_SIZE - L_ITEM_TAG_SIZE} 种)
DRAWLINE
FOR LOCAL, L_ITEM_TAG_SIZE, L_ADJ_TAG_SIZE
	LOCALS = {LOCAL, 3},%L_KEYS:LOCAL%,%TASTE_TR(L_KEYS:LOCAL)%,%MAP_GET(L_MAP, L_KEYS:LOCAL)%
	PRINTFORML %LOCALS%
NEXT

PRINTL 
PRINTL [DEBUG] 正在扫描角色喜好标签...
FOR LOCAL, 1, CHARANUM
	CALL SET_DEBUGMAP_UPDATE(L_MAP, GETMETH_STR(, "キャラデータ", LOCAL, "感性：好き"))
	CALL SET_DEBUGMAP_UPDATE(L_MAP, GETMETH_STR(, "キャラデータ", LOCAL, "感性：嫌い"))
NEXT

L_UNIQUE_COUNT = MAP_SIZE(L_MAP)
MAP_GETKEYS L_MAP, L_KEYS, 1

DRAWLINE
PRINTFORML 角色侧新增标签汇总 (共计新增 {L_UNIQUE_COUNT - L_ADJ_TAG_SIZE} 种)
DRAWLINE
IF L_UNIQUE_COUNT > L_ADJ_TAG_SIZE
	FOR LOCAL, L_ADJ_TAG_SIZE, L_UNIQUE_COUNT
		LOCALS = {LOCAL, 3},%L_KEYS:LOCAL%,%TASTE_TR(L_KEYS:LOCAL)%,%MAP_GET(L_MAP, L_KEYS:LOCAL)%
		PRINTFORML %LOCALS%
	NEXT
ELSE
	PRINTL (无新增标签)
ENDIF

DRAWLINE
PRINTFORMW 喜好标签全量统计结束，总计独立标签：{L_UNIQUE_COUNT} 种。
[SKIPEND]

