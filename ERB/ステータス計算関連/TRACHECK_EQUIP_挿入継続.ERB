@插入不可(ARG)
;-2 = 搅大缸了 -1 = 刺激太弱 1= 需要经验 2= 需要经验和知识 3= 小人飞机杯
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
SIF ARG == PLAYER
	RETURNF 0
;如果是假鸡吧，不计算体型
SIF !GETBIT(TALENT:PLAYER:2,1)
	RETURNF 0
SELECTCASE 尺寸差(ARG)
	CASE IS > 8
		RETURNF 3
	CASE 5 TO 8
		RETURNF 2
	CASE 3 TO 4
		RETURNF 1
	CASE -2 TO 2
		RETURNF 0
	CASE -3 TO -6
		RETURNF -1
	CASE IS < -6
		RETURNF -2
ENDSELECT

@尺寸差(受方)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM 攻方
#DIM 受方
#DIM 尺寸
;没有检测到肉棒时弹出
IF 受方 == PLAYER
	攻方 = TARGET
ELSE
	攻方 = PLAYER
ENDIF
SELECTCASE TALENT:攻方:形状
	CASE 0,3,4
		尺寸 = 0
	CASE 1
		尺寸 = -1
	CASE 2
		尺寸 = -2
	CASE 6
		尺寸 = 1
	CASE 5,10
		尺寸 = 2
ENDSELECT
RETURNF (TALENT:攻方:体型 - TALENT:受方:体型) * 2 + 尺寸

@挿入不可(ARG)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
RETURNF 插入不可(ARG)
