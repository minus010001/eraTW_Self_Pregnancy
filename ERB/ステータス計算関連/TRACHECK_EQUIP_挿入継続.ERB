	SOURCE:竿役:快Ｃ += 200
	SOURCE:竿役:情愛 += 25
	SOURCE:竿役:性行動 += 250
	SOURCE:竿役:達成 += 25
	SOURCE:竿役:征服 += 500
	SOURCE:竿役:逸脱 += 50

ELSE
	PRINTFORML ＜%CALLNAME:ARG%Ａ被插入中＞
	TCVAR:竿役:射精快感強度 = 900
	TCVAR:ARG:射精快感強度 = 750
	DOWNBASE:竿役:体力 += 15
	DOWNBASE:竿役:気力 += 20
	;时间停止中
	IF (FLAG:70 == 1 && CFLAG:ARG:344 == 0)
		SOURCE:ARG:快Ａ += 200
		CALL 挿入継続Ａ苦痛処理(ARG)

	ELSE
		DOWNBASE:ARG:体力 += 20
		DOWNBASE:ARG:気力 += 20
		SIF TALENT:竿役:形状 == 5
			SOURCE:ARG:苦痛 += 300
		SOURCE:ARG:快Ａ += 200
		SOURCE:ARG:情愛 += 50
		SOURCE:ARG:露出 += 30
		SOURCE:ARG:逸脱 += 100
		SIF TEQUIP:ARG:体位 == 6
			SOURCE:ARG:苦痛 += 300
		;体位BONUS
		IF TEQUIP:ARG:体位 == CFLAG:ARG:喜欢的体位 - 5
			SOURCE:ARG:情愛 += 100
			SOURCE:ARG:恭順 += 50
		ENDIF
		CALL 挿入継続Ａ苦痛処理(ARG)
	ENDIF

	IF CFLAG:ARG:诶嘿嘿 == 2
		SOURCE:ARG:快Ａ += 150
		SOURCE:ARG:情愛 += 100
		TCVAR:竿役:射精快感強度 += 150
	ENDIF
ENDIF
;-------------------------------------------------
;経験の処理
;-------------------------------------------------
EXP:竿役:挿入経験 ++
EXP:ARG:Ａ経験 ++
SIF (!FLAG:70 || CFLAG:ARG:344 == 1) && !CFLAG:ARG:恶作剧
	EXP:ARG:Ａ性交経験 ++
SIF TEQUIP:ARG:体位 == 6
	EXP:ARG:Ａ拡張経験 ++
RETURN 1


@挿入継続Ｖ苦痛処理(ARG)
#LOCALSIZE 2
#LOCALSSIZE 1
;EXP:Ｖ経験をみる（処女はありえない）
LOCAL = 200
LOCAL:1 = 150
IF EXP:ARG:Ｖ経験 < EXPLV:2
	TIMES LOCAL , 0.80
	TIMES LOCAL:1 , 1.20
ELSEIF EXP:ARG:Ｖ経験 < EXPLV:3
	TIMES LOCAL , 0.40
ELSEIF EXP:ARG:Ｖ経験 < EXPLV:4
	TIMES LOCAL , 0.10
ELSEIF EXP:ARG:Ｖ経験 < EXPLV:5
	TIMES LOCAL , 0.00
ELSEIF EXP:ARG:Ｖ経験 >= EXPLV:5
	TIMES LOCAL , 0.00
ENDIF

;PALAM:潤滑をみる
IF PALAM:ARG:潤滑 < PALAMLV:1
	TIMES LOCAL, 3.00
	TIMES LOCAL:1 , 3.00
ELSEIF PALAM:ARG:潤滑 < PALAMLV:2
	TIMES LOCAL , 2.00
	TIMES LOCAL:1 , 2.50
ELSEIF PALAM:ARG:潤滑 < PALAMLV:3
	TIMES LOCAL , 0.60
	TIMES LOCAL:1 , 1.50
ELSEIF PALAM:ARG:潤滑 < PALAMLV:4
	TIMES LOCAL , 0.50
	TIMES LOCAL:1 , 1.00
ELSEIF PALAM:ARG:潤滑 < PALAMLV:5
	TIMES LOCAL , 0.10
	TIMES LOCAL:1 , 0.50
ELSEIF PALAM:ARG:潤滑 >= PALAMLV:5
	TIMES LOCAL , 0.02
	TIMES LOCAL:1 , 0.30
ENDIF

SOURCE:ARG:苦痛 += LOCAL

SIF (!FLAG:70 || CFLAG:ARG:344 == 1)
	SOURCE:ARG:反感 += LOCAL:1


