;挿入継続の処理
@EQUIP_INCERT_V(ARG)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM 竿役

竿役 = TEQUIP:ARG:50
SIF TCVAR:竿役:ゴム使用済み
	RETURN 0
;-------------------------------------------------
;行為者
;-------------------------------------------------
TCVAR:ARG:116 = 竿役
;[eratw-chs fix] upstream bug: PENDING may be stale from previous turn's COUNTER or repeated EQUIP_CHECK
;Clear both directions before setting to avoid EJACU_SET_RECEIVER THROW on duplicate receiver
CALL EJACU_CLEAR(EJACU_STORAGE_PENDING, 竿役)
CALL EJACU_CLEAR(EJACU_STORAGE_PENDING, ARG)
CALL EJACU_SET_RECEIVER(EJACU_STORAGE_PENDING, 竿役, ARG)
CALL EJACU_SET_LOCATION(EJACU_STORAGE_PENDING, 竿役, 射精箇所_膣内)

IF EJACU_GET_RECEIVER(EJACU_STORAGE_PENDING, ARG, EJACU_SLOT_MAIN) == CHARA_NONE
	CALL EJACU_SET_RECEIVER(EJACU_STORAGE_PENDING, ARG, 竿役)
ELSE
	CALL EJACU_SET_RECEIVER(EJACU_STORAGE_PENDING, ARG, 竿役, EJACU_SLOT_AUX)
ENDIF

SIF EJACU_GET_CONTEXT(EJACU_STORAGE_PENDING, ARG) == 0
	CALL EJACU_SET_CONTEXT(EJACU_STORAGE_PENDING, ARG, 射精場合_Ｖ責め)


IF ARG == MASTER
	PRINTFORML ＜%CALLNAME:竿役%插入Ｖ中＞

	TCVAR:竿役:射精快感強度 = 850 + TEQUIP:ARG:子宮 * 100
	TCVAR:ARG:射精快感強度 = 500 + (100 * ABL:ARG:Ｖ感覚)

	DOWNBASE:竿役:体力 += 15
	DOWNBASE:竿役:気力 += 20
	DOWNBASE:ARG:体力 += 10
	DOWNBASE:ARG:気力 += 20
	SOURCE:ARG:快Ｖ += 200
	SOURCE:竿役:快Ｃ += 200
	SOURCE:竿役:情愛 += 25
	SOURCE:竿役:性行動 += 250
	SOURCE:竿役:達成 += 25
	SOURCE:竿役:征服 += 500
	SOURCE:竿役:逸脱 += 50

ELSE
	PRINTFORML ＜%CALLNAME:ARG%Ｖ被插入中＞

	TCVAR:竿役:射精快感強度 = 700 + TEQUIP:ARG:子宮 * 100
	TCVAR:ARG:射精快感強度 = 750
	DOWNBASE:竿役:体力 += 15
	DOWNBASE:竿役:気力 += 20
	;时间停止中
	IF (FLAG:70 == 1 && CFLAG:ARG:344 == 0)
		SOURCE:ARG:快Ｖ += 150
		CALL 挿入継続Ｖ苦痛処理(ARG)

	ELSE
		DOWNBASE:ARG:体力 += 10
		DOWNBASE:ARG:気力 += 20
		SIF TEQUIP:ARG:体位 == 6
			SOURCE:ARG:苦痛 += 300
		SIF TALENT:竿役:形状 == 5
			SOURCE:ARG:苦痛 += 200
		SOURCE:ARG:快Ｖ += 150
		SOURCE:ARG:情愛 += 75
		SOURCE:ARG:露出 += 25
		SIF TCVAR:ARG:强行
			SOURCE:ARG:反感 += 1000
		;体位BONUS
		IF TEQUIP:ARG:体位 == CFLAG:ARG:喜欢的体位
			SOURCE:ARG:情愛 += 100
			SOURCE:ARG:恭順 += 50
		ENDIF
		CALL 挿入継続Ｖ苦痛処理(ARG)
	ENDIF

	IF CFLAG:ARG:诶嘿嘿 == 2
		SOURCE:ARG:快Ｖ += 150
		SOURCE:ARG:情愛 += 100
		TCVAR:竿役:射精快感強度 += 150
	ENDIF
ENDIF

;-------------------------------------------------
;経験の処理
;-------------------------------------------------
EXP:竿役:挿入経験 ++
EXP:ARG:Ｖ経験 ++
SIF (!FLAG:70 || CFLAG:ARG:344 == 1) && !CFLAG:ARG:恶作剧
EXP:ARG:Ｖ性交経験 ++
SIF TEQUIP:ARG:体位 == 6
	EXP:ARG:Ｖ拡張経験 ++
SIF (FLAG:70 == 1 && CFLAG:ARG:344 == 0)
	EXP:MASTER:時姦経験 += 1
IF CFLAG:MASTER:恶作剧 == 2
	EXP:MASTER:睡眠姦経験 += 1
	EXP:ARG:睡眠姦経験 += 1
ENDIF
RETURN 1


