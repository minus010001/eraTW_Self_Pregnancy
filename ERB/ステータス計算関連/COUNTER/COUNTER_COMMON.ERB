;************************************************************
;Counter時六九式移行共通処理
;引数1 対象の角色番号 2 六九式移行への確率
;************************************************************
@EVENT_COUNTER_POSE_69(ARG,ARG:2)
IF ARG:2 == 0
	TEQUIP:ARG:六九式 = 0
	RETURN 0
ENDIF
IF TEQUIP:ARG:六九式
	TFLAG:60 ++
	RETURN 0
ENDIF
SIF TFLAG:60
	RETURN 0
IF RAND:(ARG:2) == 1
	TEQUIP:ARG:六九式 = 1
ENDIF

;**************************************************************************
;Counter中の挿入継続共通処理
;ARG = 角色番号
;**************************************************************************
@Counter挿入継続処理(ARG)
;你にＶ挿入中で、今回のCounter指令がＶ挿入系以外の場合
IF TEQUIP:PLAYER:50 == ARG && !GROUPMATCH(TCVAR:ARG:20, 80, 83, 84, 85) && CFLAG:ARG:诶嘿嘿 == 2
	CALL TOUCH_SET(SET_FROM_P,SET_V,ARG)
	SOURCE:ARG:性行動 += 150
	SOURCE:ARG:征服 += 400
	SOURCE:PLAYER:液体 += 100
	SOURCE:ARG:加虐 += 250
	SOURCE:ARG:強要 += 400
	SOURCE:PLAYER:快Ｖ += 500
	CALL PAIN_CHECK_V_MASTER(ARG)
	CALL DECLARE_EJACULATION(PLAYER, 射精場合_Ｖ責め, 0, ARG, CHARA_NONE, ARG, CHARA_NONE, 75)
	CALL DECLARE_EJACULATION(ARG, 0, 射精箇所_膣内, PLAYER, CHARA_NONE, PLAYER, CHARA_NONE, 500)
	STAIN:ARG:2 |= STAIN:PLAYER:6
	STAIN:PLAYER:6 |= STAIN:ARG:2
	EXP:PLAYER:Ｖ性交経験 ++
	TCVAR:ARG:嗜虐フラグ = 1
ENDIF

;你にＡ挿入中で、今回のCounter指令が逆Ａ系以外の場合
IF TEQUIP:PLAYER:51 == ARG && !GROUPMATCH(TCVAR:ARG:20, 90, 93, 94) && CFLAG:ARG:诶嘿嘿 == 2
	CALL TOUCH_SET(SET_FROM_P,SET_A,ARG)
	SOURCE:ARG:性行動 += 150
	SOURCE:ARG:征服 += 400
	SOURCE:PLAYER:液体 += 100
	SOURCE:ARG:加虐 += 400
	SOURCE:ARG:強要 += 400
	SOURCE:PLAYER:快Ａ += 500
	CALL PAIN_CHECK_A_MASTER(ARG)
	CALL DECLARE_EJACULATION(PLAYER, 射精場合_Ａ責め, 0, ARG, CHARA_NONE, ARG, CHARA_NONE, 125)
	CALL DECLARE_EJACULATION(ARG, 0, 射精箇所_アナル, PLAYER, CHARA_NONE, PLAYER, CHARA_NONE, 400)
	STAIN:ARG:2 |= STAIN:PLAYER:6
	STAIN:PLAYER:6 |= STAIN:ARG:2
	EXP:PLAYER:Ａ性交経験 ++
	TCVAR:ARG:嗜虐フラグ = 1
ENDIF
RETURN 1

;**************************************************************************
;射精対象登録共通処理
;ARG = 射精する角色
;ARG:1 = 射精される角色
;ARG:2 = 射精部位（1=膣内 2=肛門 3=手淫 4=口淫 5=乳交 6=素股 7=足交 8=体表 9=肛門奉仕 10=道具 11=触手 12=Ａ責め 13=Ｖ責め）
;**************************************************************************
@射精対象登録(ARG, ARG:1, ARG:2)
SELECTCASE ARG:2
	CASE 1
		CALL EJACU_SET_LOCATION(EJACU_STORAGE_PENDING, ARG, 射精箇所_膣内)
	CASE 2
		CALL EJACU_SET_LOCATION(EJACU_STORAGE_PENDING, ARG, 射精箇所_アナル)
	CASE 3
		CALL EJACU_SET_LOCATION(EJACU_STORAGE_PENDING, ARG, 射精箇所_手)
	CASE 4
		CALL EJACU_SET_LOCATION(EJACU_STORAGE_PENDING, ARG, 射精箇所_口)
	CASE 5
		CALL EJACU_SET_LOCATION(EJACU_STORAGE_PENDING, ARG, 射精箇所_胸)
	CASE 6
		CALL EJACU_SET_LOCATION(EJACU_STORAGE_PENDING, ARG, 射精箇所_脚)
	CASE 7
		CALL EJACU_SET_LOCATION(EJACU_STORAGE_PENDING, ARG, 射精箇所_足裏)
	CASE 8
		CALL EJACU_SET_LOCATION(EJACU_STORAGE_PENDING, ARG, 射精箇所_体表)
	CASE 9
		CALL EJACU_SET_CONTEXT(EJACU_STORAGE_PENDING, ARG, 射精場合_アナル奉仕)
	CASE 10
		CALL EJACU_SET_CONTEXT(EJACU_STORAGE_PENDING, ARG, 射精場合_道具)
		CALL EJACU_SET_LOCATION(EJACU_STORAGE_PENDING, ARG, 射精箇所_道具)
	CASE 12
		CALL EJACU_SET_CONTEXT(EJACU_STORAGE_PENDING, ARG, 射精場合_Ａ責め)
	CASE 13
		CALL EJACU_SET_CONTEXT(EJACU_STORAGE_PENDING, ARG, 射精場合_Ｖ責め)
	CASE 14
		CALL EJACU_SET_LOCATION(EJACU_STORAGE_PENDING, ARG, 射精箇所_脇コキ)
	CASE 15
		CALL EJACU_SET_LOCATION(EJACU_STORAGE_PENDING, ARG, 射精箇所_膣口)
ENDSELECT
CALL EJACU_SET_RECEIVER(EJACU_STORAGE_PENDING, ARG, ARG:1)
CALL EJACU_SET_INITIATOR(EJACU_STORAGE_PENDING, ARG, ARG:1)
RETURN 1

;***************************************************************************
;挿入され継続中マスターCounter共通制御
;ARG =  角色番号
;***************************************************************************
@Counter挿入され継続中処理(ARG)
;TCVAR:26 マスターCounter制御 
;(ビット 0=摸屁股不可 1=擁抱 2=接吻 3=胸愛撫 4=肛門愛撫 5=陰蒂愛撫 6=指挿入れ 7=掀裙子)

;你にＶまたはＡ挿入中で、今回のCounter指令が逆Ａ系以外の場合
IF (TEQUIP:PLAYER:50 == ARG || TEQUIP:PLAYER:51 == ARG) && !GROUPMATCH(TCVAR:ARG:20, 90, 93)
	IF TEQUIP:MASTER:体位 == 2
		SETBIT TCVAR:ARG:26 ,0
		SETBIT TCVAR:ARG:26 ,1
		SETBIT TCVAR:ARG:26 ,2
		SETBIT TCVAR:ARG:26 ,3
	ENDIF
	SETBIT TCVAR:ARG:26 ,4
	SETBIT TCVAR:ARG:26 ,5
	SETBIT TCVAR:ARG:26 ,6
	SETBIT TCVAR:ARG:26 ,7
ENDIF

;***************************************************************************
;Counter脱衣挿入時共通制御
;ARG =  角色番号
;***************************************************************************
@DATUI_FOR_INSERT(ARG)
IF BEDROOM(CFLAG:MASTER:現在位置)
	SIF TEQUIP:ARG:0
		CALL DATUI_BOTTOM_T(ARG,0)
ELSE
	SIF TEQUIP:ARG:0 & 14
		CALL DATUI_BOTTOM_T(ARG,1)
ENDIF

;***************************************************************************
;胸弄り解除共通制御
;ARG =  角色番号
;***************************************************************************
@胸弄り解除処理(ARG)
;なんでもかんでも性交してたらリセットしてるので条件を変更
;揉胸ながら挿入とか普通にするし…
IF (TEQUIP:MASTER:Ｖ性交 >= 0 || TEQUIP:MASTER:Ａ性交 >= 0)
	;IF TEQUIP:ARG:揉胸
	;	TEQUIP:ARG:揉胸 = 0
	;	PRINTL ＜揉胸解除＞
	;ENDIF
	IF TEQUIP:ARG:吸乳头 && (TEQUIP:ARG:体位 == 2 || TEQUIP:ARG:体位 == 5)
		TEQUIP:ARG:吸乳头 = 0
		PRINTL ＜吸乳头解除＞
	ENDIF
ENDIF

;***************************************************************************
;位置関係確認共通関数
;ARG =  位置関係
;***************************************************************************
@POSITION_OCCUPATION(ARG)
#FUNCTION
FOR LOCAL, 1, GET_TARGETNUM() + 1
	SIF TARGET:LOCAL <= 0
		CONTINUE
	SIF TCVAR:(TARGET:LOCAL):位置関係 == ARG
		RETURNF 1
NEXT