;射精確定後の処理
@EJAC_CHECK_AFTER(キャラ登録番号)
#DIM キャラ登録番号
#DIM 射精回数
#DIM 過剰射精
#DIM SOURCE乗数

VARSET 射精回数
VARSET 過剰射精
;キャラ登録番号 射精する人
IF !TCVAR:キャラ登録番号:要去了
	IF BASE:キャラ登録番号:射精 > MAXBASE:キャラ登録番号:射精
		IF BASE:キャラ登録番号:勃起 < 1000
			BASE:キャラ登録番号:射精 = MAXBASE:キャラ登録番号:射精 - 1
		ELSE
			TCVAR:キャラ登録番号:要去了 = 1
		ENDIF
	ENDIF
	RETURN 0
ELSEIF TEQUIP:キャラ登録番号:挑逗モード && キャラ登録番号 != MASTER
	TCVAR:キャラ登録番号:挑逗回数 += 2
	RETURN 0
ENDIF

BASE:キャラ登録番号:精力 = MAX(0, BASE:キャラ登録番号:精力)

;射精(絶頂)回数
射精回数 = MIN(BASE:キャラ登録番号:射精 / MAXBASE:キャラ登録番号:射精, (100 + BASE:キャラ登録番号:精力) / 100)

NOWEX:キャラ登録番号:射精量 = BASE:キャラ登録番号:射精 * 10 / (ABL:キャラ登録番号:Ｃ感覚 / 2 + 10) / 100
NOWEX:キャラ登録番号:射精量 = NOWEX:キャラ登録番号:射精量 * 10 / (ABL:キャラ登録番号:Ｃ感覚 / 2 + 10)
SIF NOWEX:キャラ登録番号:射精量 > 300
	NOWEX:キャラ登録番号:射精量 = 300 + (NOWEX:キャラ登録番号:射精量 - 300) * 7 / 10

IF NOWEX:キャラ登録番号:射精量 > BASE:キャラ登録番号:精力
	NOWEX:キャラ登録番号:射精量 = (NOWEX:キャラ登録番号:射精量 - BASE:キャラ登録番号:精力) / 5 + BASE:キャラ登録番号:精力
	過剰射精 = NOWEX:キャラ登録番号:射精量 - BASE:キャラ登録番号:精力
ENDIF

IF 過剰射精
	IF TALENT:キャラ登録番号:絶倫

	ELSEIF TFLAG:劇毒身軀
		DOWNBASE:キャラ登録番号:体力 += 過剰射精 * 10
	ELSE
		DOWNBASE:キャラ登録番号:体力 += 過剰射精 * 4
	ENDIF
ENDIF

BASE:キャラ登録番号:精力 = MAX(0, BASE:キャラ登録番号:精力 - NOWEX:キャラ登録番号:射精量)
SIF TALENT:キャラ登録番号:絶倫
	NOWEX:キャラ登録番号:射精量 = NOWEX:キャラ登録番号:射精量 * 3 / 2
TCVAR:キャラ登録番号:要去了 = 0
STAIN:キャラ登録番号:Ｐ |= 4

;魔改射精后增加属性上限
SIF BUp:9==1||(!キャラ登録番号&&BUp:9==2)
	CALL EjBUp(キャラ登録番号)

;異常経験、射精経験、精液経験
;女性器がある場合？
SIF !EXP:キャラ登録番号:射精経験 && TALENT:キャラ登録番号:性別 & 1
	EXP:キャラ登録番号:異常経験 += 1

EXP:キャラ登録番号:絶頂経験 ++
EXP:キャラ登録番号:射精経験 += 射精回数

NOWEX:キャラ登録番号:射精 += 射精回数
EX:キャラ登録番号:射精 += 射精回数
TCVAR:キャラ登録番号:挑逗回数 = 0
TEQUIP:キャラ登録番号:挑逗モード = 0
SIF AT_HOME(キャラ登録番号)
	YOGORE:(CFLAG:キャラ登録番号:現在位置) += 射精回数 * 50

IF TALENT:キャラ登録番号:絶倫

ELSEIF TFLAG:劇毒身軀
	DOWNBASE:キャラ登録番号:体力 += LIMIT(NOWEX:キャラ登録番号:射精量 / 4, 30, 300)
	DOWNBASE:キャラ登録番号:気力 += LIMIT(NOWEX:キャラ登録番号:射精量 / 2, 40, 400)
ELSE
	DOWNBASE:キャラ登録番号:体力 += LIMIT(NOWEX:キャラ登録番号:射精量 / 8, 10, 100)
	DOWNBASE:キャラ登録番号:気力 += LIMIT(NOWEX:キャラ登録番号:射精量 / 4, 20, 200)
ENDIF

;MASTERでなければBASEやSOURCE等の処理を入れる
SIF キャラ登録番号 == MASTER
	RETURN 0

SOURCE乗数 = (射精回数 + 1) / 2
IF EXP:キャラ登録番号:射精経験 < EXPLV:1
	SOURCE:キャラ登録番号:露出 += 5000 * SOURCE乗数
	SOURCE:キャラ登録番号:屈従 += 2500 * SOURCE乗数
	SOURCE:キャラ登録番号:不潔 += 200 * SOURCE乗数
ELSEIF EXP:キャラ登録番号:射精経験 < EXPLV:2
	SOURCE:キャラ登録番号:露出 += 2500 * SOURCE乗数
	SOURCE:キャラ登録番号:屈従 += 2000 * SOURCE乗数
	SOURCE:キャラ登録番号:不潔 += 150 * SOURCE乗数
ELSEIF EXP:キャラ登録番号:射精経験 < EXPLV:3
	SOURCE:キャラ登録番号:露出 += 1000 * SOURCE乗数
	SOURCE:キャラ登録番号:屈従 += 800 * SOURCE乗数
	SOURCE:キャラ登録番号:不潔 += 100 * SOURCE乗数
ELSEIF EXP:キャラ登録番号:射精経験 < EXPLV:4
	SOURCE:キャラ登録番号:露出 += 800 * SOURCE乗数
	SOURCE:キャラ登録番号:屈従 += 600 * SOURCE乗数
	SOURCE:キャラ登録番号:不潔 += 50 * SOURCE乗数
ELSEIF EXP:キャラ登録番号:射精経験 < EXPLV:5
	SOURCE:キャラ登録番号:露出 += 400 * SOURCE乗数
	SOURCE:キャラ登録番号:屈従 += 400 * SOURCE乗数
	SOURCE:キャラ登録番号:不潔 += 10 * SOURCE乗数
ELSE
	SOURCE:キャラ登録番号:露出 += 200 * SOURCE乗数
	SOURCE:キャラ登録番号:屈従 += 250 * SOURCE乗数
ENDIF

;-------------------------------------------------
;調教対象の射精チェック
;-------------------------------------------------
@TARGET_EJAC_CHECK(キャラ登録番号)
#DIM キャラ登録番号

;男性器がなければ返回
SIF !HAS_PENIS(キャラ登録番号)
	RETURN 0

LOCAL = (CUP:キャラ登録番号:快Ｃ + CUP:キャラ登録番号:快Ｖ + CUP:キャラ登録番号:快Ａ + CUP:キャラ登録番号:快Ｂ) / 4

;自制心
SIF TALENT:キャラ登録番号:自制心
	TIMES LOCAL , 0.80

;接受快感
SIF TALENT:キャラ登録番号:快感応答 > 0
	TIMES LOCAL , 1.20

;否定快感（淫乱、娼婦で無効）
SIF TALENT:キャラ登録番号:快感応答 < 0 && !(TALENT:キャラ登録番号:淫乱 || ABL:キャラ登録番号:欲望 > 15)
	TIMES LOCAL , 0.80

;媚薬
SIF TCVAR:キャラ登録番号:媚薬 && キャラ登録番号 != MASTER
	TIMES LOCAL , 2.00

;仙香玉兎
SIF IsInsenceValid(キャラ登録番号)
	TIMES LOCAL , 1.40

;利尿剤
SIF TCVAR:キャラ登録番号:利尿剤
	TIMES LOCAL , 0.80
;睡眠中
SIF CFLAG:キャラ登録番号:睡眠
	TIMES LOCAL , 0.80

BASE:キャラ登録番号:射精 += LOCAL

;射精処理の角色別ターミナル
@SEMEN_DISPATCH(射精した角色番号)
#DIM 射精した角色番号
#DIM RECEIVER

RECEIVER = EJACU_GET_RECEIVER(EJACU_STORAGE_LIVE, 射精した角色番号, EJACU_SLOT_MAIN)
SIF EJACU_RECEIVER_IS_CHARACTER(RECEIVER)
	CALL SEMEN_PROCESS(射精した角色番号, RECEIVER)

RECEIVER = EJACU_GET_RECEIVER(EJACU_STORAGE_LIVE, 射精した角色番号, EJACU_SLOT_AUX)
SIF EJACU_RECEIVER_IS_CHARACTER(RECEIVER)
	CALL SEMEN_PROCESS(射精した角色番号, RECEIVER)

;部位別処理
@SEMEN_PROCESS(SENDER, RECEIVER)
#DIM SENDER
#DIM RECEIVER
#DIM 路人子用

IF SENDER == MASTER && CFLAG:RECEIVER:诶嘿嘿 == 2
	SOURCE:RECEIVER:達成 += NOWEX:SENDER:射精 * 150
	SOURCE:RECEIVER:征服 += NOWEX:SENDER:射精 * 150
	SIF !(NOWEX:RECEIVER:Ｃ絶頂 + NOWEX:RECEIVER:Ｖ絶頂 + NOWEX:RECEIVER:Ａ絶頂 + NOWEX:RECEIVER:Ｂ絶頂 + NOWEX:RECEIVER:Ｍ絶頂)
		SOURCE:RECEIVER:征服 += NOWEX:SENDER:射精 * 100
ENDIF
IF SENDER == MASTER && TALENT:RECEIVER:路人 == 1
	路人子用 = MIN(NOWEX:SENDER:射精,3)
	SELECTCASE EJACU_GET_LOCATION(EJACU_STORAGE_LIVE, SENDER)
		CASE 射精箇所_膣内
			SIF ABL:RECEIVER:膣 < 路人子用
				CALL ChangeABL(RECEIVER, "膣", 1)
		CASE 射精箇所_アナル
			SIF ABL:RECEIVER:肛門 < 路人子用
				CALL ChangeABL(RECEIVER, "肛門", 1)
		CASE 射精箇所_手
			SIF ABL:RECEIVER:指 < 路人子用
				CALL ChangeABL(RECEIVER, "指", 1)
		CASE 射精箇所_口
			SIF ABL:RECEIVER:舌 < 路人子用
				CALL ChangeABL(RECEIVER, "舌", 1)
		CASE 射精箇所_胸
			SIF ABL:RECEIVER:胸 < 路人子用
				CALL ChangeABL(RECEIVER, "胸", 1)
	ENDSELECT
ENDIF

IF EJACU_HAS_CONDOM(EJACU_STORAGE_LIVE, SENDER)
	IF RECEIVER
		SELECTCASE EJACU_GET_LOCATION(EJACU_STORAGE_LIVE, SENDER)
			CASE 射精箇所_膣内
				SIF ABL:RECEIVER:膣射中毒 > 3
					CFLAG:RECEIVER:积攒度 += ABL:RECEIVER:膣射中毒 * NOWEX:SENDER:射精 * 15
			CASE 射精箇所_アナル
				SIF ABL:RECEIVER:肛射中毒 > 3
					CFLAG:RECEIVER:积攒度 += ABL:RECEIVER:肛射中毒 * NOWEX:SENDER:射精 * 15
		ENDSELECT
	ENDIF
	CALL CONDOM_MARK_USED(SENDER, NOWEX:SENDER:射精量)
	IF CFLAG:TARGET:自動ゴム && ITEM:避孕套 && SENDER == MASTER
		CALL CONDOM_REMOVE(MASTER)
		CALL CONDOM_EQUIP(MASTER)
		PRINTFORML %CALLNAME:MASTER%带上了避孕套 剩余{ITEM:避孕套}个
	ELSE
		SEX_DISENGAGE = RECEIVER + 1
	ENDIF
ELSE

IF EJACU_GET_LOCATION(EJACU_STORAGE_LIVE, SENDER) == 射精箇所_膣内 && !TCVAR:RECEIVER:ピル && TCVAR:RECEIVER:外出し約束 == 1
	LOCAL = LIMIT(4000 - BASE:SENDER:射精 / 5, 1000, 4000)
	REDRAW 1
	PRINTFORML  [0] 拔出来！
	PRINTFORML  [1] 放弃
	TINPUT LOCAL, 100, 1, "时间到！"
	IF RESULT
		SIF RESULT == 1
			PRINTFORML 被压倒性的快感打败、忘记了约定射在里面了…
		CALL EJACU_SET_CONTEXT(EJACU_STORAGE_LIVE, SENDER, 射精場合_約束破り)
	ELSE
		CALL EJACU_SET_LOCATION(EJACU_STORAGE_LIVE, SENDER, 射精箇所_体表)
		CALL EJACU_SET_CONTEXT(EJACU_STORAGE_LIVE, SENDER, 射精場合_外出し成功)
		SEX_DISENGAGE = RECEIVER + 1
	ENDIF
ENDIF

CALL APPLY_EJACULATION(SENDER, RECEIVER, EJACU_GET_LOCATION(EJACU_STORAGE_LIVE, SENDER), NOWEX:SENDER:射精量, NOWEX:SENDER:射精)

SIF EJACU_GET_LOCATION(EJACU_STORAGE_LIVE, SENDER) == 射精箇所_膣内 && TCVAR:RECEIVER:强行
	CALL SEMEN_FORCED_CREAMPIE_PENALTY(SENDER, RECEIVER)

SIF EJACU_GET_CONTEXT(EJACU_STORAGE_LIVE, SENDER) == 射精場合_約束破り
	CALL SEMEN_PULLOUT_BREACH_PENALTY(SENDER, RECEIVER)

;contact resets
SELECTCASE EJACU_GET_LOCATION(EJACU_STORAGE_LIVE, SENDER)
	CASE 射精箇所_手
		TEQUIP:SENDER:指接触部位 = 0
	CASE 射精箇所_口
		TEQUIP:SENDER:口接触部位 = 0
	CASE 射精箇所_胸
		TEQUIP:SENDER:Ｂ接触部位 = 0
	CASE 射精箇所_脚
		TEQUIP:SENDER:Ｃ接触部位 = 0
ENDSELECT
ENDIF
IF MAGIC_DLC
	CFLAG:RECEIVER:积攒度 = LIMIT(CFLAG:RECEIVER:积攒度, 0, 积攒度上限(RECEIVER))
ELSE
	CFLAG:RECEIVER:积攒度 = LIMIT(CFLAG:RECEIVER:积攒度, 0, MAX_积攒度)
ENDIF
CFLAG:SENDER:积攒度 = MAX(CFLAG:SENDER:积攒度 - NOWEX:SENDER:射精 * 50, 0)

@SEMEN_FORCED_CREAMPIE_PENALTY(SENDER, RECEIVER)
#DIM SENDER
#DIM RECEIVER
#DIM 强行反感
#DIM 强行恐怖
#DIM 信頼减少
#DIM 好感度减少

;路人子プロフィール
IF TALENT:RECEIVER:路人 == 1
	CSTR:RECEIVER:路人子プロフィール２ = %REPLACE(@"%CSTR:RECEIVER:路人子プロフィール２%","现在已经老实了","、被膣内射精了")%
	SIF !STRCOUNT(CSTR:RECEIVER:路人子プロフィール２, "膣内射精了")
		CSTR:RECEIVER:路人子プロフィール２ = %REPLACE(@"%CSTR:RECEIVER:路人子プロフィール２%","处女被夺走了","处女被夺走之后、被膣内射精了")%
	IF EX:RECEIVER:膣内精液 >= 300 && !STRCOUNT(CSTR:RECEIVER:路人子プロフィール２, "充分")
		CSTR:RECEIVER:路人子プロフィール２ = %REPLACE(@"%CSTR:RECEIVER:路人子プロフィール２%","膣内射精了","注入了充分的精液")%
	ENDIF
	IF 路人子初期Ｖ性交経験 + 10 <= EXP:RECEIVER:Ｖ性交経験
		SIF !STRCOUNT(CSTR:RECEIVER:路人子プロフィール２, "打倒在地然后")
			CSTR:RECEIVER:路人子プロフィール２ = %REPLACE(@"%CSTR:RECEIVER:路人子プロフィール２%","膣内射精了", "打倒在地然后膣内射精了")%
		SIF 路人子初期Ｖ性交経験 + 15 <= EXP:RECEIVER:Ｖ性交経験 && !STRCOUNT(CSTR:RECEIVER:路人子プロフィール２, "散々")
			CSTR:RECEIVER:路人子プロフィール２ = %REPLACE(@"%CSTR:RECEIVER:路人子プロフィール２%","打倒在地然后", "蛮横地打倒在地然后")%
	ENDIF
	SIF MARK:RECEIVER:快楽刻印 && !STRCOUNT(CSTR:RECEIVER:路人子プロフィール２, "绝顶")
		CSTR:RECEIVER:路人子プロフィール２ = %REPLACE(@"%CSTR:RECEIVER:路人子プロフィール２%","打倒在地然后", "打倒在地然后绝顶的同时被")%
	SIF MARK:RECEIVER:快楽刻印 && !STRCOUNT(CSTR:RECEIVER:路人子プロフィール２, "就那样狂乱地")
		CSTR:RECEIVER:路人子プロフィール２ = %REPLACE(@"%CSTR:RECEIVER:路人子プロフィール２%","绝顶的同时", "就那样狂乱绝顶的同时")%
ENDIF

SELECTCASE ABL:RECEIVER:膣射中毒
	CASE IS < 3
		强行反感 = 100000
		好感度减少 = NOWEX:SENDER:射精 * RAND:50 + NOWEX:SENDER:射精 * RAND:50
		信頼减少 = NOWEX:SENDER:射精 * RAND:20 + NOWEX:SENDER:射精 * RAND:20
		强行恐怖 = NOWEX:RECEIVER:膣内精液 * 5
	CASE 3 TO 5
		强行反感 = 50000
		好感度减少 = NOWEX:SENDER:射精 * RAND:30 + NOWEX:SENDER:射精 * RAND:30
		信頼减少 = NOWEX:SENDER:射精 * RAND:15 + NOWEX:SENDER:射精 * RAND:15
		强行恐怖 = NOWEX:RECEIVER:膣内精液 * 3
	CASEELSE
		强行反感 = 10000
		好感度减少 = NOWEX:SENDER:射精 * RAND:10 + NOWEX:SENDER:射精 * RAND:10
		信頼减少 = NOWEX:SENDER:射精 * RAND:10 + NOWEX:SENDER:射精 * RAND:10
		强行恐怖 = NOWEX:RECEIVER:膣内精液
ENDSELECT

IF CFLAG:RECEIVER:生理周期 == 7
	强行反感 *= 2
	强行恐怖 *= 2
	好感度减少 *= 2
	信頼减少 *= 2
ENDIF
IF CFLAG:RECEIVER:强行内射 > 1
	强行反感 *= 2
	强行恐怖 *= 2
	好感度减少 *= 2
	信頼减少 *= 2
ENDIF

SOURCE:RECEIVER:反感 += 强行反感
SOURCE:RECEIVER:恐怖 += 强行恐怖
IF CFLAG:RECEIVER:强行内射 > 1
	CFLAG:RECEIVER:强行内射 = 3
ELSE
	CFLAG:RECEIVER:强行内射 = 1
ENDIF
TFLAG:好感度管理 -= 好感度减少
CALL CHANGE_CFLAG(4,RECEIVER,信頼减少 * (-1))

@SEMEN_PULLOUT_BREACH_PENALTY(SENDER, RECEIVER)
#DIM SENDER
#DIM RECEIVER
#DIM 强行反感
#DIM 信頼减少
#DIM 好感度减少

LOCAL = GET_PULLOUT_BREACH_AGREEMENT_SCORE(RECEIVER)

IF LOCAL < 1
	TCVAR:RECEIVER:挿入拒絶 = 1
	TCVAR:RECEIVER:PULLOUT_BREACH_IS_UPSET = 1
	强行反感 = 10000
	信頼减少 = MAX((5 + MIN(RAND:4, 1) + MIN(RAND:4, 1)) * (LOCAL * -1), 60)
	好感度减少 = MAX((10 + MIN(RAND:5, 1) + MIN(RAND:7, 1)) * (LOCAL * -1), 100)
	IF CFLAG:RECEIVER:生理周期 == 7
		强行反感 *= 10
		好感度减少 *= 3
		信頼减少 *= 3
	ELSEIF CFLAG:RECEIVER:生理周期 == 8
		强行反感 *= 5
		好感度减少 *= 2
		信頼减少 *= 2
	ELSE
		强行反感 *= 5
	ENDIF
	SOURCE:RECEIVER:反感 += 强行反感
ELSE
	信頼减少 = 50
	SIF LOCAL >= 3
		好感度减少 = 80
ENDIF

TFLAG:好感度管理 -= 好感度减少
CALL CHANGE_CFLAG(2,RECEIVER,好感度减少 * (-1))
CALL CHANGE_CFLAG(4,RECEIVER,信頼减少 * (-1))
CFLAG:RECEIVER:外出し約束拒否 = 1

@GET_PULLOUT_BREACH_AGREEMENT_SCORE(ARG)
#FUNCTION
#DIM DYNAMIC AGREEMENT_SCORE

SIF TALENT:ARG:恋人
	RETURNF 999
SIF TALENT:ARG:愛欲
	RETURNF 999

IF TALENT:ARG:恋慕
	AGREEMENT_SCORE = -3
ELSEIF IS_FALLEN(ARG)
	AGREEMENT_SCORE = -5
ELSE
	AGREEMENT_SCORE = -7
ENDIF

AGREEMENT_SCORE += CFLAG:ARG:好感度 / 1000

SIF BASE:ARG:理性 < 300
	AGREEMENT_SCORE += 1
SIF CFLAG:ARG:积攒度 >= 800
	AGREEMENT_SCORE += 1
IF NOWEX:ARG:Ｖ絶頂 > 1
	AGREEMENT_SCORE += 1
ENDIF

SIF ABL:ARG:膣射中毒 >= 3
	AGREEMENT_SCORE += ABL:ARG:膣射中毒

SIF TALENT:ARG:プライド > 0
	AGREEMENT_SCORE -= 3
SIF TALENT:ARG:一線越えない > 0
	AGREEMENT_SCORE -= 5
SIF TALENT:ARG:自己愛 < 0
	AGREEMENT_SCORE -= 3

SIF CFLAG:ARG:信頼度 >= 1000
	AGREEMENT_SCORE -= 1

SIF TALENT:ARG:プライド < 0
	AGREEMENT_SCORE += 1
SIF TALENT:ARG:自己愛 > 1
	AGREEMENT_SCORE += 1
SIF TALENT:ARG:目立ちたがり > 0
	AGREEMENT_SCORE += 1
SIF TALENT:ARG:性的興味 > 0
	AGREEMENT_SCORE += 1
SIF TALENT:ARG:弱味 > 0
	AGREEMENT_SCORE += 1

SIF CFLAG:ARG:体目当て
	AGREEMENT_SCORE += 1

RETURNF AGREEMENT_SCORE

