@INJECT_SEMEN(RECEIVER, LOCATION, VOLUME)
#DIM RECEIVER
#DIM LOCATION
#DIM VOLUME
#DIM 欲求不満解消係数

SIF VOLUME <= 0
	RETURN

SELECTCASE LOCATION
	CASE 1
		EX:RECEIVER:膣内精液 += VOLUME
		EX:RECEIVER:精液残量 += VOLUME
		CFLAG:RECEIVER:累計膣内精液 += VOLUME
		STAIN:RECEIVER:Ｖ |= 4
		STAIN:RECEIVER:膣内 |= 4
		欲求不満解消係数 = 800 / MIN(100 + ABL:RECEIVER:膣射中毒 * 10, 200)
		CFLAG:RECEIVER:积攒度 -= SQRT(VOLUME) * 欲求不満解消係数
	CASE 2
		EX:RECEIVER:アナル内精液 += VOLUME
		EX:RECEIVER:アナル精液残量 += VOLUME
		CFLAG:RECEIVER:累計肛門精液 += VOLUME
		STAIN:RECEIVER:Ａ |= 4
		STAIN:RECEIVER:腸内 |= 4
		欲求不満解消係数 = 800 / MIN(100 + ABL:RECEIVER:肛射中毒 * 10, 200)
		CFLAG:RECEIVER:积攒度 -= SQRT(VOLUME) * 欲求不満解消係数
	CASE 3
		STAIN:RECEIVER:手 |= 4
	CASE 4
		STAIN:RECEIVER:口 |= 4
		CFLAG:RECEIVER:累計精飲 += VOLUME
	CASE 5
		STAIN:RECEIVER:5 |= 4
		CFLAG:RECEIVER:累計精浴 += VOLUME
	CASE 6
		STAIN:RECEIVER:Ｖ |= 4
		CFLAG:RECEIVER:累計精浴 += VOLUME
	CASE 7
		CFLAG:RECEIVER:累計精浴 += VOLUME
	CASE 8
		CFLAG:RECEIVER:累計精浴 += VOLUME
ENDSELECT

IF MAGIC_DLC
	CFLAG:RECEIVER:积攒度 = LIMIT(CFLAG:RECEIVER:积攒度, 0, 积攒度上限(RECEIVER))
ELSE
	CFLAG:RECEIVER:积攒度 = LIMIT(CFLAG:RECEIVER:积攒度, 0, MAX_积攒度)
ENDIF

@APPLY_EJACULATION(SENDER, RECEIVER, LOCATION, VOLUME, EJAC_COUNT)
#DIM SENDER
#DIM RECEIVER
#DIM LOCATION
#DIM VOLUME
#DIM EJAC_COUNT
#DIM 欲求不満解消係数
#DIM 精飲量

SIF VOLUME <= 0
	RETURN

CALL EJACU_SET_LOCATION(EJACU_STORAGE_LIVE, SENDER, LOCATION)

SELECTCASE LOCATION
	CASE 1
		EXP:RECEIVER:精液経験 += EJAC_COUNT * 2
		EXP:RECEIVER:膣射経験 += EJAC_COUNT * 2
		CALL INJECT_SEMEN(RECEIVER, 1, VOLUME)
		NOWEX:RECEIVER:膣内精液 = VOLUME
		TCVAR:RECEIVER:V被中出FLAG = 2
		TCVAR:RECEIVER:Vに中出しした角色の番号 = SENDER
		CFLAG:RECEIVER:膣内射精 = 1 + (FLAG:70 == 1)
		SEMEN_MATRIX:RECEIVER:SENDER:膣内射精量 += NOWEX:RECEIVER:膣内精液
		CALL POISONBODY(RECEIVER, SENDER, 1)
		CALL SEMEN_CERVIX_INTAKE(VOLUME, SENDER, RECEIVER)
		SIF SHIRAHU(RECEIVER)
			TCVAR:RECEIVER:種付けられ自覚 = 1
		SIF SHIRAHU(SENDER) && SENDER != MASTER
			TCVAR:SENDER:種付け自覚 = 1
	CASE 2
		EXP:RECEIVER:精液経験 += EJAC_COUNT * 2
		EXP:RECEIVER:肛射経験 += EJAC_COUNT * 2
		CALL INJECT_SEMEN(RECEIVER, 2, VOLUME)
		NOWEX:RECEIVER:アナル内精液 = VOLUME
		TCVAR:RECEIVER:A被中出FLAG = 2
		TCVAR:RECEIVER:Aに中出しした角色の番号 = SENDER
		CFLAG:RECEIVER:肛門射精 = 1 + (FLAG:70 == 1)
		SEMEN_MATRIX:RECEIVER:SENDER:肛门内射精量 += NOWEX:RECEIVER:アナル内精液
		CALL POISONBODY(RECEIVER, SENDER, 2)
	CASE 3
		EXP:RECEIVER:精液経験 += 1 + EJAC_COUNT
		CALL INJECT_SEMEN(RECEIVER, 3, VOLUME)
		CFLAG:RECEIVER:手上精液 = 1 + (FLAG:70 == 1)
		IF ABL:RECEIVER:精液中毒 > 2 && ABL:RECEIVER:技巧 > 2
			EXP:RECEIVER:精飲経験 ++
			CFLAG:RECEIVER:累計精飲 += VOLUME / 2
			CFLAG:RECEIVER:积攒度 -= VOLUME * ABL:RECEIVER:精液中毒 / 10 * (TALENT:RECEIVER:精愛味覚 + 1)
			CALL POISONBODY(RECEIVER, SENDER, 31)
		ELSE
			CALL POISONBODY(RECEIVER, SENDER, 3)
		ENDIF
	CASE 4
		EXP:RECEIVER:精液経験 += EJAC_COUNT * 3
		欲求不満解消係数 = 800 / MIN(100 + ABL:RECEIVER:精液中毒 * 10, 200)
		IF TALENT:RECEIVER:精愛味覚
			SOURCE:RECEIVER:快Ｍ += EJAC_COUNT * 10
			欲求不満解消係数 += 1
		ENDIF
		IF SELECTCOM == 140
			精飲量 = VOLUME
			EXP:RECEIVER:精飲経験 += EJAC_COUNT * 3
		ELSEIF RAND:(MIN(60, EXP:RECEIVER:精飲経験 + 1)) > 10 + RAND:30
			精飲量 = VOLUME
			EXP:RECEIVER:精飲経験 += EJAC_COUNT * 3
		ELSE
			精飲量 = VOLUME / 3
			EXP:RECEIVER:精飲経験 += EJAC_COUNT
			欲求不満解消係数 /= 2
		ENDIF
		CALL INJECT_SEMEN(RECEIVER, 4, 精飲量)
		STAIN:RECEIVER:口 |= 4
		CFLAG:RECEIVER:口内精液 = 1 + (FLAG:70 == 1)
		CALL POISONBODY(RECEIVER, SENDER, 4)
		CFLAG:RECEIVER:积攒度 -= SQRT(VOLUME) * 欲求不満解消係数 / 4
	CASE 5
		EXP:RECEIVER:精液経験 += EJAC_COUNT * 3
		CALL INJECT_SEMEN(RECEIVER, 5, VOLUME)
		CFLAG:RECEIVER:脸上精液 = 1 + (FLAG:70 == 1)
		SIF TFLAG:特殊COM == 12
			STAIN:RECEIVER:口 |= 4
		CALL POISONBODY(RECEIVER, SENDER, 5)
	CASE 6
		EXP:RECEIVER:精液経験 += EJAC_COUNT
		CALL INJECT_SEMEN(RECEIVER, 6, VOLUME)
		CALL POISONBODY(RECEIVER, SENDER, 6)
	CASE 7
		EXP:RECEIVER:精液経験 += EJAC_COUNT
		CALL INJECT_SEMEN(RECEIVER, 7, VOLUME)
		CALL POISONBODY(RECEIVER, SENDER, 7)
	CASE 8
		EXP:RECEIVER:精液経験 += EJAC_COUNT * 2
		CALL INJECT_SEMEN(RECEIVER, 8, VOLUME)
		CALL POISONBODY(RECEIVER, SENDER, 8)
ENDSELECT

SIF SHIRAHU(RECEIVER)
	CALL ADDICTION_SOURCE(RECEIVER, SENDER)

IF MAGIC_DLC
	CFLAG:RECEIVER:积攒度 = LIMIT(CFLAG:RECEIVER:积攒度, 0, 积攒度上限(RECEIVER))
ELSE
	CFLAG:RECEIVER:积攒度 = LIMIT(CFLAG:RECEIVER:积攒度, 0, MAX_积攒度)
ENDIF

;射精された精子を子宮内へ送る処理
@SEMEN_CERVIX_INTAKE(射精した精液量, 射精した角色, 射精された角色)
#DIM 射精した精液量
#DIM 射精された角色
#DIM 減算補正値
#DIM 加算値
#DIM 射精した角色

;73,挿入子宮口玩弄
IF SELECTCOM == 73
	減算補正値 = 100
ELSE
	SELECTCASE TEQUIP:射精された角色:子宮
	CASE 0
		減算補正値 = 150
	CASE 1
		減算補正値 = 120
	CASE 2
		減算補正値 = 100
ENDSELECT
ENDIF

;だいしゅきホールド
SIF TCVAR:射精された角色:Counter行動的派生 == 2 && TCVAR:射精された角色:Counter行動 == 500
	減算補正値 -= 30

加算値 = 射精した精液量 - 減算補正値

IF !TALENT:射精された角色:路人
	IF EXP:射精された角色:子宮口開発経験 < 100
		加算値 /= 2
	ELSEIF EXP:射精された角色:子宮口開発経験 < 300
		加算値 = 加算値 * 2 / 3
	ENDIF
ENDIF

;計算結果が負なら加算しない
IF 加算値 < 0
	RETURN 0
ENDIF
SIF 射精された角色 == MASTER
	TCVAR:射精した角色:種付け量 += 加算値
EX:射精された角色:子宮内精液 += 加算値
SEMEN_MATRIX:射精された角色:射精した角色:子宫内射精量 += 加算値

;通常の指令外で你がＶに出した時の処理を一括でやる関数
;基本上にオナバレックス用
@ADD_SAMEN_V(ARG, 射精した精液量,無自覚)
#DIM 射精した精液量
#DIM 無自覚

SIF 射精した精液量 <= 0
	RETURN
射精した精液量 = MIN(BASE:MASTER:精力, 射精した精液量)
BASE:MASTER:精力 -= 射精した精液量
SIF TALENT:MASTER:絶倫
	射精した精液量 = 射精した精液量 * 3 / 2
NOWEX:MASTER:射精量 = 射精した精液量

;CALL INJECT_SEMEN(ARG, 1, 射精した精液量)
;CALL SEMEN_CERVIX_INTAKE(射精した精液量, MASTER, ARG)
CALL APPLY_EJACULATION(MASTER, ARG, 1, 射精した精液量, 1)

SIF !無自覚
	TCVAR:ARG:種付けられ自覚 = 1

STAIN:MASTER:Ｐ |= 1
STAIN:MASTER:Ｐ |= 4

;通常の指令外で你がＡに出した時の処理を一括でやる関数
;基本上にオナバレックス用
@ADD_SAMEN_A(ARG, 射精した精液量)
#DIM 射精した精液量

SIF 射精した精液量 <= 0
	RETURN
射精した精液量 = MIN(BASE:MASTER:精力, 射精した精液量)
BASE:MASTER:精力 -= 射精した精液量
SIF TALENT:MASTER:絶倫
	射精した精液量 = 射精した精液量 * 3 / 2
NOWEX:MASTER:射精量 = 射精した精液量

;CALL INJECT_SEMEN(ARG, 2, 射精した精液量)
CALL APPLY_EJACULATION(MASTER, ARG, 2, 射精した精液量, 1)

STAIN:MASTER:Ｐ |= 8
STAIN:MASTER:Ｐ |= 4

@ADDICTION_SOURCE(RECEIVER, SENDER)
#DIM RECEIVER
#DIM SENDER
#DIMS REVISED_FLAG
#DIM REVISION
#DIM 中毒レベル


SELECTCASE EJACU_GET_LOCATION(EJACU_STORAGE_LIVE, SENDER)
	CASE 射精箇所_膣内
		中毒レベル = ABL:RECEIVER:膣射中毒
		REVISED_FLAG = 膣内射精補正
	CASE 射精箇所_アナル
		中毒レベル = ABL:RECEIVER:肛射中毒
		REVISED_FLAG = 肛内射精補正
	CASE 射精箇所_口
		中毒レベル = ABL:RECEIVER:精液中毒
		REVISED_FLAG = 口内射精補正
	CASEELSE
		RETURN
ENDSELECT

TCVAR:RECEIVER:REVISED_FLAG = NOWEX:SENDER:射精量 * (10 + 中毒レベル)

IF TALENT:SENDER:濃厚精液
	REVISION = GET_REVISION(TCVAR:RECEIVER:REVISED_FLAG, 500, 1000)
ELSE
	REVISION = GET_REVISION(TCVAR:RECEIVER:REVISED_FLAG, 500, 2000)
ENDIF

;同時絶頂の場合増加
SIF SENDER == MASTER && SYNCED_ORGASM(RECEIVER)
	REVISION = REVISION * 5 / 4

SOURCE:RECEIVER:情愛 += REVISION * 2
SOURCE:RECEIVER:欲情 += REVISION * 2
SOURCE:RECEIVER:恭順 += REVISION
SOURCE:RECEIVER:屈従 += REVISION

TCVAR:RECEIVER:REVISED_FLAG = REVISION

@ADDICTION_SHOW(ARG, 補正名, 対応中毒)
#DIMS 対応中毒
#DIMS 補正名
#DIM REVISION

LOCAL = GETNUM(ABL, 対応中毒)

REVISION = TCVAR:ARG:補正名
SIF REVISION
	PRINTFORML %CALLNAME:ARG%（%ABL_TR(LOCAL)%{ABL:ARG:対応中毒}）：情爱＋{REVISION * 2} 情欲＋{REVISION * 2} 屈从＋{REVISION} 恭顺＋{REVISION}
IF TALENT:ARG:路人 == 1 && ABL:ARG:対応中毒 < REVISION / 150 && ABL:ARG:対応中毒 < 3
	ABL:ARG:対応中毒 ++
	CALL COLORMESSAGE(@"%CALLNAME:ARG%的%ABL_TR(LOCAL)%变成了Lv{ABL:ARG:対応中毒}",C_YELLOW,2)
ENDIF

;===========================================
;劇毒身軀の効果を規定 MASTER限定
;POINTは射精部位
;===========================================
@POISONBODY(RECEIVER, SENDER, POINT)
#DIM RECEIVER
#DIM SENDER
#DIM POINT
#DIM ゲージ増加

ゲージ増加 = 0
IF TFLAG:劇毒身軀 && SENDER == MASTER
	SELECTCASE POINT
		CASE 1
			ゲージ増加 += NOWEX:SENDER:射精量 * 3 / 2
		CASE 2
			ゲージ増加 += NOWEX:SENDER:射精量
		CASE 3
			ゲージ増加 += NOWEX:SENDER:射精量 / 5
		CASE 31
			ゲージ増加 += NOWEX:SENDER:射精量 / 2
		CASE 4
			ゲージ増加 += NOWEX:SENDER:射精量
		CASE 5
			ゲージ増加 += NOWEX:SENDER:射精量 / 2
		CASE 6
			ゲージ増加 += NOWEX:SENDER:射精量 * 3 / 4
		CASE 7
			ゲージ増加 += NOWEX:SENDER:射精量 / 5
		CASE 8
			ゲージ増加 += NOWEX:SENDER:射精量 / 10
	ENDSELECT
	SIF TALENT:SENDER:濃厚精液
		ゲージ増加 *= 2
ENDIF
TCVAR:RECEIVER:ポイズンゲージ += ゲージ増加

@EjBUp(ARG)
;EjectBaseUp
#DIM bID,3 =0,1,6
SIF BUp:9 == 2 && ARG
	RETURN
BASE:ARG:0=BASE:ARG:0+200,BASE:ARG:1+200
IF !MAGIC_DLC
	FOR LOCAL,0,3
		MAXBASE:ARG:(bID:LOCAL)+=BUp:(bID:LOCAL)
	NEXT
	SIF !ARG&&MAXBASE:0:TSP >= 6666
		MAXBASE:0:TSP += BUp:8
ELSE
	FOR LOCAL,0,3
		CALL CHANGE_MAXBASE(ARG, (bID:LOCAL), BUp:(bID:LOCAL),1)
	NEXT
	SIF TALENT:MASTER:神性 || !TALENT:MASTER:高难开局
		CALL CHANGE_MAXBASE(MASTER, 8, BUp:8,1)
ENDIF
