;===============================================================
;Packed ejaculation event

;Purpose:
;1. Solve the issue of TCVAR:12, TCVAR:50, and TFLAG:1 having overlapping roles, and the misuse TCVAR:112 with one universal source of truth
;2. Expand data model, enabling us to do things like "Character A makes MASTER ejaculate on character B", and to be a solid foundation for features like tracking semen from different characters
;3. Trade easy manipulation with clear declaration in COMF, codes are now self-documenting, *might* significantly reduce bugs in the variable manipulation process

;Note:
;Variable CSTR:10 and CSTR:11 (a confirmation snapshot of 10) are retired as a result of this rework
;While the original CSTR:10 and CSTR:11 design allowed us to direct an action at a group of people, we ultimately isn't going to make use of its design and the scope of CSTR:10 has to be redefined
;[TODO] High priority, implement the cooncept of "action target group" for commands

;[TODO] Has to do with CSTR:10 and CSTR:11 still. As of May 2026, Ejaculation gauge (BASE:射精) will only progress-
;-when the Receiver field is populated and the receiver is in the TARGET array (See ERB\ステータス計算関連\SOURCE\SOURCE_射精確定前処理.ERB, line 50)
;This is going to be reworked at a future date because masturbation commands (COMF702, 709, 743, 43) are impossible to progress ejaculation gauge with this design and not all of them should use self as receiver
;But since the commands aren't enabled I'm ignoring them for now

;Character Duplication on English branches should survive since they are practically adding a new character that is a copy of the old
;[TODO] speaking of which I should clean up the NO:CHARA on the Japanese version of the game

;EJACU_EVENT exclusive contexts (pullout promise) are intentionally not synced to old variables
;On one hand it's to discourage the use of the old format so we slowly migrate, on the other I just don't feel like they fit in there comfortably

;Design:
;One ejaculation = one atomic event packed into a single variable
;[Flags 6][AuxInit 10][MainInit 10][AuxRecv 10][MainRecv 10][Loc 5][Ctx 6]
;Users are actively discouraged from manipulating the bits directly and have to go through our helper functions here, so we can enforce safeguards on how they do certain things

;When an event variable is in an empty state, the raw value is 0 (all fields are 0)
;But if anything is written into the fields, fields that represent character IDs now use 0 to represent MASTER
;and 255 (CHARA_NONE) represents null, setters and getters are written with this in mind

;Related variables:
;TCVAR:SENDER:EJACU_EVENT         : Live event variable (doesn't survive EVENTCOMEND)
;TCVAR:SENDER:EJACU_EVENT_LAST    : Previous-turn snapshot
;TCVAR:SENDER:PENDING_EJACU_EVENT : Pending staging, supposed to be manipulated by commands before getting mapped onto EJACU_EVENT
;===============================================================
@EJACU_ENCODE(MAIN_INITIATOR, AUX_INITIATOR, MAIN_RECEIVER, AUX_RECEIVER, LOCATION, CONTEXT, FLAGS)
#FUNCTION
#DIM MAIN_INITIATOR
#DIM AUX_INITIATOR
#DIM MAIN_RECEIVER
#DIM AUX_RECEIVER
#DIM LOCATION
#DIM CONTEXT
#DIM FLAGS
RETURNF ((FLAGS & EJACU_FLAGS_MASK) << EJACU_FLAGS_SHIFT) | ((AUX_INITIATOR & EJACU_AUX_INITIATOR_MASK) << EJACU_AUX_INITIATOR_SHIFT) | ((MAIN_INITIATOR & EJACU_INITIATOR_MASK) << EJACU_INITIATOR_SHIFT) | ((AUX_RECEIVER & EJACU_AUX_RECEIVER_MASK) << EJACU_AUX_RECEIVER_SHIFT) | ((MAIN_RECEIVER & EJACU_RECEIVER_MASK) << EJACU_RECEIVER_SHIFT) | ((LOCATION & EJACU_LOCATION_MASK) << EJACU_LOCATION_SHIFT) | (CONTEXT & EJACU_CONTEXT_MASK)

;===============================================================
;STORAGE dispatches for the actual TCVAR slot
;===============================================================
@EJACU_READ_RAW(STORAGE, SENDER_ID)
#FUNCTION
#DIM STORAGE
#DIM SENDER_ID
SELECTCASE STORAGE
	CASE EJACU_STORAGE_PENDING
		RETURNF TCVAR:SENDER_ID:PENDING_EJACU_EVENT
	CASE EJACU_STORAGE_LAST
		RETURNF TCVAR:SENDER_ID:EJACU_EVENT_LAST
	CASEELSE
		RETURNF TCVAR:SENDER_ID:EJACU_EVENT
ENDSELECT

@EJACU_WRITE_RAW(STORAGE, SENDER_ID, VALUE)
#DIM STORAGE
#DIM SENDER_ID
#DIM VALUE
SELECTCASE STORAGE
	CASE EJACU_STORAGE_PENDING
		TCVAR:SENDER_ID:PENDING_EJACU_EVENT = VALUE
	CASE EJACU_STORAGE_LAST
		TCVAR:SENDER_ID:EJACU_EVENT_LAST = VALUE
	CASEELSE
		TCVAR:SENDER_ID:EJACU_EVENT = VALUE
ENDSELECT

;===============================================================
;Slot validity checks
;===============================================================
@EJACU_RECEIVER_IS_CHARACTER(ID)
#FUNCTION
#DIM ID
RETURNF !GROUPMATCH(ID, CHARA_NONE, RECEIVER_ONAHOLE)

@EJACU_INITIATOR_IS_CHARACTER(ID)
#FUNCTION
#DIM ID
RETURNF ID != CHARA_NONE

@EJACU_IS_EMPTY(STORAGE, SENDER_ID)
#FUNCTION
#DIM STORAGE
#DIM SENDER_ID
RETURNF EJACU_READ_RAW(STORAGE, SENDER_ID) == 0

;===============================================================
;Field setters
;===============================================================
;on first write to an empty event, seed character-ID fields to CHARA_NONE so unpopulated slots read as null instead of MASTER (raw 0)
@EJACU_SEED_IF_EMPTY(STORAGE, SENDER_ID)
#DIM STORAGE
#DIM SENDER_ID
SIF EJACU_READ_RAW(STORAGE, SENDER_ID) != 0
	RETURN
CALL EJACU_WRITE_RAW(STORAGE, SENDER_ID, (CHARA_NONE << EJACU_AUX_INITIATOR_SHIFT) | (CHARA_NONE << EJACU_INITIATOR_SHIFT) | (CHARA_NONE << EJACU_AUX_RECEIVER_SHIFT) | (CHARA_NONE << EJACU_RECEIVER_SHIFT))

@EJACU_SET_LOCATION(STORAGE, SENDER_ID, LOCATION)
#DIM STORAGE
#DIM SENDER_ID
#DIM LOCATION
#DIM RAW
;0 means clear field, other values must fall in LOCATION range
SIF LOCATION != 0 && !INRANGE(LOCATION, EJACU_LOCATION_MIN, EJACU_LOCATION_MAX)
	THROW EJACU_SET_LOCATION: intake value {LOCATION} not in LOCATION range
CALL EJACU_SEED_IF_EMPTY(STORAGE, SENDER_ID)
RAW = EJACU_READ_RAW(STORAGE, SENDER_ID)
CALL EJACU_WRITE_RAW(STORAGE, SENDER_ID, (RAW & ~(EJACU_LOCATION_MASK << EJACU_LOCATION_SHIFT)) | ((LOCATION & EJACU_LOCATION_MASK) << EJACU_LOCATION_SHIFT))

@EJACU_SET_CONTEXT(STORAGE, SENDER_ID, CONTEXT)
#DIM STORAGE
#DIM SENDER_ID
#DIM CONTEXT
#DIM RAW
;0 means clear field, other values must fall in CONTEXT range
SIF CONTEXT != 0 && !INRANGE(CONTEXT, EJACU_CONTEXT_MIN, EJACU_CONTEXT_MAX)
	THROW EJACU_SET_CONTEXT: intake value {CONTEXT} not in CONTEXT range
CALL EJACU_SEED_IF_EMPTY(STORAGE, SENDER_ID)
RAW = EJACU_READ_RAW(STORAGE, SENDER_ID)
CALL EJACU_WRITE_RAW(STORAGE, SENDER_ID, (RAW & ~EJACU_CONTEXT_MASK) | (CONTEXT & EJACU_CONTEXT_MASK))

@EJACU_SET_RECEIVER(STORAGE, SENDER_ID, RECEIVER, SLOT)
#DIM STORAGE
#DIM SENDER_ID
#DIM RECEIVER
#DIM SLOT
#DIM OTHER
#DIM RAW
;stray uninitialized values become CHARA_NONE
SIF EJACU_RECEIVER_IS_CHARACTER(RECEIVER) && !INRANGE(RECEIVER, 0, CHARANUM - 1)
	RECEIVER = CHARA_NONE
CALL EJACU_SEED_IF_EMPTY(STORAGE, SENDER_ID)

;a real character cannot occupy both MAIN and AUX simultaneously
IF EJACU_RECEIVER_IS_CHARACTER(RECEIVER)
	SELECTCASE SLOT
		CASE EJACU_SLOT_AUX
			OTHER = EJACU_GET_RECEIVER(STORAGE, SENDER_ID, EJACU_SLOT_MAIN)
		CASEELSE
			OTHER = EJACU_GET_RECEIVER(STORAGE, SENDER_ID, EJACU_SLOT_AUX)
	ENDSELECT
	SIF EJACU_RECEIVER_IS_CHARACTER(OTHER) && OTHER == RECEIVER
		THROW EJACU_SET_RECEIVER: receiver {RECEIVER} already in opposite slot for SENDER {SENDER_ID} STORAGE {STORAGE}
ENDIF

RAW = EJACU_READ_RAW(STORAGE, SENDER_ID)
SELECTCASE SLOT
	CASE EJACU_SLOT_AUX
		CALL EJACU_WRITE_RAW(STORAGE, SENDER_ID, (RAW & ~(EJACU_AUX_RECEIVER_MASK << EJACU_AUX_RECEIVER_SHIFT)) | ((RECEIVER & EJACU_AUX_RECEIVER_MASK) << EJACU_AUX_RECEIVER_SHIFT))
	CASEELSE
		CALL EJACU_WRITE_RAW(STORAGE, SENDER_ID, (RAW & ~(EJACU_RECEIVER_MASK << EJACU_RECEIVER_SHIFT)) | ((RECEIVER & EJACU_RECEIVER_MASK) << EJACU_RECEIVER_SHIFT))
ENDSELECT

@EJACU_SET_INITIATOR(STORAGE, SENDER_ID, INITIATOR, SLOT)
#DIM STORAGE
#DIM SENDER_ID
#DIM INITIATOR
#DIM SLOT
#DIM OTHER
#DIM RAW
;stray uninitialized values become CHARA_NONE
SIF EJACU_INITIATOR_IS_CHARACTER(INITIATOR) && !INRANGE(INITIATOR, 0, CHARANUM - 1)
	INITIATOR = CHARA_NONE
CALL EJACU_SEED_IF_EMPTY(STORAGE, SENDER_ID)

;a real character cannot occupy both MAIN and AUX simultaneously
IF EJACU_INITIATOR_IS_CHARACTER(INITIATOR)
	SELECTCASE SLOT
		CASE EJACU_SLOT_AUX
			OTHER = EJACU_GET_INITIATOR(STORAGE, SENDER_ID, EJACU_SLOT_MAIN)
		CASEELSE
			OTHER = EJACU_GET_INITIATOR(STORAGE, SENDER_ID, EJACU_SLOT_AUX)
	ENDSELECT
	SIF EJACU_INITIATOR_IS_CHARACTER(OTHER) && OTHER == INITIATOR
		THROW EJACU_SET_INITIATOR: initiator {INITIATOR} already in opposite slot for SENDER {SENDER_ID} STORAGE {STORAGE}
ENDIF

RAW = EJACU_READ_RAW(STORAGE, SENDER_ID)
SELECTCASE SLOT
	CASE EJACU_SLOT_AUX
		CALL EJACU_WRITE_RAW(STORAGE, SENDER_ID, (RAW & ~(EJACU_AUX_INITIATOR_MASK << EJACU_AUX_INITIATOR_SHIFT)) | ((INITIATOR & EJACU_AUX_INITIATOR_MASK) << EJACU_AUX_INITIATOR_SHIFT))
	CASEELSE
		CALL EJACU_WRITE_RAW(STORAGE, SENDER_ID, (RAW & ~(EJACU_INITIATOR_MASK << EJACU_INITIATOR_SHIFT)) | ((INITIATOR & EJACU_INITIATOR_MASK) << EJACU_INITIATOR_SHIFT))
ENDSELECT

@EJACU_SET_FLAGS(STORAGE, SENDER_ID, FLAGS)
#DIM STORAGE
#DIM SENDER_ID
#DIM FLAGS
#DIM RAW
;FLAGS replaces existing flags entirely, to OR in one flag:
;  EJACU_SET_FLAGS(EJACU_STORAGE_LIVE, MASTER, EJACU_GET_FLAGS(EJACU_STORAGE_LIVE, MASTER) | 射精フラグ_コンドーム)
CALL EJACU_SEED_IF_EMPTY(STORAGE, SENDER_ID)
RAW = EJACU_READ_RAW(STORAGE, SENDER_ID)
CALL EJACU_WRITE_RAW(STORAGE, SENDER_ID, (RAW & ~(EJACU_FLAGS_MASK << EJACU_FLAGS_SHIFT)) | ((FLAGS & EJACU_FLAGS_MASK) << EJACU_FLAGS_SHIFT))

;Fancy way to just set the TCVARs to 0, this is easier to search so using this is heavily encouraged
@EJACU_CLEAR(STORAGE, SENDER_ID)
#DIM STORAGE
#DIM SENDER_ID
CALL EJACU_WRITE_RAW(STORAGE, SENDER_ID, 0)

;===============================================================
;Field getters
;===============================================================
@EJACU_GET_CONTEXT(STORAGE, SENDER_ID)
#FUNCTION
#DIM STORAGE
#DIM SENDER_ID
RETURNF EJACU_READ_RAW(STORAGE, SENDER_ID) & EJACU_CONTEXT_MASK

@EJACU_GET_LOCATION(STORAGE, SENDER_ID)
#FUNCTION
#DIM STORAGE
#DIM SENDER_ID
RETURNF (EJACU_READ_RAW(STORAGE, SENDER_ID) >> EJACU_LOCATION_SHIFT) & EJACU_LOCATION_MASK

@EJACU_GET_RECEIVER(STORAGE, SENDER_ID, SLOT)
#FUNCTION
#DIM STORAGE
#DIM SENDER_ID
#DIM SLOT
#DIM RAW

RAW = EJACU_READ_RAW(STORAGE, SENDER_ID)
SIF RAW == 0
	RETURNF CHARA_NONE

SELECTCASE SLOT
	CASE EJACU_SLOT_AUX
		RETURNF (RAW >> EJACU_AUX_RECEIVER_SHIFT) & EJACU_AUX_RECEIVER_MASK
	CASEELSE
		RETURNF (RAW >> EJACU_RECEIVER_SHIFT) & EJACU_RECEIVER_MASK
ENDSELECT

@EJACU_GET_INITIATOR(STORAGE, SENDER_ID, SLOT)
#FUNCTION
#DIM STORAGE
#DIM SENDER_ID
#DIM SLOT
#DIM RAW

RAW = EJACU_READ_RAW(STORAGE, SENDER_ID)
SIF RAW == 0
	RETURNF CHARA_NONE

SELECTCASE SLOT
	CASE EJACU_SLOT_AUX
		RETURNF (RAW >> EJACU_AUX_INITIATOR_SHIFT) & EJACU_AUX_INITIATOR_MASK
	CASEELSE
		RETURNF (RAW >> EJACU_INITIATOR_SHIFT) & EJACU_INITIATOR_MASK
ENDSELECT

@EJACU_GET_FLAGS(STORAGE, SENDER_ID)
#FUNCTION
#DIM STORAGE
#DIM SENDER_ID
RETURNF (EJACU_READ_RAW(STORAGE, SENDER_ID) >> EJACU_FLAGS_SHIFT) & EJACU_FLAGS_MASK

@EJACU_HAS_CONDOM(STORAGE, SENDER_ID)
#FUNCTION
#DIM STORAGE
#DIM SENDER_ID
RETURNF (EJACU_GET_FLAGS(STORAGE, SENDER_ID) & 射精フラグ_コンドーム) != 0


;===============================================================
;COMF-layer entry point

;Purpose:
;replaces the old variable writes with one self-documenting call

;stages the event in TCVAR:SENDER:PENDING_EJACU_EVENT, which is consumed by @EVENT_SHOOT when the ejaculation gauge actually fires
;The CONDOM flag is added by @EVENT_SHOOT at fire time, so callers don't have to pass it
;===============================================================
@DECLARE_EJACULATION(SENDER, CONTEXT, LOCATION, MAIN_RECEIVER, AUX_RECEIVER, MAIN_INITIATOR, AUX_INITIATOR, INTENSITY)
#DIM SENDER
#DIM CONTEXT
#DIM LOCATION
#DIM MAIN_RECEIVER
#DIM AUX_RECEIVER
#DIM MAIN_INITIATOR
#DIM AUX_INITIATOR
#DIM INTENSITY

SIF CONTEXT != 0 && !INRANGE(CONTEXT, EJACU_CONTEXT_MIN, EJACU_CONTEXT_MAX)
	THROW DECLARE_EJACULATION: CONTEXT {CONTEXT} out of range
SIF LOCATION != 0 && !INRANGE(LOCATION, EJACU_LOCATION_MIN, EJACU_LOCATION_MAX)
	THROW DECLARE_EJACULATION: LOCATION {LOCATION} out of range

;stray receiver/initiator IDs collapse to CHARA_NONE
SIF EJACU_RECEIVER_IS_CHARACTER(MAIN_RECEIVER) && !INRANGE(MAIN_RECEIVER, 0, CHARANUM - 1)
	MAIN_RECEIVER = CHARA_NONE
SIF EJACU_RECEIVER_IS_CHARACTER(AUX_RECEIVER) && !INRANGE(AUX_RECEIVER, 0, CHARANUM - 1)
	AUX_RECEIVER = CHARA_NONE
SIF EJACU_INITIATOR_IS_CHARACTER(MAIN_INITIATOR) && !INRANGE(MAIN_INITIATOR, 0, CHARANUM - 1)
	MAIN_INITIATOR = CHARA_NONE
SIF EJACU_INITIATOR_IS_CHARACTER(AUX_INITIATOR) && !INRANGE(AUX_INITIATOR, 0, CHARANUM - 1)
	AUX_INITIATOR = CHARA_NONE

;a real character cannot occupy both MAIN and AUX simultaneously
SIF EJACU_RECEIVER_IS_CHARACTER(MAIN_RECEIVER) && EJACU_RECEIVER_IS_CHARACTER(AUX_RECEIVER) && MAIN_RECEIVER == AUX_RECEIVER
	THROW DECLARE_EJACULATION: MAIN_RECEIVER and AUX_RECEIVER both = {MAIN_RECEIVER}
SIF EJACU_INITIATOR_IS_CHARACTER(MAIN_INITIATOR) && EJACU_INITIATOR_IS_CHARACTER(AUX_INITIATOR) && MAIN_INITIATOR == AUX_INITIATOR
	THROW DECLARE_EJACULATION: MAIN_INITIATOR and AUX_INITIATOR both = {MAIN_INITIATOR}

CALL EJACU_WRITE_RAW(EJACU_STORAGE_PENDING, SENDER, EJACU_ENCODE(MAIN_INITIATOR, AUX_INITIATOR, MAIN_RECEIVER, AUX_RECEIVER, LOCATION, CONTEXT, 0))
TCVAR:SENDER:射精快感強度 = MAX(INTENSITY, 0)


;===============================================================
;attempt to push PENDING to live and clear PENDING always
;called by @EVENT_SHOOT when the ejaculation gauge fires
;===============================================================
@EJACU_COMMIT_PENDING(SENDER_ID)
#DIM SENDER_ID
IF !EJACU_IS_EMPTY(EJACU_STORAGE_PENDING, SENDER_ID)
	CALL EJACU_WRITE_RAW(EJACU_STORAGE_LIVE, SENDER_ID, EJACU_READ_RAW(EJACU_STORAGE_PENDING, SENDER_ID))
	DEBUGPRINTFORML [EJACU_COMMIT_PENDING] SENDER={SENDER_ID} CTX={EJACU_GET_CONTEXT(EJACU_STORAGE_LIVE, SENDER_ID)} LOC={EJACU_GET_LOCATION(EJACU_STORAGE_LIVE, SENDER_ID)} MAIN_RCV={EJACU_GET_RECEIVER(EJACU_STORAGE_LIVE, SENDER_ID, EJACU_SLOT_MAIN)} AUX_RCV={EJACU_GET_RECEIVER(EJACU_STORAGE_LIVE, SENDER_ID, EJACU_SLOT_AUX)} MAIN_INI={EJACU_GET_INITIATOR(EJACU_STORAGE_LIVE, SENDER_ID, EJACU_SLOT_MAIN)} AUX_INI={EJACU_GET_INITIATOR(EJACU_STORAGE_LIVE, SENDER_ID, EJACU_SLOT_AUX)} FLAGS={EJACU_GET_FLAGS(EJACU_STORAGE_LIVE, SENDER_ID)}
ENDIF
CALL EJACU_CLEAR(EJACU_STORAGE_PENDING, SENDER_ID)


;===============================================================
;turn-end rotation
;snapshots live to LAST, then clears live and PENDING
;===============================================================
@EJACU_ADVANCE_TURN(SENDER_ID)
#DIM SENDER_ID
CALL EJACU_WRITE_RAW(EJACU_STORAGE_LAST, SENDER_ID, EJACU_READ_RAW(EJACU_STORAGE_LIVE, SENDER_ID))
CALL EJACU_CLEAR(EJACU_STORAGE_LIVE, SENDER_ID)
CALL EJACU_CLEAR(EJACU_STORAGE_PENDING, SENDER_ID)


;===============================================================
;derive legacy variables from EJACU_EVENT
;some behaviors are obviously bad but they are done so to stay faithful to the original
;===============================================================
@SYNC_LEGACY_FROM_EJACU_EVENT(SENDER)
#DIM SENDER
#DIM LOC
#DIM CTX
#DIM FLAGS
#DIM LEGACY_BIT
#DIM LEGACY_BIT_2
#DIM HAS_CONDOM

LOC = EJACU_GET_LOCATION(EJACU_STORAGE_LIVE, SENDER)
CTX = EJACU_GET_CONTEXT(EJACU_STORAGE_LIVE, SENDER)
FLAGS = EJACU_GET_FLAGS(EJACU_STORAGE_LIVE, SENDER)
HAS_CONDOM = (FLAGS & 射精フラグ_コンドーム) != 0
LEGACY_BIT = 0
LEGACY_BIT_2 = 0

SELECTCASE LOC
	CASE 射精箇所_膣内
		LEGACY_BIT = 1
	CASE 射精箇所_アナル
		LEGACY_BIT = 2
	CASE 射精箇所_手
		LEGACY_BIT = 3
	CASE 射精箇所_口
		LEGACY_BIT = 4
	CASE 射精箇所_胸
		LEGACY_BIT = 5
	CASE 射精箇所_脚
		LEGACY_BIT = 6
	CASE 射精箇所_足裏
		LEGACY_BIT = 7
	CASE 射精箇所_体表
		LEGACY_BIT = 8
	CASE 射精箇所_脇コキ
		LEGACY_BIT = 14
	CASE 射精箇所_膣口
		LEGACY_BIT = 15
ENDSELECT

SELECTCASE CTX
	CASE 射精場合_泡踊り
		LEGACY_BIT = 8
	CASE 射精場合_アナル奉仕
		LEGACY_BIT = 9
	CASE 射精場合_道具
		LEGACY_BIT = 10
	CASE 射精場合_Ａ責め
		LEGACY_BIT = 12
	CASE 射精場合_Ｖ責め
		LEGACY_BIT = 13
	CASE 射精場合_手淫フェラ
		LEGACY_BIT_2 = 20
	CASE 射精場合_パイズリフェラ
		LEGACY_BIT_2 = 21
	CASE 射精場合_シックスナイン
		LEGACY_BIT_2 = 22
	CASE 射精場合_イラマチオ
		LEGACY_BIT_2 = 23
	CASE 射精場合_子宮口責め
		LEGACY_BIT_2 = 24
	CASE 射精場合_授乳プレイ
		LEGACY_BIT_2 = 26
ENDSELECT

;TCVAR:2, TCVAR:12
;write to TCVAR:2 should be redundant but whatever
IF LEGACY_BIT > 0
	TCVAR:SENDER:射精部位 = LEGACY_BIT
	TCVAR:SENDER:已射精部位FLAG = LEGACY_BIT
ENDIF

;TFLAG:1, TCVAR:RECEIVER:50
;the old system doesn't write these when a futanari character ejaculates so we just stop here
SIF SENDER != PLAYER
	RETURN

SIF SAMEN_DIRECTION2(PLAYER, MASTER_POSE(0,SET_P)) && LEGACY_BIT > 0
	SETBIT TFLAG:1, LEGACY_BIT

SIF HAS_CONDOM
	SETBIT TFLAG:1, 0
SIF LEGACY_BIT_2 > 0
	SETBIT TFLAG:1, LEGACY_BIT_2

IF LEGACY_BIT > 0
	LOCAL = EJACU_GET_RECEIVER(EJACU_STORAGE_LIVE, PLAYER, EJACU_SLOT_MAIN)
	SIF INRANGE(LOCAL, 1, CHARANUM - 1)
		SETBIT TCVAR:LOCAL:50, LEGACY_BIT
	LOCAL = EJACU_GET_RECEIVER(EJACU_STORAGE_LIVE, PLAYER, EJACU_SLOT_AUX)
	SIF INRANGE(LOCAL, 1, CHARANUM - 1)
		SETBIT TCVAR:LOCAL:50, LEGACY_BIT
ENDIF

SIF HAS_CONDOM
	SETBIT TCVAR:50, 0
SIF LEGACY_BIT_2 > 0
	SETBIT TCVAR:50, LEGACY_BIT_2
