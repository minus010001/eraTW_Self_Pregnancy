@SEMEN_LEAK_GET_AMOUNT(CHARA, ITERATION = "PASSIVE", HOLE)
#LOCALSIZE 2
#LOCALSSIZE 1
#DIM CHARA
#DIMS ITERATION
#DIM HOLE
#DIM ELAPSED
#DIM DYNAMIC DO_V
#DIM DYNAMIC DO_A
#DIM DYNAMIC V_SPILLABLE_AMOUNT
#DIM DYNAMIC A_SPILLABLE_AMOUNT

SIF CHARA <= 0 || CHARA >= CHARANUM
	RETURN

V_SPILLABLE_AMOUNT = EX:CHARA:精液残量 - TCVAR:CHARA:Ｖ精液漏出量
A_SPILLABLE_AMOUNT = EX:CHARA:アナル精液残量 - TCVAR:CHARA:Ａ精液漏出量

SELECTCASE ITERATION
	CASE "PASSIVE"
		ELAPSED = TIME_PROGRESS(TIME:1)
		SIF !ELAPSED
			RETURN

		IF V_SPILLABLE_AMOUNT >= 30 && !CFLAG:CHARA:Ｖ漏出阻止 && ELAPSED >= 2
			;floor (2) + amount / 80 to simulate pressure
			LOCAL:1 = 2 + V_SPILLABLE_AMOUNT / 80
			;some 2-min intervals are dry
			LOCAL = MAX(ELAPSED / 2 - RAND:(ELAPSED / 5 + 1), 1)
			TCVAR:CHARA:Ｖ精液漏出量 += LOCAL * LOCAL:1 + RAND:(LOCAL:1 + 1)
		ENDIF
		IF A_SPILLABLE_AMOUNT >= 30 && !CFLAG:CHARA:Ａ漏出阻止 && ELAPSED >= 2
			LOCAL:1 = 2 + A_SPILLABLE_AMOUNT / 80
			LOCAL = MAX(ELAPSED / 2 - RAND:(ELAPSED / 5 + 1), 1)
			TCVAR:CHARA:Ａ精液漏出量 += LOCAL * LOCAL:1 + RAND:(LOCAL:1 + 1)
		ENDIF
	CASE "PULLOUT"
		IF HOLE >= 1
			DO_A = 1
		ELSE
			DO_V = 1
		ENDIF

		IF DO_V && EX:CHARA:精液残量 > 0 && (CFLAG:CHARA:Ｖ漏出阻止 <= 0 && !TEQUIP:CHARA:バイブ)
			LOCAL = EX:CHARA:精液残量 * (10 + RAND:11) / 100
			;apply soft cap
			IF LOCAL > 60
				LOCAL:1 = LOCAL - 60
				LOCAL = 60
				TIMES LOCAL:1, 0.2
			ENDIF
			TCVAR:CHARA:Ｖ精液漏出量 = LOCAL + LOCAL:1
		ENDIF
		IF DO_A && EX:CHARA:アナル精液残量 > 0 && (CFLAG:CHARA:Ａ漏出阻止 <= 0 && (!TEQUIP:CHARA:アナルバイブ && !TEQUIP:CHARA:アナルビーズ))
			LOCAL = EX:CHARA:アナル精液残量 * (10 + RAND:11) / 100
			IF LOCAL > 60
				LOCAL:1 = LOCAL - 60
				LOCAL = 60
				TIMES LOCAL:1, 0.2
			ENDIF
			TCVAR:CHARA:Ａ精液漏出量 = LOCAL + LOCAL:1
		ENDIF
	CASEELSE
		THROW Invalid iteration for @SEMEN_LEAK_GET_AMOUNT.  ITERATION = %ITERATION%
ENDSELECT

;calculate pullout, passive leak, then apply all amounts, reset
;called after KOJO messages
@SEMEN_LEAK_END_OF_TURN()
#LOCALSIZE 1
#LOCALSSIZE 1
FOR LOCAL, 0, CHARANUM
	SIF CFLAG:LOCAL:出禁
		CONTINUE
