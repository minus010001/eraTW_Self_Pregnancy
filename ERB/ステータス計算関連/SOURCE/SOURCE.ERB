			CALL SEMEN_LEAK_GET_AMOUNT(LOCAL, "PULLOUT", 0)
		ELSEIF TEQUIP:LOCAL:体位２ && TEQUIP:LOCAL:体位 != TEQUIP:LOCAL:体位２
			CALL SEMEN_LEAK_GET_AMOUNT(LOCAL, "PULLOUT", 0)
		ENDIF
	ENDIF
	IF TEQUIP:LOCAL:アナル２ == SET_P
		IF TEQUIP:LOCAL:Ａ接触部位 != SET_P
			CALL SEMEN_LEAK_GET_AMOUNT(LOCAL, "PULLOUT", 1)
		ELSEIF TEQUIP:LOCAL:体位２ && TEQUIP:LOCAL:体位 != TEQUIP:LOCAL:体位２
			CALL SEMEN_LEAK_GET_AMOUNT(LOCAL, "PULLOUT", 1)
		ENDIF
