@SAMEN_DIRECTION(ARG,ARG:1)
#FUNCTION
;ARG 射精する人
;ARG:1 射精される人
SIF EJACU_IS_EMPTY(EJACU_STORAGE_PENDING, ARG)
	RETURNF 0
SIF EJACU_GET_RECEIVER(EJACU_STORAGE_PENDING, ARG, EJACU_SLOT_MAIN) == ARG:1
	RETURNF 1
SIF EJACU_GET_RECEIVER(EJACU_STORAGE_PENDING, ARG, EJACU_SLOT_AUX) == ARG:1
	RETURNF 1
RETURNF 0

@SAMEN_DIRECTION2(ARG,ARG:1)
#FUNCTION
;ARG 射精する人
;ARG:1 射精される人
SIF EJACU_IS_EMPTY(EJACU_STORAGE_LIVE, ARG)
	RETURNF 0
SIF EJACU_GET_RECEIVER(EJACU_STORAGE_LIVE, ARG, EJACU_SLOT_MAIN) == ARG:1
	RETURNF 1
SIF EJACU_GET_RECEIVER(EJACU_STORAGE_LIVE, ARG, EJACU_SLOT_AUX) == ARG:1
	RETURNF 1
RETURNF 0

@EVENT_SHOOT
#DIM PARTICIPANTS
#DIM EVENT_CONTEXT
#DIM EVENT_LOCATION
#DIM EVENT_SENDER
VARSET LOCAL
;射精前判定
FOR LOCAL,0,CHARANUM
	SIF !HAS_PENIS(LOCAL)
		CONTINUE
	SIF LOCAL > 0
		CALL TARGET_EJAC_CHECK(LOCAL)
	EVENT_LOCATION = EJACU_GET_LOCATION(EJACU_STORAGE_PENDING, LOCAL)
	EVENT_CONTEXT = EJACU_GET_CONTEXT(EJACU_STORAGE_PENDING, LOCAL)
	PARTICIPANTS = 0
	FOR LOCAL:1, 0, GET_TARGETNUM() + 1
		IF LOCAL:1 == 0
			LOCAL:3 = 0
		ELSE
			SIF TARGET:(LOCAL:1) <= 0
				CONTINUE
			LOCAL:3 = TARGET:(LOCAL:1)
		ENDIF
		IF SAMEN_DIRECTION(LOCAL,LOCAL:3)
			CALL EJAC_CHECK(LOCAL,LOCAL:3,PARTICIPANTS, EVENT_LOCATION, EVENT_CONTEXT)
			PARTICIPANTS ++
		ENDIF
	NEXT
NEXT
;射精処理
FOR LOCAL, 0, GET_TARGETNUM() + 1
	EVENT_SENDER = TARGET:LOCAL
	SIF LOCAL == 0
		EVENT_SENDER = MASTER

	SIF TCVAR:EVENT_SENDER:射精快感強度
		CALL EJAC_CHECK_AFTER(EVENT_SENDER)
	IF NOWEX:EVENT_SENDER:射精
		CALL EJACU_COMMIT_PENDING(EVENT_SENDER)
		SIF TCVAR:EVENT_SENDER:避孕套
			CALL EJACU_SET_FLAGS(EJACU_STORAGE_LIVE, EVENT_SENDER, EJACU_GET_FLAGS(EJACU_STORAGE_LIVE, EVENT_SENDER) | 射精フラグ_コンドーム)
		CALL SEMEN_DISPATCH(EVENT_SENDER)
		CALL SYNC_LEGACY_FROM_EJACU_EVENT(EVENT_SENDER)
		BASE:EVENT_SENDER:射精 = 0
	ENDIF
NEXT

SIF !GETBIT(TFLAG:一日一回,8) && NOWEX:PLAYER:射精
	SETBIT TFLAG:一日一回,8


@EJAC_CHECK(ARG,PRIMARY, SECONDARY, LOCATION, CONTEXT)
#DIM 技巧補正
#DIM ゲージ増加量
#DIM 総計快楽強度
#DIM Ｐ感度補正
#DIM 従順補正
#DIM 欲望補正
#DIM 奉仕精神補正
#DIM 潤滑補正
#DIM PRIMARY
#DIM SECONDARY
#DIM LOCATION
#DIM CONTEXT
#DIM divisor
;-------------------------------------------------
;射精ゲージチェック
;-------------------------------------------------

;技巧（共通）
LOCAL = ABL:PRIMARY:技巧
技巧補正 = 10 + GET_REVISION(LOCAL, 5 , 5)

;従順（共通）
LOCAL = 0
IF PRIMARY == MASTER
	LOCAL = 3
ELSE
	LOCAL = ABL:PRIMARY:従順
ENDIF
従順補正 = 10 + GET_REVISION(LOCAL, 3 , 5)

;奉仕精神(奉仕系)
LOCAL = 0
IF TCVAR:PRIMARY:奉仕FLAG || TCVAR:(ARG):奉仕FLAG
	LOCAL = ABL:PRIMARY:奉仕精神
	奉仕精神補正 = 10 + GET_REVISION(LOCAL, 10 , 5)
ELSE
	奉仕精神補正 = 10
ENDIF

;欲望(性交系)
欲望補正 = 10
IF GROUPMATCH(LOCATION, 射精箇所_膣内, 射精箇所_アナル, 射精箇所_膣口)
	LOCAL = 0
	IF PRIMARY == MASTER
		LOCAL = 3
	ELSE
		LOCAL = ABL:PRIMARY:欲望
	ENDIF
	欲望補正 = 10 + GET_REVISION(LOCAL, 5 , 3)
ENDIF

;潤滑
潤滑補正 = 10
IF GROUPMATCH(LOCATION, 射精箇所_脚, 射精箇所_膣口, 射精箇所_膣内, 射精箇所_アナル) || CONTEXT == 射精場合_泡踊り
	IF PALAM:潤滑 < PALAMLV:2
		潤滑補正 = 2
	ELSEIF PALAM:潤滑 < PALAMLV:3
		潤滑補正 = 4
	ELSEIF PALAM:潤滑 < PALAMLV:4
		潤滑補正 = 6
	ELSEIF PALAM:潤滑 < PALAMLV:7
		潤滑補正 = 8
	ELSE
		潤滑補正 = 10
	ENDIF
ENDIF

;プレイヤーのＣ感覚をみる
Ｐ感度補正 = 10 + ABL:ARG:0 / 2

[SKIPSTART]
DEBUGPRINTFORML 補正前快楽強度{TCVAR:ARG:射精快感強度}
DEBUGPRINTFORML 技巧補正{技巧補正}
DEBUGPRINTFORML 欲望補正{欲望補正}
DEBUGPRINTFORML 潤滑補正{潤滑補正}
DEBUGPRINTFORML 奉仕精神補正{奉仕精神補正}
DEBUGPRINTFORML Ｐ感度補正{Ｐ感度補正}
DEBUGPRINTFORML 部位補正{部位補正(ARG, PRIMARY, SECONDARY, LOCATION, CONTEXT)}
[SKIPEND]
総計快楽強度 = TCVAR:ARG:射精快感強度 * 技巧補正 * 従順補正 * Ｐ感度補正 * 奉仕精神補正 * 潤滑補正 * 欲望補正 * 部位補正(ARG, PRIMARY, SECONDARY, LOCATION, CONTEXT) / 10000000 * (SECONDARY + 1)

SIF CFLAG:ARG:诶嘿嘿 != 2
	総計快楽強度 = 総計快楽強度 * (BASE:ARG:精力 + MAXBASE:ARG:精力) / (MAXBASE:ARG:精力 * 2)
SIF TCVAR:ARG:避孕套
	総計快楽強度 = 総計快楽強度 * 4 / 5
SIF TEQUIP:ARG:挑逗モード
	総計快楽強度 = 総計快楽強度 * 4 / 5
SIF TALENT:ARG:路人
	総計快楽強度 = 総計快楽強度 * 4 / 5
ゲージ増加量 = 総計快楽強度

DEBUGPRINTFORML 補正後快楽強度{総計快楽強度}

SELECTCASE BASE:ARG:勃起
	CASE IS < 300
		総計快楽強度 /= 5
	CASE IS < 500
		総計快楽強度 /= 4
	CASE IS < 1000
		総計快楽強度 /= 3
	CASE IS < 1500
		総計快楽強度 /= 2
	CASE 1500
		総計快楽強度 = 総計快楽強度 * 2 / 3
ENDSELECT
BASE:ARG:勃起 = BASE:ARG:勃起 + 総計快楽強度 / 5

SELECTCASE BASE:ARG:勃起
	CASE IS < 500
		ゲージ増加量 /= 5
	CASE IS < 1000
		ゲージ増加量 /= 3
	CASE IS < 1500
		ゲージ増加量 = ゲージ増加量 / 5 * 2
	CASE 1500
		ゲージ増加量 /= 2
ENDSELECT

IF !TCVAR:ARG:要去了
	divisor = POWER(2, TCVAR:ARG:射精我慢)
	ゲージ増加量 = ゲージ増加量 / divisor
ENDIF

SIF SHOOTINGSTAR
	ゲージ増加量 *= SHOOTINGSTAR_NUM
	
BASE:ARG:射精 += ゲージ増加量

TCVAR:ARG:射精槽増加量 = ゲージ増加量

@部位補正(ARG,PRIMARY,SECONDARY, LOCATION, CONTEXT)
;-------------------------------------------------
;LOCAL 補正前の快楽強度
;ARG 射精する人
;PRIMARY 射精させる人
;SECONDARY W口交等におけるふたりめ補正
;-------------------------------------------------
#FUNCTION
#DIM PRIMARY
#DIM SECONDARY
#DIM LOCATION
#DIM CONTEXT

LOCAL = 10
;恋慕
SIF TALENT:PRIMARY:恋慕
	LOCAL += 2

IF LOCATION == 射精箇所_膣内
	SIF EX:PRIMARY:処女喪失记号
		LOCAL += 10
	SIF TALENT:PRIMARY:淫壺
		LOCAL += 3
	SIF (!FLAG:70 || CFLAG:PRIMARY:344 == 1)
		LOCAL += MAX(((ABL:PRIMARY:腰 + ABL:PRIMARY:膣 * 2) / 2 - 3), 0)
	SIF NOWEX:PRIMARY:Ｖ絶頂
		LOCAL += 1
	SIF 挿入不可(PRIMARY) == -1 && ABL:PRIMARY:膣 < 2
		LOCAL -= 2
	SIF 挿入不可(PRIMARY) == -2 && ABL:PRIMARY:膣 < 3
		LOCAL -= 5
ELSEIF LOCATION == 射精箇所_アナル
	SIF !EXP:PRIMARY:Ａ性交経験
		LOCAL += 8
	SIF TALENT:PRIMARY:尻穴狂
		LOCAL += 3
	SIF (!FLAG:70 || CFLAG:PRIMARY:344 == 1)
		LOCAL += MAX(((ABL:PRIMARY:腰 + ABL:PRIMARY:肛門 * 2) / 2 - 3), 0)
	SIF NOWEX:PRIMARY:Ａ絶頂
		LOCAL += 1
	SIF 挿入不可(PRIMARY) == -1 && ABL:PRIMARY:肛門 < 2
		LOCAL -= 2
	SIF 挿入不可(PRIMARY) == -2 && ABL:PRIMARY:肛門 < 3
		LOCAL -= 5
ELSEIF LOCATION == 射精箇所_手
	SIF TALENT:PRIMARY:器用な指
		LOCAL += 3
	SIF (!FLAG:70 || CFLAG:PRIMARY:344 == 1) && !CFLAG:恶作剧
		LOCAL += MAX((ABL:PRIMARY:指 - 2) / 2, 0)
ELSEIF LOCATION == 射精箇所_口
	SIF TALENT:PRIMARY:舌使い
		LOCAL += 3
	SIF TALENT:PRIMARY:猫舌
		LOCAL -= 2
	SIF (!FLAG:70 || CFLAG:PRIMARY:344 == 1) && !CFLAG:PRIMARY:恶作剧
		LOCAL += MAX((ABL:PRIMARY:舌 - 2) / 2, 0)
	IF CONTEXT == 射精場合_パイズリフェラ
		LOCAL += TALENT:PRIMARY:胸围
		IF (!FLAG:70 || CFLAG:PRIMARY:344 == 1) && !CFLAG:PRIMARY:恶作剧
			SELECTCASE ABL:PRIMARY:胸
				CASE 0 TO 1
					LOCAL = LOCAL - 6 + ABL:PRIMARY:胸
				CASE IS >= 2
					LOCAL += (ABL:PRIMARY:胸 - 2) / 2
			ENDSELECT
		ENDIF
	ENDIF
ELSEIF LOCATION == 射精箇所_胸
	LOCAL += TALENT:PRIMARY:胸围
	IF (!FLAG:70 || CFLAG:PRIMARY:344 == 1) && !CFLAG:PRIMARY:恶作剧
		SELECTCASE ABL:PRIMARY:胸
			CASE 0 TO 1
				LOCAL = LOCAL - 6 + ABL:PRIMARY:胸
			CASE IS >= 2
				LOCAL += (ABL:PRIMARY:胸 - 2) / 2
		ENDSELECT
	ENDIF
	IF CONTEXT == 射精場合_パイズリフェラ
		IF (!FLAG:70 || CFLAG:PRIMARY:344 == 1) && !CFLAG:PRIMARY:恶作剧
			SIF TALENT:PRIMARY:舌使い
				LOCAL += 2
			SIF TALENT:PRIMARY:猫舌
				LOCAL -= 2
			LOCAL += (ABL:PRIMARY:舌 - 2) / 2
		ENDIF
	ENDIF
ELSEIF LOCATION == 射精箇所_足裏
	SIF TALENT:PRIMARY:施虐狂
		LOCAL += 2
ELSEIF CONTEXT == 射精場合_アナル奉仕
	SIF TALENT:PRIMARY:舌使い
		LOCAL += 3
	SIF TALENT:PRIMARY:猫舌
		LOCAL -= 2
	SIF (!FLAG:70 || CFLAG:PRIMARY:344 == 1)
		LOCAL += MAX((ABL:PRIMARY:舌 - 2) / 2, 0)
ENDIF

RETURNF LOCAL
