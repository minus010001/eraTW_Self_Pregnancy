@M_KOJO_IRAI_K26(ROLE, SCENE, IRAI_ID)
#DIMS ROLE     ;角色の立场、依赖者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  IRAI_ID  ;依赖自体のID
#DIM  CLIENT_ID;依赖者IDだけ抜き出したもの
#DIM  CHK_ID   ;依赖IDだけ抜き出したもの
CHK_ID    = IRAI_ID % 1000
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
SELECTCASE ROLE
CASE OPR_委托人
	;一般依頼
	IF IS_COMMON_IRAI(IRAI_ID)
		SELECTCASE STR_DATA_IRAI(IRAI_ID, OPR_委托名, CLIENT_ID)
		CASE "一般依頼名"
			SELECTCASE SCENE
			CASE OPR_委托提示时
			;依赖を持ちかけられる时
			CASE OPR_委托非受託时
			;内容だけ见て受托しなかった时
			CASE OPR_委托受託时
			;依赖を受托した时
			CASE OPR_委托确认时
			;[366]で依赖内容を依赖人に确认した时
			CASE OPR_委托破棄时
			;受托した依赖を破弃する时
			CASE OPR_委托实行直前
			;[367]で依赖を实行する时、实行处理の前に呼び出される
			CASE OPR_委托实行直后
			;[367]で依赖を实行する时、实行处理の后に呼び出される
			CASE OPR_成功报告时
			;报告时（成功）
			CASE OPR_失败报告时
			;报告时（失败）
			;この他、报告忘れや期限切れで失败扱いになり后日依赖人に遭遇した际にも表示
			ENDSELECT
		ENDSELECT
		RETURN
	ENDIF
	
	;固有依頼
	SELECTCASE STR_DATA_IRAI(IRAI_ID, OPR_委托名, CLIENT_ID)
	;个々の依頼名で分岐
	;SCENEのWAITに关する仕样
	;WAIT无しでよい　　　　：OPR_委托提示时, OPR_委托非受託时, OPR_委托确认时, OPR_委托破棄时, OPR_成功报告时, OPR_失败报告时
	;
	;以下の2つは实际にはCARRYOUTでの地の文处理との比较检讨が必要
	;WAITを入れたほうが适当：OPR_委托实行直前, OPR_委托实行直后
	CASE "固有依頼名"
		SELECTCASE SCENE
		CASE OPR_委托提示时
		;依赖を持ちかけられる时
		CASE OPR_委托非受託时
		;内容だけ见て受托しなかった时
		CASE OPR_委托受託时
		;依赖を受托した时
		CASE OPR_委托确认时
		;[366]で依赖内容を依赖人に确认した时
		CASE OPR_委托破棄时
		;受托した依赖を破弃する时
		CASE OPR_委托实行直前
		;[367]で依赖を实行する时、实行处理の前に呼び出される
		CASE OPR_委托实行直后
		;[367]で依赖を实行する时、实行处理の后に呼び出される
		CASE OPR_成功报告时
		;报告时（成功）
		CASE OPR_失败报告时
		;报告时（失败）
		;この他、报告忘れや期限切れで失败扱いになり后日依赖人に遭遇した际にも表示
		ENDSELECT
	ENDSELECT
CASE OPR_目标
	;ここで表示されるSCENEはOPR_委托实行直前, OPR_委托实行直后だけです
	;一般依頼
	IF IS_COMMON_IRAI(IRAI_ID)
		SELECTCASE STR_DATA_IRAI(IRAI_ID, OPR_委托名, CLIENT_ID)
		;个々の依頼名で分岐してください
		CASE "一般依頼名"
		;人物が键になっていた・もしくは场所にたまたま居合わせた
			SELECTCASE SCENE
			;TARGETが呼ばれるのはこのタイミングだけ
			CASE OPR_委托实行直前
			CASE OPR_委托实行直后
			ENDSELECT
		ENDSELECT
		RETURN
	ENDIF
	SELECTCASE CSVCALLNAME(CLIENT_ID)
	;依赖者のCALLNAMEによる分岐（CSV准据）
	CASE "依頼者"
		SELECTCASE STR_DATA_IRAI(IRAI_ID, OPR_委托名, CLIENT_ID)
		CASE "固有依頼名"
			SELECTCASE SCENE
			CASE OPR_委托实行直前
			CASE OPR_委托实行直后
			ENDSELECT
		ENDSELECT
	ENDSELECT
CASE OPR_无需报告
	;日数经过时、报告不要依赖を达成していた场合に呼ばれる口上
	;ここで表示されるSCENEはOPR_委托报告不要だけです
	;SCENEが一つしか无いので分岐は不要
	;また、必ず依赖主の口上が呼ばれます
	;一般依頼
	IF IS_COMMON_IRAI(IRAI_ID)
		SELECTCASE STR_DATA_IRAI(IRAI_ID, OPR_委托名, CLIENT_ID)
		;个々の依頼名で分岐してください
		CASE "一般依頼名"
		CASE "给花浇水"
		CASE "谁的遗失物"
		ENDSELECT
		RETURN
	ENDIF
	SELECTCASE STR_DATA_IRAI(IRAI_ID, OPR_委托名, CLIENT_ID)
	CASE "固有依頼名"
	ENDSELECT
ENDSELECT
