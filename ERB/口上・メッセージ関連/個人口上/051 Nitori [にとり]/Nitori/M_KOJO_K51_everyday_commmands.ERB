;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================
@M_KOJO_EGG_MESSAGE_MESSAGECHECK_COM_K51_603
RETURN 1

@M_KOJO_EGG_MESSAGE_COM_K51_603
	;Hold Hands.
CALL D_LINE
IF K51_EGG_IS_STORM() && OUTROOF(CFLAG:MASTER:現在位置)
		;Reject if outside in a storm.
	PRINTFORMDL You try to hold Nitori's hand, but she's distracted by the weather.
	PRINTFORMDW
	CALL K51_EGG_WEATHER_REJECTION()
	WAIT
	RETURN 0
ENDIF
IF CFLAG:51:ブチギレ || MARK:51:反発刻印 || TFLAG:193 == -1
		;Reject if she's mad at you, or if you fail.
	PRINTFORMDL 你试着更靠近点荷取,可却被%SPLIT_G(@"她拍开了手:她悄悄挪更远了:她瞪了一眼")%
	PRINTFORMDW
	PRINTFORMW 「%SPLIT_G(@"这样是不是不太妥了呢？:虽然我可能会答应你的约会，但别得寸进尺哦！:我们是不是有点太急了，我觉得……还是慢慢来比较好，对吗？")%」
	RETURN 0
ENDIF
IF PREVCOM == SELECTCOM
	PRINTFORMDL 你牵着荷取的手继续走着……
ELSE
	PRINTFORMDL %SPLIT_G(@"你与荷取牵着手:你与荷取十指相扣:荷取红着脸牵上了你伸出的手")%……
ENDIF
PRINTFORMDW
SELECTCASE ABL:51:親密
	CASE IS > 5
		IF IS_CHILD(MASTER) && !RAND:3
			PRINTFORML 「嘿嘿，我都看起来像是你的姐姐了……」
		ELSEIF !IS_CHILD(MASTER) && !RAND:3
			PRINTFORML 「明明是人类和河童的组合，却看起来像对真情侣，是不是？」
		ELSE
			PRINTFORML 「%SPLIT_G(@"不要急，慢慢来……:就这样也挺好的:别人会看着我们的……")%」
		ENDIF
	CASEELSE
		PRINTFORML 「%SPLIT_G(@"盟-友-！:我们……看起来像情侣吗……?:感觉有点难为情诶……")%」
ENDSELECT
WAIT
RETURN 1

