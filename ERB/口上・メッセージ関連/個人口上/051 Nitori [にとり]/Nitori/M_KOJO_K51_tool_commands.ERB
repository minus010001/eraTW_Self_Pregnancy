;==================================================
;44,振動棒
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;==================================================
@M_KOJO_EGG_MESSAGE_MESSAGECHECK_COM_K51_44
RETURN 1

@M_KOJO_EGG_MESSAGE_COM_K51_44
IF !TEQUIP:振動棒
	PRINTFORMDL 你轻轻一拔，将沾着蜜汁油光水亮的震动棒从荷取的体内取出
	PRINTFORMDW
	PRINTFORML 「%SPLIT_G(@"咕哇啊啊啊……抽，抽出来了？:你很喜欢看抽出来的样子……对吧？:呜呜噢噢噢噢……:再插感觉要死了……要死了要死了哦哦哦……:啊啊啊啊……")%」
ELSE
	IF TFLAG:192 == -1
		PRINTFORMDL 你把震动棒抵在阴唇上的时候，荷取突然开始激烈地反抗…
		PRINTFORMDW
		PRINTFORML 「等，等一下！先别把它插进来！我还是处女啊！」
		PRINTFORMDL 真的是处女吗？这话听起来莫名的别扭，而她立刻并拢双腿，不让你贸然靠近
		PRINTFORML 「听好，我是喜欢小玩具，但这个是不是有点太过分了？有些事情，要留给特别的人！」
	ELSEIF FLAG:70
		PRINTFORMDL 你在时停的时候，把震动棒插进荷取的里面……
		PRINTFORMDW
		RETURN 1
	ELSEIF CFLAG:MASTER:イタズラ == 2
		PRINTFORMDL 你趁荷取还在呼呼大睡的时候，把震动棒插进她的体内……
		PRINTFORMDW
		RETURN 1
	ELSEIF TCVAR:强行
		PRINTFORMDL 你在荷取还在拼命反抗的时候，把震动棒插进去了……
		PRINTFORMDW
		RETURN 1
	ELSEIF THINKS_IS_VIRGIN(51)
		PRINTFORMW 「呃……啊啊？你……真要用那玩意来和我做吗……？」
		PRINTFORMDW 为什么不呢？这可是台精妙的机器，荷取作为发明家，她的第一次交给这台玩意可太合理了
		PRINTFORMW 「好恶心啊……呃，算了，快点动手吧！」
		PRINTFORMDW 荷取已经被这个念头撩拨得动情不已，也容不得她拒绝。她紧咬着嘴唇，双眼紧闭，感受着你用震动棒顶开她紧闭的阴唇
		PRINTFORMDW 她的身体还有些僵硬，你用震动棒抵住了她的阴蒂，急切地打开了电源
		PRINTFORMW 「呀啊啊啊噢噢噢噢～！」
		PRINTFORMDW 毫无防备的快感让荷取如同一张拉满的弓箭一样拱了起来，她的眼睛猛地睁开，死盯着要那根即将进入小穴的异物
		PRINTFORMDW 很好，你命令她好好地看清楚——毕竟，这是她人生中最重要的时刻
		PRINTFORMW 「啊，啊啊……要插进来了，要进去了进去了哦哦哦！」
		IF TALENT:51:処女 == 1
			PRINTFORMDW 震动棒基本没遇到什么阻力，你轻而易举地贯穿了那层处女膜，疼得荷取发出尖锐的惊叫
			PRINTFORMW 「咿呀！痛死了……！额啊……好痛啊啊啊……」
			PRINTFORMDW 你安慰她，接下来会让她更舒服起来的
		ELSE
			PRINTFORMDW 那层处女膜早就没了，因此你不费任何力气就插了进去。尽管如此，她还是缩起身体，准备迎接那场并未到来的剧痛
			PRINTFORMDW 当你把整根震动棒都推入荷取体内的时候，她露出了困惑的表情
			PRINTFORMW 「……已经……全部破了吗？」
			PRINTFORMDW 你给予肯定，顺便关心她有没有感觉到疼痛
			PRINTFORMW 「没……看来也没什么大不了的嘛，白担心一场……」
			PRINTFORMDW 荷取显而易见地松了口气，归功于自己运气好。的确，她的第一次能平安无痛，是何等的幸运
		ENDIF
		PRINTFORMDW 你开启了震动棒，她的全身随之剧烈颤抖起来。紧接着，你开始活塞般地前后抽送，缓缓地将其拔出，再重重地顶入荷取的花心
		CALL HPH_PRINT(@"「噢哦哦哦……！嗯啊啊啊啊～…！……感觉好怪噢噢噢……！HPH」","W")
		PRINTFORMDW 你问荷取，身体有没有感觉到不舒服
		PRINTFORMW 「哈啊……没，没呢……嗯啊，很舒服，不准停！」
		PRINTFORMDW 荷取的脸涨得通红，羞涩地遮住了面庞，看来他承认了自己很喜欢这种感觉嘛。任务完成！
		PRINTFORMDW 你遵循着荷取的命令，继续向深处挺进，并不停地调节着震动的强弱档位，试图想看到她更多有趣的反应
		PRINTFORMDW 随后，你就一直保持着插入的状态，让它在荷取的体内不断地刺激着她的敏感地带……
		RETURN 1
	ELSE
		IF TEQUIP:51:0 & 2
			PRINTFORMD %SPLIT_G(@"你把%SHOW_BOTTOM(51,2)%拉开，然后:拉开%SHOW_BOTTOM(51,2)%后:把%SHOW_BOTTOM(51,2)%拉起来")%
		ELSE
			PRINTFORMD 你
		ENDIF
		PRINTFORMDL  %SPLIT_G(@"将震动棒滑入荷取的%FSYN_CN("阴道",,51)%:将震动棒插入荷取体内，引发一阵阵魅惑的喘息:用震动棒贯穿荷取的身体")%…
		PRINTFORMDW
		IF PALAM:51:潤滑 < 1000
			PRINTFORMDL 里面太干了，摩擦力真够大的……
		ENDIF
		CALL HPH_PRINT(@"「%SPLIT_G(@"呜哇要启动了…！:嗯嗯…！:啊…感觉来了…！:齁哦哦哦再调高点！:%MOAN_CN("m",3,RAND(2,4))%…%MOAN_CN("m",3,RAND(2,4))%")%HPH」","W")
	ENDIF
ENDIF
WAIT
RETURN 1

