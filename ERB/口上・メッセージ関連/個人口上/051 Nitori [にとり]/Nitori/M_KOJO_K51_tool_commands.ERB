		PRINTFORMDW
		IF ABL:51:Ａ感覚 < 2
			PRINTFORML 「%SPLIT_G(@"哈啊…这样插进来好痛…:绝对会把内脏搅乱的…:啊啊啊感觉太奇怪了！:居然被小玩具插屁穴…:还是没法习惯…")%」
		ELSE
		        CALL HPH_PRINT(@"「%SPLIT_G(@"呜哇要启动了…！:嗯嗯…！:啊…感觉来了…！:齁哦哦哦再调高点！:%MOAN_CN("m",3,RAND(2,4))%…%MOAN_CN("m",3,RAND(2,4))%")%HPH」","W")
		ENDIF
	ENDIF
ENDIF
