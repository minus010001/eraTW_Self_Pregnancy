@M_KOJO_EXTRASOURCE_COM_K51_90
	;Increase source gains for the player if shirikodama play is enabled.
IF CFLAG:51:K51_EGG_EVENT_SHIRIKODAMA_PLAY
	SOURCE:MASTER:快Ａ += 400
	SOURCE:MASTER:苦痛 += 400
	SOURCE:MASTER:屈従 += 300
	SOURCE:MASTER:恐怖 += 300
ELSE
		;Increase fear anyway if not, because what if she does it?
	SOURCE:MASTER:恐怖 += 100
ENDIF
RETURN

@M_KOJO_EGG_MESSAGE_COM_K51_90
IF !CFLAG:51:K51_EGG_EVENT_SHIRIKODAMA_PLAY
		;Introductory scene for the first time.
	PRINTFORMW 「咦？就这么把宝贵的后庭交给我吗？」
	PRINTFORMDW 当你要求荷取触摸你的肛门时，她用手捂住嘴，露出了一个顽皮的坏笑
	PRINTFORMW 「我可能会忍不住把手伸进去，抓点什么宝藏出来哦，你懂的吧……？」
	PRINTFORMDL
	PRINTFORMDL [0] 正合我意
	PRINTFORMDL [1] 你敢？？
	$LOOP
	INPUT
	SELECTCASE RESULT
		CASE 0
			PRINTFORMW 「真的吗？那我可要开动了~」
			PRINTFORMDW 荷取认真地盯着你，那眼神就像看一个说胡话的疯子一样。不过，她真的该如此惊讶吗？毕竟摘取尻子玉，对于河童只是司空见惯的事情罢了
			PRINTFORMDW 河童的技术必然是无与伦比，举世无双的。能感觉到自己的命根马上就要掌握在荷取的手中，这想必就让人兴奋不已
			PRINTFORMW 「你真是个十足的大变态啊，你知道吗？」
			PRINTFORMDW 她依然咧嘴笑着，手却向下向你的后方缓缓靠近，伴随着指尖滑入你的股间，你感觉到她的手指，在你的括约肌上温柔地游走着
			PRINTFORMW 「接下来的事，可不要抱怨哦……再怎么痛苦，也不要叫得过于大声HPH」
			PRINTFORMDW 随着最后这声警告，荷取的手掌连同前臂一起，猛地贯穿了你的后穴
			PRINTFORMDW 你能感觉到她的手一路上行——比你预想的要深得更多——直到穿过你的肠道，将你的内脏搅动得七零八落
			PRINTFORMDW 由于这突如其来的冲击感，一阵轻微的恶心向你的天灵盖袭来，但你尝试聚精会神，稳住了自己的身体
			PRINTFORMDW 虽然很疼——但这感觉如此奇妙，让你分不清到底是舒服还是痛苦
			PRINTFORMDW 随后，你感受到了另一种痛楚。那是一种来自下腹部的压力，就像你体内多长了颗 \@ IS_MALE(MASTER)?睾丸#卵巢\@ ，而正有人在用力挤压着它
			PRINTFORMW 「找……到了！♪」
			PRINTFORMDW 那种感觉难以言表，荷取稍微活动了一下手指，温柔细腻地爱抚着你的尻子玉
			PRINTFORMDW 尽管她动作温柔，但那东西感觉是如此脆弱，仿佛稍有不慎就会碎掉……或是直接被硬生生地撕扯下来
			PRINTFORMW 「喔，你这颗看起来水分很足嘛。虽然我也是头一回用手这么干～」
			PRINTFORMDW 她轻轻拽了一下，你顿时感到一阵头晕目眩。然而，不知为何，这种感觉竟然也伴随着奇特的愉悦
			PRINTFORMDW 在这样玩弄了一会儿后，她松开手，顺势迅速抽出了手臂
			PRINTFORMDW 随着啵的一声，你的肛门瞬间塌陷收缩，一阵剧痛从你的下盘袭来，而那个圆圆的物体仍在持续跳动
			PRINTFORMDW 黑漆漆，却又光滑圆润，这种奇特的器官，你在相关的科普书籍上并没有见到过，这便是河童所珍视的尻子玉
			PRINTFORMDW 那股疼痛很快便消散了，与之相对应的是攀升的快感。你并不觉得快要死掉——不，这反而让你感受到了前所未有的生命力
			PRINTFORMDW 你蜷缩起身体，括约肌因刺激而剧烈地抽搐。即便如此，此刻的你也觉得异常舒爽，就像被打通了经脉一样，气血从丹田内不断地涌出
			PRINTFORMW 「哈哈哈，你没事吧？看你那副样子，好像挺享受的嘛～」
			PRINTFORMDW 你确实很享受。不知为何，刚才那一下真的爽到了极点
			CALL HPH_PRINT(@"「嘻嘻……宝贝，我们以后会经常这么干的HPH」","L")
			SOURCE:MASTER:快Ａ += 400
			SOURCE:MASTER:苦痛 += 400
			SOURCE:MASTER:屈従 += 300
			SOURCE:MASTER:恐怖 += 300
			CFLAG:51:K51_EGG_EVENT_SHIRIKODAMA_PLAY++
		CASE 1
			PRINTFORMW 「呼呼, 我会乖——乖听话的」
			PRINTFORMDW 荷取露出了一个邪恶的笑容，她一把抓过你的屁股，以一种惊人的熟练度将手指滑入了你的股间
			PRINTFORMDL 她的手指不断在你的肛门内进进出出，像是毒蛇盘旋一般，利用你对弱点的恐惧来玩弄着你
			SOURCE:MASTER:恐怖 += 100
			CFLAG:51:K51_EGG_EVENT_SHIRIKODAMA_PLAY--
		CASEELSE
			GOTO LOOP
	ENDSELECT
ELSE
	IF CFLAG:51:K51_EGG_EVENT_SHIRIKODAMA_PLAY > 0
		PRINTFORMDL 荷取 %SPLIT_G(@"侵入了你的 %FSYN(@"%SPLIT_G(@"anus:ass")%",,51)%:手插进了你的 %FSYN(@"%SPLIT_G(@"anus:ass")%",,51)%:贯穿了你的 %FSYN(@"%SPLIT_G(@"anus:ass")%",,51)%:摸索着你的 %FSYN(@"%SPLIT_G(@"anus:ass")%",,51)%:翻找着你的 %FSYN(@"%SPLIT_G(@"anus:ass")%",,51)%:滑进了你的 %FSYN(@"%SPLIT_G(@"anus:ass")%",,51)%")% and %SPLIT_G(@"按摩:捏着:拽着:玩弄:爱抚:刺激")% 你的尻子玉……
		PRINTFORMDW
		IF GET_TARGETNUM() > 1 && !RAND:2
			CALL HPH_PRINT(@"「%SPLIT_G(@"瞧瞧， \@ GET_TARGETNUM() > 2 ?everyone#%CALLNAME:(TARGET:1)%\@ 都能看见你被侵犯的样子HPH:呵呵，快让大家 \@ GET_TARGETNUM() > 2 ?everyone#%CALLNAME:(TARGET:1)%\@ 看见你这副诚实的表情呀HPH:看看 %HE_SHE(MASTER)% 有多喜欢我的手部动作， \@ GET_TARGETNUM() > 2 ?everyone#%CALLNAME:(TARGET:1)%\@～?HPH")%」","L")
		ELSE
			CALL HPH_PRINT(@"「%SPLIT_G(@"哎呀，我扯得太用力啦……开玩笑的啦！:呵呵，真的有那么舒服吗？:做这种事让我感觉肚子有点饿了呢，嘿嘿……:乖哦，乖哦……就把一切交给我来处理吧HPH:嘿嘿，你现在的表情看起来真可爱HPH:你这样子太可爱了……想叫多大声都没关系哦HPH:让我听听看你有多享受，好吗？HPH")%」","L")
		ENDIF
	ELSE
		PRINTFORMDL 荷取用手指温柔地 %SPLIT_G(@"爱抚:刺激:按摩")% 你的 %FSYN(@"anus")% 
		PRINTFORMDW
		CALL HPH_PRINT(@"「%SPLIT_G(@"这次要不要试着伸进去呢……？嘿嘿:这个小菊花真可爱，总是让我忍不住想玩弄一下……:唔，感觉还挺干净的嘛……:后面被这样弄会舒服吗？呵呵:放轻松……HPH")%」","L")
	ENDIF
ENDIF
WAIT
RETURN 1
