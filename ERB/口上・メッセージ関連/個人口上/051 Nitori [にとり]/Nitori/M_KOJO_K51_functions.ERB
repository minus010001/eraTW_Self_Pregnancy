@K51_EGG_SEMEN_COLLECTION(Location)
	;将精液存入荷取储备库并显示信息（口交及衍生行为除外）
#DIM DYNAMIC Location
#DIM DYNAMIC LoadSize
SIF !CFLAG:51:K51_EGG_EVENT_SEMEN_MILKING || CFLAG:51:K51_EGG_EVENT_SEMEN_MILKING == -2
		;仅当玩家经历过首次榨精事件时触发
	RETURN 0
LoadSize = NOWEX:MASTER:射精量
SELECTCASE Location
	CASE 1
		PRINTFORMDL 就在你开始在荷取嘴里发射的瞬间，荷取就把肉棒拔出来，将精液收集器压上你的龟头
		PRINTFORMDL 你往机器里射完精的同时，荷取开心地咽下了嘴中的一半精液。
		TIMES LoadSize,0.5
	CASEELSE
		PRINTFORMDL 还没等你反应过来，荷取就脱下了你的裤子，戴着橡胶手套攥住着你的肉棒，温柔地抓揉着。她的大拇指和食指轻轻掐住蛋袋，按压揉搓那点最敏感的部位
		PRINTFORMDL 在你交出第一发浓精之前，荷取就已经把精液收集器压上你的龟头。温热的掌心挑逗般地在你的肉根处旋转着，时轻时重地攥住又松开
		PRINTFORMDL 精液的温暖感瞬间从你的铃口传出，你往冰冷的机器中射出了一发浓精。就这样，荷取迅速地将装满了你的宝贵精子的机器，给仔细地储存好
ENDSELECT
CFLAG:51:K51_EGG_SEMEN_SUPPLY += LoadSize
CFLAG:51:K51_EGG_SEMEN_TOTAL += LoadSize
WAIT
PRINTL
CALL COLORMESSAGE(@"当前供给: %三桁区切(CFLAG:51:K51_EGG_SEMEN_SUPPLY)%/1,000",C_YELLOW,1)
CALL COLORMESSAGE(@"累计供给: %三桁区切(CFLAG:51:K51_EGG_SEMEN_TOTAL)%",C_YELLOW,1)
IF CFLAG:51:K51_EGG_SEMEN_SUPPLY > 1000
	PRINTL
	CALL COLORMESSAGE(@"供给配额已达成！下次与荷取对话时将获得报酬。",C_YELLOW,1)
ENDIF
WAIT
PRINTL
RETURN 1

