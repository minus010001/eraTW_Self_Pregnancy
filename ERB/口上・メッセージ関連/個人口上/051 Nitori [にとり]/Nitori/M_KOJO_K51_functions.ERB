@K51_EGG_MASTER(ARG,ARG:1)
	;荷取的称呼函数。控制她对玩家的称谓
	;ARG控制是否大写，ARG:1控制是否禁用色情变体
#FUNCTIONS
#DIMS Output
IF CFLAG:51:K51_EGG_ADDRESS == 2
		;如果曾建立过亲密关系则直呼其名
	RETURNF @"%CALLNAME:MASTER%"
ELSEIF TALENT:51:思慕 || TALENT:51:セフレ == 2 || IS_NONHUMAN(MASTER) || !CFLAG:51:K51_EGG_ADDRESS
		;当存在思慕/炮友关系、或玩家非人类、或关闭"盟友"称呼时，使用敬称
	IF IS_CHILD(MASTER)
		IF IS_MALE(MASTER)
			RETURNF @"%CALLNAME:MASTER%君"
		ELSE
			RETURNF @"%CALLNAME:MASTER%酱"
		ENDIF
	ELSE
		RETURNF @"%CALLNAME:MASTER%桑"
	ENDIF
ENDIF
	;若关系普通且设置"盟友"称呼，则使用该称谓。特定条件下会产生变体
	;存在炮友关系或色欲状态时，在独自相处场合会改用"炮友"称呼（除非ARG:1禁用此行为）
IF TALENT:MASTER:体型 < TALENT:51:体型 && !RAND:6
	Output = 小朋友
ELSEIF TALENT:MASTER:体型 > TALENT:51:体型 && TALENT:MASTER:体型 > 0 && !RAND:6
	Output = 大朋友
ELSEIF !ARG:1 && (TALENT:51:セフレ || TALENT:51:愛欲) && GET_TARGETNUM() == 0
		;荷取偶尔会口误
	IF !RAND:12
		Output = 情人
	ELSEIF !RAND:6 && HAS_PENIS(MASTER)
		Output '= @"%SPLIT_G(@"牛子:肉棒:阴茎")%情人"
	ELSEIF !RAND:6 && !IS_MALE(MASTER) && TALENT:MASTER:胸圍 > 0
		Output '= @"%SPLIT_G(@"奶子:乳房")%情人"
	ELSEIF !RAND:6
		Output = 性伙伴
	ELSE
		Output = 炮友
	ENDIF
ELSE
	Output = 盟友
ENDIF
SIF !ARG
		;ARG为假时转为小写
	RETURNF TOLOWER(Output)
RETURNF Output

@K51_EGG_KAPPA_TEXT(ARG,ARGS,ARGS:1)
	;以《东方三月精》常见河童背景角色的颜色打印台词
	;0=黑发河童 1=眼镜河童 2=发带河童 3=配角河童 4=锯木厂河童
LOCAL = GETCOLOR()
RESETCOLOR
SELECTCASE ARG
	CASE 0
		SETCOLOR 0x436B8E
	CASE 1
		SETCOLOR 0x4585BF
	CASE 2
		SETCOLOR 0x80B7EA
	CASE 3
		SETCOLOR 0xAED1F2
	CASE 4
		SETCOLOR 路人子店員口上色:16
ENDSELECT
SELECTCASE ARGS:1
    CASE "l", "L"
        PRINTFORML %ARGS%
    CASE "w", "W"
        PRINTFORMW %ARGS%
	CASE "str", "STR"
		CALL PRINT_STR, ARGS
	CASE "strl", "STRL"
		CALL PRINT_STRL, ARGS
	CASE "strw", "STRW"
		CALL PRINT_STRW, ARGS
    CASEELSE
        PRINTFORM %ARGS%
ENDSELECT
SETCOLOR LOCAL

