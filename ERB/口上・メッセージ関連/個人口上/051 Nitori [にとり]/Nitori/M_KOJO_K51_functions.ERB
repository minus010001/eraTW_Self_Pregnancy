@K51_EGG_CHILD_EXISTS(ARG=99,ARG:1=99,ARG:2=99,ARG:3=99)
#FUNCTION
	;ARG: 性别1=女孩，2=男孩，99=任意
	;ARG:1: 成长阶段。0=哺乳期，1=断奶期，2=玩玩具，3=学走路，4=行走，5=学说话，6=语言发展，7=学礼仪，8=入学，9=学独立，10=独立，11=婴儿(0-2岁)，12=幼儿(3-6岁)，13=儿童(7-8岁)，14=儿童及以上，15=准独立及以上，99=任意
	;ARG:2: 性格99=任意，详见K51_EGG_CHILD_PERSONALITY
	;ARG:3: 兴趣99=任意，详见K51_EGG_CHILD_HOBBY
LOCAL = 0
LOCAL:5 = 0
FOR LOCAL, 1, MIN(CFLAG:51:兒童人数+1,30)
	LOCAL:1 = 0
	LOCAL:2 = 0
	LOCAL:3 = 0
	LOCAL:4 = 0
	IF ARG == 99 || CHILD_SEX:51:LOCAL == ARG
		LOCAL:1 = 1
	ENDIF
	IF ARG:1 == 99
		LOCAL:2 = 1
	ELSE
		SELECTCASE DAY - CHILD_BIRTHDAY:51:LOCAL
			CASE IS < CHILD_離乳
				IF ARG:1 == 0 || ARG:1 == 11
					LOCAL:2 = 1
				ENDIF
			CASE IS  < CHILD_玩具
				IF ARG:1 == 1 || ARG:1 == 11
					LOCAL:2 = 1
				ENDIF
			CASE IS  < CHILD_つかまり立ち
				IF ARG:1 == 2 || ARG:1 == 11
					LOCAL:2 = 1
				ENDIF
			CASE IS  < CHILD_よちよち
				IF ARG:1 == 3 || ARG:1 == 12
					LOCAL:2 = 1
				ENDIF
			CASE IS  < CHILD_喋る
				IF ARG:1 == 4 || ARG:1 == 12
					LOCAL:2 = 1
				ENDIF
			CASE IS  < CHILD_語彙
				IF ARG:1 == 5 || ARG:1 == 12
					LOCAL:2 = 1
				ENDIF
			CASE IS  < CHILD_しつけ
				IF ARG:1 == 6 || ARG:1 == 12
					LOCAL:2 = 1
				ENDIF
			CASE IS  < CHILD_就学
				IF ARG:1 == 7 || ARG:1 == 13 || ARG:1 == 14
					LOCAL:2 = 1
				ENDIF
			CASE IS  < CHILD_自立前
				IF ARG:1 == 8 || ARG:1 == 13 || ARG:1 == 14
					LOCAL:2 = 1
				ENDIF
			CASE IS  < CHILD_自立
				IF ARG:1 == 9 || ARG:1 == 14 || ARG:1 == 15
					LOCAL:2 = 1
				ENDIF
			CASEELSE
				IF ARG:1 == 10 || ARG:1 == 14 || ARG:1 == 15
					LOCAL:2 = 1
				ENDIF
		ENDSELECT
	ENDIF
	IF ARG:2 == 99 || K51_EGG_CHILD_PERSONALITY(LOCAL) == ARG:2
		LOCAL:3 = 1
	ENDIF
	IF ARG:3 == 99 || K51_EGG_CHILD_HOBBY(LOCAL) == ARG:3
		LOCAL:4 = 1
	ENDIF
	IF LOCAL:1 == 1 && LOCAL:2 == 1 && LOCAL:3 == 1 && LOCAL:4 == 1
		LOCAL:5++
	ENDIF
NEXT
RETURNF (LOCAL:5)

