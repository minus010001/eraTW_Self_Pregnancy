@COMMISSION_WORK_SITE_2_K51_EGG(Location)
	;Hakurei Shrine - Approach.
#DIM DYNAMIC Location
SIF Location != GET_MAP_REPLACEMENT(22)
	RETURN 0
SELECTCASE COMMISSION_PROGRESS:2
	CASE IS < 0
		PRINTFORMDL 河童们正在未完工的工地周围%SPLIT_G(@"坐着:闲逛:躲藏:组装奇怪的机器:玩耍")%…
	CASE 1
		PRINTFORMDL 河童们正聚集在工地周围…
	CASE IS < 160
		PRINTFORMDL 河童们正在搭建新锯木厂的地基…
	CASE IS < 400
		PRINTFORMDL 河童们正在组装新锯木厂的框架…
	CASE IS > 700
		PRINTFORMDL 河童们正在安装新锯木厂的机械设备…
	CASEELSE
		PRINTFORMDL 河童们正热火朝天地建造新锯木厂…
ENDSELECT

