@K51_EGG_SAWMILL_EVENT(Commission,ARGS)
#DIM DYNAMIC Commission
IF !RAND:20
		;小概率提前两天完成进度
	PRINTFORMDL 在新落成的%ARGS%锯木厂里，河童们一鼓作气，卖力工作着
	PRINTFORML 「哇，这都你们造出来的？！我也得加把劲了…」
	PRINTFORMDW 现场突出一个如火如荼，工程进度大幅推进！
	COMMISSION_PROGRESS:Commission += 300
ENDIF
	;前四天不会有任何问题，不过之后很有可能出现问题
SIF COMMISSION_PROGRESS:Commission < 602
	RETURN
SELECTCASE RAND:6
	CASE 0
		PRINTFORML 「啊？预算超了？！」
		PRINTFORMDL 荷取在监督新建%ARGS%锯木厂施工的时候，发现建材不够了
		PRINTFORML 「早知道就不该加盖那个附属的%SPLIT_G(@"桑拿房:相扑场:地下泳池:黄瓜培育室:树屋")%了…」
		PRINTFORMDW 现场只得停工了
		CALL COMMISSION_STALL(Commission)
	CASE 1
		PRINTFORMDL 在%ARGS%锯木厂的新工地上，河童们越来越不安分了，无数灵感想法喷涌而出
		IF !RAND:2
			CALL K51_EGG_KAPPA_TEXT(0,@"「咦，现在要按图纸施工吗？」","")
			CALL K51_EGG_KAPPA_TEXT(1,@"「改成这样会不会更好…」","")
			CALL K51_EGG_KAPPA_TEXT(2,@"「全体目光向我看齐！我画了扩建方案！」","l")
			PRINTFORML 「别分心呀！要优先满足甲方需求啊！」
			CALL K51_EGG_KAPPA_TEXT(0,@"「那我们就继续努力！」","")
			CALL K51_EGG_KAPPA_TEXT(1,@"「加上这个甲方会更开心吧？」","")
			CALL K51_EGG_KAPPA_TEXT(2,@"「好无聊啊——…」","l")
			PRINTFORML 「不过确实很酷呢，决定了！变更设计方案！」
		ELSE
			CALL K51_EGG_KAPPA_TEXT(1,@"「忘记施工图怎么画的了…」","")
			CALL K51_EGG_KAPPA_TEXT(2,@"「管它三七二十一呢，即兴发挥吧」","")
			CALL K51_EGG_KAPPA_TEXT(0,@"「诶荷取，你在捣鼓啥呢？」","l")
			PRINTFORML 「大家快来看，用%SPLIT_G(@"水刀:激光:巨型电锯")%的话肯定比普通锯子给力」
			PRINTFORML 「所以我要拆掉现有结构，全部推倒重来，组装这套新系统！」
			CALL K51_EGG_KAPPA_TEXT(0,@"「帅爆了！」","")
			CALL K51_EGG_KAPPA_TEXT(1,@"「先搞这个吧！」","")
			CALL K51_EGG_KAPPA_TEXT(2,@"「对的对的，太棒了！」","l")
		ENDIF
		PRINTFORMDW 乙方一开始瞎折腾，不出所料工程进度又落后了…
		COMMISSION_PROGRESS:Commission -= 200
ENDSELECT

@COMMISSION_STATUS_K51_EGG
#DIM DYNAMIC Commission
Commission = COMMISSION_CURRENT(51)
IF !Commission
	PRINTFORML 「提供各种劳务服务，专业可靠！」
	SIF VAR_OR_DEFAULT("nSpoilerMode")
		PRINTFORML 「最好给我们找些又快又好玩的活计，拖太久会很麻烦的」
ELSE
	SELECTCASE COMMISSION_PROGRESS:Commission
		CASE IS < 0
			PRINTFORML 「啊…关于工程进度啊……」
		CASE 1
			PRINTFORML 「目前还在准备阶段呢」
		CASE IS < COMMISSION_EXPECTED_PROGRESS:Commission
			PRINTFORML 「虽然进度有一点儿落后，但绝对能按时交工！」
		CASE IS > COMMISSION_EXPECTED_PROGRESS:Commission
			PRINTFORML 「进度超前啦！马上就能完事！」
		CASEELSE
			PRINTFORML 「工程正在顺利进行，您放一百个心！」
	ENDSELECT
ENDIF

