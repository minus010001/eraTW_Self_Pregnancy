	CASE 6
			;工作状态描述（避免项目名空洞填充）
			;If the projects were just names slotted into generic lines, it might feel hollow, so she should have at least a tiny bit of unique dialogue for each one.
		SIF DAY == CFLAG:51:K51_EGG_DAY_MET
				;初遇当日锁定（因野餐事件已介绍过项目）
			GOTO TOP
		SELECTCASE CFLAG:51:K51_EGG_PROJECT
