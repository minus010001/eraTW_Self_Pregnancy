@K51_EGG_CONVERSATION_CHILDREN(Child=-1,ChildCallName,Counter)
#DIM DYNAMIC Counter
#DIM DYNAMIC Child
#DIMS DYNAMIC ChildCallName
CALL K51_EGG_CONVERSATION_MESSAGE(8,Child,ChildCallName)
$TOP
IF Child == -1
		;Parenthood in general.
	SELECTCASE RAND:6
		CASE 0
			;适应母亲的身份
			LOCAL = 1000
			SIF CFLAG:51:兒童人数 < 11
					;通过第一个孩子的年龄判断她当母亲的时间，除非有十一个以上孩子则检查最近的孩子
					;若有十一个孩子，她可能已习惯了
				LOCAL = DAY-CHILD_BIRTHDAY:51:1
			SELECTCASE LOCAL
				CASE IS < CHILD_喋る
						;还不会说话
					PRINTFORML 「%SPLIT_G(@"要是生孩子自带一个说明书就好了……：呃，对了，我没忘东西吧？：我现在整天都焦虑不安，没事的！我很好！没问题！：呜啊啊，好想休息一下……：肯定有发明能让带孩子这事变得轻松的……")%」
					PRINTFORMDL 荷取看起来有点%SPLIT_G(@"疲惫不堪：筋疲力尽：比平时更累：累垮了：神经紧绷")%
				CASE IS < CHILD_就学
						;学龄前
					PRINTFORML 「%SPLIT_G(@"虽然适应的过程很艰难，但我觉得我们已经掌握当父母的诀窍了吧？：你知道吗，我从没想过养孩子会这么有成就感：虽然还是很辛苦，但我莫名觉得……很幸福：我现在会一边组装发明一边陪孩子玩，效果相当不错！")%」
					PRINTFORMDL 她似乎已适应了母亲的身份
				CASEELSE
						;学龄及以上
					PRINTFORML 「%SPLIT_G(@"记住要花时间陪\@ CFLAG:51:兒童人数 > 1 ?孩子们！孩子需要#%CHILDNAME:51:1%！成长中的心灵需要\@ \@ IS_MALE(MASTER) ?父爱#双倍的母爱\@！：我们是天下最好的父母吧？：养孩子确实很容易！而且永不觉得无聊！：\@ CFLAG:51:兒童人数 > 1 ?给每个孩子留时间！不能偏心！#我现在完全能再带一个孩子了，一点都不难！\@")%」
					PRINTFORMDL %SPLIT_G(@"荷取说话的时候，时常流露出作为母亲的自豪：荷取自豪地谈论着你的\@ CFLAG:51:兒童人数 > 1 ?孩子们#孩子\@：你们两人一同分享着为人父母的喜悦：谈论时，荷取脸上带着满足的表情")%
			ENDSELECT
		CASE 1
				;工作与生活的平衡
			PRINTFORML 「%SPLIT_G(@"必须更严格地规划……我一定会给孩子们腾出时间！：现在我更难沉迷于研究了，因为会不小心忘掉自己的职责……」\n「不过这也算培养感情的方式吧？：也许该请个保姆能让我更专注……不，我不放心把\@ CFLAG:51:兒童人数 > 1 ?孩子们#%CHILDNAME:51:1%\@交给任何人")%」
		CASE 2
				;物资供应
			PRINTFORML 「%SPLIT_G(@"我得赶紧去囤点货……\@ CFLAG:51:兒童人数 > 1 ?他们吃得#%CHILDNAME:51:1%吃得\@太多了！：还好我们自己有种植场，而且黄瓜便宜，可以喂饱\@ CFLAG:51:兒童人数 > 1 ?孩子们#%CHILDNAME:51:1%\@：唔，有\@ CFLAG:51:兒童人数 > 1 ?这么多张嘴#多一张嘴\@要喂，盐也太贵了！：我们这周的物资够吗？……也许我该再去别的地方采购一点")%」
		CASE 3
				;过去的时光
			PRINTFORML 「%SPLIT_G(@"想想以前我都是睡到自然醒……现在就不能这么干了：我从来没想过现在的生活会是这样……我以前和其他河童相处的时候，可是天天向往着自由！：现在的每一天都比以前热闹多了，感觉时间好像都变慢了，你懂这种感觉吗？：有\@ CFLAG:51:兒童人数 > 1 ?孩子#%CHILDNAME:51:1%\@之前，我从没想过自己一天能做这么多事……呵呵")%」
			PRINTFORMDL 荷取露出了温柔的笑容
		CASE 4
				;利用孩子帮忙
			IF K51_EGG_CHILD_EXISTS(99,13)
				ChildCallName = K51_EGG_RANDOM_CHILD(99,13)
				PRINTFORML 「%SPLIT_G(@"\@ CFLAG:51:兒童人数 > 1 ?孩子们#%ChildCallName%\@已经开始在帮我组装零件了，我们的配合超默契的！：可以用\@ CFLAG:51:兒童人数 > 1 ?孩子们#%ChildCallName%\@当吉祥物免费宣传，这样我的生意肯定会越来越好！：有\@ CFLAG:51:兒童人数 > 1 ?孩子们#%ChildCallName%\@真的太幸运了，现在去市集的时候我再也不用自己搬所有的东西了！")%」
			ELSE
				GOTO TOP
			ENDIF
		CASE 5
				;再要一个孩子
			IF TALENT:51:妊娠
				$PREGNANT
				PRINTFORML 「%SPLIT_G(@"我等不及了……：你觉得这个会像谁？：生活马上要更忙了……：希望孩子们能好好相处……")%」
				PRINTFORMDL 荷取把手放在肚子上微笑
			ELSEIF TALENT:51:妊娠願望
				PRINTFORML 「%SPLIT_G(@"好想再要一个，%K51_EGG_MASTER()%得好好努力哦！：作为母亲填补了我人生的空缺，我真的很想再添新丁……:我已经完全准备好迎接下一个孩子了……")%」
				PRINTFORMDL 荷取红着脸，催促你再给她个孩子
			ELSE
				LOCAL = 1000
				SIF CFLAG:51:兒童人数 < 11
					LOCAL = DAY-CHILD_BIRTHDAY:51:1
				SELECTCASE LOCAL
						;若孩子少于11个则按最大孩子年龄判断
					CASE IS < CHILD_喋る
							;还不会说话
						PRINTFORML 「我一想到将来可能再要一个，我就有一种奇怪的感觉……」
						IF !RAND:4
							PRINTFORMDL 荷取大声叹了口气
						ELSE
							PRINTFORMDL 荷取停顿片刻
							PRINTFORML 「%SPLIT_G(@"不可能，绝对不可能！：果然还是无法想象……：……还是别想这个了")%」
						ENDIF
					CASE IS < CHILD_就学
							;学龄前
						PRINTFORML 「%SPLIT_G(@"我还能再照料一个孩子吗……或许可以吧，我还没做好准备就是了：现在我勉强应付得来，要是再多一个就难说了……：只要不再要添一个宝宝的话，我们肯定能应付的过来！")%」
					CASEELSE
							;学龄及以上
						PRINTFORML 「%SPLIT_G(@"再要一个……唔，我不介意：你觉得……我们能再带一个孩子吗？：我太爱我们的\@ CFLAG:51:兒童人数 > 1 ?孩子们#孩子\@了，总会忍不住想再多要一个……：如果真的再添一个孩子，你能抽出时间一起照顾吗？")%」
						PRINTFORMDL 荷取%SPLIT_G(@"一想到这件事就脸颊发烫:开始和你一同畅想未来:开始构思起各种假设")%
				ENDSELECT
			ENDIF
	ENDSELECT
ELSE
	;特定孩子
	SELECTCASE K51_EGG_CHILD_AGE(Child)
			;按孩子年龄分支，再根据其他特质细分
		CASE 0
				;哺乳期
			IF !RAND:2
				SELECTCASE K51_EGG_CHILD_PERSONALITY(Child)
					CASE 0
							;好奇心旺盛
						SELECTCASE RAND:2
							CASE 0
								PRINTFORML 「不觉得这孩子特别聪明吗？\@ CHILD_SEX:51:Child == 1 ?她#他\@看东西总是那么专注」
								PRINTFORMDL 既然是荷取的\@ CHILD_SEX:51:Child == 1 ?女儿#儿子\@，将来肯定是个天才
								PRINTFORML 「哈哈，没错！」
								PRINTFORMDL 荷取笑着抱紧了宝宝
							CASE 1
								CALL HPH_PRINT,@"「\@ CHILD_SEX:51:Child == 1 ?她#他\@总是向我伸手……太可～爱了！HPH」","L"
						ENDSELECT
					CASE 1
							;胆小
						SELECTCASE RAND:2
							CASE 0
								PRINTFORML 「\@ CHILD_SEX:51:Child == 1 ?她#他\@不怎么哭，长大后会是个文静的孩子吧？」
							CASE 1
								PRINTFORML 「给这孩子喂奶很费劲，但是身体很健康」
								PRINTFORMDL 荷取特别疼那个孩子，一直抱着不撒手
						ENDSELECT
					CASE 2
						IF CHILD_SEX:51:LOCAL == 2
								;勇敢
							SELECTCASE RAND:2
								CASE 0
									PRINTFORML 「这孩子吸奶时力气好大，都留下红印了……」
									PRINTFORMDL 荷取轻抚儿子的头注视着他
								CASE 1
									PRINTFORML 「长得很快吧？我觉得他可能是同龄的孩子里最大的」
							ENDSELECT
						ELSE
								;厚脸皮
							SELECTCASE RAND:2
								CASE 0
									PRINTFORML 「她喝奶的时候超用力的，搞得我乳头都疼了，必须轮流换边才行……」
									PRINTFORMDL 荷取开始微微地抱怨，却仍紧抱着女儿
								CASE 1
									PRINTFORML 「她老是尿裤子，比其他孩子次数都多！」
							ENDSELECT
						ENDIF
					CASE 3
							;情绪化
						SELECTCASE RAND:2
							CASE 0
								PRINTFORML 「孩子哭得好厉害，千万别生病啊……」
								PRINTFORMDL 荷取开始为你的\@ CHILD_SEX:51:Child == 1 ?女儿#儿子\@担心起来
							CASE 1
								PRINTFORML 「这孩子的表情特别丰富，对吧？」
								PRINTFORMDL 荷取举起婴儿，试图逗孩子做出各种表情
						ENDSELECT
					CASE 4
							;奔放
						SELECTCASE RAND:2
