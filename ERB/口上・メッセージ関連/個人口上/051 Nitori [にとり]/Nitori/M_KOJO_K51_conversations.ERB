							CALL K51_EGG_KAPPA_TEXT(2,@"「%SPLIT_G(@"我们需要更多领地，而且只有河童能操控水！用这个新发明，我们要征服幻想乡！:天狗老是瞧不起我们！等我把这个喷到山顶上，看谁还敢笑我们！:用这个，我们可以淹掉人类村庄！然后我们河童就能永远地统治那里！:我要建造究极水上乐园！然后直接放在人类村庄正中央！")%」","l")
							PRINTFORMDL 你和荷取%SPLIT_G(@"花了点时间劝说:耐心劝说:赶紧劝说")%她放弃了这个计划……
					ENDSELECT
				CASE 4
						;提建议
					PRINTFORML 「%SPLIT_G(@"她在%SPLIT_G(@"做:组装:研究")%什么呀？:喔，你看那个！:那是什么？:她在那边干嘛呢？:她该不会在做我想的那个东西吧？")%」
					PRINTFORMDL 荷取凑到另一只河童的项目旁边，开始疯狂提建议
					PRINTFORML 「%SPLIT_G(@"你知道怎样会超酷吗？给它加装秘密武器系统！:给它装个鱼鳍让它能到处游怎么样？:给它装腿让它能走路怎么样？:装轮子怎么样？再加个引擎！干脆直接做成车啦！:做成%SPLIT_G(@"狗狗:猫咪")%的样子会很可爱！:应该做成语音控制！:做成体感操作！:喔喔！让它说话！:它还可以……啊不对，你应该让它这样……等等……")%」
					PRINTFORMDL 她有点太过兴奋了……
			ENDSELECT
		CASE 703
				;玄武之泽
			$RAVINE
			SELECTCASE RAND:4
				CASE 0
					PRINTFORML 「就算是我们，也没有探索完这里所有的洞窟」
					PRINTFORML 「%SPLIT_G(@"数量实在是太多了，找不到新东西的时候我们很快就会腻……:不过有些爱凑热闹的魔法师一直来寻找矿物:说不定里面还住着什么人呢……")%」
				CASE 1
					PRINTFORML 「能在这样清澈的水里测试机器真的很雅致，就是希望阳光能更常照到水底……」
					PRINTFORML 「%SPLIT_G(@"所以大家都只会在中午出来活动:话说回来，这样基地反而更难被发现了……:也许可以用大型镜面阵列试试……")%」
				CASE 2
					PRINTFORML 「在这片水里飘来飘去很舒服，只是千万别睡着……」
					PRINTFORML 「%SPLIT_G(@"水流会把你一直冲到湖里，说不定还会被吃掉:你也知道的，就算是河童也可能溺水……")%」
				CASE 3
					PRINTFORML 「大家老是把垃圾随便丢在显眼的地方，基地被发现了怎么办？」
					PRINTFORML 「%SPLIT_G(@"所以我们才贴了指向门口的牌子，提醒他们把东西收起来！:要我说，遗弃在这里的东西谁捡到就是谁的，哼:那些半成品也从来没有人做完……")%」
			ENDSELECT
		CASE 701
				;通往魔法森林入口之路
			$ENTRANCE
			IF GET_TARGETNUM() > 4
				PRINTFORML 「为什么大家都聚在森林边缘啊？%SPLIT_G(@"他们在开派对吗？:他们不敢进来吗？")%」
			ELSE
				PRINTFORML 「从这里看森林感觉好阴森，对吧？可以说是抵御外人的天然屏障了……」
			ENDIF
	ENDSELECT
ELSE
	SELECTCASE CFLAG:MASTER:現在位置
		CASE 720
			GOTO RAVINE
		CASE 710
			GOTO ENTRANCE
		CASEELSE
			RETURN 0
	ENDSELECT
ENDIF
RETURN 1

	;项目完成后首次交谈，荷取会告知并预告新项目
	;项目按顺序推进直至穷尽，之后随机循环翻新
@K51_EGG_PROJECT_CHANGE(Counter)
#DIM DYNAMIC Counter
IF !RAND:3
	LOCALS = 我%SPLIT_G(@"终于:已经:现在::")%%SPLIT_G(@"完成:搞定了")%%SPLIT_G(@"这个发明！:我的项目！")%
	LOCALS:1 = 
ELSE
	LOCALS = %SPLIT_G(@"这个:我发明的")%
	LOCALS:1 = %SPLIT_G(@"%SPLIT_G(@"终于:已经:现在::")%%SPLIT_G(@"完工:完成:搞定")%:%SPLIT_G(@"完工:完成:搞定")%啦:已经%SPLIT_G(@"完工:完成:搞定")%")%
