;This file stores 荷取's regular dialogue.

@K51_EGG_CONVERSATION_MESSAGE(Topic,TopicModifier,CharacterName,Counter)
	;Replacement for the default train message. This is called for certain branches, or certain individual dialogues.
	;The topic is randomized based on location and situation.
#DIM DYNAMIC Topic
#DIM DYNAMIC TopicModifier
#DIM DYNAMIC Counter
#DIMS CharacterName
	;为增加多样性，荷取的名字随机置于消息开头或结尾
LOCALS =你与荷取
LOCALS:1 =
IF !RAND:2
	LOCALS =你
	LOCALS:1 '= @"跟荷取"
ENDIF
SIF TALENT:51:恋人 && !RAND:6
	LOCALS:2 = %SPLIT_G(@"%SPLIT_G(@"时不时相互调情:彼此暧昧")%:%SPLIT_G(@"有时眉目传情:牵手同行")%")%
SELECTCASE Topic
	CASE 0
			;机械话题，在河童藏身处高概率触发
		SIF TALENT:51:心情 == 1
			GOTO HAPPY
		PRINTFORMDL %LOCALS%%LOCALS:1%%SPLIT_G(@"闲聊起:讨论起:畅谈")%关于机械的%SPLIT_G(@"运作原理:制造方法:精妙结构:零部件:设计思路:构造细节:系统:实用功能:工程技术")%%LOCALS:2%…
	CASE 1
			;协作项目，特殊事件等级2解锁，概率较低
		SELECTCASE TopicModifier
			CASE 0
					;担任助手
				PRINTFORMDL %SPLIT_G(@"荷取开始征求你对%SPLIT_G(@"项目:概念:设计:原型")%的%SPLIT_G(@"意见:想法:见解")%:荷取展示还在%SPLIT_G(@"设计中:建造中:开发中")%的蓝图:你询问荷取的工程项目进展如何")%…
			CASE 2
					;共同工作（仅限藏身处）：句尾有一边...一边...的句子，请注意格式是否正确
				PRINTFORMDL %SPLIT_G(@"%LOCALS%与荷取合力制作小装置:%LOCALS%%LOCALS:1%巡视河童藏身处，协助其他河童:你一边帮荷取%SPLIT_G(@"建造:修理:升级")%%SPLIT_G(@"她的发明:某件装置:%SPLIT_G(@"大型:小型:巨型:怪异")%机器")%一边%SPLIT_G(@"闲聊:讨论技术")%:你与荷取加入河童小组%SPLIT_G(@"建造:组装:升级:修理")%巨型机器:你一边帮荷取%SPLIT_G(@"制造:测试:调整:升级:改良")%她的%K51_EGG_PROJECT_NAME()%%SPLIT_G(@"%SPLIT_G(@"一边聊天:一边闲谈")%:%SPLIT_G(@"边工作边聊:工作间交谈")%")%")%…
			CASE 3
					;拆解作业（仅限藏身处）
				PRINTFORMDL %SPLIT_G(@"%LOCALS%%SPLIT_G(@"从废料堆回收零件:%SPLIT_G(@"拆解:分解:拆卸")%%SPLIT_G(@"并重组:再组装::")%外界机器")%%LOCALS:1%:你与荷取加入河童小组，一起%SPLIT_G(@"拆解:分解:拆卸:回收")%巨型机器")%…
			CASEELSE
					;头脑风暴
				PRINTFORMDL %LOCALS%%LOCALS:1%%SPLIT_G(@"思考了一会%SPLIT_G(@"新发明:创新设计:潜在项目")%%SPLIT_G(@"想了一会儿::")%:技术上研讨了%SPLIT_G(@"一段时间:一会儿")%")%%LOCALS:2%…
		ENDSELECT
	CASE 2
			;委托提议，每日限一次，恋爱/爱人状态锁定
		PRINTFORMDL %LOCALS%%SPLIT_G(@"提出一个交易请求:建议进行一笔交易:请求来场交易:将话题转向做生意")%…
	CASE 3
			;商业话题，特殊事件等级2解锁 ：整个句子最好都改一遍，请注意格式是否正确
		PRINTFORMDL %LOCALS%%LOCALS:1%%SPLIT_G(@"讨论:洽谈:探讨")%了一会生意上的事情，还有%SPLIT_G(@"资金运作的事务:利润分配的事务:财务规划的事务")%%LOCALS:2%…
	CASE 4
			;人物八卦，他人存在时锁定
		PRINTFORMDL %LOCALS%%LOCALS:1%%SPLIT_G(@"谈论:聊起:八卦起")%%CharacterName%……
	CASE 5
			;玩家或自身话题，概率较低 ：整个句子最好都改一遍，机翻过来说话很机翻（
		SIF TALENT:51:心情 == 1
			GOTO HAPPY
		IF TOPICMODIFIER == 0 && !RAND:2
			PRINTFORMDL %SPLIT_G(@"荷取问起%SPLIT_G(@"你的事情:你的私人问题")%:荷取拿你跟%SPLIT_G(@"她自己:其他人")%做比较:你与荷取%SPLIT_G(@"聊天:闲谈")%时，开始聊起你的事情")%…
		ELSEIF TOPICMODIFIER == 1 && !RAND:2
			PRINTFORMDL %SPLIT_G(@"你问起%SPLIT_G(@"荷取的事情:荷取的私人问题")%:荷取拿自己跟%SPLIT_G(@"你:其他人")%做比较:你与荷取%SPLIT_G(@"聊天:闲谈")%，开始聊起她自己的事情")%…
		ELSE
			PRINTFORMDL %LOCALS%%LOCALS:1%%SPLIT_G(@"谈论:聊起:讨论")%两人的私人话题……
		ENDIF
	CASE 6
			;性话题，炮友状态解锁，色欲时高概率，性压抑了概率更高（他人存在不触发）
		PRINTFORMDL %LOCALS%%LOCALS:1%%SPLIT_G(@"相互说起情话:的话语渐渐开始变得暖昧:闲聊时开始暗示挑逗:开始充满性暗示的对话:讨论色色的事情")%……
	CASE 7
			;群体互动（仅他人存在时）
		PRINTFORMDL 你与荷取同%CharacterName%%SPLIT_G(@"交谈:闲聊:对话")%…
	CASE 8
			;育儿话题（荷取产后解锁）
		IF TopicModifier != -1
			PRINTFORMDL %LOCALS%%LOCALS:1%聊起了%CharacterName%……
		ELSE
			PRINTFORMDL %LOCALS%%LOCALS:1%%SPLIT_G(@"讨论起:谈论起:聊起")%%SPLIT_G(@"\@ CFLAG:51:兒童人数 > 1 ?孩子们的事情#孩子的事情\@:为人父母的事情")%…
		ENDIF
	CASE 9
			;杂项话题 
		SIF K51_EGG_IS_STORM() && OUTROOF(CFLAG:MASTER:現在位置)
				;暴风雨中户外不描述对话
			RETURN 1
		SIF TALENT:51:心情 == 1
			GOTO HAPPY
		PRINTFORMDL %LOCALS%%LOCALS:1%%SPLIT_G(@"开展了一场愉悦的对话:开心地聊天")%%LOCALS:2%……
	CASE 10
			;醉酒状态
		PRINTFORMDL %LOCALS%%SPLIT_G(@"试图和荷取交谈:尝试跟荷取对话:对着荷取说话")%，但是荷取%SPLIT_G(@"明显没在听你说话:没法理解你在说什么:突然走神了:有点注意力不集中:感觉有点语无伦次")%…
	CASE 11
			;愉悦状态 第三行建议改的口语一点
		$HAPPY
		IF Topic == 0
			PRINTFORMDL 荷取%SPLIT_G(@"热情洋溢地讲述:狂热地阐述:滔滔不绝着:语速飞快地讲解:笑着讲解")%%SPLIT_G(@"机械知识:她的发明:她的项目:她的爱好")%…
		ELSEIF !RAND:2
			PRINTFORMDL %LOCALS%%SPLIT_G(@"和荷取聊得热火朝天:和荷取谈笑风生:和荷取聊得有声有色")%…
		ELSE
			PRINTFORMDL 荷取在跟你聊天的时候%SPLIT_G(@"%SPLIT_G(@"露出\@ ABL:51:親密 < 3 ?羞涩#开怀\@的笑容:\@ ABL:51:親密 < 3 ?紧张地咯咯笑#开怀大笑\@:\@ ABL:51:親密 < 3 ? 显得不再那么害羞了，整个人变得更加开朗活泼#整个人心情变得更加活泼了起来\@")%")% 
		ENDIF
	CASE 12
			;愤怒状态
		PRINTFORMDL 荷取%SPLIT_G(@"迅速地背过身去，似乎不怎么想见到你的样子:冷冰冰地瞅了你一眼，随即立马移开了视线:把你当成了一个隐形人，根本不想理你:一个字都不想听，感觉马上就要捂住自己的耳朵:懒得管你的破事，打算干点别的去")%…
	CASE 13
			;忧郁状态
		PRINTFORMDL %SPLIT_G(@"你拍了拍荷取的肩，尝试和她聊点什么有趣的事情，但是荷取敷衍地应付了几句:即使是平常活泼开朗的河童，这时也颇为忧愁烦恼，看来不是一个适合谈话的时间……:你尝试和荷取聊点有趣的话题，但是即使你试了几次，也没有得到什么有意义的答复")%
	CASE 14
			;对话失败
		PRINTFORMDL 你尝试与荷取交谈，但是荷取%SPLIT_G(@"有点过于拘谨了，娇小的身体都在微微颤抖:冷淡地应付了你几句话，似乎没有把你放在心上:却磕磕巴巴地吐出了几个字:甚至都迈开了一条腿，有点想尝试逃跑的样子:的小脸涨得通红，因为害羞而退缩了")%…
ENDSELECT
PRINTFORMDW


;下方为随机对话台词通常每个主题至少12种变体，确保丰富变化
;目标是让玩家每次阅读都有新鲜感，因此台词需长期保持生动
;每类主题有独立核心，主要通过SPLIT_G()实现变体，优选完全不同的台词，也可以重组措辞
;有时会将台词拆分为多个随机片段组合，以创造海量排列组合

@K51_EGG_CONVERSATION_MACHINES(Counter)
#DIM DYNAMIC Counter
CALL K51_EGG_CONVERSATION_MESSAGE(0,,,Counter)
$TOP
SELECTCASE RAND:12
	CASE 0
			;关于废料回收
			;荷取《风神录》设定提到她拆解外界机器重组，可能是为改造或研究原理
			;推测她也会回收部分材料以减少山童依赖
