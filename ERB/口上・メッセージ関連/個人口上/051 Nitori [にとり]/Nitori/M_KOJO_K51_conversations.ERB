	CASE 8
			;灵梦
		SIF !IS_MET_ENABLED(1) || FLAG:扮演 == 1
			GOTO TOP
		CharacterName = 灵梦
	CASE 9
			;妖怪山居民
		SIF !IS_MET_ENABLED(78) || FLAG:扮演 == 78 || !IS_MET_ENABLED(97) || FLAG:扮演 == 97
			GOTO TOP
		CharacterName = %SPLIT_G(@"妖怪山的居民:荷取的邻居")%
	CASE 10
			;华扇
		SIF !IS_MET_ENABLED(43) || FLAG:扮演 == 43
			GOTO TOP
		CharacterName = 华扇
	CASE 11
			;妖精
		CharacterName = %SPLIT_G(@"妖精们:幻想乡的妖精")%
ENDSELECT
CALL K51_EGG_CONVERSATION_MESSAGE(4,TopicModifier,CharacterName)
SELECTCASE TopicModifier
		;每个分支对应不同角色或群体，若相关角色未解锁则跳过
	CASE 0
			;其他河童
		PRINTFORML 「%SPLIT_G(@"她的项目前景明明很不错，就是不想和别人合作……:本来我特别期待她的成品，结果她最后还是搁置了……:大家都厌倦了这个项目，真是三分钟热度！虽然我也半斤八两……:那两人明明前几天还在合作，转眼就吵翻天…:看样子她们总是形影不离呢…:她总跑来偷看我的改造设计，到底想偷学什么啊……:又抓到她偷偷翻我的废料堆！那些都是我的东西！:说真的，我很感激他们，没有她们的帮忙，我根本造不出这么多东西:她老是弄丢眼镜，所以随身备了好几副:说起来，我从没见过她下水……该不会河童也会溺水吧……:她们的背包里藏着各种稀奇古怪的玩意儿，不过可别随便乱翻别人的包哦！:她正在偷偷搞一些秘密研究，我超级好奇是什么……:想让大家好好合作？设立个奖品最管用了。只要她们肯好好干活，就给她们造火箭发射器！:记得也和她们打个招呼呀，她们都很害羞的")%」
	CASE 1
			;人类
		IF !CFLAG:1:出禁 && !RAND:16
			PRINTFORML 「%SPLIT_G(@"我好想在村里多做点生意，可灵梦总把我赶出去……:灵梦从来不让我接触村民，即使想搭话也没有机会")%」
		ELSEIF !CFLAG:80:出禁 && !RAND:16
			PRINTFORML 「%SPLIT_G(@"藏身处的同伴都超爱看阿加莎・克里斯 Q 的小说:听过阿加莎·克里斯Q吗？她的小说在藏身处很火")%」
			PRINTFORML 「%SPLIT_G(@"不过书本总被弄湿……:我好担心她们会模仿书里的案件乱来……")%」
		ELSE
			PRINTFORML 「%SPLIT_G(@"没有我们的技术，人类过得也挺不容易的……不过说不定这样反而更安稳？:有时候想主动和人类搭话，可我一对视，他们就会下意识地躲开。仔细想想，他们也常常第一个先溜走……:我喜欢顺着河道潜到村子附近，悄悄观察人类。只要躲在水里，他们根本发现不了:人类真的很有意思，他们的习性比我们的复杂多了……:以前村里有盐商愿意和我们交易，想和人类好好交朋友真的好难……:不知道人类知不知道我们一直在默默守护他们……真希望能多和他们交流:人类比看上去要聪明得多，只要我们悄悄潜入村子，总会被察觉出来:村里有位老渔夫，每次我偷看他都能察觉得到，而且他的钓鱼技术也是一流的……:不用太担心人类，我们会好好守护他们的！:天狗和狸猫总想着利用人类，但我们河童是才是人类的盟友！:看到人类搭乘我们修建的索道，我就特别开心")%」
		ENDIF
	CASE 2
			;高岭
		PRINTFORML 「%SPLIT_G(@"高岭的心机太重，我们根本没法好好合作:一定是她怂恿山童留在森林里的，好怀念以前的同伴……:高岭打心底不信任我们的能力。背弃河流的河童，终有一天也会背弃同伴，记住这点！:整天张口闭口「工期截止日」，她到底在想什么？搞得像我的老板一样！千万别轻易和她合作:自从和她合作做生意，麻烦事就没断过，虽然收益确实变多了……:真希望她能讲道理一点，相处起来太累了:我试过跟高岭搞好关系，但是山童根本没法沟通")%」
	CASE 3
			;椛
		PRINTFORML 「%SPLIT_G(@"椛的大将棋下得挺厉害的，我想破招想了几个星期！:都说椛很高傲，其实吧，她挺好相处的:也许这步应该走麒麟……不，椛会破解的…:偶尔会想象她在山上默默注视着我们，不过这么说起来，好像有点怪怪的:以天狗来说，她算很好相处了，我偶尔会给她看我的发明:不知道椛一个人在上面会不会无聊，要不我们去陪陪她？她工作起来特别认真，我可坚持不了:她偶尔会不会偷偷摸鱼偷懒呢？:说来也怪，我们有时候还跟椛换零食吃，她好像很喜欢咸口的东西:河童藏身处的大家很喜欢椛，我们经常在一起玩耍下棋")%」
	CASE 4
			;魔理沙
		PRINTFORML 「%SPLIT_G(@"魔理沙老是跑来偷看我的发明，结果我的零件老是莫名失踪……:魔理沙从来不听别人的劝告，人类大概都是这样的吧？:魔理沙送给我过一根野生的黄瓜……味道有点怪:魔理沙每次来找我，身上的气味都不一样，应该是各种药剂和材料的味道:魔理沙的天赋很强，其他人类应该都很佩服她:真希望魔理沙她别每次来峡谷都到处捣乱:魔理沙经常雇我们把她发现的稀有金属挖出来，这生意可真不错！:我想像魔理沙那样四处探险，可我又不想离开河流太久:作为人类来说，魔理沙还挺好说话的，至少我和她相处得很轻松")%」
	CASE 5
			;文
		PRINTFORML 「%SPLIT_G(@"我一看见到文就浑身不自在，别再乱写关于我的新闻了好不好？:文总是那么趾高气昂的，对吧？真希望她离我远点:文真的别到处瞎掺和了……哼，天狗除了成天晃着大鼻子到处多管闲事，就没别的本事了吧？:文没征求我意见就乱拍我的项目，然后还写了一堆有的没的报道！:文老在人间之里鬼鬼祟祟的，总该有人管管了吧……:文这家伙办的报纸，倒是很适合拿来擦擦污渍，呵")%」
	CASE 6
			;守矢神社
			;细分讨论避免频繁提及个体
		SELECTCASE CharacterName
			CASE "早苗"
				PRINTFORML 「%SPLIT_G(@"早苗是现人神，当然最受我们河童欢迎了！:和早苗合作起来很省心，我并不排斥和她打交道:我希望早苗能多讲讲外界的事，不过她似乎觉得幻想乡更好？:比起另一位巫女，早苗她算是懂事可靠多了")%」
			CASE "神奈子"
				PRINTFORML 「%SPLIT_G(@"神奈子有着绝佳的商业头脑，而且对技术发展很有远见……幸好她是我们的盟友:最近神奈子总念叨技术伦理之类的规矩，她管得有点太严了……:神奈子作为山顶的技术之神，她人还算不错:神奈子总雇我们搞大工程，下次她还会有什么计划呢？:神奈子来到这里后，我们的生意就好转起来了，幻想乡也在慢慢接受新的技术和科技呢")%」
			CASE "诹访子"
				PRINTFORML 「%SPLIT_G(@"诹访子好像很喜欢我们…难道她觉得我们是青蛙？:在间歇泉地下中枢跟诹访子一起干活还挺有意思的，就是她的性子有点随性，你懂吧？:诹访子知道怎么搞到稀有金属，所以跟她搞好关系准没错:诹访子的那顶帽子里肯定藏着什么东西…\n「…我的帽子里面？才没有呢…")%」
			CASE "阿吽"
				PRINTFORML 「%SPLIT_G(@"她是个金融顾问之类的吧？要不咱们雇她得了，别找\@ IS_ENABLED(136) ?高岭#山童\@那边了…:那姑娘每次神社办祭典准会来，看着不像生意上的对头，可她推销起东西来的本事是真不含糊……:要是我们在藏身处也盖个神社，你说她会不会也经常跑来串门啊？:她有那么蓬蓬松松的头发，进了水不就全塌了吗？")%」
			CASEELSE
				PRINTFORML 「%SPLIT_G(@"有些人觉得她们心眼很多，其实人一点都不坏……\n「……真的，真不是光因为她们让咱们赚了不少钱才这么说的……:守矢神社的祭典可是跟人类搭上线的好机会，不过我跟他们说话的时候还是会紧张……:她们做生意是有点头脑，可没咱们精明！！\n「所以跟她们合作特别愉快，嘿嘿:那三位神明在上面过得可真滋润啊……\n「……倒也不是嫉妒，真的")%」
		ENDSELECT
	CASE 7
			;空
		PRINTFORML 「%SPLIT_G(@"我寻思她也算是间歇泉中心的重要人物吧，但非要选这么一个迷糊的家伙吗？她成天到处弄坏我们的设备！:大概有了她那种能力，头脑简单点也无所谓……」\n「脸蛋还长得挺可爱……身材也那样……咕哝咕哝……:她老是搞破坏……多出来的维修收入我倒是不介意，可她早晚有一天非把反应堆炸了不可:每次我下去找她，她都记不住我是谁，好像她根本分不清河童之间的区别:每次见到她，我都提心吊胆，拿不准她会不会想跟我打一架……:真想给她的第三条腿装一个限制器，或是什么遥控装置之类的玩意，这样就能少一大堆麻烦了……")%」
	CASE 8
			;灵梦
		PRINTFORML 「%SPLIT_G(@"她老觉得我们会伤害人类……我们怎么可能做那种事嘛！:上次祭典过后，她还抱怨道：整场市集只有我们和妖精摆摊！」\n「%SPLIT_G(@"反正又不会有几个人类会来嘛！:\"她还说，要是祭典里全是妖怪，会把人吓跑的！\" ……她是不是没反应过来，现在担心这个早就晚了……")%:我一直劝她干脆放弃，把神社改成专门接待妖怪的算了，可她就是不听……:最近神社那边越来越不挣钱了，可我也不想跟她断了来往……做生意有时候也挺难办的啊")%」
	CASE 9
			;妖怪山居民
		PRINTFORML 「%SPLIT_G(@"附近有个丰收之神倒是挺方便的，咱们的黄瓜种植设施也能得到她的祝福:前两天那个天邪鬼跑过来，说咱们应该跟山童和天狗干一架……说实话我有点心动:在山里很难推销机械与劳动力，不过偶尔也会有神明来跟咱们买:你在山里转悠的时候小心点，山童那帮家伙喜欢在林子里搞什么狩猎演习或者打仗游戏")%」
	CASE 10
			;华扇
		PRINTFORML 「%SPLIT_G(@"她有时候会过来视察我们，可我一直搞不懂她到底想干啥:她总是对咱们的机器很感兴趣，可她却对此一窍不通，每次我们都要花大把时间解释……:她老是跟我打听湖里栖息的那些生物，不知道在谋划什么……:我之前看见她的那条龙了，还挺唬人的吧……")%」
	CASE 11
			;妖精
		PRINTFORML 「%SPLIT_G(@"唉，烦死了，这群家伙超级烦人，我们的藏身处根本藏不住！:她们老翻我的破烂堆，把亮晶晶的零件都顺走了，那些都是我要用的！:她们老是来恶作剧，把我机器上的螺丝拧松……」\n「哼，等我抓到她们，非用我的飞弹发射器好好回敬她们一下不可！:看她们整天无忧无虑的，我都有点羡慕了……」\n「干嘛，我？我可有的是事儿要操心！:实在没办法的时候可以让她们搭把手，不过千万别给她们重要的活儿干:她们倒是好骗，也肯定愿意掏钱……可她们用不到钱啊……")%」
ENDSELECT

@K51_EGG_CONVERSATION_PERSONAL(Counter)
#DIM DYNAMIC Counter
