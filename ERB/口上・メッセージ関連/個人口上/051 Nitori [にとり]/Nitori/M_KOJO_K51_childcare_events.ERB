		PRINTFORMDW \@ CHILD_SEX:51:(TALENT:51:育児中) == 1 ?她#他\@的性子温顺随和，格外乖巧听话
	CASE 2
		IF CHILD_SEX:51:LOCAL == 2
				;勇敢型
			CALL K51_EGG_CHILD_TEXT(@"「一起来玩嘛！」",TALENT:51:育児中,"w")
			PRINTFORMDW 孩子从不掩饰自己的想法，坦率又直白
			CALL K51_EGG_CHILD_TEXT(@"「肚饿饿！肚饿饿！」",TALENT:51:育児中,"w")
			PRINTFORMDW 嗓门相当洪亮，充满了活力……
		ELSE
				;黏人型
			CALL K51_EGG_CHILD_TEXT(@"「玩呀～」",TALENT:51:育児中,"w")
			PRINTFORMDW 她的吐字还略显含糊，却十分主动，总愿意主动和人搭话
			CALL K51_EGG_CHILD_TEXT(@"「%K51_EGG_CHILD_MASTER_NICKNAME(LOCAL)%，陪我玩玩嘛？」",TALENT:51:育児中,"w")
			PRINTFORMDW 看着她明媚可爱的笑容，实在不忍心纠正她稚嫩的咬字与语病
		ENDIF
	CASE 3
			;情绪型
		PRINTFORMW 「小宝贝，该乖乖吃晚饭啦～」
		CALL K51_EGG_CHILD_TEXT(@"「不要，讨厌吃饭饭！」",TALENT:51:育児中,"w")
		PRINTFORMW 「唉……」
		PRINTFORMDW 孩子有的时候格外有自己的想法
	CASE 4
			;随性型
		PRINTFORMW 「要到妈妈这里来吗，小可爱？」
		CALL K51_EGG_CHILD_TEXT(@"「不要！」",TALENT:51:育児中,"w")
		PRINTFORMW 「不要？！为什么呀？！」
		PRINTFORMDW 孩子的性格格外独立，凡事都有自己的主见
