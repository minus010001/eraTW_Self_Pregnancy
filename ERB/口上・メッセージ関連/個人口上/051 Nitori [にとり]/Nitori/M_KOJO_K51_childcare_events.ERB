;-------------------------------------------------
;育児イベントの地の文。口上色はここで付けてください。
;CFLAG等のキャラ変数を使う場合、キャラ番号の指定が必要になります。
;デフォルトのものと置き換えたい場合は上下のSKIPSTART~SKIPENDを外してください。
;置き換える気がないならスルー。
;-------------------------------------------------
@M_KOJO_EGG_EVENT_K51_CHILD_RAISING_就学
;-------------------------------------------------
;入学
CALL SET_KOJO_COLOR(51)
PRINTFORMDL
PRINTFORMDW 转眼间，到了孩子入学的日子。是时候让%CHILDNAME:51:(TALENT:51:育児中)%入校深造了，为此，荷取早已默默做好了一切准备……
SELECTCASE K51_EGG_CHILD_PERSONALITY(TALENT:51:育児中)
	CASE 0
			;好奇型
		PRINTFORMW 「你要和人类孩子们一起学习，一定要记得多交朋友哦！好好认识每一个同学，所有人都要好好相处！」
		CALL K51_EGG_CHILD_TEXT(@"「好的，%K51_EGG_CHILD_NITORI_NICKNAME(TALENT:51:育児中)%」",TALENT:51:育児中,"w")
		PRINTFORMW 「但是千万不能太过显眼，别让他们知道你的与众不同！」
		CALL K51_EGG_CHILD_TEXT(@"「我知道了，%K51_EGG_CHILD_NITORI_NICKNAME(TALENT:51:育児中)%…」",TALENT:51:育児中,"w")
		PRINTFORMW 「不过，也要做班里最聪明的那一个！考试绝对不许考差，不然可有你好看的！」
		CALL K51_EGG_CHILD_TEXT(@"「……好的，%K51_EGG_CHILD_NITORI_NICKNAME(TALENT:51:育児中)%…?」",TALENT:51:育児中,"w")
		PRINTFORMDW 看着荷取不断给孩子施加沉重的压力，你连忙上前安抚，劝她不要太过严苛
	CASE 1
		;腼腆型
		PRINTFORMW 「记得要好好交朋友，好吗？」
		CALL K51_EGG_CHILD_TEXT(@"「……好」",TALENT:51:育児中,"w")
		PRINTFORMDW 孩子虽然应声答应，但你和荷取都能听出，那稚嫩的嗓音里藏着的忐忑与不安
		PRINTFORMW 「别担心呀，小宝贝！大家一定会喜欢你的！咱们的小河童这么聪明，肯定能好好融入大家！」
		PRINTFORMDW 你也跟着附和安慰着\@ CHILD_SEX:51:(TALENT:51:育児中) == 1 ?她#他\@，事实本就如此，这孩子自小与荷取一同长大，聪慧过人
		PRINTFORMDW 只要\@ CHILD_SEX:51:(TALENT:51:育児中) == 1 ?她#他\@尽力做好自己，一定能和其他小朋友和睦相处
		CALL K51_EGG_CHILD_TEXT(@"「我，我会努力的……」",TALENT:51:育児中,"w")
		PRINTFORMDW 荷取紧紧地将\@ CHILD_SEX:51:(TALENT:51:育児中) == 1 ?她#他\@拥入怀中，你也在一旁温柔鼓励，一同为即将入学的小家伙加油打气
	CASE 2
		IF CHILD_SEX:51:LOCAL == 2
				;勇敢型
			PRINTFORMW 「都准备好了吗？」
			CALL K51_EGG_CHILD_TEXT(@"「嗯！我完全没问题，早就准备好了！」",TALENT:51:育児中,"w")
			PRINTFORMDW 小家伙自信满满，毫无怯意。而荷取满心骄傲，抱着他亲了又亲的时候，你却注意到孩子根本没有收拾书包
			CALL K51_EGG_CHILD_TEXT(@"「笔记根本用不着！我全都能记住，本来就什么都会！」",TALENT:51:育児中,"w")
			PRINTFORMW 「哎哟，哈哈！看来你轻轻松松就能拿满分是吧？」
			PRINTFORMDW 嘴上这么说着，你心里却忍不住暗自犯嘀咕，实在不太放心这个小家伙了
		ELSE
				;无邪型
			CALL K51_EGG_CHILD_TEXT(@"「我穿好人类的衣服啦！我准备好啦！」",TALENT:51:育児中,"w")
			PRINTFORMDW 她得意洋洋地说这句话的时候，身上只松松垮垮套着一件敞开的浴衣，里面空空如也
			PRINTFORMDW 这件衣服还是借来的，尺寸偏大，穿在身上格外不合身
			PRINTFORMW 「不能就这么去上学啊！我不是教过你要好好系好腰带吗？」
			CALL K51_EGG_CHILD_TEXT(@"「好麻——烦呀……」",TALENT:51:育児中,"w")
			PRINTFORMW 「快乖乖穿整齐！这样会被别人看到的！开学第一天，可不能闹出糗事呀？」
			CALL K51_EGG_CHILD_TEXT(@"「哪里难为情了？」",TALENT:51:育児中,"w")
			PRINTFORMDW 你费了好大一番功夫，耐心教导她得体着装与分寸礼仪。最终好不容易才总算收拾妥当，顺利准备好出门
		ENDIF
	CASE 3
			;情绪型
		CALL K51_EGG_CHILD_TEXT(@"「为什么我非要去上学不可？」",TALENT:51:育児中,"w")
		PRINTFORMDW %CHILDNAME:51:(TALENT:51:育児中)%满脸不耐，皱起了眉头
		PRINTFORMW 「怎么啦，小宝贝？是紧张了吗？」
		CALL K51_EGG_CHILD_TEXT(@"「才没有！上学根本毫无意义，我本来就什么都懂！」",TALENT:51:育児中,"w")    
		PRINTFORMDW 看来\@ CHILD_SEX:51:(TALENT:51:育児中) == 1 ?她#他\@完全小瞧了人类小孩……
		PRINTFORMW 「这话倒也没错……」
		PRINTFORMDW 看来，孩子确实有这么聪明？
		PRINTFORMW 「可，可是……你这么聪明，一定能交到很多人类小伙伴呀！」
		CALL K51_EGG_CHILD_TEXT(@"「我才不在乎！我就是不想去！」",TALENT:51:育児中,"w")
		PRINTFORMDW 你和荷取好一番劝说，才勉强说服孩子去学校上学
	CASE 4
			;独立型
		PRINTFORMW 「都准备好了？学校一定会很好玩的！」
		CALL K51_EGG_CHILD_TEXT(@"「可我不想去」",TALENT:51:育児中,"w")
		PRINTFORMDW %CHILDNAME:51:(TALENT:51:育児中)%一脸漫不经心地回复荷取，让她瞬间蹙起眉头
		PRINTFORMW 「必须要去！你这是怎么了？」
		CALL K51_EGG_CHILD_TEXT(@"「没怎么，我就是单纯不想去」",TALENT:51:育児中,"w")
		PRINTFORMDW 无奈之下，只能由你耐心劝导，慢慢说服孩子去上学
ENDSELECT
