	CASE "依頼確認時" ;Request confirmed.
		RETURN 1
	CASE "依頼破棄時" ;Request canceled.
		PRINTFORML 「什、什么？你到头来还是帮不了我吗？」
		PRINTFORML 「啊啊啊，这下我该怎么办才好……」
		WAIT
		RETURN 1
	CASE "依頼実行直前" ;Before executing request.
		PRINTFORML 「你真的帮我带来了！让我数一数……」
		WAIT
		RETURN 1
	CASE "依頼実行直後" ;After executing request.
		PRINTL
		PRINTFORML 「这些完全足够了！真的可以给我吗？你简直救了我一命！」
		PRINTFORML 「有了这些资源，我的%K51_EGG_PROJECT_NAME()%一定能进化到所有人都想象不到的地步！」
		WAIT
		PRINTL
		RETURN 1
	CASE "成功報告時" ;Report success.
		RETURN 0
	CASE "失敗報告時" ;Report failure.
		PRINTFORML 「唔……没钱也没法随心所欲地发明创作也太难受了……」
		WAIT
		RETURN 1
	CASE "依頼報告不要" ;No report required.
		RETURN 0
ENDSELECT

