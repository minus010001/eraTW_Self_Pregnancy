IF TALENT:51:恋慕
	DateScore += MIN(ABL:51:親密 * 10, 100) + MIN(ABL:51:欲望 * 10,100) + MIN(ABL:51:奉仕精神 * 10,100)
	DateScore += MIN(EXP:51:約會経験,100) + MIN(EXP:51:愛情経験,100)
ELSEIF TALENT:51:思慕
	DateScore += MIN(ABL:51:親密 * 10, 50) + MIN(ABL:51:欲望 * 10,50) + MIN(ABL:51:奉仕精神 * 10,50)
	DateScore += MIN(EXP:51:約會経験,50)
ENDIF
DateScore += GETPALAMLV(PALAM:51:欲情,10) * 5 + GETPALAMLV(PALAM:51:好意,10) * 5 + GETPALAMLV(PALAM:51:恭順,10) * 5
