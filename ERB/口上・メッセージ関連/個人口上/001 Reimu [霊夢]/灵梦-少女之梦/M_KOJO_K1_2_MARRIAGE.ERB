;==================================================
;求婚口上
;--------------------------------------------------
;COM13（求婚）的口上
;TFLAG:193 == 0 时为求婚失败，否则为求婚成功
;==================================================
@M_KOJO_少女之梦_MESSAGE_CUSTOM_COM_K1_13
PRINTFORMDW 约会途中，你突然停下脚步，拿出订婚戒指向%CALLNAME:TARGET%求婚。

IF TFLAG:193 == 0
	;-------------------------------------------------
	;求婚失败
	;-------------------------------------------------
	PRINTFORMDL 灵梦沉默了片刻、低下了头
	LOCALS = 「……对不起、%MASTERNAME:1%……/并不是不喜欢你……只是、现在还不行……」
	PRINTFORMDL 灵梦的声音很轻、像是怕被风吹散一样
	CALL SPTALK, TARGET, "通常", 0, LOCALS, 1
	LOCALS = 「等我能回应你的心意的时候……一定会告诉你的」
	PRINTFORMDW 少女抬起了头、眼中虽然有些歉意、但更多的是坚定
	CALL SPTALK, TARGET, "通常", 0, LOCALS, 1
ELSE
	;-------------------------------------------------
	;求婚成功
	;改编自：M_KOJO_K1_2_イベント.ERB 雪花下求婚暗示（行1835-1844）
	;-------------------------------------------------
	PRINTFORMDL 灵梦怔怔地看着你手中的戒指、似乎一时间忘记了呼吸
	PRINTFORMDL 少女的眼眶渐渐泛红、嘴唇微微颤抖着
	LOCALS = 「……呐、%MASTERNAME:1%……这不是梦吧？/你真的……向我求婚了吗？」
	PRINTFORMDL 灵梦的声音颤抖着、像是怕这一切只是幻影
	CALL SPTALK, TARGET, "通常", 0, LOCALS, 1
	PRINTFORMDL 灵梦轻轻拽着你的手掌、悄悄挠着手心
	LOCALS = 「我曾经梦到过这样的场景……在梦里、你也是这样向我伸出了手/但是梦终究会醒来……而现在……」
	CALL SPTALK, TARGET, "笑顔", 0, LOCALS, 1
	PRINTFORMDL 灵梦将你的手贴在自己的脸颊上、感受着掌心的温度
	LOCALS = 「……好温暖……不是梦呢……」
	CALL SPTALK, TARGET, "笑顔", 0, LOCALS, 1
	LOCALS = 「%MASTERNAME:1%……我愿意……/此身余生、此生所爱、此心所想、尽皆是你/所以……我愿意嫁给你……」
	PRINTFORMDL 少女微闭双眼、用蚊哼一般的轻声应道
	CALL SPTALK, TARGET, "発情", 0, LOCALS, 1
	PRINTFORMDW 但那声音中蕴含的坚定、却比任何誓言都要响亮
ENDIF
RETURN 1

;==================================================
;婚礼准备口上
;--------------------------------------------------
;ARGS参数：
;  "TYPE"   — 选择婚礼场地类型时
;  "SIZE"   — 决定婚礼规模（宾客人数）时
;  "DATE"   — 决定婚礼日期时
;  "GUESTS" — 确认宾客名单时
;==================================================
@M_KOJO_少女之梦_EVENT_K1_WEDDING_PREPARATIONS(ARGS, ARG, ARG:1)
#LOCALSIZE 1
#LOCALSSIZE 1
SELECTCASE ARGS
	CASE "TYPE"
		;改编自：M_KOJO_K1_2_イベント.ERB 樱花许愿（行832-846）
		IF WEDDING_TYPE != ""
			;已选好类型
			LOCALS = 「%MASTERNAME:1%……已经决定好了吗？/唔……虽然有点紧张……不过、只要是和%MASTERNAME:1%一起的话……」
			PRINTFORMDL 灵梦的脸上浮现出既期待又害羞的表情
			CALL SPTALK, TARGET, "笑顔", 0, LOCALS, 1
			LOCALS = 「我、我可是很期待的哦？」
			CALL SPTALK, TARGET, "発情", 0, LOCALS, 1
		ELSE
			;尚未选择类型
			PRINTFORMDL 灵梦轻轻拉住了你的衣角、低着头小声说着
			LOCALS = 「呐……%MASTERNAME:1%……/我之前……梦到过自己穿上白无垢的样子……/梦到在神社的樱花树下、大家都在祝福我们/虽然只是梦……但那个时候的我、真的好幸福……」
			PRINTFORMDL 灵梦抬起头、眼中闪烁着微光
			CALL SPTALK, TARGET, "笑顔", 0, LOCALS, 1
			LOCALS = 「不过呢……不管是怎样的婚礼……/只要能和%MASTERNAME:1%在一起、就是最好的/所以……%MASTERNAME:1%想选什么样的都可以哦」
			CALL SPTALK, TARGET, "笑顔", 0, LOCALS, 1
		ENDIF
	CASE "SIZE"
		LOCALS = 「规模的话……/热闹一点也好、安静一点也好……」
		PRINTFORMDL 灵梦歪着头想了想
		CALL SPTALK, TARGET, "通常", 0, LOCALS, 1
		LOCALS = 「不过、如果人太多的话、我可能会紧张到说不出话来呢……/不管怎样、%MASTERNAME:1%来决定就好」
		CALL SPTALK, TARGET, "笑顔", 0, LOCALS, 1
	CASE "DATE"
		PRINTFORMDL 灵梦的脸上浮现出一抹红晕
		LOCALS = 「日期……/越快越好什么的……我才没有这样想呢……」
		PRINTFORMDL 少女别过头去、但嘴角却不自觉地上扬
		CALL SPTALK, TARGET, "笑顔", 0, LOCALS, 1
		LOCALS = 「……不过、也不要太久啦」
		CALL SPTALK, TARGET, "発情", 0, LOCALS, 1
	CASE "GUESTS"
		LOCALS = 「来宾的话……/魔理沙肯定要来的吧、那家伙一定会大吵大闹的……/还有先代大人和早苗……虽然有些不好意思……」
		PRINTFORMDL 灵梦掰着手指数着、表情渐渐柔和下来
		CALL SPTALK, TARGET, "笑顔", 0, LOCALS, 1
		LOCALS = 「啊、不过最重要的是%MASTERNAME:1%在身边就好」
		CALL SPTALK, TARGET, "発情", 0, LOCALS, 1
ENDSELECT
RETURN 1

;==================================================
;自定义婚礼仪式
;--------------------------------------------------
;完全自定义的婚礼叙事——"只有两个人的婚礼"
;改编自：灵梦结婚口上试写.txt（52行完整叙事）
;==================================================
@M_KOJO_少女之梦_EVENT_K1_CUSTOM_WEDDING(ARGS, ARG, ARG:1)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC GUEST_COUNT

;换装——白无垢
CALL OKIGAE(MASTER, 5)
CALL OKIGAE(TARGET, [[白无垢]])

;计算宾客人数（自定义婚礼=只有两个人）
GUEST_COUNT = 0

PRINTFORMDL 那一日、天空如同往常那般洁白无暇、天边洒下了些许微风
PRINTFORMDL 那一日、阳光温暖的照耀大地、花香遍满整个幻想乡、偶尔喧闹的神社也静谧了下来
PRINTFORMDL 不、或许是能称之为祥和吧、毕竟是一生之中最重要的事情、没有不识趣的人来打扰也是正常的
PRINTFORMDL 鸟居的注连绳上站立着几只小雀、树叶细细摩擦的声音轻灵、灌木之中隐约能够听到妖精在小声的娇笑
PRINTFORMDL 这些家伙也会有不恶作剧的时候呢、%CALLNAME:MASTER%在心中感慨、望着不断散落的樱花渐渐铺在参道与神社的各处
PRINTFORMDL 这个时刻确实已经等待了太久、在漫长的时间中两人已经向对方证明了自己的爱意
PRINTFORMDL 如此期待、也同样的如此害怕、不过、心中满是爱、所以不怕
PRINTFORMW

PRINTFORMDL 少女跪坐在榻榻米上、双手因为期待而忍不住的互相握在一起又分开
PRINTFORMDL 纯洁娇嫩的白无垢披在身上、俏脸上点缀着些许胭脂、脸颊泛红、这会是少女最美丽的时刻
PRINTFORMDL 今天也会是少女最难忘的时刻、每每想到这里、灵梦的唇角就忍不住上扬
PRINTFORMDL 但少女只是静坐着、等待着、等待了这样长的时间、只是临近的几分钟、她可以等下去
PRINTFORMDL 可她等的人同她一样的急切、%CALLNAME:MASTER%并没有让灵梦等待太久、就缓缓进到了屋中
PRINTFORMW

PRINTFORMDL 听到了那小心翼翼的脚步、灵梦又忍不住的嗔笑回头
LOCALS = 「为什么像是做贼一样悄悄的啊」
CALL SPTALK, TARGET, "笑顔", 0, LOCALS, 1
PRINTFORMDL 因为我要偷走整个神社中最珍贵的宝物
PRINTFORMDL %CALLNAME:MASTER%也笑着坐到了灵梦的身边、满眼爱恋的看着眼前美丽的女孩
LOCALS = 「可是神社中什么都没有哦」
CALL SPTALK, TARGET, "笑顔", 0, LOCALS, 1
PRINTFORMDL 灵梦笑着挽住了%CALLNAME:MASTER%的胳膊、%CALLNAME:MASTER%闻到了花一般清香的味道
PRINTFORMDL 神社里有灵梦啊、灵梦不就是最珍贵的宝物吗？
PRINTFORMDL 微风吹过、拨动灵梦的长发、伴着风与花发出的沙沙声
LOCALS = 「真是的、这种时候还要说俏皮话吗？/这种时候、你该吻我才对呀」
PRINTFORMDL 灵梦有一种解脱般的轻松、直视着%CALLNAME:MASTER%
CALL SPTALK, TARGET, "発情", 0, LOCALS, 1
PRINTFORMW

PRINTFORMDL %CALLNAME:MASTER%挠了挠头、有些不好意思
PRINTFORMDL 毕竟是第一次结婚嘛、不太熟练
LOCALS = 「是呢……不过……」
CALL SPTALK, TARGET, "笑顔", 0, LOCALS, 1
PRINTFORMDL 灵梦轻轻捧着%CALLNAME:MASTER%的脸、一阵香风吹过、额头处在那瞬间感受到了些许的柔软
PRINTFORMDL 带着恶作剧得逞的笑容、灵梦站起身、叉腰看着%CALLNAME:MASTER%
LOCALS = 「既然%CALLNAME:MASTER%忘记了、就让我来做吧」
CALL SPTALK, TARGET, "笑顔", 0, LOCALS, 1
PRINTFORMDL %CALLNAME:MASTER%抱住灵梦、灵梦没有抗拒、就那样靠住%CALLNAME:MASTER%
PRINTFORMW

PRINTFORMDL 在灵梦的要求下、只有两个人的婚礼、简单的婚礼
PRINTFORMDL 不需要海誓山盟、因为两人的感情只需要余生的陪伴、只需要时间来证明
PRINTFORMDL 嫁给我吧……灵梦……
PRINTFORMDL 抱着怀中心爱的女孩、%CALLNAME:MASTER%柔声说着
LOCALS = 「嗯……」
PRINTFORMDL 灵梦微闭双眼、用蚊哼一般的轻声回答应道
CALL SPTALK, TARGET, "笑顔", 0, LOCALS, 1
PRINTFORMW

PRINTFORMDL 从今之后……不论任何苦难、任何疾病、任何忧愁
PRINTFORMDL 我们一起承担、一起分享、一起面对
PRINTFORMDL 我们会永远在一起、我会把心交给你、直到余生的尽头
PRINTFORMDL 我会爱你、我会一直忠实于你……
PRINTFORMDL 所以……嫁给我吧……灵梦……
PRINTFORMW

LOCALS = 「嗯……我答应你……此身余生、此生所爱、此心所想、尽皆是你/任何的幸福与快乐、我们共同分享、任何的苦恼、我们一同面对/你是我的唯一、我的所爱、所以……/我愿意爱你、我愿意嫁给你/包括此刻与今后……我会一直爱你……/所以我愿意……我愿意嫁给你……」
PRINTFORMDL 灵梦的声音清亮而温柔、在神社的境内回荡
CALL SPTALK, TARGET, "発情", 0, LOCALS, 1, "", "照れ,泪", 1
PRINTFORMDW

CALL SET_FIRSTKISS_CUSTOM(MASTER, @"%CALLNAME:MASTER%在只有两个人的婚礼上、将初吻献给了灵梦。")
CALL SET_FIRSTKISS_CUSTOM(TARGET, @"灵梦在只有两个人的婚礼上、将初吻献给了%CALLNAME:MASTER%。")

TIME += 240
RETURN 1

