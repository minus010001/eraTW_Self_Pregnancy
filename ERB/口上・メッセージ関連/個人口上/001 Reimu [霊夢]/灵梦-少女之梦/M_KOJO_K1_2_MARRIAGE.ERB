;自定义婚礼检查
;--------------------------------------------------
;ARGS参数：
;  "EXISTS"   — 返回自定义婚礼的名称（RESULTS），不写则使用标准婚礼
;  "COST"     — 返回自定义婚礼的费用（RESULT）
;  "LOCATION" — 返回自定义婚礼的场地编号（RESULT）
;==================================================
@M_KOJO_少女之梦_CHECK_K1_CUSTOM_WEDDING(ARGS, ARG, ARG:1)
#LOCALSIZE 1
#LOCALSSIZE 1
SELECTCASE ARGS
	CASE "EXISTS"
		;少女之梦灵梦的自定义婚礼——"只有两个人的婚礼"
		RESULTS = 只有两个人的婚礼
		RETURN 1
	CASE "COST"
		;自定义婚礼费用——只有两个人、不需要太多花费
		RETURN 500000
	CASE "LOCATION"
		;婚礼场地——博丽神社境内
		RETURN GET_MAP_REPLACEMENT(P2境内)
ENDSELECT
RETURN 0

;==================================================
;婚礼宾客名单
;--------------------------------------------------
;设置RESULT:1~RESULT:n为宾客的角色编号
;按优先级排列，前面的宾客优先入席
;最多支持到RESULT:19（20位宾客）
;==================================================
@M_KOJO_少女之梦_CHECK_K1_WEDDING_GUESTS(ARGS, ARG, ARG:1)
#LOCALSIZE 1
#LOCALSSIZE 1
;灵梦最想邀请的人
RESULT:1 = [[魔理沙]]
RESULT:2 = [[先代]]
RESULT:3 = [[早苗]]
RESULT:4 = [[神奈子]]
RESULT:5 = [[諏訪子]]
RESULT:6 = [[アリス]]
RESULT:7 = [[ルーミア]]
RESULT:8 = [[大妖精]]
RESULT:9 = [[チルノ]]
RESULT:10 = [[リグル]]
RETURN 1
