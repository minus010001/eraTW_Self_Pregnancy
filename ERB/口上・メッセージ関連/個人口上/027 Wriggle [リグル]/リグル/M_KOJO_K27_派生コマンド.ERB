;==================================================
;7,挿入子宮口責め
;==================================================
@M_KOJO_MESSAGE_SCOM_K27_7
CALL M_KOJO_MESSAGE_SCOM_K27_7_1
RETURN 1
@M_KOJO_MESSAGE_SCOM_K27_7_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初めて
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(TFLAG:50 + 500)
		RETURN 1
	ENDIF
	;基本セット
	;時姦中
	IF FLAG:70
		PRINTFORMDW 
		RETURN 1
	;其他情况
	ELSE
		IF CFLAG:K27C_恋の季節 == 1
			SELECTCASE EXP:子宮口開発経験
			;完全开发
			CASE IS > 50
				SELECTCASE RAND:12
				CASE 0
					CALL HPH_PRINT,@"「用力往\@ CFLAG:1006 >= 1 ? %TEXTR("子宫/花芯")% # 里面顶！ \@用力往\@ CFLAG:1006 >= 1 ? %TEXTR("子宫/花芯")% # 里面顶！ \@用力往\@ CFLAG:1006 >= 1 ? %TEXTR("子宫/花芯")% # 里面顶！ \@HPHHPH」","L"
					CALL HPH_PRINT,@"「往那里HPHHPH　尽情注入%TEXTR(@"%CALLNAME:MASTER%/你")%的精子HPHHPH」","L"
				CASE 1
					CALL HPH_PRINT,@"「想怀孕HPH　想怀上%TEXTR(@"%CALLNAME:MASTER%/你")%的宝宝HPH」","L"
					CALL HPH_PRINT,@"「\@ CFLAG:1006 >= 1 ? %TEXTR("子宫/宝宝的房间/花芯")% # 里面 \@捣\@ CFLAG:1006 >= 1 ? %TEXTR("子宫/宝宝的房间/花芯")% # 里面 \@捣\@ CFLAG:1006 >= 1 ? %TEXTR("子宫/宝宝的房间/花芯")% # 里面 \@捣HPHHPH」","L"
					CALL HPH_PRINT,@"「往那里HPHHPH　%TEXTR(@"%CALLNAME:MASTER%/你")%的精子HPH　尽情注入啊HPHHPH」","L"
				CASE 11
					CALL HPH_PRINT,@"「射在里面可以的HPH　射在最深处啊HPH」","L"
				CASE 2
					CALL HPH_PRINT,@"「给我撬开啊HPH　那里HPH　我最重要的地方啊HPH」","L"
					CALL HPH_PRINT,@"「让我HPH　生下强壮的孩子啊HPHHPH」","L"
				CASE 3
					CALL HPH_PRINT,@"「啊HPH　碰到了啊HPH　最深处的HPH　那个里面啊HPHHPH」","L"
					CALL HPH_PRINT,@"「%TEXTR("生殖器/小鸡鸡")% 直接HPH　碰到了哦HPH」","L"
				CASE 4
					CALL HPH_PRINT,@"「来了HPH　来了HPH　来了HPH　来了啊HPHHPH」","L"
					CALL HPH_PRINT,@"「最深处HPH　硬硬的地方啊HPH　够到了啊HPHHPH」","L"
				CASE 5
					CALL HPH_PRINT,@"「孩子HPH　制造的地方啊HPH　用%TEXTR("生殖器/小鸡鸡")%HPH　亲吻HPH　咿HPH」","L"
				CASE 6
					CALL HPH_PRINT,@"「那、那样、被粗暴地、捅的话啊」","L"
					CALL HPH_PRINT,@"「会掉出来HPH　\@ CFLAG:1006 >= 1 ? %TEXTR("子宫/宝宝的房间/花芯")% # 花芯 \@会掉出来啦HPHHPH」","L"
				CASE 7
					CALL HPH_PRINT,@"「那里HPH　那里，好棒啊HPH」","L"
					CALL HPH_PRINT,@"「积攒的精子HPH　全部射到我最里面HPH　射出来啊HPHHPH」","L"
				CASE 8
					CALL HPH_PRINT,@"「%CALLNAME:MASTER%…HPHHPH」","L"
					CALL HPH_PRINT,@"「快点…HPH　\@ CFLAG:1006 >= 1 ? %TEXTR("子宫/宝宝的房间/花芯/阴道内/小穴")% # 里面 \@射到里面…HPH　呐…HPH」","L"
				CASE 9
					CALL HPH_PRINT,@"「好厉害…HPH　%TEXTR(@"%CALLNAME:MASTER%/你")%的%TEXTR("生殖器/小鸡鸡")%…HPH」","L"
					CALL HPH_PRINT,@"「肚子里，变得一团糟了哦……HPH」","L"
				CASE 10
					CALL HPH_PRINT,@"「啊——HPH　啊——HPH　啊——HPH　啊——HPH」","L"
				ENDSELECT
				PRINTW 
			;綻び始めた
			CASE 25 TO 50
				SELECTCASE RAND:6
				CASE 0
					CALL HPH_PRINT,@"「哦呜！？HPH　哦HPH　呜HPH」","L"
					CALL HPH_PRINT,@"「明明很难受HPH　这个HPH」","L"
				CASE 1
					CALL HPH_PRINT,@"「\@ CFLAG:1006 >= 1 ? %TEXTR("子宫/宝宝的房间/花芯")% # 肚子 \@HPH　要被压扁了HPH」","L"
				CASE 2
					CALL HPH_PRINT,@"「里面HPH　%TEXTR(@"%CALLNAME:MASTER%/你")%的在刮擦啊HPH」","L"
				CASE 3
					CALL HPH_PRINT,@"「啊HPH　呜HPH　呜HPH　啊HPH　啊HPH　啊HPH　啊啊HPH」","L"
					PRINTFORML 莉格露每被捅一下子宫口，都会发出尖锐的叫声，全身颤抖不已……
				CASE 4
					CALL HPH_PRINT,@"「一直到肚子深处HPH　一直到肚子深处HPH」","L"
					CALL HPH_PRINT,@"「%TEXTR(@"%CALLNAME:MASTER%/你")%的HPH　到达了HPH」","L"
				CASE 5
					CALL HPH_PRINT,@"「不要HPH　不要HPH」","L"
					CALL HPH_PRINT,@"「精液HPH　会想要HPH　\@ CFLAG:1006 >= 1 ? %TEXTR("子宫/宝宝的房间/花芯/欧芒果/小穴")% # 里面 \@会想要啦HPHHPH」","L"
				ENDSELECT
				PRINTW 
			;异物感
			CASEELSE
				SELECTCASE RAND:3
				CASE 0
					CALL HPH_PRINT,@"「来了HPH 感到了HPH」","L"
					CALL HPH_PRINT,@"「虽然很痛苦HPH 但是这个HPH」","L"
				CASE 1
					CALL HPH_PRINT,@"「\@ CFLAG:1006 >= 1 ? %TEXTR("子宮/宝宝的房间/花芯")% # 肚子里\@HPH 压扁HPH」","L"
				CASE 2
					CALL HPH_PRINT,@"「不行HPH 不行HPH」","L"
				ENDSELECT
				PRINTW 
			ENDSELECT
		ELSE
			SELECTCASE EXP:子宮口開発経験
			;开发完全完成
			CASE IS > 50
				IF TALENT:恋慕 || TALENT:恋人
					SELECTCASE RAND:7
					CASE 0
						PRINTFORML 「来吧…%TEXTR(@"%CALLNAME:MASTER%/你")% 如果是你的话，就算强硬一点也没关系…♥」
					CASE 1
						PRINTFORML 「在肚子里，回荡着，啊♥」
						PRINTFORMDL 莉格露似乎不仅仅受到异物感的困扰，偶尔还会被深处回荡的快感所摆弄…
					CASE 2
						PRINTFORML 「嗯啊，啊♥　那个，被温柔地敲打，我或许并不讨厌…♥」
						PRINTFORML 「嗯啊，好的，好的，啊♥」
					CASE 3
						PRINTFORML 「再多敲打一点♥　敲打一点♥」
						PRINTFORML 「进去了♥　啊♥　进去了♥」
					CASE 4
						PRINTFORML 「%TEXTR(@"%CALLNAME:MASTER%/你")%的%TEXTR("生殖器/欧金金")%和我的紧密接触着呢♥」
					CASE 5
						PRINTFORML 「有些痛苦♥　但是，感觉，舒服♥」
						PRINTFORML 「为什么，呢♥　因为是%TEXTR(@"%CALLNAME:MASTER%/你")%嘛♥　大概♥」
					CASE 6
						PRINTFORML 「不行♥　却♥」
						PRINTFORML 「%TEXTR("扭动/摩擦/")%喜欢的♥」
					ENDSELECT
				ELSEIF TALENT:愛欲 || TALENT:炮友
					SELECTCASE RAND:7
					CASE 0
						PRINTFORML 「最深处♥　成为了%TEXTR(@"%CALLNAME:MASTER%/你")%专属的肉穴了♥」
					CASE 1
						PRINTFORML 「这个♥　太棒了♥　被深深戳中了的感觉，陷进去了♥」
					CASE 2
						PRINTFORML 「重重地来♥　到最深处♥　慢慢地♥」
					CASE 3
						PRINTFORML 「击中了♥　被压迫着♥　噗呲♥　噗呲♥」
					CASE 4
						PRINTFORML 「啊♥　嗯♥　最深处♥　被压扁了♥」
					CASE 5
						PRINTFORML 「\@ CFLAG:1006 >= 1 ? %TEXTR("子宮/宝宝的房间/花芯")% # \@进一步戳击♥」
					CASE 6
						PRINTFORML 「\@ CFLAG:1006 >= 1 ? %TEXTR("子宮/宝宝的房间/花芯")% # \@被击中了♥　噢噢♥」
					ENDSELECT	
				ELSEIF TALENT:思慕
					SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「呜呜呜、呜呜呜、呜呜」
						SELECTCASE RAND:3
						CASE 0
							PRINTFORML （深处，传来沉甸甸的感觉…）
						CASE 1
							PRINTFORML （我的内部，好像被%CALLNAME:MASTER%的生殖器形状填满了）
						CASE 2
							PRINTFORML （这是，撞到了小宝宝的房间吗！？ 不、不行啊…♥）
						ENDSELECT
					CASE 1
						PRINTFORML 「呼！？♥　不，不舒服啊…」
					ENDSELECT
				ELSE
					SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「啊啊啊！！？♥　进来了！？ 进来了啊！！」
					CASE 1
						PRINTFORML 「不、不行啊！ 深深的戳进去，会变得奇怪的！」
					ENDSELECT
				ENDIF
				PRINTW 
			;破裂开始
			CASE 25 TO 50
				IF TALENT:恋慕 || TALENT:恋人
					SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「过来吧…如果是%TEXTR(@"%CALLNAME:MASTER%/你")%的话，我能接受的…」
					CASE 1
						PRINTFORML 「嗯、嗯、嗯、嗯、嗯呜！？♥」
						PRINTFORMDL 莉格露似乎除了异物感之外，还时而受到深处回响的快感的影响…
					CASE 2
						PRINTFORML 「哈啊、啊、那个，被轻轻拍打的感觉，我不讨厌，可能…♥」
						PRINTFORML 「嗯呐、好的、好的，啊、啊啊♥」
					ENDSELECT
				ELSEIF TALENT:愛欲 || TALENT:炮友
					SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「这样深深地戳进去的话啊啊啊♥　%TEXTR(@"%CALLNAME:MASTER%/你")%专用的洞会变成的啊♥」
					CASE 1
						PRINTFORML 「这样♥　危险啊♥　会卡住的可能性很大啊♥」
					CASE 2
						PRINTFORML 「沉重的，来了啊♥　深处，嗡嗡地…♥」
					ENDSELECT
				ELSEIF TALENT:思慕
					SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「呜呜呜、呜呜呜、呜呜」
						SELECTCASE RAND:3
						CASE 0
							PRINTFORML （深处，传来沉甸甸的感觉…）
						CASE 1
							PRINTFORML （我的内部，好像被%CALLNAME:MASTER%的生殖器形状填满了）
						CASE 2
							PRINTFORML （这是，撞到了小宝宝的房间吗！？ 不、不行啊…♥）
						ENDSELECT
					CASE 1
						PRINTFORML 「呼！？♥　不对，不舒服啊…」
					ENDSELECT
				ELSE
					SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「呜呜呜，深深的，进来了…！」
					CASE 1
						PRINTFORML 「最深处，被击中了啊…！」
					ENDSELECT
				ENDIF
				PRINTW 
			;异物感
			CASEELSE
				IF TALENT:恋慕 || TALENT:恋人
					SELECTCASE RAND:3
					CASE 0
						PRINTFORML 「求求你…就算戳进来，也请温柔一点…」
					CASE 1
						PRINTFORMDL 莉格露咬紧了嘴唇，忍耐着疼痛和异物感，表现得坚忍而可爱…
					CASE 2
						PRINTFORML 「那里…激烈地戳进去，是不行的哦」
					ENDSELECT
				ELSEIF TALENT:愛欲 || TALENT:炮友
					SELECTCASE RAND:2
					CASE 0
						PRINTFORML 「痛…！ 那里，还是不行的…」
					CASE 1
						PRINTFORML 「不舒服啊，讨厌啦…停下，啊…」
					ENDSELECT
				ELSEIF TALENT:思慕
					PRINTFORML 「疼、疼啊，深处，别戳进来啊」
				ELSE
					PRINTFORML 「啊啊啊！！？ 疼，不、不要啊，求你了啊」
				ENDIF
				PRINTW 
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
ENDIF
