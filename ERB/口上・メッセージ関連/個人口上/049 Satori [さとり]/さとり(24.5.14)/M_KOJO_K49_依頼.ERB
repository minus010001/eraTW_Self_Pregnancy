							PRINTFORML 「『无论如何明明完成了的吧』？　那种事情不是理所当然的吗————」
						ELSE
							PRINTFORML 「非常感谢、多亏您的帮助了」
						ENDIF
						BOOK_NAME = 
						;EVENT_1015 这是什么～?
							CALL EVENT_49_1015
					;報告時（失敗）
					;この他、報告忘れや期限切れで失敗扱いになり後日依頼人に遭遇した際にも表示
					CASE OPR_失败报告时
						IF 陷落状态() >= 4
							PRINTFORML 「…%CALLNAME:MASTER%啊、我的请求是就就可以这样忘记的事情吗——？」
							PRINTFORML 「『没有那样的事』？　可是实际上，不还是没有按时做到吗——」
							PRINTFORML 「哈啊……%CALLNAME:MASTER%真是个笨蛋」
						ELSEIF 陷落状态() == 3
							PRINTFORML 「…真是的，就不能遵守约定吗…?」
							PRINTFORML 「『偶尔也会忘记的』？　……哈啊、真拿你没办法」
						ELSEIF 陷落状态() == 2
							PRINTFORML 「果然是个没用的家伙…没办法好好完成工作、也能这样稀里糊涂的活下去的人，也只有你了吧」
							PRINTFORML 「『时奸你算是工作吗』？　请随意吧、只会发脾气和性交的笨蛋也要有个限度啊……」
						ELSE
							PRINTFORML 「如果做不到，请一开始就不接受就好了吧」
						ENDIF
						BOOK_NAME = 
				ENDSELECT
		ENDSELECT
	CASE OPR_目标
		;ここで表示されるSCENEはOPR_委托实行直前, OPR_委托实行直后だけです
		;一般依頼
		IF IS_COMMON_IRAI(IRAI_ID)
			SELECTCASE STR_DATA_IRAI(IRAI_ID, OPR_委托名, CLIENT_ID)
				;个々の依頼名で分岐してください
				CASE "一般依頼名"
				;人物が鍵になっていた・もしくは場所にたまたま居合わせた
					SELECTCASE SCENE
						;TARGETが呼ばれるのはこのタイミングだけ
						CASE OPR_委托实行直前
						CASE OPR_委托实行直后
					ENDSELECT
			ENDSELECT
			RETURN
		ENDIF
		SELECTCASE CSVCALLNAME(CLIENT_ID)
			;依頼者のCALLNAMEによる分岐（CSV准拠）
			CASE "依頼者"
				SELECTCASE STR_DATA_IRAI(IRAI_ID, OPR_委托名, CLIENT_ID)
					CASE "固有依頼名"
						SELECTCASE SCENE
						CASE OPR_委托实行直前
						CASE OPR_委托实行直后
						ENDSELECT
				ENDSELECT
		ENDSELECT
	CASE OPR_无需报告
		;日数経過時、報告不要依頼を達成していた場合に呼ばれる口上
		;ここで表示されるSCENEはOPR_委托报告不要だけです
		;SCENEが一つしか無いので分岐は不要
		;また、必ず依頼主の口上が呼ばれます
		;一般依頼
		IF IS_COMMON_IRAI(IRAI_ID)
			SELECTCASE STR_DATA_IRAI(IRAI_ID, OPR_委托名, CLIENT_ID)
				;个々の依頼名で分岐してください
				CASE "一般依頼名"
				CASE "給花澆水"
				CASE "誰的遗失物"
			ENDSELECT
			RETURN
		ENDIF
		SELECTCASE STR_DATA_IRAI(IRAI_ID, OPR_委托名, CLIENT_ID)
			CASE "固有依頼名"
		ENDSELECT
ENDSELECT

