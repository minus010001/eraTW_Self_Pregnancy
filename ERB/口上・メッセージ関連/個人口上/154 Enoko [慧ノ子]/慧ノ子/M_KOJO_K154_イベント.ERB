;==================================================
;デート归りに告白（恋人が付く）
;==================================================
;==================================================
;Optional: Determines if the standard description should be skipped.
;Return 0 if description and KOJO should be shown, 1 if description should be hidden and KOJO shown, 2 if description should be shown and KOJO hidden, and 3 if both description and KOJO should be hidden.
;（任意）:通常の地の文を表示するかスキップするか决定する。
;RETURN 0;通常地の文と口上を表示
;RETURN 1;口上のみ表示
;RETURN 2;通常地の文のみ表示
;RETURN 3;どちらも表示しない
;==================================================
@M_KOJO_SPEVENT_MESSAGECHECK_K154_2
RETURN 0

@M_KOJO_SPEVENT_K154_2(ARG,ARG:1)
;台词主人公为TARGET
;地の文表示
;--------------------------------------------------
;记入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;告白内容
	;この告白内容表示后に受けるかどうかの选择分が表示されます
	;记入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		;初回
		IF FIRSTTIME(1154)
			PRINTFORMW 「%CALLNAME:MASTER%，你知道吗」
			PRINTFORMW 在约会回家的路上，慧之子转向%CALLNAME:MASTER%，慢慢地说出了话语。
			PRINTFORMW 「我，其实对生活感到疲惫」
			PRINTFORMW 「即使说是永恒的生命，持续不断的生命只会让人感到无所适从」
			PRINTFORMW 「我总是被追赶，被超越，但是呢」
			PRINTFORMW 「我意识到，至少想和喜欢的人在一起」
			PRINTFORMW 「虽然我知道终有一天会成为送别的一方，但现在我想和%CALLNAME:MASTER%在一起……」
			PRINTFORMW 「……你愿意成为我的恋人吗」
			PRINTFORMW 慧之子害羞地说道。
		;第二次告白
		ELSE
			PRINTFORMW 「%CALLNAME:MASTER%，果然我还是无法忍受……！」
			PRINTFORMW 慧之子有些羞怯地喃喃自语。
			PRINTFORMW 「为了%CALLNAME:MASTER%，我什么都愿意做！所以至少现在让我陪着你吧！」
			PRINTFORMW 「我，已经受够了孤独……！」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白成功（成为恋人）
	;记录检查（=0，隐藏，1，显示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		PRINTFORMW 「呀吼！我的这条命，就托付给%CALLNAME:MASTER%了！」
		PRINTFORMW 慧之子夸张地跳起来，非常高兴。
		PRINTFORMW 「……说实话，我真的很害怕被你拒绝，但是你接受了我」
		PRINTFORMW 「从今往后，直到死亡将我们分开，我们都要在一起哦，%CALLNAME:MASTER%！」
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;告白失败
	;记入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		PRINTFORMW 「……是吗……%CALLNAME:MASTER%，你很受欢迎呢……」
		PRINTFORMW 「但是，如果还有机会的话，你能重新考虑一下吗……」
		PRINTFORMW 慧之子垂下肩膀，像是在恳求一样抬头看着你。
		PRINTFORMW 「……明天见，唉……」
		RETURN 1
	ENDIF

ENDIF
RETURN 1

