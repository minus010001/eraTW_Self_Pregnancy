;"EVENT"系イベント
;※※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;房间で遭遇
;==================================================
@M_KOJO_EVENT_K154_1(ARG,ARG:1)
;台词主人公为TARGET
;--------------------------------------------------
;记入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
CALL SET_KOJO_COLOR(154)
	;今日会ってない。
	IF !TCVAR:154:今天有否见面
		;-------------------------------------------------
		;小分岐
		;-------------------------------------------------
		;MASTERが入ってきた
		;记入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 1
			;正月、情人节、ハロウィン、クリスマスの场合
			IF (DAY:2 == 1 && DAY:3 == 1 && DAY:0 != 1) || (DAY:2 == 4 && DAY:3 == 14 && CFLAG:2 >= 1000) || (DAY:2 == 3 && DAY:3 == 30) || (DAY:2 == 4 && DAY:3 == 25)
				CALL SPECIALDAY_EVENT_K154
			ELSEIF CFLAG:318 == 1
				PRINTFORMW 「……哼！」
			;屋外かつ满月
			ELSEIF NAME_MOON(DAY:3) == "十五夜 -中秋的名月- " && OPENPLACE(CFLAG:MASTER:現在位置) >= 2
				PRINTFORMW 「哇啊！在美丽的月亮下相遇真是太棒了！」
				IF TALENT:恋人
					PRINTFORMW 「月亮这么圆，是不是在为我们加油呢～什么的」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「……只是看入迷了而已！别在意！」
					PRINTFORMW 慧之子好像盯着什么在看，慌慌张张的掩饰。
				ENDIF
			ELSE
				;清晨
				IF TIME:2 == 1 || TIME:2 == 2
					PRINTFORMW 「早上好！%CALLNAME:MASTER%！」
				;白天
				ELSEIF TIME:2 == 3 || TIME:2 == 4
					PRINTFORMW 「你好！%CALLNAME:MASTER%！」
				;傍晚/夜晚
				ELSEIF TIME:2 == 5 || TIME:2 == 6
					PRINTFORMW 「嘿，%CALLNAME:MASTER%」
				ENDIF
				IF TALENT:恋人
					PRINTFORMW 「诶嘿嘿，今天能见面真幸福呢～对吧？」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「看到你的脸我也精神了起来！」
				ELSEIF TALENT:思慕
					PRINTFORMW 「嗯嗯！年轻人精力充沛啊！」
				ENDIF
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;TARGETが入ってきた
		;记入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 2
			;正月、情人节、ハロウィン、クリスマスの场合
			IF (DAY:2 == 1 && DAY:3 == 1 && DAY:0 != 1) || (DAY:2 == 4 && DAY:3 == 14 && CFLAG:2 >= 1000) || (DAY:2 == 3 && DAY:3 == 30) || (DAY:2 == 4 && DAY:3 == 25)
				CALL SPECIALDAY_EVENT_K154
			ELSEIF CFLAG:318 == 1
				PRINTFORMW 「……哼！」
			;屋外かつ满月
			ELSEIF NAME_MOON(DAY:3) == "十五夜 -中秋的名月- " && OPENPLACE(CFLAG:MASTER:現在位置) >= 2
				PRINTFORMW 「哇啊！在美丽的月亮下相遇真是太棒了！」
				IF TALENT:恋人
					PRINTFORMW 「月亮这么圆，是不是在为我们加油呢～什么的」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「……只是看入迷了而已！别在意！」
					PRINTFORMW 慧之子好像盯着什么在看，慌慌张张的掩饰。
				ENDIF
			ELSE
				;清晨
				IF TIME:2 == 1 || TIME:2 == 2
					PRINTFORMW 「早上好！%CALLNAME:MASTER%！」
				;白天
				ELSEIF TIME:2 == 3 || TIME:2 == 4
					PRINTFORMW 「你好！%CALLNAME:MASTER%！」
				;傍晚/夜晚
				ELSEIF TIME:2 == 5 || TIME:2 == 6
					PRINTFORMW 「嘿，%CALLNAME:MASTER%」
				ENDIF
				IF TALENT:恋人
					PRINTFORMW 「诶嘿嘿，今天能见面真幸福呢～对吧？」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「看到你的脸我也精神了起来！」
				ELSEIF TALENT:思慕
					PRINTFORMW 「嗯嗯！年轻人精力充沛啊！」
				ENDIF
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;TARGETが澡堂に入ってきて一绪に入る
		;记入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 3
			IF TALENT:恋人
				PRINTFORMW 「啊！你已经在里面了～！」
				PRINTFORMW 「那么！一起进去吧！因为我们是恋人嘛！」
			ELSEIF TALENT:恋慕
				PRINTFORMW 「啊！%CALLNAME:MASTER%！泡头汤？」
				PRINTFORMW 「也分给我嘛～！可以吧～？」
			ELSEIF TALENT:思慕
				PRINTFORMW 「咦？已经有人在里面了！」
				PRINTFORMW 「机会难得，一起洗吧！」
			ELSE
				PRINTFORMW 「哇！？算了！一起进去吧！」
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;目标进入浴室然后离开
		;记录检查（=0，不显示，1，显示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 4
			IF TALENT:恋人
				PRINTFORMW 「阿啦啦啦……慢慢享受吧～」
			ELSEIF TALENT:恋慕
				PRINTFORMW 「对不起哦！洗澡是想慢慢享受的嘛～」
			ELSEIF TALENT:思慕
				PRINTFORMW 「哇！？对不起哦！」
			ELSE
				PRINTFORMW 「哇哇哇！打扰了～！」
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;目标进入浴室然后被赶出去
		;记录检查（=0，不显示，1，显示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 5
			IF TALENT:恋人
				PRINTFORMW 「抱歉～我现在想快点洗澡～」
			ELSEIF TALENT:恋慕
				PRINTFORMW 「我现在想一个人进澡堂，所以抱歉啦～！」
			ELSEIF TALENT:思慕
				PRINTFORMW 「女士优先哦～！如果你非要一起的话，我会考虑一下的！」
			ELSE
				PRINTFORMW 「不许抢我的澡堂～！」
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;外出先で遭遇した
		;记入チェック（=0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 6
			;正月、情人节、ハロウィン、クリスマスの场合
			IF (DAY:2 == 1 && DAY:3 == 1 && DAY:0 != 1) || (DAY:2 == 4 && DAY:3 == 14 && CFLAG:2 >= 1000) || (DAY:2 == 3 && DAY:3 == 30) || (DAY:2 == 4 && DAY:3 == 25)
				CALL SPECIALDAY_EVENT_K154
			ELSEIF CFLAG:318 == 1
				PRINTFORMW 「……哼！」
			;屋外かつ满月
			ELSEIF NAME_MOON(DAY:3) == "十五夜 -中秋的名月- " && OPENPLACE(CFLAG:MASTER:現在位置) >= 2
				PRINTFORMW 「哇啊！在美丽的月亮下相遇真是太棒了！」
				IF TALENT:恋人
					PRINTFORMW 「月亮这么圆，是不是在为我们加油呢～什么的」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「……只是看入迷了而已！别在意！」
					PRINTFORMW 慧之子好像盯着什么在看，慌慌张张的掩饰。
				ENDIF
			ELSE
				;清晨
				IF TIME:2 == 1 || TIME:2 == 2
					PRINTFORMW 「早上好！%CALLNAME:MASTER%！」
				;白天
				ELSEIF TIME:2 == 3 || TIME:2 == 4
					PRINTFORMW 「你好！%CALLNAME:MASTER%！」
				;傍晚/夜晚
				ELSEIF TIME:2 == 5 || TIME:2 == 6
					PRINTFORMW 「嘿，%CALLNAME:MASTER%」
				ENDIF
				IF TALENT:恋人
					PRINTFORMW 「诶嘿嘿，今天能见面真幸福呢～对吧？」
				ELSEIF TALENT:恋慕
					PRINTFORMW 「看到你的脸我也精神了起来！」
				ELSEIF TALENT:思慕
					PRINTFORMW 「嗯嗯！年轻人精力充沛啊！」
				ENDIF
			ENDIF
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;与其他角色约会时遇到
		;ARG:1为约会对象
		;记录检查（=0，不显示，1，显示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG == 7
			;愤怒
			IF CFLAG:318 == 1
				PRINTFORMW 「……哼！」
			;愤怒 恋慕时 约会对象是魔理沙
			ELSEIF CFLAG:318 == 1 && TALENT:恋慕 && ARG:1 == 11
				PRINTFORMW 「……魔理沙真是笨蛋！」
			;恋人时 约会对象是魔理沙
			ELSEIF TALENT:恋人 && ARG:1 == 11
				PRINTFORMW 「诶，稍等……」
			ELSEIF TALENT:恋人
				PRINTFORMW 「……出轨了……？」
			;恋慕时 约会对象是典
			ELSEIF TALENT:恋慕 && ARG:1 == 11
				PRINTFORMW 「强大的对手出现了呢……」
			ELSEIF TALENT:恋慕
				PRINTFORMW 「哇～真受欢迎啊，%CALLNAME:MASTER%」
			ELSE
				PRINTFORMW 「看来老身有点碍事呢……」
			ENDIF
			RETURN 1
		ENDIF
		;その他
		PRINTFORML  
	ENDIF
	;-------------------------------------------------
	;MAIN_MAP上で一日最初の挨拶
	;注、このあと通常の遭遇口上、ARG==1 OR ARG==2に接续します
	;记入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 8
		PRINTFORML 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;外出先で一日最初の挨拶
	;ARG:1に约会的对象、ARG:1が0の场合は非デート
	;注、このあと通常の外出先で遭遇した口上、ARG==6 OR ARG==7に接续します
	;记入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 9
		;ARG:1と约会中
		IF ARG:1
		;一人で外出
		ELSE
		ENDIF
		PRINTFORML 
		RETURN 1
	ENDIF
ENDIF
RETURN 1

