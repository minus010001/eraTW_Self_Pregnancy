		RETURN 1
	ENDIF
	;-------------------------------------------------
	;允许非危险期
	;记入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		IF TALENT:恋人
			PRINTFORMW 「……要负责哦？」
		ELSEIF TALENT:恋慕
			PRINTFORMW 「嗯，那……好吧……」
		ELSE
			PRINTFORMW 「……只能在安全期哦？」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;允许危险期
	;记入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		IF TALENT:恋人
			PRINTFORMW 「嗯，那就一起好好享受吧……♥」
		ELSEIF TALENT:恋慕
			PRINTFORMW 「嗯，好吧」
