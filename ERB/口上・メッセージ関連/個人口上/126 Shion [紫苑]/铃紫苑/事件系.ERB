@M_KOJO_铃紫苑_CHECK_K126_IRAI_BLOCKED(ARGS,ARG,ARG:1)
; SIF GROUPMATCH(ARG, 2)
;  RETURN 1
;AI真好用
;====================================================================
; 函数名：@M_KOJO_K1_UPDATE_NOSEX_DAYS
; 作用  ：当TARGET为恋人且非处女时，更新"未做爱天数"变量
;         本函数只负责更新，不返回、不改变其他游戏状态
; 调用  ：在每日事件 @M_KOJO_EVENT_K1_31 中 CALL 一次即可
;
; 【变量定义】（直接用数字索引访问，无需CSV定义）
;   CFLAG:TARGET:1500  恋人最後セックス日  最后做爱日（DAY值）
;   CFLAG:TARGET:1501  恋人未セックス日数  未做爱天数（核心变量，外部读取此值）
;   CFLAG:TARGET:1502  恋人前回性交経験    上次记录时的性交经验合计
; 判定  ：TALENT:7(恋人)==1 且 TALENT:0(処女)<=0（非处女）
;====================================================================
@M_KOJO_K126_UPDATE_NOSEX_DAYS
#DIM DYNAMIC 現在経験
;条件检查：必须为恋人且非处女
IF !TALENT:TARGET:恋人 || TALENT:TARGET:処女 > 0
	RETURN
ENDIF
現在経験 = EXP:TARGET:Ｖ性交経験 + EXP:TARGET:Ａ性交経験
IF CFLAG:TARGET:1502 == 0 && 現在経験 == 0
	;满足条件但从未做爱
	CFLAG:TARGET:1501 = -1
ELSEIF CFLAG:TARGET:1502 == 0
	;首次调用但已有经验，以当前日为基准
	CFLAG:TARGET:1500 = DAY
	CFLAG:TARGET:1502 = 現在経験
	CFLAG:TARGET:1501 = 0
ELSEIF 現在経験 > CFLAG:TARGET:1502
	;经验增加=做了爱，更新最后做爱日
	CFLAG:TARGET:1501 = DAY - CFLAG:TARGET:1500
	CFLAG:TARGET:1500 = DAY
	CFLAG:TARGET:1502 = 現在経験
ELSE
	;未做爱，只更新天数
	CFLAG:TARGET:1501 = DAY - CFLAG:TARGET:1500
ENDIF
RETURN