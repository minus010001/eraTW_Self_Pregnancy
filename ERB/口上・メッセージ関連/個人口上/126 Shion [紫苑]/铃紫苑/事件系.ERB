;==================================================
;一天结束时(AFTERTRA之前)，没有见过面的话不会被调用
;==================================================
@M_KOJO_铃紫苑_EVENT_K126_31(ARG,ARG:1)
CALL M_KOJO_K126_UPDATE_NOSEX_DAYS
;口上角色编号 = TARGET
;ARG	没见面的天数
;如果几天没见面，角色可以抱怨。
;CFLAG:オナバレ可以用于差分
;--------------------------------------------------
;启用（= 0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	IF TALENT:126:3
		IF FIRSTTIME("恋慕第一次触发")
			PRINTFORML 「这本……这本……还有这本」
			PRINTFORML 桌面上的书册越堆越高，摇摇欲坠地遮住了窗外的光线。紫苑望着眼前这座纸山，眉宇间愁云惨淡。
			PRINTFORML 「女苑……这些，真的都要看完吗？」
			PRINTFORML 她缩着脖子，手指不安地对着，视线怯生生地飘向对面。
			PRINTFORML 依神女苑翘着腿，漫不经心地打磨着指甲边缘，连眼皮都没抬一下
			PRINTFORML 「无所谓啊，不想看就不看。反正你大字不识地去倒贴，看他嫌不嫌弃你就完了」
			PRINTFORML 她吹了吹指尖的粉末，轻笑一声
			PRINTFORML 「而且我还得祈祷他不要一时糊涂就把你娶回家呢，不然这辈子就算毁了。」 
			PRINTFORML 「多少学点东西的话，就算不能帮他大富大贵，至少也能为他减轻一些负担，在这个前提下，你们才有在一起的可能」
			PRINTFORMW 「没想到你连这点事都不肯做，果然姐姐你，是名副其实的穷神啊。」
			PRINTFORML 「呜……」
			PRINTFORML 紫苑被戳中了痛处，想要反驳却找不到词句。
			PRINTFORML 她垂下头，咬着嘴唇沉默了良久，最后抓着衣角的手慢慢松开，眼神逐渐坚定起来
			PRINTFORML 「女苑你说得对……如果我真的喜欢%CALLNAME:MASTER%，就不能只想着依赖他，更不能……成为他的负担。」
			PRINTFORML 「欸痛快！我就喜欢姐姐这脾气。」
			PRINTFORML 女苑立刻换上了一副笑脸，身子前倾，将那堆令人望而生畏的书册推到了紫苑眼皮底下
			PRINTFORML 「既然想通了，那姐姐现在就开始吧~」
			PRINTFORML 「呜呜，我知道了啦。」
			PRINTFORML 紫苑深深叹了一口气，找了根布条将有些碍事的长发利落地束在脑后，翻开了最上面那本厚重的读物。
			PRINTFORML 可指尖刚触到书页，她动作顿了顿，有些疑惑地抬起了头
			PRINTFORMW 「不过……女苑，你怎么突然对我和%CALLNAME:MASTER%的事这么上心了？之前明明还很反对的……」PRINTFORML 「笨~蛋，我是你妹妹啊，当然要操心姐姐的终身大事了。」
			PRINTFORML 女苑撑着下巴，笑得天真烂漫。
			PRINTFORML 「女苑~~~有你真好，姐姐一定会努力的」
			PRINTFORML 紫苑感动地吸了吸鼻子，重新埋首于书堆之中。
			PRINTFORML 而在女苑的笑脸背后——
			PRINTFORMW （盒盒，当然是因为这样我就可以甩掉你这个拖油瓶了。）
			CALL AddEXP_D(70, 126, 200);扫地
			CALL AddEXP_D(75, 126, 200);学习
			CALL AddEXP_D(76, 126, 200);做菜
		ELSEIF DAY:3 == 30
		;这里什么都没写，只保留着风铃留下的虚无
		ENDIF
	ELSEIF TALENT:126:8 && FIRSTTIME("思慕事件仅此一次")
		PRINTFORML 是夜，依神紫苑向后一倒，原本想倒在铺团上，但忘了把桌子移走
		PRINTFORML 嘎巴一声，这是她撞到桌沿上的声音，她捂住后腰滚到了地上，好似一条绝望的虾
		PRINTFORML 「嗷嗷噢嚯嚯——」
		PRINTFORML 闹完以后，她盯着天花板上晃动的，外边水池映进来的蓝色水纹，长长地叹了一口气。
		PRINTFORML 「这样下去真的好吗……%CALLNAME:MASTER%对我这么好，我却只把他当成提款机。」
		PRINTFORML 她侧过身，视线落在黑暗的角落里。
		PRINTFORML 「……但女苑说了，反正他很快就会对我失去兴趣的，不这么做就什么捞不着了。」
		PRINTFORML 「但是……我为什么会感觉这么心闷呢，我想要的真的是这些吗……」
		PRINTFORML 我想要的究竟是——
		PRINTFORMW 紫苑把脸深深埋进被子的空隙，让流水声冲刷脑中的思绪，直到紧皱的眉头在睡意中慢慢舒展开。
	ENDIF
	;小事件，就做爱的时候触发一小段特殊文本
	SIF TALENT:126:3 && CFLAG:126:1001 != 7
		CFLAG:126:1001++
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;今日没见过面
	;启用（= 0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG
		;是为了在显示口上之前，判别是谁的东西的地文，想变更的话，请在删除之后独自制作。
		CALL EVENTEND_TSUBUYAKI
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;今天见面了
	;启用（= 0, 非表示、1, 表示）
