		;-------------------------------------------------
		IF LOCAL:1 && !ARG:1
			PRINTFORMW
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;地点在MASTER私室，TARGET在此处睡着了(没有恋慕导致此情况也有可能，比如说无家可归之人
		;启用（= 0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			PRINTFORMW
			RETURN 1
		ENDIF
		PRINTFORMW
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;同居时，TARGET先起床了
	;启用（= 0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF !RAND:5
			SELECTCASE RAND:2
				CASE 0
				PRINTFORMDL 或许是感知到了你的离去，紫苑抱着你的手臂蜷缩成了小小一团，在睡梦中倔强地挽留着你。
				PRINTFORMDL 无可奈何，你只得在这大好的清晨多怠懒了一会，陪伴你的爱人。
				PRINTFORMW
				PRINTFORMDL 醒来的时候你直冒冷汗，只觉得被什么不干净的东西缠上了，四肢动弹不得。
				PRINTFORMDL ……
				PRINTFORMDL 原来是紫苑像八爪鱼一样缠着你睡了一宿。
				PRINTFORMW
				PRINTFORML 「呼诶？已经到早上了吗？」
				PRINTFORMDL 紫苑声音糯糯的，嘴唇因为一夜的好眠而显得格外红润……
				PRINTFORML 「唔嗯～？」
				PRINTFORMDL 她有些惊讶地回应了你的吻，舌头软软地与你纠缠。
				PRINTFORMW 「噗哈……居然能被这么幸福的方式叫醒。看来我也算人生胜利组了……」
				TIME += 30
				CASE 1
				PRINTFORML 「早上好，今天是我先起来了呢。」
				PRINTFORMDL 你醒来时发现紫苑正跨坐在你身上，神态轻松地朝你打招呼。
				PRINTFORMDL 你点了点头，准备起身，却被她柔柔地按了回去。
				PRINTFORML 「……等等」
				PRINTFORMDL 紫苑爬上来了一点，上衣滑落露出光洁的肩头。短裙也卷到了大腿，她缠磨着你的身体，肌肤相贴的地方传来柔软的触感。
				PRINTFORML 「%CALLNAME:MASTER%明明为了我一直那么努力……可我却拿不出什么回报。哪怕只有清晨这一小会儿也好，让我好好疼爱你一下吧，好吗？」
				PRINTFORMDW 早晨，你在紫苑的温柔乡中怠懒了好一段时间
				TIME += 30
			ENDSELECT
		ELSE
			SELECTCASE TIME:5
				;一般
				CASE 0,1,2,3
					SELECTCASE RAND:4
						CASE 0
						PRINTFORML 「早…早上好，%CALLNAME:MASTER%。」
						PRINTFORMDL 见你苏醒，紫苑把脑袋凑了过来，似乎是想给你一个早安吻，但没把握好角度，撞到你额头上了。
						PRINTFORML 「哇啊，抱歉。」
						PRINTFORMDL 你觉得好笑地坐起身子，主动吻上了她的嘴唇。
						PRINTFORML 「唔嗯！？～～～～」
						PRINTFORMW 「谢谢……嘿嘿……感觉脑袋晕乎乎的，那、那我去给你拿衣服了哦。」
						CASE 1
						PRINTFORML 意识逐渐回笼，紫苑的身影在晕开的光影里慢慢浮现出来
						PRINTFORML 她就待在你手边不远的地方，双手抱膝坐着，裙下的风光展现在你的视野内，无一点保留
						PRINTFORML 「早上好……%CALLNAME:MASTER%。」
						PRINTFORMW 「我做了早餐，如果不嫌弃的话，一起来吃吧。」
						CASE 2
						PRINTFORML 「呀~吼~早上了呢」
						PRINTFORML 「%CALLNAME:MASTER%的睡颜，很可爱哦。」
						PRINTFORML 「稍等一下下，我这就去给%CALLNAME:MASTER%做早餐。」
						PRINTFORMW 紫苑在你的脸颊上亲了一口，留下对起床而言正合适的柔和温度，起身远去了
						CASE 3
						PRINTFORML 迷迷糊糊地睁眼，发觉光线被一旁的身影隔绝了大半，只留下一片舒适的阴影。
						PRINTFORML  紫苑坐在光影交界处，低头摆弄着自己的发梢。
						PRINTFORML 她察觉到你睁眼，只是微微侧过脸，光线之下是恬静的笑容。 
						PRINTFORMW 「早，昨晚睡得好吗？我给%CALLNAME:MASTER%准备了早餐。
					ENDSELECT
				;雨
				CASE 4,5,6
				PRINTFORML 「下雨了……」
				PRINTFORMDL 紫苑缓慢地坐起身子，在迷蒙蒙地看了一眼窗外的雨以后，又干脆地躺了回去。
				PRINTFORMDL 她在你臂弯里翻了个身，正对着你。湛蓝的眸子扑闪了几下
				PRINTFORMW 「天气播报员依神提醒您，今日大雨，不宜出门，最好和我一起懒散地度过。」
				;雪
				CASE 8,9,10,11
				PRINTFORMDL 将你从睡梦中唤醒的，是略微渗透进屋内的凌冽寒风。
				PRINTFORMDL 你睁开眼，发现紫苑也正侧躺着，那双幽寂的眼睛越过你望向窗外飘零的雪花，不知看了多久。
				PRINTFORMDL 在发现你醒了以后，她好像有些恍然似的，向你的方向缩了缩，用温热的脸颊蹭了蹭你的手臂。
				PRINTFORMW 「哼哼～%CALLNAME:MASTER%的身边就是我的归处。」
			ENDSELECT
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;同居时，TARGET还在睡觉
	;启用（= 0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORMW
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MASTER起床了，TARGET也跟着起床了
	;同时在床上保持清醒状态结束陪睡，也可能触发此口上，仅限于MASTER醒来后接着陪睡，TARGET在陪睡途中醒来的情况
	;启用（= 0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		;-------------------------------------------------
		;非同居
		;启用（= 0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && !ARG:1
			PRINTFORMW
			RETURN 1
		ENDIF
		;-------------------------------------------------
		;同居中
		;启用（= 0, 非表示、1, 表示）
		LOCAL:1 = 1
		;-------------------------------------------------
		IF LOCAL:1 && ARG:1 == 1
			SELECTCASE RAND:3
				CASE 0
				PRINTFORML 你比紫苑早醒了一会儿，没急着下床，只是侧过身，手肘陷进枕头里看她。
				PRINTFORML 晨光在她的鼻翼投下了可爱的阴影，呼吸的尾音微微拖长。
				PRINTFORML 几分钟过后，紫苑长长的睫毛颤动了一下，露出了那双蒙雾的蓝眸。
				PRINTFORML 悠悠转转，最后定格在了你身上
				PRINTFORML 「早上好啊……%CALLNAME:MASTER%。」
				PRINTFORMW 揉揉眼睛，她向你露出了甜美的笑容
				CASE 1
				PRINTFORML 在你睡醒好一会以后，依神紫苑才慢悠悠地从床上坐起来
				PRINTFORML 眼睑睁开，她的眼睛缓慢地寻找着焦点，从你枕头的褶皱，移到你睡衣的领口，最后才落在你脸上。
				PRINTFORML 她就这么盯了你一会，忽然笑了，一边笑一边用掌心盖住眼睛，指缝间漏出一点晨光，晃得她眯起眼。
				PRINTFORMW 「早上好，%CALLNAME:MASTER%……我好像贪睡了一会呢，谢谢你等我哦」
				CASE 2
				PRINTFORML 你比紫苑早醒了一会儿，没急着下床，只是侧过身，手肘陷进枕头里看她。
				PRINTFORML 光线在她侧脸镀上了一层柔和的暖晕，你打了个舒适的哈欠，伸手 
				PRINTFORML 为她遮住窗外耀眼的晨光，然后看着她在你手掌的阴影中渐渐醒转。 
				PRINTFORMW 「呜喵……已经早上了吗？」
			ENDSELECT
			RETURN 1
		ENDIF
		PRINTFORMW
		RETURN 1
	ENDIF
	;其他情况
	PRINTFORML
ENDIF
RETURN 1

