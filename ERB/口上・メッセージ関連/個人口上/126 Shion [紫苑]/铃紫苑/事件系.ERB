@M_KOJO_铃紫苑_EVENT_K126_2(ARG,ARG:1)
;口上角色编号 = TARGET
;--------------------------------------------------
;启用（= 0, 非表示、1, 表示）
LOCAL = 1
;-------------

IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;非同居，对方先起床了
	;启用（= 0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		;-------------------------------------------------
		;地点在TARGET私室，MASTER在此处睡着了（恋慕时陪睡就寝才会触发？
		;启用（= 0, 非表示、1, 表示）
