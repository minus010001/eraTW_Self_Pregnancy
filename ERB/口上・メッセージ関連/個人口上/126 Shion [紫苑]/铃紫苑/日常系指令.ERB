LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF TALENT:126:7
		IF CFLAG:126:313;睡觉
			SELECTCASE RAND:2
				CASE 0
				PRINTFORML 你放轻动作在紫苑身边躺了下去，她侧身蜷着，裙摆微微上卷，露出了一点洁白的肌肤。
				PRINTFORML 你伸手去拉平那块布料，结果指尖刚碰到她温热的膝窝，紫苑就无意识地磨蹭了一下。
				PRINTFORML 你的手指躲闪不及，被她大腿和小腿的软肉给轻轻夹住了。 
				PRINTFORML ……
				PRINTFORMW 你最终选择顺其自然。。 
				CASE 1
				PRINTFORML 紫苑像被你的体温吸引一样，翻了个身。一点点把重量压在了你身上。
				PRINTFORML 虽然听起来很甜蜜，但实际上只是紫苑一边毫无形象地流着哈喇子一边把大腿横在你的身上而已。
				PRINTFORML 「嘿嘿……%CALLNAME:MASTER%……」
				PRINTFORML 她那带着些许潮意的呼吸一下又一下地扑在你的颈窝里，即便在睡梦中也呢喃着你的名字。
				PRINTFORMW ……或许这的确很甜蜜。
			ENDSELECT
		ELSE
			SELECTCASE RAND:4
				CASE 0
				PRINTFORML 「挪挪……挪挪……」
				PRINTFORML 紫苑偷偷往你这边蹭被发现了。
				PRINTFORML 「……只是想和%CALLNAME:MASTER%靠得更近一点而已。」
				PRINTFORML 「……不行吗？」
				PRINTFORML 你直接伸手，双臂环过紫苑的腰。她很瘦弱，你稍微一用力，她整个人就像猫一样被提溜了起来。
				PRINTFORML 「……呀！」
				PRINTFORML 然后你将她放到了你两腿之间。
				PRINTFORMW 「……虽然害羞，但开心还是占更多……」
				CASE 1
				PRINTFORML 紫苑坐在你两腿之间，背部放松地向后抵住你的胸口。时不时仰起脑袋，轻轻蹭过你的脸颊。
				PRINTFORML 「……嘻嘻，我的身高刚刚好呢。这样靠在%CALLNAME:MASTER%怀里的时候，正好能看清%CALLNAME:MASTER%所有的表情。」
				PRINTFORMW 「就是这种心心相印的感觉很棒啊，要是太矮的话……可就不像情侣，而是像父女了。」
				CASE 2
				PRINTFORML 「那个……%CALLNAME:MASTER%？我能试试给你按摩吗？」
				PRINTFORML 在紫苑一反常态的坚持下，你半推半就地接受了她按摩的申请。
				PRINTFORML 她跪坐在你身后，白嫩的脚趾因为紧张而交替勾动着，因为过于兴奋还喘着粗气。
				PRINTFORML 「…因为，这个在新娘修行手册里有嘛，慰劳辛劳了一天的丈夫什么的，嘿嘿……%CALLNAME:MASTER%已经确定是我的丈夫了对吧？」
				PRINTFORML 一滴不易察觉的冷汗从你的鬓角滑落，事到如今，你只能祈祷紫苑不要失手把你脖子右拧了。
				PRINTFORML 她的小手试探着按了上来。一下，两下……力道虽然有些生涩，却意外地沉稳。
				PRINTFORMW 那舒适的触感让你有些错愕。看来为了这一刻，她背地里真的对着那个手册练习了很久。
				CASE 3
				PRINTFORML 紫苑嘴里嚷着自己累了云云，在你身侧躺了下来
				PRINTFORML 尽管如此，她的双腿却一直支着，你的视角刚好可以看到她短裙内的风光。
				PRINTFORML 一件松松垮垮的内裤随意地挂在紫苑的大腿根部，边缘处隐约能看见一点紫苑白嫩的馒头
				PRINTFORML 做得如此明显，就是笨蛋都能看出这是对男人的诱惑了
				PRINTFORMW 「呀……被发现了吗……？嘻嘻」 
			ENDSELECT
		ENDIF
	ELSEIF TALENT:126:3
		IF CFLAG:126:313;睡觉
			SELECTCASE RAND:3
				CASE 0
				PRINTFORML 紫苑睡得并不安稳。
				PRINTFORML 蜷缩的姿势让她看起来比平时小了一圈，脊背的曲线紧绷着，
				PRINTFORML 是心里有了什么心事吗？你看着她侧脸的轮廓线，心中不知作何想法。
				PRINTFORML 借着微光，能看到她紧闭的眼角溢出了一点亮晶晶的湿痕。她的嘴唇轻微地翕动，发出了模糊的音节。
				PRINTFORMW 「……%CALLNAME:MASTER%，不要走。」
				CASE 1
				PRINTFORML 紫苑似乎在梦里挣扎着想要抓住什么，睫毛颤抖得厉害。
				PRINTFORML 「%CALLNAME:MASTER%……」
				PRINTFORML 你似乎听到了很像你名字的音节，但谁知道呢？无论如何，紫苑与你不过一拳距离。
				CALL ASK_YN("拂去她的泪水","什么都不做")
				IF !RESULT
					PRINTFORMW 你用手掌摸了摸紫苑的脑袋，将那滴还没来得及滚落的泪轻轻抹去，她的呼吸渐渐平稳。直到贴着你的侧影重新安稳下来，那串模糊的梦呓才宣告平息。
					CALL CHANGE_CFLAG(2, 126, 20)
					CALL CHANGE_CFLAG(4, 126, 20)
				ELSE
					PRINTFORMW 你就这么静静地看着她。泪水在她的眼角聚集成小小的水珠，顺着脸颊缓慢滑落，最后没入发鬓。
				ENDIF
				CASE 2
				PRINTFORML 微风将她额前的碎发吹动，扫过了她恬静的睡颜。光线有些暗，你看见她的嘴唇，圆润湿润，显得格外诱人。
				PRINTFORML 你看了一会，默默转了过去，背对紫苑。
				PRINTFORML 但过了没多久，你感觉到身后有两只手臂慢慢伸了过来，绕过你的腰，轻轻贴上你的腹部。你晃了晃身体，想甩开，她反而抱得更紧了。
				PRINTFORMW 带着一丝好笑的无奈，你任由紫苑抱着，睡了一会。 
			ENDSELECT
		ELSE
			SELECTCASE RAND:3
				CASE 0
				PRINTFORML 紫苑现在已经演都不演了，你刚坐下，她就顺势歪过身子，靠在你身上求抱抱。
				PRINTFORML 「唔~」
				PRINTFORML 见你没有立刻回抱或者给出回应，她有些不满地鼓起了脸颊，目光斜斜地盯着地上的影子。
				PRINTFORML 「之前明明是%CALLNAME:MASTER%即便再怎么被拒绝也要贴上来的。」
				PRINTFORMW 「都已经把……我的心给夺走了，还想自顾自地远离什么的……天底下可没有这么方便的事。」
