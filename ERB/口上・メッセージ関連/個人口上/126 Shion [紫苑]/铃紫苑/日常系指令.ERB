;-------------------------------------------------
;启用（= 0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE TFLAG:193
		CASE -2
			PRINTFORML 「%CALLNAME:MASTER%……？你的样子是不是有点奇怪？」
			PRINTFORML 紫苑被你吓得缩了缩肩膀。
			PRINTFORML 你此刻的视线死死锁在笼里乱窜的%MUSHI_NAME%上，眼球边缘爬上了几道细碎的血丝。
			PRINTFORML 「我说……这就只是个虫子而已哦」
			PRINTFORML 紫苑紧张地把东西往身后藏了藏，没想此举反而刺激了你，你大吼一声扑向紫苑……
			PRINTFORMW  在争斗中%MUSHI_NAME%趁机逃走了……
		CASE 0
			SELECTCASE RAND:9
				CASE 0
				PRINTFORMW 「要不去看看那边？」
				CASE 1
				PRINTFORMW 「咕奴奴……不至于连虫子都找不到吧！」
				CASE 2
				PRINTFORMW 「这个季节没有吗？」
				CASE 3
				PRINTFORMW 「感觉个头都有点微妙啊……」
				CASE 4
				PRINTFORMW 「年轻的贫穷神渴望找到巨物……」
				CASE 5
				PRINTFORMW 「捕虫……就是要想得开，挺得住！」
				CASE 6
				PRINTFORML 「不要翻石头，而是要去找青冈树和柳树这些会流汁液的树？」
				PRINTFORMW 「抓虫子也有这么多门道啊。」
				CASE 7
				PRINTFORML 「喂喂……我刚刚好像看见了什么球状的生命体一闪而过」
				PRINTFORMW 「那绝对不是虫子吧！！」
				;是垃圾
				CASE 8
				PRINTFORMW 「唔……到底为什么我要在这里找虫子……」
			ENDSELECT
		CASE 2
			SELECTCASE RAND:4
				CASE 0
				IF MUSHI_RARE >= 8
					PRINTFORML 「我可以留着吗？好耶——」
					PRINTFORMW 把虫笼收好后紫苑还兴奋地跟你聊虫子的成色、习性等等话题
				ELSE
					PRINTFORML 「诶？我自己留着……？」
					PRINTFORML 紫苑盯着掌心里那个低等虫豸，一脸不情愿地把它揣进怀里。
					PRINTFORML 好像连自己都不太理解为什么要这么做似的，她的视线在你和那个刚被藏起来的小玩意儿之间来回扫视。
					PRINTFORMW 「所以说……到底为什么要特意跑来抓虫子啊？」
				ENDIF
				CASE 1
				PRINTFORMW 「嘿嘿……你还别说，这些虫子挺好养活的。」
				CASE 2
				PRINTFORML 「%CALLNAME:MASTER%你知道吗？虫子中的高级种可以分化为强化种和集群种」
				PRINTFORML 「如果是强化种，就能觉醒更强的固有技能；如果是集群种，则会掌握群体攻击」
				PRINTFORMW 被紫苑灌输了幻想乡昆虫的知识……感觉完全是另一个次元的内容
				CASE 3
				PRINTFORML 「不对不对，明显是这只比那一只更好吧，虽然从面板上看那一只的力量更高，但在实战中往往是精密度更加重要」
				PRINTFORMW 紫苑似乎能够看到虫子的面板。
			ENDSELECT
		CASE 3
		PRINTFORMW 「啊……给你。反正……这种小东西，跟着我也只会死掉吧……」
		CASE 4	
		PRINTFORML 「看吧！这成色！这可是我抓到的哦！」
		PRINTFORMW 「但既然%CALLNAME:MASTER%那么想要……就送给%CALLNAME:MASTER%好了！ 要记得感谢我哦，嘿嘿。」
	ENDSELECT
ENDIF
RETURN 1
