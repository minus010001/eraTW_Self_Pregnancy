;==================================================
;140,深喉插入
;==================================================

@M_KOJO_铃紫苑_MESSAGE_MESSAGECHECK_COM_K126_140
RETURN 0

@M_KOJO_铃紫苑_MESSAGE_COM_K126_140
CALL M_KOJO_铃紫苑_MESSAGE_COM_K126_140_1
RETURN RESULT

@M_KOJO_铃紫苑_MESSAGE_COM_K126_140_1
;-------------------------------------------------
;启用（= 0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;初次使用
	;启用
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		PRINTFORMW 
		RETURN 1
	ENDIF
	;基本差分模板
	;恋慕
	IF TALENT:恋慕
		SELECTCASE RAND:6
			CASE 0
			PRINTFORML 上下的节奏伴着吸溜的黏腻声，紫苑的鼻息从均匀转促，喉间时不时滚动着，
			PRINTFORML 她的舌尖推动着唾液，抹匀了整个肉棒，深喉拉长着吞咽的声音。
			PRINTFORML 你沉浸在天国般的快感中……任由阴茎在湿热的包裹中跳动
			PRINTFORMW 「噗哈💗……嘿嘿……新娘修行时偷看的那些书……终于能实践了，好开心~」
			CASE 1
			PRINTFORML 「唔——啾噜……哈姆、噗啾啾~💗」
			PRINTFORML 紫苑献身般低头，舌头随着阴茎被完整吞入一圈圈卷绕向下，唾液被搅动着
			PRINTFORMW 口穴中发出含糊不清的液体搅拌声。
			CASE 2
			PRINTFORML 「滋溜滋溜……啾啾💗……」
			PRINTFORML 紫苑的深喉非常拼命，哪怕是俏鼻几乎要碰到你的肌肤，也不管不顾地将肉棒往深处吞咽
			PRINTFORML 有外物如此深入喉道，常人定会翻起强烈的呕吐感吧，可紫苑没有
			PRINTFORMW 有的只是身体扭动间的低吟哼声，和侍奉套弄的口水靡音
			CASE 3
			PRINTFORML 紫苑的蓝色发丝翻飞，全心全意地为你进行着深喉侍奉。
			PRINTFORML 诱人的小嘴短时间内便已吞吐数十次，黏腻湿热的唾液被反复涂抹，卷了一层又一层
			PRINTFORMW 你只有咬紧牙关忍耐才不至于马上在紫苑的口中喷发。
			CASE 4
			PRINTFORML 紫苑忘我地吞吐着肉根，舌身变换花样激烈搅拌着龟头
			PRINTFORML 因为害怕被抛弃而拼命锻炼出来的侍奉技法，覆盖了阴茎的每一寸肌肤
			PRINTFORMW 黏腻的水声传到你的耳朵里，煽动着你的情欲。
			CASE 5
			PRINTFORML 你难以忍耐心中高涨的欲望，按住紫苑的脑袋开始了抽插
			PRINTFORML 「唔嗯💗……！？」
			PRINTFORML 紫苑咳嗽一声后迅速反应过来，软滑舒适的舌头由主动转为了被动
			PRINTFORMW 迎合着你的动作，微微抬首让味蕾尽情享用你肉棒浓烈的气息。
		ENDSELECT
		RETURN 1
	;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORMW 
		RETURN 1
	;除此以外
	ELSE
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
RETURN 1

