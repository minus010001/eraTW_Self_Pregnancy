@M_KOJO_IRAI_K53(ROLE, SCENE, IRAI_ID)
#DIMS ROLE     ;角色の立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  IRAI_ID  ;依頼自体のID
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
#DIM  CHK_ID   ;依頼IDだけ抜き出したもの
CHK_ID    = IRAI_ID % 1000
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
SELECTCASE ROLE
CASE OPR_委托人
	;一般依頼
	IF IS_COMMON_IRAI(IRAI_ID)
		SELECTCASE STR_DATA_IRAI(IRAI_ID, OPR_委托名, CLIENT_ID)
		CASE "一般依頼名"
			SELECTCASE SCENE
			CASE OPR_委托提示时
			;依頼を持ちかけられる時
			CASE OPR_委托非受託时
			;内容だけ見て受託しなかった時
			CASE OPR_委托受託时
			;依頼を受託した時
			CASE OPR_委托确认时
			;[366]で依頼内容を依頼人に確認した時
			CASE OPR_委托破棄时
			;受託した依頼を破棄する時
			CASE OPR_委托实行直前
			;[367]で依頼を実行する時、実行処理の前に呼び出される
			CASE OPR_委托实行直后
			;[367]で依頼を実行する時、実行処理の後に呼び出される
			CASE OPR_成功报告时
			;報告時（成功）
			CASE OPR_失败报告时
			;報告時（失敗）
			;この他、報告忘れや期限切れで失敗扱いになり後日依頼人に遭遇した際にも表示
			ENDSELECT
		ENDSELECT
		RETURN
	ENDIF
	
	;固有依頼
	SELECTCASE STR_DATA_IRAI(IRAI_ID, OPR_委托名, CLIENT_ID)
	;个々の依頼名で分岐
	;SCENEのWAITに関する仕様
	;WAIT無しでよい　　　　：OPR_委托提示时, OPR_委托非受託时, OPR_委托确认时, OPR_委托破棄时, OPR_成功报告时, OPR_失败报告时
	;
	;以下の2つは実際にはCARRYOUTでの地の文処理との比較検討が必要
	;WAITを入れたほうが適切：OPR_委托实行直前, OPR_委托实行直后
	CASE "固有依頼名"
		SELECTCASE SCENE
		CASE OPR_委托提示时
		;依頼を持ちかけられる時
		CASE OPR_委托非受託时
		;内容だけ見て受託しなかった時
		CASE OPR_委托受託时
		;依頼を受託した時
		CASE OPR_委托确认时
		;[366]で依頼内容を依頼人に確認した時
		CASE OPR_委托破棄时
		;受託した依頼を破棄する時
		CASE OPR_委托实行直前
		;[367]で依頼を実行する時、実行処理の前に呼び出される
		CASE OPR_委托实行直后
		;[367]で依頼を実行する時、実行処理の後に呼び出される
		CASE OPR_成功报告时
		;報告時（成功）
		CASE OPR_失败报告时
		;報告時（失敗）
		;この他、報告忘れや期限切れで失敗扱いになり後日依頼人に遭遇した際にも表示
		ENDSELECT
	ENDSELECT
CASE OPR_目标
	;ここで表示されるSCENEはOPR_委托实行直前, OPR_委托实行直后だけです
	;一般依頼
	IF IS_COMMON_IRAI(IRAI_ID)
		SELECTCASE STR_DATA_IRAI(IRAI_ID, OPR_委托名, CLIENT_ID)
		;个々の依頼名で分岐してください
		CASE "一般依頼名"
		;人物が鍵になっていた・もしくは場所にたまたま居合わせた
			SELECTCASE SCENE
			;TARGETが呼ばれるのはこのタイミングだけ
			CASE OPR_委托实行直前
			CASE OPR_委托实行直后
			ENDSELECT
		ENDSELECT
		RETURN
	ENDIF
	SELECTCASE CSVCALLNAME(CLIENT_ID)
	;依頼者のCALLNAMEによる分岐（CSV準拠）
	CASE "依頼者"
		SELECTCASE STR_DATA_IRAI(IRAI_ID, OPR_委托名, CLIENT_ID)
		CASE "固有依頼名"
			SELECTCASE SCENE
			CASE OPR_委托实行直前
			CASE OPR_委托实行直后
			ENDSELECT
		ENDSELECT
	ENDSELECT
CASE OPR_无需报告
	;日数経過時、報告不要依頼を達成していた場合に呼ばれる口上
	;ここで表示されるSCENEはOPR_委托报告不要だけです
	;SCENEが一つしか無いので分岐は不要
	;また、必ず依頼主の口上が呼ばれます
	;一般依頼
	IF IS_COMMON_IRAI(IRAI_ID)
		SELECTCASE STR_DATA_IRAI(IRAI_ID, OPR_委托名, CLIENT_ID)
		;个々の依頼名で分岐してください
		CASE "一般依頼名"
		CASE "給花澆水"
		CASE "誰的遗失物"
		ENDSELECT
		RETURN
	ENDIF
	SELECTCASE STR_DATA_IRAI(IRAI_ID, OPR_委托名, CLIENT_ID)
	CASE "固有依頼名"
	ENDSELECT
ENDSELECT
