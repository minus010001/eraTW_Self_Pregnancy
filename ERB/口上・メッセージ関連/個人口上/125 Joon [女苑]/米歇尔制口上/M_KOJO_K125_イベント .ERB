;==================================================
;部屋で遭遇
;==================================================
@M_KOJO_米歇尔制口上_EVENT_K125_1(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;MASTERが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		IF TALENT:恋人
			PRINTFORMW 「啊、%CALLNAME:MASTER%…」
			PRINTFORMW 「稍等一下！」
			PRINTFORMW 女苑慌忙取出手镜、确认自己的仪容……
			PRINTFORMW 「这样就可以了」
			PRINTFORMW 「哎……别吓我一跳啊！」
		ELSEIF TALENT:恋慕
			PRINTFORMW 「哎呀？这不是%CALLNAME:MASTER%吗？」
			PRINTFORMW 「你来见我太方便了」
			PRINTFORMW 「你来应酬一下吧！」
			PRINTFORMW 女苑似乎很高兴……
		ELSEIF TALENT:思慕
			PRINTFORMW 「哎呀？这不是%CALLNAME:MASTER%吗？」
			PRINTFORMW 「来拜见我的美貌了吗？」
			PRINTFORMW 女苑对着高飞车笑着……
		ELSE
			PRINTFORMW 「哇、是%CALLNAME:MASTER%」
			PRINTFORMW 「别那么随便靠近我哦―」
			PRINTFORMW 女苑静静地挥着手……
			ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが入ってきた
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF TALENT:恋人
			PRINTFORMW 「你爱着的女苑酱来见面了哦」
			PRINTFORMW 女苑和%CALLNAME:MASTER%偎依在一起
			PRINTFORMW 「%CALLNAME:MASTER%、见到我很開心吧？」
			PRINTFORMW 回答说“当然了”后、女苑笑了
			PRINTFORMW 「嘛、当然了」
		  PRINTFORMW 「我也这么高兴」
		ELSEIF TALENT:恋慕
			PRINTFORMW 「啊、%CALLNAME:MASTER%到了！」
			PRINTFORMW 向声音的方向回头、女苑站了起来
			PRINTFORMW 「这个商品、不是我要找的」
			PRINTFORMW 被女苑用包包打了……
		ELSEIF TALENT:思慕
			PRINTFORMW 「哼哼、你这个笨蛋带着笑脸过来了」
			PRINTFORMW 女苑露出了坏心眼的笑容……
		ELSE
			PRINTFORMW 「只是转来转去、除了走路就没有其他娱乐了吗？」
			PRINTFORMW 女苑投以鄙夷的视线……
			ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて一緒に入る
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて出て行った
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 4
		PRINTFORMW 
		PRINTFORMW 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;TARGETが風呂に入ってきて追い出された
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 5
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;外出先で遭遇した
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 6
		IF TALENT:恋人
			PRINTFORMW 看到女苑后%CALLNAME:MASTER%打了招呼、她走了过来
			PRINTFORMW 「哦、是%CALLNAME:MASTER%」
			PRINTFORMW 「还是一如既往的開朗呢」
			PRINTFORMW 女苑看着%CALLNAME:MASTER%的脸笑着
			PRINTFORMW 看到那浮现欢乐笑容的女苑、%CALLNAME:MASTER%的脸颊也松缓下来
		ELSEIF TALENT:恋慕
			PRINTFORMW 突然、不知从哪里感觉到了视线……
			PRINTFORMW 环顾四周、发现了在背阴处凝视着这边的女苑
			PRINTFORMW 「哈～？我又不是在看你啊？」
			PRINTFORMW 女苑局促不安地说……
		ELSEIF TALENT:思慕
			PRINTFORMW 「哎呀？这不是%CALLNAME:MASTER%吗？」
			PRINTFORMW 「……总觉得讨厌的表情！！」
			PRINTFORMW 女苑愤怒地向这边走来……
		ELSE
			PRINTFORMW 「等一下！不要靠近我」
			PRINTFORMW 「你觉得我像是和你有关系的人吗？」
			PRINTFORMW 女苑吹毛求疵地进行挑剔……
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;他角色と约会中に遭遇した
	;ARG:1に约会的对象
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 7
		IF TALENT:恋人
			PRINTFORMW 「咦？%CALLNAME:MASTER%那是……」
			PRINTFORMW 刚发现%CALLNAME:MASTER%旁边的少女时、女苑的表情就冻住了
			PRINTFORMW 嘴巴像金鱼一样咕噜咕噜地动了一会儿
			PRINTFORMW 不久就像逃跑似的离開了……
		ELSEIF TALENT:恋慕
			PRINTFORMW 「……………」
			PRINTFORMW 女苑一边看着这边一边開始影子拳击
			PRINTFORMW 不知是不是出于心理作用、她的视线似乎集中在旁边的少女身上……
		ELSEIF TALENT:思慕
			PRINTFORMW 「……………」
			PRINTFORMW 女苑一边看着这边一边開始影子拳击…
		RETURN 1
		ENDIF
	ENDIF
ENDIF
RETURN 1
