;==================================================
@K125_BEFORETRAIN_米歇尔制口上
;是否启用（= 0，不启用；= 1，启用）
LOCAL = 1
;-------------
IF LOCAL
	IF CFLAG:神社在住
		RETURN 0
	ELSE
		IF CFLAG:125:1003 == 1
			CFLAG:362 = 1
		ELSE
			RETURN 0
		ENDIF
	ENDIF
ENDIF
RETURN 0


