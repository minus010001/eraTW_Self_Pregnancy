@M_KOJO_IRAI_K124(ROLE, SCENE, IRAI_ID)
#DIMS ROLE     ;角色の立場、依頼者かそうでないか
#DIMS SCENE    ;セリフの表示されるタイミング
#DIM  IRAI_ID  ;依頼自体のID
#DIM  CLIENT_ID;依頼者IDだけ抜き出したもの
#DIM  CHK_ID   ;依頼IDだけ抜き出したもの
CHK_ID    = IRAI_ID % 1000
CLIENT_ID = IRAI_ID_TO_CLIENT(IRAI_ID)
SELECTCASE ROLE
CASE OPR_委托人
	;一般依頼
	IF IS_COMMON_IRAI(IRAI_ID)
		SELECTCASE STR_DATA_IRAI(IRAI_ID, OPR_委托名, CLIENT_ID)
		CASE "一般依頼名"
			SELECTCASE SCENE
			CASE OPR_委托提示时
			PRINTFORMW 「%CALLNAME:MASTER%哟，能不能稍微拜托我帮个忙？」
			;依頼を持ちかけられる時
			CASE OPR_委托非受託时
			PRINTFORMW 「什么啊，现在很忙吗？那么，下次再拜托你吧」
			;内容だけ見て受託しなかった時
			CASE OPR_委托受託时
			PRINTFORMW 「那就拜托你了。千万不要出什么差错啊！」
			;依頼を受託した時
			CASE OPR_委托确认时
			PRINTFORMW 「拜托你的事情如下。别忘了啊？」
			;[366]で依頼内容を依頼人に確認した時
			CASE OPR_委托破棄时
			PRINTFORMW 「诶ー？不行吗？没办法啊…」
			;受託した依頼を破棄する時
			CASE OPR_委托实行直前
			;[367]で依頼を実行する時、実行処理の前に呼び出される
			CASE OPR_委托实行直后
			;[367]で依頼を実行する時、実行処理の後に呼び出される
			CASE OPR_成功报告时
			PRINTFORMW 「哦哦，做得很好。呵呵呵，看来拜托你是对的！」
			;報告時（成功）
			CASE OPR_失败报告时
			;報告時（失敗）
			;この他、報告忘れや期限切れで失敗扱いになり後日依頼人に遭遇した際にも表示
				PRINTFORML 「%CALLNAME:MASTER%，之前托你办的事……」
				PRINTFORML 「我还以为你会帮我做呢。看来是我估计错了啊」
				PRINTFORMDW 隐岐奈失望地大叹了一口气。
			ENDSELECT
		ENDSELECT
		RETURN
	ENDIF
CASE OPR_目标
	;ここで表示されるSCENEはOPR_委托实行直前, OPR_委托实行直后だけです
	;一般依頼
	IF IS_COMMON_IRAI(IRAI_ID)
		SELECTCASE STR_DATA_IRAI(IRAI_ID, OPR_委托名, CLIENT_ID)
		;个々の依頼名で分岐してください
		CASE "一般依頼名"
		;人物が鍵になっていた・もしくは場所にたまたま居合わせた
			SELECTCASE SCENE
			;TARGETが呼ばれるのはこのタイミングだけ
			CASE OPR_委托实行直前
			CASE OPR_委托实行直后
			ENDSELECT
		ENDSELECT
		RETURN
	ENDIF
	SELECTCASE CSVCALLNAME(CLIENT_ID)
	;依頼者のCALLNAMEによる分岐（CSV準拠）
	CASE "依頼者"
		SELECTCASE STR_DATA_IRAI(IRAI_ID, OPR_委托名, CLIENT_ID)
		CASE "固有依頼名"
			SELECTCASE SCENE
			CASE OPR_委托实行直前
			CASE OPR_委托实行直后
			ENDSELECT
		ENDSELECT
	ENDSELECT
CASE OPR_无需报告
	;日数経過時、報告不要依頼を達成していた場合に呼ばれる口上
	;ここで表示されるSCENEはOPR_委托报告不要だけです
	;SCENEが一つしか無いので分岐は不要
	;また、必ず依頼主の口上が呼ばれます
	;一般依頼
	IF IS_COMMON_IRAI(IRAI_ID)
		SELECTCASE STR_DATA_IRAI(IRAI_ID, OPR_委托名, CLIENT_ID)
		;个々の依頼名で分岐してください
		CASE "一般依頼名"
		CASE "給花澆水"
		CASE "誰的遗失物"
		ENDSELECT
		RETURN
	ENDIF
	SELECTCASE STR_DATA_IRAI(IRAI_ID, OPR_委托名, CLIENT_ID)
	CASE "固有依頼名"
	ENDSELECT
ENDSELECT
