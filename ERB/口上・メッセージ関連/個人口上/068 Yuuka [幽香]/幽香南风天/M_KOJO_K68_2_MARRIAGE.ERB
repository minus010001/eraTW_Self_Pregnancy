;==================================================
;求婚剧本
;--------------------------------------------------
;COM13（求婚）的剧本
;TFLAG:193 == 0 时为求婚失败，否则为求婚成功
;==================================================
@M_KOJO_幽香南风天_MESSAGE_CUSTOM_COM_K68_13
PRINTFORMDW 约会途中，你突然停下脚步，拿出订婚戒指向%CALLNAME:TARGET%求婚。
IF TFLAG:193 == 0
	;-------------------------------------------------
	;求婚失败
	;-------------------------------------------------
	LOCALS = 「求婚？哈哈哈哈哈……」
	CALL SPTALK, TARGET, "通常", 0, LOCALS, 1
	PRINTFORMDL 幽香仿佛看到天大的玩笑
	LOCALS = 「虽然和%CALLNAME:MASTER%玩恋爱游戏很开心，但那只是游戏人间罢了/你从未真正了解过我，回去吧，小心别再陷进我编织的幻境里」
	CALL SPTALK, TARGET, "通常", 0, LOCALS, 1
	PRINTFORMDL 幽香的指尖妩媚地抚过你的脸，然后带走所有曾经萦绕在你身边的香气，消失了
	PRINTFORMW
	PRINTFORMDL 但是%HE_SHE(TARGET)%拒绝了。
	IF TALENT:恋慕 < 2
		PRINTFORMDW 也许%HE_SHE(TARGET)%对你的感情还不够深。
	ELSEIF MARK:反発刻印
		PRINTFORMDW %HE_SHE(TARGET,1)%对你之前做过的事仍然耿耿于怀。
	ELSEIF TALENT:機嫌 < 0
		PRINTFORMDW 你应该多注意一下%HE_SHE(TARGET)%的心情。
	ELSEIF CFLAG:ブチギレ
		PRINTFORMDW %HE_SHE(TARGET,1)%显然正在气头上，不可能答应。
	ENDIF
ELSE
	;-------------------------------------------------
	;求婚成功
	;-------------------------------------------------
	LOCALS = 「求求求…求婚！」
	CALL SPTALK, TARGET, "照れ", 0, LOCALS, 1
	PRINTFORMDL 明明是那样的大妖怪，阅尽世间一切，此刻活脱脱娇羞的少女一枚
	PRINTFORMDL 「对，婚礼是外界的一种仪式，既是向外人宣告二人的感情，也是夫妻关系的重要纪念点」
	PRINTFORMDL 你不顾已经变成蒸汽姬的幽香，继续添砖加瓦地描述着婚礼
	PRINTFORMDL 「可以按我们的想法举办一场婚礼哦，穿上专门的婚礼仪式服装，相爱的我们在众人的簇拥下走到台前，然后宣誓和轻吻」
	PRINTFORMDL 「幽香你喜欢哪种衣服？什么风格的呢？」
	PRINTFORML
	PRINTFORMDL 「当然，你要是觉得繁琐也没关系，只是个仪式罢了、反正我们已经过上了婚后日子」
	LOCALS = 「要婚礼，当然要婚礼！！」
	CALL SPTALK, TARGET, "笑顔", 0, LOCALS, 1
	PRINTFORMDL 幽香整个妖精甜蜜地和你黏在一起
	LOCALS = 「如果连我们的爱情都不举行婚礼，神社就没有这业务收入了/为了守护幻想乡的婚恋仪式，绝对要举行婚礼啊，还得是超巨大规模的那种！」
	CALL SPTALK, TARGET, "笑顔", 0, LOCALS, 1
	LOCALS = 「当然…最重要的还是想和%CALLNAME:MASTER%牵手走过礼堂……」
	CALL SPTALK, TARGET, "照れ", 0, LOCALS, 1
	PRINTFORMDL 「嗯」
	PRINTFORMDL 你郑重地点了头，牵起幽香的手

ENDIF
RETURN 1

;==================================================
;婚礼准备剧本
;--------------------------------------------------
;ARGS参数：
;  "TYPE"   — 选择婚礼场地类型时
;  "SIZE"   — 决定婚礼规模（宾客人数）时
;  "DATE"   — 决定婚礼日期时
;  "GUESTS" — 确认宾客名单时
;==================================================
@M_KOJO_幽香南风天_EVENT_K68_WEDDING_PREPARATIONS(ARGS, ARG, ARG:1)
#LOCALSIZE 1
#LOCALSSIZE 1
SELECTCASE ARGS
	CASE "TYPE"
		PRINTFORMDL 当你谈论起婚礼的布置时，幽香有前所未有的兴致
		PRINTFORMDL 看来她似乎找到了一种能和种花媲美的爱好
		PRINTFORMDL 不过只限这一次，毕竟婚礼也不能天天办（笑），也许以后会开个婚庆公司？
		PRINTFORMDL 婚礼地点？除了太阳花田还能是哪里
		PRINTFORMDL 为了婚礼流程，这几天你们全部进入加班环节
		PRINTFORMDL 幽香亲自出手准备婚礼用花（除了她没人能提供这么多，除了她也没人用这么多），花田的布局和温室系统也要调控
		PRINTFORMDL 胡桃负责写请帖，幻月几人布置场地累得快冒烟了
		PRINTFORMDL 拉尔瓦负责召集妖精乐团和妖精伴娘
		WEDDING_TYPE = "FAIRY"
		LOCALS = 「还有一件事！我们还没给婚礼定名字呢/没这个，胡桃的请帖可写不了/来，给我们的婚礼取个名字吧」
		CALL SPTALK, TARGET, "通常", 0, LOCALS, 1
		PRINTFORMDL 点击默认名或者输入你喜欢的名称
		PRINTBUTTON "[太阳花田婚礼]","太阳花田婚礼"
		PRINTL
		INPUTS
		IF RESULTS != ""
			LOCALS = 「%RESULTS%……嗯，不错呢/敲定用这个名字了吗？」
			CALL SPTALK, TARGET, "笑顔", 0, LOCALS, 1
		ELSE
			LOCALS = 「不取名字吗？那胡桃的请帖就写太阳花田婚礼好了」
			CALL SPTALK, TARGET, "通常", 0, LOCALS, 1
		ENDIF

	CASE "SIZE"
		PRINTFORMD 规模：
		IF !WEDDING_SIZE
			CALL COLORMESSAGE("[未定]", C_RED, 1)
		ELSE
			SELECTCASE WEDDING_SIZE
				CASE IS > 50
					PRINTFORMDL [盛大] 婚礼，可容纳{WEDDING_SIZE}位来宾。
					LOCALS = 「就是这样，和你的婚礼我要做到最盛大/让整个幻想乡都为之侧目」
					CALL SPTALK, TARGET, "笑顔", 0, LOCALS, 1
				CASE 50
					PRINTFORMDL [超大型] 婚礼，可容纳{WEDDING_SIZE}位来宾。
					LOCALS = 「很不错哦，让所有我们想邀请的宾客都能来/所有我们关于婚礼的设计都将实现」
					CALL SPTALK, TARGET, "笑顔", 0, LOCALS, 1
				CASE IS >= 30
					PRINTFORMDL [大型] 婚礼，可容纳{WEDDING_SIZE}位来宾。
					LOCALS = 「外界的婚礼就是这样的吧/好期待和你一起走过婚毯」
					CALL SPTALK, TARGET, "笑顔", 0, LOCALS, 1
				CASE IS >= 15
					PRINTFORMDL [中型] 婚礼，可容纳{WEDDING_SIZE}位来宾。
					LOCALS = 「感觉会很温馨呢，只用把在乎的人邀请来就行/没有交集的家伙，来再多也只是多余/和我们所珍爱的人一起…我的心砰砰跳了呢」
					CALL SPTALK, TARGET, "照れ", 0, LOCALS, 1
				CASEELSE
					PRINTFORMDL [小型] 婚礼，可容纳{WEDDING_SIZE}位来宾。
					LOCALS = 「水不在深，有龙则灵/和你在一起，有花田的大家/我真的很满足呢」
					CALL SPTALK, TARGET, "通常", 0, LOCALS, 1
					PRINTFORMDL 不过场地有限，花田的大家不一定都能入席呢
			ENDSELECT
		ENDIF
		PRINTFORML
	CASE "DATE"
		IF WEDDING_DATE < DAY + (MARRIAGE_DEBUG ? 1 # 2)
			VARSET WEDDING_DATE
			VARSET WEDDING_TIME
		ENDIF

		IF !WEDDING_DATE
			CALL COLORMESSAGE("[未定]", C_RED, 1)
		ELSE
			PRINTFORMDL [%PRINT_DATE_F(WEDDING_DATE)% %TWENTY_FOUR_TIME(WEDDING_TIME)%。]
		ENDIF
		LOCALS = 「具体的日期就是这天吗？/天气不用考虑，反正用温室系统」
		CALL SPTALK, TARGET, "通常", 0, LOCALS, 1
	CASE "GUESTS"
		LOCALS = 「在准备宾客名单？/太阳花田的几位就不用重复了，都是一家人、远方的朋友的话…我邀请了慧音和圣白莲，也许还要带上四季？」
		CALL SPTALK, TARGET, "通常", 0, LOCALS, 1
		LOCALS = 「%CALLNAME:MASTER%有想邀请的朋友可千万不要忘记，这么难得的场合每位人的祝福都很重要」
		CALL SPTALK, TARGET, "笑顔", 0, LOCALS, 1
		IF WEDDING_SIZE <= 10
			PRINTFORMDL 场地有限，只能邀请少数最亲近的人
		ENDIF
		PRINTFORML
ENDSELECT
RETURN 1

;==================================================
;自定义婚礼仪式
;--------------------------------------------------
;完全自定义的婚礼叙事，可以编写独特的婚礼场景
;ARGS为空字符串，口上需自行编写完整仪式流程
;==================================================
@M_KOJO_幽香南风天_EVENT_K68_CUSTOM_WEDDING(ARGS, ARG, ARG:1)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC GUEST_COUNT
#DIM DYNAMIC GUEST_IDX
#DIM DYNAMIC L_LOOP

;计算宾客人数
IF EXISTVAR("WEDDING_GUESTS")
	FOR LOCAL, 0, CHARANUM
		SIF GETVAR(@"WEDDING_GUESTS:{LOCAL}")
			GUEST_COUNT++
	NEXT
ENDIF

;换装
CALL OKIGAE(MASTER, [[婚礼套装]])
CALL OKIGAE(TARGET, [[婚紗套]])

;开始前，你和宾客闲聊       幽香换衣服
CALL PRINTLINE, "-- 太阳花田·婚礼现场 ", ,1
PRINTFORMDL 平日里参加茶会，晚上陪幽香散步，工作侍弄花草、你可堪太阳花田的第二位主人、但今天你陌生地有些意外
PRINTFORMDL 明明只是在原有布局上加了婚礼布置，连那装饰的花卉都是你和幽香亲手种下的
PRINTFORMDL 此刻都蒙上了爱和仪式的纱，变得模糊，乃至带上庄严的气息
PRINTFORMDL 前来的好友看出了你的紧张，主动和你搭话
PRINTFORMDL
;宾客互动循环
L_LOOP = 1
WHILE L_LOOP
	FOR GUEST_IDX, 0, CHARANUM
		SIF !WEDDING_GUESTS:GUEST_IDX
			CONTINUE
		SIF GUEST_IDX == LEGAL_SPOUSE
			CONTINUE
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMDL %CALLNAME:GUEST_IDX%祝福你道：
			CASE 1
				PRINTFORMDL %CALLNAME:GUEST_IDX%和你攀谈道：
			CASE 2
				PRINTFORMDL %CALLNAME:GUEST_IDX%和你闲聊道：
		ENDSELECT

		SELECTCASE RAND:5
			CASE 0
				CALL CHARA_TEXT(GUEST_IDX, "「回忆当初你和幽香第一次见面，我就觉得你俩有种般配感」", "l")
				CALL CHARA_TEXT(GUEST_IDX, "「天作之合的一对终于举办婚礼了，很荣幸参加你们的婚礼哦」", "l")
			CASE 1
				CALL CHARA_TEXT(GUEST_IDX, "「会场布置得真不错，你们花了不少心思吧」", "l")
				CALL CHARA_TEXT(GUEST_IDX, "「真期待过会幽香亮相，话说你们选了那种款式的婚服？不不不，还是别现在告诉我」", "l")
				CALL CHARA_TEXT(GUEST_IDX, "「还是留些悬念，过会让我自己看吧」", "l")
			CASE 2
				CALL CHARA_TEXT(GUEST_IDX, "「肯定很激动吧，唉…真羡慕幽香，你俩的甜蜜生活在幻想乡都是出名的」", "l")
				CALL CHARA_TEXT(GUEST_IDX, "「也不知道我的伴侣能不能这么爱我」", "l")
			CASE 3
				CALL CHARA_TEXT(GUEST_IDX, "「过会我们会祝福你们的，送上最真挚的祝福，毕竟你和幽香可是我最看好的cp」", "l")
				CALL CHARA_TEXT(GUEST_IDX, "「真谢谢你邀请我，为此我可是连今天的安排都推了」", "l")
			CASE 4
				CALL CHARA_TEXT(GUEST_IDX, "「太阳花田上次这么大规模开放是啥时候来着？平时都是在外围，今天终于能好好参观里面了」", "l")
				CALL CHARA_TEXT(GUEST_IDX, "「哇塞，正餐前的茶点都这么丰富」", "l")
		ENDSELECT
	NEXT

	CALL ASK_M("继续招待客人", 1, "聊够了", 1)
	SIF RESULT == 1
		L_LOOP = 0
WEND

PRINTFORMW
PRINTFORMDL 在你应酬宾客的时候，幽香正在梦幻馆里着装
PRINTFORMDL 沐浴完毕的幽香坐在椅子上接受着梦月和幻月的服侍，今天作为主角的她不能像往常那样干练地动手，尽力压制住不安分的手指
CALL SPTALK, 116, "笑顔", 0, @"「幽香姐你别担心，时间还早着呢」", 1
LOCALS = 「嗯……」/（心跳的好快，只是个仪式为什么我控制不住）
CALL SPTALK, TARGET, "照れ", 0, LOCALS, 1
PRINTFORMDL 语气里掩不住的紧张
PRINTFORMDL 吹干头发，跳过香水步骤从里到外穿上婚衣，一层层如鲜花片片绽开
PRINTFORMDL 全身镜前的幽香看呆了，明明是之前试穿过的衣服啊
PRINTFORMDL 最后检查完衣服的固定系带，幻月拿来首饰盒，有些是以前攒下的，有些是%CALLNAME:MASTER%送的
PRINTFORMDL 一环精雕银丝手镯白不过佳人肤，脖颈处珍珠宝石缀成的项链映得光彩夺目，塑完型的发型里点缀发叉，唯独青葱十指————留给那人的戒指
PRINTFORMDL 画上淡妆，最后披上妖精织出的妖精魔法纱，大功告成
PRINTFORMDL 梦月幻月绕着幽香转圈，检查细节的同时不免也暗自期待自己未来的婚礼
DRAWLINE
PRINTFORMW

;花田入场，幽香从别墅出发到花田，你在花田会场门口等
PRINTFORMDL 哒哒哒，妖精侍从从梦幻馆跑来，告知你和司仪拉尔瓦新娘已着装完毕
PRINTFORMDL 正是原安排的时间，恰到好处，太阳光线明亮柔和而不刺眼，微风卷起太阳花花海翻腾，场地正当时
PRINTFORMDL 司仪拉尔瓦当即宣布开始，你接过艾麗递来的花束，按妖精传统过会要和幽香交换用
PRINTFORMDL 迎在太阳花田会场的入口，妖精乐队演奏起欢庆的音乐，同时梦幻馆的大门打开
PRINTFORMDL 美，美的不可方物
PRINTFORMDL 背景乐主动配合脚步踩点，地毯左右的太阳花未曾偏移过视线
PRINTFORMDL 走过地毯的幽香每一步都踩在你的心口，背后宾客的欢呼声和乐队的声音逐渐远去
PRINTFORMDL 所有的一切都不在重要，注意力只留给爱人便好，满堂兮美人，唯与余兮目成
PRINTFORMDL 直到幽香已走完过道，站在会场的结界前
DRAWLINE
PRINTFORMW

;高潮点1，你牵手开门和她一起走
PRINTFORMDL 所谓人生得意时，莫过于此了吧
PRINTFORMDL 你掀开结界的大门，和心心念念的幽香注视，妖精纱下鲜艳的红唇突破面纱的遮掩
LOCALS = 「笨蛋…忍住现在亲我」
CALL SPTALK, TARGET, "発情", 0, LOCALS, 1
PRINTFORMDL 你们交换手中的花束（虽然两束都是向日葵），十指相缠走向拉尔瓦方向
PRINTFORMDL 左右的朋友们欢呼着，妖精们飞在你们上空挥洒着妖精尘，手心的体温跃动着
DRAWLINE
PRINTFORMW

;司仪讲话，誓词回应
PRINTFORMDL 你和幽香携手扔出手中受祝福的花束，不知被哪个人抢到
PRINTFORMDL 之后拉尔瓦开始念起妖精的祝福文，明明只是站着听，紧张感贯穿了你
PRINTFORMDL 自己可是新郎啊，还是太阳花田的主场，空的左手冒出冷汗，握着的右手抖地还要…厉害…唉？
PRINTFORMDL 幽香怎么比我还激动
PRINTFORMDL 无惧一切的花田暴君，我的爱人幽香啊，你爱我更甚
LOCALS = 「……妖精生于自然，终于自然，天地已经感受到你们真挚的爱，赐下美好的祝福」
CALL SPTALK, 118, "通常", 0, LOCALS, 1
LOCALS = 「现在，新生的夫妻啊，你们有什么要在自然母亲的注视下说的吗？」
CALL SPTALK, 118, "通常", 0, LOCALS, 1
CALL ASK_M("向幽香示爱", 1, "好紧张，不节外生枝了", 1)
SELECTCASE RESULT
	CASE 0
		PRINTFORMDL 在拉尔瓦的点头下你开始演讲，作为司仪的她已经计划怎么救场意外了，幽香则期待你
		PRINTFORMDL 「我从未觉得爱是如此强大的力量，它比喜怒哀乐要持久，久到一辈子还不够；比最奔涌的江河还汹涌，爱起来不讲一点逻辑和苦难」
		PRINTFORMDL 「爱也是最广阔的力量，跨越了种族间的距离，让我敬畏起人生也让我有胆子站在这里」
		PRINTFORMDL 「我爱你幽香，超越了可观测的时空和次元，我爱你」
		PRINTFORMDL 坐下的宾客都被你的表白感动，不少前来的情侣的双手不知何时已紧紧地握住
		PRINTFORMW
		LOCALS = 「我爱你，%CALLNAME:MASTER%/我风见幽香，魔界混战都从未仿徨之人，现在被爱所颤栗/我宣誓必将守护珍爱的一切」
		CALL SPTALK, TARGET, "発情", 0, LOCALS, 1
		PRINTFORMDL 「我%CALLNAME:MASTER%宣誓会照顾好我所爱的太阳花田」
	CASE 1
		PRINTFORMDL 你和幽香默契地选择跳过，这本就是传统里可有可无的环节，更别提你们紧张得不行
		PRINTFORMDL 生怕嘴瓢或多念一个错字，玷污这庄严的时刻
ENDSELECT
PRINTFORMDW

;亲吻
LOCALS = 「新郎，现在你可以轻吻新娘了」
CALL SPTALK, 118, "通常", 0, LOCALS, 1

LOCALS = 你捻起婚纱的左右角，缓缓上抬<br><br>月下花田花上月 风前佳偶偶迎风<br>今朝有幸得此卿 不羡鸳鸯不羡仙
CALL IMG_TALK, "颜68AS06MARKIV_服躯_服_头纱", LOCALS, 0, 1, (默认角色画像横幅 * 角色画像表示尺寸比) / 100, HEX_TO_HTML_COLOR(GETDEFCOLOR())
PRINTFORMW
CALL SPTALK, TARGET, "愛撫", 0, "「……啾」", 1
PRINTFORMDL 才掀开面纱，红唇主动吻了上来，嗯，典型的幽香风格
PRINTFORMDL 你们二人吻在一起，唇齿间的吻无比有力，要把所有的一切都吻给对方
PRINTFORMDL 宾客起身鼓掌，早就按耐不住的妖精们得到信号，跳起妖精们的舞蹈来
PRINTFORMDL 多么美妙的时刻，你和幽香这辈子都无法忘记吧
DRAWLINE
TIME += 240
RETURN 1

