;==================================================
@M_KOJO_幽香南风天_EVENT_K68_WEDDING(ARGS, ARG, ARG:1)
#LOCALSIZE 1
#LOCALSSIZE 1
SELECTCASE WEDDING_TYPE
	CASE "WESTERN"
		SELECTCASE ARGS
			CASE "AISLE_WALK"
				;新娘入场
				PRINTFORML
			CASE "I_DO"
				;誓词回应
				PRINTFORML
			CASE "KISS"
				;亲吻
				PRINTFORML
		ENDSELECT
		RETURN 1
	CASE "JAPANESE"
		SELECTCASE ARGS
			CASE "AISLE_WALK"
				;参入・修祓・致辞
				PRINTFORML
			CASE "I_DO"
				;誓词
				PRINTFORML
			CASE "KISS"
				;三献仪・亲吻
				PRINTFORML
		ENDSELECT
		RETURN 1
	CASE "FAIRY"
		SELECTCASE ARGS
			CASE "AISLE_WALK"
				;花田入场
				PRINTFORML
			CASE "I_DO"
				;誓词回应
				PRINTFORML
			CASE "KISS"
				;亲吻
				PRINTFORML
		ENDSELECT
		RETURN 1
ENDSELECT
RETURN 1

;==================================================
;自定义婚礼检查
;--------------------------------------------------
;ARGS参数：
;  "EXISTS"   — 返回自定义婚礼的名称（RESULTS），不写则使用标准婚礼
;  "COST"     — 返回自定义婚礼的费用（RESULT）
;  "LOCATION" — 返回自定义婚礼的场地编号（RESULT）
;==================================================
@M_KOJO_幽香南风天_CHECK_K68_CUSTOM_WEDDING(ARGS, ARG, ARG:1)
#LOCALSIZE 1
#LOCALSSIZE 1
SELECTCASE ARGS
	CASE "EXISTS"
		RESULTS = 太阳花田妖精式婚礼
		RETURN 1
	CASE "COST"
		LOCALS = 「明明都是一个被窝的人了还分什么费用啊」
		CALL SPTALK, TARGET, "笑顔", 0, LOCALS, 1
		IF MONEY < 1500000
			LOCALS = 「你缴费也是左手进右手，别管了，快来帮我选婚纱」
			CALL SPTALK, TARGET, "笑顔", 0, LOCALS, 1
			CALL ASK_M("吃软饭", 1, "男儿当自强", 1)
			SELECTCASE RESULT
				CASE 0
					PRINTFORMDL 唉，我牙口不好，只能吃软饭，但是幽香的软饭香甜，不吃不行
					RETURN 0
				CASE 1
					LOCALS = 「略略略…随便你，反正钱对我来说只是个数字，我筹备流程去了」
					CALL SPTALK, TARGET, "笑顔", 0, LOCALS, 1
			ENDSELECT
		ELSE
			PRINTFORMDL 「不行！要是一直吃幽香你的软饭的话…我可是会堕落的啊！」
			LOCALS = 「略略略…随便你，反正钱对我来说只是个数字，我筹备流程去了」
			CALL SPTALK, TARGET, "笑顔", 0, LOCALS, 1
			PRINTFORMDL （笨蛋，偏偏我就是喜欢你这股死脑筋劲啊，回头嫁妆准备什么好呢）
		ENDIF
		RETURN 1500000
	CASE "LOCATION"
		IF RESULT == P438太陽花田
			LOCALS = 「场地还要点时间，我还在修缮中，毕竟这可是太阳花田首次招待这么多宾客」
			CALL SPTALK, TARGET, "通常", 0, LOCALS, 1
		ENDIF
		RETURN P438太陽花田
ENDSELECT
RETURN 0

