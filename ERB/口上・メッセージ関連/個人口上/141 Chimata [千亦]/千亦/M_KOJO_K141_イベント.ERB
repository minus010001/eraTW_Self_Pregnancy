;==================================================
;贈り物イベント
;==================================================
@M_KOJO_ARIMA_EVENT_K141_GIFT(ARG, GIFT_ID, 評価点, GIFT_NAME, SENSE)
#DIM GIFT_ID
#DIM 評価点
#DIMS GIFT_NAME
#DIMS SENSE
;---------------------------------------------------------------------------------------------------
;評価点       贈り物の評価点（1～999）,口上主があげた場合でも口上主の評価点
;GIFT_NAME    贈り物の名称
;SENSE        贈り物に設定された属性。STRCOUNT(SENSE, "ほげほげ/")を使うと特定の属性を判定できます。
;GIFT_ID      これ単体では使いません。以下の式内関数を使うとデータを抽出できます（こだわりたい人用）
;　GET_GIFTDATA(GIFT_ID, "回数")    貰った（あげた）回数
;　GET_GIFTDATA(GIFT_ID, "得点")    得点（1～999）,口上テンプレ内では用意されてます。
;　GET_GIFTDATA(GIFT_ID, "日付")    貰った（あげた）日付（1～9999）
;　GET_GIFTDATA(GIFT_ID, "場所")    買った場所（デートの行き先）
;　GET_GIFTDATA(GIFT_ID, "形容詞")  形容詞番号（贈り物_形容詞.erb参照）
;　GET_GIFTDATA(GIFT_ID, "本体")    本体番号（贈り物_本体.erb参照）
;--------------------------------------------------------------------------------------------------
;デート帰りに口上主があなたに贈り物を渡す（陥落や好感度に関わらず親密5以上から発生）
;評価点は701～999（渡すキャラ本人の評価）
;--------------------------------------------------------------------------------------------------
IF ARG == 1 && CFLAG:[[千亦]]:1051 > 0 ;如果没有收到过让人想一直带在身边的礼物的记忆，就不会产生送礼的想法
	PRINTFORML 「啊，%CALLNAME:MASTER%。稍等一下……」
	PRINTFORMD 停下脚步后，看到
	CALL F_KOJO_K141_PRINTS_RAINBOW("用七色彩虹包装纸包好的礼物")
	PRINTFORMDL 不知从哪里被千亦拿了出来……
	PRINTFORMW 「这个，是送给\@ TALENT:MASTER:性別 == 2 ? 你 # 你 \@的礼物哦。要好好珍惜呢？」
	CALL COLORMESSAGE("里面装着" + GIFT_NAME + "！",C_YELLOW,2)
	PRINTFORMW
	;PRINTFORMW 「%GIFT_NAME%をあげるから大事に使って」
	RETURN 1
;--------------------------------------------------------------------------------------------------
;一日の終わりに今日貰った贈り物を大事にする（700点以上）
;--------------------------------------------------------------------------------------------------
ELSEIF ARG == 2
	SELECTCASE CFLAG:[[千亦]]:1051
	CASE IS >= 2
		PRINTFORML 「%CALLNAME:MASTER%……果然眼光真不错呢～」 
		PRINTFORML %TEXTR("「这东西的所有权可得好好珍惜才行」/「下次要不要让我也来帮忙进货呢」/「下次再陪你逛街购物吧」")%
		PRINTFORML 「……呵呵♪」
		PRINTW
	CASE 1
		PRINTFORML 「\@ TALENT:MASTER:性別 == 2 ? 那家伙 # 那孩子 \@送的礼物……」
		PRINTFORML 「用我的能力的话，这东西也能干干净净地变成无主之物，重新摆上货架卖掉就是了」
		PRINTFORMW 「不过……他说很适合我，吗」
		PRINTFORML 「……那就好好珍惜它也不错呢」
		PRINTW
	CASEELSE
	ENDSELECT
	;彼女の能力は物の所有権を失くす能力。
	;その力を持ってすればあなたから贈られたという所有権も消せるはずなのだ。
	;
	;ENDIF
	RETURN 1
;--------------------------------------------------------------------------------------------------
;一日の終わりに今日貰った贈り物をお気に入りにする（↑の大事にするから続き）（700点以上かつ最高得点）
;--------------------------------------------------------------------------------------------------
ELSEIF ARG == 3
	;IF STRCOUNT(SENSE, "身につける/")
	;	PRINTFORMW 「明日からこれを付けて行こうっと」
	;ELSE
	;	PRINTFORMW 「明日からこれを持って行こうっと」
	;ENDIF
	RETURN 1
;--------------------------------------------------------------------------------------------------
;一日の終わりに今日貰った贈り物をとりあえず保管する（400～699点）
;--------------------------------------------------------------------------------------------------
ELSEIF ARG == 4
	SELECTCASE CFLAG:[[千亦]]:1051
	CASE IS >= 2
		PRINTFORML 「%CALLNAME:MASTER%……眼光果然很毒呢～」 
		PRINTFORML %TEXTR("「这东西的所有权可得好好珍惜才行」/「下次要不要让我也来帮忙进货呢」/「下次再和他逛街购物吧」")%
		PRINTFORML 「……呵呵♪」
		PRINTW
	CASE 1
		PRINTFORML 「\@ TALENT:MASTER:性別 == 2 ? 那家伙 # 那孩子 \@送的礼物……」
		PRINTFORML 「用我的能力的话，这东西也能干干净净地变成无主之物，重新摆上货架卖掉就是了」
		PRINTFORMW 「不过……他说很适合我，吗」
		PRINTFORML 「……稍微留着自己用用也不错呢」
		PRINTW
	CASEELSE
	ENDSELECT
	RETURN 1
;--------------------------------------------------------------------------------------------------
;一日の終わりに今日貰った贈り物をこっそり質に入れる（400点未満）
;--------------------------------------------------------------------------------------------------
ELSEIF ARG == 5
		PRINTFORML 「嗯～……收到是收到了啦～」
		PRINTFORML 「不过这个……果然不太适合我呢」
		PRINTFORML 「没办法，下次市集就拿去卖掉吧。这种时候不拖泥带水、心慈手软也是我的职责嘛」
		PRINTFORMW
		;龙「切换得真快」
		;典「不愧是商业女性呢～」
	RETURN 1
ENDIF
RETURN 1


