;==================================================
;是否有人目击的判定函数＠把掀裙子判定的汇总了一下
;有人目击 =1 无 =0
;-------------------------------------------------
@K39_BE_SEEN()
#FUNCTION
SIF GET_TARGETNUM() > 1 || DATE_HITOGOMI(CFLAG:PLAYER:現在位置) || WITH_MOB()
	RETURNF 1
RETURNF 0
;==================================================
;返回问候语的式中函数
;4时～10时前・10时～18时前・其他
;-------------------------------------------------
@K39_GREETING_NAZRIN()
#FUNCTIONS
SELECTCASE TIME
	CASE 240 TO 599
		SIF TALENT:恋人
			RETURNF "早哦"
		RETURNF "早安呐"
	CASE 600 TO 1079
		RETURNF "嗯"
	CASEELSE
		RETURNF "哟"
ENDSELECT
;==================================================
;MASTER的恋人是否在场的式中函数
;=-1 娜兹是恋人 =0 本来就没有恋人 =1 不在场 =2 与恋人同席
;有恋慕但不是恋人的娜兹各种不稳定
;-------------------------------------------------
@K39_FIND_LOVER()
#FUNCTION
SIF TALENT:MASTER:恋人 == 0
	RETURNF 0
SIF TALENT:39:恋人
	RETURNF -1
SIF GET_TARGETNUM() < 2
	RETURNF 1
FOR LOCAL, 1, GET_TARGETNUM() + 1
	SIF TALENT:(TARGET:LOCAL):恋人 && CFLAG:MASTER:現在位置 == CFLAG:(TARGET:LOCAL):現在位置
		RETURNF 2
NEXT
RETURNF 1

;==================================================
;以数字返回醉酒程度的式中函数
;=0 清醒 =1 微醺 =2 醉酒 3=烂醉如泥
;-------------------------------------------------
@K39_DRUNK()
#FUNCTION
SIF BASE:39:酒気 <= 2
	RETURNF 0
SELECTCASE BASE:39:酒気
	;烂醉如泥
	CASE IS > (MAXBASE:39:酒気 / 10) * 8
		RETURNF 3
	;醉酒
	CASE IS > (MAXBASE:39:酒気 / 10) * 5
		RETURNF 2
	;微醺
	CASE IS <= (MAXBASE:39:酒気 / 10) * 5
		RETURNF 1
ENDSELECT
;==================================================
;接吻等行为考虑视线后判断是否通过的式中函数
;因为是风味性质的所以判定偏严也无所谓
;=0 失败 =1 成功
;-------------------------------------------------
@K39_TRY_HARASS
#FUNCTION
;状态异常・诶嘿嘿时・受邀时直接通过
SIF SHIRAHU(39) != 1 || CFLAG:39:うふふ || CFLAG:39:お招き
	RETURNF 1
;有接吻魔素质则接吻全通过
SIF TALENT:キス魔 && SELECTCOM == 312
	RETURNF 1
LOCAL = RAND:110
LOCAL:1 = 25 + GET_SUCCESS_RATE() / 8
SIF LOCAL:1 > 109
	LOCAL:1 = 109
;加上上限后，有视线则-33%，没有则+20%
IF K39_BE_SEEN() == 0
	LOCAL:1 += 20
ELSE
	LOCAL:1 -= 33
ENDIF
;反发刻印每个-20%
LOCAL:1 -= MARK:39:反発刻印 * 20
SIF LOCAL >= LOCAL:1
	RETURNF 0
RETURNF 1
;==================================================
;拾取同房间角色的式中函数
;借用了爱丽丝口上的函数并改为平文。放在ERH里的话运行会更快更稳定吧
;完全照搬不太好，所以熟人以外随机选择并返回ID。没人的话返回0
;参数为真-TARGET内随机、假-有优先顺序（[恋人]持有→约会对象→熟人→TARGET内随机）
;娜兹的熟人有8人，按 星>白莲>一轮>水蜜>响子>猯藏>鵺>小伞 的顺序（擅自）设定
;-------------------------------------------------
@K39_FIND_AROUND(ARG = 0)
#FUNCTION
#DIM 知り合い = 87, 55, 85, 86, 88, 69, 41, 40
#DIM 総人数
#DIM 抽選
VARSET LOCAL
抽選 = 0
総人数 = GET_TARGETNUM()
;房间里只有娜兹的话当然返回0
SIF 総人数 == 1
	RETURNF 0
IF !ARG
	;有[恋人]的话优先返回ID＠多恋人兼容
	IF K39_FIND_LOVER() == 2
		FOR COUNT,1, 総人数 + 1
			SIF (CFLAG:(TARGET:COUNT):現在位置 != CFLAG:MASTER:現在位置) || (CFLAG:(TARGET:COUNT):現在位置 != CFLAG:39:現在位置)
				CONTINUE
			SIF !TALENT:(TARGET:COUNT):恋人 || TARGET:COUNT == 39
				CONTINUE
			LOCAL:抽選 = TARGET:COUNT
			抽選 ++
		NEXT
		SIF 抽選
			RETURNF LOCAL:(RAND(抽選))
	ENDIF
	;从FromEN拿来的
	SIF FLAG:デート相手 && FLAG:デート相手 != 39
		RETURNF FLAG:デート相手
	;按熟人优先顺序检查现在位置，与MASTER相同则返回ID
	FOR COUNT, 0, VARSIZE("知り合い")
		SIF CFLAG:(知り合い:COUNT):現在位置 == CFLAG:MASTER:現在位置
			RETURNF 知り合い:COUNT
	NEXT
ENDIF
;没有熟人的话拾取同室的所有TARGET_ID
FOR COUNT,1, 総人数 + 1
	;为防止地狱断头台with杰罗尼莫状态，跳过口上主
	SIF TARGET:COUNT == TARGET:0
		CONTINUE
	;不在MASTER和娜兹的现在位置则跳过
	SIF (CFLAG:(TARGET:COUNT):現在位置 != CFLAG:MASTER:現在位置) || (CFLAG:(TARGET:COUNT):現在位置 != CFLAG:39:現在位置)
		CONTINUE
	;数组计数另外取的同时赋值
	LOCAL:抽選 = TARGET:COUNT
	抽選 ++
NEXT
;存在GET_TARGETNUM()>1但抽選==0的情况，原因不明
SIF 抽選 < 1
	RETURNF 0
;抽选决定ID
RETURNF LOCAL:(RAND(抽選))

;==================================================
;判断是否可以中出的式中函数
;性交相关口上的准备（能不能写出来还不清楚）
;--------------------------------------------------
;=0 中出OK =1 因为怀孕所以不行 =2 因为育儿中所以不行 =3 没有合意
;--------------------------------------------------
@K39_CREAMPIE()
#FUNCTION
;只要吃了避孕药就可以放心内射
SIF TCVAR:39:ピル
	GOTO PREG
;检查合意状况
SIF (CFLAG:39:生解禁 == 0 && ESTRUS_CYCLE(39) != 15) || (CFLAG:39:生解禁 == 1 && ESTRUS_CYCLE(39) == 150)
	RETURNF 3
;检查育儿状况
SIF TALENT:39:育児中 && CFLAG:39:出産経過日 < CHILD_就学
	RETURNF 2
$PREG
;检查母胎的发育
SIF TALENT:39:妊娠 && !INRANGE(CFLAG:妊娠経過日数, 31, 70)
	RETURNF 1
;到这里就OK
RETURNF 0
;==================================================
;判断接吻插入是否可行的式中函数
;将性交相关口上按情境固定以便填入
;--------------------------------------------------
;=0 OK =-1 因为猫舌所以不行 =-2 因为太脏所以不行
;--------------------------------------------------
@K39_KISS_CANCEL()
#FUNCTION
SIF TALENT:PLAYER:猫舌 && ABL:PLAYER:舌 < 2
	RETURNF -1
SIF TALENT:猫舌 && ABL:舌 < 2
	RETURNF -1
SIF TALENT:PLAYER:汚臭耐性 > 1
	RETURNF 0
SIF STAIN:0 & 汚れ_精液 && ABL:PLAYER:精液中毒 < 3
	RETURNF -2
SIF STAIN:0 & 汚れ_アナル
	RETURNF -2
SIF STAIN:0 & 汚れ_ペニス && TALENT:PLAYER:汚臭耐性 < 0
	RETURNF -2
SIF TALENT:PLAYER:汚臭耐性 == -2 && (STAIN:0 & 汚れ_破瓜血 || STAIN:0 & 汚れ_愛液)
	RETURNF -2
RETURNF 0
