;==================================================
;查看娜兹有多想推倒的式中函数
;从@ENDURE中为工作和肌肤接触时的使用稍微削减后拿来的
;本体中此值大于 RAND:300 + 300 时会进入被推倒状态
;-------------------------------------------------
@K39_PUSH_DOWN()
#FUNCTION
;根据素质改变判定
LOCAL = CFLAG:39:合意判定
LOCAL += (EX:39:Ｃ寸止め + EX:39:Ｖ寸止め + EX:39:Ａ寸止め + EX:39:Ｂ寸止め + EX:39:Ｍ寸止め) * 20
;拥抱时推倒率上升
SIF SELECTCOM == 311
	LOCAL += 30
LOCAL += TALENT:39:性的興味 * 20
SIF TALENT:39:処女
	LOCAL -= 50
SIF TALENT:39:恋慕
	LOCAL = LOCAL + 50
SIF TALENT:39:プライド > 0
	LOCAL -= 20
SIF CFLAG:39:生解禁 == 2
	LOCAL = LOCAL + 50
SIF CFLAG:39:無理矢理膣射
	LOCAL -= 100
SIF TALENT:39:度胸 < 0 || TALENT:39:応答 < 0 || TALENT:39:無関心
	LOCAL = LOCAL - 30
SIF TALENT:39:羞恥心 > 0
	LOCAL -= 30
SIF TALENT:39:羞恥心 < 0
	LOCAL = LOCAL + 20
SIF TALENT:39:自制心 
	LOCAL = LOCAL - 20
SIF TALENT:39:貞操 < 0 || TALENT:39:小悪魔
	LOCAL = LOCAL + 20
SIF TALENT:39:貞操 > 0 || TALENT:39:一線越えない
	LOCAL -= 20
IF !GETBIT(CFLAG:39:既成事実, 1) && TALENT:39:貞操 > 0
	LOCAL -= 30
	SIF !TALENT:39:恋慕 && !TALENT:39:セフレ
		LOCAL -= 50
ENDIF
SIF OTOKOGIRAI(39) && !(IsHeat(39) || IsInsenceValid(39))
	LOCAL = LOCAL / 2
SIF TALENT:39:一線越えない && TALENT:39:恋慕
	LOCAL = LOCAL * 12 / 5
SIF MARK:39:反発刻印 == 3
	LOCAL = 0
SELECTCASE CFLAG:39:溜まってる度
	CASE IS >= 1000
		LOCAL *= 3
	CASE IS >= 800
		LOCAL = LOCAL * 3 / 2
	CASE IS >= 600
		LOCAL = LOCAL * 5 / 4
	CASE IS >= 500
	CASE IS >= 300
		LOCAL /= 2
	CASE IS >= 200
		LOCAL /= 4
	CASE IS >= 100
		LOCAL /= 10
	CASEELSE
		LOCAL = 0
ENDSELECT
;依赖体力减少推倒率
SELECTCASE BASE:39:体力
	CASE IS < 750
		LOCAL = 0
	CASE IS < 1000
		LOCAL /= 2
	CASE IS < 1500
		LOCAL = LOCAL * 3 / 4
	CASEELSE
ENDSELECT
SELECTCASE BASE:39:気力
	CASE 0
		LOCAL = 0
	CASE IS < 500
		LOCAL /= 2
	CASEELSE
ENDSELECT
;依赖理性减少推倒率
IF BASE:39:理性 > 800
	LOCAL = LOCAL / 5
ELSEIF BASE:39:理性 > 600
	LOCAL = LOCAL / 2
ENDIF
SELECTCASE BASE:39:ムード
	CASE IS < 200
		LOCAL = 0
	CASE 201 TO 400
		LOCAL /= 4
	CASE 401 TO 600
		LOCAL /= 2
	CASE 601 TO 800
	CASEELSE
		LOCAL = LOCAL * 6 / 5
ENDSELECT
SIF FLAG:甲斐性無
	LOCAL = LOCAL * 2
SIF CFLAG:39:ブチギレ
	LOCAL = 0
RETURNF LOCAL
;==================================================
;以字符串返回日记用场所的式中函数＠月地图对应
;用数值保存的话据点搬家后可能会变
