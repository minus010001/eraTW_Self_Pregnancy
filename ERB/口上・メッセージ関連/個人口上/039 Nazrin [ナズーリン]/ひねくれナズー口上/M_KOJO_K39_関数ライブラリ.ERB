	CASE 0
		SELECTCASE MAP_SEARCH_REPLACEMENT_0(ARG)
			CASE 妖精の大樹
				TEMP_NAME = 三妖精の家
			CASE 夢幻遺跡
				TEMP_NAME = 夢幻遺跡
			CASEELSE
				TEMP_NAME = 博麗神社
		ENDSELECT
	CASE 1
		SELECTCASE MAP_SEARCH_REPLACEMENT_1(ARG)
