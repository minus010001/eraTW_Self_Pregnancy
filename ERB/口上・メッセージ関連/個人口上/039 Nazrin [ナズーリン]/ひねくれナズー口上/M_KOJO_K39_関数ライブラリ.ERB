;==================================================
;控制多恋人的函数
;因为无法应对TALENT:MASTER:恋人变动的规格变更
;--------------------------------------------------
;ARG	状况分类(0=破局检查（每回合） 1=约会后告白事件控制 2=告白指令控制
;				 3=破局后检查)
;--------------------------------------------------
@K39_DENY_POLYAMORY(ARG)
;通过口上选项控制：CFLAG:39:1801 == 0 时不执行多恋人制御
SIF !CFLAG:39:1801
	RETURN 0
SELECTCASE ARG
	CASE 0
		SIF !TALENT:39:恋人
			RETURN
		SIF TALENT:MASTER:恋人 == 39
			RETURN
		CLEARBIT CFLAG:39:既成事実, 2
		TALENT:39:恋人 = 0
		SETBIT CFLAG:39:1505, 1
		PRINTFORMDL
		PRINTFORMDW …在%CALLNAME:MASTER%得到了新的恋情的同时，又觉得有什么东西在某处破碎了
		CALL COLORMESSAGE, "与娜兹琳的恋人关系结束了", C_YELLOW, 2, 1
	CASE 1
		IF TALENT:MASTER:恋人
			TCVAR:39:キスキャンセル = 1
			SETBIT CFLAG:39:デート後イベントフラグ, 1
		ELSEIF !(TALENT:MASTER:恋人 || TALENT:39:恋人)
			CLEARBIT CFLAG:39:デート後イベントフラグ, 1
		ENDIF
	CASE 2
		SIF !TALENT:MASTER:恋人
			RETURN 0
		SIF GETBIT(CFLAG:39:1505, 1)
			RETURN 2
		RETURN 1
	CASE 3
		SIF GETBIT(CFLAG:39:1505, 1)
			RETURN 1
ENDSELECT
