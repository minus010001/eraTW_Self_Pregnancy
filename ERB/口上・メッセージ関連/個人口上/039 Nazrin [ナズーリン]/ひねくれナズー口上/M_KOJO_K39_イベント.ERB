;==================================================
;贈り物イベント
;==================================================
@M_KOJO_EVENT_K39_GIFT(ARG, GIFT_ID, 評価点, GIFT_NAME, SENSE)
#DIM GIFT_ID
#DIM 評価点
#DIMS GIFT_NAME
#DIMS SENSE
;---------------------------------------------------------------------------------------------------
;評価点       贈り物の評価点（1～999）,口上主があげた場合でも口上主の評価点
;GIFT_NAME    贈り物の名称
;SENSE        贈り物に設定された属性。STRCOUNT(SENSE, "ほげほげ/")を使うと特定の属性を判定できます。
;GIFT_ID      これ単体では使いません。以下の式内関数を使うとデータを抽出できます（こだわりたい人用）
;　GET_GIFTDATA(GIFT_ID, "回数")    貰った（あげた）回数
;　GET_GIFTDATA(GIFT_ID, "得点")    得点（1～999）,口上テンプレ内では用意されてます。
;　GET_GIFTDATA(GIFT_ID, "日付")    貰った（あげた）日付（1～9999）
;　GET_GIFTDATA(GIFT_ID, "場所")    買った場所（デートの行き先）
;　GET_GIFTDATA(GIFT_ID, "形容詞")  形容詞番号（贈り物_形容詞.erb参照）
;　GET_GIFTDATA(GIFT_ID, "本体")    本体番号（贈り物_本体.erb参照）
;--------------------------------------------------------------------------------------------------
;デート帰りに口上主があなたに贈り物を渡す（陥落や好感度に関わらず親密5以上から発生）
;評価点は701～999（渡すキャラ本人の評価）
;--------------------------------------------------------------------------------------------------
IF ARG == 1
	IF TALENT:恋慕
		;/香霖堂で霖之助にアドバイス貰いながら選んだという隠し設定
		IF RAND:2 == 0
			PRINTFORMW 「啊—…咳咳，%MASTERNAME:39%…这个，给你」
			PRINTFORMDW 纳兹琳装作若无其事的样子，递出了手中的东西…
		ELSE
			PRINTFORMW 「…%GIFT_NAME%送给你的。在古董店找到的」
			PRINTFORMW 「……　能好好珍惜的话我会很高兴的…　」
		ENDIF
	ELSE
		IF RAND:2 == 0
			PRINTFORML 「这个，给你。是我的孩子们找到的，但最后没人要」
			PRINTFORMW 「大概不会碍事吧。就当是今天回礼了」
		ELSE
			PRINTFORMW 「%GIFT_NAME%，我已经有了」
			PRINTFORMW 「嗯…应该挺配你的吧…」
		ENDIF
	ENDIF
	RETURN 1
;--------------------------------------------------------------------------------------------------
;一日の終わりに今日貰った贈り物を大事にする（700点以上）
;--------------------------------------------------------------------------------------------------
ELSEIF ARG == 2
	;IF STRCOUNT(SENSE, "かわいい/")
	;	PRINTFORMW 「かわいいプレゼントを貰っちゃった」
	;ELSEIF 評価点 >= 800
	;	PRINTFORMW 「とっても素敵なプレゼントを貰っちゃった」
	;ELSE
	;	PRINTFORMW 「素敵なプレゼントを貰っちゃった」
	;ENDIF

	IF TALENT:恋人
		PRINTFORML 「嗯…对你刮目相看了…没想到那家伙会带这么有品味的东西来」
		CALL HPH_PRINT,@"「…说明对方一直在看着我呢…HPH　糟了…好开心…HPH」","W"
	ELSEIF TALENT:恋慕
		PRINTFORML 「…糟了…好开心好开心好开心…」
		PRINTFORMW 「先…先放这里吧！？不、不，放这里的话会被啃的…但是…」
	ELSE
		PRINTFORML 「…没想到能收到这种东西…」
		PRINTFORMW 「…我说过我的喜好了吗？」
		PRINTFORMW 「哈，不行不行。已经这个时间了」
	ENDIF
	RETURN 1
;--------------------------------------------------------------------------------------------------
;一日の終わりに今日貰った贈り物をお気に入りにする（↑の大事にするから続き）（700点以上かつ最高得点）
;--------------------------------------------------------------------------------------------------
ELSEIF ARG == 3
	;IF STRCOUNT(SENSE, "身につける/")
	;	PRINTFORMW 「明日からこれを付けて行こうっと」
	;ELSE
	;	PRINTFORMW 「明日からこれを持って行こうっと」
	;ENDIF

	IF TALENT:恋慕
		PRINTFORML 「…这样就能随身带着了吧」
		CALL HPH_PRINT,@"「嘻嘻…HPH」","W"
	ELSE
		PRINTFORML 「…嗯，把这里这样…」
		PRINTFORMW 「好，这样就能带着走了」
	ENDIF
	RETURN 1
;--------------------------------------------------------------------------------------------------
;一日の終わりに今日貰った贈り物をとりあえず保管する（400～699点）
;--------------------------------------------------------------------------------------------------
ELSEIF ARG == 4
	IF TALENT:恋慕 || TALENT:セフレ >= 1 || TALENT:愛欲
		PRINTFORML 「……嘛，虽然也不是什么特别厉害的东西」
		PRINTFORMW 「既然是%MASTERNAME:39%给我的，就收下来吧…」
	ELSE
		PRINTFORML 「…啊，对了，还有这个东西…」
		PRINTFORMW 「摆出来有点…但也不能扔掉…」
	ENDIF
	RETURN 1
;--------------------------------------------------------------------------------------------------
;一日の終わりに今日貰った贈り物をこっそり質に入れる（400点未満）
;--------------------------------------------------------------------------------------------------
ELSEIF ARG == 5
	IF TALENT:恋人
		PRINTFORMW 「这个真不行。下次得委婉地告诉对方喜好了…」
	ELSEIF TALENT:恋慕
		PRINTFORMW 「…嘁，这果然还是…就算是%MASTERNAME:39%给的也…」
	ELSE
		PRINTFORMW 「不，这真的不行。抱歉收下这东西了，干脆送当铺吧…」
	ENDIF
	RETURN 1
ENDIF
RETURN 1


