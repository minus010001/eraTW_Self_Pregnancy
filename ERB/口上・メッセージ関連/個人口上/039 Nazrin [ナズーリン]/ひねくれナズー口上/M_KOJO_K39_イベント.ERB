;==================================================
;一日の終了時(AFTERTRAニーの前)、面識がなければ呼び出されない
;==================================================
@M_KOJO_EVENT_K39_31(ARG,ARG:1)
;口上主はTARGET
;ARGは会ってない日数
;何日以上会ってなかったら愚痴を言うとかできます
;CFLAG:オナバレで分岐入れてもよさそう
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;今日会っていない
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG
		;口上を表示する前の誰のものか判別するための発生文です,変更したい場合は削除した上で独自に作成してください
		;CALL EVENTEND_TSUBUYAKI
		IF !MARK:反発刻印
			IF TALENT:恋慕
				;半月
				IF ARG == 15
					CALL EVENTEND_TSUBUYAKI
						CFLAG:39:翌日来訪 = 1
				;一週間
				ELSEIF ARG == 7
					CALL EVENTEND_TSUBUYAKI
					CFLAG:39:翌日来訪 = 1
				ENDIF
			ELSEIF TALENT:思慕
				IF ARG == 7
					CALL EVENTEND_TSUBUYAKI
					IF MAIN_MAP == 6
					ELSE
					ENDIF
				ENDIF
			ELSE
				IF ARG == 7
					CALL EVENTEND_TSUBUYAKI
				ENDIF
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;今日会っている
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 0
		CALL EVENTEND_TSUBUYAKI
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;セフレ契約でセフレになった（条件達成で取れるセフレ取得口上は、別途[セフレ取得]にて描写）
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	;セフレ契約でセフレになった　eratwさんが契約セフレ専用CFLAG:を作ってくれるらしいので仮番号
	IF LOCAL:1 && CFLAG:2351 == 1
		PRINTFORMDW 纳兹琳正逐渐沉溺于你所给予的快感…
		PRINTFORML
		;セフレにはなったがうふふ未経験　ナズでそんなことある？かなりレアケースだと思う…
		IF CFLAG:1200 == 0
			;うふふ未経験なのにセフレ化成功しているということは、理性ゼロ時つまりかなりイチャついていたはず
			PRINTFORMDW ——终究，还是答应了和%MASTERNAME:39%成为炮友。
			PRINTFORMDW 稀里糊涂地就这么被带过去了，仔细想想还是不明白怎么回事。
			PRINTFORMDW 毕竟，和那家伙明明连『那种事』都还没做过。
			IF MARK:不埒刻印 >= 1 || MARK:時姦刻印 >= 1
				PRINTFORMDW 又或者，每次见到那家伙时身体涌起的这股躁动，已经被看穿了吗…？
			ENDIF
			;動物耳持ちは、危険日に欲情Lv.5以上になると発情する
			PRINTFORMDW 而且，仔细想想的话，时不时到来的『那个时候』也许也方便一些。
			PRINTFORMDW 总之，\@ TALENT:思慕 ? 和那家伙 #  \@……得承认自己心里其实在期待着『那种事』…也许这样比较好…
			PRINTFORMDW …
		ELSE
			PRINTFORMDW ——终究，还是答应了和%MASTERNAME:39%成为炮友。
			;MASTERが押し倒して初うふふ
			IF CFLAG:1200 == 1
				PRINTFORMDW 虽然的确是把身体交出去的交情了，但炮友是不是做得太过了？
				PRINTFORMDW 也许有些轻率了。
			;ナズから押し倒して初うふふ
			ELSEIF CFLAG:1200 == 2
				PRINTFORMDW 确实，我也有主动推倒的时候，但炮友果然还是太过分了吧。
				PRINTFORMDW 也许有些轻率了。
			ENDIF
			
			;時姦刻印3か快楽刻印を持っている、セフレ契約したときに思慕を持っていた
			IF ( MARK:時姦刻印 == 3 || MARK:快楽刻印 >= 1 ) && CFLAG:1222 == 1
				PRINTFORMDW …但是，被那家伙玩弄过好多次、确实很舒服这也是事实…
			;時姦刻印3か快楽刻印を持ってるけど思慕は無かった
			ELSEIF MARK:時姦刻印 == 3 || MARK:快楽刻印 == 1
				PRINTFORMDW 虽然是个不能大意的家伙，但被弄得很舒服也是事实…
			ELSEIF CFLAG:1222 == 1 || MARK:不埒刻印 == 3
				PRINTFORMDW 和那家伙上床倒也不讨厌，可是…
			ENDIF
			;動物耳持ちは、危険日に欲情Lv.5以上になると発情する
			PRINTFORMDW …嘛，算了…而且时不时到来的『那个时候』也方便一些…
			PRINTFORMDW 下次见面的时候…和那家伙…
			PRINTFORMDW …
		ENDIF
	;表示が終わったら次回から表示されないようにCFLAG:契約セフレに2を入れとく
	CFLAG:2351 = 2
	RETURN 1
	ENDIF
ENDIF
RETURN 1

