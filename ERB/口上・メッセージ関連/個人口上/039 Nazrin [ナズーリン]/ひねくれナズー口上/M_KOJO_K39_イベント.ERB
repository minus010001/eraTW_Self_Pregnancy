;==================================================
;（TARGETが）押し倒した　MASTERが押し倒すのは日常系コマンドの「押し倒す」にて
;室外では押し倒されない&仕事中も自重
;押し倒され条件を満たしていると、以下の地の文が表示される
[SKIPSTART]
SELECTCASE CFLAG:TARGET:溜まってる度
	CASE IS < 600
		PRINTFORMDL %CALLNAME:TARGET%拽了拽你的衣袖
		PRINTFORMDW 看起来是想去某个不引人注目的地方
	CASE IS < 800
		PRINTFORMDW %CALLNAME:TARGET%依偎到%CALLNAME:MASTER%身旁，用那双抬起的眼睛注视着这边…
	CASE IS < 1000
		PRINTFORMDL %CALLNAME:TARGET%凑到%CALLNAME:MASTER%身边，\@ BATHROOM(CFLAG:現在位置) ? 用裸露的 # 隔着衣服 \@轻轻抚上了股间…
		PRINTFORMDW %CALLNAME:TARGET%用眼神诉说着情欲
	CASEELSE
		PRINTFORMDL %CALLNAME:TARGET%红着脸倚靠在%CALLNAME:MASTER%身上，握住%CALLNAME:MASTER%的手、引导到那早已濡湿的秘部…
		PRINTFORMDW %CALLNAME:TARGET%似乎已经忍耐不住想要立刻被%CALLNAME:MASTER%拥抱了
ENDSELECT
[SKIPEND]
;/ネズミのオスは性欲旺盛だが、メスも性欲旺盛だという事実は特になかった。残念。
;==================================================
@M_KOJO_EVENT_K39_10(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入スイッチ
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;MASTERを押し倒した（開始時）
	;地の文：PRINTFORMDW %CALLNAME:MASTER%は押し倒された！
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	;被逆推ている時に立つフラグ
	CFLAG:1211 = 1
	;ナズに被逆推た回数を加算
	CFLAG:1216 ++
	IF LOCAL:1 && ARG == 1
		PRINTFORMDL 
		;-------------------------------------------------
		;小分岐
		;-------------------------------------------------
		;初めて
		;記入チェック
		LOCAL:1 = 1
		;-------------------------------------------------
		;ナズが押し倒したことなければここ、発情時の押し倒しはナズの中では「初情事」としてはノーカン
		IF LOCAL:1 && CFLAG:1215 == 0 && !TCVAR:発情
			;恋慕かつ恋人
			;/普通にプレイしてたら多分見る機会はない。勿体ないなあ
			IF TALENT:恋慕 && TALENT:恋人
				PRINTFORMW 「我想要你」
				PRINTFORMDW 纳兹琳把脸埋在你的胸口，小声诉说着
				PRINTFORMW 「也许你是尊重我才礼待我。可是你知道吗，这种态度反而让我好难过」
				PRINTFORMW 「难道我一点魅力也没有吗，其实一点也不很讨人喜欢吗。明明是…恋人…为什么呢？」
				PRINTFORMW 「%MASTERNAME:39%、我不想再等了，前段时间也说过了、我想和心爱的人建立联系」
				PRINTFORMW 「……这种事，居然要先从女生的嘴里说出来…你个铁木头…」
			;恋慕or好感度1000以上
