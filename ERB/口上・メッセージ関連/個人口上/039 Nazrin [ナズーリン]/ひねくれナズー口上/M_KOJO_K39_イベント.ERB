;==================================================
;情事を目撃した
;==================================================
@M_KOJO_EVENT_K39_6(ARG,ARG:1)
;口上主はTARGET
;ARGに情事相手
;--------------------------------------------------
;記入スイッチ
LOCAL = 1
;-------------

IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;情事を目撃した（亲热度:低）
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 1
		;恋慕
		IF TALENT:恋慕
			PRINTFORMW 「……打…打、打扰了…」
		ELSE
			PRINTFORMW 「……哎呀、这下失礼了……只是提醒、下次不要发出奇怪的声音哦」
		ENDIF	
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;◆負けじと参加（亲热度:高）
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 2
		PRINTFORMDL 
		;恋慕
		IF TALENT:恋慕
			PRINTFORMW 「嗯？现在想要我什么都不说就离开吗……」
			PRINTFORMW 「真是的，我可不是什么乐于分享的好女人啊……」
		ELSE
			IF RAND:2 == 0
				PRINTFORMW 「哎呀呀，玩得挺开心嘛……」
			ELSE
				PRINTFORMW 「到 此 为 止 了！」
				PRINTFORMDL 
				PRINTFORMDW 啊！  野生的  纳兹琳  出现了！
				PRINTFORMDL 
				PRINTFORMW 「小老鼠们已经把全程都帮我看清楚了哦！
				PRINTFORMDL 　但是、你们两个根本没有做到底嘛！看着就让人着急！
				PRINTFORMW 　总之、那个…这太狡猾了吧！我也要加入！」
			ENDIF
		ENDIF
		PRINTFORMDL 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;気まずそうに立ち去る
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 3
		PRINTFORMDL 	
		PRINTFORMW 「…………这、真是打扰了。那我就先行告退…」
		PRINTFORMDL 
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;◆MASTERに誘われて参加
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 4
		PRINTFORMW 「……那么、该怎么办呢……诶、呜哇哇哇！？」
		PRINTFORMW 「说什么……太突然了…等，等等，等一下！呀唔！？」
		RETURN 1
	ENDIF
	;其他
	PRINTFORMDL 
ENDIF
RETURN 1

;==================================================
;◆情事を見られた
;==================================================
@M_KOJO_EVENT_K39_7(ARG,ARG:1)
;口上主はTARGET
;ARGに目撃者
;--------------------------------------------------
;記入スイッチ
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;情事を見られた（目撃者の亲热度:低）
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 1
		PRINTFORMDL 
		;恋慕
		IF TALENT:恋慕
			PRINTFORMW 「……真是有够失礼的，这种情况下不应该是该一言不发地走开吗？」
			PRINTFORMW 「唉，不好意思啊今天只能到这、后续就……等下再期待吧？」
			PRINTFORMW 「但是、难得的享受中断了、不会觉得扫兴吗？」
		ELSE
			IF RAND:2 == 0
				PRINTFORMW 「唔……明明正在兴头上呢……」
				PRINTFORMW 「……（整理衣服）咳、让你久等了。出什么事了吗？」
			ELSE
				PRINTFORMW 「……竟然没有注意到小家伙们的警告……好像有点太投入了呢。」
				PRINTFORML 「……既然被看到了就没办法了。只能灭口─……！」
				PRINTFORMDL 
				PRINTFORMDW 你赶忙抓住灵摆，将纳兹琳按倒……
				PRINTFORML
			ENDIF
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;目撃者が負けじと参加（目撃者の亲热度:高）
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 2
		;恋慕
		IF TALENT:恋慕
			IF RAND:2 == 0
				PRINTFORMW 「……什么嘛，你也想加入吗？」
				PRINTFORMW 「不好意思，驳回了。现在他可是我的……喂你等等」
				PRINTFORMW 「哎呀呀…好吧，反正错的也是%MASTERNAME:39%…哼」
			ELSE
				PRINTFORMDL 
				PRINTFORML 「……你……我也是不知道该说什么了，简直就是女猩猩啊」
				PRINTFORMDL 
				PRINTFORMDW 纳兹琳眯着眼俯视着、被闯入者一招放倒的%CALLNAME:MASTER%，无奈的叹了口气
				PRINTFORMDL 
			ENDIF
		ELSE
			PRINTFORMW 「……诶，在那样的地方做什么呢……哦……哈哈～」
			PRINTFORMW 「我明白了……你也一起怎么样？」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;目撃者が立ち去る
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 3
		;恋慕
		IF TALENT:恋慕
			IF RAND:2 == 0
				PRINTFORMW 「……这才对嘛、搅事者就应该快快消失」
				PRINTFORMW 「呀唔！？……嘿～偷袭吗，偷袭可是要、做好觉悟哦！」
			ELSE
				PRINTFORMDL 
				PRINTFORMW 「……竟然没有注意到小家伙们的警告……好像有点太投入了呢。」
				PRINTFORML 「……既然被看到了就没办法了。只能灭口─……！」
				PRINTFORMDL 
				PRINTFORMDW 你赶忙抓住灵摆，将纳兹琳按倒……
				PRINTFORMDL 
			ENDIF
		ELSE
			PRINTFORMW 「哎呀，好像走了呢……嘻嘻，那就继续吧」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MASTERに誘われて目撃者も参加
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 4
		;恋人
		;/普通ならブチ切れて修羅場突入だが…幻想郷は寛大だなぁ
		IF TALENT:恋人
			PRINTFORMW 「……你这真是…做出这样的事、都不觉得会伤我心的吗？你这坏家伙……」
			PRINTFORMW 「这次就放过你了、但等会一起来的时候你可得更偏心我一点…懂吗？」
		ELSEIF TALENT:恋慕
			PRINTFORMW 「诶，不是、先别客气…呀唔！？」
		ELSE
			PRINTFORMW 「哦呀、你也真是放的开啊…玩很大哦？」
		ENDIF
		RETURN 1
	ENDIF
	;其他
	PRINTFORMDL 
ENDIF
RETURN 1

;==================================================
;◆目撃した情事を問い詰める
;==================================================
@M_KOJO_EVENT_K39_8(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入スイッチ
LOCAL = 1
;-------------

IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;MASTERだけ問い詰め
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 1
		;恋慕
		IF TALENT:恋慕
			PRINTFORMW 「……只有我……不行吗……果然……区区社君的魅力还是、不能满足啊……」
			PRINTFORMW 「……不，该道歉的是我。你也有自由的……我没有资格束缚你……」
			PRINTFORMDW 心好痛啊、不能再对不起这个姑娘了……
		ELSE
			PRINTFORMW 「……嘛，想做那种事我也不是不明白……但还是要记得节制，好吗？」
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;二人とも説教
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG:1 == 2
		;恋人
		IF TALENT:恋人
			PRINTFORMW 「关系好是件好事。但是，关系太好也不行！」
			PRINTFORMW 「特别是%MASTERNAME:39%的人和我以外的家伙相处，对我的心灵健康非常不好！」
		ELSEIF TALENT:恋慕
			PRINTFORMW 「那个啊…不是说不要搞好关系，但有个限度吧」
			PRINTFORMW 「特别是%MASTERNAME:39%…因为是人啊…和妖怪搞好关系是不可能的……」
			PRINTFORMDW 这么说教的纳兹琳的表情看起来很痛苦……
		ELSE
			PRINTFORMW 「幸亏是被我看到了……也没闹出什么动静，其他人应该不知道吧」
		ENDIF
		RETURN 1
	ENDIF
	;其他
	PRINTFORMDL 
ENDIF
RETURN 1

