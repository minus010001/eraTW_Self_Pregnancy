;==================================================
@M_KOJO_EVENT_K39_4(ARG,ARG:1)
;口上主はTARGET
;--------------------------------------------------
;記入スイッチ
LOCAL = 1
;-------------
IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;立ち止まった
	;記入チェック
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;軽く会釈して通り過ぎた
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 2
		IF CFLAG:LOCAL:ブチギレ
			PRINTFORMW 「……呋嗯」
		;恋人かつ随机1/2
		ELSEIF TALENT:恋人 && RAND:2 == 0 
			;◆
			IF RAND:4 == 0
				PRINTFORMW 「辛苦了啊，回头见」
			;◆
			ELSEIF RAND:3 == 0
				PRINTFORMW 「要去工作吗？那、等下结束了……能来找我吗？」
			ELSEIF RAND:2 == 0
				PRINTFORML 「嗯…」
				PRINTFORMDW 路过的时候随意轻抚了下她的头发，结果她一下就害羞地转过身去……
			ELSE
				PRINTFORMDW 纳兹琳对你微微一笑，也点头回应
			ENDIF
			;無視素通りの怒りフラグをゼロに戻す
			CFLAG:1207 = 0
		ELSE
			;MASTERの気力が0
			IF BASE:MASTER:気力 <= 0
				PRINTFORMW 「看起来相当累了呢，稍微休息一下吧」
			;恋慕または思慕または顔見知り
			ELSEIF TALENT:恋慕 || TALENT:思慕 || ( ( CFLAG:好感度 >= 1000 && CFLAG:信頼度 >= 100 ) || TALENT:2 != 2 )
				;◆
				IF RAND:5 == 0
					PRINTFORMDL 
					PRINTFORML 「啊啊、呀啊……诶」
					PRINTFORMDL 纳兹琳挥舞着她那对灵摆好像在找什么
					IF TALENT:恋慕 && RAND:2 == 0
						PRINTFORMDW 
						PRINTFORMDL 看你走远后、纳兹琳的表情变得有些疑惑
						PRINTFORMDW ……她手里的灵摆一直指着你的方向
					ENDIF
				ELSEIF RAND:4 == 0
					PRINTFORMDL 
					PRINTFORMDL 纳兹琳抬起一只手以示回应
				;◆
				ELSEIF RAND:3 == 0 
					PRINTFORMDL 
					PRINTFORML 「啊，辛苦了」
					IF TALENT:恋慕 && RAND:2 == 0
						PRINTFORMDW 
						PRINTFORMDL 擦身而过后、纳兹琳就这么目送着你的背影看了一会
						PRINTFORMDL 
						PRINTFORMW 「…诶、我在做什么呢…」
					ENDIF
				ELSEIF RAND:2 == 0
					PRINTFORMDW 纳兹琳对你这边的点头致意做出了反应，微微扬了扬眉
				ELSE
					PRINTFORML 「嗯」
					PRINTFORMDW 纳兹琳对你这边的点头致意稍稍做出了反应
				ENDIF
			;顔見知りですらない、好感度信頼度低くてあなたが男
			ELSE
				IF RAND:2 == 0
					PRINTFORMDW 纳兹琳对你这边的点头致意做出了反应，微微扬了扬眉
				ELSE
					PRINTFORML 「嗯」
					PRINTFORMDW 纳兹琳对你这边的点头致意稍稍做出了反应
				ENDIF
			ENDIF
			PRINTFORMDL 
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;無視して通り過ぎた
	;/許されざるよ
	;記入チェック
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 3
		;◆
		IF CFLAG:LOCAL:ブチギレ
			PRINTFORMW 「…………」
		ELSEIF TALENT:恋人
			IF CFLAG:1207 == 1
				PRINTFORMW 「…」
				PRINTFORMDL 
				PRINTFORMDW ―纳兹琳生气了―
				CFLAG:ブチギレ = 1
			;◆
			ELSE
				PRINTFORMW 「你给我等等」
				PRINTFORMDL 
				PRINTFORMDW 被谁一下抓住了肩膀
				PRINTFORMDL 
				PRINTFORMDW 你不自然地回过头，发觉纳兹琳看你的眼神有些异常
				PRINTFORMDL 
				PRINTFORMW 「为什么无视我……我们不是恋人吗？不·是·吗？」
				PRINTFORMDL 
				PRINTFORMDW 她的手指慢慢地压入肩膀，啊、好疼好疼
				PRINTFORMDW 似缓实急地，从四周如奔流般涌出一大群老鼠
				PRINTFORMDL 
				PRINTFORMDW 呃，那个，走神了走神了，误会啊…咳，对不起，我是认真的，真的对不起。
				PRINTFORMDL 
				PRINTFORMW 「……下次再这样我可就真生气了哦」
				PRINTFORMDL 
				;まあ怒らないんですけどね！口上側で怒らせていいのかもよく分からんし
				;↑採用。一度やるとフラグが立ち、次やると憤怒状態になります。
				CFLAG:1207 = 1
			ENDIF
		;◆
		ELSEIF TALENT:恋慕
			PRINTFORMW 「啊，是你啊。对了、今天……诶」
			PRINTFORMDL 
			PRINTFORMDW 纳兹琳看着你神色匆匆地离去、连一句问候也没有，不由得嘴角微微一歪
			PRINTFORMDL 
			PRINTFORMW 「……这样啊……也是、也不是什么大事……」
			PRINTFORMDL ……啊，真是的。
			PRINTFORMW 「唉、我在干什么啊，和平常一点也不像……」
			PRINTFORMDL 
		;◆
		ELSE
			PRINTFORML 「啊，嗨─…」
			PRINTFORML 「……诶，我哪里做错了吗……」
		ENDIF
		RETURN 1
	ENDIF
	;其他
	PRINTFORMDL 
ENDIF
RETURN 1

