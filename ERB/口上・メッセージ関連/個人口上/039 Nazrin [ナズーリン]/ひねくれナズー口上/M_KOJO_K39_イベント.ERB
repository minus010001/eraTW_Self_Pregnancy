;==================================================
;時止め終了時
;構文は妖夢口上の丸パクリ
;妖夢口上におけるCFLAG:23:1001はパンツ盗まれ自覚回数　10，20，100回で反応が変化→ナズ口上ではCFLAG:1219に移動
;		同じくCFLAG:23:1002は時止め時の絶頂回数の累計加算値→ナズ口上ではCFLAG:1220に移動
;		同じくCFLAG:23:1003はCFLAG:23:1002が500以上になった状態で時止め絶頂するとイベントが起こって1が立つ。時姦に堕ちきった状態
;==================================================
@M_KOJO_EVENT_K39_17(ARG,ARG:1)
;口上主はTARGET
;排他と明記されていないモノは状況によっては連続で表示されるので注意
;ARGに射精状況
;ARG:1に射精状態
;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------

IF LOCAL
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;謎の快感	絶頂合計30回未満
	;	%CALLNAME:LOCAL%は、謎の快感にびくりと身を強張らせた
	;ARG=1～3は排他
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARG == 1
		;絶頂回数カウント
		LOCAL:4 = 0
		LOCAL:4 += EX:39:50
		LOCAL:4 += EX:39:51
		LOCAL:4 += EX:39:52
		LOCAL:4 += EX:39:53
		;絶頂箇所判定
		LOCAL:5 = 0
		;無自覚C絶頂
		SIF EX:39:50 > 0
			LOCAL:5 += 1
		;無自覚V絶頂
		SIF EX:39:51 > 0
			LOCAL:5 += 1
		;無自覚A絶頂
		SIF EX:39:52 > 0
			LOCAL:5 += 1
		;無自覚B絶頂
		SIF EX:39:53 > 0
			LOCAL:5 += 1
		IF MARK:時姦刻印 == 1
		;参考　時姦刻印1取得時の地の文：PRINTFORMDL 時間の止まった%CALLNAME:TARGET%の身体に、性の悦びを教えてやった……
			IF RAND:2 == 0
				PRINTFORML 「——呃呃！？」
			ELSE
				PRINTFORML 「——！？」
			ENDIF
			PRINTFORMD 纳兹琳的身体猛地一颤，
				;1回以上無自覚絶頂した
				IF LOCAL:5 > 1
					IF RAND:2 == 0
						PRINTFORMD 对突如其来的快感不知所措地
					ELSE
						PRINTFORMD 对突如其来的感觉不知所措地
					ENDIF
				ENDIF
