;-------------------------------------------------
;名前を教えるイベント（関数）
;/見事な響子口上の丸パクだと感心するがどこもおかしくはない
;-------------------------------------------------

@NAME_SET_K39
gLineCount = LINECOUNT
DO
	SIF LINECOUNT - gLineCount > 0
		CLEARLINE LINECOUNT - gLineCount
PRINTDL 请输入称呼(直接输入或点击按钮)
IF NAME:MASTER != "你"
	LOCALS = %NAME:MASTER%
ELSE
	LOCALS = %CALLNAME:MASTER%
ENDIF
PRINTBUTTON @"[就叫%LOCALS%吧]", @"%LOCALS%"
PRINTDL 　
INPUTS
; 行頭行尾の空白文字削除
LOCALS = %RESULTS%
REPLACE LOCALS, "(^[ 　]+|[ 　]+$)", ""
;10文字以上は受け付けない
IF STRLENS(LOCALS) > 10
	CLEARLINE 1
	PRINTFORMW 「…不管怎么说都太长了喂，还是说个简单点的吧？」
	CONTINUE
;空白は受け付けない
ELSEIF RESULTS == ""
	PRINTDL 请输入称呼
		CONTINUE
ELSE
	; 同姓同名
	IF FLAG:扮演 != 39 && STRCOUNT(LOCALS, "纳兹琳")
		CLEARLINE 1
		PRINTFORMW 「…拿名字来开玩笑，我可是会生气的哦」
			CONTINUE
	; 白蓮が主人ではなく、白蓮というフレーズが含まれている。もしくは
	; 星が主人ではなく、寅丸もしくは星というフレーズが含まれている
	ELSEIF (FLAG:扮演 != 55 && STRCOUNT(LOCALS, "(^白蓮$|聖[ 　]*白蓮)")) || (FLAG:扮演 != 87 && STRCOUNT(LOCALS, "(^星$|寅丸[ 　]*星)"))
		CLEARLINE 1
		PRINTFORMW 「…别开玩笑了」
			CONTINUE
	; 命蓮寺勢はじき
	; うんそうだね多多良勝五郎とか教える人もいるかもしれないもんね
	ELSEIF (FLAG:扮演 != 40 && STRCOUNT(LOCALS, "(^小傘$|多多良[ 　]*小傘)")) || (FLAG:扮演 != 85 && STRCOUNT(LOCALS, "(^一輪$|雲居[ 　]*一輪)")) || (FLAG:扮演 != 86 && STRCOUNT(LOCALS, "(^水蜜$|村紗[ 　]*水蜜)"))
		CLEARLINE 1
		PRINTFORMW 「…和我们家的人容易混淆啊。要不换个？」
			CONTINUE
	ELSEIF FLAG:扮演 != 69 && STRCOUNT(LOCALS, "(^猯藏$|二ツ岩[ 　]*猯藏)")
		CLEARLINE 1
		PRINTFORMW 「…拜托，那家伙可是有尾巴诶」
			CONTINUE
	ELSEIF (FLAG:扮演 != 41 && STRCOUNT(LOCALS, "(^鵺$|封獣[ 　]*鵺)"))
		CLEARLINE 1
		PRINTFORMW 「…啊，鵺」（对着上方挥了下手）「找到你的二重身了」
			CONTINUE
	; 道教勢力はじき
	ELSEIF (FLAG:扮演 != 89 && STRCOUNT(LOCALS, "(^芳香$|宮古[ 　]*芳香)")) || (FLAG:扮演 != 90 && STRCOUNT(LOCALS, "(^青娥$|霍[ 　]*青娥)")) || (FLAG:扮演 != 91 && STRCOUNT(LOCALS, "(^屠自古$|蘇我[ 　]*屠自古)")) || (FLAG:扮演 != 92 && STRCOUNT(LOCALS, "(^布都$|物部[ 　]*布都)")) || (FLAG:扮演 != 56 && STRCOUNT(LOCALS, "(^神子$|豊聡耳[ 　]*神子|聖徳太子)"))
		CLEARLINE 1
		PRINTFORMDW 
			CONTINUE
	; 博麗霊夢というフレーズが含まれてる。もしくは
	; 東風谷早苗というフレーズが含まれている
	ELSEIF STRCOUNT(LOCALS, "(^霊夢$|博麗[ 　]*霊夢)") || STRCOUNT(LOCALS, "(^早苗$|東風谷[ 　]*早苗)")
		PRINTFORML 「哦，那个脱离常识的巫女的亲人吗？倒是可以……」
	; 霧雨魔理沙というフレーズが含まれてる。
	ELSEIF STRCOUNT(LOCALS, "(^魔理沙$|霧雨[ 　]*魔理沙)")
		PRINTFORML 「唔……和那个奇怪的魔法使有微妙的缘分啊。好吧」
	; 直接入力ならいけると思ったか？弾くぜ！
	ELSEIF ABL:親密 < 4 && (STRCOUNT(LOCALS, "(お(兄|にい|姉|ねえ)(さん|ちゃん))$") || STRCOUNT(LOCALS, "((([N|n]i{1,})|([N|n]e{1,}))(-|)(san|chan)|[B|b]rother|[S|s]ister|[B|b]ro|[S|s]is)$") || (STRCOUNT(LOCALS, "((大|)(哥哥|哥|姐姐|姐|姊姊|姊))$") || STRCOUNT(LOCALS, "((歐|欧|)(尼|捏)(醬|酱|桑))$") || STRCOUNT(LOCALS, "((兄|學|学)(长|長))$")))
		CLEARLINE 1
		PRINTFORMW 「你是笨蛋吗」
			CONTINUE
	ELSEIF ABL:親密 < 7 && (STRCOUNT(LOCALS, "(お(兄|にい|姉|ねえ)(様|さま))$") || STRCOUNT(LOCALS, "(([N|n]i{1,})|([N|n]e{1,}))(-|)(chama|sama)$") || (STRCOUNT(LOCALS, "(殿下|神|神明|卡密)$") || STRCOUNT(LOCALS, "(大人)$")))
		CLEARLINE 1
		PRINTFORMW 「你是笨蛋吗」
			CONTINUE
	ELSEIF (ABL:従順 < 7 || ABL:奉仕精神 < 7) && (STRCOUNT(LOCALS, "((御|ご)(主人|しゅじん)(様|さま))$") || STRCOUNT(LOCALS, "((?i)master|lord|god|shujin|shuujin)$") || STRCOUNT(LOCALS, "((主人)(撒嘛|撒麻|))$"))
		CLEARLINE 1
		PRINTFORMW 「你是笨蛋吗」
			CONTINUE
	ELSEIF (!TALENT:恋人 || !TALENT:恋慕) && (STRCOUNT(LOCALS, "((旦那|だんな)(様|さま))$") || STRCOUNT(LOCALS, "(?i)(husband|dear|darling|honey|hubby|danna)$") || STRCOUNT(LOCALS, "((我的|我|)(親愛的|亲爱的|達令|达令|爸爸|爹地|爸比|戀人|恋人|愛人|爱人|夫君|眷屬|當家的|当家的|丈夫|老公|相公))$"))
		CLEARLINE 1
		PRINTFORMW 「你是笨蛋吗」
			CONTINUE
	ELSE
		PRINTFORML 「%RESULTS%…吗」
	ENDIF
	CALL ASK_YN
	IF RESULT == 0
		;あなたの名前を%MASTERNAME:39%に格納
		MASTERNAME:39 = %RESULTS%
		PRINTFORMDL 
BREAK
	ELSEIF RESULT == 1
		CONTINUE
	ENDIF
ENDIF
