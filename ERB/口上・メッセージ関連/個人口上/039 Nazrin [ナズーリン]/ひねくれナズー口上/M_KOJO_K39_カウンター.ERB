	ELSEIF RAND:2 == 0
		CALL HPH_PRINT,@"「…HPH」","W"
		PRINTFORMDW 纳兹琳装出一副若无其事的样子，缩短了与你之间的距离
	ELSE
		PRINTFORMDW 心满意足的纳兹琳把身体靠向这边…
	ENDIF
ELSEIF TALENT:恋慕
	IF RAND:3 == 0 
		;因为她不善表达，即使在恋慕状态也会说些不中听的话
		PRINTFORMW 「…诶？靠得太近了？」
