;==================================================
;弾幕勝負
;==================================================
;
@M_KOJO_MESSAGE_COM_K139_DANMAKU(ARGS, 相手残機, ARG:2)
#DIM 相手残機
;全体の流れ
;①【戦闘前】→②ダイスロールとプレイヤー選択肢、ハンデをつけた場合は【ハンデ口上】→③対応スキルが発動した場合【スキル口上】→④被弾判定、キャラが被弾したなら【被弾口上】→
;どちらかの残機が0になっていなければ②に戻る→⑤【戦闘後口上】

;--------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------
IF LOCAL
SIF FLAG:口上色
	TRYCALLFORM M_KOJO_COLOR_K{NO:TARGET}
	;-------------------------------------------------
	;小分岐
	;-------------------------------------------------
	;戦闘前
	;HANDICAP_FIXED = 0
	;HANDICAP_RAND = 0
	;ハンデをつけることができ、数値が大きいほどあなたが不利になる　数値が負ならあなたが有利に
	;キャラの能力に関わらずクッソ強くしたり弱くしたりできる
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == OPR_战斗前
		IF (TALENT:MASTER:年齢 == -1 || TALENT:MASTER:幼児／幼児退行)
			PRINTFORML 「%CALLNAME:MASTER%大人、姐姐我、有个請求」
			PRINTFORML 「你看、%CALLNAME:MASTER%大人不是相當厲害嗎」
			PRINTFORML 「只有一方壓倒性地贏、這樣不是很無聊嗎、%CALLNAME:MASTER%大人不會欺負弱者的对吧？」
			PRINTFORML 「所以呢、能不能对姐姐稍加手下留情呢…♪」
			CALL ASK_YN("いいよ","だめ")
			IF !RESULT
				HANDICAP_FIXED += ABL:MASTER:戦闘能力 * 50
			ELSE
				PRINTFORMW 「ふみゅう…%CALLNAME:MASTER%どのの、イジワル…」
			ENDIF
		ELSE
			PRINTFORML 「%CALLNAME:MASTER%大人。我只不過是隻無聊的管狐而已哦」
			PRINTFORML 「真的打算对這麼弱的对手全力以赴嗎？」
			PRINTFORML 「折磨比自己弱的对手、會讓%CALLNAME:MASTER%大人的戰績留下黑點的哦」
			PRINTFORML 「如何呢？　這樣能否稍微手下留情一下呢？」
			PRINTW 
			CALL ASK_YN("いいよ","ならぬ。完膚なきまでに叩き潰す")
			IF !RESULT
				HANDICAP_FIXED += ABL:MASTER:戦闘能力 * 50
			ELSE
				PRINTFORMW 「ひ、ひえぇ…」
			ENDIF
		ENDIF
	ENDIF
	;-------------------------------------------------
	;ハンデ
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == OPR_让步
		;ハンデつけなかったら表示されないので無記入でよい
		IF (TALENT:MASTER:年齢 == -1 || TALENT:MASTER:幼児／幼児退行)
			PRINTFORML 「好开心♪　%CALLNAME:MASTER%大人对姐姐真是温柔呢♪」
			IF ABL:MASTER:戦闘能力 >= 3
				PRINTFORML (這位比\@ ABL:MASTER:戦闘能力 > 4 ? 飯綱丸大人 # 我 \@更強的孩子如果全力以赴的話我可是拿他一點辦法都没有呢…）
			ELSE
				PRINTFORML （太好了…♪）
				;生意気か反抗的持ち
				IF (TALENT:MASTER:応答 == 1 || TALENT:MASTER:態度 == 1)
					PRINTFORML （如果給予一些限制、或許能夠讓這个有些倔強的孩子明白个一二呢…♪）
					PRINTFORML （反彈也是一種可愛、但有時候也要聽姐姐的話才行呢…♪）
				ELSE
					PRINTFORML （在擊敗他後、再加言語攻擊粉碎他的自尊、再加寵愛他个亂七八糟的…♪）
					PRINTFORML （然後、就會完全依赖我了…完美的計劃♪）
				ENDIF
			ENDIF
		ELSE
			PRINTFORML 「%CALLNAME:MASTER%大人果然厲害。真正強大的人是不需要炫耀的」
			PRINTFORML （這真是太容易了呢…這麼好操作、真是幫大忙了♪）
			PRINTW 
		ENDIF
	ENDIF
	;-------------------------------------------------
	;戦闘中TARGET被弾時口上
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == OPR_被弹 
		;別に一律で「やられたー」だけでもいいよ
		SELECTCASE 相手残機
			;残り残機3が表示されるのは【洽覧深識】持ちのみ
			CASE 3
				PRINTFORML 
			CASE 2
				PRINTFORML 「姆姆姆、果然是%CALLNAME:MASTER%大人呢」
				PRINTW 
			CASE 1
				PRINTFORML 「這真是太強了。典這边已經是風中殘燭了呢」
				IF HANDICAP_FIXED > 0
					PRINTFORML （好奇怪、明明%CALLNAME:MASTER%確實是在故意放水的）
					PRINTFORML （我居然仍被壓著打呢）
				ELSE
					IF ABL:戦闘能力 > ABL:MASTER:戦闘能力
						PRINTFORML （不可能！？　明明我應該是更強的、是我太低估能力了嗎！？）
					ELSE
						PRINTFORML （啊啊、真是的。雖如預期、但被打成這樣還真是有些不甘心呢）
					ENDIF
				ENDIF
			CASE 0
				IF HANDICAP_FIXED > 0
					PRINTFORML 「居然輸了！？　怎么可能…」
					PRINTFORML （這、這不可能吧！？）
					PRINTFORML （在被放水的狀況下、力量差距居然還如此的明顯！？）
					PRINTW 
				ELSE
					IF ABL:MASTER:戦闘能力 > 2
						PRINTFORML 「完敗了。真令人驚艷」
						IF (TALENT:MASTER:年齢 == -1 || TALENT:MASTER:幼児／幼児退行)
							IF TALENT:恋慕 || TALENT:恋人
								PRINTFORML 「可是、%CALLNAME:MASTER%大人的力量…」
								IF FLAG:周回数
									PRINTFORML （怎么說呢…這孩子的靈魂…靈性與普通孩子相比完全不同呢）
									PRINTFORML （難道、是輪迴不斷循環嗎？）
									PRINTFORML （這也太不可思議了吧。能力保持不变地輪迴轉生、這可不是普通人能做到的事情）
									PRINTFORML 「啊啊、没什么。只是姐姐的自言自語而已啦」
								ELSE
									IF TALENT:MASTER:動物耳
										IF (TALENT:MASTER:妖狐 || TALENT:MASTER:狐)
											PRINTFORML 「其实…跟八雲家的九尾大人有血緣關係嗎…」
										ELSE
											PRINTFORML 「跟我一樣長著獸耳朵…但其实流著名門妖怪的血液呢…」
											PRINTFORML 「嘛、可能不是跟我一樣的管狐啦」
											PRINTW 
											PRINTFORML （啊啊不過…）
											PRINTFORML （在各地都有著七十五隻的随從、在附身方面更是没有人能比得上的「同族」存在呢…確實、名字是…）
										ENDIF
									ELSE
										IF (TALENT:MASTER:妖狐 || TALENT:MASTER:狐)
											PRINTFORML 「顯然地混有妖怪的血液呢…而且還是相當強大的」
											PRINTFORML 典看著%CALLNAME:MASTER%的眼睛說道
											PRINTFORML 抗議臉貼太靠近時、典說著「又害羞了呀～♪」地抱了過來…
										ELSE
											PRINTFORM 「無論從哪个角度看
											IF (TALENT:MASTER:応答 == 1 || TALENT:MASTER:態度 == 1)
												PRINTFORML 都是一个相當囂張的人類小孩呢」
												PRINTFORML 对趁亂抱了上來而表示抗議
												PRINTFORML 「這樣不是很好嗎ー♪　\@ TALENT:恋人 ? 畢竟我们是戀人呢～♪ # 畢竟我只是擁抱喜歡的人而已呀～ \@」
												PRINTW 
											ELSE
												PRINTFORML 都是一个相當可愛的小孩呢」
												PRINTFORML 对被抱住會很害羞而表示抗議
												PRINTFORML 「這樣不是很好嗎ー♪　\@ TALENT:恋人 ? 畢竟我们是戀人呢～♪ # 畢竟我只是擁抱喜歡的人而已呀～ \@」
												PRINTW 
											ENDIF
										ENDIF
									ENDIF
								ENDIF
							;ショタ恋慕・恋人なし
							ELSE
								PRINTFORML 「「這小小的身體究竟是從哪里來這麼大的力量呢…」
								IF TALENT:MASTER:動物耳
									IF (TALENT:MASTER:妖狐 || TALENT:MASTER:狐)
										PRINTFORML 「其实…跟八雲家的九尾大人有血緣關係嗎…」
									ELSE
										PRINTFORML 「跟我一樣長著獸耳朵…但其实流著名門妖怪的血液呢…」
									ENDIF
								ELSE
									IF (TALENT:MASTER:妖狐 || TALENT:MASTER:狐)
										PRINTFORML 「顯然地混有妖怪的血液呢…而且還是相當強大的」
										PRINTFORML 典看著%CALLNAME:MASTER%的眼睛說道
										PRINTFORML 抗議臉貼太靠近時、典說著「又害羞了呀～♪」地抱了過來…
									ELSE
										PRINTFORM 「無論從哪个角度看
										IF (TALENT:MASTER:応答 == 1 || TALENT:MASTER:態度 == 1)
											PRINTFORML 都是一个相當囂張的人類小孩呢」
											PRINTFORML 对趁亂抱了上來而表示抗議
											PRINTFORML 「這樣不是很好嗎ー♪　累了的話可以靠在姐姐上休息的哦～」
											PRINTW 
										ELSE
											PRINTFORML 都是一个相當可愛的小孩呢」
											PRINTFORML 对被抱住會很害羞而表示抗議
											PRINTFORML 「這樣不是很好嗎ー♪　累了的話可以靠在姐姐上休息的哦～」
											PRINTW 
										ENDIF
									ENDIF
								ENDIF
							ENDIF
						;大人・戦闘能力3以上
						ELSE
							IF TALENT:恋慕 || TALENT:恋人
								PRINTFORML （強大的人…好喜歡♥）
								PRINTW 
								PRINTFORML 「已經不是我能对付的了、如果想追求強大的力量、最好找个同等強度的对手」
								PRINTFORML 「以%CALLNAME:MASTER%大人的情況來說的話…嗯…」
								SELECTCASE ABL:MASTER:戦闘能力
								CASE 6
									PRINTFORML 「地獄女神赫卡提亞大人、以及擁有能夠降臨神靈之身能力的月人綿月依姬大人…就這兩位吧」
									PRINTFORML 「如果能夠戰勝這兩位的話、%CALLNAME:MASTER%就會成为名副其实的幻想鄉最強者了呢」
									PRINTFORML 「…實際上也不僅限於幻想鄉内了呢」
								CASE 5
									PRINTFORML 「幻想鄉的閻魔大人四季映姬大人、棲息於地獄中的鬼的四天王之一、星熊勇儀大人等等…」
									PRINTFORML 「可以直接說是與『神』爭鬥的程度呢。天上人的戰鬥、典也完全不清楚是什么樣的呢」
									PRINTFORML 「飯綱丸大人的好友百百世大人也是這个範圍内的一員吧。那一位、可是有名的大妖呢」
									PRINTFORML 「聽說还有更高次元之上的戰鬥呢…唉、真是不可思議呀」
								CASE 4
									PRINTFORML 「我主飯綱丸大人、曾在某次異变中與我们合作的千亦大人、守矢神社的神明等等…」
									PRINTFORML 「对手的強度逐漸超越人類的極限了呢。不過也是理所當然的呢」
									PRINTFORML 「如果%CALLNAME:MASTER%大人希望的話、和飯綱丸大人的对練就由我來求情、您意下如何呢？」
								CASE 3
									PRINTFORML 「射命丸大人、姬海棠大人、犬走大人、守矢的青椒…咳咳、巫女大人都是適合的对手呢」
									PRINTFORML 「不過、天狗们个个都有一兩个怪癖呢…而巫女大人的底細還没有被完全知曉呢」
									PRINTFORML 「就目前來說、何不先和一本正經的犬走大人進行一場对戰試試看呢？」
								ENDSELECT
								PRINTW 
							ELSE
								PRINTFORML （咕嗚、戰力差距果然如此明顯呢）
								PRINTW 
								PRINTFORML 「%CALLNAME:MASTER%大人與我這種低級妖怪相比、更應該找一位更有實力的对手才对吧？」
								PRINTFORML 「比如我主或百百世大人那樣的…」
								SIF CFLAG:140:弾幕勝負勝利 == 1
									PRINTFORML 「……說起来、似乎已經從主人那里取得過勝利了呢」
								SIF CFLAG:142:弾幕勝負勝利 == 1
									PRINTFORML 「……啊啊、百百世大人也是一樣呢」
								IF CFLAG:98:弾幕勝負勝利 == 1 && CFLAG:113:弾幕勝負勝利 == 1
									PRINTFORML 「唔唔唔、那二位、被公認为幻想鄉最強者的絲卡提亞大人與綿月依姬大人…也被戰勝了嗎ー！　好煩呀ー！」
									PRINTFORML 「總感觉太過荒謬呢…」
									PRINTFORML 「要不要停一下呢？　指的是像瘋狗一樣到處找人彈幕对決」
								ENDIF
								PRINTFORML 「這麼強大的您、为什么要找典這樣的來做对手呢、真是讓人不解啊…」
							ENDIF
							PRINTW 
						ENDIF
						PRINTW 
					;あなたの戦闘能力2以下
					ELSE
						PRINTFORML 「不、表現得非常出色呢」
						IF (TALENT:MASTER:年齢 == -1 || TALENT:MASTER:幼児／幼児退行)
							IF TALENT:恋慕 || TALENT:恋人
								PRINTFORML 「果然是被姐姐看中的%CALLNAME:MASTER%大人、真是了不起呢♪」
								PRINTFORML 「你变得這麼強、姐姐也很开心哦♪　嗯ー啾～♪」
									PRINTFORM 在這混亂中典親了一下、
									IF (TALENT:MASTER:応答 == 1 || TALENT:MASTER:態度 == 1)
										PRINTFORML 讓%CALLNAME:MASTER%嚇得紧张到發僵
									ELSE
										PRINTFORML 讓%CALLNAME:MASTER%臉頰泛紅
									ENDIF
									PRINTW 
							ELSE
								IF TALENT:MASTER:性別 == 2
									PRINTFORML 「雖然有句諺語說『士別三日、刮目相看』但…」
									PRINTFORML 「变得更強了呢。姐姐已經無法與之匹敵了呢」
									PRINTFORM 典轻轻摸了摸頭
									IF (TALENT:MASTER:応答 == 1 || TALENT:MASTER:態度 == 1)
										PRINTFORML 、但%CALLNAME:MASTER%没有拍开那只手
									ELSE
										PRINTFORML 、%CALLNAME:MASTER%露出了害羞的笑容
									ENDIF
								ELSE
									PRINTFORML 「像我這種程度的妖怪、只要不大意應該就不會輸了呢」
									PRINTFORML 「不過不過、也有那種既強大也很狡猾的妖怪呢、所以姐姐的指導也還是有必要的呢」
								ENDIF
								PRINTW 
							ENDIF
						ELSE
							IF TALENT:恋慕 || TALENT:恋人
								PRINTFORML （不愧是我所迷戀的人…♥）
								PRINTW 
								PRINTFORML 「不過、還請不要大意呢」
								PRINTFORML 「典的實力、在妖怪中堪稱下下等。從我往下數能轻轻鬆鬆的數過來」
								PRINTFORML 「先不說有更強大的妖怪存在、就連比%CALLNAME:MASTER%大人弱的妖怪之中、也不乏狡猾的傢伙」
								PRINTFORML 「所以請不要掉以轻心、請努力精進。典、也會盡微薄之力協助你的」
							ELSE
								PRINTFORML （這傢伙、原本我以为會比我還要弱呢）
								PRINTFORML （我果然、不太適合做這種肉體勞动呢）
							ENDIF
							PRINTW 
						ENDIF
					ENDIF
				ENDIF
		ENDSELECT
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【残忍酷薄】発動時: 相手の被弾からの復帰時のボム数が-1される
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == OPR_残忍酷薄
		SELECTCASE RAND:3
		CASE 0
			PRINTFORML 「被『那个』擊中的話可是麻煩事呢…還是給你封印起来吧」
			PRINTW 
		CASE 1
			PRINTFORML 「封鎖对手的後路。這是戰鬥的基本吧」
			PRINTW 
		CASE 2
			PRINTFORML 「呵呵呵…我可不會放水的哦」
			PRINTW 
		ENDSELECT
		PRINTW 
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【乾坤一擲】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == OPR_乾坤一掷
		
	ENDIF
	;-------------------------------------------------
	;戦闘中
	;TARGETの【怪力乱神】発動時
	;ARGはTARGETの残機
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 0
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == OPR_怪力乱神
		
	ENDIF
	
	;-------------------------------------------------
	;戦闘後
	;記入チェック（=0, 非表示、1, 表示）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && ARGS == OPR_战斗后 
		PRINTFORML 
		;残り残機4が表示されうるのは【洽覧深識】持ちのみ
		;残機が1以上ならあなたの負け、0の場合はあなたの勝利
		SELECTCASE 相手残機
		CASE 4
			PRINTFORML 
		CASE 3
			;ハンデ付き負け。ここぞとばかりに煽られる
			;あなたの素質で煽り内容が変化（増加）
			IF HANDICAP_FIXED > 0
				CALL HPH_PRINT,@"「雜魚HPH　魚HPH」","L"
				CALL HPH_PRINT,@"「得意忘形地加上限制、然後完敗給管狐了HPH」","L"
				SIF TALENT:MASTER:非童貞 == 0
					CALL HPH_PRINT,@"「處男HPH」","L"
				SIF (TALENT:MASTER:形状 == 1 || TALENT:MASTER:形状 == 2)
					CALL HPH_PRINT,@"「短小HPH　包莖HPH」","L"
				SIF TALENT:MASTER:応答 == -1
					CALL HPH_PRINT,@"「死社恐HPH」","L"
				SIF TALENT:MASTER:胆量 == -1
					CALL HPH_PRINT,@"「没出息HPH　只會欺軟怕硬HPH」","L"
				SIF ABL:MASTER:話術技能 < 1
					CALL HPH_PRINT,@"「只會对自己感興趣的东西講个不停HPH　一點都不會找話題HPH」","L"
				SIF ABL:MASTER:料理技能 < 1
					CALL HPH_PRINT,@"「明明就不擅長做菜還一直不按食譜做出難吃死了的料理HPH」","L"
				SIF ABL:MASTER:音楽技能 < 1
					CALL HPH_PRINT,@"「玩樂器只學了个樣子真是浪費HPH」","L"
				SIF (TALENT:MASTER:酒耐性 == -2 || TALENT:MASTER:形状 == -1)
					CALL HPH_PRINT,@"「一喝點酒就滿臉通紅的HPH」","L"
				CALL HPH_PRINT,@"「真是、無可救藥的廢柴呢HPH」","L"
				SIF TALENT:恋慕
					CALL HPH_PRINT,@"「不過我就是最喜歡這樣的你了呢HPH」","L"
				
