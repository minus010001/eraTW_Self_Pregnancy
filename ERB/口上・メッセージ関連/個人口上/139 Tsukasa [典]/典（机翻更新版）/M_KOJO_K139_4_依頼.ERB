		SELECTCASE RAND:3
			CASE 0
				;このお悩みは、恋慕で発生し、親密によって正解が変わります
				SIF TALENT:恋慕
					RESULT = 1
				RESULTS:0 = 赤ちゃん作るなら何人がいいかな？
				RESULTS:1 = ５人でバスケチームを作ろう
				RESULTS:2 = ９人で野球チームを作ろう
				RESULTS:3 = １１人でサッカーチームを作ろう
				IF ABL:親密 >= 100
					RESULT:1 = 3
				ELSEIF ABL:親密 >= 20
					RESULT:1 = 2
				ELSE
					RESULT:1 = 1
				ENDIF
			CASE 1
				;このお悩みは、無条件で発生し、正解は絶対に2番で固定化されます
				SIF 1
					RESULT = 1
				RESULTS:0 = どのジョブがいいかな？
				RESULTS:1 = かっこいしナイト
				RESULTS:2 = シーフが便利だよ
				RESULTS:3 = 青魔道士最強！
				RESULT:1 = 2
				RESULT:2 = 1
			CASE 2
				;このお悩みは、夏の月に発生し、正解がランダムで変わります
				SIF DAY:2 == 2
					RESULT = 1
				RESULTS:0 = どの水着を買おうかな？
				RESULTS:1 = かわいいワンピース
				RESULTS:2 = クールなセパレート
				RESULTS:3 = 色っぽいビキニ
				RESULT:1 = RAND:3 + 1
		ENDSELECT
		[SKIPEND]

		SIF !RESULT
			RESTART
		RETURN 1
ENDSELECT

