;--------------------------------------------------
SELECTCASE SCENE
	CASE OPR_委托提示时
		IF (TALENT:MASTER:年齢 == -1 || TALENT:MASTER:幼児／幼児退行||CFLAG:139:1050 == 1)
			IF CFLAG:1020 == 1
				PRINTFORML 「%CALLNAME:MASTER%阁下…♪ 和姐姐再做『好事』吧…♪」
				PRINTFORMDL 典一边抚摸着自己的下腹部，一边诱惑道
				PRINTW
			ELSE
				PRINTFORML 「%CALLNAME:MASTER%阁下…要不要和姐姐『做·好·事』呢…♪」
				PRINTFORMDL 典一边从背后抱着%CALLNAME:MASTER%，一边搭话道
				PRINTW
				PRINTFORML 「这不难。只要让姐姐舒服就行了…♪」
				IF TALENT:MASTER:無知
					PRINTFORML 「……啊—，您这真是摆出一副完全不知道该做什么的表情呢…」
					PRINTFORML 「这不难。只要按照姐姐的指示抚摸身体，或者放松就行了♪」
					PRINTFORML 「如果表现好，会给您很多零花钱哦♪」
				ELSE
					IF TALENT:MASTER:非童貞 == 0
						PRINTFORML 「即使没有经验也懂的吧？您不是也总是偷看姐姐的屁股嘛♪」
						PRINTFORMDL 典狡黠一笑，在耳边轻轻低语
						SETCOLOR 0xFF69B4
						CALL HPH_PRINT,@"「和姐姐，做爱吧…HPH」","L"
						RESETCOLOR
					ELSE
						CALL HPH_PRINT,@"「没错。只要和姐姐做爱就好了…HPH」","L"
						CALL HPH_PRINT,@"「如果让姐姐非常舒服的话，也会给零花钱哦HPH」","L"
						PRINTW
						PRINTFORMDL 说着，典用手指比出数字
						CALL HPH_PRINT,@"「怎么样？ 我想这不是什么坏条件吧…HPH」","L"
						PRINTFORMDL 典一边抚摸着%CALLNAME:MASTER%的下腹部，一边等待着答复
					ENDIF
				ENDIF
			ENDIF
		ELSE
			IF CFLAG:1020 == 1
				PRINTFORML 「%CALLNAME:MASTER%，能不能…♪ 再给我你的\@ (TALENT:MASTER:性別 == 2 || TALENT:MASTER:性別 == 3) ? 鸡鸡 # 身体\@呢♪」
				PRINTFORMDL 典一边抚摸着%CALLNAME:MASTER%的下腹部，一边诱惑着
				PRINTW
				CALL HPH_PRINT,@"「请安抚女狐之躯的疼痛HPH，\@ (TALENT:MASTER:性別 == 2 || TALENT:MASTER:性別 == 3) ? 尽情中出HPH # \@ 尽情侵犯典吧…HPH」","L"
				PRINTW
			ELSE
				PRINTFORML 「%CALLNAME:MASTER%，可以拜托一件事吗…」
				PRINTFORMDL 典依偎在%CALLNAME:MASTER%身旁，用手指在脸颊上轻轻划过
				CALL HPH_PRINT,@"「能抱抱典吗…HPH」","L"
				PRINTW
				IF TALENT:MASTER:無知
					PRINTFORMDL %CALLNAME:MASTER%轻轻抱住了典
					PRINTFORML 「哇，%CALLNAME:MASTER%阁下好温暖啊…等等，我说的不是那个抱啦」
					PRINTFORMDL 典稍微拉开了一点距离，然后做出了把什么东西推到一旁的动作
					PRINTW
					PRINTFORML 「身为人类却到了这个年纪还在那方面很迟钝什么的…莫非是不食五谷杂粮的吗？」
					PRINTFORML 「嘛，既然也有食欲旺盛的仙人大人，或许有这样的人类也无妨呢…」
					PRINTW
					PRINTFORML 「…哎呀，话题扯远了」
					PRINTFORML 「简单来说，就是希望您能通过『抚摸』或『揉搓』来帮典放松身体的『僵硬』…♪」
					PRINTFORML 「做法典会指导您的，当然也会支付报酬哦♪」
					PRINTW
					PRINTFORML 「怎么样？能接受吗？」
					PRINTW
				ELSE
					PRINTFORMDL 抚摸脸颊的手，另一只手则伸向%CALLNAME:MASTER%的股间，五指灵巧地施加着爱抚
					PRINTFORMDL 仿佛在说，这是我的东西
					PRINTW
					CALL HPH_PRINT,@"「工作原因，需要顾虑很多…偶尔像这样放松一下，不是吗…HPH」","L"
