			TRYCALLFORM M_KOJO%KOJO_NAME%_DAILY_EVENT_MESSAGECHECK_K{NO:TARGET}_{ARG:1}
			SKIP_MESSAGE = GETBIT(RESULT, 0)
			SKIP_KOJO = GETBIT(RESULT, 1)
