			RESETCOLOR
		ENDIF
		TARGET = LOCAL
	;デイリーイベント,DIARYと綴り間違えなように
	CASE "DAILY"
		SIF FLAG:情景文本設定 <= 0 && FLAG:口上文本設定 <= 0
			RETURN -1

		LOCAL = TARGET
		TARGET = ARG:2

		;テキスト設定
		IF FLAG:口上文本設定 <= 0
		ELSE
			CALL KOJO_ACTIVE_INFO(TARGET)
			KOJO_VALID = RESULT
			KOJO_NAME '= RESULTS
				
