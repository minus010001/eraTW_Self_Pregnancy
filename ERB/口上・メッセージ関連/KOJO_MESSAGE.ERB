		SIF !SKIP_MESSAGE && FLAG:情景文本設定 > 0
			TRYCALLFORM DAILY_MESSAGE_{ARG:1}(ARG:2, ARG:3, ARG:4, ARG:5, ARG:6, ARGS:1, ARGS:2)

		RESULT = 0
		IF KOJO_VALID && !SKIP_KOJO
			SIF FLAG:口上色
				TRYCALLFORM M_KOJO%KOJO_NAME%_COLOR_K{NO:TARGET}
