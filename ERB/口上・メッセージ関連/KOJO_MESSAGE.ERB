		IF FLAG:口上文本設定 > 0
			CALL KOJO_ACTIVE_INFO(TARGET)
			;TARGET口上出力
			SIF FLAG:口上色
				TRYCALLFORM M_KOJO%RESULTS%_COLOR_K{NO:TARGET}
			RESULT = 0
			TRYCALLFORM M_KOJO%RESULTS%_IRAI_K{NO:TARGET}(ARGS:1, ARGS:2, ARG:2)
			RESETCOLOR
		ENDIF
		TARGET = LOCAL
		RETURN RESULT
	;贈り物
	CASE "GIFT"
		LOCAL = TARGET
		TARGET = ARG:2
		;口上表示
		IF FLAG:口上文本設定 > 0
			CALL KOJO_ACTIVE_INFO(TARGET)
			;TARGET口上出力
			SIF FLAG:口上色
				TRYCALLFORM M_KOJO%RESULTS%_COLOR_K{NO:TARGET}
