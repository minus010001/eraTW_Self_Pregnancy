;==========================================================
; Phase 0 + Phase 1 B.1/B.2 Bugfix 验证测试
; 基于 REFACTOR_HANDBOOK.md 方案，commit b76ddb35
;
; 注意：
;   - long.MinValue (-9223372036854775808) 不能作为字面量写入 ERB
;     因为解析器先读 9223372036854775808 已溢出。
;     改用运行时计算：MAX = 9223372036854775807; MIN = -MAX - 1
;   - LOCAL 数组大小受 VariableSize.csv 限制，测试不超出默认范围
;==========================================================

@Phase01Bugfix
	PRINTL ============================================
	PRINTL  Phase 0 + Phase 1 Bugfix 验证测试
	PRINTL ============================================
	PRINTL

	CALL TEST_A1_CONVERTARG
	CALL TEST_A1_TRY_SAFETY
	CALL TEST_A2_SAFE_ARITHMETIC
	CALL TEST_A2_TIMES_OVERFLOW
	CALL TEST_A2_INCREMENT_OVERFLOW
	CALL TEST_A2_PLUSVALUE_OVERFLOW
	CALL TEST_INITRAND_DECOUPLE
	CALL TEST_B1_EXECUTION_CONTEXT
	CALL TEST_B2_SPARSE_ARRAY

	PRINTL
	PRINTL ============================================
	PRINTL  全部测试完成
	PRINTL ============================================

	ONEINPUT

;==========================================================
; Phase 0 — A.1 ConvertArg() 多余参数静默丢弃
;==========================================================
@TEST_A1_CONVERTARG
	PRINTL ----------------------------------------
	PRINTL  [Phase 0 A.1] ConvertArg 多余参数静默丢弃
	PRINTL ----------------------------------------

	LOCAL = 0
	CALL FUNC_TWO_ARGS(10, 20, 30, 40)
	LOCAL = RESULT

	PRINTFORML  CALL FUNC_TWO_ARGS(10,20,30,40) → RESULT={LOCAL}
	IF LOCAL == 30
		PRINTL  [PASS] 多余参数被静默丢弃，前两个参数正确接收
	ELSE
		PRINTL  [FAIL] 预期 RESULT=30，实际 RESULT={LOCAL}
	ENDIF
	PRINTL
	RETURN

@FUNC_TWO_ARGS(ARG:0, ARG:1)
	RESULT = SUMARRAY(ARG)
	RETURN RESULT

;==========================================================
; Phase 0 — A.1 CALL_Instruction isTry 安全网
;==========================================================
@TEST_A1_TRY_SAFETY
	PRINTL ----------------------------------------
	PRINTL  [Phase 0 A.1] TRYCALL isTry 安全网
	PRINTL ----------------------------------------

	LOCALS '= "TRYCALL 正常执行后应到达此处"

	TRYCALL NONEXISTENT_FUNCTION_XYZ
	PRINTFORML  %LOCALS%
	PRINTL  [PASS] TRYCALL 不存在的函数未崩溃

	TRYCALL FUNC_TWO_ARGS(1, 2, 999, 888)
	PRINTFORML  TRYCALL FUNC_TWO_ARGS(1,2,999,888) → RESULT={RESULT}
	PRINTL  [PASS] TRYCALL 多余参数未崩溃

	PRINTL
	RETURN

;==========================================================
; Phase 0 — A.2 SafeArithmetic 运算溢出保护
;
; MAX = 9223372036854775807 (long.MaxValue，合法字面量)
; MIN = -MAX - 1 = -9223372036854775808 (long.MinValue，运行时计算)
;==========================================================
@TEST_A2_SAFE_ARITHMETIC
	#DIM LONG_MAX
	#DIM LONG_MIN
	PRINTL ----------------------------------------
	PRINTL  [Phase 0 A.2] SafeArithmetic 运算溢出保护
	PRINTL ----------------------------------------

	LONG_MAX = 9223372036854775807
	LONG_MIN = -LONG_MAX - 1

	PRINTFORML  LONG_MAX = {LONG_MAX}
	PRINTFORML  LONG_MIN = {LONG_MIN}

	LOCAL:0 = LONG_MAX
	LOCAL:1 = 1
	LOCAL:2 = LOCAL:0 + LOCAL:1
	PRINTFORML  MaxValue + 1 = {LOCAL:2}
	IF LOCAL:2 == LONG_MAX
		PRINTL  [PASS] 加法溢出饱和到 MaxValue
	ELSE
		PRINTL  [FAIL] 加法溢出未饱和，值={LOCAL:2}
	ENDIF

	LOCAL:0 = LONG_MIN
	LOCAL:1 = 1
	LOCAL:2 = LOCAL:0 - LOCAL:1
	PRINTFORML  MinValue - 1 = {LOCAL:2}
	IF LOCAL:2 == LONG_MIN
		PRINTL  [PASS] 减法溢出饱和到 MinValue
	ELSE
		PRINTL  [FAIL] 减法溢出未饱和，值={LOCAL:2}
	ENDIF

	LOCAL:0 = 3037000500
	LOCAL:1 = 3037000500
	LOCAL:2 = LOCAL:0 * LOCAL:1
	PRINTFORML  3037000500 * 3037000500 = {LOCAL:2}
	IF LOCAL:2 == LONG_MAX
		PRINTL  [PASS] 乘法溢出饱和到 MaxValue
	ELSEIF LOCAL:2 < 0
		PRINTL  [FAIL] 乘法溢出回绕为负数，值={LOCAL:2}
	ELSE
		PRINTL  [WARN] 乘法溢出结果不确定，值={LOCAL:2}
	ENDIF

	LOCAL:0 = 100
	LOCAL:1 = 0
	LOCAL:2 = LOCAL:0 / LOCAL:1
	PRINTFORML  100 / 0 = {LOCAL:2}
	IF LOCAL:2 == 0
		PRINTL  [PASS] 零除返回 0
	ELSE
		PRINTL  [FAIL] 零除未返回 0，值={LOCAL:2}
	ENDIF

	LOCAL:0 = 100
	LOCAL:1 = 0
	LOCAL:2 = LOCAL:0 % LOCAL:1
	PRINTFORML  100 \% 0 = {LOCAL:2}
	IF LOCAL:2 == 0
		PRINTL  [PASS] 取模零除返回 0
	ELSE
		PRINTL  [FAIL] 取模零除未返回 0，值={LOCAL:2}
	ENDIF

	LOCAL:0 = LONG_MIN
	LOCAL:2 = -LOCAL:0
	PRINTFORML  -MinValue = {LOCAL:2}
	IF LOCAL:2 == LONG_MAX
		PRINTL  [PASS] 取反溢出饱和到 MaxValue
	ELSE
		PRINTL  [FAIL] 取反溢出未饱和，值={LOCAL:2}
	ENDIF

	PRINTL
	RETURN

;==========================================================
; Phase 0 — A.2 TIMES 溢出保护
;==========================================================
@TEST_A2_TIMES_OVERFLOW
	#DIM LONG_MAX
	#DIM LONG_MIN
	PRINTL ----------------------------------------
	PRINTL  [Phase 0 A.2] TIMES 溢出保护
	PRINTL ----------------------------------------

	LONG_MAX = 9223372036854775807
	LONG_MIN = -LONG_MAX - 1

	LOCAL = LONG_MAX
	TIMES LOCAL, 2.0
	PRINTFORML  TIMES MaxValue * 2.0 = {LOCAL}
	IF LOCAL == LONG_MAX
		PRINTL  [PASS] TIMES 溢出饱和到 MaxValue
	ELSE
		PRINTL  [FAIL] TIMES 溢出未饱和，值={LOCAL}
	ENDIF

	LOCAL = LONG_MIN
	TIMES LOCAL, 2.0
	PRINTFORML  TIMES MinValue * 2.0 = {LOCAL}
	IF LOCAL == LONG_MIN
		PRINTL  [PASS] TIMES 溢出饱和到 MinValue
	ELSE
		PRINTL  [FAIL] TIMES 溢出未饱和，值={LOCAL}
	ENDIF

	LOCAL = 100
	TIMES LOCAL, 1.5
	PRINTFORML  TIMES 100 * 1.5 = {LOCAL}
	IF LOCAL == 150
		PRINTL  [PASS] TIMES 正常乘法正确
	ELSE
		PRINTL  [FAIL] TIMES 正常乘法不正确，值={LOCAL}
	ENDIF

	PRINTL
	RETURN

;==========================================================
; Phase 0 — A.2 Increment/Decrement 溢出保护
;==========================================================
@TEST_A2_INCREMENT_OVERFLOW
	#DIM LONG_MAX
	#DIM LONG_MIN
	PRINTL ----------------------------------------
	PRINTL  [Phase 0 A.2] Increment/Decrement 溢出保护
	PRINTL ----------------------------------------

	LONG_MAX = 9223372036854775807
	LONG_MIN = -LONG_MAX - 1

	LOCAL = LONG_MAX
	LOCAL ++
	PRINTFORML  MaxValue++ = {LOCAL}
