;==========================================================
; B.3 冒烟测试 —— EraType 类型系统 + 浮点变量
;
; 运行时机：每完成 B.3 一个子层后运行对应测试
;
; @B3_SMOKE_TEST → TEST_B3_FULL（全量）
;   ├── TEST_B3_TYPE_SYSTEM   (B.3-1: 类型系统基础设施)
;   ├── TEST_B3_FLOAT_BASIC   (B.3-5: 浮点基本运算)
;   ├── TEST_B3_REGRESSION    (B.3: 踩坑回归)
;   └── Phase01Bugfix         (回归: 现有脚本零影响)
;==========================================================

@B3_SMOKE_TEST
	PRINTL ============================================
	PRINTL  B.3 类型系统冒烟测试
	PRINTL ============================================
	PRINTL

	CALL TEST_B3_FULL

	PRINTL
	PRINTL ============================================
	PRINTL  B.3 冒烟测试完成
	PRINTL ============================================
	ONEINPUT

;==========================================================
; B.3-1 后运行：类型系统基础设施验证
;
; 验证点：
;   1. Integer/String 变量读写不受 E-Type 迁移影响
;   2. 所有内置变量仍可通过原 VariableCode 路径访问
;   3. 表达式运算 IntInt/StrStr 路径不受影响
;==========================================================
@TEST_B3_TYPE_SYSTEM
	#DIM DYNAMIC temp_var, 10
	PRINTL ----------------------------------------
	PRINTL  [B.3-1] 类型系统基础设施
	PRINTL ----------------------------------------

	;--- 测试1：Integer 标量/数组正常 ---
	LOCAL:0 = 42
	LOCAL:1 = LOCAL:0 + 8
	PRINTFORML  LOCAL:0=42, LOCAL:0+8={LOCAL:1}
	IF LOCAL:1 == 50
		PRINTL  [PASS] Integer 运算正常
	ELSE
		PRINTL  [FAIL] Integer 运算异常！预期 50，实际 {LOCAL:1}
	ENDIF

	;--- 测试2：String 标量/数组正常 ---
	LOCALS:0 '= "hello"
	LOCALS:1 '= LOCALS:0 + " world"
	PRINTFORML  LOCALS:0="hello", 拼接后="%LOCALS:1%"
	IF LOCALS:1 == "hello world"
		PRINTL  [PASS] String 运算正常
	ELSE
		PRINTL  [FAIL] String 运算异常！预期 "hello world"，实际 "%LOCALS:1%"
	ENDIF

	;--- 测试3：内置变量 Integer 正常 ---
	RESULT = 123
	IF RESULT == 123
		PRINTL  [PASS] RESULT 读写正常
	ELSE
		PRINTL  [FAIL] RESULT 读写异常
	ENDIF

	;--- 测试4：内置变量 String 正常 ---
	RESULTS '= "test_results"
	IF RESULTS == "test_results"
		PRINTL  [PASS] RESULTS 读写正常
	ELSE
		PRINTL  [FAIL] RESULTS 读写异常
	ENDIF

	;--- 测试5：字符变量正常 ---
	LOCAL:0 = DAY
	DAY += 1
	LOCAL:1 = DAY
	DAY -= 1
	IF LOCAL:1 == LOCAL:0 + 1
		PRINTL  [PASS] DAY 自增/自减正常
	ELSE
		PRINTL  [FAIL] DAY 自增/自减异常
	ENDIF

	;--- 测试6：Int/String 混合表达式不受影响 ---
	LOCALS:0 '= "num "
	LOCALS:0 '= LOCALS:0 + TOSTR(42)
	IF LOCALS:0 == "num 42"
		PRINTL  [PASS] Int→String 隐式转换正常
	ELSE
		PRINTL  [FAIL] 隐式转换异常！预期 "num 42"，实际 "%LOCALS:0%"
	ENDIF

	;--- 测试7：比较运算符正常 ---
	LOCAL:0 = 100
	LOCAL:1 = 200
	IF LOCAL:0 < LOCAL:1
		PRINTL  [PASS] Int 比较运算符正常
	ELSE
		PRINTL  [FAIL] Int 比较运算符异常
	ENDIF

	;--- 测试8：位运算正常 ---
	LOCAL:0 = 0x0F
	LOCAL:1 = LOCAL:0 & 0x03
	IF LOCAL:1 == 0x03
		PRINTL  [PASS] Int 位运算正常
	ELSE
		PRINTL  [FAIL] Int 位运算异常
	ENDIF

	;--- 测试9：#DIM DYNAMIC 不受影响 ---
	temp_var:0 = 999
	IF temp_var:0 == 999
		PRINTL  [PASS] #DIM DYNAMIC 读写正常
	ELSE
		PRINTL  [FAIL] #DIM DYNAMIC 读写异常
	ENDIF

	;--- 测试10：内置函数调用正常 ---
	LOCAL:0 = MAX(5, 10)
	PRINTFORML  MAX(5,10)={LOCAL:0}
	IF LOCAL:0 == 10
		PRINTL  [PASS] 内置函数 MAX 正常
	ELSE
		PRINTL  [FAIL] 内置函数 MAX 异常
	ENDIF

	LOCAL:0 = STRLENS("abc")
	IF LOCAL:0 == 3
		PRINTL  [PASS] 内置函数 STRLENS 正常
	ELSE
		PRINTL  [FAIL] 内置函数 STRLENS 异常
	ENDIF

	PRINTL
	RETURN

;==========================================================
; B.3-5 后运行：浮点变量基本运算
;
; 验证点：
;   1. #DIMF 声明浮点变量
;   2. 浮点字面量解析
;   3. Int↔Float 隐式提升
;   4. Float↔Int 显式转换 TOINT()
;   5. Float↔String 显式转换 TOFLOAT()/TOSTRF()
;==========================================================
@TEST_B3_FLOAT_BASIC
	#DIMF FVAL = 3.14
	#DIMF RATE = 1.5
	#DIM _I = 42
	#DIMF _F = 3.14
	PRINTL ----------------------------------------
	PRINTL  [B.3-5] 浮点变量基本运算
	PRINTL ----------------------------------------


	PRINTFORML  FVAL = {FVAL}
	PRINTFORML  RATE = {RATE}

	LOCAL:0 = 100
	FVAL = LOCAL:0 * RATE
	PRINTFORML  100 * 1.5 = {FVAL}
	IF FVAL == 150.0
		PRINTL  [PASS] Int*Float 隐式提升正常
	ELSE
		PRINTL  [FAIL] Int*Float 隐式提升异常
	ENDIF

	LOCAL:0 = TOINT(3.14)
	IF LOCAL:0 == 3
		PRINTL  [PASS] TOINT(3.14)=3 截断正常
	ELSE
		PRINTL  [FAIL] TOINT 截断异常
	ENDIF

	IF 1.0 < 2.0
		PRINTL  [PASS] Float 比较正常
	ELSE
		PRINTL  [FAIL] Float 比较异常
	ENDIF

	PRINTFORML  [DIAG] _I={_I}, _F={_F}
	LOCAL:0 = TOINT(_F)
	PRINTFORML  [DIAG] TOINT(_F)={LOCAL:0}
	_I = _I + TOINT(_F)
	PRINTFORML  [DIAG] _I + TOINT(_F) = {_I}
	IF _I == 45
		PRINTL  [PASS] Int/Float 混合运算正常
	ELSE
		PRINTL  [FAIL] Int/Float 混合运算异常！预期 45，实际 {_I}
	ENDIF

	PRINTL
	RETURN

;==========================================================
; B.3 回归测试 —— 覆盖开发中踩过的所有坑
;
; 验证点：
;   1. Float 初始化（曾不生效）
;   2. Float 类型身份（曾被误判为 String）
;   3. 全运算符矩阵（曾缺失）
;   4. 跨类型比较（隐式提升）
;   5. TOFLOAT / TOSTRF（从未测试）
;   6. Float 一元取负
;   7. Float 除法精度
;   8. TIMES Float
;   9. 隔离复现 Int/Float 混合运算失败
;==========================================================
@TEST_B3_REGRESSION
	#DIMF RX = 3.14
	#DIMF RY
	#DIMF RN = -1.5
	#DIMF RA = 3.0
	#DIMF RB = 2.0
	#DIMF RC
	#DIM RI = 42
	#DIMF RF = 3.14
	PRINTL ----------------------------------------
	PRINTL  [B.3-REGRESSION] 踩坑回归测试
	PRINTL ----------------------------------------

	;=== 1. Float 初始化 ===
	PRINTFORML  [INIT] RX={RX}
	IF RX == 3.14
		PRINTL  [PASS] #DIMF 初始化 3.14 正常
	ELSE
		PRINTL  [FAIL] #DIMF 初始化异常！预期 3.14，实际 {RX}
	ENDIF

	;=== 2. Float 默认值 ===
	PRINTFORML  [INIT] RY(默认)={RY}
	IF RY == 0.0
		PRINTL  [PASS] #DIMF 默认值 0.0 正常
	ELSE
		PRINTL  [FAIL] #DIMF 默认值异常！预期 0.0，实际 {RY}
	ENDIF

	;=== 3. Float 负数 ===
	IF RN == -1.5
		PRINTL  [PASS] Float 负数正常
	ELSE
		PRINTL  [FAIL] Float 负数异常！预期 -1.5，实际 {RN}
	ENDIF

	;=== 4. Float 类型身份（非 String） ===
	LOCAL:0 = TOINT(RX + 1)
	IF LOCAL:0 == 4
		PRINTL  [PASS] Float 变量非 String（TOINT(RX+1)=4 截断正确）
	ELSE
		PRINTL  [FAIL] Float 变量可能被误判为 String！TOINT(RX+1)={LOCAL:0}
	ENDIF

	;=== 5. Float-Float 运算符 ===
	RC = RA + RB
	IF RC == 5.0
		PRINTL  [PASS] Float+Float 正常
	ELSE
		PRINTL  [FAIL] Float+Float 异常！预期 5.0，实际 {RC}
	ENDIF

	RC = RA - RB
	IF RC == 1.0
		PRINTL  [PASS] Float-Float 正常
	ELSE
		PRINTL  [FAIL] Float-Float 异常！预期 1.0，实际 {RC}
	ENDIF

	RC = RA * RB
	IF RC == 6.0
		PRINTL  [PASS] Float*Float 正常
	ELSE
		PRINTL  [FAIL] Float*Float 异常！预期 6.0，实际 {RC}
	ENDIF

	RC = RA / RB
	IF RC == 1.5
		PRINTL  [PASS] Float/Float 正常
	ELSE
		PRINTL  [FAIL] Float/Float 异常！预期 1.5，实际 {RC}
	ENDIF

	;=== 6. Int-Float 运算符 ===
	LOCAL:0 = 3
	RC = LOCAL:0 + RB
	IF RC == 5.0
		PRINTL  [PASS] Int+Float 正常
	ELSE
		PRINTL  [FAIL] Int+Float 异常！预期 5.0，实际 {RC}
	ENDIF

	RC = LOCAL:0 - RB
	IF RC == 1.0
		PRINTL  [PASS] Int-Float 正常
	ELSE
		PRINTL  [FAIL] Int-Float 异常！预期 1.0，实际 {RC}
	ENDIF

	RC = LOCAL:0 * RB
	IF RC == 6.0
		PRINTL  [PASS] Int*Float 正常
	ELSE
		PRINTL  [FAIL] Int*Float 异常！预期 6.0，实际 {RC}
	ENDIF

	RC = LOCAL:0 / RB
	IF RC == 1.5
		PRINTL  [PASS] Int/Float 正常
	ELSE
		PRINTL  [FAIL] Int/Float 异常！预期 1.5，实际 {RC}
	ENDIF

	;=== 7. Float-Int 运算符 ===
	RC = RA + LOCAL:0
	IF RC == 6.0
		PRINTL  [PASS] Float+Int 正常
	ELSE
		PRINTL  [FAIL] Float+Int 异常！预期 6.0，实际 {RC}
	ENDIF

	;=== 8. Float 一元取负 ===
	RC = -RA
	IF RC == -3.0
		PRINTL  [PASS] Float 取负正常
	ELSE
		PRINTL  [FAIL] Float 取负异常！预期 -3.0，实际 {RC}
	ENDIF

	;=== 9. Float 除法精度 ===
	RC = 10.0 / 3.0
	PRINTFORML  [PREC] 10.0/3.0 = {RC}
	IF RC > 3.3
		IF RC < 3.34
			PRINTL  [PASS] Float 除法精度正常
		ELSE
			PRINTL  [FAIL] Float 除法精度异常！值={RC}
		ENDIF
	ELSE
		PRINTL  [FAIL] Float 除法精度异常！值={RC}
	ENDIF

	;=== 10. 跨类型相等比较 ===
	IF 1 == 1.0
		PRINTL  [PASS] 1==1.0 跨类型相等正常
	ELSE
		PRINTL  [FAIL] 1==1.0 跨类型相等异常
	ENDIF

	IF 1.0 == 1
		PRINTL  [PASS] 1.0==1 跨类型相等正常
	ELSE
		PRINTL  [FAIL] 1.0==1 跨类型相等异常
	ENDIF

	;=== 11. TIMES Float ===
	RC = 100.0
	TIMES RC, 1.5
	IF RC == 150.0
		PRINTL  [PASS] TIMES Float 正常
	ELSE
		PRINTL  [FAIL] TIMES Float 异常！预期 150.0，实际 {RC}
	ENDIF

	;=== 12. TOFLOAT ===
	RC = TOFLOAT("3.14")
	IF RC == 3.14
		PRINTL  [PASS] TOFLOAT("3.14") 正常
	ELSE
		PRINTL  [FAIL] TOFLOAT 异常！预期 3.14，实际 {RC}
	ENDIF

	;=== 13. 隔离复现：Int/Float 混合运算 ===
	PRINTFORML  [ISOLATE] RI={RI}, RF={RF}
	LOCAL:0 = TOINT(RF)
	PRINTFORML  [ISOLATE] TOINT(RF)={LOCAL:0}
	RI = RI + TOINT(RF)
	PRINTFORML  [ISOLATE] RI + TOINT(RF) = {RI}
	IF RI == 45
		PRINTL  [PASS] Int/Float 混合运算（隔离）正常
	ELSE
		PRINTL  [FAIL] Int/Float 混合运算（隔离）异常！预期 45，实际 {RI}
	ENDIF

	PRINTL
	RETURN

;==========================================================
; B.3-8/9/10 后运行：浮点数数组、函数参数、返回值
;
; 验证点：
;   1. LOCALF / ARGF 数组读写
;   2. RESULTF 全局浮点返回值
;   3. #FUNCTIONF 用户自定义 Float 返回函数
;   4. Int→Float 函数参数自动提升
;   5. #LOCALFSIZE 指令
;==========================================================
@TEST_B3_FLOAT_ADVANCED
	#DIMF FA = 1.0
	#DIMF FB = 2.0
	PRINTL ----------------------------------------
	PRINTL  [B.3-8/9/10] 浮点数数组、函数参数、返回值
	PRINTL ----------------------------------------

	;=== 1. LOCALF 数组读写 ===
	LOCALF:0 = 3.14
	LOCALF:1 = 2.71
	IF LOCALF:0 == 3.14
		PRINTL  [PASS] LOCALF:0 读写正常
	ELSE
		PRINTL  [FAIL] LOCALF:0 读写异常！预期 3.14，实际 {LOCALF:0}
	ENDIF
	IF LOCALF:1 == 2.71
		PRINTL  [PASS] LOCALF:1 读写正常
	ELSE
		PRINTL  [FAIL] LOCALF:1 读写异常！预期 2.71，实际 {LOCALF:1}
	ENDIF

	;=== 2. LOCALF 数组运算 ===
	LOCALF:2 = LOCALF:0 + LOCALF:1
	IF LOCALF:2 > 5.8
		IF LOCALF:2 < 5.86
			PRINTL  [PASS] LOCALF 数组运算正常
		ELSE
			PRINTL  [FAIL] LOCALF 数组运算异常！值={LOCALF:2}
		ENDIF
	ELSE
		PRINTL  [FAIL] LOCALF 数组运算异常！值={LOCALF:2}
	ENDIF

	;=== 3. RESULTF 全局浮点返回值 ===
	RESULTF = 0.0
	RESULTF = 9.99
	IF RESULTF == 9.99
		PRINTL  [PASS] RESULTF 读写正常
	ELSE
		PRINTL  [FAIL] RESULTF 读写异常！预期 9.99，实际 {RESULTF}
	ENDIF

	;=== 4. CALL 函数传递 Float 参数 (ARGF) ===
	CALL TEST_B3_ARGF_HELPER(3.14, 2.71)
	IF RESULTF == 5.85
		PRINTL  [PASS] ARGF 函数参数传递正常
	ELSE
		PRINTL  [FAIL] ARGF 函数参数传递异常！预期 5.85，实际 {RESULTF}
	ENDIF

	;=== 5. CALL 函数传递 Int→Float 自动提升 ===
	CALL TEST_B3_ARGF_HELPER(3, 2)
	IF RESULTF == 5.0
		PRINTL  [PASS] Int→Float 参数自动提升正常
	ELSE
		PRINTL  [FAIL] Int→Float 参数自动提升异常！预期 5.0，实际 {RESULTF}
	ENDIF

	;=== 6. #FUNCTIONF 用户自定义 Float 返回函数 ===
	FA = TEST_B3_RETURNF_HELPER(10.0, 3.0)
	IF FA == 3.3333333333333335
		PRINTL  [PASS] #FUNCTIONF 返回 Float 正常
	ELSE
		IF FA > 3.3
			IF FA < 3.4
				PRINTL  [PASS] #FUNCTIONF 返回 Float 正常（近似）
			ELSE
				PRINTL  [FAIL] #FUNCTIONF 返回值异常！值={FA}
			ENDIF
		ELSE
			PRINTL  [FAIL] #FUNCTIONF 返回值异常！值={FA}
		ENDIF
	ENDIF

	;=== 7. #FUNCTIONF 返回 Int→Float ===
	FB = TEST_B3_RETURNF_INT_HELPER(7)
	IF FB == 7.0
		PRINTL  [PASS] #FUNCTIONF 返回 Int→Float 正常
	ELSE
		PRINTL  [FAIL] #FUNCTIONF 返回 Int→Float 异常！预期 7.0，实际 {FB}
	ENDIF

	;=== 8. VARSETEX 对 Float 数组 ===
	LOCALF:0 = 0.0
	LOCALF:1 = 0.0
	VARSETEX "LOCALF", 1.23
	IF LOCALF:0 == 1.23
		PRINTL  [PASS] VARSETEX Float 数组填充正常
	ELSE
		PRINTL  [FAIL] VARSETEX Float 数组填充异常！预期 1.23，实际 {LOCALF:0}
	ENDIF

	PRINTL
	RETURN

	;=== 9. CALL 函数传递 Float→Int 自动提升 ===
	FB = TEST_B3_RETURNF_HELPER(333, 7)
	IF FB == 333.0/7
		PRINTL  [PASS] #FUNCTIONF 返回 Int→Float 正常
	ELSE
		PRINTL  [FAIL] #FUNCTIONF 返回 Int→Float 异常！预期 {333.0/7}，实际 {FB}
	ENDIF

;--- ARGF 辅助函数：接收两个 Float 参数，相加后存入 RESULTF ---
@TEST_B3_ARGF_HELPER(ARGF:0,ARGF:1)
	RESULTF = ARGF:0 + ARGF:1
	RETURN

;--- #FUNCTIONF 辅助函数：返回 Float 除法结果 ---
@TEST_B3_RETURNF_HELPER(LF:0,LF:1)
	#DIMF DYNAMIC LF,2
	#FUNCTIONF
	RETURNF LF:0 / LF:1

;--- #FUNCTIONF 辅助函数：返回 Int 自动提升为 Float ---
@TEST_B3_RETURNF_INT_HELPER(_F)
	#DIMF _F
	#FUNCTIONF
	RETURNF _F
;
; 验证点：
;   1. 浮点运算 + 存档兼容
;   2. Phase01Bugfix 全部 PASS（回归）
;==========================================================
@TEST_B3_FULL
	PRINTL ----------------------------------------
	PRINTL  [B.3-6] 全量端到端测试
	PRINTL ----------------------------------------

	CALL TEST_B3_TYPE_SYSTEM
	CALL TEST_B3_FLOAT_BASIC
	CALL TEST_B3_REGRESSION
	CALL TEST_B3_FLOAT_ADVANCED
	PRINTFORML CALL Phase01Bugfix
	CALL Phase01Bugfix  ;验证现有脚本零影响

	PRINTL
	RETURN
