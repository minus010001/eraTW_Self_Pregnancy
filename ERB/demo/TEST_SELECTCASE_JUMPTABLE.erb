; TEST_SELECTCASE_JUMPTABLE.ERB - SelectCaseJumpTable 编译期跳转表测试
; 测试目标：验证 SelectCaseJumpTable 在编译期正确构建并于运行时触发 O(1) 查找
; 触发条件：所有 CASE 表达式均为 Normal 类型且 IsConst = true
; 回退条件：存在 TO/IS/CASEELSE 表达式或非常量值时，回退到线性扫描

@TEST_SELECTCASE_JUMPTABLE
#DIMS DYNAMIC _STR
#DIMF DYNAMIC FF

;==============================================================
; 测试1：整数 SELECTCASE（跳转表优化路径）
;==============================================================
PRINTFORML 【测试1】整数 SELECTCASE（跳转表快速路径）
I = 3
SELECTCASE I
	CASE 1
		PRINTFORML 分支: CASE 1
	CASE 2
		PRINTFORML 分支: CASE 2
	CASE 3
		PRINTFORML 分支: CASE 3
	CASE 4
		PRINTFORML 分支: CASE 4
	CASEELSE
		PRINTFORML 分支: CASEELSE
ENDSELECT

;==============================================================
; 测试2：整数 SELECTCASE（重复调用，验证字典查找一致性）
;==============================================================
PRINTFORML 【测试2】重复调用整数 SELECTCASE
FOR LOCAL, 1, 5
	SELECTCASE LOCAL
		CASE 1
			PRINTFORML {LOCAL} -> CASE 1
		CASE 2
			PRINTFORML {LOCAL} -> CASE 2
		CASE 3
			PRINTFORML {LOCAL} -> CASE 3
		CASE 4
			PRINTFORML {LOCAL} -> CASE 4
		CASEELSE
			PRINTFORML {LOCAL} -> CASEELSE
	ENDSELECT
NEXT

;==============================================================
; 测试3：字符串 SELECTCASE（跳转表优化路径）
;==============================================================
PRINTFORML 【测试3】字符串 SELECTCASE（跳转表快速路径）
_STR = "B"
SELECTCASE _STR
	CASE "A"
		PRINTFORML 分支: A
	CASE "B"
		PRINTFORML 分支: B
	CASE "C"
		PRINTFORML 分支: C
	CASEELSE
		PRINTFORML 分支: CASEELSE
ENDSELECT

;==============================================================
; 测试4：浮点数 SELECTCASE（跳转表优化路径）
;==============================================================
PRINTFORML 【测试4】浮点数 SELECTCASE（跳转表快速路径）
FF = 2.5
SELECTCASE FF
	CASE 1.0
		PRINTFORML 分支: 1.0
	CASE 2.5
		PRINTFORML 分支: 2.5
	CASE 3.0
		PRINTFORML 分支: 3.0
	CASEELSE
		PRINTFORML 分支: CASEELSE
ENDSELECT

;==============================================================
; 测试5：混合多值 CASE（每个 CASE 多个值，跳转表仍可优化）
;==============================================================
PRINTFORML 【测试5】多值 CASE（跳转表对每个值独立建表）
I = 5
SELECTCASE I
	CASE 1, 3, 5
		PRINTFORML 分支: 奇数(1,3,5)，I={I}
	CASE 2, 4, 6
		PRINTFORML 分支: 偶数(2,4,6)，I={I}
	CASEELSE
		PRINTFORML 分支: CASEELSE
ENDSELECT

;==============================================================
; 测试6：CASEELSE 兜底（跳转表返回 CASEELSE 行）
;==============================================================
PRINTFORML 【测试6】CASEELSE 兜底（跳转表 fallback）
I = 99
SELECTCASE I
	CASE 1
		PRINTFORML 分支: 1
	CASE 2
		PRINTFORML 分支: 2
	CASEELSE
		PRINTFORML 分支: CASEELSE (默认值)
ENDSELECT

;==============================================================
; 测试7：连续 CASEELSE 后的正常分支
;==============================================================
PRINTFORML 【测试7】连续调用（含 CASEELSE 分支）
FOR LOCAL, 0, 3
	SELECTCASE LOCAL
		CASE 0
			PRINTFORML {LOCAL} -> CASE 0
		CASE 1
			PRINTFORML {LOCAL} -> CASE 1
		CASEELSE
			PRINTFORML {LOCAL} -> CASEELSE
	ENDSELECT
NEXT

PRINTFORML 【测试完成】所有 SelectCaseJumpTable 测试用例执行完毕
