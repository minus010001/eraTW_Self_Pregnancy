	SETIMAGELAYER "老吴2改", 10, 50, -200, 0, 0, 255, , 0
	PRINTL  SETIMAGELAYER "老吴2改", 10, 50, -200, 0, 0, 255, , 0
	PRINTL  动图应在图层中播放动画

	PRINTL
	PRINTL  填充文本以测试离窗暂停...
	PRINTL  第 1 行
	PRINTL  第 2 行
	PRINTL  第 3 行
	PRINTL  第 4 行
	PRINTL  第 5 行
	PRINTL  第 6 行
	PRINTL  第 7 行
	PRINTL  第 8 行
	PRINTL  第 9 行
	PRINTL  第 10 行
	PRINTL  第 11 行
	PRINTL  第 12 行
	PRINTL  第 13 行
	PRINTL  第 14 行
	PRINTL  第 15 行
	PRINTL  第 16 行
	PRINTL  第 17 行
	PRINTL  第 18 行
	PRINTL  第 19 行
	PRINTL  第 20 行

	PRINTL
	WAIT

	; 测试多个动图图层
	CLEARIMAGELAYER_ALL

	SETIMAGELAYER "老吴2改", 5, 50, -200, 0, 0, 255, , 0
	SETIMAGELAYER "小帽1", 10, 200, -150, 0, 0, 255, , 0
	SETIMAGELAYER "output", 15, 350, -100, 0, 0, 255, , 0

	PRINTL  三个动图图层同时播放:
	PRINTL  depth=5:  老吴2改
	PRINTL  depth=10: 小帽1
	PRINTL  depth=15: output

	PRINTL
	WAIT

	CLEARIMAGELAYER_ALL
	PRINTL  动图图层已全部清除
