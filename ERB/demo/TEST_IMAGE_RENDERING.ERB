;==========================================================
; 全功能图像渲染测试 — SETIMAGELAYER / CBGSETSPRITE / SETBGIMAGE
; 基于 _dev_static 静态开发 → 双端实装
;
; 测试资源:
;   图片: resources\剧本自定义附件\k68_pet\nanfengtian.csv
;   动图: resources\动图示例\list.csv
;
; 注意: sprite 名称参数为字符串表达式，字面量需用 "" 包裹
; 坐标系: SETIMAGELAYER 的 x,y 坐标以窗口左下角为原点 (0,0)
;         x 向右为正，y 向下为正（与 CBGSETSPRITE 一致）
;         y=0 图片贴底，y=-200 图片底部距窗口底部 200px
;==========================================================

@ImageRenderingFullTest
	PRINTL ============================================
	PRINTL  全功能图像渲染测试
	PRINTL  SETIMAGELAYER / CBGSETSPRITE / SETBGIMAGE
	PRINTL ============================================
	PRINTL

	CALL TEST_SETBGIMAGE
	CALL TEST_CBGSETSPRITE
	CALL TEST_SETIMAGELAYER_BASIC
	CALL TEST_SETIMAGELAYER_DEPTH
	CALL TEST_SETIMAGELAYER_OPACITY
	CALL TEST_SETIMAGELAYER_CM
	CALL TEST_SETIMAGELAYER_FOLLOWSCROLL
	CALL TEST_CLEARIMAGELAYER
	CALL TEST_EXISTSIMAGELAYER
	CALL TEST_HTML_IMG
	CALL TEST_ANIMATION_LAYER

	PRINTL
	PRINTL ============================================
	PRINTL  全部测试完成
	PRINTL ============================================

	ONEINPUT

;==========================================================
; 1. SETBGIMAGE — 背景图片 + 透明度
;==========================================================
@TEST_SETBGIMAGE
	PRINTL ----------------------------------------
	PRINTL  [1] SETBGIMAGE 背景图片 + 透明度
	PRINTL ----------------------------------------

	SETBGIMAGE "pet_1", 0, 128
	PRINTL  SETBGIMAGE "pet_1", 0, 128  (50% 透明度)
	PRINTL  背景应显示 pet_1 图片，半透明效果

	PRINTL
	WAIT

;==========================================================
; 2. CBGSETSPRITE — 客户端背景图片
;==========================================================
@TEST_CBGSETSPRITE
#DIM CM_CBGRAY, 5, 5
	PRINTL ----------------------------------------
	PRINTL  [2] CBGSETSPRITE 客户端背景图片
	PRINTL ----------------------------------------

	CBGSETSPRITE "pet_2_hello", 0, 0, 1
	PRINTL  CBGSETSPRITE "pet_2_hello", 0, 0, 1
	PRINTL  基本渲染：图片应显示在窗口底部 (depth=1)

	CBGSETSPRITE "pet_1", 100, 50, 2, 200, 200, 200
	PRINTL  CBGSETSPRITE "pet_1", 100, 50, 2, 200, 200, 200
	PRINTL  缩放+透明度：图片应缩放到 200x200，约 78% 不透明

	CM_CBGRAY:0:0 = 77, 77, 77, 0, 0
	CM_CBGRAY:1:0 = 77, 77, 77, 0, 0
	CM_CBGRAY:2:0 = 77, 77, 77, 0, 0
	CM_CBGRAY:3:0 = 0, 0, 0, 256, 0
	CM_CBGRAY:4:0 = 0, 0, 0, 0, 256

	CBGSETSPRITE "pet_4_zhi", 300, 50, 3, 150, 150, 255, CM_CBGRAY:0:0
	PRINTL  CBGSETSPRITE "pet_4_zhi", 300, 50, 3, 150, 150, 255, CM_CBGRAY:0:0
	PRINTL  颜色矩阵：图片应显示为灰度效果

	PRINTL
	WAIT

;==========================================================
; 3. SETIMAGELAYER — 基本图层渲染
;==========================================================
@TEST_SETIMAGELAYER_BASIC
	PRINTL ----------------------------------------
	PRINTL  [3] SETIMAGELAYER 基本图层渲染
	PRINTL ----------------------------------------

	SETIMAGELAYER "yuka_sex1", 10, 100, -200, 0, 0, 255, , 0
	PRINTL  SETIMAGELAYER "yuka_sex1", 10, 100, -200, 0, 0, 255, , 0
	PRINTL  图层应显示 yuka_sex1 在 (100, -200)，完全不透明

	PRINTL
	WAIT

;==========================================================
; 4. SETIMAGELAYER — 深度排序测试
;==========================================================
@TEST_SETIMAGELAYER_DEPTH
	PRINTL ----------------------------------------
	PRINTL  [4] SETIMAGELAYER 深度排序
	PRINTL ----------------------------------------

	CLEARIMAGELAYER_ALL

	SETIMAGELAYER "pet_4_zhi", 5, 50, -200, 0, 0, 255, , 0
	SETIMAGELAYER "pet_4_maqia", 10, 120, -150, 0, 0, 255, , 0
	SETIMAGELAYER "pet_4_malisha", 15, 190, -100, 0, 0, 255, , 0

	PRINTL  depth=5:  pet_4_zhi   (最底层)
	PRINTL  depth=10: pet_4_maqia (中间层)
	PRINTL  depth=15: pet_4_malisha (最顶层)
	PRINTL  三张图片应按 depth 顺序层叠显示

	PRINTL
	WAIT

;==========================================================
; 5. SETIMAGELAYER — 透明度测试
;==========================================================
@TEST_SETIMAGELAYER_OPACITY
	PRINTL ----------------------------------------
	PRINTL  [5] SETIMAGELAYER 透明度测试
	PRINTL ----------------------------------------

	CLEARIMAGELAYER_ALL

	SETIMAGELAYER "pet_4_dos", 10, 50, -200, 0, 0, 64, , 0
	SETIMAGELAYER "pet_4_laji", 10, 150, -200, 0, 0, 128, , 0
	SETIMAGELAYER "yukafumo", 10, 250, -200, 0, 0, 192, , 0

	PRINTL  opacity=64:  pet_4_dos   (25% 不透明)
	PRINTL  opacity=128: pet_4_laji  (50% 不透明)
	PRINTL  opacity=192: yukafumo    (75% 不透明)
	PRINTL  三张图片应有不同的透明度

	PRINTL
	WAIT

;==========================================================
; 6. SETIMAGELAYER — 颜色矩阵测试
;==========================================================
@TEST_SETIMAGELAYER_CM
#DIM CM_GRAYSCALE, 5, 5
	PRINTL ----------------------------------------
	PRINTL  [6] SETIMAGELAYER 颜色矩阵 (CM)
	PRINTL ----------------------------------------

	CLEARIMAGELAYER_ALL

	; 灰度化颜色矩阵 (5x5 二维整数数组, 取值 0~256)
	CM_GRAYSCALE:0:0 = 77, 77, 77, 0, 0
	CM_GRAYSCALE:1:0 = 77, 77, 77, 0, 0
	CM_GRAYSCALE:2:0 = 77, 77, 77, 0, 0
	CM_GRAYSCALE:3:0 = 0, 0, 0, 256, 0
	CM_GRAYSCALE:4:0 = 0, 0, 0, 0, 256

	SETIMAGELAYER "pet_1", 10, 50, -200, 0, 0, 255, CM_GRAYSCALE:0:0, 0
	PRINTL  SETIMAGELAYER "pet_1", 10, 50, -200, 0, 0, 255, CM_GRAYSCALE:0:0, 0
	PRINTL  图片应显示为灰度效果

	PRINTL
	WAIT

;==========================================================
; 7. SETIMAGELAYER — 跟随滚动测试
;==========================================================
@TEST_SETIMAGELAYER_FOLLOWSCROLL
	PRINTL ----------------------------------------
	PRINTL  [7] SETIMAGELAYER 跟随滚动
	PRINTL ----------------------------------------
	CBGCLEAR
	CLEARIMAGELAYER_ALL

	SETIMAGELAYER "pet_2_hello", 10, 50, -200, 0, 0, 255, 0, 1
	PRINTL  SETIMAGELAYER "pet_2_hello", 10, 50, -200, 0, 0, 255, 0, 1
	PRINTL  followScroll=1，图片应随文本滚动

	PRINTL
	PRINTL  填充一些文本以测试滚动...
	PRINTL  第 1 行填充文本
	PRINTL  第 2 行填充文本
	PRINTL  第 3 行填充文本
	PRINTL  第 4 行填充文本
	PRINTL  第 5 行填充文本
	PRINTL  第 6 行填充文本
	PRINTL  第 7 行填充文本
	PRINTL  第 8 行填充文本
	PRINTL  第 9 行填充文本
	PRINTL  第 10 行填充文本

	PRINTL
	WAIT

;==========================================================
; 8. CLEARIMAGELAYER — 清除图层测试
;==========================================================
@TEST_CLEARIMAGELAYER
	PRINTL ----------------------------------------
	PRINTL  [8] CLEARIMAGELAYER 清除图层
	PRINTL ----------------------------------------

	CLEARIMAGELAYER_ALL

	SETIMAGELAYER "pet_4_zhi", 5, 50, -200, 0, 0, 255, , 0
	SETIMAGELAYER "pet_4_maqia", 10, 120, -150, 0, 0, 255, , 0
	SETIMAGELAYER "pet_4_malisha", 15, 190, -100, 0, 0, 255, , 0

	PRINTL  已设置 3 个图层 (depth=5, 10, 15)
	PRINTL
	WAIT

	CLEARIMAGELAYER 10
	PRINTL  CLEARIMAGELAYER 10
	PRINTL  depth=10 的图层应被清除，只剩 depth=5 和 depth=15

	PRINTL
	WAIT

	CLEARIMAGELAYER_ALL
	PRINTL  CLEARIMAGELAYER_ALL
	PRINTL  所有图层应被清除

	PRINTL
	WAIT

;==========================================================
; 9. EXISTSIMAGELAYER — 检查图层是否存在
;==========================================================
@TEST_EXISTSIMAGELAYER
	PRINTL ----------------------------------------
	PRINTL  [9] EXISTSIMAGELAYER 检查图层
	PRINTL ----------------------------------------

	CLEARIMAGELAYER_ALL

	SETIMAGELAYER "pet_1", 10, 50, -200, 0, 0, 255, , 0

	LOCAL = EXISTSIMAGELAYER(10)
	PRINTFORML  EXISTSIMAGELAYER(10) = {LOCAL} (应为 1)

	LOCAL = EXISTSIMAGELAYER(99)
	PRINTFORML  EXISTSIMAGELAYER(99) = {LOCAL} (应为 0)

	PRINTL
	WAIT

;==========================================================
; 10. HTML img cm 属性测试 (HTML_PRINT)
;==========================================================
@TEST_HTML_IMG
#DIM CM_GRAY, 5, 5
#DIM CM_SEPIA, 5, 5
	PRINTL ----------------------------------------
	PRINTL  [10] HTML img cm 属性 (HTML_PRINT)
	PRINTL ----------------------------------------

	; 灰度化颜色矩阵 (5x5 二维整数数组, 取值 0~256)
	CM_GRAY:0:0 = 77, 77, 77, 0, 0
	CM_GRAY:1:0 = 77, 77, 77, 0, 0
	CM_GRAY:2:0 = 77, 77, 77, 0, 0
	CM_GRAY:3:0 = 0, 0, 0, 256, 0
	CM_GRAY:4:0 = 0, 0, 0, 0, 256

	HTML_PRINT "<img src='pet_1' height='1000' cm='CM_GRAY:0:0'>"
	PRINTL  图片应显示为灰度效果 (通过 HTML img cm 属性)

	; 深褐色复古矩阵 (5x5 二维整数数组, 取值 0~256)
	CM_SEPIA:0:0 = 100, 197, 48, 0, 0
	CM_SEPIA:1:0 = 89, 176, 43, 0, 0
	CM_SEPIA:2:0 = 69, 137, 34, 0, 0
	CM_SEPIA:3:0 = 0, 0, 0, 256, 0
	CM_SEPIA:4:0 = 0, 0, 0, 0, 256

	HTML_PRINT "<img src='pet_2_hello' height='1000' cm='CM_SEPIA:0:0'>"
	PRINTL  图片应显示为深褐色复古效果

	PRINTL
	WAIT

;==========================================================
