; G_POLYGON 多边形指令集测试
; 测试 G_POLYGON_DRAW / G_POLYGON_FILL / G_POLYGON_POINT_ADD / G_POLYGON_POINT_CLEAR

@TEST_GPOLYGON

#DIM L_GID
#DIM L_RESULT
#DIM L_X
#DIM L_Y
PRINTL ===== G_POLYGON 多边形测试开始 =====

; 创建画布 400x300（GCREATE 签名: gID, width, height，返回 1=成功）
L_GID = 0
L_RESULT = GCREATE(L_GID, 400, 300)
PRINTFORML GCREATE(0,400,300) -> {L_RESULT}

; 用白色清空画布
L_RESULT = GCLEAR(L_GID, 0xFFFFFFFF)
PRINTFORML GCLEAR -> {L_RESULT}
L_RESULT = CBGSETG(L_GID, 500, -500, 1)
PRINTFORML CBGSETG(gid=0, x=500, y=-500, zdepth=1) -> {L_RESULT}

; 设置画笔颜色为红色 (用于描边)
L_RESULT = GSETPEN(L_GID, 0xFFFF0000, 3)
PRINTFORML GSETPEN(red,3) -> {L_RESULT}

; 设置画刷颜色为蓝色 (用于填充)
L_RESULT = GSETBRUSH(L_GID, 0xFF0000FF)
PRINTFORML GSETBRUSH(blue) -> {L_RESULT}

; 添加三角形顶点
L_RESULT = G_POLYGON_POINT_ADD(L_GID, 50, 50)
PRINTFORML G_POLYGON_POINT_ADD(50,50) -> {L_RESULT}

L_RESULT = G_POLYGON_POINT_ADD(L_GID, 350, 50)
PRINTFORML G_POLYGON_POINT_ADD(350,50) -> {L_RESULT}

L_RESULT = G_POLYGON_POINT_ADD(L_GID, 200, 250)
PRINTFORML G_POLYGON_POINT_ADD(200,250) -> {L_RESULT}

; 填充三角形
L_RESULT = G_POLYGON_FILL(L_GID)
PRINTFORML G_POLYGON_FILL -> {L_RESULT}

; 描边三角形
L_RESULT = G_POLYGON_DRAW(L_GID)
PRINTFORML G_POLYGON_DRAW -> {L_RESULT}

; 清除顶点，准备画第二个多边形
L_RESULT = G_POLYGON_POINT_CLEAR(L_GID)
PRINTFORML G_POLYGON_POINT_CLEAR -> {L_RESULT}

; 设置绿色画笔
L_RESULT = GSETPEN(L_GID, 0xFF00FF00, 2)
PRINTFORML GSETPEN(green,2) -> {L_RESULT}

; 设置黄色画刷
L_RESULT = GSETBRUSH(L_GID, 0xFFFFFF00)
PRINTFORML GSETBRUSH(yellow) -> {L_RESULT}

; 添加矩形顶点
L_RESULT = G_POLYGON_POINT_ADD(L_GID, 100, 100)
L_RESULT = G_POLYGON_POINT_ADD(L_GID, 300, 100)
L_RESULT = G_POLYGON_POINT_ADD(L_GID, 300, 200)
L_RESULT = G_POLYGON_POINT_ADD(L_GID, 100, 200)
PRINTFORML 矩形4顶点已添加

; 填充矩形
L_RESULT = G_POLYGON_FILL(L_GID)
PRINTFORML G_POLYGON_FILL(rect) -> {L_RESULT}

; 描边矩形
L_RESULT = G_POLYGON_DRAW(L_GID)
PRINTFORML G_POLYGON_DRAW(rect) -> {L_RESULT}

; 显示画布
L_RESULT = CBGSETG(L_GID, 0, 0, 1)
PRINTFORML CBGSETG(gid=0, x=0, y=0, zdepth=1) -> {L_RESULT}
PRINTL
PRINTL
PRINTL

PRINTL ===== G_POLYGON 多边形测试结束 =====
WAIT

; 释放画布
GDISPOSE L_GID