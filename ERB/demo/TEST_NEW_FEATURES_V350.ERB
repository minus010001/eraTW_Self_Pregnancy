;==========================================================
; 新功能测试 — 图像翻转 / HTML DisplayMode 绝对定位
; 基于 v3.5.0 移植自 EmueraDotNet 的三项功能:
;   1. 图像翻转（负尺寸 width/height）
;   2. <img> display 属性（relative/absolute-lefttop/absolute-leftbottom）
;   3. <img> xpos 属性（绝对定位 X 坐标）
;   4. <div> display 属性扩展（absolute-lefttop/absolute-leftbottom）
;
; 测试资源:
;   图片: resources\剧本自定义附件\k68_pet\nanfengtian.csv
;   动图: resources\动图示例\list.csv
;
; 注意:
;   - HTML 标签必须通过 HTML_PRINT 输出，PRINTFORML 不解析标签
;   - sprite 名称参数为字符串表达式，字面量需用 "" 包裹
;   - xpos/ypos 支持 px 后缀（绝对像素）或无后缀（百分比 × FontSize/100）
;   - display 属性值: relative | absolute-lefttop | absolute-leftbottom
;   - <div> 还额外支持 absolute（= absolute-leftbottom，EM+EE 兼容）
;==========================================================

@NewFeaturesTest
	PRINTL ============================================
	PRINTL  新功能测试 (v3.5.0)
	PRINTL  图像翻转 / DisplayMode / xpos
	PRINTL ============================================
	PRINTL

	CALL TEST_IMG_FLIP
	CALL TEST_IMG_DISPLAY_RELATIVE
	CALL TEST_IMG_DISPLAY_ABSOLUTE_LEFTTOP
	CALL TEST_IMG_DISPLAY_ABSOLUTE_LEFTBOTTOM
	CALL TEST_IMG_XPOS
	CALL TEST_IMG_DISPLAY_WITH_CM
	CALL TEST_DIV_DISPLAY_ABSOLUTE_LEFTTOP
	CALL TEST_DIV_DISPLAY_ABSOLUTE_LEFTBOTTOM
	CALL TEST_ANIMATION_DISPLAYMODE

	PRINTL
	PRINTL ============================================
	PRINTL  全部测试完成
	PRINTL ============================================

	ONEINPUT

;==========================================================
; 1. 图像翻转 — 负尺寸 width/height
;==========================================================
@TEST_IMG_FLIP
	PRINTL ----------------------------------------
	PRINTL  [1] 图像翻转（负尺寸 width/height）
	PRINTL ----------------------------------------
	PRINTL  原理：width/height 为负值时，图片沿该轴翻转
	PRINTL  用法：HTML_PRINT "<img src='...' width='-500' height='500'>"
	PRINTL

	HTML_PRINT "<img src='pet_1' height='500'>"
	PRINTL  原图 (height=500, width=自适应)
	PRINTL

	HTML_PRINT "<img src='pet_1' height='500' width='-500'>"
	PRINTL  水平翻转 (width=-500, 负值=沿 X 轴镜像)
	PRINTL

	HTML_PRINT "<img src='pet_1' height='-500'>"
	PRINTL  垂直翻转 (height=-500, 负值=沿 Y 轴镜像)
	PRINTL

	HTML_PRINT "<img src='pet_1' height='-500' width='-500'>"
	PRINTL  双轴翻转 (width=-500, height=-500)
	PRINTL

	WAIT

;==========================================================
; 2. <img> display="relative" — 默认相对定位
;==========================================================
@TEST_IMG_DISPLAY_RELATIVE
	PRINTL ----------------------------------------
	PRINTL  [2] <img> display="relative"（默认）
	PRINTL ----------------------------------------
	PRINTL  原理：图片跟随文本流，ypos 控制垂直偏移
	PRINTL  这是默认行为，不指定 display 时即为 relative
	PRINTL

	HTML_PRINT "文字在前<img src='pet_1' height='200' ypos='0'>文字在后"
	PRINTL  默认相对定位：图片嵌入文本流中
	PRINTL

	HTML_PRINT "<img src='pet_1' height='200' display='relative' ypos='0'>"
	PRINTL  显式指定 display='relative'，效果相同
	PRINTL

	WAIT

;==========================================================
; 3. <img> display="absolute-lefttop" — 左上角绝对定位
;==========================================================
@TEST_IMG_DISPLAY_ABSOLUTE_LEFTTOP
	PRINTL ----------------------------------------
	PRINTL  [3] <img> display="absolute-lefttop"
	PRINTL ----------------------------------------
	PRINTL  原理：图片固定在窗口左上角为原点的绝对坐标
	PRINTL  xpos/ypos 指定距窗口左上角的像素偏移
	PRINTL  图片不随文本滚动而移动
	PRINTL

	HTML_PRINT "<img src='pet_1' height='200' display='absolute-lefttop' xpos='50px' ypos='50px'>"
	PRINTL  display='absolute-lefttop' xpos='50px' ypos='50px'
	PRINTL  图片应固定在窗口左上角 (50, 50) 位置
	PRINTL

	HTML_PRINT "<img src='pet_4_zhi' height='150' display='absolute-lefttop' xpos='300px' ypos='100px'>"
	PRINTL  display='absolute-lefttop' xpos='300px' ypos='100px'
	PRINTL  第二张图片在 (300, 100) 位置
	PRINTL

	PRINTL
	PRINTL  填充文本以测试图片不随滚动...
	PRINTL  第 1 行 — 图片应保持在窗口左上角不动
	PRINTL  第 2 行
	PRINTL  第 3 行
	PRINTL  第 4 行
	PRINTL  第 5 行
	PRINTL  第 6 行
	PRINTL  第 7 行
	PRINTL  第 8 行
	PRINTL  第 9 行
	PRINTL  第 10 行

	WAIT

;==========================================================
; 4. <img> display="absolute-leftbottom" — 左下角绝对定位
;==========================================================
@TEST_IMG_DISPLAY_ABSOLUTE_LEFTBOTTOM
	PRINTL ----------------------------------------
	PRINTL  [4] <img> display="absolute-leftbottom"
	PRINTL ----------------------------------------
	PRINTL  原理：图片固定在窗口左下角为原点的绝对坐标
	PRINTL  xpos 指定距窗口左边的像素偏移
	PRINTL  ypos 指定距窗口底部的像素偏移（负值=距底部向上）
	PRINTL  图片不随文本滚动而移动
	PRINTL

	HTML_PRINT "<img src='pet_1' height='200' display='absolute-leftbottom' xpos='50px' ypos='-50px'>"
	PRINTL  display='absolute-leftbottom' xpos='50px' ypos='-50px'
	PRINTL  图片应固定在窗口左下角上方 50px 处
	PRINTL

	HTML_PRINT "<img src='pet_4_maqia' height='150' display='absolute-leftbottom' xpos='300px' ypos='-200px'>"
	PRINTL  display='absolute-leftbottom' xpos='300px' ypos='-200px'
	PRINTL  第二张图片在左下角上方 200px 处
	PRINTL

	PRINTL
	PRINTL  填充文本以测试图片不随滚动...
	PRINTL  第 1 行 — 图片应保持在窗口左下角不动
	PRINTL  第 2 行
	PRINTL  第 3 行
	PRINTL  第 4 行
	PRINTL  第 5 行
	PRINTL  第 6 行
	PRINTL  第 7 行
	PRINTL  第 8 行
	PRINTL  第 9 行
	PRINTL  第 10 行

	WAIT

;==========================================================
; 5. <img> xpos 属性 — 绝对定位的 X 坐标
;==========================================================
@TEST_IMG_XPOS
	PRINTL ----------------------------------------
	PRINTL  [5] <img> xpos 属性
	PRINTL ----------------------------------------
	PRINTL  原理：xpos 指定绝对定位时的 X 坐标
	PRINTL  仅在 display 为 absolute-* 时有意义
	PRINTL  支持 px 后缀（绝对像素）或无后缀（百分比 × FontSize/100）
	PRINTL

	HTML_PRINT "<img src='pet_1' height='100' display='absolute-lefttop' xpos='0px' ypos='0px'>"
	PRINTL  xpos='0px' — 图片紧贴窗口左边
	PRINTL

	HTML_PRINT "<img src='pet_1' height='100' display='absolute-lefttop' xpos='100px' ypos='0px'>"
	PRINTL  xpos='100px' — 图片距左边 100px
	PRINTL

	HTML_PRINT "<img src='pet_1' height='100' display='absolute-lefttop' xpos='200' ypos='0px'>"
	PRINTL  xpos='200' — 无 px 后缀，200×FontSize/100 像素
	PRINTL

	WAIT

;==========================================================
; 6. <img> display + cm 颜色矩阵组合
;==========================================================
@TEST_IMG_DISPLAY_WITH_CM
#DIM CM_GRAY, 5, 5
	PRINTL ----------------------------------------
	PRINTL  [6] <img> display + cm 颜色矩阵组合
	PRINTL ----------------------------------------
	PRINTL  原理：display 和 cm 属性可以同时使用
	PRINTL  绝对定位的图片也能应用颜色矩阵效果
	PRINTL

	CM_GRAY:0:0 = 77, 77, 77, 0, 0
	CM_GRAY:1:0 = 77, 77, 77, 0, 0
	CM_GRAY:2:0 = 77, 77, 77, 0, 0
	CM_GRAY:3:0 = 0, 0, 0, 256, 0
	CM_GRAY:4:0 = 0, 0, 0, 0, 256

	HTML_PRINT "<img src='pet_1' height='200' display='absolute-lefttop' xpos='50px' ypos='50px' cm='CM_GRAY:0:0'>"
	PRINTL  display='absolute-lefttop' + cm='CM_GRAY:0:0'
	PRINTL  绝对定位 + 灰度效果
	PRINTL

	WAIT

;==========================================================
; 7. <div> display="absolute-lefttop" — 左上角绝对定位容器
;==========================================================
@TEST_DIV_DISPLAY_ABSOLUTE_LEFTTOP
	PRINTL ----------------------------------------
	PRINTL  [7] <div> display="absolute-lefttop"
	PRINTL ----------------------------------------
	PRINTL  原理：div 容器以窗口左上角为原点绝对定位
	PRINTL  xpos/ypos 指定距窗口左上角的偏移
	PRINTL  容器内文本/图片不随文本滚动
	PRINTL

	HTML_PRINT "<div display='absolute-lefttop' xpos='50px' ypos='50px' width='300px' height='200px'>这是左上角绝对定位的 div 容器<br>第二行文本</div>"
	PRINTL  display='absolute-lefttop' xpos='50px' ypos='50px'
	PRINTL  div 应固定在窗口左上角 (50, 50) 位置
	PRINTL

	PRINTL
	PRINTL  填充文本以测试 div 不随滚动...
	PRINTL  第 1 行
	PRINTL  第 2 行
	PRINTL  第 3 行
	PRINTL  第 4 行
	PRINTL  第 5 行

	WAIT

;==========================================================
; 8. <div> display="absolute-leftbottom" — 左下角绝对定位容器
;==========================================================
@TEST_DIV_DISPLAY_ABSOLUTE_LEFTBOTTOM
	PRINTL ----------------------------------------
	PRINTL  [8] <div> display="absolute-leftbottom"
	PRINTL ----------------------------------------
	PRINTL  原理：div 容器以窗口左下角为原点绝对定位
	PRINTL  ypos 负值=距底部向上偏移
	PRINTL  这是 EM+EE 原有的 display="absolute" 行为
	PRINTL

	HTML_PRINT "<div display='absolute-leftbottom' xpos='50px' ypos='-250px' width='300px' height='200px'>这是左下角绝对定位的 div 容器<br>ypos=-250px: 距底部 250px</div>"
	PRINTL  display='absolute-leftbottom' xpos='50px' ypos='-250px'
	PRINTL  div 应固定在窗口左下角上方 250px 处
	PRINTL

	PRINTL
	PRINTL  填充文本以测试 div 不随滚动...
	PRINTL  第 1 行
	PRINTL  第 2 行
	PRINTL  第 3 行
	PRINTL  第 4 行
	PRINTL  第 5 行

	WAIT

;==========================================================
; 9. 动图 + DisplayMode — 绝对定位的动画
;==========================================================
@TEST_ANIMATION_DISPLAYMODE
	PRINTL ----------------------------------------
	PRINTL  [9] 动图 + DisplayMode 绝对定位
	PRINTL ----------------------------------------
	PRINTL  原理：动图也可以使用 display 属性绝对定位
	PRINTL  绝对定位的动图在窗口固定位置播放
	PRINTL

	HTML_PRINT "<img src='老吴2改' height='300' display='absolute-lefttop' xpos='100px' ypos='100px'>"
	PRINTL  display='absolute-lefttop' xpos='100px' ypos='100px'
	PRINTL  动图应在窗口 (100, 100) 位置播放
	PRINTL

	PRINTL
	PRINTL  填充文本以测试动图不随滚动...
	PRINTL  第 1 行 — 动图应保持在窗口左上角播放
	PRINTL  第 2 行
	PRINTL  第 3 行
	PRINTL  第 4 行
	PRINTL  第 5 行
	PRINTL  第 6 行
	PRINTL  第 7 行
	PRINTL  第 8 行
	PRINTL  第 9 行
	PRINTL  第 10 行

	WAIT
