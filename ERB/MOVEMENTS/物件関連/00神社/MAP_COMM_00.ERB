;--------------------------------------------------
;地点名変更関数
;--------------------------------------------------
@MAP_PLACENAME_0(ARG,ARG:1)
#FUNCTIONS
#DIM DYNAMIC LOCAL_MAP
LOCAL_MAP = GET_MAPID(ARG)
IF LOCAL_MAP == GET_CURRENT_MAP()
	SELECTCASE ARG
		CASE P53倉庫
			IF CFLAG:MASTER:初期位置 == ARG
				RETURNF CALLNAME:MASTER + "的仓库"
			ELSE
				RETURNF "仓库"
			ENDIF
		CASE SUMIKOMI_ROOM
			IF FLAG:住宿人物
				IF HOUGONG
					RETURNF CALLNAME:MASTER+ "的后宫别墅"
				ELSE
					RETURNF CALLNAME:(FLAG:住宿人物) + "的小屋"
				ENDIF
			ELSE
				RETURNF "破旧小屋"
			ENDIF
		CASE MINROOM(LOCAL_MAP) TO (MAXROOM(LOCAL_MAP) - 1)
			RETURNF ARG:1 ? STR:(ARG + 8000) # STR_TR(ARG + 8000) ;custom code
		CASE OMANEKIBEYA(LOCAL_MAP)
			RETURNF OMANEKI_PLACE()
		CASE SUKIMA(LOCAL_MAP)
			RETURNF "隙间空间"
		CASE MAXROOM(LOCAL_MAP)
			RETURNF "参道的另一边"
		CASEELSE
			RETURNF "不明"
	ENDSELECT
ELSE
	RETURNF "神社之外"
ENDIF

;--------------------------------------------------
;場所ARGがどのエリアにあるか
;表示するMapの番号と連動（TFLAG:地圖切換）
;ARG     場所ID
;--------------------------------------------------
@MAP_AREASELECT_0(ARG)
#FUNCTION
SELECTCASE ARG
	;三妖精之家
	CASE P27三妖精之家・大廳 TO P35三妖精之家・地下室
		RETURNF 4
	;夢幻遺跡
	CASE P36夢幻遺跡前 TO P51夢幻遺跡・倉庫
		RETURNF 3
	;神社周辺
	CASE P22参道, P25鎮守之森
		RETURNF 6
	;大别墅
	CASE P57大温泉 TO P68大广场
		RETURNF 5
	;博麗神社-前院
	CASE P1鳥居 TO P6庫房, P16破舊小屋, P21守矢神社分社, P23温泉・脱衣所, P24温泉, P56阿吽の棲家
		RETURNF 1
	;博丽神社-内部+后院	
	CASEELSE
		RETURNF 2
ENDSELECT

;--------------------------------------------------
;内部構造がある場所の内部の判定
;TFLAG:地圖切換  内部察知が必要なMap番号
;                P_ID  表示ボタンの場所ID
;                Q_ID  判定する内部の場所ID,必ずP_IDと一致した数値も含める
;--------------------------------------------------
@GETMAP_BUILDING_0(P_ID, Q_ID,ARG)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTION
#DIM P_ID
#DIM Q_ID
IF TFLAG:地圖切換 == 4 || ARG
	SELECTCASE P_ID
		;三妖精之家
		CASE P27三妖精之家・大廳
			SELECTCASE Q_ID
			CASE P27三妖精之家・大廳 TO P35三妖精之家・地下室
				RETURNF 1
			ENDSELECT
		;夢幻遺跡
		CASE P36夢幻遺跡前
			SELECTCASE Q_ID
			CASE P36夢幻遺跡前 TO P51夢幻遺跡・倉庫
				RETURNF 1
			ENDSELECT
		CASE P2境内, P4本堂
			SELECTCASE Q_ID
			CASE P1鳥居 TO P6庫房, P16破舊小屋, P21守矢神社分社, P23温泉・脱衣所, P24温泉, P56阿吽の棲家
				RETURNF 1
			ENDSELECT
		CASE P11庭, P7土間
			SELECTCASE Q_ID
			CASE P7土間 TO P15霊夢私室, P17小的倉庫 TO P19大的倉庫, P52別屋 TO P55和室, P69先代巫女的小屋, P70贝子的暂居处
				RETURNF 1
			ENDSELECT		
	ENDSELECT
ENDIF
RETURNF 0

;--------------------------------------------------
;移動制限設定
;ARG    場所ID
;CHARA  移動する角色ID
;RETURNF 1=移動できる,0=移動できない
;TFLAG:移動不能メッセージ   ↓の@MAP_CANNOT_WORD用の設定
;--------------------------------------------------
@MAP_CAN_MOVE_0(ARG, CHARA)
#FUNCTION
#DIM CHARA
SELECTCASE ARG
	;虫かご
	CASE P54小人的虫籠
		;小人じゃないと入れない
		IF TALENT:CHARA:体型 > -5
			TFLAG:移動不能メッセージ = 2
			RETURNF 0
		ENDIF
	;三妖精ハウス
	CASE P27三妖精之家・大廳 TO P35三妖精之家・地下室
		;妖精なら入れる
		SIF TALENT:CHARA:妖精
			RETURNF 1
		;中からは動ける
		SIF INRANGE(CFLAG:CHARA:現在位置, P27三妖精之家・大廳, P35三妖精之家・地下室)
			RETURNF 1
		;你は恋慕か教養LV1以上で入れる
		IF CHARA == MASTER
			IF TALENT:[[桑尼]]:恋慕 || TALENT:[[露娜]]:恋慕 || TALENT:[[斯塔]]:恋慕 || ABL:CHARA:教養 >= 1
				RETURNF 1
			ELSEIF INRANGE(CFLAG:MASTER:初期位置, P27三妖精之家・大廳, P35三妖精之家・地下室)
				RETURNF 1
			ELSE
				TFLAG:移動不能メッセージ = 1
				RETURNF 0
			ENDIF
		;それ以外は入れない
		ELSE
			RETURNF 0
		ENDIF
	;夢幻遺跡,你以外は教養LV3が必要
	CASE P37夢幻遺跡・一階通路 TO P51夢幻遺跡・倉庫
		;中からは動ける
		IF INRANGE(CFLAG:CHARA:現在位置, P37夢幻遺跡・一階通路, P51夢幻遺跡・倉庫)
			RETURNF 1
		ELSEIF ABL:CHARA:教養 <= 2 && CHARA != MASTER
			RETURNF 0
		ENDIF
	;大别墅
	CASE P57大温泉 TO P68大广场
		;中からは動ける
		SIF INRANGE(CFLAG:CHARA:現在位置, P57大温泉, P68大广场) || INRANGE(CFLAG:CHARA:初期位置, P57大温泉, P68大广场)
			RETURNF 1
		IF FamilyHotel
			RETURNF 1
		ELSE
			TFLAG:移動不能メッセージ = 3
			RETURNF 0
		ENDIF
ENDSELECT
RETURNF 1

;--------------------------------------------------
;移動不能時に表示されるメッセージ
;--------------------------------------------------
@MAP_CANNOT_WORD_0(ARG)
SELECTCASE TFLAG:移動不能メッセージ
	CASE 1
		PRINTFORMW 不熟悉的%CALLNAME:MASTER%没有找到路…
	CASE 2
		PRINTFORMW %CALLNAME:MASTER%无论如何也进不去
	CASE 3
		CALL FamilyHotel_Close_Info
		CLEARLINE 1
ENDSELECT
CLEARLINE 2
REUSELASTLINE

;-----------------------------------------
;拠点専用の情景描写
;WAITはかけないように
;-----------------------------------------
@MAP_UNIQUEMESSAGE_0
SELECTCASE CFLAG:MASTER:現在位置
	CASEELSE
ENDSELECT

;-----------------------------------------
;非自宅時に差し替える場所IDを返す関数
;ARG,対象ID
;RETURNF,差し替え済み対象ID
;-----------------------------------------
@MAP_SEARCH_REPLACEMENT_0(ARG)
#FUNCTION
SELECTCASE ARG
	CASE P1鳥居, P22参道
		RETURNF 桜花道的鳥居
	CASE P2境内, P5手水舎, P6庫房, P21守矢神社分社, P56阿吽の棲家, P16破舊小屋
		RETURNF 神社境内
	;賽銭箱,本堂
	CASE P3賽銭箱, P4本堂
		RETURNF 神社本堂
	;三妖精之家
	CASE P27三妖精之家・大廳 TO P35三妖精之家・地下室
		RETURNF 妖精的大樹
	;夢幻遺跡
	CASE P36夢幻遺跡前 TO P51夢幻遺跡・倉庫
		RETURNF 夢幻遺跡
	;大别墅
	CASE P57大温泉 TO P68大广场
		RETURNF 大别墅
	CASEELSE
		RETURNF 神社走廊
ENDSELECT
RETURNF 0

