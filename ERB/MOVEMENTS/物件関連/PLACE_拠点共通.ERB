;-----------------------------------------------------------
;约会道中
;ARG            MAPID
;RETURNF        约会道中
;-----------------------------------------------------------
@ROAD_TO(ARG)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
RETURNF 97 + ARG * 100

;-----------------------------------------------------------
;室内判定
;RETURNF 1=室内（和室）,2=室内（洋室）,0=室外
;厳密な使い分けはされていないが、屋外だけど屋根のある場所はINROOMにもOUTROOFにも引っかからない
;現状、靴を脱掉かどうかのためだけに洋室判定がある
;-----------------------------------------------------------
@INROOM(ARG)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC MAP_ID
;隙间属于室内
SIF IS_GAP_GUEST(MASTER) && ARG == OMANEKIBEYA()
	RETURNF 1
;暂时弃用, 减少游戏负担
[SKIPSTART]
;幻想乡大地图，GMF调用函数修改MAIN_MAP后获得对应地图返回值
IF GMF_GETBIT("幻想乡大地图") && GMF_METHOD_STACK != "INROOM"
	RETURNF GMF_MAP_METHODF(ARG, 1, "INROOM", 0, ARG)
ENDIF
[SKIPEND]
IF IN_HOME(ARG)
	IF GMF_GETBIT("幻想乡大地图")
		IF GMF_ROOMDATA:(ARG / 100):(ARG % 100) & 場所_洋室
			RETURNF 2
		ELSEIF GMF_ROOMDATA:(ARG / 100):(ARG % 100) & 場所_屋内
			RETURNF 1
		ENDIF
	ELSE
		IF ROOMDATA:(ARG % 100) & 場所_洋室
			RETURNF 2
		ELSEIF ROOMDATA:(ARG % 100) & 場所_屋内
			RETURNF 1
		ENDIF
	ENDIF
ELSEIF ARG == OMANEKIBEYA()
	RETURNF 1
ELSE
	IF ODEKAKEMAP_SETTING(ARG, "洋室")
		RETURNF 2
	ELSEIF ODEKAKEMAP_SETTING(ARG, "屋内")
		RETURNF 1
	ENDIF
ENDIF
RETURNF 0

;-----------------------------------------------------------
;屋外判定
;RETURNF 1=屋外（屋根がない）,0=屋根がある
;-----------------------------------------------------------
@OUTROOF(ARG)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
SIF IS_GAP_GUEST(MASTER)
	RETURNF 0
;暂时弃用, 减少游戏负担
[SKIPSTART]
;幻想乡大地图，GMF调用函数修改MAIN_MAP后获得对应地图返回值
IF GMF_GETBIT("幻想乡大地图") && GMF_METHOD_STACK != "OUTROOF"
	RETURNF GMF_MAP_METHODF(ARG, 1, "OUTROOF", 0, ARG)
ENDIF
[SKIPEND]
IF IN_HOME(ARG)
	IF GMF_GETBIT("幻想乡大地图")
		SIF GMF_ROOMDATA:(ARG / 100):(ARG % 100) & 場所_赏月
			RETURNF 0
		SIF GMF_ROOMDATA:(ARG / 100):(ARG % 100) & 場所_屋根
			RETURNF 0
	ELSE
		SIF ROOMDATA:(ARG % 100) & 場所_屋内
			RETURNF 0
		SIF ROOMDATA:(ARG % 100) & 場所_屋根
			RETURNF 0
		RETURNF 1
	ENDIF
ELSEIF ARG == OMANEKIBEYA()
	RETURNF 0
ELSEIF ARG == ROAD_TO(GET_MAPID(ARG))
	;地底はダメ
	SIF GET_MAPID(ARG) == 9
		RETURNF 0
	RETURNF 1
ELSE
	SIF ODEKAKEMAP_SETTING(ARG, "屋内")
		RETURNF 0
	SIF ODEKAKEMAP_SETTING(ARG, "屋根")
		RETURNF 0
	RETURNF 1
ENDIF
RETURNF 0

;-----------------------------------------------------------
;開阔处の良い場所
;RETURNF	1=广阔室内,2=广阔野外,0=広くない
;-----------------------------------------------------------
@OPENPLACE(ARG)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
;暂时弃用, 减少游戏负担
[SKIPSTART]
;幻想乡大地图，GMF调用函数修改MAIN_MAP后获得对应地图返回值
IF GMF_GETBIT("幻想乡大地图") && GMF_METHOD_STACK != "OPENPLACE"
	RETURNF GMF_MAP_METHODF(ARG, 1, "OPENPLACE", 0, ARG)
ENDIF
[SKIPEND]
IF IN_HOME(ARG)
	IF GMF_GETBIT("幻想乡大地图")
		IF GMF_ROOMDATA:(ARG / 100):(ARG % 100) & 場所_广阔
			IF INROOM(ARG)
				RETURNF 1
			ELSE
				RETURNF 2
			ENDIF
		ENDIF
	ELSE
		IF ROOMDATA:(ARG % 100) & 場所_广阔
			IF INROOM(ARG)
				RETURNF 1
			ELSE
				RETURNF 2
			ENDIF
		ENDIF
	ENDIF
ELSEIF ARG == OMANEKIBEYA()
	RETURNF 0
ELSEIF ARG == ROAD_TO(GET_MAPID(ARG))
	RETURNF 1
ELSE
	IF ODEKAKEMAP_SETTING(ARG, "广阔")
		IF INROOM(ARG)
			RETURNF 1
		ELSE
			RETURNF 2
		ENDIF
	ENDIF
ENDIF
RETURNF 0

;-----------------------------------------------------------
;赏月ポイント
;RETURNF	1=月が見える,0=月が見えない
;実質空が見えるかどうかの判定
;-----------------------------------------------------------
@MOON_WATCH_POINT(ARG)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
;暂时弃用, 减少游戏负担
[SKIPSTART]
;幻想乡大地图，GMF调用函数修改MAIN_MAP后获得对应地图返回值
IF GMF_GETBIT("幻想乡大地图") && GMF_METHOD_STACK != "MOON_WATCH_POINT"
	RETURNF GMF_MAP_METHODF(ARG, 1, "MOON_WATCH_POINT", 0, ARG)
ENDIF
[SKIPEND]
;无日照区域和月都无法赏月
SIF IS_NO_SUN(VISITOR_LOCATION(ARG)) || GROUPMATCH(GET_MAPID(ARG), MAP月)
	RETURNF 0
IF IN_HOME(ARG)
	IF GMF_GETBIT("幻想乡大地图")
		SIF GMF_ROOMDATA:(ARG / 100):(ARG % 100) & 場所_赏月
			RETURNF 1
	ELSE
		SIF ROOMDATA:(ARG % 100) & 場所_赏月
			RETURNF 1
	ENDIF
	SIF ROOMDATA:(ARG % 100) & 場所_赏月
		RETURNF 1
	SIF OUTROOF(ARG)
		RETURNF 1
ELSEIF ARG == OMANEKIBEYA() || ARG == ROAD_TO(GET_MAPID(ARG))
	;地底、月都和魔界的道中也无法赏月
	SIF GROUPMATCH(GET_MAPID(ARG), 9, 10, 11)
		RETURNF 0
	RETURNF 1
ELSE
	SIF ODEKAKEMAP_SETTING(ARG, "赏月")
		RETURNF 1
	SIF OUTROOF(ARG)
		RETURNF 1
ENDIF
RETURNF 0

