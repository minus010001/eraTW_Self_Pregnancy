;-----------------------------------------------------------
;部屋に居る人数取得
;ARG            部屋NO
;RETURNF        人数
;-----------------------------------------------------------
@IN_ROOM_NUMBER(ARG)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
RETURNF CMATCH(CFLAG:現在位置, ARG)

;wrapped for IN_ROOM_NUMBER that only counts characters other than EXCLUDED_CHARA
@OTHER_IN_ROOM_NUMBER(ARG, EXCLUDED_CHARA)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM EXCLUDED_CHARA
LOCAL = IN_ROOM_NUMBER(ARG)
SIF CFLAG:EXCLUDED_CHARA:現在位置 == ARG
	LOCAL--

RETURNF LOCAL

