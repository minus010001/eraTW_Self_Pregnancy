;-----------------------------------------------------------
;風呂から追い出された時の逐出先
;-----------------------------------------------------------
@KICKOUT(ARG)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC MAP_ID
;暂时弃用, 减少游戏负担
[SKIPSTART]
;幻想乡大地图，GMF调用函数修改MAIN_MAP后获得对应地图返回值
IF GMF_GETBIT("幻想乡大地图") && GMF_METHOD_STACK != "KICKOUT"
	RETURNF GMF_MAP_METHODF(ARG, 1, "KICKOUT", 0, ARG)
ENDIF
[SKIPEND]
FLAG:自室施錠 = 0 ;custom code, unlocks door
SIF !ARG
	ARG = CFLAG:MASTER:現在位置
IF GMF_GETBIT("幻想乡大地图")
	MAP_ID = ARG / 100
	FOR LOCAL, MAP_ID * 100 + 1, GMF_MAXROOM:MAP_ID
		SIF CAN_MOVE(ARG, LOCAL) & 1
			RETURNF LOCAL
	NEXT
ELSE
	FOR LOCAL, MINROOM(), MAXROOM
		SIF CAN_MOVE(ARG, LOCAL) & 1
			RETURNF LOCAL
	NEXT
ENDIF
RETURNF CFLAG:MASTER:前一次的位置

;-----------------------------------------------------------
;角色ARGの現在位置の名称を返す関数
;ARG  角色ID
;-----------------------------------------------------------
@PLACE_NAME(ARG)
#FUNCTIONS
#LOCALSIZE 1
#LOCALSSIZE 1
IF !IN_HOME(CFLAG:ARG:現在位置) && CFLAG:ARG:現在位置 != OMANEKIBEYA()
	LOCALS = %DATENAME_SPOT()%
ELSEIF CHK_DATENOW(CFLAG:MASTER:约会中) && CFLAG:MASTER:現在位置 != OMANEKIBEYA()
	LOCALS = %DATENAME_PLACE()%の%DATENAME_SPOT()%
ELSE
	LOCALS = %NAME_FROM_PLACE(CFLAG:ARG:現在位置)%
ENDIF
RETURNF LOCALS

;-----------------------------------------------------------
;拠点の住人かをチェックする関数
;ARG    MAPID
;CHARA  判定する角色
;-----------------------------------------------------------
@MAP_住人(ARG, CHARA)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM CHARA
;CSVの初期位置を取得
LOCAL = CSVCFLAG(CHARA, GETNUM(CFLAG, "初期位置"))
SIF LOCAL == 99 || !LOCAL
	RETURNF 0
SIF LOCAL / 100 == ARG
	RETURNF 1

;-----------------------------------------------------------
;角色 ARG 是否在你可见的范围内
;ARG  角色ID
;-----------------------------------------------------------
@CAN_SEE(ARG)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
SIF CFLAG:MASTER:現在位置 == CFLAG:ARG:現在位置
	RETURNF 1
SIF GETBIT(CAN_MOVE(CFLAG:MASTER:現在位置, CFLAG:ARG:現在位置), 1)
	RETURNF 1
RETURNF 0

;-----------------------------------------------------------
;角色 ARG 是否在可以看见你的范围内
;ARG  角色ID
;-----------------------------------------------------------
@CAN_BE_SEE(ARG)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
SIF CFLAG:MASTER:現在位置 == CFLAG:ARG:現在位置
	RETURNF 1
SIF GETBIT(CAN_MOVE(CFLAG:ARG:現在位置, CFLAG:MASTER:現在位置), 1)
	RETURNF 1
RETURNF 0
