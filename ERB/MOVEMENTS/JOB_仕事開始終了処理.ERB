;FileName_JOB.ERB ----------------------------- Rev1.00
;工作開始処理
;CALL		USER
;ARG		角色NO
;RETURN		VOID
;COMMENT	
;-----------------------------------------------------------
@CHARA_JOBSTR(ARG)
#DIM 移動前
#DIM 移動後
#DIMS HOLD_SAMEN


IF EX:ARG:精液残量 + EX:ARG:アナル精液残量 >= 900
	HOLD_SAMEN = 小腹内存储了不可思议的量的精液的
ELSEIF EX:ARG:精液残量 + EX:ARG:アナル精液残量 >= 700
	HOLD_SAMEN = 小腹内存储了满满当当的精液的
ELSEIF EX:ARG:精液残量 + EX:ARG:アナル精液残量 >= 500
	HOLD_SAMEN = 小腹内积攒了满满的精液的
ELSEIF EX:ARG:精液残量 + EX:ARG:アナル精液残量 >= 300
	HOLD_SAMEN = 小腹内积攒了精液的
ELSEIF EX:ARG:精液残量 + EX:ARG:アナル精液残量 >= 100
	HOLD_SAMEN = 小腹内留存着精液的
ELSE
	HOLD_SAMEN =
ENDIF

;FOR LOCAL,0,CHARANUM
;	SIF CFLAG:LOCAL:職場 == 0 && CFLAG:LOCAL:行動 == 5
;		PRINTFORMW ### JOB 326ERROR %CALLNAME:LOCAL% ###
;NEXT
VARSET LOCAL
移動前 = 0
移動後 = 0
;泣く泣く仕事へ 真面目だからね
IF CFLAG:ARG:诶嘿嘿 && !GROUPMATCH(CFLAG:ARG:職種, 49, 51)
	PRINTFORMW %CALLNAME:ARG%必须要\@ CFLAG:ARG:職場 == CFLAG:ARG:現在位置 ? 开始 # 前去 \@工作了…
	IF CFLAG:ARG:職場 == CFLAG:ARG:現在位置 ;qol custom code
		CALL ENDUFUFU_ALL
	ELSE
		CALL ENDUFUFU(ARG)
	ENDIF
	;CFLAG:MASTER:うふふ = 0
	TFLAG:106 = 0
	IF TFLAG:102 == 3 && TFLAG:抱住模式
		TFLAG:抱住模式 = 0
		TFLAG:102 = 1
	ENDIF
ENDIF

SIF CFLAG:ARG:行動 == 5
	CALL JOBMOVE(ARG)

IF CAN_SEE(ARG) && !TFLAG:遠距離移動
	IF CFLAG:ARG:現在位置 == TFLAG:宴会場 && TIME_PROGRESS(TIME:1) && (CFLAG:ARG:職種 == 49 || CFLAG:ARG:職種 == 51)
		CALL 宴会描写(ARG)
	ELSEIF CFLAG:ARG:現在位置 == CFLAG:ARG:職場 && TIME_PROGRESS(TIME:1)
		CALL 仕事情景描写(ARG)
		IF BASE:ARG:工作量
			;仕事がまだ3分の2以上残っている
			IF BASE:ARG:工作量 >= (MAXBASE:ARG:工作量 / 3) * 2
				IF CFLAG:ARG:職種 == 48
					PRINTFORMW 　%ADD_BANQUET_TERM(CFLAG:ARG:BANQUET)%的准备工作还剩很多没完成的样子…
				ELSEIF CFLAG:ARG:職種 == 50
					PRINTFORMW 　%ADD_BANQUET_TERM(CFLAG:ARG:BANQUET_CLEANUP)%的善后工作还剩很多没完成的样子…
				ELSEIF CFLAG:ARG:職種 == 46
					PRINTW 埋头于玩耍之中…
				ELSEIF CFLAG:ARG:職種 == 49
				ELSEIF STRFIND(GET_JOBNAME(ARG), "午睡") >= 0
					PRINTFORMW 看起来暂时不要打扰对方会比较好的样子…
				ELSE
					PRINTFORMW %GET_JOBNAME(ARG)%还剩很多没完成的样子…
				ENDIF
				LOCAL = 3
			;仕事がまだ3分の1以上残っている
			ELSEIF BASE:ARG:工作量 >= (MAXBASE:ARG:工作量 / 3)
				IF CFLAG:ARG:職種 == 48
					PRINTFORMW 　距离%ADD_BANQUET_TERM(CFLAG:ARG:BANQUET)%的准备工作完成还需要一段时间…
				ELSEIF CFLAG:ARG:職種 == 50
					PRINTFORMW 　距离%ADD_BANQUET_TERM(CFLAG:ARG:BANQUET_CLEANUP)%的善后工作完成还需要一段时间…
				ELSEIF CFLAG:ARG:職種 == 46
					PRINTW 好像还没玩够的样子…
				ELSEIF CFLAG:ARG:職種 == 49
				ELSE
					PRINTFORMW 距离%GET_JOBNAME(ARG)%完成还需要一段时间…
				ENDIF
				LOCAL = 2
			ELSE
				IF CFLAG:ARG:職種 == 48
					PRINTFORMW 　%ADD_BANQUET_TERM(CFLAG:ARG:BANQUET)%的准备工作还差一点就可以完成了…
				ELSEIF CFLAG:ARG:職種 == 50
					PRINTFORMW 　%ADD_BANQUET_TERM(CFLAG:ARG:BANQUET_CLEANUP)%的善后工作还差一点就可以完成了…
				ELSEIF CFLAG:ARG:職種 == 46
					PRINTW 玩累了的样子…
				ELSEIF CFLAG:ARG:職種 == 49
				ELSE
					PRINTFORMW %GET_JOBNAME(ARG)%还差一点就可以完成了…
				ENDIF
				LOCAL = 1
			ENDIF
			;通常のお仕事口上　お仕事中かつ宴会フラグが立ってなければ表示する
			SIF CFLAG:ARG:宴会参加 == 0
				CALL KOJO_MESSAGE_SEND("EVENT",13,ARG,2,LOCAL)
		ENDIF
		;宴会中の場合のみ、スムーズに次の動作に繋がる
		;酒を飲み終わった時に１ターン何もせずボーっとするのを防止する処理
;		SIF CFLAG:ARG:宴会参加 > 0 && BASE:ARG:工作量 <= 0
;			CALL CHARA_JOBEND(ARG)
	ELSEIF CFLAG:ARG:職種 != 51
		;custom code, not using this as it only causes problems
		; IF !AT_HOME(ARG)
		; 	移動前 = 6000 + (CFLAG:ARG:現在位置 / 10)
		; ELSE
		; 	移動前 = CFLAG:ARG:現在位置
		; ENDIF
		; IF IN_HOME(CFLAG:ARG:職場) == 0 && GET_MAPID(CFLAG:ARG:職場) != MAIN_MAP
		; 	移動後 = 6000 + (CFLAG:ARG:職場 / 10)
		; ELSE
		; 	移動後 = CFLAG:ARG:職場
		; ENDIF
		;時間経過してなかったら非表示
		IF !TIME_PROGRESS(TIME:1)
			;custom code
			PRINTFORMW 因为还有工作，%CALLNAME:ARG%匆忙离开了…
		;移動前と移動後の位置が同じなら非表示
		ELSEIF NAME_FROM_PLACE(移動前) == NAME_FROM_PLACE(移動後)
		ELSEIF CFLAG:ARG:現在位置 == OMANEKIBEYA()
			;部屋に上がってたら出る,すいません面倒なので地の文まとめちゃいます；
			IF MOREDATE && CFLAG:MASTER:お招き != ARG ;custom code, don't kick from rooms they don't own
				PRINTFORMW %HOLD_SAMEN%%CALLNAME:ARG%好像有事，所以感谢了%CALLNAME:(CFLAG:MASTER:お招き)%之后就告辞了
			ELSE
				CFLAG:MASTER:現在位置 = CFLAG:ARG:自宅位置
				;幻想乡大地图 目的地在非外出地图模式下应该去往初期位置
				SIF GMF_GETBIT("幻想乡大地图") && !GMF_IS_ODEKAKE(GET_MAPID(CFLAG:ARG:初期位置))
					CFLAG:MASTER:現在位置 = CFLAG:ARG:初期位置
				PRINTFORMW %HOLD_SAMEN%%CALLNAME:ARG%好像还有事，忙着离开了
			ENDIF
		ELSEIF CFLAG:ARG:職種 == 48
			PRINTFORM %HOLD_SAMEN%%CALLNAME:ARG%为了准备宴会，离开
			PRINTFORMS NAME_FROM_PLACE(移動前)
			PRINT 向
			PRINTFORMS NAME_FROM_PLACE(移動後)
			PRINTW 出发了。
		ELSEIF CFLAG:ARG:職種 == 49
			PRINTFORM %HOLD_SAMEN%%CALLNAME:ARG%为了参加宴会，从
			PRINTFORMS NAME_FROM_PLACE(移動前)
			PRINT 向
			PRINTFORMS NAME_FROM_PLACE(移動後)
			PRINTW 出发了。
		ELSEIF CFLAG:ARG:職種 == 46
			PRINTFORM %HOLD_SAMEN%%CALLNAME:ARG%为了去玩，从
			PRINTFORMS NAME_FROM_PLACE(移動前)
			PRINT 向
			PRINTFORMS NAME_FROM_PLACE(移動後)
			PRINTW 出发了。
		ELSE
			PRINTFORM %HOLD_SAMEN%%CALLNAME:ARG%为了%GET_JOBNAME(ARG)%、从
			PRINTFORMS NAME_FROM_PLACE(移動前)
			PRINT 向
			PRINTFORMS NAME_FROM_PLACE(移動後)
			PRINTW 出发了。
		ENDIF
		
		;通常の職場に移動口上　宴会フラグが立ってなければ表示する
		SIF CFLAG:ARG:宴会参加 == 0
			CALL KOJO_MESSAGE_SEND("EVENT",13,ARG,1,LOCAL)
			
		;addition custom code, let 2hu invite you with them
		;CALL Add_Move_Job(ARG)
	ENDIF
ENDIF
SIF CFLAG:ARG:陪睡中
	CALL SET_TOGETHER(0,ARG,1)
SIF CFLAG:ARG:同行 && CFLAG:ARG:職種 != 51
	CFLAG:ARG:同行 = 0
;End date due to work(? i legit have no idea why or how this gets called)
IF MOREDATE && IS_IN_GROUP_DATE(ARG) ;Check if currently dating
	CALL REMOVE_FROM_GROUP_DATE(ARG)
ELSEIF FLAG:约会的对象 == ARG
	FLAG:约会的对象 = 0
	TFLAG:约会前好感度 = 0
	CFLAG:ARG:约会中 = GET_HOME_MAP()
ENDIF
;職場へ移動
SIF CFLAG:ARG:職場 && SHIRAHU(ARG)
	CFLAG:ARG:現在位置 = CFLAG:ARG:職場
SIF CFLAG:ARG:職種 == 49 && !TCVAR:ARG:烂醉 && (BASE:ARG:酒気 > (MAXBASE:ARG:酒気 / 10) * 8)
	CALL ENKAI_DRUNK(ARG)
CFLAG:ARG:行動 = 5
IF TCVAR:ARG:着替え
	CALL OKIGAE(ARG,TCVAR:ARG:着替え)
ENDIF
;FileName_JOB.ERB ----------------------------- Rev1.00
;工作結束処理
;CALL		USER
;ARG		角色NO
;RETURN		VOID
;COMMENT	
;-----------------------------------------------------------
@CHARA_JOBEND(ARG)
;仕事後延迟SET
SIF CFLAG:ARG:行動 == 5 && !CFLAG:ARG:拠点来訪 ;qol custom code, skip the delay for special visitors
	CALL SET_DERAY(3,ARG)

;工作量を0にする
SIF CFLAG:ARG:行動 == 5
	BASE:ARG:工作量 = 0
;このタイミングで疲労追加
CALL ADD_TIRED(ARG, MAXBASE:ARG:工作量 / 2)

;仕事中フラグOFF
CFLAG:ARG:行動 = 0
;qol custom code
IF TCVAR:ARG:本来的服装 && CFLAG:ARG:基本服装セット == TCVAR:ARG:着替え
	CALL OKIGAE(ARG,TCVAR:ARG:本来的服装)
	TCVAR:ARG:本来的服装 = 0
	TCVAR:ARG:着替え = 0
ENDIF
IF CFLAG:ARG:現在位置 == CFLAG:ARG:職場 && CFLAG:ARG:職種 != 51
	SELECTCASE CFLAG:ARG:職種
	CASE 46
		IF CFLAG:ARG:現在位置 == CFLAG:MASTER:現在位置
			PRINTFORMW %CALLNAME:ARG%结束了玩耍。
			;お疲れ様口上
			SIF CFLAG:ARG:宴会参加 == 0
				CALL KOJO_MESSAGE_SEND("EVENT",13,ARG,3,0)
		ENDIF
	CASE 48
		IF CFLAG:ARG:現在位置 == CFLAG:MASTER:現在位置
			PRINTFORMW %CALLNAME:ARG%的宴会准备已经结束了。
			SIF ARG == [[霊夢]]
				PRINTL 　真是辛苦了
		ENDIF
		;addition custom code, handled by new banquet system
		IF DAY == FLAG:開始日 && TIME >= FLAG:33
			CALL ENKAI_START(ARG)
		ELSEIF 宴会開催中判定()
			CALL ENKAI_START(ARG)
		ENDIF
	CASE 49
		CALL ENKAI_DRUNK(ARG)
	CASE 50
		IF CFLAG:ARG:現在位置 == CFLAG:MASTER:現在位置
			PRINTFORMW %CALLNAME:ARG%的宴会善后已经结束了。
			SIF ARG == [[霊夢]]
				PRINTL 　真是辛苦了
		ENDIF
		CFLAG:ARG:職種 = 0
		CFLAG:ARG:宴会参加 = 0 ;bugfix custom code
		CALL CHARA_JOBEND_GO_HOME(ARG)
	CASEELSE
		IF CFLAG:ARG:現在位置 == CFLAG:MASTER:現在位置
			PRINTFORMW %CALLNAME:ARG%的%GET_JOBNAME(ARG)%结束了。
			;お疲れ様口上
			CALL KOJO_MESSAGE_SEND("EVENT",13,ARG,3,0)
			IF MAXBASE:ARG:工作量 < (TCVAR:ARG:帮忙工作量 * 3) && TCVAR:ARG:礼物
				PRINTFORMW 从%CALLNAME:ARG%得到了%ITEMNAME_TR((TCVAR:ARG:礼物))%
				ITEM:(TCVAR:ARG:礼物) ++
			ENDIF
		ENDIF
		IF !AT_HOME(ARG) && !CFLAG:ARG:神社在住 && VISIT(ARG)
			IF !RAND:15 && CAN_VISIT(ARG) ;custom code, use the CAN_VISIT function
				CALL 主人公物件へ向かう(ARG)
			ELSEIF CFLAG:ARG:現在位置 == CFLAG:MASTER:現在位置 && CAN_DATE(ARG) && !FLAG:约会的对象
				PRINTFORML %CALLNAME:ARG%似乎想要约你出门？
				CALL KOJO_MESSAGE_SEND("EVENT",27,ARG,0,0) ;addition custom code, call date invite kojo
				CALL ASK_YN
				IF !RESULT
					CALL KOJO_MESSAGE_SEND("EVENT",27,ARG,1,0) ;addition custom code
					CALL 外出先から誘えるか(ARG)
					IF RESULT
						;Group date check
						SIF MOREDATE
							CALL ADD_TO_GROUP_DATE(ARG)
						CFLAG:MASTER:同行 = 60
						CFLAG:ARG:同行 = 60
						CFLAG:ARG:约会中 = GET_MAPID(CFLAG:MASTER:現在位置)
						FLAG:约会的对象 = ARG
						TFLAG:约会前好感度 = CFLAG:ARG:好感度
						TIME += 1
						PRINTFORMW 决定工作结束后和%CALLNAME:ARG%去约会
						;必要かわからんが一応
						RETURN
					ENDIF
				ELSE
					CALL KOJO_MESSAGE_SEND("EVENT",27,ARG,2,0) ;addition custom code
				ENDIF
			ENDIF
		ENDIF
		CALL CHARA_JOBEND_GO_HOME(ARG)
	ENDSELECT
ENDIF


@CHARA_JOBEND_GO_HOME(ARG)
IF CFLAG:ARG:神社在住 && !AT_HOME(ARG)
	SIF CFLAG:ARG:現在位置 == CFLAG:MASTER:現在位置
		PRINTFORMW %CALLNAME:ARG%回去%GET_MAPNAME(GET_HOME_MAP())%了
	IF CFLAG:ARG:(450 + GET_CURRENT_MAP(ARG)) ;qol custom code
		CFLAG:ARG:現在位置 = CFLAG:ARG:(450 + GET_CURRENT_MAP(ARG))
	ELSE
	CFLAG:ARG:現在位置 = MAXROOM
	ENDIF ;qol custom code
ENDIF
