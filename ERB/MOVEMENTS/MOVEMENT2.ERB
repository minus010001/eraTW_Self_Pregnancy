;诶嘿嘿リセット
CALL ENDUFUFU_ALL
;夜這い侵入成功フラグクリア
CLEARBIT CFLAG:ARG:夜這い, 8
;移動可能な場所へ移動    移动到可移动位置
CALL GETOUT(MASTER)


@風呂から逐出(ARG)
#LOCALSIZE 1
#LOCALSSIZE 1
SETCOLOR 150,150,250
PRINTL 【浴场的闯入者】
RESETCOLOR
IF TALENT:ARG:羞恥心 < 0
	IF ABL:ARG:親密 < 5
		PRINTFORML 『我现在在里面、请你给我出去』、%CALLNAME:ARG%泰然自若地如此说道。
		CFLAG:ARG:好感度 -= (20 - ABL:ARG:親密 * 2)
		CFLAG:ARG:信赖度 -= (20 - ABL:ARG:親密 * 2)
		SOURCE:ARG:反感 += 300
		CFLAG:MASTER:現在位置 = KICKOUT()
	;ELSE
	;	PRINTFORML %CALLNAME:ARG%坦然的问要不要一起洗
	ENDIF
ELSE
	PRINTFORML %CALLNAME:ARG%察觉了自己所面对的状况、发出尖叫声飞奔出了浴场
	CFLAG:ARG:好感度 -= (50 - ABL:ARG:親密 * 2)
	CFLAG:ARG:信赖度 -= (50 - ABL:ARG:親密 * 2)
	SOURCE:ARG:反感 += 1000
	BASE:ARG:憤怒 += (1500 - ABL:ARG:親密 * 100)
	CFLAG:ARG:現在位置 = KICKOUT()
	;角色を動かしたのでTARGET再設定
ENDIF

;幻想乡大地图，移动逻辑修改
SIF GMF_GETBIT("幻想乡大地图")
	CALL GMF_BATH_KICKOUT(ARG)

CFLAG:ARG:好感度 = MAX(CFLAG:ARG:好感度,0)
CFLAG:ARG:信赖度 = MAX(CFLAG:ARG:信赖度,0)
CALL TARGETSET_CHECK
CFLAG:ARG:同室 = 0
RETURN 1


@待客室処理(ARG)
#LOCALSIZE 1
#LOCALSSIZE 1
SIF FLAG:時間停止 || !CFLAG:ARG:招待
	RETURN

;待客室から出たら日常に返回    从待客室出来回到日常
;泊まる前か後かは连住禁止フラグを参照してます    住宿之前还是之后参照禁止连住标志
IF CFLAG:MASTER:現在位置 != OMANEKIBEYA()
	CALL 待客室から出る(ARG)

;翌日仕事に行く場合    第二天去工作
ELSEIF 仕事中チェック(ARG) && TCVAR:ARG:连住禁止 && CFLAG:ARG:诶嘿嘿 != 1
	SIF !MOREDATE || (MOREDATE && CFLAG:MASTER:お招き == ARG) ;only kick from room if they own it
		CFLAG:MASTER:現在位置 = CFLAG:ARG:自宅位置
	IF CFLAG:ARG:诶嘿嘿
		PRINTFORMW %CALLNAME:ARG%好像要开始工作了…
		CALL ENDUFUFU(ARG)
		PRINTFORMW %CALLNAME:ARG%虽然依依不舍但还是离开了
	ELSE
		PRINTFORMW %CALLNAME:ARG%因为工作而离开了
	ENDIF
	CALL 待客室から出る(ARG)

;约会中
ELSEIF CHK_DATENOW(CFLAG:ARG:约会中)
	IF CFLAG:ARG:神社在住
		;住宿人物は睡眠時間になったら约会終了    住宿人物到了睡眠时间约会结束
		IF 睡眠時間(ARG)
			CFLAG:ARG:约会中 = GET_HOME_MAP()
			FLAG:约会的对象 = 0
			SIF MOREDATE
				CALL REMOVE_FROM_GROUP_DATE(ARG)
		ENDIF
	ELSE
		;约会中に返回時間が来たらメッセージ＆约会だけ消す    如果在约会中收到返回时间的消息，就只删除消息和约会信息
		IF !VISIT(ARG)
			CALL KITAKU(ARG)
		ENDIF
	ENDIF
ENDIF


@待客室から出る(ARG)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC 出口
;遭遇フラグを自宅位置に設定（連動してると他の角色が駆けつけてくるのは仕様）    将遭遇标志设置在家中位置（若已联动，其他角色会赶来，这是正常现象）
CFLAG:ARG:遭遇位置 = CFLAG:ARG:自宅位置
;初期位置を元に戻す（参道的另一边や0もいるが99でもおｋ）    将初始位置恢复（参道的另一边或0都行，99也ok）
IF CFLAG:ARG:神社在住
	CFLAG:ARG:初期位置 = CFLAG:ARG:神社在住
ELSE
	CFLAG:ARG:初期位置 = SUKIMA()
ENDIF
;如果是活动时间，就直接进行约会。搬入角色如果醒着，也可以约会。
;原本是这样打算的，但感觉会破坏平衡，而且过夜后一个人离开更有感觉，所以只针对搬入角色。
;因为活动前也开始配置角色了，所以如果是起床时间，就让他们出门。
IF CFLAG:ARG:神社在住
	CFLAG:ARG:現在位置 = ROAD_TO(MAIN_MAP)
	CFLAG:ARG:约会中 = GET_HOME_MAP()
	FLAG:约会的对象 = 0
	TFLAG:约会前好感度 = 0
	SIF MOREDATE
		CALL REMOVE_FROM_GROUP_DATE(ARG)
ELSE
	IF !睡眠時間(ARG) && !CFLAG:ARG:睡眠
		;自宅位置に移動
		CFLAG:ARG:現在位置 = CFLAG:ARG:遭遇位置
		;泊まる前or住宿人物なら约会継続,ワープ移動してたらダメ    若是在住宿前或住宿的人，则可继续约会，但不能瞬移
		IF !TCVAR:ARG:连住禁止 && CHK_DATENOW(CFLAG:ARG:约会中) && !AT_HOME(MASTER)
			CFLAG:ARG:约会中 = (CFLAG:ARG:自宅位置) / 100
			CFLAG:ARG:同行 = 60
		ENDIF
	;寝ている場合は見えないところに移動    若处于睡眠状态则移至看不见的地方
	;住宿人物は識別するために現在位置97を使ってるので要注意（MOVEMENT2のSLEEPへ続く）    为识别住宿人员，目前使用位置97，请注意（接MOVEMENT2的SLEEP）
	ELSE
		CFLAG:ARG:現在位置 = SUKIMA()
		CFLAG:ARG:约会中 = GET_HOME_MAP()
		FLAG:约会的对象 = 0
		TFLAG:约会前好感度 = 0
		SIF MOREDATE
			CALL REMOVE_FROM_GROUP_DATE(ARG)
	ENDIF
ENDIF

;招待フラグを消して日常に戻す
CFLAG:ARG:招待 = 0
IF !MOREDATE || (MOREDATE && CFLAG:MASTER:お招き == ARG) ; need to always runs this in case player turns off mod and characters get their initial place stuck forever
	LOCK:(OMANEKIBEYA()) = 0
	;GET EXIT
	IF CFLAG:(CFLAG:MASTER:お招き):自宅位置
		出口 = CFLAG:(CFLAG:MASTER:お招き):自宅位置
	ELSE
		DO
			LOCAL = RAND:9
			IF LOCAL == MAIN_MAP
				出口 = 0
			ELSE
				出口 = LOCAL * 100 + 10
			ENDIF
		LOOP !出口
	ENDIF
	;move player to exit
	CFLAG:MASTER:お招き = 0
	CFLAG:MASTER:デート中 = 出口 / 100
	CFLAG:MASTER:現在位置 = 出口
	CALL MOREDATES_HOUSE_EXIT(出口)
ENDIF

;幻想乡大地图，移动逻辑修改
SIF GMF_GETBIT("幻想乡大地图")
	CALL GMF_RECEPTION_ROOM_OUT(ARG)

@OneNightStay(ARG)
#LOCALSIZE 3
#LOCALSSIZE 1
#DIM YANUSHI
#DIM REQUIRED_DESIRE
YANUSHI = PRIVATEROOM:(CFLAG:MASTER:初期位置 % 100)
SIF CFLAG:ARG:积攒度 < 800
	RETURN
SIF CFLAG:ARG:現在位置 != CFLAG:MASTER:現在位置
	RETURN
;qol custom code
; SIF FLAG:一時滞在
; 	RETURN
SIF CFLAG:ARG:神社在住
	RETURN
SIF !AT_HOME(MASTER)
	RETURN
IF GMF_GETBIT("幻想乡大地图")
	SIF GET_MAPID(CFLAG:MASTER:現在位置) != GMF_HOME_MAP
		RETURN
ENDIF
REQUIRED_DESIRE = 10
SIF TALENT:ARG:恋慕 || TALENT:ARG:炮友
	REQUIRED_DESIRE -= 5
SIF TALENT:ARG:思慕
	REQUIRED_DESIRE -= 2
IF !(CFLAG:ARG:既成事實 & 合意_诶嘿嘿)
	REQUIRED_DESIRE += TALENT:ARG:一線越えない * 2
	REQUIRED_DESIRE += TALENT:ARG:貞操 * 2
ENDIF
SIF TALENT:ARG:風騷
	REQUIRED_DESIRE = 0
SIF ABL:ARG:欲望 < REQUIRED_DESIRE
	RETURN

PRINTFORML %CALLNAME:ARG%说今天晚上不想回去…
;帰宅口上,7,今夜は帰りたくない
CALL KOJO_MESSAGE_SEND("EVENT", 20, ARG, 7)
CALL ASK_YN("同意留宿","不同意留宿")
IF !RESULT
	IF !QOL_CAN_STAY_OVER(ARG) ; qol custom code
		PRINTFORMW 虽然非常想让对方留下了、但是有点害怕%CALLNAME:YANUSHI%…
		GOTO REFUSAL
	ELSE
		;qol custom code, description
		LOCAL = 0
		LOCAL:1 = 0
		LOCAL:2 = 0
		LOCALS =
		DO
			LOCAL = FINDCHARA(CFLAG:初期位置, CFLAG:MASTER:初期位置, LOCAL + 1, CHARANUM - 1)
			SIF LOCAL == ARG
				CONTINUE
			IF LOCAL > 0
				LOCALS += @"%CALLNAME:LOCAL%、"
				LOCAL:1++
				LOCAL:2 = LOCAL
			ENDIF
		LOOP LOCAL > 0 && LOCAL < CHARANUM - 1
		IF LOCAL:1
			PRINTFORMDL 你询问%LIST_IN_STRING_CN(LOCALS)%的意见，\@ LOCAL:1 > 1 ? 她们都 # 她 \@欣然允许%CALLNAME:ARG%留宿一晚。
		ENDIF
	ENDIF
	; FLAG:一時滞在 = ARG
	; CFLAG:ARG:本来の初期位置 = CFLAG:ARG:初期位置
	; CFLAG:ARG:初期位置 = CFLAG:MASTER:初期位置
	; CFLAG:ARG:神社在住 = CFLAG:ARG:初期位置
	CALL QOL_STAYOVER(ARG) ;qol custom code
	PRINTFORMW %CALLNAME:ARG%在%NAME_FROM_PLACE(CFLAG:MASTER:初期位置)%留宿了
	;帰宅口上,8,泊まっていくことになる
	CALL KOJO_MESSAGE_SEND("EVENT", 20, ARG, 8)
ELSE
	$REFUSAL
	PRINTFORMW %CALLNAME:MASTER%郑重地拒绝了
	;帰宅口上,9,断った
	CALL KOJO_MESSAGE_SEND("EVENT", 20, ARG, 9)
ENDIF
