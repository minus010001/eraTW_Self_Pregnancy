;FileName_MOVEMENT.ERB ----------------------------- Rev1.00
;時間経過処理
;CALL		USER
;ARG		経過時間前
;RETURN		時間経過量
;COMMENT	
;-----------------------------------------------------------
@TIME_PROGRESS(ARG)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
SIF TIME + DAY * 1440 < ARG
	RETURNF 0
IF MAGIC_DLC
	;分两部分处理, 超出当前时间的部分乘以时间因子, 不超出的部分返回时间差
	IF ARG < TIME:1
		LOCAL = TIME:1 - ARG + MAGIC_TimeFactor2(TIME + 1440 * DAY - TIME:1)
	ELSE
		LOCAL = MAGIC_TimeFactor2(TIME + DAY * 1440 - ARG)
	ENDIF
	RETURNF LOCAL
ELSE
	RETURNF TIME + DAY * 1440 - ARG
ENDIF 

;FileName_MOVEMENT.ERB ----------------------------- Rev1.01
;角色帰宅処理
;CALL		USER
;ARG		0:角色NO
;RETURN		VOID
;COMMENT	
;-----------------------------------------------------------
@KITAKU(ARG)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS 帰宅理由
;午前3時～午前7時
IF INRANGE(TIME, 180, 420)
	帰宅理由 = 天亮了、
;午前7時～午後3時
ELSEIF INRANGE(TIME, 421, 899)
	帰宅理由 = 差不多到时间了、
;午後3時～午後7時
ELSEIF INRANGE(TIME, 900, 1140)
	帰宅理由 = 太阳下山了、
;午後7時～午前3時
ELSE
	帰宅理由 = 已经是深夜了、
ENDIF

IF CFLAG:ARG:現在位置 == CFLAG:MASTER:現在位置 && !CFLAG:MASTER:睡眠 && CFLAG:ARG:現在位置 != CFLAG:ARG:初期位置
	CALL OneNightStay(ARG)
	SIF CFLAG:ARG:神社在住
		RETURN
	IF 睡眠時間(ARG)
		PRINTFORMW %CALLNAME:ARG%去睡眠了。
	;约会中
	ELSEIF CHK_DATENOW(CFLAG:(ARG):约会中)
		;诶嘿嘿中は非表示
		SIF !CFLAG:ARG:诶嘿嘿
			PRINTFORMW %帰宅理由%%CALLNAME:ARG%和你的约会到此为止。
		;自宅にいる時,待客室にいる時は诶嘿嘿していない時    在自宅或在待客室，且没有在诶嘿嘿时
		IF (CFLAG:ARG:現在位置 == CFLAG:ARG:自宅位置 && (!GMF_GETBIT("幻想乡大地图") || GMF_IS_ODEKAKE(-1))) || (CFLAG:ARG:現在位置 == OMANEKIBEYA() && !CFLAG:ARG:诶嘿嘿)
			;帰宅口上,3,玄関先で見送り
			CALL KOJO_MESSAGE_SEND("EVENT", 20, ARG, 3)
		;通常の约会中
		ELSE
			;お誘い
			IF (TALENT:ARG:恋慕 || TALENT:ARG:炮友 == 2) && CFLAG:ARG:积攒度 >= (700 + TALENT:ARG:羞恥心 * 150) && !CFLAG:ARG:神社在住 && !TCVAR:ARG:连住禁止 && CFLAG:(ARG):現在位置 != OMANEKIBEYA()
				PRINTFORML 被%CALLNAME:ARG%邀请去房间
				;帰宅口上,4,部屋に来ないかと誘う
				CALL KOJO_MESSAGE_SEND("EVENT", 20, ARG, 4)
				CALL ASK_YN("去","不去")
				IF !RESULT
					IF CFLAG:ARG:自宅位置
						PRINTFORML %CALLNAME:ARG%的邀请下、%CALLNAME:MASTER%走向了%CALLNAME:ARG%的房间……
						LOCAL = TIME_REQUIRED(GET_MAPID(CFLAG:ARG:現在位置), GET_MAPID(CFLAG:ARG:自宅位置))
						PRINTFORMW +{LOCAL}分
						TIME += LOCAL
					ELSE
						PRINTFORML 应%CALLNAME:ARG%的邀请、%CALLNAME:MASTER%走向了%CALLNAME:ARG%那不知道具体方位的房间……
						PRINTFORMW +30分
						TIME += 30
					ENDIF
					;帰宅口上,5,誘われるまま行く
					SIF MOREDATE
						HouseInvitationStatus = 1
					CALL KOJO_MESSAGE_SEND("EVENT", 20, ARG, 5, 0)
					CALL OMANEKI_ENTER(ARG)
					CALL TARGETSET_CHECK
				ELSE
					PRINTFORMW %CALLNAME:ARG%好象很寂寞似的……
					;帰宅口上,6,誘いを拒绝
					CALL KOJO_MESSAGE_SEND("EVENT", 20, ARG, 6)
					SIF (CFLAG:MASTER:現在位置 % 100) % 10 && CHK_DATENOW(CFLAG:MASTER:约会中) && FLAG:约会的对象 == ARG && CFLAG:MASTER:現在位置 != OMANEKIBEYA()
						CFLAG:MASTER:現在位置 = CFLAG:MASTER:约会中 * 100
				ENDIF
			ELSE
				;帰宅口上,2,约会中帰宅
				CALL KOJO_MESSAGE_SEND("EVENT", 20, ARG, 2)
				SIF (CFLAG:MASTER:現在位置 % 100) % 10 && CHK_DATENOW(CFLAG:MASTER:约会中) && FLAG:约会的对象 == ARG && CFLAG:MASTER:現在位置 != OMANEKIBEYA()
					CFLAG:MASTER:現在位置 = CFLAG:MASTER:约会中 * 100
			ENDIF
		ENDIF
	;神社内にいるか自宅でもお招き部屋でもない場所
	ELSEIF AT_HOME(ARG) || (CFLAG:(ARG):現在位置 != CFLAG:(ARG):自宅位置 && CFLAG:(ARG):現在位置 != OMANEKIBEYA()) && CFLAG:ARG:行動 != 5
		;帰宅口上,1,通常帰宅
		CALL KOJO_MESSAGE_SEND("EVENT", 20, ARG, 1)
		PRINTFORMW %帰宅理由%%CALLNAME:ARG%回去了。
		CALL SET_TOGETHER(0,ARG,1)
		SIF (CFLAG:MASTER:現在位置 % 100) % 10 && CHK_DATENOW(CFLAG:MASTER:约会中) && FLAG:约会的对象 == ARG && CFLAG:MASTER:現在位置 != OMANEKIBEYA()
			CFLAG:MASTER:現在位置 = CFLAG:MASTER:约会中 * 100
		IF GMF_GETBIT("幻想乡大地图")
			CFLAG:ARG:GMF_現在拠点位置 = CFLAG:ARG:初期位置
			CFLAG:ARG:現在位置 = CFLAG:ARG:GMF_現在拠点位置
		ENDIF
	ENDIF
	IF CFLAG:(ARG):诶嘿嘿 > 0 || CHK_DATENOW(CFLAG:(ARG):约会中)
		;修改了大量判定
		CFLAG:ARG:约会中 = GET_HOME_MAP()
		FOR LOCAL,1,CHARANUM
			;お招き中は継続
			SIF CFLAG:MASTER:お招き != LOCAL && CFLAG:LOCAL:うふふ
				CALL ENDUFUFU(LOCAL)
			;デートは消える
			CFLAG:LOCAL:デート中 = GET_HOME_MAP()
			FLAG:デート相手 = 0
			TFLAG:デート前好感度 = 0
		NEXT
		SIF MOREDATE
			CALL REMOVE_FROM_GROUP_DATE(ARG)
		;お招きうふふ中は継続
		SIF !CFLAG:MASTER:お招き
			CFLAG:MASTER:うふふ = 0
		CFLAG:MASTER:同行 = 0
	ENDIF
ENDIF
CFLAG:ARG:同行 = 0

IF !TCVAR:ARG:休憩中 && !CFLAG:ARG:招待
	;拠点から返回なら今日はもう来訪しない
	SIF IN_HOME(CFLAG:ARG:現在位置) && !CFLAG:MASTER:睡眠
		CFLAG:ARG:拠点来訪 = 0
	;活動時間外は自宅が那个ば寝るまで自宅にいる
	IF CFLAG:ARG:自宅位置 && !IN_HOME(CFLAG:ARG:自宅位置) && !睡眠時間(ARG)
		CFLAG:ARG:現在位置 = CFLAG:ARG:自宅位置
	;自宅がないか寝ると消える
	ELSE
		CFLAG:ARG:現在位置 = SUKIMA()
	ENDIF
	CFLAG:ARG:GMF_現在拠点位置 = CFLAG:ARG:初期位置
ENDIF

;幻想乡大地图，移动逻辑修改
SIF GMF_GETBIT("幻想乡大地图")
	CALL GMF_KITAKU(ARG)

