;-----------------------------------------------------------
;Map描画処理
;2文字セットの半角数字(01とか)は自動でボタン化、全角数字は認識しない
;-----------------------------------------------------------
@DRAW_MAP(ARGS)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS DYNAMIC AA, 50
#DIMS DYNAMIC COLOR, 50
#DIM DYNAMIC MODE
#DIM DYNAMIC LOCATION
#DIM DYNAMIC LOCAL_MAP

#DIM DYNAMIC LINENUM
#DIM DYNAMIC X_POINT

;GMF：用局部变量替代轻量级上下文切换
;添加搬家时需要特殊处理的情况
IF SETTING_MAP
	LOCAL_MAP = MAIN_MAP
ELSE
	LOCAL_MAP = GET_CURRENT_MAP()
ENDIF
;AAを取得、なければそのまま返回
VARSET AA
VARSET COLOR
SETFONT "ＭＳ ゴシック"
;お出かけMapかどうかの分岐
IF ARGS == "ODEKAKE"
	TRYCCALLFORM ODEKAKEMAP_{CFLAG:MASTER:约会中}(AA)
	CATCH
		SETFONT
		RETURN 0
	ENDCATCH
ELSE
	TRYCCALLFORM MAP_VIEWING(LOCAL_MAP)
		;BugFix: 地图切换时 TFLAG 可能残留越界值，在此处做最终的边界安全检查
		IF GMF_GETBIT("幻想乡大地图")
			TFLAG:地圖切換 = LIMIT(TFLAG:地圖切換, 1, GMF_MAP_PAGES:LOCAL_MAP)
			CALL DRAW_INFORMATIONLINE(@"%GMF_MAPNAME:LOCAL_MAP:(TFLAG:地圖切換)%")
		ELSE
			TFLAG:地圖切換 = LIMIT(TFLAG:地圖切換, 1, MAP_PAGES)
			CALL DRAW_INFORMATIONLINE(@"%MAPNAME:(TFLAG:地圖切換)%")
		ENDIF
		PRINTFORML 
		IF RECOLOREDMAPS
			TRYCCALLFORM COLOREDMAP_%RESULTS%_{TFLAG:地圖切換}(AA, COLOR)
			CATCH
				RECOLOREDMAPS = 0
				CALL DRAW_MAP
				RECOLOREDMAPS = 1
				RETURN
			ENDCATCH
		ELSE
			TRYCALLFORM MAP_%RESULTS%_{TFLAG:地圖切換}(AA)
		ENDIF
	CATCH
		SETFONT
		RETURN 0
	ENDCATCH
ENDIF

;-----------------------------------------------------------
;描画処理
;-----------------------------------------------------------
FOR LINENUM, 0, VARSIZE("AA")
	SIF AA:LINENUM == ""
		CONTINUE
	;行ごとに初期化
	X_POINT = 0
	RESULTS = I
	;行の終端までループ
	WHILE RESULTS != "" && STRLENSU(RESULTS) < 3
		;1文字取り出す
		SUBSTRINGU AA:LINENUM, X_POINT, 1
		;数字ならボタンにする
		IF ISNUMERIC(RESULTS)
			;分岐めんどいから必ず2ケタ取る
			SUBSTRINGU AA:LINENUM, X_POINT, 2
			CALL GETMAP(TOINT(RESULTS), ARGS)
			X_POINT += 2
		;記号に意味を持たせる例、これだと#は普通には使えなくなるけどまあいいか
		ELSEIF RESULTS == "#"
			;必ず二文字取る
			SUBSTRINGU AA:LINENUM, X_POINT, 2
			IF ARGS == "HIKKOSHI"
				TRYCALLFORM DRAW_MAP_BG_{LOCAL_MAP}(RESULTS)
			ELSE
				TRYCALLFORM DRAW_MAP_BG_{CFLAG:MASTER:约会中}(RESULTS)
			ENDIF
			X_POINT += 2
		;ふつうの文字
		ELSE
			;CALL DRAW_MAP_BG(RESULTS)
			IF ARGS == "HIKKOSHI"
				TRYCALLFORM DRAW_MAP_BG_{LOCAL_MAP}(RESULTS)
			ELSE
				TRYCALLFORM DRAW_MAP_BG_{CFLAG:MASTER:约会中}(RESULTS)
			ENDIF
			X_POINT ++
		ENDIF
	WEND
	PRINTL
NEXT
SETFONT
RESETCOLOR
;------------------------------------------
;Mapの表示設定
;ARG    表示するMapのMAPID
;ARG:1  判定する場所ID（任意）
;------------------------------------------
@MAP_VIEWING(ARG, ARG:1)
#LOCALSIZE 1
#LOCALSSIZE 1
SIF !TFLAG:地圖切換
	TFLAG:地圖切換 = MAP_AREASELECT(ARG, ARG:1)
RESULTS = %MAP_VIEWING_NAME(ARG)%

;------------------------------------------
;Mapに表示する数字ボタンの描画設定
;ARG   二桁のボタン数値（場所IDの下二桁）
;ARGS  "ODEKAKE"=お出かけMap
;------------------------------------------
@GETMAP(ARG, ARGS, IS_GET_HTML_STR)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC P_ID
#DIM DYNAMIC Q_ID
#DIM DYNAMIC IS_GET_HTML_STR
#DIMS DYNAMIC LOCAL_TITLE
#DIM DYNAMIC LOCAL_MAP

;GMF：用局部变量替代轻量级上下文切换
;添加搬家时需要特殊处理的情况
IF SETTING_MAP
	LOCAL_MAP = MAIN_MAP
ELSE
	LOCAL_MAP = GET_CURRENT_MAP()
ENDIF
;お出かけMap
IF ARGS == "ODEKAKE"
	P_ID = (ARG * 10) + (CFLAG:MASTER:约会中 * 100)
;拠点Map
ELSE
	P_ID = ARG + LOCAL_MAP * 100
ENDIF
;居場所察知
IF (TALENT:MASTER:居場所察知 || MAGIC_IS_CLAIR()) && (FLAG:察知模式 == 1 || ARGS == "ODEKAKE")
	IF ARGS != "ODEKAKE"
		;路人は優先度最低
		SIF (GMF_GETBIT("幻想乡大地图") ? GMF_ROOMDATA:LOCAL_MAP:ARG # ROOMDATA:ARG) & 場所_路人
			SETCOLOR C_D_PINK
	ENDIF

	KEHAI = 0
	FOR LOCAL, 1, CHARANUM
		;内部構造判定,第三引数は第二と同じにする
		IF ARGS != "ODEKAKE" && GETMAP_BUILDING(LOCAL_MAP, P_ID, P_ID)
			;内部にあたる場所を全部チェック
			FOR Q_ID, MINROOM(LOCAL_MAP), MAXROOM(LOCAL_MAP)
				IF GETMAP_BUILDING(LOCAL_MAP, P_ID, Q_ID) && CFLAG:LOCAL:現在位置 == Q_ID
					KEHAI = CHECK_HEHAI(LOCAL)
					SIF KEHAI > 1
						BREAK
				ENDIF
			NEXT
		;通常の地点
		ELSEIF CFLAG:LOCAL:現在位置 == P_ID
			KEHAI = CHECK_HEHAI(LOCAL)
		ENDIF
		;特定の行動優先
		SIF KEHAI > 1
			BREAK
	NEXT
	CALL SET_KEHAI_COLOR(KEHAI)
;汚部屋察知,お出かけMap時は不使用
ELSEIF (TALENT:MASTER:汚部屋察知 || MAGIC_IS_CLAIR()) && FLAG:察知模式 == 2 && ARGS != "ODEKAKE"
	IF OUTROOF(P_ID) && DAY:2 == 4
		SELECTCASE YOGORE:P_ID
			CASE IS < 100
				SETCOLOR C_GREEN
			CASE IS < 500
				SETCOLOR C_M_GREEN
			CASE IS < 1000
				SETCOLOR C_P_GREEN
			CASE IS < 2000
				SETCOLOR 0xFFFFFF
			CASE IS < 3500
				SETCOLOR 0xFFFFFF
			CASE IS < 5000
				SETCOLOR 0xFFFFFF
			CASEELSE
				SETCOLOR 0xFFFFFF
		ENDSELECT
	ELSE
		SELECTCASE YOGORE:P_ID
			CASE IS < 100
				SETCOLOR C_GREEN
			CASE IS < 500
				SETCOLOR C_M_GREEN
			CASE IS < 1000
				SETCOLOR C_P_GREEN
			CASE IS < 2000
				SETCOLOR C_YELLOW
			CASE IS < 3500
				SETCOLOR C_V_PINK
			CASE IS < 5000
				SETCOLOR C_RED
			CASEELSE
				SETCOLOR C_RED
		ENDSELECT
	ENDIF
ENDIF

;MASTERは優先度最高
SIF CFLAG:MASTER:現在位置 == P_ID
	SETCOLOR C_GREEN
;Mapプレビュー時（SHOP画面か初期状態）
IF CFLAG:MASTER:睡眠 || (DAY == 1 && TIME == 0)
	SIF P_ID == 默认初期位置 || CMATCH(CFLAG:大家候補, P_ID, 1, CHARANUM)
		SETCOLOR C_ORANGE
ENDIF

;ポップアップ表示とアニメーションと排他にする場合はコメントアウトを外す
;IF ANIMATERECOLOREDMAPS && !FLAG:70
	LOCAL_TITLE '= NAME_FROM_PLACE(P_ID)
	IF (TALENT:MASTER:汚部屋察知 || MAGIC_IS_CLAIR()) && FLAG:察知模式 == 2 && ARGS != "ODEKAKE"
		IF OUTROOF(P_ID) && DAY:2 == 4
			SELECTCASE YOGORE:P_ID
				CASE IS < 100
					LOCAL_TITLE += "  积雪量:干净"
				CASE IS < 500
					LOCAL_TITLE += "  积雪量:小"
				CASE IS < 1000
					LOCAL_TITLE += "  积雪量:较小"
				CASE IS < 2000
					LOCAL_TITLE += "  积雪量:中"
				CASE IS < 3500
					LOCAL_TITLE += "  积雪量:较大"
				CASE IS < 5000
					LOCAL_TITLE += "  积雪量:大"
				CASEELSE
					LOCAL_TITLE += "  积雪量:雪山"
			ENDSELECT
		ELSE
			SELECTCASE YOGORE:P_ID
				CASE IS < 100
					LOCAL_TITLE += "  清洁度:最高"
				CASE IS < 500
					LOCAL_TITLE += "  清洁度:高"
				CASE IS < 1000
					LOCAL_TITLE += "  清洁度:较高"
				CASE IS < 2000
					LOCAL_TITLE += "  清洁度:中"
				CASE IS < 3500
					LOCAL_TITLE += "  清洁度:较低"
				CASE IS < 5000
					LOCAL_TITLE += "  清洁度:低"
				CASEELSE
					LOCAL_TITLE += "  清洁度:垃圾山"
			ENDSELECT
		ENDIF
	ENDIF
	IF (TALENT:MASTER:居場所察知 || MAGIC_IS_CLAIR())
		FOR LOCAL, 1, CHARANUM
			KEHAI = 0
			;内部構造判定,第三引数は第二と同じにする
			IF ARGS != "ODEKAKE" && GETMAP_BUILDING(MAIN_MAP, P_ID, P_ID)
				;内部にあたる場所をすべてチェック
				FOR Q_ID, MINROOM(), MAXROOM
					IF GETMAP_BUILDING(MAIN_MAP, P_ID, Q_ID) && CFLAG:LOCAL:現在位置 == Q_ID
						KEHAI = CHECK_HEHAI(LOCAL)
						BREAK
					ENDIF
				NEXT
			;通常の地点
			ELSEIF CFLAG:LOCAL:現在位置 == P_ID
				KEHAI = CHECK_HEHAI(LOCAL)
			ENDIF
			;行動内容
			IF KEHAI > 0
				SIF LOCAL_TITLE != ""
					LOCAL_TITLE += UNICODE(0x000D)
				LOCAL_TITLE += @"%CALLNAME:LOCAL, 20, LEFT%"
				SELECTCASE KEHAI
					CASE 1
						; LOCAL_TITLE += "何もしてない"
						LOCAL_TITLE += "什么都没在做"
					CASE 2
						; LOCAL_TITLE += "仕事中"
						LOCAL_TITLE += "工作中"
					CASE 3
						LOCAL_TITLE += "睡眠中"
					CASE 4
						LOCAL_TITLE += "自由行动中"
				ENDSELECT
			ENDIF
		NEXT
		SIF LOCAL_TITLE == ""
			LOCAL_TITLE = 谁都不在
	ENDIF
;ENDIF

IF ARGS == "ODEKAKE" && ARG >= 10
	;特殊ワープ用
	SETCOLOR C_P_PURPLE
	IF IS_GET_HTML_STR
		RESULTS = ◇
	ELSE
		PRINTBUTTON "◇", ARG
	ENDIF
ELSE
	IF IS_GET_HTML_STR
		RESULTS = {ARG}
		SIF ARG < 10
			RESULTS '= TOFULL(RESULTS)
	ELSE
		PRINTBUTTON (ARG > 9 ? TOSTR(ARG) # TOFULL(TOSTR(ARG))), ARG
	ENDIF
ENDIF
SIF IS_GET_HTML_STR
	RESULTS = <font color = '#%TOSTR(GETCOLOR(), "X6")%'><button value = '{ARG}' title = '%LOCAL_TITLE%'>%RESULTS%</font></button>
RESETCOLOR

;------------------------------------------
;居場所察知した人物の行動
;------------------------------------------
@CHECK_HEHAI(ARG)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
;仕事中
IF CFLAG:ARG:行動 == 5
	RETURNF 2
;睡眠中
ELSEIF CFLAG:ARG:睡眠
	RETURNF 3
;自由行動中
ELSEIF Activity_Duration:ARG
	RETURNF 4
;何もしてない
ELSE
	RETURNF 1
ENDIF

;------------------------------------------
;居場所察知の着色
;------------------------------------------
@SET_KEHAI_COLOR(ARG)
#LOCALSIZE 1
#LOCALSSIZE 1
;何もしてない＠粉色
IF ARG == 1
	SETCOLOR C_H_PINK
;仕事中＠濃オレンジ
ELSEIF ARG == 2
	SETCOLOR C_D_ORANGE
;睡眠中＠紺色
ELSEIF ARG == 3
	SETCOLOR C_N_BLUE
;自由行動中＠黄色
ELSEIF ARG == 4
	SETCOLOR C_YELLOW
ENDIF

;--------------------------------------------------
;共通のMap描画処理
;ARG      SLICED
;#a～#d       菜園の描画
;#e, #o, #p   拠点の外の描画（气息用）
;--------------------------------------------------
@MAP_PRINT(ARGS)
#LOCALSIZE 1
#LOCALSSIZE 1
SELECTCASE ARGS
CASE "#a"
	IF HATAKE_NAME:0 != ""
		SETCOLOR C_P_GREEN
		PRINT VV
		RESETCOLOR
	ELSE
		PRINT 　
	ENDIF
CASE "#b"
	IF HATAKE_NAME:1 != ""
		SETCOLOR C_P_GREEN
		PRINT VV
		RESETCOLOR
	ELSE
		PRINT 　
	ENDIF
CASE "#c"
	IF HATAKE_NAME:2 != ""
		SETCOLOR C_P_GREEN
		PRINT VV
		RESETCOLOR
	ELSE
		PRINT 　
	ENDIF
CASE "#d"
	IF HATAKE_NAME:3 != ""
		SETCOLOR C_P_GREEN
		PRINT VV
		RESETCOLOR
	ELSE
		PRINT 　
	ENDIF
CASE "#e"
	SIF (TALENT:MASTER:居場所察知 || MAGIC_IS_CLAIR()) && COUNTCHARA:(MAXROOM) > 0 && FLAG:察知模式 == 1
		SETCOLOR 255, 100, 200
	PRINT ↓
	RESETCOLOR
CASE "#o"
	SIF (TALENT:MASTER:居場所察知 || MAGIC_IS_CLAIR()) && COUNTCHARA:(MAXROOM) > 0 && FLAG:察知模式 == 1
		SETCOLOR 255, 100, 200
	PRINT ←
	RESETCOLOR
CASE "#p"
	SIF (TALENT:MASTER:居場所察知 || MAGIC_IS_CLAIR()) && COUNTCHARA:(MAXROOM) > 0 && FLAG:察知模式 == 1
		SETCOLOR 255, 100, 200
	PRINT →
	RESETCOLOR
;被窝
;┌─┐　#f#j#g
;└─┘　#h#j#i
CASE "#f"
	SETCOLOR C_FUTON
	PRINT ┌
	RESETCOLOR
CASE "#g"
	SETCOLOR C_FUTON
	PRINT ┐
	RESETCOLOR
CASE "#h"
	SETCOLOR C_FUTON
	PRINT └
	RESETCOLOR
CASE "#i"
	SETCOLOR C_FUTON
	PRINT ┘
	RESETCOLOR
CASE "#j"
	SETCOLOR C_FUTON
	PRINT ─
	RESETCOLOR
;鳥居
;┳━┳　#l#k#l
;╋━╋　#n#k#n
;┃　┃　#m　#m
CASE "#k"
	SETCOLOR C_TORII
	PRINT ━
	RESETCOLOR
CASE "#l"
	SETCOLOR C_TORII
	PRINT ┳
	RESETCOLOR
CASE "#m"
	SETCOLOR C_TORII
	PRINT ┃
	RESETCOLOR
CASE "#n"
	SETCOLOR C_TORII
	PRINT ╋
	RESETCOLOR
ENDSELECT

;===========================================================
;場所名表示
;===========================================================
@PRINT_SPOT
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS SPOTNAME, 100

VARSET SPOTNAME
CALLFORM MAP_SPOTNAME_{MAIN_MAP}(SPOTNAME)
FOR  LOCAL, 0, VARSIZE("SPOTNAME")
	IF SPOTNAME:LOCAL != ""
		IF MAIN_MAP * 100 + LOCAL != CFLAG:MASTER:現在位置
			PRINTBUTTON TOSTR(LOCAL, "00") + "." + SPOTNAME:LOCAL + "　", MAIN_MAP * 100 + LOCAL
		ELSE
			SETCOLOR 0x00FF00
			PRINTS TOSTR(LOCAL, "00") + "." + SPOTNAME:LOCAL + "　"
			RESETCOLOR
		ENDIF
	ENDIF
NEXT
