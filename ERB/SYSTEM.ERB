;FileName_SYSTM.ERB -------------------------------- Rev1.00
;ニューゲーム処理
;CALL		SYSTEM
;ARG		VOID
;RETURN		VOID
;COMMENT	
;-----------------------------------------------------------
@EVENTFIRST
;ロード時と共通の初期化
CALL INIT_NG_OR_LOAD
;複雑化のため専用関数へ移動
CALL NEWGAME

;积攒度の初期設定
FOR LOCAL,1,CHARANUM
	CFLAG:LOCAL:积攒度 = RAND:500
NEXT

FOR LOCAL,1,CHARANUM
	IF TALENT:LOCAL:路人
		RANDOM_CHARANUM = LOCAL
		BREAK
	ENDIF
NEXT

;アップデート処理
CALL NEWGAME_VERUP

;SYSTEMCALL to SHOW_SHOP
BEGIN SHOP

@EVENTLOAD
#DIM DYNAMIC chara
#DIM DYNAMIC index
#DIM DYNAMIC printTimes
#DIM DYNAMIC L_Time
L_Time = GETTIME()
DEBUGPRINTFORML {L_Time / 10000000000000}年 {(L_Time / 100000000000) % 100}月 {(L_Time / 1000000000) % 100}日 {(L_Time / 10000000) % 100}時だよ
;即时读档
RESETBGCOLOR
STOPBGM
STOPSOUND
CALL 背景图片打印()
IF SaveDataInTrain
	FOR chara, 0, CHARANUM
		FOR index, 0, 500
			STcvar:chara:index = TCVAR:chara:index
		NEXT
		FOR index, 0, 250
			STequip:chara:index = TEQUIP:chara:index
		NEXT
		FOR index, 0, 200
			SPalam:chara:index = PALAM:chara:index
		NEXT
		FOR index, 0, 100
			SaveEX:chara:index = EX:chara:index
		NEXT
		;防死循环
		IF chara % 20
			SIF printTimes % 5 == 0
				TWAIT 1, 0
			printTimes ++
			CLEARLINE 1
			PRINTFORML 少女折寿中%"." * (printTimes / 10 % 3 + 1), 5, LEFT% {chara * 50 / CHARANUM}\%
		ENDIF
	NEXT
	ARRAYCOPY "TFLAG", "STflag"
	CALL INIT_NG_OR_LOAD
	BEGIN TRAIN
ENDIF
VARSET 剧本错误警告
CALL INIT_NG_OR_LOAD
CALL ROOMSETTING
CALL VERSION_UP
SIF CFLAG:MASTER:312
	TIME:3 = CFLAG:MASTER:312
CFLAG:MASTER:312 = 0
;CALL MAKE_ALL_CLASS_LIST
;;依頼：手紙の宛先処理
;CALL SETUP_ALL_LETTERS

;Custom code, updates character dialog status
;CALL CHARACTER_DIALOG_STATUS

FOR LOCAL, 0, CHARANUM
	IF LOCAL != MASTER
		;口上の基本フラグ設定
		CALL KOJO_MESSAGE_SEND("FLAGSETTING", 0, LOCAL)
		IF TALENT:LOCAL:行きずり
			RANDOM_CHARANUM = LOCAL
			BREAK
		ENDIF
	ENDIF
NEXT
SIF SAVESTR:本体バージョン != eraTW_Version || NOW_VERSION != modding_version
	CALL UPDATE_MAIN("init")
modding_version = NOW_VERSION

@EVENTLOAD
#LATER
IF !RANDOM_CHARANUM
	CALL COLORMESSAGE("路人角色编号出错了，请执行一次UPDATE", C_RED, 1)
	FORCEWAIT
ENDIF
;validate penis status
FOR LOCAL, 0, CHARANUM
	IF (HAS_PENIS(LOCAL) && (TALENT:LOCAL:形状 <= 0 || MAXBASE:LOCAL:精力 <= 0 || MAXBASE:LOCAL:勃起 <= 0)) || (!HAS_PENIS(LOCAL) && (TALENT:LOCAL:形状 > 0 || MAXBASE:LOCAL:精力 > 0 || MAXBASE:LOCAL:勃起 > 0))
		CALL COLORMESSAGE(@"%CALLNAME:LOCAL%的鸡鸡信息修正中...",C_YELLOW,1,1)
		IF HAS_PENIS(LOCAL)
			SIF TALENT:LOCAL:形状 <= 0
				TALENT:LOCAL:形状 = 3
			SIF MAXBASE:LOCAL:勃起 <= 0
				MAXBASE:LOCAL:勃起 = 1500
			SIF MAXBASE:LOCAL:精力 <= 0
				MAXBASE:LOCAL:精力 = 1000
		ELSE
			TALENT:LOCAL:形状 = 0
			MAXBASE:LOCAL:勃起 = 0
			MAXBASE:LOCAL:精力 = 0
		ENDIF
	ENDIF
	SIF LOCAL == MASTER && HAS_PENIS(LOCAL) && MAXBASE:LOCAL:精力 == 1000 ;give back bonus vig the game owes you if you're at base VIG
		CALL Pc_Vig_Recover(MASTER)
	;===== custom code =====
	;IF TALENT:LOCAL:絶倫 && MAXBASE:LOCAL:勃起 == 1500 ;addition custom code
		;CALL COLORMESSAGE(@"%CALLNAME:LOCAL%の勃起力を修正中...",C_YELLOW,1,1)
		;MAXBASE:LOCAL:勃起 *= 2
	;ENDIF
	;=======================
NEXT
;warning for the faulty cflag value
LOCALS '= ""
LOCAL:1 = 0
FOR LOCAL, 1, CHARANUM
	;don't bother if the value is not tampered with
	SIF !CFLAG:LOCAL:口上セレクタ
		CONTINUE
	;check if the main dialogue still works with it
	TRYCCALLFORM M_KOJO_K{NO:LOCAL}_{CFLAG:LOCAL:口上セレクタ}
		IF !RESULT
			LOCAL:1 ++
			LOCALS += CALLNAME:LOCAL + "、"
			剧本错误警告:LOCAL = 1
		ENDIF
	CATCH
		LOCAL:1 ++
		LOCALS += CALLNAME:LOCAL + "、"
		剧本错误警告:LOCAL = 1
	ENDCATCH
NEXT
IF LOCAL:1
	CALL COLORMESSAGE("警告！CFLAG剧本选择的值无效！",C_RED,2,1)
	PRINTFORML 角色数量: {LOCAL:1}
	PRINTFORML 受影响的角色: %LIST_IN_STRING_CN(LOCALS)%
	CALL COLORMESSAGE("请在[500]UPDATE中确认并重选剧本\n由于剧本运作异常，重选时需解除无剧本角色过滤功能",C_RED,2,1)
ENDIF

;需要初始化的数据放在一起
@INIT_NG_OR_LOAD
#LOCALSIZE 1
#LOCALSSIZE 1
;OBJ
;CALL MAKE_ALL_CLASS_LIST
CALL MAKE_ALL_OOP_MAP
BREWING_LIST_CHECKED = 0
CALL BREWING_GUIDE_CHECK_EXISTING
;依頼：手紙の宛先処理
CALL SETUP_ALL_LETTERS
;Custom code, updates character dialog status
;CALL CHARACTER_DIALOG_STATUS
CALL GRAPH_DB_INIT
CALL CREATE_BBAS_DATABASE()
CALL INIT_UFUFU_LOG
CALL INIT_KOJO_COLOR