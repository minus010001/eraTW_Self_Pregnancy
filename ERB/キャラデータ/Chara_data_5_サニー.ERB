@CHARAMOVE_DATA_5(ARG, ARG:2)
#LOCALSIZE 1
#LOCALSSIZE 1
LOCAL = 5
SELECTCASE ARG
	;連動設定（RETURN=依存する角色, RESULT:1～3=対等に連動する角色）
	CASE 1
		RESULT:1 = [[桑尼]]
		RESULT:2 = [[露娜]]
		RESULT:3 = [[斯塔]]
	;特殊生活時間設定（CFLAG:LOCAL:生活時間補正を設定する）
	CASE 3
	;移動傾向（±～10=行きやすい/行きにくい, -100=行かない）
	CASE 4
		SELECTCASE ARG:2
			;よく居る
			CASE P27三妖精之家・大廳
				RETURN 5
		ENDSELECT
	;出現場所
	CASE 7
		SELECTCASE ARG:2
			CASE 桜花道的鳥居, 神社境内, 神社走廊, 妖精的大樹
				RETURN 1
			CASE 霧之湖, 冰造的小雪屋, 正門
				RETURN 1
			CASE 森林的入口, 香霖堂, 古木的大樹, 霧雨魔法店, 人偶的洋館, 再思之道, 無縁塚
				RETURN 1
		ENDSELECT
	;引力設定（CFLAG:LOCAL:引力点を設定する）
	CASE 8
		;平日は5分の4で神社に玩耍に行ったり,露娜、斯塔と連動
		IF YOUBI_MATCH(DAY, "月火水木金") && INRANGE(TIME, 600, 960)
			SELECTCASE CFLAG:LOCAL:今日の運勢 % 5
			CASE 1
				TCVAR:LOCAL:引力点 = P2境内
			CASE 2
				TCVAR:LOCAL:引力点 = P10走廊
			CASE 3
				TCVAR:LOCAL:引力点 = P11庭
			CASE 4
				TCVAR:LOCAL:引力点 = P25鎮守之森
			CASEELSE
				TCVAR:LOCAL:引力点 = 0
			ENDSELECT
		ENDIF
ENDSELECT

@EXIST_キャラデータ5
#LOCALSIZE 1
#LOCALSSIZE 1

@キャラデータ5(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "名前"
	CALLF MAKE_STR(V_NAME, "桑尼")
;こっから衣装設定
CASE "今天的睡衣"
	CALLF MAKE_STR(V_NAME, "睡衣（睡袍）套")

CASE "便装：帽子"
	CALLF MAKE_INT(V_NAME, [[頭装備_女仆发箍]])
CASE "便装：靴"
	CALLF MAKE_INT(V_NAME, [[靴_鞋子]])
CASE "便装：襪子"
	CALLF MAKE_INT(V_NAME, [[襪子_袜子]])
CASE "便装：連衣裙"
	CALLF MAKE_INT(V_NAME, [[連衣裙_連衣裙]])

CASE "固有内衣形容詞"
	CALLF MAKE_STR(V_NAME, "太阳刺绣的")
CASE "固有下半身内衣名"
	CALLF MAKE_STR(V_NAME, "斑点胖次")
CASE "固有上半身内衣"
	CALLF MAKE_INT(V_NAME, 1)
CASE "固有上半身内衣名"
	CALLF MAKE_STR(V_NAME, "抹胸")
CASE "固有内衣着用条件"
	SIF !RAND:(1 + (2 * 勝負内衣判定([[桑尼]])))
		CALLF MAKE_INT(V_NAME, 1)
CASE "固有内衣半透明(前)"
	CALLF MAKE_INT(V_NAME, 1)
CASE "固有内衣半透明(後)"
	CALLF MAKE_INT(V_NAME, 1)
CASE "固有内衣布料厚度"
	CALLF MAKE_INT(V_NAME, 2)

;農民関連
CASE "農民：説明"
	CALLF MAKE_STR(V_NAME, "生菜農家")
CASE "農民：作物"
	CALLF MAKE_STR(V_NAME, "生菜")
CASE "農民：田的种类"
	CALLF MAKE_STR(V_NAME, "生菜田地")
CASE "農民：畑の所在地"
	CALLF MAKE_STR(V_NAME, "博麗神社")

CASE "農民：MapID"
	CALLF MAKE_INT(V_NAME, 0)
CASE "農民：場所ID"
	CALLF MAKE_INT(V_NAME, 25)
CASE "農民：報酬"
	CALLF MAKE_INT(V_NAME, 200)
CASE "農民：金利"
	CALLF MAKE_INT(V_NAME, 3)

;料理関連
CASE "料理：喜欢的味道"
	CALLF MAKE_STR(V_NAME, "牛奶/蘑菇/洋食/油炸食品/辣/丰盛/ジャンキー/濃厚/温暖/豪華/野趣/豪快/黏稠/闪耀/甜/甜/甜/")
CASE "料理：讨厌的味道"
	CALLF MAKE_STR(V_NAME, "質素/酸/酸/野菜/野菜/野菜/怪诞/怪诞/怪诞/謎料理/謎料理/謎料理/")
CASE "料理：助手効果"
	CALLF MAKE_STR(V_NAME, "浓郁/")
;贈り物関連
CASE "感性：好き"
	CALLF MAKE_STR(V_NAME, "朱/果実/かわいい/ポップ/派手/パワフル/ロリータ/" + "日/生体品/" * 3 + "太陽の/陽光の/三位一体の/反射の/" * 5)
CASE "感性：嫌い"
	CALLF MAKE_STR(V_NAME, "別緻/知的/" + "闇/星/月/書物/烟袋/" * 3)

ENDSELECT

;-------------------------------------------------
;固有料理設定
;DISH_NAME          料理名
;RESULTS            料理の種類（軽食/主食/甜点）
;CALL 材料設定("")  材料の指定。"汎用"を入れると自動で汎用食材になる
;DISH_TASTE         味の設定
;DISH_COMMENT       （任意）一行コメント
;DISH_TIME          （任意）調理にかかる時間
;DISH_MAXLIMIT      （任意）料理の持続時間
;-------------------------------------------------
@SPECIAL_MENU_5
#LOCALSIZE 1
#LOCALSSIZE 1
DISH_NAME = 单面煎蛋
RESULTS = 軽食
CALL 材料設定("卵")
DISH_TASTE = 洋食/卵/卵/甜/简易/鲜艳/豪快/
DISH_COMMENT = 煎了一面的荷包蛋。装饰非常的华丽。
DISH_TIME = 10
RETURN 1

;IMAGE_I5_特殊服装(CHARA)-------------------------------------------------------------------
;キャラクター特有の服装表示条件
;エフェクトを共有する服装差分はこちらで指定する
;使用時注意点:
;	RESULTSに特殊服装を格納すること
;	書式は %服装%%特殊服装% 適宜"_"等入れること
;-------------------------------------------------------------------------------------------
@IMAGE_I5_特殊服装(CHARA)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM CHARA
VARSET RESULTS

IF CFLAG:5:差し替え適用 == 3
	IF CHECK_NUDE(CHARA)
	ELSE
		;服
		IF CFLAG:CHARA:睡眠 || CFLAG:CHARA:陪睡中 || 睡眠時間(CHARA)
			RESULTS = _下着
		ELSEIF IS_BUNNY(CHARA)
			RESULTS = _バニーギャル
		ELSEIF CURRENT_CLOTHES_SET(CHARA) == 74
			RESULTS = _セーラー服
		ELSEIF CURRENT_CLOTHES_SET(CHARA) == [[女仆装]]
			RESULTS = _メイド
		ELSEIF CHECK_CLO("bra_visible", CHARA)
			RESULTS = _下着
		ENDIF
	ENDIF
ELSEIF CFLAG:5:差し替え適用 == 1
	;差し替え画像
	IF CHECK_NUDE(CHARA)
		;裸
		IF FLAG:立絵種類
			;顔絵
		ELSE
			;立ち絵
		ENDIF
	ELSE
		;服
		IF FLAG:立絵種類
			;顔絵
				IF IS_BUNNY(CHARA)
					RESULTS = _バニー
				ELSEIF CURRENT_CLOTHES_SET(CHARA) == 62
					RESULTS = _変T
				ELSEIF CURRENT_CLOTHES_SET(CHARA) == 74
					RESULTS = _セーラー
				ELSEIF CHECK_CLO("bra_visible", CHARA)
					RESULTS = _下着
				ELSEIF DAY:2 == 2
					RESULTS = _夏服
				ENDIF
		ELSE
			;立ち絵
			IF CHECK_CLO("bra_visible", CHARA) && EQUIP:CHARA:下半身下着２ != 0
				RESULTS = _下着
			ELSEIF CHECK_CLO("bra_visible", CHARA) && EQUIP:CHARA:下半身下着２ == 0
				RESULTS = _ノーパン下着
			{
			ELSEIF (!EQUIP:CHARA:上半身上着１ && !EQUIP:CHARA:上半身上着２ && !EQUIP:CHARA:外搭 &&
					!EQUIP:CHARA:和服 && !EQUIP:CHARA:連衣裙 &&
					!EQUIP:CHARA:レオタード && !EQUIP:CHARA:ボディースーツ) &&
					EQUIP:CHARA:下半身内衣２ != 0
			}
				RESULTS = _ノーブラ下着
			ELSEIF IS_BUNNY(CHARA)
				RESULTS = _バニー
			ELSEIF CURRENT_CLOTHES_SET(CHARA) == 62
				RESULTS = _変T
			ELSEIF CURRENT_CLOTHES_SET(CHARA) == 74
				RESULTS = _セーラー
			ELSEIF DAY:2 == 2
				RESULTS = _夏服
			ENDIF
		ENDIF
	ENDIF
ELSEIF CFLAG:5:差し替え適用
ELSE
	;通常画像
	IF CHECK_NUDE(CHARA)
		;裸
		IF FLAG:立絵種類
			;顔絵
		ELSE
			;立ち絵
		ENDIF
	ELSE
		;服
		SIF DAY:2 == 2
			RESULTS = _夏服
	ENDIF
ENDIF

