;IMAGE_I5_特殊表情COM(CHARA, コマンド)-------------------------------------------------------
;直前のコマンドで変化するキャラクター特有の表情表示条件
;時間停止中は変化しない表情はこちら
;使用時注意点:
;	RESULTS:0に表情を格納
;	RESULTS:1にマウスオーバー時の表情を格納すること
;	"オナニー","愛撫","性交"は本編で実装済み
;-------------------------------------------------------------------------------------------
@IMAGE_I5_特殊表情COM(CHARA, 指令)
#DIM CHARA
#DIM 指令

IF CFLAG:5:差し替え適用 == 3
	IF CHECK_NUDE(CHARA)
	ELSE
		IF IS_BUNNY(CHARA)
		ELSEIF CURRENT_CLOTHES_SET(CHARA) == 74
		ELSEIF CURRENT_CLOTHES_SET(CHARA) == [[女仆装]]
		ELSEIF CHECK_CLO("bra_visible", CHARA)
		ELSE
			SELECTCASE 指令
				CASE 305
					RESULTS = 膝枕覆盖
			ENDSELECT
		ENDIF
	ENDIF
ELSEIF CFLAG:5:差し替え適用
	;差し替え画像
	IF FLAG:立絵種類
		;顔絵
	ELSE
		;立ち絵
	ENDIF
ELSE
	;通常画像
	IF FLAG:立絵種類
		;顔絵
	ELSE
		;立ち絵
	ENDIF
ENDIF

