;IMAGE_I11_特殊服装(CHARA)-------------------------------------------------------------------
;キャラクター特有の服装表示条件
;エフェクトを共有する服装差分はこちらで指定する
;使用時注意点:
;	RESULTSに特殊服装を格納すること
;	書式は %服装%%特殊服装% 適宜"_"等入れること
;-------------------------------------------------------------------------------------------
@IMAGE_I11_特殊服装(CHARA)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM CHARA
VARSET RESULTS

IF CFLAG:11:差し替え適用 == 2
	IF CHECK_NUDE(CHARA)
	ELSE
		;服
		SIF DAY:0 % 2
			RESULTS = _日替わり
	ENDIF
ELSEIF CFLAG:11:差し替え適用 == 1
	;差し替え画像
	IF CHECK_NUDE(CHARA)
		;裸
		IF FLAG:立絵種類
			;颜绘
			IF DAY:2 == 4
				RESULTS = _冬服
			ELSEIF DAY:0 % 2 && DAY:2 != 4
				RESULTS = _日替わり
			ENDIF
		ELSE
		;立ち絵
			IF DAY:2 == 4
				RESULTS = _冬服
			ELSEIF DAY:0 % 2 && DAY:2 != 4
				RESULTS = _日替わり
			ENDIF
		ENDIF
	ELSE
		;服
		IF FLAG:立絵種類
			;顔絵
			IF TEQUIP:CHARA:SWIMMING || EQUIP:CHARA:レオタード == 8
				RESULTS = _水着
			ELSEIF CHECK_CLO("bra_visible", CHARA)
				IF DAY:0 % 2 && DAY:2 != 4
					RESULTS = _日替わり下着
				ELSE
					RESULTS = _下着
				ENDIF
			ELSEIF IS_BUNNY(CHARA)
				RESULTS = _バニー
			ELSEIF CURRENT_CLOTHES_SET(CHARA) == 62
				RESULTS = _変T
			ELSEIF CURRENT_CLOTHES_SET(CHARA) == 74
				RESULTS = _セーラー
			ELSEIF DAY:2 == 4
				RESULTS = _冬服
			ELSEIF DAY:0 % 2 && DAY:2 != 4
				RESULTS = _日替わり
			ENDIF
		ELSE
			;立ち絵
			IF TEQUIP:CHARA:SWIMMING || EQUIP:CHARA:レオタード == 8
				RESULTS = _水着
			ELSEIF CHECK_CLO("bra_visible", CHARA) && EQUIP:CHARA:下半身下着２ != 0
				IF DAY:0 % 2 && DAY:2 != 4
					RESULTS = _日替わり下着
				ELSE
					RESULTS = _下着
				ENDIF
			ELSEIF CHECK_CLO("bra_visible", CHARA) && EQUIP:CHARA:下半身下着２ == 0
				IF DAY:0 % 2 && DAY:2 != 4
					RESULTS = _日替わりノーパン下着
				ELSE
					RESULTS = _ノーパン下着
				ENDIF
			{
			ELSEIF (!EQUIP:CHARA:上半身上着１ && !EQUIP:CHARA:上半身上着２ && !EQUIP:CHARA:外搭 &&
					!EQUIP:CHARA:和服 && !EQUIP:CHARA:連衣裙 &&
					!EQUIP:CHARA:レオタード && !EQUIP:CHARA:ボディースーツ) &&
					EQUIP:CHARA:下半身内衣２ != 0
			}
				IF DAY:0 % 2 && DAY:2 != 4
					RESULTS = _日替わりノーブラ下着
				ELSE
					RESULTS = _ノーブラ下着
				ENDIF
			ELSEIF IS_BUNNY(CHARA)
				RESULTS = _バニー
			ELSEIF CURRENT_CLOTHES_SET(CHARA) == 62
				RESULTS = _変T
			ELSEIF CURRENT_CLOTHES_SET(CHARA) == 74
				RESULTS = _セーラー
			ELSEIF DAY:2 == 4
				RESULTS = _冬服
			ELSEIF DAY:0 % 2 && DAY:2 != 4
				RESULTS = _日替わり
			ENDIF
		ENDIF
	ENDIF
ELSE
	;通常画像
	IF CHECK_NUDE(CHARA)
		SIF BATHROBE_SWITCH && BATHROOM() && !CFLAG:诶嘿嘿
			RESULTS = _浴袍

	ELSE
		;服
		SIF DAY:0 % 2 && DAY:2 != 4
			RESULTS = _日替わり
	ENDIF
ENDIF

