@CHARAMOVE_DATA_11(ARG, ARG:2)
#LOCALSIZE 1
#LOCALSSIZE 1
LOCAL = 11
SELECTCASE ARG
	;連動設定（RETURN=依存する角色, RESULT:1～3=対等に連動する角色）
	CASE 1
	;特殊生活時間設定（CFLAG:LOCAL:生活時間補正を設定する）
	CASE 3
	;移動傾向（±～10=行きやすい/行きにくい, -100=行かない）
	CASE 4
		SELECTCASE ARG:2
			;神社のよくいるところ
			CASE P2境内, P10走廊
				RETURN 5
			;よく居る
			CASE P502香霖堂, P507菌菇群生地
				RETURN 5
			;引きこもらない
			CASE P512魔理沙宅・寝室
				RETURN -10
			;愛麗絲以外の私室には入らない
			CASE P522人偶洋館・神綺的房間, P523人偶洋館・夢子的房間, P526人偶洋館・風呂, P531人偶洋館・空的部屋
				RETURN -100
			CASE P535艾伦宅・寝室, P537艾伦宅・風呂, P541朱鷺子的棲息処, P542莉格露的棲息処, P543露米娅的棲息処, P544成美の小屋, P545慧ノ子の棲み処
				RETURN -100
			CASE P310図書館
				RETURN 10
		ENDSELECT
	;出現場所
	CASE 7
		SELECTCASE ARG:2
			CASE 桜花道的鳥居, 神社境内, 神社走廊, 夢幻遺跡
				RETURN 1
			CASE 広場, 商家町, 呑屋小道, 長屋街
				RETURN 1
			CASE 霧之湖, 正門, 大廳, 食堂, 大図書館, 地下室
				RETURN 1
			CASE 竹林入口, 迷失的小道, 斜角的竹林, 永遠亭, 夢幻館
				RETURN 1
			CASE 森林的入口, 香霖堂, 古木的大樹, 霧雨魔法店, 人偶的洋館, 再思之道, 無縁塚
				RETURN 1
			CASE 魔界都市, 万魔殿, 冰雪世界, 法界
				RETURN 1
		ENDSELECT
	;引力設定（CFLAG:LOCAL:引力点を設定する）
	CASE 8
		;水木金15～19時は看店,たまにサボる
		IF YOUBI_MATCH(DAY, "水木金") && INRANGE(TIME, 900, 1140) && CFLAG:LOCAL:今日の運勢 > 200
			TCVAR:LOCAL:引力点 = P510霧雨魔法店
		;19～22時はまぁまぁな頻度で研究部屋にこもる
		ELSEIF INRANGE(TIME, 1140, 1320) && CFLAG:LOCAL:今日の運勢 % 3
			TCVAR:LOCAL:引力点 = P513魔理沙宅・研究部屋
		ENDIF
ENDSELECT

@EXIST_キャラデータ11
#LOCALSIZE 1
#LOCALSSIZE 1

@キャラデータ11(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "名前"
	CALLF MAKE_STR(V_NAME, "魔理沙")
;こっから衣装設定
CASE "今天的睡衣"
	CALLF MAKE_STR(V_NAME, "睡衣（睡袍）套")

CASE "便装：帽子"
	CALLF MAKE_INT(V_NAME, [[頭装備_帽子]])
CASE "便装：靴"
	CALLF MAKE_INT(V_NAME, [[靴_鞋子]])
CASE "便装：襪子"
