		CALLF MAKE_INT(V_NAME, [[襪子_吊带袜]])
	ELSE
		CALLF MAKE_INT(V_NAME, [[襪子_袜子]])
	ENDIF
CASE "便装：裙子"
	CALLF MAKE_INT(V_NAME, [[裙子_裙子]])
CASE "便装：上身衣服２"
	CALLF MAKE_INT(V_NAME, [[上身衣服_はだけ可能_女式衬衫]])
CASE "便装：上身衣服１"
	CALLF MAKE_INT(V_NAME, [[上身衣服_はだけ不可_无袖上衣]])
CASE "便装：其他１"
	CALLF MAKE_INT(V_NAME, [[其他衣装_扫帚]])

CASE "固有内衣形容詞"
	CALLF MAKE_STR(V_NAME, "少女情调的")
CASE "固有下半身内衣名"
	CALLF MAKE_STR(V_NAME, "荷叶边灯笼裤")
CASE "固有上半身内衣"
	CALLF MAKE_INT(V_NAME, 1)
CASE "固有上半身内衣名"
	CALLF MAKE_STR(V_NAME, "衬裙")
CASE "固有内衣着用条件"
	CALLF MAKE_INT(V_NAME, 1)
CASE "固有内衣半透明(前)"
	CALLF MAKE_INT(V_NAME, 1)
CASE "固有内衣半透明(後)"
	CALLF MAKE_INT(V_NAME, 1)
CASE "固有内衣布料厚度"
	CALLF MAKE_INT(V_NAME, 2)

;農民関連
;農家というか蘑菇スポットを教えてくれたのかな
CASE "農民：説明"
	CALLF MAKE_STR(V_NAME, "蘑菇農家")
CASE "農民：作物"
	CALLF MAKE_STR(V_NAME, "蘑菇")
CASE "農民：田的种类"
	CALLF MAKE_STR(V_NAME, "蘑菇農園")
CASE "農民：畑の所在地"
	CALLF MAKE_STR(V_NAME, "魔法之森")

CASE "農民：MapID"
	CALLF MAKE_INT(V_NAME, 5)
CASE "農民：場所ID"
	CALLF MAKE_INT(V_NAME, 507)
CASE "農民：報酬"
	CALLF MAKE_INT(V_NAME, 450)
CASE "農民：金利"
	CALLF MAKE_INT(V_NAME, 6)

CASE "固有指令"
	IF CFLAG:11:口上セレクタ == 1
		CALLF MAKE_STR(V_NAME, "少女行动DA☆ZE")
	ELSE
		CALLF MAKE_STR(V_NAME, "帮助别人")
	ENDIF
CASE "固有指令実行可能"
	CALLF MAKE_INT(V_NAME, 1)

;料理関連
CASE "料理：喜欢的味道"
	CALLF MAKE_STR(V_NAME, "魚料理/蘑菇/麺類/丰盛/野趣/鲜艳/豪快/サクサク/魔界風/外界風/和食/和食/甜/甜/辣/辣/冬物/冬物/冬物/")
CASE "料理：讨厌的味道"
	CALLF MAKE_STR(V_NAME, "面包/洋食/酸/酸/" + "怪诞/謎料理/" * 3)
CASE "料理：助手効果"
	CALLF MAKE_STR(V_NAME, "附魔/")
;贈り物関連
CASE "感性：好き"
	CALLF MAKE_STR(V_NAME, "黒/秩序/かわいい/奇妙/パワフル/壮大/" + "魔法/星/書物/鸦の/魔女の/冬の/" * 3 + "蘑菇の/彗星の/星屑の/恋色の/魔法書/箒/" * 5)
CASE "感性：嫌い"
	CALLF MAKE_STR(V_NAME, "繊細/" + "妖怪/" * 5)
ENDSELECT


