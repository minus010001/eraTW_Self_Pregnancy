@CHARAMOVE_DATA_21(ARG, ARG:2)
#LOCALSIZE 1
#LOCALSSIZE 1
LOCAL = 21
SELECTCASE ARG
	;連動設定（RETURN=依存する角色, RESULT:1～3=対等に連動する角色）
	CASE 1
		RESULT:1 = [[莉莉卡]]
		RESULT:2 = [[梅露蘭]]
		RESULT:3 = [[露娜薩]]
	;特殊生活時間設定（CFLAG:LOCAL:生活時間補正を設定する）
	CASE 3
	;移動傾向（±～10=行きやすい/行きにくい, -100=行かない）
	CASE 4
		SELECTCASE ARG:2
			;よく居る
			CASE P335廃洋館・大廳
				RETURN 5
			;私室には入らない
			CASE P303守衛小屋, P304空的小屋, P305仓库, P311帕秋莉私室, P312小悪魔私室, P320咲夜私室, P326蕾米莉亜私室, P331地下室
				RETURN -100
			CASE P344蕾蒂的冰屋, P345琪露諾的冰屋, P346大妖精の棲家, P348霧之湖・湖底
				RETURN -100
		ENDSELECT
	;出現場所
	CASE 7
		SELECTCASE ARG:2
			CASE 広場, 商家町, 呑屋小道
				RETURN 1
			CASE 霧之湖, 廃洋館, 正門
				RETURN 1
			CASE 中有之道, 三途之川, 白玉楼庭, 白玉楼
				RETURN 1
		ENDSELECT
	;引力設定（CFLAG:LOCAL:引力点を設定する）
	CASE 8
ENDSELECT

@EXIST_キャラデータ21
#LOCALSIZE 1
#LOCALSSIZE 1

@キャラデータ21(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "名前"
	CALLF MAKE_STR(V_NAME, "梅露蘭")
;こっから衣装設定
CASE "今天的睡衣"
	CALLF MAKE_STR(V_NAME, "睡衣（裤子）套")

CASE "便装：帽子"
	CALLF MAKE_INT(V_NAME, [[頭装備_帽子]])
CASE "便装：靴"
	CALLF MAKE_INT(V_NAME, [[靴_鞋子]])
CASE "便装：襪子"
	CALLF MAKE_INT(V_NAME, [[襪子_袜子]])
CASE "便装：裙子"
	CALLF MAKE_INT(V_NAME, [[裙子_裙子]])
CASE "便装：上身衣服２"
	CALLF MAKE_INT(V_NAME, [[上身衣服_はだけ可能_女式衬衫]])
CASE "便装：外搭"
	CALLF MAKE_INT(V_NAME, [[外搭_背心]])
CASE "便装：其他１"
	CALLF MAKE_INT(V_NAME, [[其他衣装_小号]])

CASE "固有内衣形容詞"
	CALLF MAKE_STR(V_NAME, "太阳图案的")
CASE "固有下半身内衣名"
	CALLF MAKE_STR(V_NAME, "荷叶边胖次")
CASE "固有上半身内衣"
	CALLF MAKE_INT(V_NAME, 1)
CASE "固有上半身内衣名"
	CALLF MAKE_STR(V_NAME, "全罩杯胸罩")
CASE "固有内衣着用条件"
	SIF !RAND:(1 + (2 * 勝負内衣判定([[梅露蘭]])))
		CALLF MAKE_INT(V_NAME, 1)
CASE "固有内衣半透明(前)"
	CALLF MAKE_INT(V_NAME, 1)
CASE "固有内衣半透明(後)"
	CALLF MAKE_INT(V_NAME, 1)
CASE "固有内衣布料厚度"
	CALLF MAKE_INT(V_NAME, 2)

;料理関連
CASE "料理：喜欢的味道"
	CALLF MAKE_STR(V_NAME, "牛奶/乳酪/洋食/鍋物/派/丰盛/ジャンキー/芸術的/鲜艳/豪快/软绵绵/甜/甜/辣/辣/")
CASE "料理：讨厌的味道"
	CALLF MAKE_STR(V_NAME, "简易/咸/咸/虫肉/虫肉/虫肉/香料/香料/香料/")
CASE "料理：助手効果"
	CALLF MAKE_STR(V_NAME, "未知の味/")
;贈り物関連
CASE "感性：好き"
	CALLF MAKE_STR(V_NAME, "粉色/幽霊/かわいい/派手/パワフル/" + "音楽/日/楽器/" * 3 + "虹の/幽霊の/欢愉の/幸福の/三位一体の/" * 5)
CASE "感性：嫌い"
	CALLF MAKE_STR(V_NAME, "別緻/繊細/" + "星/月/刃物/弾/护臂/烟袋/" * 3 + "鼓槌/拨片/指揮棒/" * 5 + "精霊銀の/憂鬱の/" * 10)
ENDSELECT

