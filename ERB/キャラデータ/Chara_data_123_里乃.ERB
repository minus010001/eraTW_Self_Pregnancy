@MUSIC_BUFF_123(ARG, SUCCESS)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC SUCCESS
IF SUCCESS == -1
	TIMES SOURCE:ARG:反感, 0.7
	CALL COLORMESSAGE(@"由于%CALLNAME:[[里乃]]%的能力，反感下降了",C_YELLOW,1)
ENDIF