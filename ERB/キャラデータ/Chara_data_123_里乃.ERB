@CHARAMOVE_DATA_123(ARG, ARG:2)
#LOCALSIZE 1
#LOCALSSIZE 1
LOCAL = 123
SELECTCASE ARG
	;連動設定（RETURN=依存する角色, RESULT:1～3=対等に連動する角色）
	CASE 1
		RESULT:1 = [[舞]]
		RESULT:2 = [[里乃]]
	;特殊生活時間設定（CFLAG:LOCAL:生活時間補正を設定する）
	CASE 3
	;移動傾向（±～10=行きやすい/行きにくい, -100=行かない）
	CASE 4
		SELECTCASE ARG:2
			;未設定
		ENDSELECT
	;出現場所
	CASE 7
		SELECTCASE ARG:2
			CASE 広場, 商家町, 呑屋小道
				RETURN 1
			CASE 竹林入口, 迷失的小道, 斜角的竹林, 無名之丘, 太陽花田
				RETURN 1
			CASE 森林的入口, 香霖堂, 古木的大樹, 再思之道, 無縁塚
				RETURN 1
		ENDSELECT
	;引力設定（CFLAG:LOCAL:引力点を設定する）
	CASE 8
ENDSELECT

@EXIST_キャラデータ123
#LOCALSIZE 1
#LOCALSSIZE 1

@キャラデータ123(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "名前"
	CALLF MAKE_STR(V_NAME, "里乃")
;こっから衣装設定
CASE "今天的睡衣"
	CALLF MAKE_STR(V_NAME, "睡衣（裤子）套")

CASE "便装：帽子"
	CALLF MAKE_INT(V_NAME, [[頭装備_乌帽子]])
CASE "便装：靴"
	CALLF MAKE_INT(V_NAME, [[靴_鞋子]])
CASE "便装：襪子"
	CALLF MAKE_INT(V_NAME, [[襪子_长筒袜]])
CASE "便装：連衣裙"
	CALLF MAKE_INT(V_NAME, [[連衣裙_連衣裙]])
CASE "便装：其他１"
	CALLF MAKE_INT(V_NAME, [[其他衣装_茗荷]])

CASE "固有内衣形容詞"
	CALLF MAKE_STR(V_NAME, "方便跳舞的")
CASE "固有下半身内衣名"
	CALLF MAKE_STR(V_NAME, "紧身裤")
CASE "固有上半身内衣"
	CALLF MAKE_INT(V_NAME, 1)
CASE "固有上半身内衣名"
	CALLF MAKE_STR(V_NAME, "吊带背心")
CASE "固有内衣着用条件"
	SIF !RAND:(1 + (2 * 勝負内衣判定([[里乃]])))
		CALLF MAKE_INT(V_NAME, 1)
CASE "固有内衣半透明(前)"
	CALLF MAKE_INT(V_NAME, 1)
CASE "固有内衣半透明(後)"
	CALLF MAKE_INT(V_NAME, 1)
CASE "固有内衣布料厚度"
	CALLF MAKE_INT(V_NAME, 2)

;料理関連
CASE "料理：喜欢的味道"
	CALLF MAKE_STR(V_NAME, "魚料理/汁物/简易/ジャンキー/淡白/豪華/芸術的/鲜艳/软糯的/甜/甜/酸/酸/")
CASE "料理：讨厌的味道"
	CALLF MAKE_STR(V_NAME, "質素/辣/辣/" + "青蛙/虫肉/天狗流/" * 3)
CASE "料理：助手効果"
	CALLF MAKE_STR(V_NAME, "附魔/薄味/")
;贈り物関連
CASE "感性：好き"
	CALLF MAKE_STR(V_NAME, "紫/高級/混沌/かわいい/時尚/ポップ/派手/不思議/" + "音楽/楽器/記憶の/" * 3 + "疯狂な/後戸の/精神の/忘却の/" * 5)
CASE "感性：嫌い"
	CALLF MAKE_STR(V_NAME, "別緻/" + "生体品/护臂/" * 3 + "天狗の/" * 10)
ENDSELECT

