@CHARAMOVE_DATA_149(ARG, ARG:2)
#LOCALSIZE 1
#LOCALSSIZE 1
LOCAL = 149
SELECTCASE ARG
	;連動設定（RETURN=依存する角色, RESULT:1～3=対等に連動する角色）
	CASE 1
	;特殊生活時間設定（CFLAG:LOCAL:生活時間補正を設定する）
	CASE 3
	;移動傾向（±～10=行きやすい/行きにくい, -100=行かない）
	CASE 4
		SELECTCASE ARG:2 ;lives at 740
			;森の深奥、秘天崖によく居る
			CASE P738森の深奥, P739秘天崖
				RETURN 5
			;私室には入らない
			CASE P704河童の宣傳站, P706厄神的家, P709莉莉們的家, P716秋姉妹的家・土間 TO P730仙人的宅邸・庭
				RETURN -100
			CASE P733正邪的隠匿処, P744合欢宅邸, P737招财猫的家, P742美天居所
				RETURN -100
		ENDSELECT
	;出現場所
	CASE 7
		SELECTCASE ARG:2
			CASE 広場, 商家町, 呑屋小道, 正門
				RETURN 1
			CASE 森林的入口, 香霖堂, 古木的大樹, 再思之道, 無縁塚
				RETURN 1
			CASE 山麓樹海, 玄武之澤, 大蛤蟆之池, 森の深奥
				RETURN 1
			CASE 九天瀑布, 絶景之丘, 山之湖, 守矢神社境内
				RETURN 1
			CASE 魔界都市
				RETURN 1
		ENDSELECT
	;引力設定（CFLAG:LOCAL:引力点を設定する）
	CASE 8
ENDSELECT
@EXIST_キャラデータ149
#LOCALSIZE 1
#LOCALSSIZE 1

@キャラデータ149(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "名前"
	CALLF MAKE_STR(V_NAME, "奥莲姬")
;こっから衣装設定
CASE "今天的睡衣"
	CALLF MAKE_STR(V_NAME, "睡衣（裤子）套")

CASE "便装：帽子"
	CALLF MAKE_INT(V_NAME, [[頭装備_帽子]])
CASE "便装：靴"
	CALLF MAKE_INT(V_NAME, [[靴_鞋子]])
CASE "便装：襪子"
	CALLF MAKE_INT(V_NAME, [[襪子_袜子]])
CASE "便装：裤子"
	CALLF MAKE_INT(V_NAME, [[裤子_热裤]])
CASE "便装：上身衣服２"
	CALLF MAKE_INT(V_NAME, [[上身衣服_はだけ可能_女式衬衫]])
CASE "便装：上身衣服１"
	CALLF MAKE_INT(V_NAME, [[上身衣服_はだけ不可_无袖上衣]])
CASE "便装：其他１"
	CALLF MAKE_INT(V_NAME, [[其他衣装_蝴蝶结]])
CASE "便装：其他２"
	CALLF MAKE_INT(V_NAME, [[其他衣装_杖]])

CASE "固有内衣形容詞"
	CALLF MAKE_STR(V_NAME, "紧身的")
CASE "固有下半身内衣名"
	CALLF MAKE_STR(V_NAME, "运动短裤")
CASE "固有上半身内衣"
	CALLF MAKE_INT(V_NAME, 1)
CASE "固有上半身内衣名"
	CALLF MAKE_STR(V_NAME, "运动文胸")
CASE "固有内衣着用条件"
	CALLF MAKE_INT(V_NAME, 1)
CASE "固有内衣半透明(前)"
	CALLF MAKE_INT(V_NAME, 1)
CASE "固有内衣半透明(後)"
	CALLF MAKE_INT(V_NAME, 1)
CASE "固有内衣布料厚度"
	CALLF MAKE_INT(V_NAME, 2)

;料理関連
CASE "料理：喜欢的味道"
	CALLF MAKE_STR(V_NAME, "夏物/野菜/濃厚/辣/辣/丰盛/肉料理/豪華/甜/質素/鲜艳/家庭的/黏稠/妖力/酸/酸/酸/")
CASE "料理：讨厌的味道"
	CALLF MAKE_STR(V_NAME, "酸/酸/青蛙/青蛙/青蛙/虫肉/虫肉/虫肉/謎料理/謎料理/謎料理/")
CASE "料理：助手効果"
	CALLF MAKE_STR(V_NAME, "果物/")
;贈り物関連
CASE "感性：好き"
	CALLF MAKE_STR(V_NAME, "夏の/緑/黄/指揮棒/蝴蝶结/发带/芸術的/" + "手板/杖/妖術/" * 3 + "橙子の/パワフル/"* 5)
CASE "感性：嫌い"
	CALLF MAKE_STR(V_NAME, "知的/欲望の/" + "厄の/不吉の/巫女の/驅魔棒/博霊の/" * 10) 
ENDSELECT

