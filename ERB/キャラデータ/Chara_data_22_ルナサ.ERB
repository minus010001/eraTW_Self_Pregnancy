@CHARAMOVE_DATA_22(ARG, ARG:2)
#LOCALSIZE 1
#LOCALSSIZE 1
LOCAL = 22
SELECTCASE ARG
	;連動設定（RETURN=依存する角色, RESULT:1～3=対等に連動する角色）
	CASE 1
		RESULT:1 = [[莉莉卡]]
		RESULT:2 = [[梅露蘭]]
		RESULT:3 = [[露娜薩]]
	;特殊生活時間設定（CFLAG:LOCAL:生活時間補正を設定する）
	CASE 3
	;移動傾向（±～10=行きやすい/行きにくい, -100=行かない）
	CASE 4
		SELECTCASE ARG:2
			;よく居る
			CASE P335廃洋館・大廳
				RETURN 5
			;私室には入らない
			CASE P303守衛小屋, P304空的小屋, P305仓库, P311帕秋莉私室, P312小悪魔私室, P320咲夜私室, P326蕾米莉亜私室, P331地下室
				RETURN -100
			CASE P344蕾蒂的冰屋, P345琪露諾的冰屋, P346大妖精の棲家, P348霧之湖・湖底
				RETURN -100
		ENDSELECT
	;出現場所
	CASE 7
		SELECTCASE ARG:2
			CASE 広場, 商家町, 呑屋小道
				RETURN 1
			CASE 霧之湖, 廃洋館, 正門
				RETURN 1
			CASE 中有之道, 三途之川, 白玉楼庭, 白玉楼
				RETURN 1
		ENDSELECT
	;引力設定（CFLAG:LOCAL:引力点を設定する）
	CASE 8
ENDSELECT

@EXIST_キャラデータ22
#LOCALSIZE 1
#LOCALSSIZE 1

@キャラデータ22(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "名前"
	CALLF MAKE_STR(V_NAME, "露娜薩")
;こっから衣装設定
CASE "今天的睡衣"
	CALLF MAKE_STR(V_NAME, "睡衣（裤子）套")

CASE "便装：帽子"
	CALLF MAKE_INT(V_NAME, [[頭装備_帽子]])
CASE "便装：靴"
	CALLF MAKE_INT(V_NAME, [[靴_鞋子]])
CASE "便装：襪子"
	CALLF MAKE_INT(V_NAME, [[襪子_袜子]])
CASE "便装：裙子"
	CALLF MAKE_INT(V_NAME, [[裙子_裙子]])
CASE "便装：上身衣服２"
	CALLF MAKE_INT(V_NAME, [[上身衣服_はだけ可能_女式衬衫]])
CASE "便装：外搭"
	CALLF MAKE_INT(V_NAME, [[外搭_背心]])
CASE "便装：其他１"
	CALLF MAKE_INT(V_NAME, [[其他衣装_小提琴]])

CASE "固有内衣形容詞"
	CALLF MAKE_STR(V_NAME, "月牙图案的")
CASE "固有下半身内衣名"
	CALLF MAKE_STR(V_NAME, "迷你胖次")
CASE "固有上半身内衣"
	CALLF MAKE_INT(V_NAME, 1)
CASE "固有上半身内衣名"
	CALLF MAKE_STR(V_NAME, "无肩带胸罩")
CASE "固有内衣着用条件"
	SIF !RAND:(1 + (2 * 勝負内衣判定([[露娜薩]])))
		CALLF MAKE_INT(V_NAME, 1)
CASE "固有内衣半透明(前)"
	CALLF MAKE_INT(V_NAME, 1)
CASE "固有内衣半透明(後)"
	CALLF MAKE_INT(V_NAME, 1)
CASE "固有内衣布料厚度"
	CALLF MAKE_INT(V_NAME, 2)
;模组用教育指令
CASE "固有指令"
	IF 成人再教育插件开关 == 1 
		CALLF MAKE_STR(V_NAME, "学习演奏")
	ENDIF
CASE "固有指令実行可能"
	CALLF MAKE_INT(V_NAME, 1)
;料理関連
CASE "料理：喜欢的味道"
	CALLF MAKE_STR(V_NAME, "魚料理/果物/洋食/汁物/派/简易/健康/淡白/芸術的/家庭的/鲜艳/软糯的/赏月/甜/甜/酸/酸/")
CASE "料理：讨厌的味道"
	CALLF MAKE_STR(V_NAME, "丰盛/濃厚/野趣/辣/辣/青蛙/青蛙/青蛙/香料/香料/香料/謎料理/謎料理/謎料理/謎料理/謎料理/")
CASE "料理：助手効果"
	CALLF MAKE_STR(V_NAME, "薄味/")
;贈り物関連
CASE "感性：好き"
	CALLF MAKE_STR(V_NAME, "黒/幽霊/美的/シンプル/別緻/繊細/" + "音楽/月/楽器/" * 3 + "虹の/幽霊の/憂鬱の/三位一体の/" * 5)
CASE "感性：嫌い"
	CALLF MAKE_STR(V_NAME, "派手/パワフル/威厳/" + "星/日/刃物/弾/护臂/烟袋/" * 3 + "鼓槌/拨片/指揮棒/" * 5 + "精霊銀の/欢愉の/" * 10)
ENDSELECT

;-------------------------------------------------
;固有料理設定
;DISH_NAME          料理名
;RESULTS            料理の種類（軽食/主食/甜点）
;CALL 材料設定("")  材料の指定。"汎用"を入れると自動で汎用食材になる
;DISH_TASTE         味の設定
;DISH_COMMENT       （任意）一行コメント
;DISH_TIME          （任意）調理にかかる時間
;DISH_MAXLIMIT      （任意）料理の持続時間
;-------------------------------------------------
@SPECIAL_MENU_22
#LOCALSIZE 1
#LOCALSSIZE 1
DISH_NAME = 生洋蔥沙拉
RESULTS = 軽食
CALL 材料設定("洋葱")
DISH_TASTE = 野菜/酸/简易/健康/辣/家庭的/
DISH_COMMENT = 用新鲜洋葱切片制作的沙拉。制作的时候总有一种想流眼淚的衝動。
RETURN 1


;IMAGE_I22_特殊服装(CHARA)-------------------------------------------------------------------
;キャラクター特有の服装表示条件
;エフェクトを共有する服装差分はこちらで指定する
;使用時注意点:
;	RESULTSに特殊服装を格納すること
;	書式は %服装%%特殊服装% 適宜"_"等入れること
;-------------------------------------------------------------------------------------------
@IMAGE_I22_特殊服装(CHARA)
#DIM CHARA
VARSET RESULTS

IF CFLAG:CHARA:差し替え適用 == 3
	;差し替え画像
	IF CHECK_NUDE(CHARA)
		;裸
		IF FLAG:立ち絵種類
			;顔絵
		ELSE
			;立ち絵
		ENDIF
	ELSE
		;服
		IF FLAG:立ち絵種類
			;顔絵
			IF CHECK_CLO("bra_visible", CHARA)
				RESULTS = _下着
			ELSEIF CURRENT_CLOTHES_SET(CHARA) == 55
				RESULTS = _バニー
			ELSEIF CURRENT_CLOTHES_SET(CHARA) == 62
				RESULTS = _変T
			ELSEIF CURRENT_CLOTHES_SET(CHARA) == 74
				RESULTS = _セーラー
			ENDIF
		ELSE
			;立ち絵
			IF CHECK_CLO("bra_visible", CHARA) && EQUIP:CHARA:下半身下着２ != 0
				RESULTS = _下着
			ELSEIF CHECK_CLO("bra_visible", CHARA) && EQUIP:CHARA:下半身下着２ == 0
				RESULTS = _ノーパン下着
			{
			ELSEIF (!EQUIP:CHARA:上半身上着１ && !EQUIP:CHARA:上半身上着２ && !EQUIP:CHARA:外衣 &&
					!EQUIP:CHARA:着物 && !EQUIP:CHARA:ワンピース &&
					!EQUIP:CHARA:レオタード && !EQUIP:CHARA:ボディースーツ) &&
					EQUIP:CHARA:下半身下着２ != 0
			}
				RESULTS = _ノーブラ下着
			ELSEIF CURRENT_CLOTHES_SET(CHARA) == 55
				RESULTS = _バニー
			ELSEIF CURRENT_CLOTHES_SET(CHARA) == 62
				RESULTS = _変T
			ELSEIF CURRENT_CLOTHES_SET(CHARA) == 74
				RESULTS = _セーラー
			ENDIF
		ENDIF
	ENDIF
ELSEIF CFLAG:CHARA:差し替え適用
ELSE
	;通常画像
	IF CHECK_NUDE(CHARA)
		;裸
		IF FLAG:立ち絵種類
			;顔絵
		ELSE
			;立ち絵
		ENDIF
	ELSE
		;服
		IF FLAG:立ち絵種類
			;顔絵
		ELSE
			;立ち絵
		ENDIF
	ENDIF
ENDIF


