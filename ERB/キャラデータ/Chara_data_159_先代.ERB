;IMAGE_I159_特殊表情COM(CHARA, 指令)-------------------------------------------------------
;直前の指令で変化する角色特有の表情表示条件
;時間停止中は変化しない表情はこちら
;使用時注意点:
;    RESULTS:0に表情を格納
;    RESULTS:1にマウスオーバー時の表情を格納すること
;    "自慰","愛撫","性交"は本編で実装済み
;-------------------------------------------------------------------------------------------
@IMAGE_I159_特殊表情COM(CHARA, 指令)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM CHARA
#DIM 指令

IF CFLAG:159:差し替え適用 == 4
	IF CHECK_NUDE(CHARA)
		SELECTCASE 指令
			CASE 80
				RESULTS = 手交覆盖
				CASE 81, 88, 140
				RESULTS = 口交覆盖
			CASE 82
				RESULTS = 乳交覆盖
			CASE 85
				RESULTS = 足交覆盖
			CASE 8
				IF EX:CHARA:膣内精液
					RESULTS = 张开阴唇2覆盖
				ELSE
					RESULTS = 张开阴唇覆盖
				ENDIF
			CASE 13
				IF EX:CHARA:肛門内精液
					RESULTS = 张开菊穴2覆盖
				ELSE
					RESULTS = 张开菊穴覆盖
				ENDIF
			CASE 83
				IF CFLAG:CHARA:妊娠経過日数 >= 40
					RESULTS = 妊娠_素股覆盖
				ELSE
					RESULTS = 素股覆盖
				ENDIF
			CASE 431
				RESULTS = 泡澡覆盖
			CASEELSE
				IF MASTER_POSE(SET_V,SET_P) == CHARA || MASTER_POSE(SET_A,SET_P) == CHARA
					IF MASTER_POSE(SET_V,SET_P) == CHARA
						SELECTCASE TEQUIP:CHARA:110
							CASE POSE_MISSIONARY
								RESULTS = V_正面覆盖
							CASE POSE_COWGIRL,POSE_SUSPENDED_CONGRESS
								RESULTS = V_骑乘位覆盖
							CASE POSE_LOTUS
								RESULTS = V_对面座位覆盖
							CASE POSE_DOGGYSTYLE,POSE_REV_COWGIRL
								RESULTS = V_后入覆盖
							CASE POSE_STANDING_FROM_BEHIND
								RESULTS = V_站立后入覆盖
							CASE POSE_REVLOTUS
								RESULTS = V_背面坐莲覆盖
							CASE POSE_STANDING_MISSIONARY
								RESULTS = 站立正常覆盖
						ENDSELECT
					ELSEIF MASTER_POSE(SET_A,SET_P) == CHARA
						SELECTCASE TEQUIP:CHARA:110
							CASE POSE_MISSIONARY
								RESULTS = A_正面覆盖
							CASE POSE_COWGIRL,POSE_SUSPENDED_CONGRESS
								RESULTS = A_骑乘位覆盖
							CASE POSE_LOTUS
								RESULTS = A_对面座位覆盖
							CASE POSE_DOGGYSTYLE,POSE_REV_COWGIRL
								RESULTS = A_后入覆盖
							CASE POSE_STANDING_FROM_BEHIND
								RESULTS = A_站立后入覆盖
							CASE POSE_REVLOTUS
								RESULTS = A_背面坐莲覆盖
							CASE POSE_STANDING_MISSIONARY
								RESULTS = 站立正常覆盖
						ENDSELECT
					ENDIF
					IF CFLAG:CHARA:妊娠経過日数 >= 40
						RESULTS = 妊娠_%RESULTS%
					ENDIF
				ENDIF
		ENDSELECT
	ELSE
		IF IS_BUNNY(CHARA)
		ELSEIF CURRENT_CLOTHES_SET(CHARA) == 74
		ELSEIF CURRENT_CLOTHES_SET(CHARA) == 68
		ELSEIF CURRENT_CLOTHES_SET(CHARA) == 52 || TEQUIP:CHARA:SWIMMING
		ELSEIF CHECK_CLO("bra_visible", CHARA)
		ELSE
			SELECTCASE 指令
				CASE 443
					IF RAND:2
						RESULTS = 特殊训练覆盖
					ELSE
						RESULTS = 特殊训练覆盖2
					ENDIF
				CASE 305
					RESULTS = 膝枕覆盖
				CASE 350
					RESULTS = 推倒覆盖
				CASE 6,12,313
					IF CFLAG:CHARA:诶嘿嘿
						RESULTS = 揉胸2覆盖
					ELSE
						RESULTS = 揉胸覆盖
					ENDIF
			ENDSELECT
		ENDIF
	ENDIF
ELSEIF CFLAG:159:差し替え適用
    ;替换用画像
    IF FLAG:立絵種類
        ;顔絵
    ELSE
        ;立絵
    ENDIF
ELSE
    ;通常画像
    IF FLAG:立絵種類
        ;顔絵
    ELSE
        ;立絵
        SELECTCASE 指令
            CASE 61 ,63
                IF IS_STANDING_SEX(SELECTCOM)
                    RESULTS:1 = 性交
                    RESULTS:0 = 性交
                ELSE
                    RESULTS:1 = 后入
                    RESULTS:0 = 后入
                ENDIF
            CASEELSE
        ENDSELECT
    ENDIF
ENDIF

;IMAGE_I159_特殊エフェクトチェック(CHAR, エフェクト)--------------------------------------------
;角色特有のエフェクト判定  特殊エフェクトを直接指定したい場合に参照
;引数 "エフェクト" に固有のエフェクトが含まれるかを判定する
;例の街道、STRFINDを使用してください
;-------------------------------------------------------------------------------------------
@IMAGE_I159_特殊エフェクトチェック(CHARA, エフェクト)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM CHARA
#DIMS エフェクト

IF CFLAG:159:差し替え適用 == 4
	;替换用画像
	SIF STRFIND(エフェクト, "乳头") != -1
		RETURN 1
ELSE
	;通常画像
ENDIF

RETURN 0

;IMAGE_I159_特殊エフェクト(CHARA)--------------------------------------------------------------------
;角色特有のエフェクト表示条件
;使用時注意点:
;	RESULTS配列に特殊エフェクトを格納
;	RETURNで追加するエフェクト数を返却すること
;-------------------------------------------------------------------------------------------
@IMAGE_I159_特殊エフェクト(CHARA)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM CHARA
#DIMS DYNAMIC 服装
#DIM DYNAMIC エフェクト数 = 0
VARSET RESULTS

IF CFLAG:159:差し替え適用 == 4
	CALL IMAGE_CHARA_OVERRIDE("特殊表情COM", CHARA)
	IF STRCOUNT(RESULTS:0, "覆盖") || STRCOUNT(RESULTS:1, "覆盖")
		VARSET RESULTS
		RETURN エフェクト数
	ENDIF
	IF 0
		RESULTS:エフェクト数 = 深色乳头
		エフェクト数 += 1
	ENDIF
ELSEIF CFLAG:159:差し替え適用 == 1
ELSE
	;通常画像
	IF FLAG:立絵種類
		;顔絵
	ELSE
		;立絵
	ENDIF
ENDIF

RETURN エフェクト数
