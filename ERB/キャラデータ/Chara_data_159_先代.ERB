;    RESULTS:1にマウスオーバー時の表情を格納すること
;    "通常","笑顔","憤怒","発情","睡眠"は本編で実装済み
;-------------------------------------------------------------------------------------------
@IMAGE_I159_特殊表情(CHARA)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM CHARA

IF CFLAG:159:差し替え適用
    ;替换用画像
    IF FLAG:立絵種類
        ;顔絵
    ELSE
        ;立絵
    ENDIF
ELSE
    ;通常画像
    IF FLAG:立絵種類
        ;顔絵
    ELSE
        ;立絵
    ENDIF
