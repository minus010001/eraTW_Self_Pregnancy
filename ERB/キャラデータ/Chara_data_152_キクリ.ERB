@CHARAMOVE_DATA_152(ARG, ARG:2)
#LOCALSIZE 1
#LOCALSSIZE 1
LOCAL = 152
SELECTCASE ARG
	;連動設定（RETURN=依存する角色, RESULT:1～3=対等に連動する角色）
	CASE 1
	;特殊生活時間設定（CFLAG:LOCAL:生活時間補正を設定する）
	CASE 3
	;移動傾向（±～10=行きやすい/行きにくい, -100=行かない）
	CASE 4
		SELECTCASE ARG:2
			;地霊殿には行かない、勇儀の家には行かない
			CASE P901地霊殿前 TO P930旧血の池地獄, P936勇儀的家
				RETURN -100
			;自室、裏通り、酒場に行きやすい
			CASE P942琪斯美的家, P932後街, P933酒場
				RETURN 5
		ENDSELECT
	;出現場所
	CASE 7
		SELECTCASE ARG:2
			CASE 地獄, 彼岸, 中有之道, 三途之川
				RETURN 1
			CASE 灼熱地獄跡, 旧地獄街道, 地獄的深道
				RETURN 1
			CASE 神社境内, 神社走廊, 神社本堂
				RETURN 1
			CASE 命蓮寺境内, 命蓮寺方丈
				RETURN 1
		ENDSELECT
	;引力設定
	CASE 8
ENDSELECT

@EXIST_キャラデータ152
#LOCALSIZE 1
#LOCALSSIZE 1

@キャラデータ152(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "名前"
	CALLF MAKE_STR(V_NAME, "菊理")
;こっから衣装設定
CASE "今天的睡衣"
	CALLF MAKE_STR(V_NAME, "睡衣（连衣裙）套")

CASE "便装：上身衣服２"
	CALLF MAKE_INT(V_NAME, [[上身衣服_はだけ可能_女式衬衫]])
CASE "固有内衣形容詞"
	CALLF MAKE_STR(V_NAME, "固态金属的")
CASE "固有下半身内衣名"
	CALLF MAKE_STR(V_NAME, "黄铜内裤")
CASE "固有上半身内衣"
	CALLF MAKE_INT(V_NAME, 1)
CASE "固有上半身内衣名"
	CALLF MAKE_STR(V_NAME, "黄铜胸罩")
CASE "固有内衣着用条件"
	SIF !RAND:(3 - (2 * 勝負内衣判定([[菊理]])))
		CALLF MAKE_INT(V_NAME, 1)
CASE "固有内衣半透明(前)"
	CALLF MAKE_INT(V_NAME, 0)
CASE "固有内衣半透明(後)"
	CALLF MAKE_INT(V_NAME, 0)
CASE "固有内衣布料厚度"
	CALLF MAKE_INT(V_NAME, 3)

;料理関連
CASE "料理：喜欢的味道"
	CALLF MAKE_STR(V_NAME, "煎餅/派/淡白/魔界風/隠し味/附魔/秘術/蛋糕/漢堡/外界風/大火力/" + "春物/加護/道具の共鳴/" * 3 + "和食/" * 5)
CASE "料理：讨厌的味道"
	CALLF MAKE_STR(V_NAME, "怪诞/謎料理/霊障/ジャンキー/浓郁/玉兎流/逆転/純化的味道/貧乏飯/洋食/" + "科学的/滑溜溜/平价食材/" * 3 + "软糯的/" * 5)
CASE "料理：助手効果"
	CALLF MAKE_STR(V_NAME, "闪耀/神力/魔界風/")
;贈り物関連
CASE "感性：好き"
	CALLF MAKE_STR(V_NAME, "古の/懐かしき/神代の/天空の/霊力の/金属风格的/退魔の/" + "懷舊的/和風の/太古の/聖域の/法界の/山吹の/" * 3 + "中世風の/始原の/黄金の/故郷の/" * 5 + "青銅の/菊の/反射の/" * 10)
CASE "感性：嫌い"
	CALLF MAKE_STR(V_NAME, "复古未来な/多彩な/塑料の/软乎乎の/蓬蓬鼓鼓の/诅咒の/量子の/" + "近未来風の/氷結の/" * 3 + "モダンな/锈迹の/" * 5)
ENDSELECT

