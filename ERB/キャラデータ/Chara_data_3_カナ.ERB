@CHARAMOVE_DATA_3(ARG, ARG:2)
#LOCALSIZE 1
#LOCALSSIZE 1
LOCAL = 3
SELECTCASE ARG
	;連動設定（RETURN=依存する角色, RESULT:1～3=対等に連動する角色）
	CASE 1
	;特殊生活時間設定（CFLAG:LOCAL:生活時間補正を設定する）
	CASE 3
	;移動傾向
	CASE 4
		SELECTCASE ARG:2
			;壁櫥間にはあんまりいない
			CASE P18壁櫥間
				RETURN -5
			;他所
			CASE P27三妖精之家・大廳 TO P35三妖精之家・地下室, P39夢幻遺跡・浴室, P56阿吽の棲家
				RETURN -100
		ENDSELECT
	;出現場所
	CASE 7
		SELECTCASE ARG:2
			CASE 桜花道的鳥居, 神社境内, 神社走廊, 夢幻遺跡
				RETURN 1
			CASE 広場, 商家町, 呑屋小道, 長屋街
				RETURN 1
			CASE 夢幻館
				RETURN 1
		ENDSELECT
	;引力設定（CFLAG:LOCAL:引力点を設定する）
	CASE 8
ENDSELECT

@EXIST_キャラデータ3
#LOCALSIZE 1
#LOCALSSIZE 1

@キャラデータ3(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "名前"
	CALLF MAKE_STR(V_NAME, "卡娜")
;こっから衣装設定
CASE "今天的睡衣"
	CALLF MAKE_STR(V_NAME, "睡衣（裤子）套")

CASE "便装：帽子"
	CALLF MAKE_INT(V_NAME, [[頭装備_帽子]])
CASE "便装：靴"
	CALLF MAKE_INT(V_NAME, [[靴_鞋子]])
CASE "便装：襪子"
	CALLF MAKE_INT(V_NAME, [[襪子_袜子]])
CASE "便装：連衣裙"
	CALLF MAKE_INT(V_NAME, [[連衣裙_围裙洋装]])
CASE "便装：腕部装束"
	CALLF MAKE_INT(V_NAME, [[腕部装束_晚宴手套]])

CASE "固有内衣形容詞"
	CALLF MAKE_STR(V_NAME, "猫咪图案的")
CASE "固有下半身内衣名"
	CALLF MAKE_STR(V_NAME, "印花胖次(猫)")
CASE "固有上半身内衣"
	CALLF MAKE_INT(V_NAME, 1)
CASE "固有上半身内衣名"
	CALLF MAKE_STR(V_NAME, "吊带小背心")
CASE "固有内衣着用条件"
	CALLF MAKE_INT(V_NAME, 1)
CASE "固有内衣半透明(前)"
	CALLF MAKE_INT(V_NAME, 1)
CASE "固有内衣半透明(後)"
	CALLF MAKE_INT(V_NAME, 1)
CASE "固有内衣布料厚度"
	CALLF MAKE_INT(V_NAME, 2)

;料理関連
CASE "料理：喜欢的味道"
	CALLF MAKE_STR(V_NAME, "面包/牛奶/汁物/派/咸/简易/淡白/上品/鲜艳/サクサク/外界風/洋食/洋食/甜/甜/甜/謎料理/謎料理/謎料理/")
CASE "料理：讨厌的味道"
	CALLF MAKE_STR(V_NAME, "和食/丰盛/野趣/辣/辣/虫肉/虫肉/虫肉/")
CASE "料理：助手効果"
	CALLF MAKE_STR(V_NAME, "薄味/")
;贈り物関連
CASE "感性：好き"
	CALLF MAKE_STR(V_NAME, "白/混沌/かわいい/洋風/ポップ/不思議/" + "鳥/幽霊/" * 3 + "夢の/逝去的/" * 5)
CASE "感性：嫌い"
	CALLF MAKE_STR(V_NAME, "秩序/別緻/知的/" + "日/护符/書物/护臂/" * 3)
ENDSELECT

