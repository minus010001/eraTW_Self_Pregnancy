;IMAGE_I3_特殊服装(CHARA)-------------------------------------------------------------------
;キャラクター特有の服装表示条件
;エフェクトを共有する服装差分はこちらで指定する
;使用時注意点:
;	RESULTSに特殊服装を格納すること
;	書式は %服装%%特殊服装% 適宜"_"等入れること
;-------------------------------------------------------------------------------------------
@IMAGE_I3_特殊服装(CHARA)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM CHARA
VARSET RESULTS

IF CFLAG:3:差し替え適用 == 3
	;AS06替换用画像
	IF CHECK_NUDE(CHARA)
		;裸
	ELSE
		;服
		IF CFLAG:CHARA:睡眠 || CFLAG:CHARA:陪睡中 || 睡眠時間(CHARA)
			RESULTS = _下着
		ELSEIF IS_BUNNY(CHARA)
			RESULTS = _バニーギャル
		ELSEIF CURRENT_CLOTHES_SET(CHARA) == 74
			RESULTS = _セーラー服
		ELSEIF CURRENT_CLOTHES_SET(CHARA) == 67
			RESULTS = _フォーマルドレス
		ELSEIF CURRENT_CLOTHES_SET(CHARA) == [[纯色连衣裙套装]]
			RESULTS = _私服
		ELSEIF CHECK_CLO("bra_visible", CHARA)
			RESULTS = _下着
		ENDIF
	ENDIF
ELSEIF CFLAG:3:差し替え適用 == 1
	IF CHECK_NUDE(CHARA)
		;裸
		IF FLAG:立絵種類
			;顔絵
		ELSE
			;立ち絵
		ENDIF
	ELSE
		;服
		IF FLAG:立絵種類
			;顔絵
			IF IS_BUNNY(CHARA)
				RESULTS = _バニー
			ELSEIF CURRENT_CLOTHES_SET(CHARA) == 62
				RESULTS = _変T
			ELSEIF CURRENT_CLOTHES_SET(CHARA) == 74
				RESULTS = _セーラー
			ELSEIF CHECK_CLO("bra_visible", CHARA)
				RESULTS = _下着
			ENDIF
		ELSE
			;立ち絵
			IF CHECK_CLO("bra_visible", CHARA) && EQUIP:CHARA:下半身下着２ != 0
				RESULTS = _下着
			ELSEIF CHECK_CLO("bra_visible", CHARA) && EQUIP:CHARA:下半身下着２ == 0
				RESULTS = _ノーパン下着
			{
			ELSEIF (!EQUIP:CHARA:上半身上着１ && !EQUIP:CHARA:上半身上着２ && !EQUIP:CHARA:外搭 &&
        			!EQUIP:CHARA:和服 && !EQUIP:CHARA:連衣裙 &&
					!EQUIP:CHARA:レオタード && !EQUIP:CHARA:ボディースーツ) &&
					EQUIP:CHARA:下半身内衣２ != 0
			}
				RESULTS = _ノーブラ下着
			ELSEIF IS_BUNNY(CHARA)
				RESULTS = _バニー
			ELSEIF CURRENT_CLOTHES_SET(CHARA) == 62
				RESULTS = _変T
			ELSEIF CURRENT_CLOTHES_SET(CHARA) == 74
				RESULTS = _セーラー
			ENDIF
		ENDIF
	ENDIF
ELSE
	;通常画像
	IF CHECK_NUDE(CHARA)
		;裸
		IF FLAG:立絵種類
			;顔絵
		ELSE
			;立ち絵
		ENDIF
	ELSE
		;服
		IF FLAG:立絵種類
			;顔絵
		ELSE
			;立ち絵
		ENDIF
	ENDIF
ENDIF

;IMAGE_I3_特殊表情(CHARA)--------------------------------------------------------------------
;角色特有の表情表示条件
;時間停止中でも維持する表情はこちら
;使用時注意点:
;	RESULTS:0に表情を格納
;	RESULTS:1にマウスオーバー時の表情を格納すること
;	"通常","笑顔","憤怒","発情","睡眠"は本編で実装済み
;-------------------------------------------------------------------------------------------
@IMAGE_I3_特殊表情(CHARA)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM CHARA

IF CFLAG:3:差し替え適用 == 3
	IF TALENT:CHARA:心情 == 1 || BASE:CHARA:情緒 > MAXBASE:CHARA:情緒 / 2 || TALENT:CHARA:恋慕
		IF RESULTS:0 == "通常"
			RESULTS:0 '= "微笑"
		ENDIF
		IF RESULTS:1 == "通常"
			RESULTS:1 '= "微笑"
		ENDIF
	ENDIF
ELSEIF CFLAG:3:差し替え適用
ELSE
	;通常画像
	IF FLAG:立絵種類
		;顔絵
	ELSE
		;立絵
	ENDIF
ENDIF

;IMAGE_I3_特殊表情COM(CHARA, コマンド)-------------------------------------------------------
;直前のコマンドで変化するキャラクター特有の表情表示条件
;時間停止中は変化しない表情はこちら
;使用時注意点:
;	RESULTS:0に表情を格納
;	RESULTS:1にマウスオーバー時の表情を格納すること
;	"オナニー","愛撫","性交"は本編で実装済み
;-------------------------------------------------------------------------------------------
@IMAGE_I3_特殊表情COM(CHARA, コマンド)
#DIM CHARA
#DIM コマンド

IF CFLAG:3:差し替え適用 == 3
	IF CHECK_NUDE(CHARA)
	ELSE
		IF IS_BUNNY(CHARA)
		ELSEIF CURRENT_CLOTHES_SET(CHARA) == 74
		ELSEIF CURRENT_CLOTHES_SET(CHARA) == 67
		ELSEIF CURRENT_CLOTHES_SET(CHARA) == [[纯色连衣裙套装]]
		ELSEIF CHECK_CLO("bra_visible", CHARA)
		ELSE
			SELECTCASE コマンド
				CASE 305
					RESULTS = 膝枕覆盖
				CASE 6, 12, 313
					RESULTS = 揉胸覆盖
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
