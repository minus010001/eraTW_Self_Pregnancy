;IMAGE_I17_特殊服装(CHARA)-------------------------------------------------------------------
;キャラクター特有の服装表示条件
;エフェクトを共有する服装差分はこちらで指定する
;使用時注意点:
;	RESULTSに特殊服装を格納すること
;	書式は %服装%%特殊服装% 適宜"_"等入れること
;-------------------------------------------------------------------------------------------
@IMAGE_I17_特殊服装(CHARA)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM CHARA
VARSET RESULTS
IF CFLAG:17:差し替え適用
	;差し替え画像
	IF CHECK_NUDE(CHARA)
		;裸
		IF GROUPMATCH(CFLAG:17:差し替え適用, 1)
			SIF BATHROBE_SWITCH && BATHROOM() && !CFLAG:诶嘿嘿
				RESULTS = _浴袍
		ENDIF
	ELSE
		;服
		IF FLAG:立絵種類
			;顔絵
			IF GROUPMATCH(CFLAG:17:差し替え適用, 3)
				IF CHECK_CLO("bra_visible", CHARA)
					IF CFLAG:CHARA:651 == 18
						RESULTS = _固有下着
					ELSE
						RESULTS = _下着
					ENDIF
				ELSEIF IS_BUNNY(CHARA)
					RESULTS = _バニー
				ELSEIF CURRENT_CLOTHES_SET(CHARA) == 62
					RESULTS = _変T
				ELSEIF CURRENT_CLOTHES_SET(CHARA) == 74
					RESULTS = _セーラー
				ELSEIF (DAY:2 == 1 && DAY:3 == 1) || (DAY:2 == 4 && DAY:3 == 31)
					IF CFLAG:CHARA:313
						RESULTS = _襦袢
					ELSE
						RESULTS = _年越し
					ENDIF
				ELSEIF CFLAG:CHARA:初期位置 == CFLAG:MASTER:初期位置
					SIF CFLAG:CHARA:313
						RESULTS = _ベビードール
				ENDIF
			ENDIF
		ELSE
			;立ち絵
			IF GROUPMATCH(CFLAG:17:差し替え適用, 3)
				IF CHECK_CLO("bra_visible", CHARA) && EQUIP:CHARA:下半身下着２ != 0
					IF CFLAG:CHARA:651 == 18
						RESULTS = _固有下着
					ELSE
						RESULTS = _下着
					ENDIF
				ELSEIF CHECK_CLO("bra_visible", CHARA) && EQUIP:CHARA:下半身下着２ == 0
					IF CFLAG:CHARA:651 == 18
						RESULTS = _固有下着
					ELSE
						RESULTS = _ノーパン下着
					ENDIF
				{
				ELSEIF (!EQUIP:CHARA:上半身上着１ && !EQUIP:CHARA:上半身上着２ && !EQUIP:CHARA:外搭 &&
						!EQUIP:CHARA:和服 && !EQUIP:CHARA:連衣裙 &&
						!EQUIP:CHARA:レオタード && !EQUIP:CHARA:ボディースーツ) &&
						EQUIP:CHARA:下半身内衣２ != 0
				}
					RESULTS = _ノーブラ下着
				ELSEIF IS_BUNNY(CHARA)
					RESULTS = _バニー
				ELSEIF CURRENT_CLOTHES_SET(CHARA) == 62
					RESULTS = _変T
				ELSEIF CURRENT_CLOTHES_SET(CHARA) == 74
					RESULTS = _セーラー
				ELSEIF (DAY:2 == 1 && DAY:3 == 1) || (DAY:2 == 4 && DAY:3 == 31)
					IF CFLAG:CHARA:313
						RESULTS = _襦袢
					ELSE
						RESULTS = _年越し
					ENDIF
				ELSEIF CFLAG:CHARA:初期位置 == CFLAG:MASTER:初期位置
					IF CFLAG:CHARA:313
						IF EQUIP:CHARA:下半身下着２ == 0
							RESULTS = _ノーパンベビー
						ELSE
							RESULTS = _ベビードール
						ENDIF
					ENDIF
				ENDIF
			ENDIF
		ENDIF
	ENDIF
ELSE
	;通常画像
	IF CHECK_NUDE(CHARA)
		;裸
		SIF BATHROBE_SWITCH && BATHROOM() && !CFLAG:诶嘿嘿
			RESULTS = _浴袍
	ELSE
		;服
		IF FLAG:立絵種類
			;顔絵
		ELSE
			;立ち絵
		ENDIF
	ENDIF
ENDIF

