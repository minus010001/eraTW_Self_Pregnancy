@CHARAMOVE_DATA_99(ARG, ARG:2)
#LOCALSIZE 1
#LOCALSSIZE 1
LOCAL = 99
SELECTCASE ARG
	;連動設定（RETURN=依存する角色, RESULT:1～3=対等に連動する角色）
	CASE 1
	;特殊生活時間設定（CFLAG:LOCAL:生活時間補正を設定する）
	CASE 3
	;移動傾向（±～10=行きやすい/行きにくい, -100=行かない）
	CASE 4
		SELECTCASE ARG:2
			;夢幻館には行かない
			CASE P450玄関 TO P466庭
				RETURN -100
			;他人的家には入らない
			CASE P432影狼的家, P437梅蒂欣的家, P439拉尔瓦的家, P443米斯蒂亜的家, P445妹紅的家
				RETURN -100
			;走廊,居間によく居る
			CASE P409走廊, P416居間
				RETURN 5

			;寧靜海の方へは行かない
			CASE P1016入海口, P1060純狐邸・玄関 TO P1072赫卡提亚私室
				RETURN -100
			;哆来咪宅には行かない
			CASE P1050哆来咪宅・居間 TO P1055哆来咪宅・廁所
				RETURN -100
			;詰め所は行かない
			CASE P1023門番詰め所 TO P1025玉兎詰め所
				RETURN -100
			;書斎、食堂によく居る
			CASE P1043書斎, P1026食堂
				RETURN 5
		ENDSELECT
	;出現場所
	CASE 7
		SELECTCASE ARG:2
			CASE 月之都, 綿月亭, 玉兎之街, 桃林～砂浜
				RETURN 1
		ENDSELECT
	;引力設定（CFLAG:LOCAL:引力点を設定する）
	CASE 8
ENDSELECT

@EXIST_キャラデータ99
#LOCALSIZE 1
#LOCALSSIZE 1

@キャラデータ99(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "名前"
	CALLF MAKE_STR(V_NAME, "豊姫")
;こっから衣装設定
CASE "今天的睡衣"
	CALLF MAKE_STR(V_NAME, "睡衣（襦袢）套")

CASE "便装：帽子"
	CALLF MAKE_INT(V_NAME, [[頭装備_帽子]])
CASE "便装：靴"
	CALLF MAKE_INT(V_NAME, [[靴_鞋子]])
;CASE "便装：襪子"
	;CALLF MAKE_INT(V_NAME, [[襪子_袜子]])
CASE "便装：裙子"
	CALLF MAKE_INT(V_NAME, [[裙子_背带裙]])
CASE "便装：上身衣服２"
	CALLF MAKE_INT(V_NAME, [[上身衣服_はだけ可能_褶边女式衬衫]])
CASE "便装：其他１"
	CALLF MAKE_INT(V_NAME, [[其他衣装_束腰]])

CASE "固有内衣形容詞"
	CALLF MAKE_STR(V_NAME, "永远不坏的")
CASE "固有下半身内衣名"
	CALLF MAKE_STR(V_NAME, "F纤维内裤")
CASE "固有上半身内衣"
	CALLF MAKE_INT(V_NAME, 1)
CASE "固有上半身内衣名"
	CALLF MAKE_STR(V_NAME, "F纤维胸罩")
CASE "固有内衣着用条件"
	SIF !RAND:3
		CALLF MAKE_INT(V_NAME, 1)
CASE "固有内衣半透明(前)"
	CALLF MAKE_INT(V_NAME, 1)
CASE "固有内衣半透明(後)"
	CALLF MAKE_INT(V_NAME, 1)
CASE "固有内衣布料厚度"
	CALLF MAKE_INT(V_NAME, 3)
;教育补丁获取技能
CASE "固有指令"
	IF 成人再教育插件开关 == 1
		CALLF MAKE_STR(V_NAME, "寻求知识")
	ENDIF
CASE "固有指令実行可能"
	IF 成人再教育插件开关 == 1
		CALLF MAKE_INT(V_NAME, 1)
	ENDIF
;料理関連
CASE "料理：喜欢的味道"
	CALLF MAKE_STR(V_NAME, "魚料理/鍋物/健康/淡白/上品/野趣/家庭的/滑溜溜/月都風/赏月/美味的水/中華/中華/甜/甜/辣/辣/")
CASE "料理：讨厌的味道"
	CALLF MAKE_STR(V_NAME, "洋食/ジャンキー/酸/酸/" + "青蛙/虫肉/怪诞/" * 3 + "謎料理/生命力/" * 5)
CASE "料理：助手効果"
	CALLF MAKE_STR(V_NAME, "月都風/幸運/")
;贈り物関連
CASE "感性：好き"
	CALLF MAKE_STR(V_NAME, "紫/秩序/美的/芸術的/大陸風/繊細/知的/" + "水/月/巫術/护符/扇/" * 3 + "フェムトファイバーの/桃の/海神の/海の/穢れなき/" * 5)
CASE "感性：嫌い"
	CALLF MAKE_STR(V_NAME, "混沌/奇妙/パワフル/ロリータ/マニアック/" + "土/闇/死生/生体品/护臂/" * 3 + "地上の/万魔殿な/" * 10)
ENDSELECT

;-------------------------------------------------
;固有料理設定
;DISH_NAME          料理名
;RESULTS            料理の種類（軽食/主食/甜点）
;CALL 材料設定("")  材料の指定。"汎用"を入れると自動で汎用食材になる
;DISH_TASTE         味の設定
;DISH_COMMENT       （任意）一行コメント
;DISH_TIME          （任意）調理にかかる時間
;DISH_MAXLIMIT      （任意）料理の持続時間
;-------------------------------------------------
@SPECIAL_MENU_99
#LOCALSIZE 1
#LOCALSSIZE 1
DISH_NAME = 海幸山幸
RESULTS = 主食
CALL 材料設定("高级食材")
DISH_TASTE = 肉料理/魚料理/淡白/豪華/上品/鲜艳/彩り/美味的水/
DISH_COMMENT = 用了很多山珍海味的奢侈料理。名字没有什么深意…应该。
RETURN 1


;IMAGE_I99_特殊服装(CHARA)-------------------------------------------------------------------
;角色特有の服装表示条件
;エフェクトを共有する服装差分はこちらで指定する
;使用時注意点:
;	RESULTSに特殊服装を格納すること
;	書式は %服装%%特殊服装% 適宜"_"等入れること
;-------------------------------------------------------------------------------------------
@IMAGE_I99_特殊服装(CHARA)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM CHARA
VARSET RESULTS

IF CFLAG:99:差し替え適用 == 3
	;替换用画像
	IF CHECK_NUDE(CHARA)
		;裸
		IF FLAG:立絵種類
			;顔絵
		ELSE
			;立絵
		ENDIF
	ELSE
		;服
		IF CHECK_CLO("bra_visible", CHARA) || TEQUIP:CHARA:SWIMMING
			RESULTS = _泳衣
		ELSE
			
		ENDIF
	ENDIF
ELSEIF CFLAG:99:差し替え適用 == 2
	;替换用画像
	IF CHECK_NUDE(CHARA)
		;裸
		IF FLAG:立絵種類
			;顔絵
		ELSE
			;立絵
		ENDIF
	ELSE
		;服
		IF IS_BUNNY(CHARA)
			IF FLAG:立絵種類
				;顔絵
				RESULTS = _バニー
			ELSE
				;立絵
				RESULTS = _バニー
			ENDIF
		ENDIF
	ENDIF
ELSEIF CFLAG:99:差し替え適用 == 1
	;替换用画像
	IF CHECK_NUDE(CHARA)
		;裸
		IF FLAG:立絵種類
			;顔絵
		ELSE
			;立絵
		ENDIF
	ELSE
		;服
		IF FLAG:立絵種類
			;顔絵
		ELSE
			;立絵
		ENDIF
	ENDIF
ELSE
	;通常画像
	IF CHECK_NUDE(CHARA)
		;裸
		IF FLAG:立絵種類
			;顔絵
		ELSE
			;立絵
		ENDIF
	ELSE
		;服
		IF IS_BUNNY(CHARA)
			IF FLAG:立絵種類
				;顔絵
				RESULTS = _バニー
			ELSE
				;立絵
				RESULTS = _バニー
			ENDIF
		ENDIF
	ENDIF
ENDIF

;IMAGE_I99_特殊表情(CHARA)--------------------------------------------------------------------
;角色特有の表情表示条件
;時間停止中でも維持する表情はこちら
;使用時注意点:
;	RESULTS:0に表情を格納
;	RESULTS:1にマウスオーバー時の表情を格納すること
;	"通常","笑顔","憤怒","発情","睡眠"は本編で実装済み
;-------------------------------------------------------------------------------------------
@IMAGE_I99_特殊表情(CHARA)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM CHARA

IF CFLAG:99:差し替え適用 == 3
	;替换用画像
	IF CHECK_NUDE(CHARA)
		IF RESULTS:0 == "通常"
			RESULTS:0 '= "裸通常"
		ENDIF
		IF RESULTS:1 == "通常"
			RESULTS:1 '= "裸通常"
		ENDIF
	ENDIF
ELSEIF CFLAG:99:差し替え適用
	;替换用画像
	IF FLAG:立絵種類
		;顔絵
	ELSE
		;立絵
	ENDIF
ELSE
	;通常画像
	IF FLAG:立絵種類
		;顔絵
	ELSE
		;立絵
	ENDIF
ENDIF

