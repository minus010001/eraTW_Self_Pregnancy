@CHARAMOVE_DATA_56(ARG, ARG:2)
#LOCALSIZE 1
#LOCALSSIZE 1
LOCAL = 56
SELECTCASE ARG
	;連動設定（RETURN=依存する角色, RESULT:1～3=対等に連動する角色）
	CASE 1
		SELECTCASE CFLAG:LOCAL:今日の運勢 % 100
			CASE IS < 5 ;5%
				RETURN [[青娥]]
			CASE IS < 10 ;5%
				RETURN [[こころ]]
		ENDSELECT
	;特殊生活時間設定（CFLAG:LOCAL:生活時間補正を設定する）
	CASE 3
	;移動傾向（±～10=行きやすい/行きにくい, -100=行かない）
	CASE 4
		SELECTCASE ARG:2
			;神霊廟メンバーの私室はあんまり入らない
			CASE P125屠自古私室, P127布都私室, P139邪仙楼
				RETURN -5
			;命蓮寺内部
			CASE P103本堂 TO P120庫房
				RETURN -100
			;道場によく居る
			CASE P126道場
				RETURN 5
		ENDSELECT
	;出現場所
	CASE 7
		SELECTCASE ARG:2
			CASE 桜花道的鳥居, 神社境内, 神社走廊
				RETURN 1
			CASE 地蔵小路, 倒垂的柳樹下, 命蓮寺境内, 神霊廟広場, 神霊廟道場
				RETURN 1
			CASE 広場, 商家町, 呑屋小道, 長屋街
				RETURN 1
		ENDSELECT
	;引力設定（CFLAG:LOCAL:引力点を設定する）
	CASE 8
ENDSELECT

@EXIST_キャラデータ56
#LOCALSIZE 1
#LOCALSSIZE 1

@キャラデータ56(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "名前"
	CALLF MAKE_STR(V_NAME, "神子")
;こっから衣装設定
CASE "今天的睡衣"
	CALLF MAKE_STR(V_NAME, "睡衣（襦袢）套")

CASE "便装：帽子"
	CALLF MAKE_INT(V_NAME, [[頭装備_头戴式耳机]])
CASE "便装：靴"
	CALLF MAKE_INT(V_NAME, [[靴_鞋子]])
CASE "便装：襪子"
	CALLF MAKE_INT(V_NAME, [[襪子_袜子]])
CASE "便装：裙子"
	CALLF MAKE_INT(V_NAME, [[裙子_裙子]])
CASE "便装：上身衣服１"
	CALLF MAKE_INT(V_NAME, [[上身衣服_はだけ不可_无袖上衣]])
CASE "便装：飾品"
	CALLF MAKE_INT(V_NAME, [[飾品_剑]])
CASE "便装：腕部装束"
	CALLF MAKE_INT(V_NAME, [[腕部装束_手链]])
CASE "便装：其他１"
	CALLF MAKE_INT(V_NAME, [[其他衣装_笏板]])

CASE "固有内衣形容詞"
	CALLF MAKE_STR(V_NAME, "定制的")
CASE "固有下半身内衣名"
	CALLF MAKE_STR(V_NAME, "真丝蕾丝内裤")
CASE "固有上半身内衣"
	CALLF MAKE_INT(V_NAME, 1)
CASE "固有上半身内衣名"
	CALLF MAKE_STR(V_NAME, "真丝蕾丝胸罩")
CASE "固有内衣着用条件"
	SIF !RAND:(3 - (2 * 勝負内衣判定([[神子]])))
		CALLF MAKE_INT(V_NAME, 1)
CASE "固有内衣半透明(前)"
	CALLF MAKE_INT(V_NAME, 1)
CASE "固有内衣半透明(後)"
	CALLF MAKE_INT(V_NAME, 1)
CASE "固有内衣布料厚度"
	CALLF MAKE_INT(V_NAME, 1)

CASE "固有指令"
	IF 成人再教育插件开关 == 1 
		CALLF MAKE_STR(V_NAME, "学习演讲")
	ENDIF
CASE "固有指令実行可能"
	IF 成人再教育插件开关 == 1
		CALLF MAKE_INT(V_NAME, 1)
	ENDIF

;料理関連
CASE "料理：喜欢的味道"
	CALLF MAKE_STR(V_NAME, "米/魚料理/煮物/简易/健康/淡白/豪華/上品/鲜艳/サクサク/仙術/月都風/天界風/外界風/" + "和食/甜/酸/" * 2)
CASE "料理：讨厌的味道"
	CALLF MAKE_STR(V_NAME, "洋食/質素/辣/辣/" + "青蛙/虫肉/濃厚/謎料理/冥界風/地獄風/" * 3)
CASE "料理：助手効果"
	CALLF MAKE_STR(V_NAME, "絢爛/")
;贈り物関連
CASE "感性：好き"
	CALLF MAKE_STR(V_NAME, "紫/金/高級/秩序/美的/時尚/和風/派手/知的/威厳/" + "光/日/宝石/巫術/梟の/斗篷/" * 3 + "黄金の/神霊の/仙人の/七星の/威厳の/救世の/宝剣/" * 5)
CASE "感性：嫌い"
	CALLF MAKE_STR(V_NAME, "黒/混沌/シンプル/別緻/繊細/ロリータ/" + "安物/闇/死生/生体品/" * 3)
ENDSELECT

;-------------------------------------------------
;固有料理設定
;DISH_NAME          料理名
;RESULTS            料理の種類（軽食/主食/甜点）
;CALL 材料設定("")  材料の指定。"汎用"を入れると自動で汎用食材になる
;DISH_TASTE         味の設定
;DISH_COMMENT       （任意）一行コメント
;DISH_TIME          （任意）調理にかかる時間
;DISH_MAXLIMIT      （任意）料理の持続時間
;-------------------------------------------------
@SPECIAL_MENU_56
#LOCALSIZE 1
#LOCALSSIZE 1
DISH_NAME = 蘇
RESULTS = 軽食
CALL 材料設定("汎用")
DISH_TASTE = 和食/牛奶/乳酪/甜/上品/濃厚/豪華/
DISH_COMMENT = 将牛奶熬制而成的类似乳酪的料理。似乎深受古代贵族的喜爱。
RETURN 1

;IMAGE_I56_特殊服装(CHARA)-------------------------------------------------------------------
;角色特有の服装表示条件
;エフェクトを共有する服装差分はこちらで指定する
;使用時注意点:
;	RESULTSに特殊服装を格納すること
;	書式は %服装%%特殊服装% 適宜"_"等入れること
;-------------------------------------------------------------------------------------------
@IMAGE_I56_特殊服装(CHARA)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM CHARA
VARSET RESULTS

IF CFLAG:56:差し替え適用 == 3
	;替换用画像
	IF CHECK_NUDE(CHARA)
		;裸
		IF GROUPMATCH(1, TEQUIP:CHARA:新妻PLAY)
			RESULTS = _裸エプロン
		ENDIF
	ELSE
		;服
		IF CFLAG:CHARA:睡眠 || CFLAG:CHARA:陪睡中 || 睡眠時間(CHARA)
			RESULTS = _下着
		ELSEIF CURRENT_CLOTHES_SET(CHARA) == [[高叉偶像演出服套装]]
			RESULTS = _アイドル
		ELSEIF CURRENT_CLOTHES_SET(CHARA) == 74
			RESULTS = _セーラー服
		ELSEIF IS_BUNNY(CHARA)
			RESULTS = _バニーギャル
		ELSEIF CURRENT_CLOTHES_SET(CHARA) == [[军装风格演出服套装]]
			RESULTS = _军服
		ELSEIF CURRENT_CLOTHES_SET(CHARA) == [[女仆装]]
			RESULTS = _メイド
		ELSEIF CURRENT_CLOTHES_SET(CHARA) == [[白无垢]]
			RESULTS = _白无垢
		ELSEIF CURRENT_CLOTHES_SET(CHARA) == [[浴衣穿搭]] || EQUIP:CHARA:和服 == 1
			RESULTS = _着物
		ELSEIF CURRENT_CLOTHES_SET(CHARA) == [[辣妹系休闲套装]]
			RESULTS = _私服
		ELSEIF CHECK_CLO("bra_visible", CHARA)
			RESULTS = _下着
		ENDIF
	ENDIF
ELSEIF CFLAG:56:差し替え適用
	;替换用画像
	IF CHECK_NUDE(CHARA)
		;裸
		IF FLAG:立絵種類
			;顔絵
		ELSE
			;立絵
		ENDIF
	ELSE
		;服
		IF FLAG:立絵種類
			;顔絵
		ELSE
			;立絵
		ENDIF
	ENDIF
ELSE
	;通常画像
ENDIF


;IMAGE_I56_特殊表情(CHARA)--------------------------------------------------------------------
;角色特有の表情表示条件
;時間停止中でも維持する表情はこちら
;使用時注意点:
;	RESULTS:0に表情を格納
;	RESULTS:1にマウスオーバー時の表情を格納すること
;	"通常","笑顔","憤怒","発情","睡眠"は本編で実装済み
;-------------------------------------------------------------------------------------------
@IMAGE_I56_特殊表情(CHARA)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM CHARA

IF CFLAG:56:差し替え適用 == 3
	IF TALENT:CHARA:心情 == 1 || BASE:CHARA:情緒 > MAXBASE:CHARA:情緒 / 2 || TALENT:CHARA:恋慕
		IF RESULTS:0 == "通常"
			RESULTS:0 '= "微笑"
		ENDIF
		IF RESULTS:1 == "通常"
			RESULTS:1 '= "微笑"
		ENDIF
	ENDIF
ELSEIF CFLAG:56:差し替え適用
	;替换用画像
	IF FLAG:立絵種類
		;顔絵
	ELSE
	ENDIF
ELSE
	;通常画像
	IF FLAG:立絵種類
		;顔絵
	ELSE
		;立絵
	ENDIF
ENDIF

;IMAGE_I56_特殊表情COM(CHARA, 指令)-------------------------------------------------------
;直前の指令で変化する角色特有の表情表示条件
;時間停止中は変化しない表情はこちら
;使用時注意点:
;	RESULTS:0に表情を格納
;	RESULTS:1にマウスオーバー時の表情を格納すること
;	"自慰","愛撫","性交"は本編で実装済み
;-------------------------------------------------------------------------------------------
@IMAGE_I56_特殊表情COM(CHARA, 指令)
#DIM CHARA
#DIM 指令

IF CFLAG:56:差し替え適用 == 3
	;裸
	IF CHECK_NUDE(CHARA)
		IF GROUPMATCH(1, TEQUIP:CHARA:新妻PLAY)
		ELSE
			SELECTCASE 指令
				CASE 8
					RESULTS = 张开阴唇覆盖
				CASEELSE
					IF MASTER_POSE(SET_V,SET_P) == CHARA
						SELECTCASE TEQUIP:CHARA:110
							CASE POSE_COWGIRL
								RESULTS = V_骑乘位覆盖
							CASE POSE_LOTUS,POSE_SUSPENDED_CONGRESS
								RESULTS = V_对面座位覆盖
						ENDSELECT
					ENDIF
			ENDSELECT
		ENDIF
	ELSE
		;服
		IF CFLAG:CHARA:睡眠 || CFLAG:CHARA:陪睡中 || 睡眠時間(CHARA)
		ELSEIF CURRENT_CLOTHES_SET(CHARA) == [[高叉偶像演出服套装]]
		ELSEIF CURRENT_CLOTHES_SET(CHARA) == 74
		ELSEIF IS_BUNNY(CHARA)
		ELSEIF CURRENT_CLOTHES_SET(CHARA) == [[军装风格演出服套装]]
		ELSEIF CURRENT_CLOTHES_SET(CHARA) == [[女仆装]]
		ELSEIF CURRENT_CLOTHES_SET(CHARA) == [[白无垢]]
		ELSEIF CURRENT_CLOTHES_SET(CHARA) == [[浴衣穿搭]] || EQUIP:CHARA:和服 == 1
		ELSEIF CURRENT_CLOTHES_SET(CHARA) == [[辣妹系休闲套装]]
		ELSEIF CHECK_CLO("bra_visible", CHARA)
		ELSE
			SELECTCASE 指令
				CASE 305
					RESULTS = 膝枕覆盖
				CASE 6,12,313
					RESULTS = 揉胸覆盖
			ENDSELECT
		ENDIF
	ENDIF
ELSEIF CFLAG:56:差し替え適用
	;替换用画像
	IF FLAG:立絵種類
		;顔絵
	ELSE
		;立絵
	ENDIF
ELSE
	;通常画像
	IF FLAG:立絵種類
		;顔絵
	ELSE
		;立絵
	ENDIF
ENDIF
