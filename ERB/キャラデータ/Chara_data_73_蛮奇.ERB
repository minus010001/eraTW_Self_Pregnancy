@CHARAMOVE_DATA_73(ARG, ARG:2)
#LOCALSIZE 1
#LOCALSSIZE 1
LOCAL = 73
SELECTCASE ARG
	;連動設定（RETURN=依存する角色, RESULT:1～3=対等に連動する角色）
	CASE 1
		;水曜日は連動
		SIF YOUBI_MATCH(DAY, "水")
			RETURN [[若鷺姫]]
	;特殊生活時間設定（CFLAG:LOCAL:生活時間補正を設定する）
	CASE 3
	;移動傾向（±～10=行きやすい/行きにくい, -100=行かない）
	CASE 4
		SELECTCASE ARG:2
			;酒屋,自室,広場によく居る
			CASE P211酒屋, P231蛮奇的房間, P202中央広場
				RETURN 5
			;私室には行かない
			CASE P221稗田邸, P224慧音宅, P222寺子屋
				RETURN -100
			CASE P208雷鼓的房間, P209八橋的房間, P210弁弁的房間, P226小鈴私室, P229阿求私室
				RETURN -100
			CASE P232蓮子的房間, P233梅莉的房間, P234雪的房間, P235​​舞​的房間, P239美宵的房間
				RETURN -100
		ENDSELECT
	;出現場所
	CASE 7
		SELECTCASE ARG:2
			CASE 地蔵小路, 倒垂的柳樹下, 命蓮寺境内, 墓地
				RETURN 1
			CASE 広場, 商家町, 呑屋小道, 長屋街
				RETURN 1
		ENDSELECT
	;引力設定（CFLAG:LOCAL:引力点を設定する）
	CASE 8
ENDSELECT

@EXIST_キャラデータ73
#LOCALSIZE 1
#LOCALSSIZE 1

@キャラデータ73(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "名前"
	CALLF MAKE_STR(V_NAME, "蛮奇")
;こっから衣装設定
CASE "今天的睡衣"
	CALLF MAKE_STR(V_NAME, "睡衣（襦袢）套")

CASE "便装：外搭"
	CALLF MAKE_INT(V_NAME, [[外搭_披肩斗篷]])
CASE "便装：帽子"
	CALLF MAKE_INT(V_NAME, [[頭装備_蝴蝶结]])
CASE "便装：靴"
	CALLF MAKE_INT(V_NAME, [[靴_鞋子]])
CASE "便装：裙子"
	CALLF MAKE_INT(V_NAME, [[裙子_裙子]])
CASE "便装：上身衣服２"
	CALLF MAKE_INT(V_NAME, [[上身衣服_はだけ可能_女式衬衫]])
CASE "便装：其他１"
;とりあえず冬限定にしてみる
	SIF DAY:2 == 4
		CALLF MAKE_INT(V_NAME, [[其他衣装_围巾]])

CASE "固有内衣形容詞"
	CALLF MAKE_STR(V_NAME, "色彩柔和的")
CASE "固有下半身内衣名"
	CALLF MAKE_STR(V_NAME, "淡红色胖次")
CASE "固有上半身内衣"
	CALLF MAKE_INT(V_NAME, 1)
CASE "固有上半身内衣名"
	CALLF MAKE_STR(V_NAME, "淡红色胸罩")
CASE "固有内衣着用条件"
	SIF !RAND:(3 - (2 * 勝負内衣判定([[蛮奇]])))
		CALLF MAKE_INT(V_NAME, 1)
CASE "固有内衣半透明(前)"
	CALLF MAKE_INT(V_NAME, 1)
CASE "固有内衣半透明(後)"
	CALLF MAKE_INT(V_NAME, 1)
CASE "固有内衣布料厚度"
	CALLF MAKE_INT(V_NAME, 1)

;料理関連
CASE "料理：喜欢的味道"
	CALLF MAKE_STR(V_NAME, "卵/香料/中華/汁物/简易/ジャンキー/淡白/機能的/上品/鲜艳/软糯的/辣/辣/咸/咸/")
CASE "料理：讨厌的味道"
	CALLF MAKE_STR(V_NAME, "米/丰盛/野趣/酸/酸/")
CASE "料理：助手効果"
	CALLF MAKE_STR(V_NAME, "薄味/")
;贈り物関連
CASE "感性：好き"
	CALLF MAKE_STR(V_NAME, "かわいい/時尚/大陸風/別緻/マニアック/" + "赤/" * 3 + "騎士の/斗篷/面罩/" * 5)
CASE "感性：嫌い"
	CALLF MAKE_STR(V_NAME, "派手/知的/ロリータ/" + "書物/" * 3)

;農民関連
;首が落ちる＋赤色
;あんま人付き合いなさそうだけど一応
CASE "農民：説明"
	CALLF MAKE_STR(V_NAME, "椿農家")
CASE "農民：作物"
	CALLF MAKE_STR(V_NAME, "椿油")
CASE "農民：田的种类"
	CALLF MAKE_STR(V_NAME, "椿農園")
CASE "農民：畑の所在地"
	CALLF MAKE_STR(V_NAME, "人里")

CASE "農民：MapID"
	CALLF MAKE_INT(V_NAME, 2)
CASE "農民：場所ID"
	CALLF MAKE_INT(V_NAME, 206)
CASE "農民：報酬"
	CALLF MAKE_INT(V_NAME, 350)
CASE "農民：金利"
	CALLF MAKE_INT(V_NAME, 6)
ENDSELECT

