;IMAGE_I73_特殊服装(CHARA)-------------------------------------------------------------------
;キャラクター特有の服装表示条件
;エフェクトを共有する服装差分はこちらで指定する
;使用時注意点:
;	RESULTSに特殊服装を格納すること
;	書式は %服装%%特殊服装% 適宜"_"等入れること
;-------------------------------------------------------------------------------------------
@IMAGE_I73_特殊服装(CHARA)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM CHARA
VARSET RESULTS
IF CFLAG:73:差し替え適用 == 3
	;替换用画像
	IF CHECK_NUDE(CHARA)
	ELSE
		IF CFLAG:CHARA:睡眠 || CFLAG:CHARA:陪睡中 || 睡眠時間(CHARA)
			RESULTS = _下着
		ELSEIF IS_BUNNY(CHARA)
			RESULTS = _バニーギャル
		ELSEIF CURRENT_CLOTHES_SET(CHARA) == 74
			RESULTS = _セーラー服
		ELSEIF CURRENT_CLOTHES_SET(CHARA) == [[晚宴礼服套装]]
			RESULTS = _フォーマルドレス
		ELSEIF CURRENT_CLOTHES_SET(CHARA) == [[辣妹系休闲套装]]
			RESULTS = _私服
		ELSEIF CHECK_CLO("bra_visible", CHARA)
			RESULTS = _下着
		ENDIF
	ENDIF
ELSEIF CFLAG:73:差し替え適用 == 1 && FLAG:立絵種類
	IF IS_BUNNY(CHARA)
		RESULTS = _バニー
	ELSEIF !CHECK_NUDE(CHARA) && DAY:3 % 10 == 6
	;ELSEIF !CHECK_NUDE(CHARA)
		RESULTS = _スーツ
	ENDIF
ENDIF

;IMAGE_I73_体形(CHARA)-----------------------------------------------------------------------
;キャラクター特有の体形表示条件
;エフェクトを共有する体形差分はこちら
;服装を指定しても自動で表示されるので注意
;使用時注意点:
;   RESULTSに体形を格納すること
;   書式は %体形%%服装% 適宜"_"等入れること
;   "巨乳"は本編で実装済み %体形%巨乳%服装% で追記可能
;-------------------------------------------------------------------------------------------
@IMAGE_I73_体形(CHARA)
#DIM CHARA
VARSET RESULTS

IF CFLAG:73:差し替え適用 == 1 && FLAG:立絵種類 && CHECK_NUDE(CHARA) && TALENT:CHARA:胸围 < 0
	RESULTS = 貧乳
ENDIF

;IMAGE_I73_特殊表情(CHARA)--------------------------------------------------------------------
;角色特有の表情表示条件
;時間停止中でも維持する表情はこちら
;使用時注意点:
;	RESULTS:0に表情を格納
;	RESULTS:1にマウスオーバー時の表情を格納すること
;	"通常","笑顔","憤怒","発情","睡眠"は本編で実装済み
;-------------------------------------------------------------------------------------------
@IMAGE_I73_特殊表情(CHARA)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM CHARA

IF CFLAG:73:差し替え適用 == 3
	IF TALENT:CHARA:心情 == 1 || BASE:CHARA:情緒 > MAXBASE:CHARA:情緒 / 2 || TALENT:CHARA:恋慕
		IF RESULTS:0 == "通常"
			RESULTS:0 '= "微笑"
		ENDIF
		IF RESULTS:1 == "通常"
			RESULTS:1 '= "微笑"
		ENDIF
	ENDIF
ELSEIF CFLAG:73:差し替え適用
ELSE
	;通常画像
	IF FLAG:立絵種類
		;顔絵
	ELSE
		;立絵
	ENDIF
ENDIF

;IMAGE_I73_特殊表情COM(CHARA, 指令)-------------------------------------------------------
;直前の指令で変化する角色特有の表情表示条件
;時間停止中は変化しない表情はこちら
;使用時注意点:
;	RESULTS:0に表情を格納
;	RESULTS:1にマウスオーバー時の表情を格納すること
;	"自慰","愛撫","性交"は本編で実装済み
;-------------------------------------------------------------------------------------------
@IMAGE_I73_特殊表情COM(CHARA, 指令)
#DIM CHARA
#DIM 指令

IF CFLAG:73:差し替え適用 == 3
	IF CHECK_NUDE(CHARA)
	ELSE
		IF IS_BUNNY(CHARA)
		ELSEIF CURRENT_CLOTHES_SET(CHARA) == 74
		ELSEIF CURRENT_CLOTHES_SET(CHARA) == [[晚宴礼服套装]]
		ELSEIF CURRENT_CLOTHES_SET(CHARA) == [[辣妹系休闲套装]]
		ELSEIF CHECK_CLO("bra_visible", CHARA)
		ELSE
			SELECTCASE 指令
				CASE 305
					RESULTS = 膝枕覆盖
				CASE 6,12,313
					RESULTS = 揉胸覆盖
			ENDSELECT
		ENDIF
	ENDIF
ELSE
	;通常画像
	IF FLAG:立絵種類
		;顔絵
	ELSE
		;立絵
	ENDIF
ENDIF

;IMAGE_I73_特殊エフェクト(CHARA)--------------------------------------------------------------------
;キャラクター特有のエフェクト表示条件
;使用時注意点:
;	RESULTS配列に特殊エフェクトを格納
;	RETURNで追加するエフェクト数を返却すること
;-------------------------------------------------------------------------------------------
@IMAGE_I73_特殊エフェクト(CHARA)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM CHARA
#DIM DYNAMIC エフェクト数 = 0
VARSET RESULTS

IF CFLAG:73:差し替え適用 == 1 && FLAG:立絵種類
	;顔絵
	IF TALENT:CHARA:母乳体質 && NOWEX:CHARA:噴乳 && CHECK_NUDE(CHARA)
		IF FLAG:巨乳差分表示 && TALENT:CHARA:胸围 > 0
			RESULTS:エフェクト数 = 巨乳母乳
		ELSEIF TALENT:CHARA:胸围 < 0
			RESULTS:エフェクト数 = 貧乳母乳
		ELSE
			RESULTS:エフェクト数 = 母乳
		ENDIF
		エフェクト数 += 1
	ENDIF
	IF NOWEX:CHARA:TotalEX >= 5
		IF !RAND:2
			CSTR:CHARA:汎用エフェクト = ～～
		ELSE
			CSTR:CHARA:汎用エフェクト = んお゛お゛
		ENDIF
	ENDIF
ENDIF

RETURN エフェクト数

