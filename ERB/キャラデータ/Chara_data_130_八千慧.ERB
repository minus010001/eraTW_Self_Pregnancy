@CHARAMOVE_DATA_130(ARG, ARG:2)
#LOCALSIZE 1
#LOCALSSIZE 1
LOCAL = 130
SELECTCASE ARG
	;連動設定（RETURN=依存する角色, RESULT:1～3=対等に連動する角色）
	CASE 1
	;特殊生活時間設定（CFLAG:LOCAL:生活時間補正を設定する）
	CASE 3
	;移動傾向（±～10=行きやすい/行きにくい, -100=行かない）
	CASE 4
		SELECTCASE ARG:2
			;是非曲直庁、冥界、八雲邸には行かない（入り口部分は出る時用）
			CASE P612法廷 TO P639八雲邸居間
				RETURN -100
			;他人的家には入らない
			CASE P608潤美的家, P609瓔花的家, P606日狭美の家, P607残無の家
				RETURN -100
			;霊長園には行かない
			CASE P642霊長園 TO P645磨弓的房間
				RETURN -100
			;他所の風呂には行かない
			CASE P652早鬼宅の風呂, P655尤魔宅の風呂
				RETURN -100
		ENDSELECT
	;出現場所
	CASE 7
		SELECTCASE ARG:2
			CASE 桜花道的鳥居, 神社境内, 神社走廊
				RETURN 1
			CASE 広場, 商家町, 呑屋小道
				RETURN 1
			CASE 森林的入口, 古木的大樹, 霧雨魔法店, 再思之道, 無縁塚
				RETURN 1
			CASE 中有之道, 三途之川, 彼岸, 地獄, 畜生界
				RETURN 1
		ENDSELECT
	;引力設定（CFLAG:LOCAL:引力点を設定する）
	CASE 8
ENDSELECT

@EXIST_キャラデータ130
#LOCALSIZE 1
#LOCALSSIZE 1

@キャラデータ130(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "名前"
	CALLF MAKE_STR(V_NAME, "八千慧")
;こっから衣装設定
CASE "今天的睡衣"
	CALLF MAKE_STR(V_NAME, "睡衣（襦袢）套")

CASE "便装：上身衣服２"
	CALLF MAKE_INT(V_NAME, [[上身衣服_はだけ可能_女式衬衫]])
CASE "便装：裙子"
	CALLF MAKE_INT(V_NAME, [[裙子_裙子]])
CASE "便装：靴"
	CALLF MAKE_INT(V_NAME, [[靴_鞋子]])
CASE "便装：襪子"
	CALLF MAKE_INT(V_NAME, [[襪子_袜子]])
CASE "便装：其他１"
	CALLF MAKE_INT(V_NAME, [[其他衣装_龟壳]])

CASE "固有内衣形容詞"
	CALLF MAKE_STR(V_NAME, "不能给人看的")
CASE "固有下半身内衣名"
	CALLF MAKE_STR(V_NAME, "龟龟图案内裤")
CASE "固有上半身内衣"
	CALLF MAKE_INT(V_NAME, 1)
CASE "固有上半身内衣名"
	CALLF MAKE_STR(V_NAME, "龟甲胸罩")
CASE "固有内衣着用条件"
	SIF !RAND:(1 + (2 * 勝負内衣判定([[八千慧]])))
		CALLF MAKE_INT(V_NAME, 1)
CASE "固有内衣半透明(前)"
	CALLF MAKE_INT(V_NAME, 1)
CASE "固有内衣半透明(後)"
	CALLF MAKE_INT(V_NAME, 1)
CASE "固有内衣布料厚度"
	CALLF MAKE_INT(V_NAME, 2)

;料理関連
CASE "料理：喜欢的味道"
	CALLF MAKE_STR(V_NAME, "野菜/香料/麺類/下酒菜/丰盛/健康/濃厚/冷/豪華/上品/怪诞/黏稠/畜生流/中華/中華/辣/辣/酸/酸/")
CASE "料理：讨厌的味道"
	CALLF MAKE_STR(V_NAME, "淡白/鲜艳/甜/甜/虫肉/虫肉/虫肉/天界風/天界風/天界風/")
CASE "料理：助手効果"
	CALLF MAKE_STR(V_NAME, "畜生流/幸運/得意料理＊中華＊/")
;贈り物関連
CASE "感性：好き"
	CALLF MAKE_STR(V_NAME, "緑/高級/混沌/かわいい/奇妙/大陸風/別緻/知的/威厳/" + "水/宝石/美術品/" * 3 + "水獭の/龟の/龍の/" * 5)
CASE "感性：嫌い"
	CALLF MAKE_STR(V_NAME, "秩序/ポップ/派手/ロリータ/" + "安物/神霊/" * 3 + "埴轮の/狼の/马の/鹫の/天馬の/埴轮/" * 10)
ENDSELECT

