@IMAGE_I102_特殊表情COM(CHARA, コマンド)
#DIM CHARA
#DIM コマンド

SELECTCASE CFLAG:102:差し替え適用
	CASE 2
	CASE 1
		IF CHECK_NUDE(CHARA)
			SELECTCASE コマンド
				CASE 80
					RESULTS = 手交覆盖
				CASE 81, 88, 140
					RESULTS = 口交覆盖{RANDNR(5, "COM_DIFF_AS06MARKIV") + 1}
				CASE 82
					RESULTS = 乳交覆盖
				CASE 85
					RESULTS = 足交覆盖{RANDNR(2, "COM_DIFF_AS06MARKIV") + 1}
				CASE 89
					RESULTS = 喝套内精液覆盖
				CASE 91
					RESULTS = 肛门侍奉覆盖
				CASE 8
					IF EX:CHARA:膣内精液
						RESULTS = 张开阴唇2覆盖
					ELSE
						RESULTS = 张开阴唇覆盖
					ENDIF
				CASE 13
					IF EX:CHARA:肛門内精液
						RESULTS = 张开菊穴2覆盖
					ELSE
						RESULTS = 张开菊穴覆盖
					ENDIF
				CASE 83
					IF CFLAG:CHARA:妊娠経過日数 >= 40
						RESULTS = 妊娠_素股覆盖
					ELSE
						RESULTS = 素股覆盖
					ENDIF
				CASEELSE
					IF MASTER_POSE(SET_V,SET_P) == CHARA && CHECK_NUDE([[梦子]]) && CFLAG:[[梦子]]:诶嘿嘿
						SELECTCASE TEQUIP:CHARA:110
							CASE POSE_MISSIONARY
								RESULTS = 正常位覆盖_d0
							CASE POSE_COWGIRL,POSE_LOTUS,POSE_SUSPENDED_CONGRESS
								RESULTS = 骑乘位覆盖_d0
							CASE POSE_DOGGYSTYLE,POSE_REVLOTUS,POSE_REV_COWGIRL
								RESULTS = 后入位覆盖_d0
						ENDSELECT
					ELSEIF MASTER_POSE(SET_A,SET_P) == CHARA && CHECK_NUDE([[梦子]]) && CFLAG:[[梦子]]:诶嘿嘿
						SELECTCASE TEQUIP:CHARA:110
							CASE POSE_MISSIONARY
								RESULTS = 正常位A覆盖_d0
							CASE POSE_COWGIRL,POSE_LOTUS,POSE_SUSPENDED_CONGRESS
								RESULTS = 正常位A覆盖_d0
							CASE POSE_DOGGYSTYLE,POSE_REVLOTUS,POSE_REV_COWGIRL
						ENDSELECT
					ELSEIF MASTER_POSE(SET_V,SET_P) == CHARA
						SELECTCASE TEQUIP:CHARA:110
							CASE POSE_MISSIONARY
								RESULTS = V_正面覆盖
							CASE POSE_COWGIRL,POSE_SUSPENDED_CONGRESS
								RESULTS = V_骑乘位覆盖
							CASE POSE_LOTUS
								RESULTS = V_对面座位覆盖
							CASE POSE_DOGGYSTYLE,POSE_REV_COWGIRL
								RESULTS = V_后入覆盖
							CASE POSE_STANDING_FROM_BEHIND
								RESULTS = V_站立后入覆盖
							CASE POSE_REVLOTUS
								RESULTS = V_背面坐莲覆盖
							CASE POSE_STANDING_MISSIONARY
								RESULTS = 站立正常覆盖
						ENDSELECT
						IF CFLAG:CHARA:妊娠経過日数 >= 40
							RESULTS = 妊娠_%RESULTS%
						ENDIF
					ELSEIF MASTER_POSE(SET_A,SET_P) == CHARA
						SELECTCASE TEQUIP:CHARA:110
							CASE POSE_MISSIONARY
								RESULTS = A_正面覆盖
							CASE POSE_COWGIRL,POSE_SUSPENDED_CONGRESS
								RESULTS = A_骑乘位覆盖
							CASE POSE_LOTUS
								RESULTS = A_对面座位覆盖
							CASE POSE_DOGGYSTYLE,POSE_REV_COWGIRL
								RESULTS = A_后入覆盖
							CASE POSE_STANDING_FROM_BEHIND
								RESULTS = A_站立后入覆盖
							CASE POSE_REVLOTUS
								RESULTS = A_背面坐莲覆盖
							CASE POSE_STANDING_MISSIONARY
								RESULTS = 站立正常覆盖
						ENDSELECT
						IF CFLAG:CHARA:妊娠経過日数 >= 40
							RESULTS = 妊娠_%RESULTS%
						ENDIF
					ENDIF
			ENDSELECT
		ELSE
			IF EQUIP:CHARA:連衣裙 == 19
				SELECTCASE コマンド
					CASE 305
						RESULTS = 膝枕覆盖
					CASE 6,12,313
						RESULTS = 揉胸覆盖
				ENDSELECT
			ENDIF
		ENDIF
	CASE 0
		IF CHECK_NUDE(CHARA)
			;裸
			IF FLAG:立絵種類
				;顔絵
			ELSE
				;立ち絵
			ENDIF
		ELSE
			;服
			IF FLAG:立絵種類
				;顔絵
			ELSE
				;立ち絵
			ENDIF
		ENDIF
ENDSELECT
