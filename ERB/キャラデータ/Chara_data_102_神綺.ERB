@IMAGE_I102_特殊服装(CHARA)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM CHARA
VARSET RESULTS
SELECTCASE CFLAG:102:差し替え適用
	CASE 2
	CASE 1
		IF CHECK_NUDE(CHARA)
			;裸
			IF CURRENT_CLOTHES_SET(CHARA) == 66
				RESULTS = _逆兔女郎
			ENDIF
		ELSE
			IF CFLAG:CHARA:睡眠 || CFLAG:CHARA:陪睡中 || 睡眠時間(CHARA)
				RESULTS = _睡衣
			ELSEIF GROUPMATCH(1, TEQUIP:CHARA:新妻PLAY)
				RESULTS = _婚纱
			ELSEIF EQUIP:CHARA:連衣裙 == 7
				RESULTS = _晚礼服
			ELSEIF CURRENT_CLOTHES_SET(CHARA) == [[童贞杀手毛衣]]
