@GO_OUT_CONDITION_EV1
#LOCALSIZE 1
#LOCALSSIZE 1
RESULT = 0
;约会中は発生しない
SIF RAND:3 || FLAG:约会的对象
	RETURN 0
;その日物色済みだと無理
SIF GETBIT(TFLAG:一日一回, 9)
	RETURN 0
IF WEATHERDLC
	IF TIME:5 != 3
		SIF RAND:100 > 50
			RETURN 0
	ELSEIF RAND:100 > 75
			RETURN 0
	ENDIF
ELSE
ENDIF
IF ENCOUNTDLC
	IF SUMIPROTECT
		IF 自机立绘开关
			CALL PRINT_FACE_PLAYER, MASTER, "憤怒", "服", "", ""
			PRINTFORMDW 「%TEXTR("嗯？！/哦呀？!/啊？！")%」
		ENDIF
		PRINTFORMW 在路上，突然感觉到了被袭击的预感，%CALLNAME:MASTER%不由得在心中感谢了堇子的加护，连忙小心的躲避了开来……
		RETURN 0
	ENDIF
ENDIF
CALL GO_OUT_EV1
RETURN RESULT

