@DAILY_NAME_EV0(ARG=1)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTIONS
RETURNF ARG?"一团糟"#"散らかし"

@DAILY_CONDITION_EV0
#LOCALSIZE 1
#LOCALSSIZE 1
SIF RAND:8 > 0
	RETURN -1
SIF DAY <= 30
	RETURN -1
SIF AVERAGE_YOGORE() > 800
	RETURN -1

CALL DAILY_EV0
RETURN 1

@DAILY_EV0
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM CUMNUMB
#DIM 妖精
PRINTFORML 在%CALLNAME:MASTER%睡着的时候%GET_MAPNAME(GET_HOME_MAP())%里大群的妖精蜂拥过来！
IF RAND:10 < ABL:MASTER:戦闘能力 + TALENT:MASTER:神性 * MAGIC_DLC && AT_HOME(MASTER) == 1
	PRINTFORML 妖精们把%GET_MAPNAME(GET_HOME_MAP())%里面弄的乱七八糟的
	PRINTFORML
	PRINTL
	PRINTFORML 途中发现%CALLNAME:MASTER%出来了、目瞪口呆的看着...
	PRINTFORML 可恶...要教训一顿吗？
	PRINTFORML
	PRINT [0] - 是 
	PRINT [1] - 否
	INPUT
	IF RESULT == 0
		PRINTFORML 臭小鬼们就要用肉棒好好调教一番！
		IF !HAS_PENIS(MASTER)
			PRINTFORML 但遗憾的是你并没有那活儿.....
			GOTO NO_PUNISH
		ENDIF
		WAIT
		PRINTFORMW 

		SETCOLOR 251,100,254
		CALL DQPRINT ("你抓住了一只妖精，在她的悲鸣中用种付位的姿势啪啪啪的做了起来...")
		RESETCOLOR
		;CALL PRINT_IMAGE("压倒2")	
		EXP:MASTER:挿入経験 += RAND:5
		EXP:MASTER:射精経験 += RAND:5
		EXP:MASTER:絶頂経験 += RAND:5
		SIF TALENT:MASTER:キス未経験
			CALL SET_FIRSTKISS(MASTER, 妖精, 2)
		DOWNBASE:MASTER:体力 = 500
		DOWNBASE:MASTER:気力 = 550
		CUMNUMB = 500 + RAND:100
		DOWNBASE:MASTER:精力 = CUMNUMB
		SETCOLOR C_CREAM
		WAIT
		PRINTFORML 往妖精的子宫内注入了{CUMNUMB}ml的精液…
		CALL DQPRINT (" .. ")
		;WAIT
		CALL DQPRINT (" ... ")
		;WAIT
		CALL DQPRINT (" .... ")
		;WAIT
		CALL DQPRINT (" 狠狠恐吓妖精不要说出去之后，把她赶走了。")
		WAIT
	ELSE
		$NO_PUNISH
		PRINTFORML 还是算了。
	ENDIF
	FOR LOCAL,MINROOM(),MAXROOM
		IF RAND:10 <= ABL:MASTER:戦闘能力
			YOGORE:LOCAL = MIN(YOGORE:LOCAL + 1000 + RAND:4000, 6000)
		ENDIF
	NEXT
;黑雷神巧克力を10个以上所持
ELSEIF ITEM:120 >= 10 && AT_HOME(MASTER) == 1
	;最大9つ。你の分は残しておく
	PRINTFORML %CALLNAME:MASTER%睁开眼睛时妖精们已经在咀嚼黑雷神巧克力了
	PRINTFORML %CALLNAME:MASTER%擦拭妖精的嘴边、告诫它们可以回家了
	CALL LOST_ITEM("黑雷神巧克力", RAND:9 + 1, 1)
ELSE
	PRINTFORML 妖精们把%GET_MAPNAME(GET_HOME_MAP())%里面弄得乱七八糟的
	FOR LOCAL,MINROOM(),MAXROOM
		YOGORE:LOCAL = MIN(YOGORE:LOCAL + 1000 + RAND:4000, 6000)
	NEXT
ENDIF
PRINTW 
