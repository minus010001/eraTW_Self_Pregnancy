;FileName_APPEND_SYS.ERB --------------------------- Rev1.00
;CALL		USER
;ARG		VOID
;RETURN		VOID
;COMMENT	
;-----------------------------------------------------------

@SYS_EVENT
#LOCALSIZE 1
#LOCALSSIZE 1

;自宅にSUMIKOMI_ROOMが設定されている
LOCAL:0 = 0
IF HOUGONG
	IF FLAG:住宿人物 >= 0 && !FLAG:住宿事件 && SUMIKOMI_ROOM && CFLAG:MASTER:現在位置 != OMANEKIBEYA()
		LOCAL:0 = 1
		CALL NEWMEMBER_ADD
	ENDIF
ELSE
	IF FLAG:住宿人物== 0 && !FLAG:住宿事件 && SUMIKOMI_ROOM && CFLAG:MASTER:現在位置 != OMANEKIBEYA()
		LOCAL:0 = 1
		CALL NEWMEMBER_ADD
	ENDIF
ENDIF
IF MovingHomeWish
	IF MHW_WishExists && !LOCAL:0
		CALL MHW_NEWMEMBER_ADD
		VARSET MHW_WishList
	ENDIF
ENDIF


;住宿EX角色決定イベント
@NEWMEMBER_ADD
#DIM 人数
#DIM ROOM_N
#DIM C_ID
VARSET LOCAL
人数 = 0
FOR LOCAL,1,CHARANUM
	;既に住んでいるメンバーは除く
	IF 实用设置开关 && Setting_跟随型后宫
		SIF CFLAG:LOCAL:神社在住 == SUMIKOMI_ROOM
			Setting_CFLAG:LOCAL:后宫居住标记 = 1
		IF Setting_CFLAG:LOCAL:后宫居住标记
			CFLAG:LOCAL:初期位置 = SUMIKOMI_ROOM
			CFLAG:LOCAL:神社在住 = SUMIKOMI_ROOM
			CFLAG:LOCAL:現在位置 = SUMIKOMI_ROOM
			FLAG:住宿人物 = LOCAL
		ENDIF
	ENDIF
	SIF CFLAG:LOCAL:神社在住 > 0
		CONTINUE
	SIF TALENT:LOCAL:路人
		CONTINUE
	IF HOUGONG
		IF TALENT:LOCAL:恋慕 && EXP:LOCAL:愛情経験 >= 20
			人数 ++
			LOCAL:LOCAL = 1
			LOCALS = %CALLNAME:LOCAL%
		ENDIF
		IF TALENT:LOCAL:愛欲
			人数 ++
			LOCAL:LOCAL = 1
			LOCALS = %CALLNAME:LOCAL%
		ENDIF
	ELSE
		IF TALENT:LOCAL:恋慕 && EXP:LOCAL:愛情経験 >= 200 
			人数 ++
			LOCAL:LOCAL = 1
			LOCALS = %CALLNAME:LOCAL%
		ENDIF
	ENDIF
NEXT
IF HOUGONG
	SIF !人数
		RETURN
ELSE
	SIF !人数 || (DAY:3 != 1)
		RETURN
ENDIF
PRINTL
DRAWLINE
PRINTFORML 早上起床后、出现了来找%CALLNAME:MASTER%的来访者

PRINTFORML %LOCALS%\@ 人数 > 1 ? 她们 # \@告诉%CALLNAME:MASTER%想在%GET_MAPNAME(GET_HOME_MAP())%定居生活
PRINTL
IF HOUGONG
	IF MAIN_MAP == 0
		PRINTFORML 同意→入住后宫别墅
	ELSE
		PRINTFORML 如果重新装修%NAME_FROM_PLACE(SUMIKOMI_ROOM)%的话，就可以住更多人了吧
	ENDIF
ELSEIF MAIN_MAP == 2
	PRINTFORML 因为长屋里面有空房间、所以搬家应该很容易吧
	IF TALENT:NameToID(LOCALS):人类
		PRINTFORMW %CALLNAME:拠点_家主%好像也没有什么特殊的拒绝理由
	ELSE
		PRINTFORMW %LOCALS%说只要对%CALLNAME:拠点_家主%隐瞒真实身份就可以了
	ENDIF
ELSE
	PRINTFORML 如果重新装修%NAME_FROM_PLACE(SUMIKOMI_ROOM)%的话，就可以一个人住了吧
	PRINTFORMW %CALLNAME:拠点_家主%好好说的话，会欢迎的
ENDIF
$HOUGONGLOOP
PRINTFORML %CALLNAME:MASTER%也同意…
C_ID = 1
FOR LOCAL,1,CHARANUM
	;既に住んでいるメンバーは除く
	SIF CFLAG:LOCAL:神社在住 > 0
		CONTINUE
	IF HOUGONG
		IF TALENT:LOCAL:恋慕 && EXP:LOCAL:愛情経験 >= 20
			C_ID = LOCAL
			PRINTFORML [{LOCAL}] - 同意%CALLNAME:LOCAL%入住%GET_MAPNAME(GET_HOME_MAP())%
		ENDIF
		IF TALENT:LOCAL:愛欲
			C_ID = LOCAL
			PRINTFORML [{LOCAL}] - 同意%CALLNAME:LOCAL%入住%GET_MAPNAME(GET_HOME_MAP())%
		ENDIF
	ELSE
		IF TALENT:LOCAL:恋慕 && EXP:LOCAL:愛情経験 >= 200
			C_ID = LOCAL
			PRINTFORML [{LOCAL}] - 同意%CALLNAME:LOCAL%搬家
		ENDIF
	ENDIF
NEXT
PRINTFORML [999] - 拒绝
$INPUT_LOOP
INPUT
IF RESULT == 999
	PRINTFORMW %CALLNAME:MASTER%摇了摇头拒绝、%LOCALS%\@ 人数 > 1 ? 她们 # \@很遗憾的离开了%CALLNAME:MASTER%的房间
	;このやり方だと一人しか口上を呼べないんだが良い方法はないものか
	;とりあえず多数の場合にそれぞれの角色の口上を呼び出せるようにしてみる、ただし実際に出来るかどうかはテスト出来てないので自信は無い
	IF 人数 > 1
		FOR LOCAL,1,CHARANUM
			;既に住んでいるメンバーは除く
			SIF CFLAG:LOCAL:神社在住 > 0
				CONTINUE
			IF HOUGONG
				IF TALENT:LOCAL:恋慕 && EXP:LOCAL:愛情経験 >= 20
					CALL KOJO_MESSAGE_SEND("EVENT",19,LOCAL,2,0)
					PRINTL 
				ENDIF
				IF TALENT:LOCAL:愛欲
					CALL KOJO_MESSAGE_SEND("EVENT",19,LOCAL,2,0)
					PRINTL 
				ENDIF
			ELSE
				IF TALENT:LOCAL:恋慕 && EXP:LOCAL:愛情経験 >= 200
					CALL KOJO_MESSAGE_SEND("EVENT",19,LOCAL,2,0)
					PRINTL 
				ENDIF
			ENDIF
		NEXT
	ELSE
		CALL KOJO_MESSAGE_SEND("EVENT",19,C_ID,2,0)
	ENDIF
	RETURN 0
ELSEIF RESULT >= CHARANUM
	CLEARLINE 1
	GOTO INPUT_LOOP
ELSEIF !LOCAL:RESULT
	CLEARLINE 1
	GOTO INPUT_LOOP
ENDIF
PRINTFORML 拉起%CALLNAME:RESULT%的手、告诉她要去拜托%CALLNAME:拠点_家主%,%CALLNAME:RESULT%高兴地微笑着
PRINTFORMW 马上去%CALLNAME:拠点_家主%那里拜托、她很快就答应了…
PRINTL
PRINTFORMW - %CALLNAME:RESULT%成为了%GET_MAPNAME(GET_HOME_MAP())%的一员 -
PRINTL
FLAG:住宿人物= RESULT
Setting_CFLAG:RESULT:后宫居住标记 = 1
CFLAG:(FLAG:住宿人物):初期位置 = SUMIKOMI_ROOM
CFLAG:(FLAG:住宿人物):神社在住 = SUMIKOMI_ROOM
CFLAG:(FLAG:住宿人物):現在位置 = SUMIKOMI_ROOM
Setting_CFLAG:(FLAG:住宿人物):后宫居住标记 = 1
CALL KOJO_MESSAGE_SEND("EVENT",19,RESULT,1,0)
IF HOUGONG && 人数 > 1
	PRINTFORML 是否继续同意剩下的人入住？
	CALL ASK_YN
	IF !RESULT
		人数 --
		GOTO HOUGONGLOOP
	ENDIF
ENDIF

CALL ROOMSETTING