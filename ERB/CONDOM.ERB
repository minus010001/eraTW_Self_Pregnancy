;-------------------------------------------------
;Condom state management helpers

;Purpose:
;Following the changes to condom behavior in April 2026 (added ゴム使用済み, having a filled condom now blocks certain actions)
;It became important to be able to conveniently manipulate multiple condom related flags

;Note:
;ゴム使用済み's purpose is worth thinking further, "ゴム内 > 1" might already serve its purpose
;but I wanted to seperate the logic and checks just in case we want to add a threshold to when a condom is considered as "used"
;-------------------------------------------------
@CONDOM_EQUIP(CHARA_ID, SKIP_CONSUME)
#DIM CHARA_ID
#DIM SKIP_CONSUME

;return -1 when character already has condom equipped
SIF TEQUIP:CHARA_ID:コンドーム
	RETURN -1
;return 0 when no condom in inventory
SIF !ITEM:コンドーム && !SKIP_CONSUME
	RETURN 0

SIF !SKIP_CONSUME
	ITEM:コンドーム --

TEQUIP:CHARA_ID:コンドーム = 1
TCVAR:CHARA_ID:コンドーム = 1
TCVAR:CHARA_ID:ゴム使用済み = 0
TCVAR:CHARA_ID:ゴム内 = 0
RETURN 1

;remove condom from character ARG and clear all condom state
@CONDOM_REMOVE(ARG)
TEQUIP:ARG:コンドーム = 0
TCVAR:ARG:コンドーム = 0
TCVAR:ARG:ゴム使用済み = 0
TCVAR:ARG:ゴム内 = 0

;mark condom on character as used
@CONDOM_MARK_USED(ARG, ARG:1)
TCVAR:ARG:ゴム使用済み = 1
TCVAR:ARG:ゴム内 = ARG:1

;empty semen from condom without removing it
@CONDOM_CLEAR(ARG)
TCVAR:ARG:ゴム使用済み = 0
TCVAR:ARG:ゴム内 = 0
