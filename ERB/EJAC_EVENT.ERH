;===============================================================
;EJACU_EVENT constants
;===============================================================
;---------------------------------------------------------------
;Bit-layout masks and shifts (57 bits used, 10-bit character fields)
;  [Flags 6][AuxInit 10][MainInit 10][AuxRecv 10][MainRecv 10][Loc 5][Ctx 6]
;    56-51     50-41       40-31     30-21         20-11    10-6   5-0
;---------------------------------------------------------------
#DIM CONST EJACU_CONTEXT_MASK         = 63
#DIM CONST EJACU_LOCATION_SHIFT       = 6
#DIM CONST EJACU_LOCATION_MASK        = 31
#DIM CONST EJACU_RECEIVER_SHIFT       = 11
#DIM CONST EJACU_RECEIVER_MASK        = 1023
#DIM CONST EJACU_AUX_RECEIVER_SHIFT   = 21
#DIM CONST EJACU_AUX_RECEIVER_MASK    = 1023
#DIM CONST EJACU_INITIATOR_SHIFT      = 31
#DIM CONST EJACU_INITIATOR_MASK       = 1023
#DIM CONST EJACU_AUX_INITIATOR_SHIFT  = 41
#DIM CONST EJACU_AUX_INITIATOR_MASK   = 1023
#DIM CONST EJACU_FLAGS_SHIFT          = 51
#DIM CONST EJACU_FLAGS_MASK           = 63

;Sentinels (10-bit character ID fields). 0 is MASTER, so sentinels live at the top
;Shared across fields that represent character IDs
#DIM CONST CHARA_NONE = 1023
#DIM CONST RECEIVER_ONAHOLE = 1022

;Slot indexes for the SLOT parameter on RECEIVER/INITIATOR functions
#DIM CONST EJACU_SLOT_MAIN = 0
#DIM CONST EJACU_SLOT_AUX = 1

;values should match TCVAR slot numbers
#DIM CONST EJACU_STORAGE_LIVE = 210
#DIM CONST EJACU_STORAGE_LAST = 211
#DIM CONST EJACU_STORAGE_PENDING = 212

;---------------------------------------------------------------
;Flag bits
;---------------------------------------------------------------
#DIM CONST 射精フラグ_コンドーム = 1

;---------------------------------------------------------------
;射精箇所, physical body-part location
;---------------------------------------------------------------
#DIM CONST EJACU_LOCATION_MIN = 1
#DIM CONST EJACU_LOCATION_MAX = 31
#DIM CONST 射精箇所_膣内 = 1
#DIM CONST 射精箇所_アナル = 2
#DIM CONST 射精箇所_手 = 3
#DIM CONST 射精箇所_口 = 4
#DIM CONST 射精箇所_胸 = 5
#DIM CONST 射精箇所_脚 = 6
#DIM CONST 射精箇所_足裏 = 7
#DIM CONST 射精箇所_体表 = 8
#DIM CONST 射精箇所_道具 = 9
#DIM CONST 射精箇所_脇コキ = 10
#DIM CONST 射精箇所_膣口 = 11

;---------------------------------------------------------------
;射精場合, context of the ejaculation
;---------------------------------------------------------------
#DIM CONST EJACU_CONTEXT_MIN = 32
#DIM CONST EJACU_CONTEXT_MAX = 63
#DIM CONST 射精場合_泡踊り = 32
#DIM CONST 射精場合_アナル奉仕 = 33
#DIM CONST 射精場合_道具 = 34
#DIM CONST 射精場合_Ａ責め = 35
#DIM CONST 射精場合_Ｖ責め = 36
#DIM CONST 射精場合_手淫フェラ = 37
#DIM CONST 射精場合_パイズリフェラ = 38
#DIM CONST 射精場合_シックスナイン = 39
#DIM CONST 射精場合_イラマチオ = 40
#DIM CONST 射精場合_子宮口責め = 41
#DIM CONST 射精場合_疑似 = 42
#DIM CONST 射精場合_授乳プレイ = 43
#DIM CONST 射精場合_約束破り = 44
#DIM CONST 射精場合_外出し成功 = 45
#DIM CONST 射精場合_二穴愛撫 = 46
