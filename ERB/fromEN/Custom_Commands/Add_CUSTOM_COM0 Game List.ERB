;=================================================
;通用计算函数
;=================================================
@ADD_GAME_DEFAULT_CALCULATION()
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC SKILL_VALUES, ADD_GAME_MAXIMUM_PARTICIPANTS
VARSET SKILL_VALUES
CALL ADD_GAME_DEFAULT_CALCULATION_WITH_VALUES(SKILL_VALUES)

@ADD_GAME_DEFAULT_CALCULATION_WITH_VALUES(SKILL_VALUES)
#LOCALSIZE 2
#LOCALSSIZE 1
#DIM REF SKILL_VALUES,
VARSET ADD_GAME_SCORES

FOR LOCAL, 0, ADD_GAME_PARTICIPANT_COUNT
	LOCAL:1 = CFLAG:(ADD_GAME_PARTICIPANTS:LOCAL):今日の運勢 + SKILL_VALUES:LOCAL
	SIF LOCAL:1 > 0
		ADD_GAME_SCORES:LOCAL = RAND:MAX(LOCAL:1,1)

	DEBUGPRINTFORML %CALLNAME:(ADD_GAME_PARTICIPANTS:LOCAL)%'s score: {ADD_GAME_SCORES:LOCAL} ({LOCAL:1} max).
NEXT

LOCAL:1 = MAXARRAY(ADD_GAME_SCORES, 0, ADD_GAME_PARTICIPANT_COUNT) ;highest
DEBUGPRINTFORML Winning score: {LOCAL:1}.
;handle duplicate scores
WHILE FINDELEMENT(ADD_GAME_SCORES, LOCAL:1, 0, ADD_GAME_PARTICIPANT_COUNT) != FINDLASTELEMENT(ADD_GAME_SCORES, LOCAL:1, 0, ADD_GAME_PARTICIPANT_COUNT)
	;fifty percent chance of being labelled the loser
	ADD_GAME_SCORES:(FINDELEMENT(ADD_GAME_SCORES, LOCAL:1, 0, ADD_GAME_PARTICIPANT_COUNT)) += (!RAND:2 ? 0 # -1)
WEND

FOR LOCAL, 0, ADD_GAME_PARTICIPANT_COUNT
	IF ADD_GAME_SCORES:LOCAL == LOCAL:1
		ADD_GAME_WINNERS:(ADD_GAME_WINNER_COUNT++) = ADD_GAME_PARTICIPANTS:LOCAL
	ELSE
 		ADD_GAME_LOSERS:(ADD_GAME_LOSER_COUNT++) = ADD_GAME_PARTICIPANTS:LOCAL
	ENDIF
NEXT

;=================================================
;赌注系统
;=================================================
@ADD_GAME_STANDARD_BETS
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTIONS
LOCALS = NONE/

SIF MONEY > ((ADD_GAME_PARTICIPANT_COUNT - 1) * 1000)
	LOCALS += "MONEY/"
SIF MONEY:2 > ((ADD_GAME_PARTICIPANT_COUNT - 1) * 10)
	LOCALS += "CHARISMA/"

RETURNF LOCALS

@ADD_GAME_BET_NAME(BET)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTIONS
#DIMS DYNAMIC BET
SELECTCASE BET
	CASE "NONE"
		RETURNF "不赌"
	CASE "MONEY"
		RETURNF @"%金額表示(1000)%"
	CASE "CHARISMA"
		RETURNF "10筹码"
	CASE "BIGMONEY"
		RETURNF @"%金額表示(20000)%"
	CASE "BIGCHARISMA"
		RETURNF "200筹码"
	CASE "LEWDACT"
		RETURNF "色色的事"
	CASE "DATE"
		RETURNF "约会"
	CASE "CHORES"
		RETURNF "家务"
	CASE "PANTIES"
		RETURNF "内裤"
	CASE "HANETSUKI"
		RETURNF "墨汁"
	CASE "HANETSUKI_LEWD"
		RETURNF "墨汁（色色版）"
ENDSELECT

@ADD_GAME_BET_MONEY
#LOCALSIZE 1
#LOCALSSIZE 1
PRINTFORML 按照约定，%ADD_GAME_LIST_NAMES(ADD_GAME_LOSERS)%\@ ADD_GAME_LOSER_COUNT > 1 ? 给 # 给 \@了%ADD_GAME_LIST_NAMES(ADD_GAME_WINNERS)%%金額表示(1000)%。
IF FINDELEMENT(ADD_GAME_LOSERS, MASTER) >= 0
	CALL LOST_MONEY_YEN(1000, 2)
ELSEIF FINDELEMENT(ADD_GAME_WINNERS, MASTER) >= 0
	CALL GET_MONEY_YEN(1000 * ADD_GAME_LOSER_COUNT / ADD_GAME_WINNER_COUNT, 2)
ENDIF

