;=================================================
;Game 1: 纸牌（Cards）
;=================================================
@FADD_GAME_INFO1(ARG, O_DATA)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTIONS
#DIMS DYNAMIC O_DATA

SELECTCASE O_DATA
	CASE "NAME"
		RETURNF "纸牌"
	CASE "DESCRIPTION"
		RETURNF "纸牌游戏"
	CASE "MINPLAYERS"
		RETURNF "2"
	CASE "MAXPLAYERS"
		RETURNF "4"
	CASE "CHECKREQUIREMENTS"
		SIF INROOM(CFLAG:MASTER:現在位置)
			RETURNF "1"
		RETURNF "0"
	CASE "VALIDBETS"
		RETURNF ADD_GAME_STANDARD_BETS()
	CASE "DURATION"
		RETURNF "30"
ENDSELECT
RETURNF ""

@ADD_GAME1
#LOCALSIZE 1
#LOCALSSIZE 1
PRINTFORML 你们%TOKANJI(ADD_GAME_PARTICIPANT_COUNT)%人玩了一局激烈的纸牌。
CALL ADD_GAME_DEFAULT_CALCULATION
PRINTFORML 经过一番激战，%ADD_GAME_LIST_NAMES(ADD_GAME_WINNERS)%获胜。

