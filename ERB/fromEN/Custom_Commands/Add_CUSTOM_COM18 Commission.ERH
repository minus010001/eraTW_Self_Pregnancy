	;The maximum number of commissions. This can be set to a higher number than the actual amount of commissions for the sake of breathing room.
#DIM CONST COMMISSION_MAX = 30
	;Tracks the progress of every commission from 0 to 1000 by its identification number.
	;0 is not started. 1000 is completed. Anything in between is in progress. A negative number means it is stalled.
#DIM SAVEDATA COMMISSION_PROGRESS, COMMISSION_MAX
	;The default progress, unmodified by events. Checked to ascertain if the project is on schedule.
#DIM SAVEDATA COMMISSION_EXPECTED_PROGRESS, COMMISSION_MAX
	;Tracks which character is assigned to each work by its identification number.
#DIM SAVEDATA COMMISSION_CHARACTER, COMMISSION_MAX