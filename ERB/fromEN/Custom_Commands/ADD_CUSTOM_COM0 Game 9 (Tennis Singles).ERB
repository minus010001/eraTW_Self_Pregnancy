;=================================================
;Game 9: 网球单打（Tennis Singles）
;仅在宴会21（网球俱乐部）中可用，需要TENNIS标志
;=================================================
@FADD_GAME_INFO9(ARG, O_DATA)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTIONS
#DIMS DYNAMIC O_DATA

SELECTCASE O_DATA
	CASE "NAME"
		RETURNF "网球（单打）"
	CASE "DESCRIPTION"
		RETURNF "网球单打比赛"
	CASE "MINPLAYERS"
		RETURNF "2"
	CASE "MAXPLAYERS"
		RETURNF "2"
	CASE "CHECKREQUIREMENTS"
        IF !ADD_BANQUET_ACTIVITY_ALLOWED("TENNIS",1)
        ELSEIF CFLAG:MASTER:現在位置 != CFLAG:ARG:現在位置 ;don't take from surrounding areas
        ELSEIF !((ADD_BANQUET_CHARA_STATE(ARG) && CFLAG:ARG:BANQUET_ROLE >= ADD_BANQUET_ROLE_GUEST) || ARG == FLAG:デート相手)
        ELSE
			RETURNF "1"
        ENDIF
		RETURNF "0"
	CASE "VALIDBETS"
		RETURNF ADD_GAME_STANDARD_BETS()
	CASE "DURATION"
		RETURNF "30"
ENDSELECT
RETURNF ""

@ADD_GAME9
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC SKILL_VALUES, 2
#DIM DYNAMIC TOTAL_SKILL
#DIM DYNAMIC SKILL_DIFFERENCE
#DIM DYNAMIC SCORE_DIFFERENCE
#DIM DYNAMIC DARK_HORSE_VICTORY
#DIMS DYNAMIC WINNER_NAME ;"你" if MASTER
#DIMS DYNAMIC LOSER_NAME ;"你" if MASTER

CALL ADD_BANQUET_SET_OUTFIT21(MASTER)
CALL ADD_BANQUET_SET_OUTFIT21(TARGET)

SKILL_VALUES:0 = ABL:MASTER:戦闘能力 * 200
SKILL_VALUES:1 = ABL:TARGET:戦闘能力 * 200
TOTAL_SKILL = SUMARRAY(SKILL_VALUES)
SKILL_DIFFERENCE = SKILL_VALUES:0 - SKILL_VALUES:1

PRINTFORML 你们%TOKANJI(ADD_GAME_PARTICIPANT_COUNT)%人打了一场网球。
CALL ADD_GAME_DEFAULT_CALCULATION_WITH_VALUES(SKILL_VALUES)

WINNER_NAME '= ADD_GAME_WINNERS:0 == MASTER ? "你" # CALLNAME:(ADD_GAME_WINNERS:0)
LOSER_NAME '= ADD_GAME_LOSERS:0 == MASTER ? "你" # CALLNAME:(ADD_GAME_LOSERS:0)
DARK_HORSE_VICTORY = (SKILL_VALUES:0 > SKILL_VALUES:1 && ADD_GAME_WINNERS:0 != MASTER) || (SKILL_VALUES:0 < SKILL_VALUES:1 && ADD_GAME_WINNERS:0 == MASTER)

IF TOTAL_SKILL < 600
    PRINTFORM 经过一场业余水准的比赛
    IF ABS(SKILL_DIFFERENCE) <= 200
        PRINTFORM ，双方势均力敌
    ELSE
        PRINTFORM ，%WINNER_NAME%在大部分时间里占据上风
    ENDIF
    PRINTFORML ，%WINNER_NAME%%COND_STR("出人意料地 ", DARK_HORSE_VICTORY)%获得了胜利。
ELSEIF ABS(SKILL_DIFFERENCE) >= 600
    IF DARK_HORSE_VICTORY
        PRINTFORML 尽管实力差距悬殊，%WINNER_NAME%还是漂亮地逆转击败了%LOSER_NAME%。
        SIF CFLAG:(ADD_GAME_LOSERS:0):今日の運勢 < 400
            PRINTFORML 也许今天就是\@ ADD_GAME_LOSERS:0 == MASTER ? 你的 # %HIS_HER(ADD_GAME_LOSERS:0)% \@倒霉日。
    ELSE
        PRINTFORML 不出所料，%WINNER_NAME%全程压制，轻松击败了%LOSER_NAME%。
    ENDIF
ELSEIF TOTAL_SKILL <= 2000
    PRINTFORML 比赛十分激烈，双方都全力以赴。
    IF ABS(SKILL_DIFFERENCE) <= 200
        PRINTFORML 两人旗鼓相当，但最终%WINNER_NAME%还是取得了优势，赢得了胜利。
    ELSEIF DARK_HORSE_VICTORY
        PRINTFORML 尽管%LOSER_NAME%占据优势，%WINNER_NAME%还是成功逆转了局面。
    ELSE
        PRINTFORML %WINNER_NAME%最终取得了上风，对%LOSER_NAME%确立了决定性的优势。
    ENDIF
ELSE
    PRINTFORML 这场两位高手之间的精彩对决吸引了网球场上所有人的目光。
    PRINTFORML 经过一番将双方逼至极限的激烈交锋，%WINNER_NAME%最终取得了决定性的优势，赢得了胜利。
    PRINTFORML 俱乐部成员们为这场精彩的比赛报以热烈的掌声。
ENDIF

;chance to proc red thread, somewhat better odds than through standard actions
SIF !RAND:3 && TARGET == FLAG:デート相手
    TRYCALL Add_RedThread
