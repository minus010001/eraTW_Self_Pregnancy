;titjob
@ADD_SEX_ACTION_1_9(ARG, MULTIPLIER)
#DIM MULTIPLIER
;-------------------------------------------------
;COM別FLAGの設定
;-------------------------------------------------
;行為者
TCVAR:ARG:116 = ARG
;奉仕快楽
TCVAR:ARG:108 = 1

; [EJACU_MIGRATION] Removed: CSTR:PLAYER:10 += @"{ARG}/"
CALL DECLARE_EJACULATION(PLAYER, 0, 射精箇所_体表, ARG, CHARA_NONE, ARG, CHARA_NONE, MULTIPLY(300, MULTIPLIER))

;-------------------------------------------------
;ソース追加処理
;-------------------------------------------------
;消費体力、気力
IF FLAG:70 == 1
	BASE:MASTER:TSP -= 40

	SOURCE:PLAYER:快Ｃ += MULTIPLY(20, MULTIPLIER)
	SIF CFLAG:妊娠経過日数 >= 30
		SOURCE:PLAYER:快Ｃ += MULTIPLY(CFLAG:妊娠経過日数 / 2, MULTIPLIER)
ELSE
	DOWNBASE:体力 += 20
	DOWNBASE:気力 += 20

	SOURCE:PLAYER:快Ｃ += MULTIPLY(40, MULTIPLIER)
	SIF CFLAG:妊娠経過日数 >= 30
		SOURCE:PLAYER:快Ｃ += MULTIPLY(CFLAG:妊娠経過日数, MULTIPLIER)
ENDIF
RETURN 1

@ADD_SEX_ABLE_1_9(ARG)
SIF !TFLAG:100
	RETURN 0
SIF !TARGET
    RETURN 0
SIF CFLAG:うふふ == 0
    RETURN 0
SIF !HAS_PENIS(PLAYER)
	RETURN 0
SIF !CHECK_CLO("belly_visible")
    RETURN 0
RETURN 1

@ADD_SEX_CAN_1_9()
ADD_SEX_MODULE_DIFFICULTY_TEMP += 20
ADD_SEX_MODULE_COM_ORDER_TEMP |= QOL_COM_ORDER_SERVICE_FULL | QOL_COM_ORDER_DIRT_SOURCE_PENIS
