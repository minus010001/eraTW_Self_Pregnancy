;=================================================
;Game 10: 网球双打（Tennis Doubles）
;仅在宴会21（网球俱乐部）中可用，需要TENNIS标志
;=================================================
@FADD_GAME_INFO10(ARG, O_DATA)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTIONS
#DIMS DYNAMIC O_DATA

SELECTCASE O_DATA
	CASE "NAME"
		RETURNF "网球（双打）"
	CASE "DESCRIPTION"
		RETURNF "四人网球双打比赛"
	CASE "MINPLAYERS"
		RETURNF "4"
	CASE "MAXPLAYERS"
		RETURNF "4"
	CASE "CHECKREQUIREMENTS"
        IF !ADD_BANQUET_ACTIVITY_ALLOWED("TENNIS",1)
        ELSEIF CFLAG:MASTER:現在位置 != CFLAG:ARG:現在位置 ;don't take from surrounding areas
        ELSEIF !((ADD_BANQUET_CHARA_STATE(ARG) && CFLAG:ARG:BANQUET_ROLE >= ADD_BANQUET_ROLE_GUEST) || ARG == FLAG:デート相手)
        ELSE
			RETURNF "1"
        ENDIF
		RETURNF "0"
	CASE "VALIDBETS"
		RETURNF ADD_GAME_STANDARD_BETS()
	CASE "DURATION"
		RETURNF "30"
ENDSELECT
RETURNF ""

@ADD_GAME10
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC YOUR_TEAM, 2
#DIM DYNAMIC OPPONENT_TEAM, 2
#DIM DYNAMIC PLAYER_SKILL
#DIM DYNAMIC OPPONENT_SKILL
#DIM DYNAMIC PLAYER_SCORE
#DIM DYNAMIC OPPONENT_SCORE
#DIM DYNAMIC PLAYER_AFFINITY
#DIM DYNAMIC OPPONENT_AFFINITY

YOUR_TEAM:0 = MASTER
IF FLAG:デート相手 ;date takes priority as player's partner
	YOUR_TEAM:1 = FLAG:デート相手
	FOR LOCAL, 1, ADD_GAME_PARTICIPANT_COUNT
		IF ADD_GAME_PARTICIPANTS:LOCAL != FLAG:デート相手
			ARRAYSHIFT OPPONENT_TEAM, 1, ADD_GAME_PARTICIPANTS:LOCAL
		ENDIF
	NEXT
ELSE ;random
	CALL FISHER_YATES_SHAFFLE(3)
	YOUR_TEAM:1 = ADD_GAME_PARTICIPANTS:(SHAFFLE_ARRAY:0 + 1)
	OPPONENT_TEAM:0 = ADD_GAME_PARTICIPANTS:(SHAFFLE_ARRAY:1 + 1)
	OPPONENT_TEAM:1 = ADD_GAME_PARTICIPANTS:(SHAFFLE_ARRAY:2 + 1)
ENDIF

CALL ADD_BANQUET_SET_OUTFIT21(MASTER)
CALL ADD_BANQUET_SET_OUTFIT21(YOUR_TEAM:1)

IF RELATION:MASTER:(YOUR_TEAM:1)
    IF RELATION:MASTER:(YOUR_TEAM:1) < 100
        PLAYER_AFFINITY = -((100-RELATION:MASTER:(YOUR_TEAM:1))*10)
    ELSE
        PLAYER_AFFINITY = RELATION:MASTER:(YOUR_TEAM:1) - 100 
    ENDIF
ENDIF

IF RELATION:(OPPONENT_TEAM:0):(OPPONENT_TEAM:1) || RELATION:(OPPONENT_TEAM:1):(OPPONENT_TEAM:0)
    IF MIN(RELATION:(OPPONENT_TEAM:0):(OPPONENT_TEAM:1), RELATION:(OPPONENT_TEAM:1):(OPPONENT_TEAM:0)) < 100
        OPPONENT_AFFINITY = -((MIN(RELATION:(OPPONENT_TEAM:0):(OPPONENT_TEAM:1), RELATION:(OPPONENT_TEAM:1):(OPPONENT_TEAM:0)))*10)
    ELSE
        OPPONENT_AFFINITY = MIN(RELATION:(OPPONENT_TEAM:0):(OPPONENT_TEAM:1), RELATION:(OPPONENT_TEAM:1):(OPPONENT_TEAM:0)) - 100
    ENDIF
ENDIF

PRINTFORML 你和%CALLNAME:(YOUR_TEAM:1)%对阵%CALLNAME:(OPPONENT_TEAM:0)%和%CALLNAME:(OPPONENT_TEAM:1)%。

;calculation is mostly based on combat and affinity, with some luck
PLAYER_SKILL += MAX(ABL:(YOUR_TEAM:0):戦闘能力 * 100 + CFLAG:(YOUR_TEAM:0):今日の運勢 / 2, 0)
PLAYER_SKILL += MAX(ABL:(YOUR_TEAM:1):戦闘能力 * 100 + CFLAG:(YOUR_TEAM:1):今日の運勢 / 2, 0)
PLAYER_SKILL += PLAYER_AFFINITY

OPPONENT_SKILL += MAX(ABL:(OPPONENT_TEAM:0):戦闘能力 * 100 + CFLAG:(OPPONENT_TEAM:0):今日の運勢 / 2, 0)
OPPONENT_SKILL += MAX(ABL:(OPPONENT_TEAM:1):戦闘能力 * 100 + CFLAG:(OPPONENT_TEAM:1):今日の運勢 / 2, 0)
OPPONENT_SKILL += OPPONENT_AFFINITY

PLAYER_SCORE = RAND:MAX(PLAYER_SKILL,1)
OPPONENT_SCORE = RAND:MAX(OPPONENT_SKILL,1)

SIF PLAYER_SCORE == OPPONENT_SCORE
    PLAYER_SCORE++

IF PLAYER_SCORE > OPPONENT_SCORE
    IF RELATION:MASTER:(YOUR_TEAM:1) == 1000
        PRINTFORML 你和%CALLNAME:(YOUR_TEAM:1)%配合得天衣无缝，在球场上翩翩起舞，完美地弥补了彼此的盲区。
        PRINTFORML 你们的默契简直令人感动落泪。
        PRINTFORML %CALLNAME:(OPPONENT_TEAM:0)%和%CALLNAME:(OPPONENT_TEAM:1)%被彻底击败，只能在目睹这般神迹后灰溜溜地离开。
    ELSEIF RELATION:MASTER:(YOUR_TEAM:1) > 100
        PRINTFORML 你和%CALLNAME:(YOUR_TEAM:1)%出色的配合让你们在场上游刃有余，轻松击败了%CALLNAME:(OPPONENT_TEAM:0)%和%CALLNAME:(OPPONENT_TEAM:1)%。
    ELSEIF INRANGE(RELATION:MASTER:(YOUR_TEAM:1), 1, 99)
        IF OPPONENT_AFFINITY > 0
            PRINTFORML 尽管和%CALLNAME:(YOUR_TEAM:1)%配合有些困难，你们还是凭借个人实力克服了对手的默契配合。
        ELSE
            PRINTFORML 尽管和%CALLNAME:(YOUR_TEAM:1)%配合有些困难，你们还是凭借实力压制了对手，取得了胜利。
        ENDIF
    ELSE
        SELECTCASE ABS(PLAYER_SCORE - OPPONENT_SCORE)
            CASE IS <= 100
                PRINTFORML 比赛十分胶着，但最终你和%CALLNAME:(YOUR_TEAM:1)%还是赢得了胜利。
            CASE IS <= 400
                PRINTFORML 全程占据优势，你和%CALLNAME:(YOUR_TEAM:1)%轻松取胜。
            CASEELSE
                PRINTFORML 你和%CALLNAME:(YOUR_TEAM:1)%全程碾压，彻底击溃了%CALLNAME:(OPPONENT_TEAM:0)%和%CALLNAME:(OPPONENT_TEAM:1)%。
        ENDSELECT
    ENDIF

	ADD_GAME_WINNERS:0 = YOUR_TEAM:0
	ADD_GAME_WINNERS:1 = YOUR_TEAM:1
	ADD_GAME_LOSERS:0 = OPPONENT_TEAM:0
	ADD_GAME_LOSERS:1 = OPPONENT_TEAM:1
	ADD_GAME_LOSER_COUNT = 2
	ADD_GAME_WINNER_COUNT = 2
ELSEIF OPPONENT_SCORE > PLAYER_SCORE
    IF OPPONENT_AFFINITY > 0
        PRINTFORML %CALLNAME:(OPPONENT_TEAM:0)%和%CALLNAME:(OPPONENT_TEAM:1)%出色的配合让你们无法招架，你和%CALLNAME:(YOUR_TEAM:1)%败下阵来。
    ELSE
        SELECTCASE ABS(PLAYER_SCORE - OPPONENT_SCORE)
            CASE IS <= 100
                PRINTFORML 双方势均力敌，但%CALLNAME:(OPPONENT_TEAM:0)%和%CALLNAME:(OPPONENT_TEAM:1)%最终取得了优势，赢得了比赛。
            CASE IS <= 400
                PRINTFORML %CALLNAME:(OPPONENT_TEAM:0)%和%CALLNAME:(OPPONENT_TEAM:1)%展现出了强大的实力，最终获胜。
            CASEELSE
                PRINTFORML 完全跟不上%CALLNAME:(OPPONENT_TEAM:0)%和%CALLNAME:(OPPONENT_TEAM:1)%的节奏，你们遭遇了惨败。
        ENDSELECT
    ENDIF

	ADD_GAME_WINNERS:0 = OPPONENT_TEAM:0
	ADD_GAME_WINNERS:1 = OPPONENT_TEAM:1
	ADD_GAME_LOSERS:0 = YOUR_TEAM:0
	ADD_GAME_LOSERS:1 = YOUR_TEAM:1
	ADD_GAME_LOSER_COUNT = 2
	ADD_GAME_WINNER_COUNT = 2
ENDIF

;chance to proc red thread, somewhat better odds than through standard actions
IF !RAND:3 && YOUR_TEAM:1 == FLAG:デート相手
    LOCAL = TARGET
    TARGET = YOUR_TEAM:1
    TRYCALL Add_RedThread
    TARGET = LOCAL
ENDIF
