;Cum Outside
@ADD_CUSTOM_SCOM15

TCVAR:116 = PLAYER
;奉仕快楽フラグ
TCVAR:PLAYER:108 = 1

TCVAR:PLAYER:童貞喪失 = 1
;強度
TCVAR:PLAYER:射精快感強度 = 300
CALL DECLARE_EJACULATION(PLAYER, 0, 射精箇所_体表, TARGET, CHARA_NONE, TARGET, CHARA_NONE, 300)

;強度
TCVAR:TARGET:射精快感強度 = 300
CALL DECLARE_EJACULATION(TARGET, 0, 射精箇所_体表, PLAYER, CHARA_NONE, PLAYER, CHARA_NONE, 300)

DOWNBASE:PLAYER:体力 += 30
DOWNBASE:PLAYER:気力 += 30

RETURN 1

@ADD_CUSTOM_SCOM_ABLE15
;交互挿入
SIF !TFLAG:100
	RETURN 0
SIF !TARGET
    RETURN 0
SIF CFLAG:うふふ == 0
    RETURN 0
SIF ADD_CHARA_WHO_TOUCHING(TARGET, SET_V, SET_P, 1) != PLAYER && ADD_CHARA_WHO_TOUCHING(TARGET, SET_A, SET_P, 1) != PLAYER
    RETURN 0
SIF !TCVAR:PLAYER:イきそう
	RETURN 0

RETURN 1

@ADD_CUSTOM_MESSAGE_SCOM15
PRINTFORMDL %CALLNAME:MASTER%在射精前拔出%TINKO(PLAYER,0)%，将火热的精液射在%CALLNAME:TARGET%身上。
