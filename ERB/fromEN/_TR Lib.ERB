@GET_DAY_TR(ARG)
#FUNCTIONS
#DIMS CONST YOUBI = "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"
SIF !ARG
	ARG = DAY
RETURNF YOUBI:(ARG % 7)


