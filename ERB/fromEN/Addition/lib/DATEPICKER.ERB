@DATEPICKER(SELECTED_VALUE = -1, MIN_VALUE = 1, MAX_VALUE = 9223372036854775)
#LOCALSIZE 2
#LOCALSSIZE 1
#DIM DYNAMIC SELECTED_VALUE
#DIM DYNAMIC MIN_VALUE
#DIM DYNAMIC MAX_VALUE
#DIM DYNAMIC ACTIVE_DAY
#DIM DYNAMIC ACTIVE_YEAR
#DIM DYNAMIC ACTIVE_MONTH
#DIM DYNAMIC ACTIVE_DAY_OF_MONTH
#DIM DYNAMIC FIRST_LINE
#DIM DYNAMIC WIDTH_PER_VALUE
#DIM DYNAMIC LINE_WIDTH
#DIM DYNAMIC FIRST_VISIBLE_DAY
#DIM DYNAMIC LAST_VISIBLE_DAY  
#DIMS DYNAMIC YEAR_TEXT
#DIMS DYNAMIC MONTH_TEXT
#DIM DYNAMIC BUTTON_SPACE
#DIM DYNAMIC RENDERING_DAY
#DIM DYNAMIC ROW_COUNT
#DIM DYNAMIC MIN_ACTIVE_DAY
#DIM DYNAMIC MAX_ACTIVE_DAY

RESETCOLOR
MIN_ACTIVE_DAY = MIN_VALUE - (DAY_TO_DATE(MIN_VALUE) % 1000 % 100 - 1)
MAX_ACTIVE_DAY = MAX_VALUE - (DAY_TO_DATE(MAX_VALUE) % 1000 % 100 - 1)

IF SELECTED_VALUE > 0
    ACTIVE_DAY = SELECTED_VALUE
ELSE
    ACTIVE_DAY = MAX(DAY, MIN_ACTIVE_DAY)
ENDIF
LOCAL = DAY_TO_DATE(ACTIVE_DAY)
ACTIVE_DAY_OF_MONTH = LOCAL % 1000 % 100
ACTIVE_DAY = ACTIVE_DAY - (ACTIVE_DAY_OF_MONTH - 1)
;active day should always be the first of the month and drive the calculations

FIRST_LINE = LINECOUNT
$DRAWCALENDAR
LOCAL = DAY_TO_DATE(ACTIVE_DAY)
ACTIVE_YEAR = LOCAL / 1000
ACTIVE_MONTH = LOCAL % 1000 / 100
ACTIVE_DAY_OF_MONTH = LOCAL % 1000 % 100

FIRST_VISIBLE_DAY = ACTIVE_DAY - ACTIVE_DAY % 7
LAST_VISIBLE_DAY = ACTIVE_DAY + 31 + (6 - (ACTIVE_DAY + 31) % 7)
ROW_COUNT = ((LAST_VISIBLE_DAY - FIRST_VISIBLE_DAY) / 7) + 1

WIDTH_PER_VALUE = 2

LINE_WIDTH = WIDTH_PER_VALUE * 7 + 6

YEAR_TEXT '= @"年: {ACTIVE_YEAR}"
SIF STRLENS(YEAR_TEXT) % 2 == 1
    YEAR_TEXT '= @" %YEAR_TEXT%"
MONTH_TEXT '= GET_MONTH(ACTIVE_MONTH, 1)
SIF STRLENS(MONTH_TEXT) % 2 == 1
    MONTH_TEXT '= @" %YEAR_TEXT%"

CLEARLINE LINECOUNT - FIRST_LINE
REDRAW 0

;draw block
PRINTFORMDL ┌%"─"*LINE_WIDTH%┐
;year
BUTTON_SPACE = ((LINE_WIDTH * 2 - STRLENS(YEAR_TEXT)) / 2) - 1
PRINTFORMD ｜

IF ACTIVE_DAY <= MIN_ACTIVE_DAY
    SETCOLOR C_GRAY
ELSE
    RESETCOLOR
ENDIF
PRINTBUTTON @"%" "*(BUTTON_SPACE/2)%◁%" "*(BUTTON_SPACE-(BUTTON_SPACE/2))%", -1
PRINTFORMD %YEAR_TEXT%
IF ACTIVE_DAY >= MAX_ACTIVE_DAY
    SETCOLOR C_GRAY
ELSE
    RESETCOLOR
ENDIF
PRINTBUTTON @"%" "*(BUTTON_SPACE-(BUTTON_SPACE/2))%▷%" "*(BUTTON_SPACE/2)%", -2
PRINTFORMDL ｜
;month
BUTTON_SPACE = ((LINE_WIDTH * 2 - STRLENS(MONTH_TEXT)) / 2) - 1
PRINTFORMD ｜
IF ACTIVE_DAY <= MIN_ACTIVE_DAY
    SETCOLOR C_GRAY
ELSE
    RESETCOLOR
ENDIF
PRINTBUTTON @"%" "*(BUTTON_SPACE/2)%◁%" "*(BUTTON_SPACE-(BUTTON_SPACE/2))%", -3
PRINTFORMD %MONTH_TEXT%
IF ACTIVE_DAY >= MAX_ACTIVE_DAY
    SETCOLOR C_GRAY
ELSE
    RESETCOLOR
ENDIF
PRINTBUTTON @"%" "*(BUTTON_SPACE-(BUTTON_SPACE/2))%▷%" "*(BUTTON_SPACE/2)%", -4
PRINTFORMDL ｜

PRINTFORMD ┝
REPEAT 7
    PRINTFORMD %"━"*WIDTH_PER_VALUE%
    SIF COUNT < 6
        PRINTFORMD ┯
REND
PRINTFORMDL ┥

PRINTFORMD ｜
FOR LOCAL, 1, 8
    LOCALS '= GET_DAY_CN(LOCAL)
    IF LOCAL == 7
        SETCOLOR C_FLAME
    ELSEIF LOCAL == 6
        SETCOLOR C_BLUE
    ELSE
        SETCOLOR C_AQUA
    ENDIF
    PRINTFORM %LOCALS, 4, LEFT%
    SIF LOCAL < 7
        PRINTFORMD ｜
NEXT
PRINTFORMDL ｜
PRINTFORMD ┝
REPEAT 7
    PRINTFORMD %"━"*WIDTH_PER_VALUE%
    SIF COUNT < 6
        PRINTFORMD ┿
REND
PRINTFORMDL ┥

;days
RENDERING_DAY = FIRST_VISIBLE_DAY

REPEAT ROW_COUNT
    PRINTFORMD ｜
    FOR LOCAL, 1, 8
        IF RENDERING_DAY < 1
            PRINTBUTTON @"%" " * (WIDTH_PER_VALUE * 2)%", -100
        ELSE
            LOCAL:1 = DAY_TO_DATE(RENDERING_DAY) % 1000 % 100
            LOCALS '= @" {LOCAL:1} "
            SIF LOCAL:1 < 10
                LOCALS '= @" %LOCALS%"

            IF RENDERING_DAY < MIN_VALUE || RENDERING_DAY > MAX_VALUE
                SETCOLOR C_GRAY
            ELSEIF RENDERING_DAY < ACTIVE_DAY || RENDERING_DAY >= ACTIVE_DAY + 31
                SETCOLOR C_L_GRAY
            ELSEIF RENDERING_DAY == SELECTED_VALUE
                SETCOLOR C_GREEN
            ELSEIF RENDERING_DAY == DAY
                SETCOLOR C_ORANGE
            ELSE
                RESETCOLOR
            ENDIF

            PRINTBUTTON LOCALS, RENDERING_DAY
        ENDIF
        RENDERING_DAY++
        PRINTFORMD ｜
    NEXT
    PRINTL

    IF COUNT < ROW_COUNT - 1
        PRINTFORMD ├

        FOR LOCAL, 0, 7
            PRINTFORMD %"─"*WIDTH_PER_VALUE%
            SIF LOCAL < 6
                PRINTFORMD ┼
        NEXT

        PRINTFORMDL ┤
    ENDIF
REND

PRINTFORMD └
REPEAT 7
    PRINTFORMD ──
    SIF COUNT < 6
        PRINTFORMD ┴
REND

PRINTFORMDL ┘

IF ROW_COUNT < 6
    PRINTL
    PRINTL
ENDIF

RESETCOLOR
PRINTBUTTON "退出", -5
PRINTL

$INPUT_LOOP
INPUT
LOCAL = RESULT
IF LOCAL == -1 ;-1 year
    IF ACTIVE_DAY - 124 <= MIN_ACTIVE_DAY
        ACTIVE_DAY = MIN_ACTIVE_DAY
    ELSE
        ACTIVE_DAY -= 124
    ENDIF
    CLEARLINE 1
    GOTO DRAWCALENDAR
ELSEIF LOCAL == -2 ;+1 year
    IF ACTIVE_DAY + 124 >= MAX_ACTIVE_DAY
        ACTIVE_DAY = MAX_ACTIVE_DAY
    ELSE
        ACTIVE_DAY += 124
    ENDIF
    CLEARLINE 1
    GOTO DRAWCALENDAR
ELSEIF LOCAL == -3 ;-1 month
    IF ACTIVE_DAY - 31 <= MIN_ACTIVE_DAY
        ACTIVE_DAY = MIN_ACTIVE_DAY
    ELSE
        ACTIVE_DAY -= 31
    ENDIF
    CLEARLINE 1
    GOTO DRAWCALENDAR
ELSEIF LOCAL == -4 ;+1 month
    IF ACTIVE_DAY + 31 >= MAX_ACTIVE_DAY
        ACTIVE_DAY = MAX_ACTIVE_DAY
    ELSE
        ACTIVE_DAY += 31
    ENDIF
    CLEARLINE 1
    GOTO DRAWCALENDAR
ELSEIF LOCAL == -5 ;quit
    RETURN SELECTED_VALUE
ELSEIF LOCAL <= 0 ;do nothing
    CLEARLINE 1
    GOTO INPUT_LOOP
ELSEIF LOCAL < MIN_VALUE || LOCAL > MAX_VALUE
    CLEARLINE 1
    IF MAX_VALUE < __INT_MAX__
        REUSELASTLINE 必须在%PRINT_DATE_F(MIN_VALUE,1)%和%PRINT_DATE_F(MAX_VALUE,1)%之间
    ELSE
        REUSELASTLINE 必须在%PRINT_DATE_F(MIN_VALUE,1)%之后。
    ENDIF
    GOTO INPUT_LOOP
ELSE
    CLEARLINE 1
    RETURN LOCAL
ENDIF
