@FADD_BANQUET8(ARG, O_DATA)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTIONS
#DIMS DYNAMIC O_DATA

SELECTCASE O_DATA
    CASE "NAME"
        RETURNF "住所不定者的集会"
    CASE "ACTIVITIES"
        RETURNF "饮酒聊天"
    CASE "TERM"
        RETURNF "宴会"
    CASE "CATEGORY"
        RETURNF "宴会"
    CASE "PRIORITY"
        RETURNF "3"
    CASE "HOST"
        RETURNF @"{ADD_BANQUET_8_HOST()}"
    CASE "HOST_LIST"
        RETURNF @"{[[菫子]]}"
    CASE "GUEST_LIST"
        RETURNF ""
    CASE "BANNED_LIST"
        RETURNF @"{[[正邪]]}"
    CASE "CONDITIONS"
        SIF CFLAG:[[菫子]]:出禁 == 0 && DAY:3 == 10 && DAY:2 != 4
            RETURNF "1"
        RETURNF "0"
    CASE "WEATHER_DEPENDENT"
        RETURNF "1"
    CASE "ALTERNATIVE_INDOOR_LOCATION"
        RETURNF @"{P933酒場}"
    CASE "DRINKING"
        RETURNF "1"
    CASE "MUSIC_PERFORMANCE"
        RETURNF "1"
ENDSELECT
RETURNF ""

@ADD_BANQUET_PLANNING8
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC LOCATION
#DIM DYNAMIC SCALE
#DIM DYNAMIC START_TIME

LOCATION = P708大蝦蟇の池

SCALE = 1000 + RAND:1500
START_TIME = CLOCK_TO_TIME(15, 0)

CALL ADD_BANQUET_CREATE(8, LOCATION, START_TIME, DAY+3, (SCALE / 10) + 300, SCALE)
LOCAL = RESULT

SIF LOCAL < 0
    RETURN

ADD_BANQUETS_INVITED:LOCAL = ADD_BANQUET_INVITE_INVITED
PRINTL
PRINTFORML 似乎是些没有固定住处的人聚在一起开宴会。
PRINTFORML 平时不太见到的面孔大概也会出现吧
PRINTFORMW 不过据说下雨就取消……
CALL ADD_BANQUET_DRINKING_INITIALIZATION_DESCRIPTION(LOCAL)

@ADD_BANQUET_START8
#LOCALSIZE 1
#LOCALSSIZE 1
CALL ADD_BANQUET_DRESS_UP(8)

@ADD_BANQUET_FINISH8
#LOCALSIZE 1
#LOCALSSIZE 1
CALL ADD_BANQUET_DRESS_DOWN(8)

@ADD_BANQUET_VISIT8(PREVIOUS_STATE)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC PREVIOUS_STATE
CALL ADD_BANQUET_DRINKING_VISIT(PREVIOUS_STATE, ADD_BANQUET_INDEX(8))

@ADD_BANQUET_PROGRESS8(BANQUET_INDEX)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC BANQUET_INDEX
CALL ADD_BANQUET_DRINKING_PROGRESS(BANQUET_INDEX)

@ADD_BANQUET_PREPARATION_TEXT8(CHARA, LOCATION)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC CHARA
#DIM DYNAMIC LOCATION
CALL ADD_BANQUET_DRINKING_PREPARATION_TEXT(CHARA, LOCATION)

@ADD_BANQUET_JOIN_TEXT8(CHARA, LOCATION)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC CHARA
#DIM DYNAMIC LOCATION
CALL ADD_BANQUET_DRINKING_JOIN_TEXT(CHARA, LOCATION)

@ADD_BANQUET_SET_PARTICIPANTS8
#LOCALSIZE 2
#LOCALSSIZE 1
#DIM DYNAMIC BANQUET_INDEX
#DIM DYNAMIC BANQUET_SCALE
BANQUET_INDEX = ADD_BANQUET_INDEX(8)
BANQUET_SCALE = ADD_BANQUETS_SCALE:BANQUET_INDEX

CALL ADD_BANQUET_FILL_PARTICIPANTS(BANQUET_INDEX, 0, 0)

LOCAL = 0
FOR LOCAL:1, 1, CHARANUM
    SIF CFLAG:(LOCAL:1):BANQUET == ADD_BANQUETS_UPCOMING:BANQUET_INDEX
        LOCAL++
NEXT
IF LOCAL < 8
    ADD_BANQUETS_STATUS:BANQUET_INDEX = ADD_BANQUET_STATE_CANCELLED
    PRINTFORML 参加者不足，住所不定者的集会取消了……
ENDIF

@ADD_BANQUET_PARTICIPANT_JOIN_CHECK8(ARG)
#LOCALSIZE 1
#LOCALSSIZE 1
;住所不定キャラは全員参加
IF CFLAG:ARG:自宅位置 == 0
	RETURN 1
ENDIF
;部外者も少し来る（旧版 ARGRESIDENT=3, ARGVISITOR=3）
RETURN RAND:100 < 3

@ADD_BANQUET_WORKLOAD_PREPARATION8(ARG)
#LOCALSIZE 1
#LOCALSSIZE 1
CALL ADD_BANQUET_DRINKING_PREPARATION_WORKLOAD(ARG, ADD_BANQUET_INDEX(8))

@ADD_BANQUET_WORKLOAD_PARTICIPATION8(ARG, SCALE)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC SCALE
CALL ADD_BANQUET_DRINKING_WORKLOAD(ARG, SCALE)

@ADD_BANQUET_MESSAGE_TALK8
#LOCALSIZE 1
#LOCALSSIZE 1
CALL ADD_BANQUET_DRINKING_MESSAGE_TALK(ADD_BANQUET_INDEX(8))

@ADD_BANQUET_8_HOST()
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTION
IF !CFLAG:[[菫子]]:出禁
    RETURNF [[菫子]]
ENDIF
FOR LOCAL, 1, CHARANUM
    SIF CFLAG:LOCAL:出禁
        CONTINUE
    SIF CFLAG:LOCAL:自宅位置 != 0
        CONTINUE
    RETURNF LOCAL
NEXT
