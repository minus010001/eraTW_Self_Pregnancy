@FADD_BANQUET31(ARG, O_DATA)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTIONS
#DIMS DYNAMIC O_DATA

SELECTCASE O_DATA
	CASE "NAME"
		RETURNF "婚礼宴会"
	CASE "ACTIVITIES"
		RETURNF "庆祝结婚"
	CASE "TERM"
		RETURNF "宴会"
	CASE "PRIORITY"
		RETURNF "1"
	CASE "HOST"
		RETURNF @"{MASTER}"
	CASE "HOST_LIST"
		LOCALS '= @"{MASTER}/{LEGAL_SPOUSE}/"
		SIF WEDDING_OFFICIANT_ID > 0
			LOCALS += @"{WEDDING_OFFICIANT_ID}/"
		RETURNF LOCALS
	CASE "GUEST_LIST"
		LOCALS '= ""
		FOR LOCAL, 1, CHARANUM
			SIF WEDDING_GUESTS:LOCAL
				LOCALS += @"{LOCAL}/"
		NEXT
		RETURNF LOCALS
	CASE "BANNED_LIST"
		RETURNF ""
	CASE "CONDITIONS"
		SIF WEDDING_PLANNING_COMPLETE
			RETURNF "1"
		RETURNF "0"
	CASE "WEATHER_DEPENDENT"
		RETURNF "0"
	CASE "DRINKING"
		RETURNF "1"
	CASE "MUSIC_PERFORMANCE"
		RETURNF "1"
	CASE "KEEP_AWAKE"
		RETURNF "1"
ENDSELECT
RETURNF ""

@ADD_BANQUET_PLANNING31
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC LOCATION
#DIM DYNAMIC SCALE
#DIM DYNAMIC START_TIME

LOCATION = WEDDING_LOCATION

SCALE = SUMARRAY(WEDDING_GUESTS) * 100
START_TIME = WEDDING_TIME + 180

CALL ADD_BANQUET_CREATE(31, LOCATION, START_TIME, WEDDING_DATE, 300, SCALE)
LOCAL = RESULT

SIF LOCAL < 0
	RETURN

ADD_BANQUETS_INVITED:LOCAL = 1

