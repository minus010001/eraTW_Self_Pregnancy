@FADD_BANQUET1(ARG, O_DATA)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTIONS
#DIMS DYNAMIC O_DATA

SELECTCASE O_DATA
	CASE "NAME"
		RETURNF "灵梦一时兴起的酒宴"
	CASE "ACTIVITIES"
		RETURNF "饮酒聊天"
	CASE "TERM"
		RETURNF "宴会"
	CASE "CATEGORY"
		RETURNF "宴会"
	CASE "PRIORITY"
		RETURNF "3"
	CASE "NOTIFY_PLAYER"
		RETURNF "1"
	CASE "HOST"
		RETURNF @"{[[霊夢]]}"
	CASE "HOST_LIST"
		RETURNF @"{[[霊夢]]}/{[[る～こと]]}/{[[魔理沙]]}"
	CASE "GUEST_LIST"
		RETURNF @"{[[萃香]]}"
	CASE "BANNED_LIST"
		RETURNF @"{[[正邪]]}"
	CASE "CONDITIONS"
		SIF CFLAG:1:出禁 == 0 && DAY%7 == 6 && !(DAY:2 == 4 && DAY:3 > 25) && RAND:100 <= 40
			RETURNF "1"
		RETURNF "0"
	CASE "WEATHER_DEPENDENT"
		RETURNF "1"
	CASE "DRINKING"
		RETURNF "1"
	CASE "MUSIC_PERFORMANCE"
		RETURNF "1"
	CASE "ALTERNATIVE_INDOOR_LOCATION"
		RETURNF @"{P9居間}"
ENDSELECT
RETURNF ""

@ADD_BANQUET_PLANNING1
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC LOCATION
#DIM DYNAMIC SCALE
#DIM DYNAMIC START_TIME

SELECTCASE RAND:19
    CASE IS < 15
        LOCATION = P11庭
    CASE 15
        LOCATION = P2境内
    CASE 16
        LOCATION = P20本殿の裏
    CASE 17
        LOCATION = P21守矢神社分社
    CASEELSE
        LOCATION = P218小料理屋

ENDSELECT

SCALE = 1000 + RAND:1500
START_TIME = 1360 - (SCALE / 10)

CALL ADD_BANQUET_CREATE(1, LOCATION, START_TIME, DAY+1, (SCALE / 10) + 300, SCALE)
LOCAL = RESULT ;banquet_index

SIF LOCAL < 0 ;couldn't create
    RETURN

ADD_BANQUETS_INVITED:LOCAL = ADD_BANQUET_INVITE_INVITED
PRINTL  
PRINTFORMW %CALLNAME:[[霊夢]]%一时兴起要办宴会了
PRINTFORML 

CALL ADD_BANQUET_DRINKING_INITIALIZATION_DESCRIPTION(LOCAL)

