@FADD_BANQUET23(ARG, O_DATA)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTIONS
#DIMS DYNAMIC O_DATA

SELECTCASE O_DATA
	CASE "NAME"
		RETURNF "月兔祭"
	CASE "ACTIVITIES"
		RETURNF "捣年糕唱歌"
	CASE "TERM"
		RETURNF "月兔祭"
	CASE "CATEGORY"
		RETURNF "祭典"
	CASE "PRIORITY"
		RETURNF "3"
	CASE "HOST"
		RETURNF @"{[[てゐ]]}"
	CASE "HOST_LIST"
		RETURNF @"{[[てゐ]]}/{[[鈴仙]]}"
	CASE "GUEST_LIST"
		RETURNF ""
	CASE "BANNED_LIST"
		RETURNF ""
	CASE "CONDITIONS"
		IF DAY:2 != 3
			SIF INRANGE(DAY:3,10,14)
				RETURNF "1"
		ENDIF
		RETURNF "0"
	CASE "WEATHER_DEPENDENT"
		RETURNF "1"
	CASE "ALTERNATIVE_INDOOR_LOCATION"
		RETURNF @"{P415広間}"
ENDSELECT
RETURNF ""

@ADD_BANQUET_PLANNING23
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC LOCATION
#DIM DYNAMIC SCALE
#DIM DYNAMIC START_TIME
#DIM DYNAMIC END_TIME

LOCATION = P431兎の洞穴

SCALE = 2000
START_TIME = CLOCK_TO_TIME(19, 0)

CALL ADD_BANQUET_CREATE(23, LOCATION, START_TIME, DAY + 15 - DAY:3, 180, SCALE)
LOCAL = RESULT ;banquet_index

SIF LOCAL < 0 ;couldn't create
    RETURN
;no invitation
@ADD_BANQUET_START23
#LOCALSIZE 1
#LOCALSSIZE 1
CALL ADD_BANQUET_DRESS_UP(23)

@ADD_BANQUET_FINISH23
#LOCALSIZE 1
#LOCALSSIZE 1
CALL ADD_BANQUET_DRESS_DOWN(23)
;tewi doesn't do cleanup
CFLAG:[[てゐ]]:BANQUET_ROLE = 1

@ADD_BANQUET_VISIT23(PREVIOUS_STATE)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC PREVIOUS_STATE
#DIM DYNAMIC BANQUET_INDEX
#DIM DYNAMIC CURRENT_STATE
#DIM DYNAMIC PARTICIPANTS
BANQUET_INDEX = ADD_BANQUET_INDEX(23)
PARTICIPANTS = ADD_BANQUET_PARTICIPANT_COUNT(BANQUET_INDEX)
CURRENT_STATE = ADD_BANQUETS_STATUS:BANQUET_INDEX

IF CURRENT_STATE == ADD_BANQUET_STATE_IN_PROGRESS && PREVIOUS_STATE == ADD_BANQUET_STATE_PREPARING ;player was present during start
    PRINTFORML 
    PRINTFORML 因幡兔们开始了每月的祭典。
    PRINTFORML 
ELSEIF CURRENT_STATE == ADD_BANQUET_STATE_IN_PROGRESS ;joins later
    PRINTL  
    PRINTW 因幡兔们已经在忙活了。
    PRINTL  
ENDIF

@ADD_BANQUET_PROGRESS23(BANQUET_INDEX)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC BANQUET_INDEX
#DIM DYNAMIC BANQUET_ID
#DIM DYNAMIC PRESENT
#DIM DYNAMIC LAPSE
#DIM DYNAMIC VERSE

BANQUET_ID = ADD_BANQUETS_UPCOMING:BANQUET_INDEX
;if master at location
PRESENT = CFLAG:MASTER:現在位置 == GET_MAP_REPLACEMENT(ADD_BANQUETS_LOCATION:BANQUET_INDEX)
LAPSE = TIME_PROGRESS(TIME:1)

SELECTCASE ADD_BANQUETS_STATUS:BANQUET_INDEX
    CASE ADD_BANQUET_STATE_IN_PROGRESS
        FOR LOCAL, 1, CHARANUM
            IF CFLAG:LOCAL:BANQUET == BANQUET_ID
                IF CFLAG:LOCAL:行動 == 5
                    BASE:LOCAL:仕事量 = MAX(BASE:LOCAL:仕事量 - LAPSE * 10, 0)
                    SIF CFLAG:LOCAL:BANQUET_ROLE < ADD_BANQUET_ROLE_HOST && (BASE:LOCAL:仕事量 == 0 || CFLAG:LOCAL:睡眠)
                        CALL ADD_BANQUET_END_PARTICIPATION(LOCAL)
                ENDIF
            ENDIF
        NEXT
        IF PRESENT
            PRINTFORMDL 你听到因幡兔们一边以完美的节奏捣着年糕一边唱着歌。
            SELECTCASE TIME % (20 + (TALENT:[[てゐ]]:恋慕 ? 10 # 0)) ;add another verse for tewi
                CASE 0 TO 9
                    VERSE = 1
                CASE 10 TO 19
                    VERSE = 2
                CASE 20 TO 29
                    VERSE = 3
            ENDSELECT

            SELECTCASE VERSE
                CASE 1
                    PRINTFORMDL 「第一杵献给大黑天大人～」
                    PRINTFORMDL 「第二杵献给大黑天大人～」
                    PRINTFORMDW 「为了所有一百八十个孩子，继续捣年糕，嘿！捣年糕哟～」
                CASE 2
                    PRINTFORMDL 「第三杵献给%CALLNAME:[[輝夜]]%大人～」
                    PRINTFORMDL 「第四杵献给%CALLNAME:[[永琳]]%大人～」
                    PRINTFORMDW 「月上永恒贵族皆安康，继续捣年糕，嘿！捣年糕哟～」
                CASE 3
                    PRINTFORMDL 「第五杵献给%CALLNAME:MASTER%～」
                    PRINTFORMDL 「第六杵献给%CALLNAME:MASTER%～」
                    IF CFLAG:MASTER:子供人数 == 0
                        PRINTFORMDW 「为了所有敬慕%HIM_HER(MASTER)%的兔子们，继续捣年糕，嘿！捣年糕哟～」
                    ELSEIF CFLAG:MASTER:子供人数 == 1
                        PRINTFORMDW 「为了%HIS_HER(MASTER)%那可爱的孩子，继续捣年糕，嘿！捣年糕哟～」
                    ELSE
                        PRINTFORMDW 「为了%HIS_HER(MASTER)%那%TOKANJI(CFLAG:MASTER:子供人数)%个孩子，继续捣年糕，嘿！捣年糕哟～」
                    ENDIF
            ENDSELECT
        ENDIF
    CASE ADD_BANQUET_STATE_FINISHED
ENDSELECT

@ADD_BANQUET_PREPARATION_TEXT23(CHARA, LOCATION)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC CHARA
#DIM DYNAMIC LOCATION

@ADD_BANQUET_JOIN_TEXT23(CHARA, LOCATION)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC CHARA
#DIM DYNAMIC LOCATION
IF CFLAG:CHARA:現在位置 == CFLAG:MASTER:現在位置 && CFLAG:MASTER:現在位置 == LOCATION
ELSEIF CFLAG:MASTER:現在位置 == LOCATION
ELSEIF CFLAG:CHARA:現在位置 == CFLAG:MASTER:現在位置
    PRINTFORML %CALLNAME:CHARA%前往%NAME_FROM_PLACE(LOCATION)%参加月兔祭。
ENDIF

@ADD_BANQUET_SET_PARTICIPANTS23
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC BANQUET_INDEX
#DIM DYNAMIC BANQUET_SCALE
BANQUET_INDEX = ADD_BANQUET_INDEX(23)
BANQUET_SCALE = ADD_BANQUETS_SCALE:BANQUET_INDEX

CALL ADD_BANQUET_FILL_PARTICIPANTS(BANQUET_INDEX, 0, 0)

@ADD_BANQUET_PARTICIPANT_JOIN_CHECK23(ARG)
#LOCALSIZE 1
#LOCALSSIZE 1
RETURN 0 ;fixed group

@ADD_BANQUET_WORKLOAD_PREPARATION23(ARG)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC BANQUET_INDEX
#DIM DYNAMIC WORKLOAD
BANQUET_INDEX = ADD_BANQUET_INDEX(23)
WORKLOAD = ADD_BANQUET_TIME_UNTIL(BANQUET_INDEX) * 10

IF CFLAG:ARG:職種 != JOB_宴会準備
	MAXBASE:ARG:仕事量 = WORKLOAD
	BASE:ARG:仕事量 = MAXBASE:ARG:仕事量
	CFLAG:ARG:職種 = JOB_宴会準備
    TCVAR:ARG:手伝えない = 2
	CFLAG:ARG:行動 = 5
ENDIF

@ADD_BANQUET_WORKLOAD_PARTICIPATION23(ARG, SCALE)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC SCALE
#DIM DYNAMIC BANQUET_INDEX
BANQUET_INDEX = ADD_BANQUET_INDEX(23)

IF CFLAG:ARG:職種 != JOB_宴会参加
	MAXBASE:ARG:仕事量 = ADD_BANQUET_TIME_UNTIL(BANQUET_INDEX) * 10
	BASE:ARG:仕事量 = MAXBASE:ARG:仕事量
	CFLAG:ARG:職種 = JOB_宴会参加
	CFLAG:ARG:行動 = 5
    TCVAR:ARG:手伝えない = 1
ENDIF

@ADD_BANQUET_MESSAGE_TALK23
