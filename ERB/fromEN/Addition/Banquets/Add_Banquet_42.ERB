@FADD_BANQUET42(ARG, O_DATA)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTIONS
#DIMS DYNAMIC O_DATA

SELECTCASE O_DATA
	CASE "NAME"
		RETURNF "疯狂木曜日"
	CASE "ACTIVITIES"
		RETURNF "疯狂地吃喝玩乐"
	CASE "TERM"
		RETURNF "宴会"
	CASE "CATEGORY"
		RETURNF "宴会"
	CASE "PRIORITY"
		RETURNF "2"
	CASE "NOTIFY_PLAYER"
		RETURNF "1"
	CASE "HOST"
		RETURNF @"{[[ミスティア]]}"
	CASE "HOST_LIST"
		RETURNF @"{[[ミスティア]]}/{[[阿求]]}/{[[慧音]]}"
	CASE "GUEST_LIST"
		RETURNF ""
	CASE "BANNED_LIST"
		RETURNF @"{[[正邪]]}"
	CASE "CONDITIONS"
		SIF CFLAG:[[ミスティア]]:出禁 == 0 && DAY%7 == 4 && CRAZY_THURSDAY && !(DAY:2 == 4 && DAY:3 > 25) && RAND:100 <= 20
			RETURNF "1"
		RETURNF "0"
	CASE "WEATHER_DEPENDENT"
		RETURNF "1"
	CASE "ALTERNATIVE_INDOOR_LOCATION"
		RETURNF @"{P201人里の門}"
	CASE "DRINKING"
		RETURNF "1"
	CASE "MUSIC_PERFORMANCE"
		RETURNF "1"
ENDSELECT
RETURNF ""

@ADD_BANQUET_PLANNING42
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC LOCATION
#DIM DYNAMIC SCALE
#DIM DYNAMIC START_TIME

LOCATION = P202中央広場
SCALE = 2000 + RAND:2000
START_TIME = 1080

CALL ADD_BANQUET_CREATE(42, LOCATION, START_TIME, DAY+3, (SCALE / 10) + 300, SCALE)
LOCAL = RESULT

SIF LOCAL < 0
	RETURN

ADD_BANQUETS_INVITED:LOCAL = ADD_BANQUET_INVITE_INVITED
PRINTL
PRINTFORMW %CALLNAME:[[ミスティア]]%的疯狂木曜日活动将要在周四举办……
PRINTFORML
CALL ADD_BANQUET_DRINKING_INITIALIZATION_DESCRIPTION(LOCAL)

@ADD_BANQUET_START42
#LOCALSIZE 1
#LOCALSSIZE 1
CALL ADD_BANQUET_DRESS_UP(42)

@ADD_BANQUET_FINISH42
#LOCALSIZE 1
#LOCALSSIZE 1
CALL ADD_BANQUET_DRESS_DOWN(42)

@ADD_BANQUET_VISIT42(PREVIOUS_STATE)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC PREVIOUS_STATE
CALL ADD_BANQUET_DRINKING_VISIT(PREVIOUS_STATE, ADD_BANQUET_INDEX(42))

@ADD_BANQUET_PROGRESS42(BANQUET_INDEX)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC BANQUET_INDEX
CALL ADD_BANQUET_DRINKING_PROGRESS(BANQUET_INDEX)

@ADD_BANQUET_PREPARATION_TEXT42(CHARA, LOCATION)
#LOCALSIZE 1
