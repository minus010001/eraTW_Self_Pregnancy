CALL ADD_BANQUET_DRINKING_PREPARATION_TEXT(CHARA, LOCATION)

@ADD_BANQUET_JOIN_TEXT42(CHARA, LOCATION)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC CHARA
#DIM DYNAMIC LOCATION
CALL ADD_BANQUET_DRINKING_JOIN_TEXT(CHARA, LOCATION)

@ADD_BANQUET_SET_PARTICIPANTS42
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC BANQUET_INDEX
#DIM DYNAMIC BANQUET_SCALE
BANQUET_INDEX = ADD_BANQUET_INDEX(42)
BANQUET_SCALE = ADD_BANQUETS_SCALE:BANQUET_INDEX

CALL ADD_BANQUET_FILL_PARTICIPANTS(BANQUET_INDEX, 0, 0)

@ADD_BANQUET_PARTICIPANT_JOIN_CHECK42(ARG)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC BANQUET_INDEX
#DIM DYNAMIC VENUE_MAP
#DIM DYNAMIC BANQUET_SCALE
BANQUET_INDEX = ADD_BANQUET_INDEX(42)
VENUE_MAP = GET_MAPID(ADD_BANQUETS_LOCATION:BANQUET_INDEX)
BANQUET_SCALE = ADD_BANQUETS_SCALE:BANQUET_INDEX
IF GET_MAPID(CFLAG:ARG:自宅位置) == VENUE_MAP
	;同マップ住人は100%参加
	RETURN 1
ELSEIF BANQUET_SCALE >= 2000
	;大規模なら14%
	RETURN RAND:100 < 14
ELSE
	;小規模なら9%
	RETURN RAND:100 < 9
ENDIF

