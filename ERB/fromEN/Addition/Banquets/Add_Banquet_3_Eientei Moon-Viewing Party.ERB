@FADD_BANQUET3(ARG, O_DATA)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTIONS
#DIMS DYNAMIC O_DATA

SELECTCASE O_DATA
	CASE "NAME"
		RETURNF "永远亭赏月会"
	CASE "ACTIVITIES"
		RETURNF "饮酒聊天"
	CASE "TERM"
		RETURNF "宴会"
	CASE "CATEGORY"
		RETURNF "宴会"
	CASE "PRIORITY"
		RETURNF "1"
	CASE "NOTIFY_PLAYER"
		RETURNF "1"
	CASE "HOST"
		RETURNF @"{[[永琳]]}"
	CASE "HOST_LIST"
		RETURNF @"{[[永琳]]}/{[[鈴仙]]}/{[[てゐ]]}/{[[メディスン]]}"
	CASE "GUEST_LIST"
		RETURNF @"{[[輝夜]]}"
	CASE "BANNED_LIST"
		RETURNF @"{[[正邪]]}"
	CASE "CONDITIONS"
		SIF DAY:2 == 3 && DAY:3 >= 1 && DAY:3 < 15
			RETURNF "1"
		RETURNF "0"
	CASE "WEATHER_DEPENDENT"
		RETURNF "1"
	CASE "DRINKING"
		RETURNF "1"
	CASE "MUSIC_PERFORMANCE"
		RETURNF "1"
	CASE "MOON_VIEWING"
		RETURNF "1"
ENDSELECT
RETURNF ""

@ADD_BANQUET_PLANNING3
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC LOCATION
#DIM DYNAMIC SCALE
#DIM DYNAMIC START_TIME

LOCATION = P409縁側

SCALE = 2000 + RAND:1000
START_TIME = 1140
CALL ADD_BANQUET_CREATE(3, LOCATION, START_TIME, DAY + (15 - DAY:3), (SCALE / 10) + 300, SCALE)
LOCAL = RESULT

SIF LOCAL < 0 ;couldn't create
    RETURN

ADD_BANQUETS_INVITED:LOCAL = ADD_BANQUET_INVITE_INVITED
PRINTL  
IF MAIN_MAP == 4
        PRINTFORMW 被%CALLNAME:[[永琳]]%请去喝赏月酒了
ELSE
        PRINTFORMW 被邀请去永远亭喝赏月酒了
ENDIF
PRINTFORML 


CALL ADD_BANQUET_DRINKING_INITIALIZATION_DESCRIPTION(LOCAL)

