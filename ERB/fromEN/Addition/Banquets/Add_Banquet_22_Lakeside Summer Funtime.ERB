@FADD_BANQUET22(ARG, O_DATA)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTIONS
#DIMS DYNAMIC O_DATA

SELECTCASE O_DATA
	CASE "NAME"
		RETURNF "湖畔嬉水"
	CASE "ACTIVITIES"
		RETURNF "游泳嬉戏"
	CASE "TERM"
		RETURNF "湖畔派对"
	CASE "CATEGORY"
		RETURNF "游泳"
	CASE "PRIORITY"
		RETURNF "2"
	CASE "HOST"
		RETURNF ""
	CASE "HOST_LIST"
		RETURNF ""
	CASE "GUEST_LIST"
		RETURNF ""
	CASE "BANNED_LIST"
		RETURNF ""
	CASE "CONDITIONS"
		;夏季每周举办
		IF DAY:2 == 2
			LOCAL = ADD_BANQUET_NEXT_DAY_OF_WEEK(0)
			IF LOCAL % 31 > (DAY-1) % 31 ;只有当月还有周日时
				RETURNF "1"
			ENDIF
		ENDIF
		RETURNF "0"
	CASE "WEATHER_DEPENDENT"
		RETURNF "1"
	CASE "SWIMMING"
		RETURNF "1"
	CASE "WATERMELON"
		RETURNF "1"
ENDSELECT
RETURNF ""

@ADD_BANQUET_PLANNING22
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC LOCATION
#DIM DYNAMIC SCALE
#DIM DYNAMIC START_TIME
#DIM DYNAMIC END_TIME

LOCATION = P347霧の湖

SCALE = 1
START_TIME = CLOCK_TO_TIME(9, 0)

CALL ADD_BANQUET_CREATE(22, LOCATION, START_TIME, ADD_BANQUET_NEXT_DAY_OF_WEEK(0), 480, SCALE)
LOCAL = RESULT ;banquet_index

SIF LOCAL < 0 ;无法创建
	RETURN

ADD_BANQUETS_INVITED:LOCAL = ADD_BANQUET_INVITE_INVITED

PRINTL
PRINTFORMW 因为是夏天，很多人会聚集到湖边乘凉。
PRINTFORML

PRINTFORMW %ADD_BANQUET_TIME_AND_PLACE_DESCRIPTION(LOCAL)%
PRINTFORMW 不过如果天气不好的话可能会取消……

@ADD_BANQUET_START22
#LOCALSIZE 1
#LOCALSSIZE 1
FOR LOCAL, 1, CHARANUM
	SIF CFLAG:LOCAL:BANQUET == 22
		CALL ADD_BANQUET_SET_OUTFIT22(LOCAL)
NEXT

@ADD_BANQUET_FINISH22
#LOCALSIZE 1
#LOCALSSIZE 1
FOR LOCAL, 1, CHARANUM
	CALL ADD_BANQUET_RESET_OUTFIT22(LOCAL)
NEXT

@ADD_BANQUET_VISIT22(PREVIOUS_STATE)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC PREVIOUS_STATE
#DIM DYNAMIC BANQUET_INDEX
#DIM DYNAMIC CURRENT_STATE
#DIM DYNAMIC PARTICIPANTS
BANQUET_INDEX = ADD_BANQUET_INDEX(22)
PARTICIPANTS = ADD_BANQUET_PARTICIPANT_COUNT(BANQUET_INDEX)
CURRENT_STATE = ADD_BANQUETS_STATUS:BANQUET_INDEX

IF CURRENT_STATE == ADD_BANQUET_STATE_IN_PROGRESS && PREVIOUS_STATE == ADD_BANQUET_STATE_PREPARING ;玩家在开始时在场
	PRINTFORML
	PRINTFORMDL 人们来到湖边，准备享受嬉水的乐趣。
	PRINTFORML
ELSEIF CURRENT_STATE == ADD_BANQUET_STATE_IN_PROGRESS ;后来加入
	PRINTL
	PRINTDW 湖边已经有人在嬉水了。
	PRINTL
ENDIF

@ADD_BANQUET_PROGRESS22(BANQUET_INDEX)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC BANQUET_INDEX
#DIM DYNAMIC BANQUET_ID
#DIM DYNAMIC PRESENT
#DIM DYNAMIC LAPSE

BANQUET_ID = ADD_BANQUETS_UPCOMING:BANQUET_INDEX
;玩家是否在场
PRESENT = CFLAG:MASTER:現在位置 == GET_MAP_REPLACEMENT(ADD_BANQUETS_LOCATION:BANQUET_INDEX)
LAPSE = TIME_PROGRESS(TIME:1)

SELECTCASE ADD_BANQUETS_STATUS:BANQUET_INDEX
	CASE ADD_BANQUET_STATE_IN_PROGRESS
		FOR LOCAL, 1, CHARANUM
			IF CFLAG:LOCAL:BANQUET == BANQUET_ID
				IF CFLAG:LOCAL:行動 == 5
					BASE:LOCAL:仕事量 = MAX(BASE:LOCAL:仕事量 - LAPSE * 10, 0)
					SIF CFLAG:LOCAL:BANQUET_ROLE < ADD_BANQUET_ROLE_HOST && (BASE:LOCAL:仕事量 == 0 || CFLAG:LOCAL:睡眠)
						CALL ADD_BANQUET_END_PARTICIPATION(LOCAL)
				ENDIF
				IF PRESENT

				ENDIF
			ENDIF
		NEXT
	CASE ADD_BANQUET_STATE_FINISHED
ENDSELECT

@ADD_BANQUET_PREPARATION_TEXT22(CHARA, LOCATION)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC CHARA
#DIM DYNAMIC LOCATION

@ADD_BANQUET_JOIN_TEXT22(CHARA, LOCATION)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC CHARA
#DIM DYNAMIC LOCATION
IF CFLAG:CHARA:現在位置 == CFLAG:MASTER:現在位置 && CFLAG:MASTER:現在位置 == LOCATION
ELSEIF CFLAG:MASTER:現在位置 == LOCATION
	PRINTFORMDL %CALLNAME:CHARA%来到了湖边。
ELSEIF CFLAG:CHARA:現在位置 == CFLAG:MASTER:現在位置
	PRINTFORMDL %CALLNAME:CHARA%前往%NAME_FROM_PLACE(LOCATION)%嬉水去了。
ENDIF

@ADD_BANQUET_SET_PARTICIPANTS22
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC BANQUET_INDEX
#DIM DYNAMIC BANQUET_SCALE
BANQUET_INDEX = ADD_BANQUET_INDEX(22)
BANQUET_SCALE = ADD_BANQUETS_SCALE:BANQUET_INDEX

CALL ADD_BANQUET_FILL_PARTICIPANTS(BANQUET_INDEX, 0, 0)

@ADD_BANQUET_PARTICIPANT_JOIN_CHECK22(ARG)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC START_TIME
START_TIME = ADD_BANQUETS_START_TIME:ADD_BANQUET_INDEX(22)

IF !ADD_BANQUET_SCHEDULE_CHECK(ARG, ADD_BANQUET_INDEX(22))
	DEBUGPRINTFORML %CALLNAME:ARG%因作息时间不去湖边
	RETURN 0
ENDIF

SIF TALENT:ARG:妖怪 == 3 ;吸血鬼不参加
	RETURN 0
SIF TALENT:ARG:水棲 ;水栖种族喜欢水
	RETURN RAND:100 < 50
RETURN RAND:100 < 8 ;其他人

@ADD_BANQUET_WORKLOAD_PREPARATION22(ARG)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC SCALE
#DIM DYNAMIC BANQUET_INDEX
#DIM DYNAMIC WORKLOAD
BANQUET_INDEX = ADD_BANQUET_INDEX(22)
SCALE = ADD_BANQUETS_SCALE:BANQUET_INDEX
WORKLOAD = ADD_BANQUET_TIME_UNTIL(BANQUET_INDEX) * 10

IF CFLAG:ARG:職種 != JOB_宴会準備
	MAXBASE:ARG:仕事量 = MIN(WORKLOAD, 2400)
	BASE:ARG:仕事量 = MAXBASE:ARG:仕事量
	CFLAG:ARG:職種 = JOB_宴会準備
	TCVAR:ARG:手伝えない = 2
	CFLAG:ARG:行動 = 5
ENDIF

@ADD_BANQUET_WORKLOAD_PARTICIPATION22(ARG, SCALE)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC SCALE

IF CFLAG:ARG:職種 != JOB_宴会参加
	MAXBASE:ARG:仕事量 = RAND(2400, 4800)
	BASE:ARG:仕事量 = MAXBASE:ARG:仕事量
	CFLAG:ARG:職種 = JOB_宴会参加
	CFLAG:ARG:行動 = 5
	TCVAR:ARG:手伝えない = 1
ENDIF

@ADD_BANQUET_MESSAGE_TALK22
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC BANQUET_INDEX
#DIM DYNAMIC PARTICIPANTS
BANQUET_INDEX = ADD_BANQUET_INDEX(22)
PRINTFORMDL 大家都在水边嬉戏。

@ADD_BANQUET_SET_OUTFIT22(ARG)
#LOCALSIZE 1
#LOCALSSIZE 1
CALL ADD_START_SWIMMING(ARG)
TCVAR:ARG:DRESSED_FOR_BANQUET = 22

@ADD_BANQUET_RESET_OUTFIT22(ARG)
#LOCALSIZE 1
#LOCALSSIZE 1
CALL ADD_END_SWIMMING(ARG)
TCVAR:ARG:DRESSED_FOR_BANQUET = 0
