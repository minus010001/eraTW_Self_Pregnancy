@FADD_BANQUET15(ARG, O_DATA)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTIONS
#DIMS DYNAMIC O_DATA

SELECTCASE O_DATA
    CASE "NAME"
        RETURNF "教徒秘密酒会"
    CASE "ACTIVITIES"
        RETURNF "饮酒聊天"
    CASE "TERM"
        RETURNF "宴会"
    CASE "CATEGORY"
        RETURNF "宴会"
    CASE "PRIORITY"
        RETURNF "3"
    CASE "HOST"
        RETURNF @"{[[一輪]]}"
    CASE "HOST_LIST"
        RETURNF @"{[[一輪]]}/{[[ムラサ]]}/{[[響子]]}"
    CASE "GUEST_LIST"
        RETURNF @"{[[ナズーリン]]}/{[[ぬえ]]}/{[[マミゾウ]]}/{[[星]]}"
    CASE "BANNED_LIST"
        RETURNF @"{[[白蓮]]}"
    CASE "CONDITIONS"
        SIF CFLAG:[[一輪]]:出禁 == 0 && !(DAY:2 == 4 && DAY:3 > 25) && !RAND:60
            RETURNF "1"
        RETURNF "0"
    CASE "WEATHER_DEPENDENT"
        RETURNF "1"
    CASE "DRINKING"
        RETURNF "1"
    CASE "MUSIC_PERFORMANCE"
        RETURNF "1"
ENDSELECT
RETURNF ""

@ADD_BANQUET_PLANNING15
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC LOCATION
#DIM DYNAMIC SCALE
#DIM DYNAMIC START_TIME

LOCATION = P121墓地

SCALE = 2500
START_TIME = CLOCK_TO_TIME(18, 0)

CALL ADD_BANQUET_CREATE(15, LOCATION, START_TIME, DAY+1, (SCALE / 10) + 300, SCALE)
LOCAL = RESULT ;banquet_index

SIF LOCAL < 0 ;couldn't create
    RETURN

;never invited, must stumble upon it in the wild

@ADD_BANQUET_START15
#LOCALSIZE 1
#LOCALSSIZE 1
CALL ADD_BANQUET_DRESS_UP(15)

@ADD_BANQUET_FINISH15
#LOCALSIZE 1
#LOCALSSIZE 1
CALL ADD_BANQUET_DRESS_DOWN(15)

@ADD_BANQUET_VISIT15(PREVIOUS_STATE)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC PREVIOUS_STATE
;invited if found and not disliked
IF !MARK:[[一輪]]:反発刻印
    PRINTFORMDL 你发现命莲寺的修行僧们正在吃肉喝酒。
    PRINTFORMDL 云山反应很快，告诉你只要不对白莲说出去就可以加入。
    ADD_BANQUETS_INVITED:ADD_BANQUET_INDEX(15) = ADD_BANQUET_INVITE_INVITED
ENDIF

CALL ADD_BANQUET_DRINKING_VISIT(PREVIOUS_STATE, ADD_BANQUET_INDEX(15))

@ADD_BANQUET_PROGRESS15(BANQUET_INDEX)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC BANQUET_INDEX
#DIM DYNAMIC PRESENT
#DIM DYNAMIC LOCATION
CALL ADD_BANQUET_DRINKING_PROGRESS(BANQUET_INDEX)
LOCATION = GET_MAP_REPLACEMENT(ADD_BANQUETS_LOCATION:BANQUET_INDEX)
;byakuren appears
IF CFLAG:[[白蓮]]:現在位置 == LOCATION
    IF CFLAG:[[白蓮]]:同行 ;bringing byakuren to the party
        PRINTFORMDL 进入%NAME_FROM_PLACE(LOCATION)%后，你看到命莲寺的修行僧们围坐在一起吃肉喝酒。
        PRINTFORMDW 白莲毫不留情地把他们一个个打翻在地，终结了这场小宴会。
    ELSEIF TALENT:[[ぬえ]]:恋慕 && BASE:[[ぬえ]]:酒気 < (MAXBASE:[[ぬえ]]:酒気 / 10) * 8
        CALL SET_KOJO_COLOR([[ぬえ]])
        PRINTFORMW 「嘿%MASTER_NAME([[ぬえ]])%，能跟我来一下吗？」
        PRINTFORMDL 你还没来得及回答，%CALLNAME:[[ぬえ]]%就一把抓住你的手臂，把你从宴会上拽走了。
        PRINTFORMDW 两人走远后，身后传来一声巨响，像是有人被狠狠揍了一顿，你不由得加快了脚步。
        PRINTFORML 「咕咕咕……看来我们跑得刚刚好。能跟这位%CALLNAME:[[ぬえ]]%大人做朋友，是不是很庆幸？」
        PRINTFORMW 「圣应该过一会儿就会消气，不过现在最好还是别靠近她。」
        RESETCOLOR
        CALL GETOUT(MASTER)
        CFLAG:[[ぬえ]]:現在位置 = CFLAG:MASTER:現在位置
		CALL TARGETSET_CHACK
    ELSEIF TALENT:[[マミゾウ]]:恋慕 && BASE:[[マミゾウ]]:酒気 < (MAXBASE:[[マミゾウ]]:酒気 / 10) * 8
        CALL SET_KOJO_COLOR([[マミゾウ]])
        PRINTFORMW 「嗯，今天差不多该收了吧，%MASTER_NAME([[マミゾウ]])%。」
        PRINTFORMDL 你还不太想走，但猯藏非常坚持要你立刻离开。
        PRINTFORML 「好啦好啦，凡事都得有个度嘛。人也好妖怪也好，都一样。」
        PRINTFORMDL 猯藏把你拉起来，两人迅速离开了宴会。
        PRINTFORMDL 身后传来一声巨响，像是有人被狠狠揍了一顿，但%CALLNAME:[[マミゾウ]]%叫你不用在意。
        PRINTFORMW 「嗯？你觉得该回去看看？那帮家伙不用担心啦，她们自己能搞定的。」
        RESETCOLOR
        CALL GETOUT(MASTER)
        CFLAG:[[マミゾウ]]:現在位置 = CFLAG:MASTER:現在位置
		CALL TARGETSET_CHACK
    ELSEIF CFLAG:MASTER:現在位置 == LOCATION
        CALL COLORMESSAGE(@"☆南无三！☆　", C_RED, 1, 1)
        PRINTFORMDL 正享受着宴会时，后脑勺突然挨了重重一击。
	    CALL RECOVER(MASTER, -MIN(MAXBASE:MASTER:体力 / 2, BASE:MASTER:体力 - 501),"体力", "被南无三了！")

        CALL PRINT_STRL, @"转过身来，你看到了%CALLNAME:[[白蓮]]%。虽然脸上挂着微笑，但显然对撞见弟子们@ITALIC@明知故犯@非常不满。"
        PRINTFORMDW 看来宴会到此为止了。
    ENDIF

    FOR LOCAL, 1, CHARANUM
        IF CFLAG:LOCAL:BANQUET == 15 && CFLAG:LOCAL:現在位置 == LOCATION
            IF GROUPMATCH(LOCAL, [[ぬえ]], [[マミゾウ]]) && BASE:LOCAL:酒気 < (MAXBASE:LOCAL:酒気 / 10) * 8 ;slippery individuals
                CALL GETOUT(LOCAL)
            ELSE
                BASE:LOCAL:体力 -= 1000            
                TALENT:LOCAL:機嫌 = -1
            ENDIF
            CALL ADD_BANQUET_END_PARTICIPATION(LOCAL)
        ENDIF
    NEXT

    ADD_BANQUETS_STATUS:BANQUET_INDEX = ADD_BANQUET_STATE_CANCELLED
ENDIF

