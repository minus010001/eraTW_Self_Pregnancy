@FADD_BANQUET2(ARG, O_DATA)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTIONS
#DIMS DYNAMIC O_DATA
SELECTCASE O_DATA
	CASE "NAME"
		RETURNF "幻想乡忘年会"
	CASE "ACTIVITIES"
		RETURNF "饮酒聊天"
	CASE "TERM"
		RETURNF "宴会"
	CASE "CATEGORY"
		RETURNF "宴会"
	CASE "PRIORITY"
		RETURNF "1"
	CASE "NOTIFY_PLAYER"
		RETURNF "1"
	CASE "HOST"
		RETURNF @"{[[霊夢]]}"
	CASE "HOST_LIST"
		RETURNF @"{[[霊夢]]}/{[[る～こと]]}/{[[魔理沙]]}"
	CASE "GUEST_LIST"
		RETURNF @"{[[萃香]]}"
	CASE "BANNED_LIST"
		RETURNF @"{[[正邪]]}"
	CASE "CONDITIONS"
		SIF DAY:2 == 4 && DAY:3 >= 25 && DAY:3 <= 30
			RETURNF "1"
		RETURNF "0"
	CASE "WEATHER_DEPENDENT"
		RETURNF "0"
	CASE "KEEP_AWAKE"
		RETURNF "1"
	CASE "DRINKING"
		RETURNF "1"
	CASE "MUSIC_PERFORMANCE"
		RETURNF "1"
ENDSELECT
RETURNF ""

@ADD_BANQUET_PLANNING2
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC SCALE
#DIM DYNAMIC START_TIME

SCALE = 6000
START_TIME = 900

CALL ADD_BANQUET_CREATE(2, P9居間, START_TIME, DAY + (31 - DAY:3), 720, SCALE)
LOCAL = RESULT ;banquet_index

SIF LOCAL < 0 ;couldn't create
    RETURN

ADD_BANQUETS_INVITED:LOCAL = ADD_BANQUET_INVITE_INVITED
PRINTL  
PRINTFORMW 办忘年会的日子又要到了
PRINTFORML 

CALL ADD_BANQUET_DRINKING_INITIALIZATION_DESCRIPTION(LOCAL)

