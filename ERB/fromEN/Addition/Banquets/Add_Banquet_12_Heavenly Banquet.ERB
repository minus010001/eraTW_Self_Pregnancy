#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC CHARA
#DIM DYNAMIC LOCATION
CALL ADD_BANQUET_DRINKING_PREPARATION_TEXT(CHARA, LOCATION)

@ADD_BANQUET_JOIN_TEXT12(CHARA, LOCATION)
