@ADD_BANQUET_MESSAGE_TALK12
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC BANQUET_INDEX
BANQUET_INDEX = ADD_BANQUET_INDEX(12)

PRINTFORMDL 天界宴会还在继续…
SELECTCASE ADD_BANQUET12_DISASTER
    CASE 1
        PRINTFORMD 酒如流水般源源不断，大家都在畅饮
        SELECTCASE ADD_BANQUET12_QUALITY
            CASE IS < 50
                PRINTFORMDL ，沉醉于酒精的魔力之中。
            CASE IS < 100
                PRINTFORMDL 。
            CASEELSE
                PRINTFORMDL ，尽情享受着美酒的滋味。
        ENDSELECT
    CASE 0
        PRINTFORMDL 人们悠闲地吃喝着。
    CASE -1
        PRINTFORMDL 在场的人似乎都心情极好，享受着美味的食物和饮料。
ENDSELECT

@ADD_BANQUET_HELP_PREPARE12
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC BANQUET_INDEX
BANQUET_INDEX = ADD_BANQUET_INDEX(12)

PRINTFORMDL 你帮忙准备天界宴会。

SELECTCASE ADD_BANQUET12_PREPARATION_STAGE
    CASE 0
        PRINTFORMDL 天子让你把杯子和盘子摆好。
        IF GETBIT(ADD_BANQUET12_TOOLS, 4)
            PRINTFORMDL 你想用自己的餐具替换吗？
            CALL ASK_YN
            IF !RESULT
                IF RAND:(ABL:MASTER:清掃技能)
                    PRINTFORMDL 趁没人注意，你迅速把那些缺口的脏盘脏杯换成了你那套带手绘长春花的皇家道尔顿瓷器。
                    PRINTFORMDL 宴会看起来顿时高档了不少。
                    ADD_BANQUET12_QUALITY += 25
                ELSE
                    PRINTFORMDL 可惜，你正要动手换餐具时，天子走了过来，你只好放弃了计划。
                ENDIF
            ELSE
                PRINTFORMDL 你拿出那些缺口的盘子和杯子，开始摆放。
            ENDIF
        ELSE
            PRINTFORMDL 你拿出那些缺口的盘子和杯子，开始摆放。
        ENDIF
        IF ABL:MASTER:清掃技能
            PRINTFORMDL 你用清洁技巧把盘子和杯子擦得锃亮。
            ADD_BANQUET12_QUALITY += MIN(ABL:MASTER:清掃技能 * 2, 10)
        ENDIF
    CASE 1
        IF !ADD_BANQUET12_KASEN_HOST
            PRINTFORMDL 天子说她要出去一小会儿，留下你一个人和酒坛子。
            PRINTFORMDL 你想用自己带来的酒替换那些劣质酒吗？
            CALL ASK_M(@"替换（需要清酒20，剩余{ITEM:清酒}）",ITEM:清酒 >= 20, "不换", 1)
            IF !RESULT
                IF RAND:(TALENT:MASTER:調合Lv)
                    PRINTFORMDL 你把坛子里的酒倒掉，迅速换上了自己的。
                    PRINTFORMDL 虽然很贵，但至少今天能保证喝到好酒了。
                    CALL LOST_ITEM("清酒", 20, 2)
                    ADD_BANQUET12_QUALITY += 40
                ELSE
                    PRINTFORMDL 你端着酒坛的时候，发现%CALLNAME:[[紫苑]]%一直在你身边转来转去，根本没机会偷换。
                ENDIF
            ELSE
                PRINTFORMDL 你决定不动天子的酒。
            ENDIF
            IF GETBIT(ADD_BANQUET12_TOOLS, 1)
                PRINTFORMDW 你迅速把酒过一遍你的仿制酒器，提升了品质。
                ADD_BANQUET12_QUALITY += MIN(TALENT:MASTER:調合Lv * 3, 15)
            ENDIF
        ELSE
            PRINTFORMDL 你帮%CALLNAME:[[華扇]]%摆酒。
        ENDIF
    CASE 2
        IF !ADD_BANQUET12_KASEN_HOST
            PRINTFORMDL 你按照天子的命令开始做菜。
            PRINTFORMDL 你想偷偷用自己的蔬菜替换吗？

            CALL ASK_M(@"替换（需要卷心菜、黄瓜、番茄、洋葱、茄子、胡萝卜各10个）",ITEM:キャベツ >= 10 && ITEM:キュウリ >= 10 && ITEM:トマト >= 10 && ITEM:タマネギ >= 10 && ITEM:ナス >= 10 && ITEM:ニンジン >= 10, "不换", 1)
            IF !RESULT
                PRINTFORMDL 你无视了天子和紫苑带来的蔬菜，改用自己带来的。
                CALL LOST_ITEM("キャベツ", 10, 1)
                CALL LOST_ITEM("キュウリ", 10, 1)
                CALL LOST_ITEM("トマト", 10, 1)
                CALL LOST_ITEM("タマネギ", 10, 1)
                CALL LOST_ITEM("ナス", 10, 1)
                CALL LOST_ITEM("ニンジン", 10, 2)
                ADD_BANQUET12_QUALITY += 20
            ELSE
                PRINTFORMDL 你决定用天子和紫苑带来的蔬菜。
            ENDIF
        ELSE
            PRINTFORMDL 你帮%CALLNAME:[[華扇]]%做菜。她带来的优质食材让做菜变得轻松许多。
        ENDIF
        ADD_BANQUET12_QUALITY += MIN(ABL:MASTER:料理技能 * 2, 10)
        IF GETBIT(ADD_BANQUET12_TOOLS, 3)
            PRINTFORMDL 你大方地在食物上撒满了稗田家特制的香草和调料。
            PRINTFORMDL 不管菜做得怎么样，至少闻起来是相当不错的。

            ADD_BANQUET12_QUALITY += 5
        ENDIF
        WAIT
    CASEELSE
        PRINTFORMDW 你帮%CALLNAME:[[天子]]%和%CALLNAME:[[紫苑]]%布置装饰，改善%NAME_FROM_PLACE(GET_MAP_REPLACEMENT(ADD_BANQUETS_LOCATION:BANQUET_INDEX))%周围的气氛。
        ADD_BANQUET12_QUALITY += RAND:(MAX(ABL:MASTER:音楽技能 + ABL:MASTER:教養,1))
ENDSELECT
ADD_BANQUET12_PREPARATION_STAGE++

DEBUGPRINTFORML Current heavenly banquet quality: {ADD_BANQUET12_QUALITY}.

@EVENTTRAIN
#LATER
IF ADD_BANQUET12_DISASTER > 0
    PRINTFORMDL 经历了昨天那场灾难般的宴会，你感觉糟透了。
    PRINTFORMDW 今天最好悠着点。
	CALL BUFF_BASE(MASTER, BASE_体力, -MAXBASE:MASTER:体力 / 2)
	CALL BUFF_BASE(MASTER, BASE_気力, -MAXBASE:MASTER:気力 / 2)
	CALL BUFF_BASE(MASTER, BASE_精力, -MAXBASE:MASTER:精力 / 2)
	CALL BUFF_BASE(MASTER, BASE_TSP, -MAXBASE:MASTER:TSP / 2)
    CALL COLORMESSAGE(@"今天的体力、气力、精力、时间减半。（最糟糕的宴会）",C_YELLOW,2,1)
    ADD_BANQUET12_BAD_EXPERIENCE = 1
    ADD_BANQUET12_DISASTER = 0
ELSEIF ADD_BANQUET12_DISASTER < 0
    PRINTFORMDL 经历了昨天那场精彩的宴会，你精力充沛。
    PRINTFORMDW 你觉得今天能征服全世界。
	CALL BUFF_BASE(MASTER, BASE_体力, MAXBASE:MASTER:体力 / 5)
	CALL BUFF_BASE(MASTER, BASE_気力, MAXBASE:MASTER:気力 / 5)
	CALL BUFF_BASE(MASTER, BASE_精力, MAXBASE:MASTER:精力 / 5)
	CALL BUFF_BASE(MASTER, BASE_TSP, MAXBASE:MASTER:TSP / 5)
    CALL COLORMESSAGE(@"今天的体力、气力、精力、时间增加20\%。（最棒的宴会）",C_YELLOW,2,1)
    ADD_BANQUET12_DISASTER = 0
ENDIF