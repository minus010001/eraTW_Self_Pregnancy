@ADD_BANQUET_SET_PARTICIPANTS13
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC BANQUET_INDEX
#DIM DYNAMIC BANQUET_SCALE
BANQUET_INDEX = ADD_BANQUET_INDEX(13)
BANQUET_SCALE = ADD_BANQUETS_SCALE:BANQUET_INDEX

CALL ADD_BANQUET_FILL_PARTICIPANTS(BANQUET_INDEX, 15, BANQUET_SCALE > 2500 ? 10 # 5)

