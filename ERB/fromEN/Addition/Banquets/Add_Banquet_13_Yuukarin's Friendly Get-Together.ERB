@FADD_BANQUET13(ARG, O_DATA)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTIONS
#DIMS DYNAMIC O_DATA

SELECTCASE O_DATA
    CASE "NAME"
        RETURNF "幽香的友好聚会"
    CASE "ACTIVITIES"
        RETURNF "饮酒聊天"
    CASE "TERM"
        RETURNF "宴会"
    CASE "CATEGORY"
        RETURNF "宴会"
    CASE "PRIORITY"
        RETURNF "3"
    CASE "HOST"
        RETURNF @"{[[幽香]]}"
    CASE "HOST_LIST"
        RETURNF @"{[[幽香]]}"
    CASE "GUEST_LIST"
        RETURNF @"{[[美鈴]]}/{[[妖夢]]}"
    CASE "BANNED_LIST"
        RETURNF @"{[[正邪]]}/{[[映姫]]}"
    CASE "CONDITIONS"
        SIF CFLAG:[[幽香]]:出禁 == 0 && DAY%7 == 2 && !(DAY:2 == 4 && DAY:3 > 25) && RAND:100 <= 20
            RETURNF "1"
        RETURNF "0"
    CASE "WEATHER_DEPENDENT"
        RETURNF "0"
    CASE "DRINKING"
        RETURNF "1"
    CASE "MUSIC_PERFORMANCE"
        RETURNF "1"
ENDSELECT
RETURNF ""

@ADD_BANQUET_PLANNING13
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC LOCATION
#DIM DYNAMIC SCALE
#DIM DYNAMIC START_TIME

LOCATION = P462テラス

SCALE = 1000 + RAND:1500 ;relatively small event
START_TIME = CLOCK_TO_TIME(15, 0)

CALL ADD_BANQUET_CREATE(13, LOCATION, START_TIME, DAY+1, (SCALE / 10) + 300, SCALE)
LOCAL = RESULT ;banquet_index

SIF LOCAL < 0 ;couldn't create
    RETURN

IF CFLAG:[[幽香]]:好感度 > 1500 || TALENT:MASTER:採集Lv >= 4 ;friend or good with plants
    ADD_BANQUETS_INVITED:LOCAL = ADD_BANQUET_INVITE_INVITED

    PRINTL 
    PRINTFORMW %CALLNAME:[[幽香]]%邀请你参加她策划的小聚会。
    PRINTFORML 
    CALL ADD_BANQUET_DRINKING_INITIALIZATION_DESCRIPTION(LOCAL)
    
ENDIF
SIF !MARK:[[幽香]]:反発刻印
    CALLF Add_SPECIAL_REQUEST_CREATION([[幽香]], 95, 80, 1, 1)

