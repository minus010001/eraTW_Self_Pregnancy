@FADD_BANQUET4(ARG, O_DATA)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTIONS
#DIMS DYNAMIC O_DATA
#DIMS DYNAMIC L_HOSTS

SELECTCASE O_DATA
	CASE "NAME"
		RETURNF "收获祭"
	CASE "ACTIVITIES"
		RETURNF "饮酒聊天"
	CASE "TERM"
		RETURNF "祭典"
	CASE "CATEGORY"
		RETURNF "祭典"
	CASE "PRIORITY"
		RETURNF "1"
	CASE "NOTIFY_PLAYER"
		RETURNF "1"
	CASE "HOST"
		RETURNF @"{[[阿求]]}"
	CASE "HOST_LIST"
		L_HOSTS =
		FOR LOCAL,1,CHARANUM
			IF CFLAG:LOCAL:自宅位置 / 100 == 2
				SIF STRLENS(L_HOSTS)
					L_HOSTS += "/"
				L_HOSTS += @"{LOCAL}"
			ENDIF
		NEXT
		RETURNF L_HOSTS
	CASE "GUEST_LIST"
		RETURNF @"{[[静葉]]}/{[[穣子]]}"
	CASE "BANNED_LIST"
		RETURNF @"{[[正邪]]}"
	CASE "CONDITIONS"
		SIF DAY:2 == 3 && DAY:3 >= 16 && DAY:3 < 27
			RETURNF "1"
		RETURNF "0"
	CASE "WEATHER_DEPENDENT"
		RETURNF "0"
	CASE "DRINKING"
		RETURNF "1"
	CASE "MUSIC_PERFORMANCE"
		RETURNF "1"
ENDSELECT
RETURNF ""

@ADD_BANQUET_PLANNING4
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC LOCATION
#DIM DYNAMIC SCALE
#DIM DYNAMIC START_TIME

LOCATION = P202中央広場

SCALE = 2000 + RAND:3000
START_TIME = 540

CALL ADD_BANQUET_CREATE(4, LOCATION, START_TIME, DAY + (27 - DAY:3), (SCALE / 10) + 360, SCALE)
LOCAL = RESULT ;banquet_index

SIF LOCAL < 0 ;couldn't create
    RETURN

ADD_BANQUETS_INVITED:LOCAL = ADD_BANQUET_INVITE_INVITED
PRINTL  
PRINTFORMW 今年也到收获祭的季节了…
PRINTFORML 

