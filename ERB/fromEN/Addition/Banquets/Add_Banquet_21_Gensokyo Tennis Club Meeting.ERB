@FADD_BANQUET21(ARG, O_DATA)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTIONS
#DIMS DYNAMIC O_DATA

SELECTCASE O_DATA
	CASE "NAME"
		RETURNF "幻想乡网球俱乐部"
	CASE "ACTIVITIES"
		RETURNF "打网球"
	CASE "TERM"
		RETURNF "网球俱乐部"
	CASE "CATEGORY"
		RETURNF "运动"
	CASE "PRIORITY"
		RETURNF "3"
	CASE "HOST"
		RETURNF ""
	CASE "HOST_LIST"
		RETURNF ""
	CASE "GUEST_LIST"
		RETURNF ""
	CASE "BANNED_LIST"
		RETURNF @"{[[白蓮]]}"
	CASE "CONDITIONS"
		;每周举办
		RETURNF "1"
	CASE "WEATHER_DEPENDENT"
		RETURNF "1"
	CASE "TENNIS"
		RETURNF "1"
ENDSELECT
RETURNF ""

@ADD_BANQUET_PLANNING21
#LOCALSIZE 2
#LOCALSSIZE 1
#DIM DYNAMIC LOCATION
#DIM DYNAMIC SCALE
#DIM DYNAMIC START_TIME
#DIM DYNAMIC END_TIME

LOCATION = P201人里の門

SCALE = 1
;白天和夜晚交替（12:00-17:00 或 21:00-02:00）
START_TIME = DAY % 14 < 7 ? CLOCK_TO_TIME(12, 0) # CLOCK_TO_TIME(21, 0)

CALL ADD_BANQUET_CREATE(21, LOCATION, START_TIME, ADD_BANQUET_NEXT_DAY_OF_WEEK(4), 300, SCALE)
LOCAL = RESULT ;banquet_index

SIF LOCAL < 0 ;无法创建
	RETURN

END_TIME = START_TIME + ADD_BANQUETS_DURATION:LOCAL
ADD_BANQUETS_INVITED:LOCAL = ADD_BANQUET_INVITE_INVITED ;总在概览中列出
ADD_BANQUET21_INVITE = 0
REPEAT 3
	LOCAL:1 = RAND_PERSON()
	SIF MARK:(LOCAL:1):反発刻印
		CONTINUE
	SIF !LOCAL:1
		CONTINUE
	SIF !ADD_BANQUET_SCHEDULE_CHECK(LOCAL:1, LOCAL)
		CONTINUE
	IF CFLAG:(LOCAL:1):好感度 > 1000
		ADD_BANQUET21_INVITE = LOCAL:1
		PRINTL
		PRINTFORMW %CALLNAME:ADD_BANQUET21_INVITE%邀请你下次一起去网球俱乐部。
		PRINTFORML

		PRINTFORMW %ADD_BANQUET_TIME_AND_PLACE_DESCRIPTION(LOCAL)%
		PRINTFORMW 不过如果天气不好的话可能会取消……
		BREAK
	ENDIF
REND

@ADD_BANQUET_START21
#LOCALSIZE 1
#LOCALSSIZE 1
FOR LOCAL, 1, CHARANUM
	SIF CFLAG:LOCAL:BANQUET == 21
		CALL ADD_BANQUET_SET_OUTFIT21(LOCAL)
NEXT

@ADD_BANQUET_FINISH21
#LOCALSIZE 1
#LOCALSSIZE 1
FOR LOCAL, 1, CHARANUM
	CALL ADD_BANQUET_RESET_OUTFIT21(LOCAL)
NEXT

@ADD_BANQUET_VISIT21(PREVIOUS_STATE)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC PREVIOUS_STATE
#DIM DYNAMIC BANQUET_INDEX
#DIM DYNAMIC CURRENT_STATE
#DIM DYNAMIC PARTICIPANTS
BANQUET_INDEX = ADD_BANQUET_INDEX(21)
PARTICIPANTS = ADD_BANQUET_PARTICIPANT_COUNT(BANQUET_INDEX)
CURRENT_STATE = ADD_BANQUETS_STATUS:BANQUET_INDEX

IF CURRENT_STATE == ADD_BANQUET_STATE_IN_PROGRESS && PREVIOUS_STATE == ADD_BANQUET_STATE_PREPARING ;玩家在开始时在场
	PRINTFORML
	PRINTFORMDL 网球俱乐部的成员们迅速换上网球服，开始打球。
ELSEIF CURRENT_STATE == ADD_BANQUET_STATE_IN_PROGRESS ;后来加入
	PRINTL
	PRINTDW 网球俱乐部已经在练习了。
ENDIF

SIF ADD_BANQUET21_INVITE && IS_HERE(ADD_BANQUET21_INVITE)
	PRINTFORMW %CALLNAME:ADD_BANQUET21_INVITE%向你挥手，很高兴你能来。
PRINTL

@ADD_BANQUET_PROGRESS21(BANQUET_INDEX)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC BANQUET_INDEX
#DIM DYNAMIC BANQUET_ID
#DIM DYNAMIC PRESENT
#DIM DYNAMIC LAPSE

BANQUET_ID = ADD_BANQUETS_UPCOMING:BANQUET_INDEX
;玩家是否在场
PRESENT = CFLAG:MASTER:現在位置 == GET_MAP_REPLACEMENT(ADD_BANQUETS_LOCATION:BANQUET_INDEX)
LAPSE = TIME_PROGRESS(TIME:1)

SELECTCASE ADD_BANQUETS_STATUS:BANQUET_INDEX
	CASE ADD_BANQUET_STATE_IN_PROGRESS
		FOR LOCAL, 1, CHARANUM
			IF CFLAG:LOCAL:BANQUET == BANQUET_ID
				IF CFLAG:LOCAL:行動 == 5
					BASE:LOCAL:仕事量 = MAX(BASE:LOCAL:仕事量 - LAPSE * 10, 0)
					SIF CFLAG:LOCAL:BANQUET_ROLE < ADD_BANQUET_ROLE_HOST && (BASE:LOCAL:仕事量 == 0 || CFLAG:LOCAL:睡眠)
						CALL ADD_BANQUET_END_PARTICIPATION(LOCAL)
					IF PRESENT
						PRINTFORMDL %CALLNAME:LOCAL%在网球聚会上玩得很开心。
					ENDIF
				ENDIF
			ENDIF
		NEXT
	CASE ADD_BANQUET_STATE_FINISHED
ENDSELECT

@ADD_BANQUET_PREPARATION_TEXT21(CHARA, LOCATION)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC CHARA
#DIM DYNAMIC LOCATION

@ADD_BANQUET_JOIN_TEXT21(CHARA, LOCATION)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC CHARA
#DIM DYNAMIC LOCATION
IF CFLAG:CHARA:現在位置 == CFLAG:MASTER:現在位置 && CFLAG:MASTER:現在位置 == LOCATION
	PRINTFORMDL %CALLNAME:CHARA%走进了网球场。
ELSEIF CFLAG:MASTER:現在位置 == LOCATION
	PRINTFORMDL %CALLNAME:CHARA%走进了网球场。
ELSEIF CFLAG:CHARA:現在位置 == CFLAG:MASTER:現在位置
	PRINTFORMDL %CALLNAME:CHARA%前往%NAME_FROM_PLACE(LOCATION)%参加网球俱乐部的聚会。
ENDIF

@ADD_BANQUET_SET_PARTICIPANTS21
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC BANQUET_INDEX
#DIM DYNAMIC BANQUET_SCALE
BANQUET_INDEX = ADD_BANQUET_INDEX(21)
BANQUET_SCALE = ADD_BANQUETS_SCALE:BANQUET_INDEX

CALL ADD_BANQUET_FILL_PARTICIPANTS(BANQUET_INDEX, 0, 0)

@ADD_BANQUET_PARTICIPANT_JOIN_CHECK21(ARG)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC START_TIME
START_TIME = ADD_BANQUETS_START_TIME:ADD_BANQUET_INDEX(21)

IF !ADD_BANQUET_SCHEDULE_CHECK(ARG, ADD_BANQUET_INDEX(21))
	DEBUGPRINTFORML %CALLNAME:ARG%因作息时间不参加网球
	RETURN 0
ENDIF

SIF ADD_BANQUET21_INVITE == ARG ;被邀请的玩家
	RETURN 1

IF START_TIME == CLOCK_TO_TIME(12, 0) ;白天
	SIF TALENT:ARG:妖怪 == 3 ;吸血鬼不参加
		RETURN 0
	IF GROUPMATCH(ARG, [[妖夢]], [[小鈴]], [[阿求]]) ;经常参加
		RETURN RAND:100 < 40
	ELSEIF GET_MAPID(CFLAG:ARG:初期位置) == 2 ;村民经常参加
		RETURN RAND:100 < 10
	ELSEIF TALENT:ARG:妖怪 ;妖怪不太参加
		RETURN RAND:100 < 3
	ELSE ;其他人（如神明、妖精等）
		RETURN RAND:100 < 8
	ENDIF
ELSE ;夜晚
	IF GROUPMATCH(ARG, [[レミリア]], [[フラン]]) ;贵族女性的优雅运动
		RETURN RAND:100 < 40
	ELSEIF GET_MAPID(CFLAG:ARG:初期位置) == 2 ;村民在这个时间很少参加
		RETURN RAND:100 < 5
	ELSEIF TALENT:ARG:妖怪 ;妖怪喜欢夜间活动
		RETURN RAND:100 < 10
	ELSE ;其他人（如神明、妖精等）
		RETURN RAND:100 < 3
	ENDIF
ENDIF

@ADD_BANQUET_WORKLOAD_PREPARATION21(ARG)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC SCALE
#DIM DYNAMIC BANQUET_INDEX
#DIM DYNAMIC WORKLOAD
BANQUET_INDEX = ADD_BANQUET_INDEX(21)
SCALE = ADD_BANQUETS_SCALE:BANQUET_INDEX
WORKLOAD = ADD_BANQUET_TIME_UNTIL(BANQUET_INDEX) * 10

IF CFLAG:ARG:職種 != JOB_宴会準備
	MAXBASE:ARG:仕事量 = MIN(WORKLOAD, 2400)
	BASE:ARG:仕事量 = MAXBASE:ARG:仕事量
	CFLAG:ARG:職種 = JOB_宴会準備
	TCVAR:ARG:手伝えない = 2
	CFLAG:ARG:行動 = 5
ENDIF

@ADD_BANQUET_WORKLOAD_PARTICIPATION21(ARG, SCALE)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC SCALE

IF CFLAG:ARG:職種 != JOB_宴会参加
	MAXBASE:ARG:仕事量 = 3000 ;全程参与
	BASE:ARG:仕事量 = MAXBASE:ARG:仕事量
	CFLAG:ARG:職種 = JOB_宴会参加
	CFLAG:ARG:行動 = 5
	TCVAR:ARG:手伝えない = 1
ENDIF

@ADD_BANQUET_MESSAGE_TALK21
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC BANQUET_INDEX
#DIM DYNAMIC PARTICIPANTS
BANQUET_INDEX = ADD_BANQUET_INDEX(21)
PRINTFORMDL 大家都在忙着练习或打比赛。

@ADD_BANQUET_SET_OUTFIT21(ARG)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC PRESENT
PRESENT = CFLAG:MASTER:現在位置 == GET_MAP_REPLACEMENT(ADD_BANQUETS_LOCATION:ADD_BANQUET_INDEX(21))
IF !ADD_BANQUET21_WEARING_TENNIS_OUTFIT(ARG)
	CALL SET_EVENT_CLOTHES(ARG, [[网球服套装]])
	TCVAR:ARG:DRESSED_FOR_BANQUET = 21
	SIF PRESENT
		PRINTFORMDL %CALLNAME:ARG%换上了网球服。
ENDIF

@ADD_BANQUET_RESET_OUTFIT21(ARG)
#LOCALSIZE 1
#LOCALSSIZE 1
IF ADD_BANQUET21_WEARING_TENNIS_OUTFIT(ARG) && TCVAR:ARG:EVENT_CLOTHING_SET
	SIF CFLAG:ARG:現在位置 == CFLAG:MASTER:現在位置
		PRINTFORMDL %CALLNAME:ARG%换回了平时的衣服。
	CALL RESET_EVENT_CLOTHES(ARG)
ENDIF
TCVAR:ARG:DRESSED_FOR_BANQUET = 0

@ADD_BANQUET21_WEARING_TENNIS_OUTFIT(ARG)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTION
RETURNF CURRENT_CLOTHES_SET(ARG) == [[网球服套装]]
