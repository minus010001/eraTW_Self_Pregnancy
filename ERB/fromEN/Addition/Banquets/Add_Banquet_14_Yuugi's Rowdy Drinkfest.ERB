@ADD_BANQUET_SET_PARTICIPANTS14
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC BANQUET_INDEX
#DIM DYNAMIC BANQUET_SCALE
BANQUET_INDEX = ADD_BANQUET_INDEX(14)
BANQUET_SCALE = ADD_BANQUETS_SCALE:BANQUET_INDEX

CALL ADD_BANQUET_FILL_PARTICIPANTS(BANQUET_INDEX, 25, BANQUET_SCALE > 2500 ? 6 # 3) ;heavily leaning towards underground dwellers

