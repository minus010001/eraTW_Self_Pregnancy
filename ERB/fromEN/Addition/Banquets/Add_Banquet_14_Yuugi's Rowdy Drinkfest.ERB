@FADD_BANQUET14(ARG, O_DATA)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTIONS
#DIMS DYNAMIC O_DATA

SELECTCASE O_DATA
    CASE "NAME"
        RETURNF "勇仪的喧闹酒会"
    CASE "ACTIVITIES"
        RETURNF "饮酒聊天"
    CASE "TERM"
        RETURNF "宴会"
    CASE "CATEGORY"
        RETURNF "宴会"
    CASE "PRIORITY"
        RETURNF "3"
    CASE "HOST"
        RETURNF @"{[[勇儀]]}"
    CASE "HOST_LIST"
        RETURNF @"{[[勇儀]]}/{[[萃香]]}/{[[華扇]]}"
    CASE "GUEST_LIST"
        RETURNF ""
    CASE "BANNED_LIST"
        RETURNF @"{[[正邪]]}/{[[てゐ]]}"
    CASE "CONDITIONS"
        SIF CFLAG:[[勇儀]]:出禁 == 0 && DAY%7 == 4 && !(DAY:2 == 4 && DAY:3 > 25) && RAND:100 <= 20
            RETURNF "1"
        RETURNF "0"
    CASE "WEATHER_DEPENDENT"
        RETURNF "0"
    CASE "DRINKING"
        RETURNF "1"
    CASE "MUSIC_PERFORMANCE"
        RETURNF "1"
ENDSELECT
RETURNF ""

@ADD_BANQUET_PLANNING14
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC LOCATION
#DIM DYNAMIC SCALE
#DIM DYNAMIC START_TIME

LOCATION = P933酒場

SCALE = 500 + RAND:2500 ;unpredictable
START_TIME = CLOCK_TO_TIME(20, 0)

CALL ADD_BANQUET_CREATE(14, LOCATION, START_TIME, DAY+1, (SCALE / 10) + 300, SCALE)
LOCAL = RESULT ;banquet_index

SIF LOCAL < 0 ;couldn't create
    RETURN

PRINTL 
PRINTFORMW 听说%CALLNAME:[[勇儀]]%要在旧地狱开一场喧闹的酒会。
PRINTFORML 
CALL ADD_BANQUET_DRINKING_INITIALIZATION_DESCRIPTION(LOCAL)
SIF !MARK:[[勇儀]]:反発刻印
    CALLF Add_SPECIAL_REQUEST_CREATION([[勇儀]], 95, 70, 1, 1)
SIF !MARK:[[萃香]]:反発刻印
    CALLF Add_SPECIAL_REQUEST_CREATION([[萃香]], 95, 70, 1, 1)
SIF !MARK:[[華扇]]:反発刻印
    CALLF Add_SPECIAL_REQUEST_CREATION([[華扇]], 95, 70, 1, 1)
ADD_BANQUETS_INVITED:LOCAL = ADD_BANQUET_INVITE_INVITED

@ADD_BANQUET_START14
#LOCALSIZE 1
#LOCALSSIZE 1
CALL ADD_BANQUET_DRESS_UP(14)

