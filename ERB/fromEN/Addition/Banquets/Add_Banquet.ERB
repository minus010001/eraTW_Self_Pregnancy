@ADD_BANQUET_WEATHER_CHECK(BANQUET_INDEX)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC BANQUET_INDEX
#DIM DYNAMIC BANQUET_ID
#DIM DYNAMIC PRESENT
#DIM DYNAMIC INVITED
BANQUET_ID = ADD_BANQUETS_UPCOMING:BANQUET_INDEX
PRESENT = CFLAG:MASTER:現在位置 ==  GET_MAP_REPLACEMENT(ADD_BANQUETS_LOCATION:BANQUET_INDEX)
INVITED = ADD_BANQUETS_INVITED:BANQUET_INDEX > 0
SIF !BANQUET_ID
    RETURN
SIF !GROUPMATCH(ADD_BANQUETS_STATUS:BANQUET_INDEX, ADD_BANQUET_STATE_PREPARING, ADD_BANQUET_STATE_IN_PROGRESS)
    RETURN
SIF !GETMETH_INT(0, "ADD_BANQUET", BANQUET_ID, "WEATHER_DEPENDENT")
    RETURN
SIF ADD_BANQUETS_LOCATION:BANQUET_INDEX == GETMETH_INT(0, "ADD_BANQUET", BANQUET_ID, "ALTERNATIVE_INDOOR_LOCATION")
    RETURN
SIF TIME:5 < 4
    RETURN

IF TIME:5 >= 4 && CFLAG:[[天子]]:BANQUET == BANQUET_ID
	SIF INVITED || PRESENT
		PRINTFORMW %GETMETH_STR(0, "ADD_BANQUET", BANQUET_ID, "NAME")%似乎要因为恶劣天气而取消了，但天子的力量驱散了乌云。
	TIME:5 = 0
	WIND_VELOCITY = 0
	FORBIDDEN_CHANGE_WEATHER = 1
	CALL qol_FORCESET_REGION_WEATHER_SYSTEM
	CALL qol_FORCESET_REGION_RAINBOW_SYSTEM
	CALL qol_FORCESET_REGION_WIND_VE_SYSTEM
ELSEIF TIME:5 >= 4
    IF ITEM:ウェザー・リポート && !FLAG:異常気象 && INVITED
        PRINTFORML %GETMETH_STR(0, "ADD_BANQUET", BANQUET_ID, "NAME")%似乎要因为天气原因而取消了。
        PRINTFORML 要使用%ITEMNAME_TR(GETNUM(ITEM, "ウェザー・リポート"))%来驱散恶劣天气吗？
        CALL ASK_YN
        IF !RESULT
            PRINTFORMDL 『Weather Report』！
            PRINTFORMDW 天气立刻放晴，%GETMETH_STR(0, "ADD_BANQUET", BANQUET_ID, "NAME")%得以照常进行。
            TIME:5 = 0
            WIND_VELOCITY = 0
            FORBIDDEN_CHANGE_WEATHER = 1
            CALL qol_FORCESET_REGION_WEATHER_SYSTEM
            CALL qol_FORCESET_REGION_RAINBOW_SYSTEM
            CALL qol_FORCESET_REGION_WIND_VE_SYSTEM
            ITEM:ウェザー・リポート--
            RETURN
        ENDIF
    ENDIF
    
	PRINTL  
    IF GETMETH_INT(0, "ADD_BANQUET", BANQUET_ID, "ALTERNATIVE_INDOOR_LOCATION")
        ADD_BANQUETS_LOCATION:BANQUET_INDEX = GETMETH_INT(0, "ADD_BANQUET", BANQUET_ID, "ALTERNATIVE_INDOOR_LOCATION")
        SIF INVITED || PRESENT
			PRINTFORMW 因为天气原因，%GETMETH_STR(0, "ADD_BANQUET", BANQUET_ID, "NAME")%改在了%ADD_BANQUET_LOCATION(BANQUET_INDEX)%举行。
        IF PRESENT && INVITED
            PRINTFORML 大家匆忙收拾东西，准备搬到新场地去。
            PRINTFORML 要帮忙吗？
            CALL ASK_YN
            IF !RESULT
                CFLAG:MASTER:現在位置 = GET_MAP_REPLACEMENT(ADD_BANQUETS_LOCATION:BANQUET_INDEX)
                CFLAG:MASTER:デート中 = GET_MAPID(CFLAG:MASTER:現在位置)
                PRINTFORMW 你拿起一些东西，跟着大家来到了%ADD_BANQUET_LOCATION(BANQUET_INDEX)%。
            ELSE
                PRINTFORMW 你没有跟去，留在了原地。
            ENDIF
            CALL ADD_BANQUET_STATUS_CHECK(BANQUET_INDEX)
        ENDIF
    ELSE
        PRINTFORMW 很遗憾，%GETMETH_STR(0, "ADD_BANQUET", BANQUET_ID, "NAME")%因恶劣天气而取消了。

        ADD_BANQUETS_STATUS:BANQUET_INDEX = ADD_BANQUET_STATE_CANCELLED
        FOR LOCAL, 1, CHARANUM
            IF CFLAG:LOCAL:BANQUET == BANQUET_ID
                CALL ADD_BANQUET_END_PARTICIPATION(LOCAL)
            ENDIF
        NEXT
    ENDIF
ENDIF

