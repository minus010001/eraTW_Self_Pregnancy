;mostly common functions used for the old banquets
@ADD_BANQUET_DRINKING(ARG, LAPSE)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC LAPSE

SIF LAPSE <= 0
	RETURN

SIF !CFLAG:ARG:BANQUET
	RETURN
BASE:ARG:仕事量 = MAX(BASE:ARG:仕事量 - LAPSE * 10, 0)
;宴会で呑んでる場合酒気が上昇
SIF CFLAG:ARG:職種 == 49 && !(TALENT:ARG:酒耐性 == -2 || CFLAG:ARG:妊娠自覚状態 == 1)
	BASE:ARG:酒気 += LAPSE * (RAND:3 * (4 - TALENT:ARG:酒耐性))

IF CFLAG:ARG:BANQUET_ROLE < ADD_BANQUET_ROLE_HOST && (BASE:ARG:仕事量 == 0 || CFLAG:ARG:睡眠)
	IF BASE:ARG:酒気 > (MAXBASE:ARG:酒気 / 10) * 8
		; chs 扩展：烂醉中间态——保留 BANQUET 身份，标记醉倒（与旧 ENKAI 的 CHARA_ACTION_DRUNK 行为一致）
		CFLAG:ARG:職種 = JOB_酔いつぶれる
		CFLAG:ARG:行動 = 5
		TCVAR:ARG:泥酔 = 1
		TCVAR:ARG:烂醉 = 1
	ELSE
		; 酒气不高：自然退出
		CALL ADD_BANQUET_END_PARTICIPATION(ARG)
	ENDIF
ENDIF

@ADD_BANQUET_DRINKING_DESCRIPTIONS(ARG)
#LOCALSIZE 1
#LOCALSSIZE 1
IF TCVAR:ARG:泥酔 == 0
	IF CFLAG:ARG:職種 == 49 && TALENT:ARG:恋慕
		PRINTFORML %CALLNAME:ARG%一边享受着宴会一边时不时看向%CALLNAME:MASTER%
	ELSE
		PRINTFORML %CALLNAME:ARG%享受着宴会
	ENDIF
ELSE
	IF TALENT:ARG:恋慕
		PRINTFORML %CALLNAME:ARG%虽然喝得酩酊大醉但也不时往%CALLNAME:MASTER%所在的方向望去
	ELSE
		PRINTFORML %CALLNAME:ARG%喝了个烂醉整个人趴了下去
	ENDIF
ENDIF
IF CFLAG:ARG:職種 == 51 && (BASE:ARG:酒気 > (MAXBASE:ARG:酒気 / 10) * 8)
	PRINTFORML 　好像还醉醺醺的样子…
ELSEIF CFLAG:ARG:職種 == 51 && (BASE:ARG:酒気 > (MAXBASE:ARG:酒気 / 10) * 6)
	PRINTFORML 　好像离酒醒还需要一段时间…
ELSEIF CFLAG:ARG:職種 == 51
	PRINTFORML 　应该快要从醉意中清醒过来了…
ELSEIF CFLAG:ARG:職種 == 49 && (BASE:ARG:酒気 > (MAXBASE:ARG:酒気 / 10) * 6) 
	IF TALENT:ARG:感情乏しい && RAND:4
		ELSEIF !RAND:10
			IF !RAND:2
				PRINTFORML 　%CALLNAME:ARG%眼神呆滞…好像喝醉了的样子
				PRINTFORML 　酒精似乎不太对劲…
					TALENT:ARG:15 = -1
			ELSE
				PRINTFORML 　%CALLNAME:ARG%看上去非常开心
				PRINTFORML 　状态良好的来回敬酒的样子
					TALENT:ARG:15 = 1
			ENDIF
		ELSE
			IF TALENT:ARG:15 == -1
				PRINTFORML 　%CALLNAME:ARG%一个人孤零零地待着…
			ELSEIF TALENT:ARG:15 == 1
				PRINTFORML 　%CALLNAME:ARG%意义不明的笑着…
			ELSE
				PRINTFORML 　%CALLNAME:ARG%差不多要醉倒了的样子…
			ENDIF
		ENDIF
ELSEIF CFLAG:ARG:職種 == 49 && (BASE:ARG:酒気 > (MAXBASE:ARG:酒気 / 10) * 4)
	PRINTFORML 　酒过三巡、气氛开始变好了…
ELSEIF TALENT:ARG:酒耐性 == -2 || CFLAG:ARG:妊娠自覚状態 == 1
	IF BASE:ARG:仕事量 >= (MAXBASE:ARG:仕事量 / 3) * 2
		PRINTFORML 　%CALLNAME:ARG%并没有在喝酒而在跟周围的人谈笑风生…
	ELSEIF BASE:ARG:仕事量 >= (MAXBASE:ARG:仕事量 / 3)
		IF CFLAG:ARG:妊娠自覚状態 == 1
			PRINTFORML 　%CALLNAME:ARG%坚决不喝酒并享受着…
		ELSEIF TALENT:ARG:酒耐性 == -2
			PRINTFORML 　%CALLNAME:ARG%还是老样子滴酒不沾…
		ENDIF
	ELSEIF TALENT:ARG:酒耐性 == -2 || CFLAG:ARG:妊娠自覚状態 == 1
		PRINTFORML 　%CALLNAME:ARG%坚决不碰一滴酒精的模样…
	ENDIF
ELSEIF CFLAG:ARG:職種 == 49 
	PRINTFORML 　%CALLNAME:ARG%还很能喝呢…
ENDIF


@ADD_BANQUET_DRINKING_PREPARATION_WORKLOAD(ARG, BANQUET_INDEX)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC BANQUET_INDEX
#DIM DYNAMIC SCALE
#DIM DYNAMIC WORKLOAD
SCALE = ADD_BANQUETS_SCALE:BANQUET_INDEX
WORKLOAD = ADD_BANQUET_TIME_UNTIL(BANQUET_INDEX) * 10

IF CFLAG:ARG:職種 != JOB_宴会準備
	MAXBASE:ARG:仕事量 = MIN(WORKLOAD, 2400)
	BASE:ARG:仕事量 = MAXBASE:ARG:仕事量
	CFLAG:ARG:職種 = JOB_宴会準備
	TCVAR:ARG:手伝えない = 2
	CFLAG:ARG:行動 = 5
ENDIF

@ADD_BANQUET_DRINKING_WORKLOAD(ARG, SCALE)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC SCALE
;それぞれが飲むペースを変えるので、宴の規模に応じて仕事量が変化
IF CFLAG:ARG:職種 != JOB_宴会参加 && TCVAR:ARG:泥酔 == 0
	MAXBASE:ARG:仕事量 = SCALE
	;最大値、通常7200(半日)・酒呑み神なら制限なし
	SIF MAXBASE:ARG:仕事量 >= 7200 && TALENT:ARG:酒耐性 != 3
		MAXBASE:ARG:仕事量 = 7200
	MAXBASE:ARG:仕事量 += RAND:500
	IF TALENT:ARG:酒耐性 == -1
		TIMES MAXBASE:ARG:仕事量, 0.75
	ELSEIF TALENT:ARG:酒耐性 == 1
		TIMES MAXBASE:ARG:仕事量, 1.25
	ELSEIF TALENT:ARG:酒耐性 == 2
		TIMES MAXBASE:ARG:仕事量, 1.5
	ELSEIF TALENT:ARG:酒耐性 == 3
		TIMES MAXBASE:ARG:仕事量, 2.0
	ENDIF
	BASE:ARG:仕事量 = MAXBASE:ARG:仕事量
	CFLAG:ARG:職種 = JOB_宴会参加
	CFLAG:ARG:行動 = 5
	TCVAR:ARG:手伝えない = 1
ENDIF

RETURN 1

