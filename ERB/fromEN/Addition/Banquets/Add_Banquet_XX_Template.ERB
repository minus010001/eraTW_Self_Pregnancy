;=============================================================================
; ADD_BANQUET 宴会模板 — Add_Banquet_XX.ERB
;=============================================================================
;
; 本文件是 ADD_BANQUET 框架的宴会定义模板。
; 创建新宴会时，将 XX 替换为宴会 ID（1~99），按需实现各函数。
; 框架通过 GETMETH_STR/GETMETH_INT 查询 O_DATA 属性，
; 通过 CALLFORM/TRYCCALLFORM 调用各钩子函数。
;
; 宴会 ID 分配规则：
;   1~16   pedy-tw 原版宴会
;   17~20  预留
;   21~22  pedy-tw 运动类/夏日类（暂缓）
;   23     月兔祭
;   24~30  预留
;   31     婚礼宴会
;   32~40  预留
;   41~42  chs 独有宴会
;   43~99  可用
;
; 宴会类型与通用函数选择：
;   饮酒类 → 使用 Add_Banquet_Drinking_Common.ERB 中的 DRINKING_* 系列通用函数
;   演出类 → 自行实现 PROGRESS/VISIT/WORKLOAD 等函数（参考宴会 5/11）
;
;=============================================================================

;=============================================================================
; §1  OBJ 数据函数（必须实现）
;=============================================================================
; 函数名：@FADD_BANQUET{XX}(ARG, O_DATA)
; 框架通过 GETMETH_STR/GETMETH_INT(0, "ADD_BANQUET", XX, "键名") 查询。
; 返回值类型：#FUNCTIONS（统一返回字符串，数值键返回 "0"/"1"/"42" 等）
[SKIPSTART]
@FADD_BANQUET{XX}(ARG, O_DATA)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTIONS
#DIMS DYNAMIC O_DATA

SELECTCASE O_DATA

	;--- 必须属性 ---

	CASE "NAME"
		; 宴会名称，用于所有显示场景
		; 例：RETURNF "灵梦一时兴起的酒宴"
		RETURNF "【宴会名称】"

	CASE "CONDITIONS"
		; 触发条件，返回 "1" 表示本回合应创建此宴会
		; 每回合 EVENTTURNEND/INFO 中 ADD_BANQUET_CHECK 会查询此属性
		; 仅在 ADD_BANQUET_INDEX(XX) < 0（尚未创建）时检查
		; 例：SIF DAY%7 == 6 && RAND:100 <= 40 \n RETURNF "1"
		RETURNF "0"

	CASE "HOST"
		; 主催者角色编号（单个），用于天气检查等
		; 例：RETURNF @"{[[霊夢]]}"
		RETURNF @"{【主催者角色编号】}"

	CASE "HOST_LIST"
		; 主催者列表，"/" 分隔的角色编号字符串
		; FILL_PARTICIPANTS 中被设为 BANQUET_ROLE=2（主催）
		; 例：RETURNF @"{[[霊夢]]}/{[[る～こと]]}/{[[魔理沙]]}"
		RETURNF @"{【主催者1】}/{【主催者2】}"

	CASE "GUEST_LIST"
		; 必定邀请的客人列表，"/" 分隔
		; FILL_PARTICIPANTS 中被设为 BANQUET_ROLE=1（客人）
		; 空字符串 = 无必定客人
		RETURNF @"{【客人1】}"

	CASE "BANNED_LIST"
		; 禁止参加的角色列表，"/" 分隔
		; 空字符串 = 无禁止角色
		RETURNF ""

	;--- 可选属性（不实现则返回 ""，框架按默认值处理）---

	CASE "ACTIVITIES"
		; 活动描述，用于 ADD_BANQUET_CHARA_STATE 显示
		; 例："饮酒聊天" / "听经" / "听音乐"
		RETURNF "饮酒"

	CASE "TERM"
		; 宴会简称，用于 ADD_BANQUET_TERM() 返回值
		; JOB_DEPICTION 中 "准备着{TERM}" / "收拾着{TERM}的残局"
		; 例："宴会" / "演唱会" / "读经Live"
		RETURNF "宴会"

	CASE "CATEGORY"
		; 类别标签，用于显示分类
		RETURNF "宴会"

	CASE "PRIORITY"
		; 优先级（数值越小越高），影响多宴会冲突时的选择
		; 默认 "3"
		RETURNF "3"

	CASE "NOTIFY_PLAYER"
		; 是否通知玩家宴会创建，"1"=通知
		; 目前仅在 PLANNING 函数中手动 PRINT，此属性暂未被框架查询
		RETURNF "1"

	CASE "WEATHER_DEPENDENT"
		; 是否受天气影响，"1"=是
		; 为 1 时：①恶劣天气可能取消；②天子/Weather Report 可改天气
		; 为 0 时：天气不影响此宴会
		RETURNF "1"

	CASE "ALTERNATIVE_INDOOR_LOCATION"
		; 恶劣天气时的室内替代地点（角色编号形式）
		; 仅 WEATHER_DEPENDENT=1 时有效
		; 为空或 "0" = 无替代地点 → 恶劣天气直接取消
		; 例：RETURNF @"{P9居間}"
		RETURNF ""

	CASE "KEEP_AWAKE"
		; 是否阻止参与者入睡，"1"=是
		; 为 1 时：PREPARING/IN_PROGRESS 阶段参与者不会被睡眠系统影响
		RETURNF "0"

	CASE "DRINKING"
		; 是否允许交杯指令（COMF334），"1"=允许
		; ADD_BANQUET_ACTIVITY_ALLOWED("DRINKING") 查询此值
		RETURNF "1"

	CASE "MUSIC_PERFORMANCE"
		; 是否允许演奏指令（COMF416），"1"=允许
		; ADD_BANQUET_ACTIVITY_ALLOWED("MUSIC_PERFORMANCE") 查询此值
		RETURNF "0"

	CASE "WATERMELON"
		; 是否允许劈西瓜指令（COMF484），"1"=允许
		; ADD_BANQUET_ACTIVITY_ALLOWED("WATERMELON") 查询此值
		RETURNF "0"

	CASE "LISTEN_TO_MUSIC"
		; 是否有"听演奏"指令（Add_CUSTOM_COM5），"1"=有
		; 仅演出类宴会需要
		RETURNF "0"

	CASE "PERFORMERS"
		; 演出者列表，"/" 分隔的角色编号字符串
		; ADD_BANQUET_IS_PERFORMER(ARG, BANQUET_ID) 通过 STRCOUNT 检查
		; 仅 LISTEN_TO_MUSIC=1 的演出类宴会需要
		; 例：RETURNF @"{[[ミスティア]]}/{[[響子]]}"
		RETURNF ""

ENDSELECT
RETURNF ""

;=============================================================================
; §2  规划函数（必须实现）
;=============================================================================
; 函数名：@ADD_BANQUET_PLANNING{XX}
; 触发时机：ADD_BANQUET_CHECK 检测到 CONDITIONS=1 时调用
; 职责：确定地点/规模/开始时间，调用 ADD_BANQUET_CREATE 创建宴会

@ADD_BANQUET_PLANNING{XX}
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC LOCATION
#DIM DYNAMIC SCALE
#DIM DYNAMIC START_TIME

; --- 地点选择 ---
; 使用 P** 常量指定地点（定义在 AutoConst_PLACE.ERH）
LOCATION = 【地点常量】

; --- 规模 ---
; 影响参加人数、工作量、描写文本
; 典型值：500~5000（饮酒类），1000~3000（演出类）
SCALE = 1000 + RAND:1500

; --- 开始时间 ---
; 一天 = 1440 分钟，0:00=0, 6:00=360, 12:00=720, 18:00=1080, 21:00=1260
; CLOCK_TO_TIME(时, 分) 可辅助计算
START_TIME = 【开始时间】

; --- 创建宴会 ---
; ADD_BANQUET_CREATE(ID, 地点, 开始时间, 开始日, 持续时间, 规模)
; 返回值：banquet_index（-1=创建失败）
; 持续时间单位：分钟
CALL ADD_BANQUET_CREATE({XX}, LOCATION, START_TIME, DAY+1, (SCALE / 10) + 300, SCALE)
LOCAL = RESULT

SIF LOCAL < 0
	RETURN

; --- 邀请状态 ---
; ADD_BANQUET_INVITE_INVITED = 已邀请
; ADD_BANQUET_INVITE_NOT_INVITED = 未邀请
; ADD_BANQUET_INVITE_STAFF = 工作人员
ADD_BANQUETS_INVITED:LOCAL = ADD_BANQUET_INVITE_INVITED

; --- 通知文本 ---
PRINTL  
PRINTFORMW 【通知文本：宴会已创建】
PRINTFORML 

; --- 饮酒类通用初始化描写（可选） ---
; 显示时间地点+规模描述+天气警告
; CALL ADD_BANQUET_DRINKING_INITIALIZATION_DESCRIPTION(LOCAL)

; --- 自定义初始化描写（可选） ---
; PRINTFORMW %ADD_BANQUET_TIME_AND_PLACE_DESCRIPTION(LOCAL)%

;=============================================================================
; §3  开始/结束钩子（必须实现，可为空）
;=============================================================================

;--- 宴会开始时调用（状态变为 IN_PROGRESS）---
; 典型用途：换装
; 饮酒类通用换装：CALL ADD_BANQUET_DRESS_UP({XX})
; 自定义换装：遍历参与者 CALL ADD_BANQUET_SET_OUTFIT{XX}(LOCAL)

@ADD_BANQUET_START{XX}
#LOCALSIZE 1
#LOCALSSIZE 1
CALL ADD_BANQUET_DRESS_UP({XX})

;--- 宴会结束时调用（状态变为 FINISHED 后）---
; 典型用途：换回原装
; 饮酒类通用换回：CALL ADD_BANQUET_DRESS_DOWN({XX})
; 自定义换回：遍历参与者 CALL ADD_BANQUET_RESET_OUTFIT{XX}(LOCAL)

@ADD_BANQUET_FINISH{XX}
#LOCALSIZE 1
#LOCALSSIZE 1
CALL ADD_BANQUET_DRESS_DOWN({XX})

