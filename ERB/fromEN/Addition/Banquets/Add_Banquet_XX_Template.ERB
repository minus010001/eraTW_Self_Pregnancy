;=============================================================================
; §11 框架工具函数速查
;=============================================================================
;
; ADD_BANQUET_INDEX(BANQUET_ID)
;   返回宴会在 ADD_BANQUETS_UPCOMING 数组中的索引，-1=不存在
;
; ADD_BANQUET_CREATE(ID, 地点, 开始时间, 开始日, 持续时间, 规模)
;   创建宴会，返回 banquet_index，-1=失败
;
; ADD_BANQUET_FILL_PARTICIPANTS(BANQUET_INDEX, ResidentRate, VisitorRate)
;   填充参与者：HOST_LIST→主催, GUEST_LIST→客人, 其余按概率
;
; ADD_BANQUET_DRESS_UP(BANQUET_ID)
;   通用换装：遍历参与者调用 宴会服决定 + SET_EVENT_CLOTHES
;
; ADD_BANQUET_DRESS_DOWN(BANQUET_ID)
;   通用换回：遍历参与者调用 RESET_EVENT_CLOTHES
;
; ADD_BANQUET_TIME_AND_PLACE_DESCRIPTION(BANQUET_INDEX)
;   返回时间地点描述字符串
;
; ADD_BANQUET_TIME_UNTIL(BANQUET_INDEX)
;   返回距宴会开始的剩余分钟数（负值=已开始）
;
; ADD_BANQUET_LOCATION(BANQUET_INDEX)
;   返回地点名称字符串
;
; ADD_BANQUET_PARTICIPANT_COUNT(BANQUET_INDEX)
;   返回当前参与者人数
;
; ADD_BANQUET_CHARA_STATE(CHARA)
;   返回角色宴会状态：0=无, 1=准备中, 2=参加中
;
; ADD_BANQUET_TERM(BANQUET_ID)
;   返回宴会简称（O_DATA "TERM" 的值）
;
; ADD_BANQUET_ACTIVITY_ALLOWED(ACTIVITY)
;   检查当前场地宴会是否允许指定活动
;   ACTIVITY: "DRINKING"/"MUSIC_PERFORMANCE"/"WATERMELON"
;
; ADD_BANQUET_IS_PERFORMER(ARG, BANQUET_ID)
;   检查角色是否为演出者（O_DATA "PERFORMERS" 中包含）
;
; ADD_BANQUET_END_PARTICIPATION(ARG)
;   结束角色参与：清除 BANQUET/BANQUET_ROLE/宴会参加
;
; ADD_BANQUET_PREVENT_MOVEMENT()
;   阻止宴会参与者离开场地
;
; ADD_BANQUET_ARRIVAL()
;   检查玩家是否到达宴会场地
;
; ADD_BANQUET_KOJO_MESSAGE_PARTICIPANTS(BANQUET_ID, SCENE)
;   向所有在场参与者发送口上事件
;   SCENE: "IDLE"/"MEET_PLAYER"
;
; --- 饮酒类通用函数（Add_Banquet_Drinking_Common.ERB）---
;
; ADD_BANQUET_DRINKING_PROGRESS(BANQUET_INDEX)
;   饮酒类通用进度：酒气上升+工作量递减+醉倒+描写
;
; ADD_BANQUET_DRINKING_VISIT(PREVIOUS_STATE, BANQUET_INDEX)
;   饮酒类通用到达描写
;
; ADD_BANQUET_DRINKING_PREPARATION_TEXT(CHARA, LOCATION)
;   饮酒类通用准备文本
;
; ADD_BANQUET_DRINKING_JOIN_TEXT(CHARA, LOCATION)
;   饮酒类通用参加文本
;
; ADD_BANQUET_DRINKING_PREPARATION_WORKLOAD(ARG, BANQUET_INDEX)
;   饮酒类通用准备工作量
;
; ADD_BANQUET_DRINKING_WORKLOAD(ARG, SCALE)
;   饮酒类通用参加工作量（受酒耐性影响）
;
; ADD_BANQUET_DRINKING_INITIALIZATION_DESCRIPTION(BANQUET_INDEX)
;   饮酒类通用创建描写（时间地点+规模+天气警告）
;
; ADD_BANQUET_DRINKING_MESSAGE_TALK(BANQUET_INDEX)
;   饮酒类通用对话文本
;
; ADD_BANQUET_DRINKING(ARG, LAPSE)
;   饮酒核心逻辑：酒气上升+工作量递减+退出判定
;
; ADD_BANQUET_DRINKING_DESCRIPTIONS(ARG)
;   饮酒类宴会描写（職種 49/51 的描写由此处触发，非 JOB_DEPICTION）
;
;=============================================================================
; §12 職種编号速查
;=============================================================================
;
; JOB_宴会準備 (48)  — 准备阶段，由 WORKLOAD_PREPARATION 设置
; JOB_宴会参加 (49)  — 参加阶段，由 WORKLOAD_PARTICIPATION 设置
; JOB_宴会の片づけ (50) — 收拾阶段，由 STATUS_CHECK(FINISHED) 设置
; JOB_酔いつぶれる (51) — 醉倒，由 DRINKING 系统自动设置
; JOB_遊び (46)      — 玩耍
; JOB_女子会 (52)    — 女子会
;
; 描写路径：
;   48/50/46/52/普通 → JOB_DEPICTION（仕事情景描写）
;   49/51            → ADD_BANQUET_DRINKING_DESCRIPTIONS（ADD_BANQUET_PROGRESS 调用链）
;   旧 宴会描写      → 死代码（TFLAG:宴会場 永远为 0）
;
;=============================================================================
