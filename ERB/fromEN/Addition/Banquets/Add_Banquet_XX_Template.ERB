;=============================================================================
; §7  参与者设置（必须实现）
;=============================================================================
; 函数名：@ADD_BANQUET_SET_PARTICIPANTS{XX}
; 触发时机：BEFORETRAIN 中 ADD_BANQUET_SET_PARTICIPANTS 调用
; 职责：调用 ADD_BANQUET_FILL_PARTICIPANTS 设置 HOST/GUEST/BANNED + 随机参与者

@ADD_BANQUET_SET_PARTICIPANTS{XX}
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC BANQUET_INDEX
#DIM DYNAMIC BANQUET_SCALE
BANQUET_INDEX = ADD_BANQUET_INDEX({XX})
BANQUET_SCALE = ADD_BANQUETS_SCALE:BANQUET_INDEX

; --- ADD_BANQUET_FILL_PARTICIPANTS(BANQUET_INDEX, ResidentRate, VisitorRate) ---
; ResidentRate：同地图居民参加概率（0~100）
; VisitorRate：其他地图访客参加概率（0~100）
; HOST_LIST/GUEST_LIST/BANNED_LIST 由 O_DATA 自动读取
; 不在上述列表中的角色按 ResidentRate/VisitorRate 随机决定
; 若需自定义概率逻辑，实现 ADD_BANQUET_PARTICIPANT_JOIN_CHECK{XX}
CALL ADD_BANQUET_FILL_PARTICIPANTS(BANQUET_INDEX, 7, 7)

