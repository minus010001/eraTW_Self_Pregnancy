@FADD_BANQUET7(ARG, O_DATA)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTIONS
#DIMS DYNAMIC O_DATA

SELECTCASE O_DATA
    CASE "NAME"
        RETURNF "畜生界的和平亲睦会"
    CASE "ACTIVITIES"
        RETURNF "饮酒聊天"
    CASE "TERM"
        RETURNF "宴会"
    CASE "CATEGORY"
        RETURNF "宴会"
    CASE "PRIORITY"
        RETURNF "3"
    CASE "HOST"
        RETURNF @"{ADD_BANQUET_7_ORGANIZER()}"
    CASE "HOST_LIST"
        RETURNF @"{[[ちやり]]}/{[[美天]]}/{[[慧ノ子]]}"
    CASE "GUEST_LIST"
        RETURNF @"{[[八千慧]]}/{[[早鬼]]}/{[[尤魔]]}"
    CASE "BANNED_LIST"
        RETURNF @"{[[正邪]]}/{[[小兎姫]]}/{[[袿姫]]}/{[[磨弓]]}"
    CASE "CONDITIONS"
        SIF CFLAG:[[八千慧]]:出禁 || CFLAG:[[早鬼]]:出禁 || CFLAG:[[尤魔]]:出禁
            RETURNF "0"
        SIF CFLAG:[[ちやり]]:出禁 || CFLAG:[[美天]]:出禁 || CFLAG:[[慧ノ子]]:出禁
            RETURNF "0"
        SIF DAY:2 == 4
            RETURNF "0"
        SIF DAY:3 != 4
            RETURNF "0"
        RETURNF "1"
    CASE "WEATHER_DEPENDENT"
        RETURNF "0"
    CASE "DRINKING"
        RETURNF "1"
    CASE "MUSIC_PERFORMANCE"
        RETURNF "1"
ENDSELECT
RETURNF ""

@ADD_BANQUET_PLANNING7
#LOCALSIZE 2
#LOCALSSIZE 1
#DIM DYNAMIC LOCATION
#DIM DYNAMIC SCALE
#DIM DYNAMIC START_TIME
#DIM DYNAMIC L_BOSS_HIT
#DIM DYNAMIC L_BOSS_LIST, 10
#DIM DYNAMIC L_BOSS
#DIMS DYNAMIC L_MESSENGER
#DIMS DYNAMIC L_MESSENGER_TMP

LOCATION = ADD_BANQUET_7_VENUE()
SCALE = 2000
START_TIME = 1100 + RAND:41

CALL ADD_BANQUET_CREATE(7, LOCATION, START_TIME, DAY+3, (SCALE / 10) + 300, SCALE)
LOCAL = RESULT

SIF LOCAL < 0
    RETURN

ADD_BANQUETS_INVITED:LOCAL = ADD_BANQUET_INVITE_INVITED

VARSET L_BOSS_HIT, 0
VARSET L_MESSENGER
VARSET L_BOSS_LIST, -1

L_BOSS_HIT = ADD_BANQUET_7_FAMILIAR("BOSS")
FOR LOCAL:1, 0, L_BOSS_HIT
    L_BOSS_LIST:(LOCAL:1) = RESULT:(LOCAL:1)
    IF MATCH(L_BOSS_LIST, L_BOSS_LIST:(LOCAL:1))
        SELECTCASE L_BOSS_LIST:(LOCAL:1)
            CASE [[八千慧]]
                L_MESSENGER_TMP = 水獭灵
            CASE [[早鬼]]
                L_MESSENGER_TMP = 野狼灵
            CASE [[尤魔]]
                L_MESSENGER_TMP = 大鹫灵
        ENDSELECT
        IF L_MESSENGER == ""
            L_MESSENGER = %L_MESSENGER_TMP%
        ELSE
            L_MESSENGER = %L_MESSENGER%和%L_MESSENGER_TMP%
        ENDIF
    ENDIF
NEXT

PRINTL 
SELECTCASE L_BOSS_HIT
    CASE 0
        PRINTFORML 畜生界三大组织好像要开一场和平的酒会了
        PRINTFORML 为什么区区一次喝酒聚会还要特意强调「和平」两个字……完全搞不懂。总之先记下来吧……
    CASEELSE
        IF L_BOSS_HIT == 1
            PRINTFORML %CALLNAME:(L_BOSS_LIST:0)%麾下的%L_MESSENGER%送来了邀请
            PRINTFORML 说是畜生界三大组织联合举办的酒会
        ELSE
            PRINTFORML %L_MESSENGER%争先恐后地把邀请函塞了过来
            PRINTFORML 据说每一位都是各自老大派来的使者
        ENDIF
        PRINTFORML 虽然是内部聚会，但他们愿意带我这个外人进去
        PRINTFORML 总之先记在心里好了
ENDSELECT
WAIT
PRINTFORML 
CALL ADD_BANQUET_DRINKING_INITIALIZATION_DESCRIPTION(LOCAL)

@ADD_BANQUET_START7
#LOCALSIZE 1
#LOCALSSIZE 1
CALL ADD_BANQUET_DRESS_UP(7)

@ADD_BANQUET_FINISH7
#LOCALSIZE 1
#LOCALSSIZE 1
