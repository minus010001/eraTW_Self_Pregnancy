@ADD_BANQUET_7_FAMILIAR(ARGMODE = "ALL")
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTION
#DIM CNT
#DIM L_MAXCNT
#DIM L_HITNUM
#DIM L_CHRLIST, 10
#DIM CONST CON_INTIMACY_THRESHOLD = 6
#DIMS ARGMODE

VARSET L_CHRLIST, -1

SELECTCASE ARGMODE
    CASE "BOSS"
        L_CHRLIST = [[八千慧]], [[早鬼]], [[尤魔]]
    CASE "SUBORDINATE"
        L_CHRLIST = [[ちやり]], [[美天]], [[慧ノ子]]
    CASE "ALL"
        L_CHRLIST = [[八千慧]], [[早鬼]], [[尤魔]], [[ちやり]], [[美天]], [[慧ノ子]]
    CASEELSE
        THROW ADD_BANQUET_7_FAMILIAR: unexpected ARGMODE=%ARGMODE%
ENDSELECT

L_HITNUM = 0

L_MAXCNT = FINDELEMENT(L_CHRLIST, -1)
SIF L_MAXCNT == -1
    L_MAXCNT = VARSIZE("L_CHRLIST")

FOR CNT, 0, L_MAXCNT
    IF ABL:(L_CHRLIST:CNT):親密 >= CON_INTIMACY_THRESHOLD
        RESULT:L_HITNUM = L_CHRLIST:CNT
        L_HITNUM++
    ENDIF
NEXT

RETURNF L_HITNUM
