@ADD_BANQUET_VISIT7(PREVIOUS_STATE)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC PREVIOUS_STATE
#DIM DYNAMIC BANQUET_INDEX
#DIM DYNAMIC CURRENT_STATE
#DIM DYNAMIC L_FAMILIAR_NUM
#DIM DYNAMIC L_FAMILIAR_LIST, 10
#DIM DYNAMIC CNT
#DIMS DYNAMIC L_FAMILIAR_NAMES

BANQUET_INDEX = ADD_BANQUET_INDEX(7)
CURRENT_STATE = ADD_BANQUETS_STATUS:BANQUET_INDEX

IF CURRENT_STATE == ADD_BANQUET_STATE_IN_PROGRESS && PREVIOUS_STATE == ADD_BANQUET_STATE_PREPARING
    VARSET L_FAMILIAR_LIST, -1
    L_FAMILIAR_NUM = ADD_BANQUET_7_FAMILIAR("BOSS")
    SIF L_FAMILIAR_NUM == 0
        L_FAMILIAR_NUM = ADD_BANQUET_7_FAMILIAR("SUBORDINATE")
    FOR CNT, 0, L_FAMILIAR_NUM
        L_FAMILIAR_LIST:CNT = RESULT:CNT
    NEXT
    L_FAMILIAR_NAMES = 

    PRINTL 
    PRINTFORMW 剑拔弩张的气氛中，三大组织的酒会正式开始了！
    PRINTL 

    IF L_FAMILIAR_NUM == 0
        ;nop
    ELSEIF GROUPMATCH(L_FAMILIAR_LIST, [[八千慧]], [[早鬼]], [[尤魔]]) > 0
        SIF GROUPMATCH(L_FAMILIAR_LIST, [[八千慧]])
            L_FAMILIAR_NAMES = %CALLNAME:[[八千慧]]%
        IF GROUPMATCH(L_FAMILIAR_LIST, [[早鬼]])
            IF L_FAMILIAR_NAMES == ""
                L_FAMILIAR_NAMES = %CALLNAME:[[早鬼]]%
            ELSE
                L_FAMILIAR_NAMES = %L_FAMILIAR_NAMES%、%CALLNAME:[[早鬼]]%
            ENDIF
        ENDIF
        IF GROUPMATCH(L_FAMILIAR_LIST, [[尤魔]])
            IF L_FAMILIAR_NAMES == ""
                L_FAMILIAR_NAMES = %CALLNAME:[[尤魔]]%
            ELSE
                L_FAMILIAR_NAMES = %L_FAMILIAR_NAMES%和%CALLNAME:[[尤魔]]%
            ENDIF
        ENDIF
        IF L_FAMILIAR_NUM >= 3
            PRINTFORML %L_FAMILIAR_NAMES%为了抢%CALLNAME:MASTER%旁边的座位，互相瞪得火花四溅
            PRINTFORMW 谁都不肯让步……好可怕……
        ELSE
            PRINTFORMW %L_FAMILIAR_NAMES%理所当然地坐到了%CALLNAME:MASTER%旁边……
        ENDIF
    ELSE
        SIF GROUPMATCH(L_FAMILIAR_LIST, [[美天]])
            L_FAMILIAR_NAMES = %CALLNAME:[[美天]]%
        IF GROUPMATCH(L_FAMILIAR_LIST, [[慧ノ子]])
            IF L_FAMILIAR_NAMES == ""
                L_FAMILIAR_NAMES = %CALLNAME:[[慧ノ子]]%
            ELSE
                L_FAMILIAR_NAMES = %L_FAMILIAR_NAMES%、%CALLNAME:[[慧ノ子]]%
            ENDIF
        ENDIF
        IF GROUPMATCH(L_FAMILIAR_LIST, [[ちやり]])
            IF L_FAMILIAR_NAMES == ""
                L_FAMILIAR_NAMES = %CALLNAME:[[ちやり]]%
            ELSE
                L_FAMILIAR_NAMES = %L_FAMILIAR_NAMES%和%CALLNAME:[[ちやり]]%
            ENDIF
        ENDIF
        IF L_FAMILIAR_NUM >= 3
            PRINTFORMW %L_FAMILIAR_NAMES%她们把%CALLNAME:MASTER%围在中间坐下了
        ELSE
            PRINTFORMW %L_FAMILIAR_NAMES%坐到了%CALLNAME:MASTER%旁边……
        ENDIF
    ENDIF
ELSEIF CURRENT_STATE == ADD_BANQUET_STATE_FINISHED && PREVIOUS_STATE == ADD_BANQUET_STATE_IN_PROGRESS
    DRAWLINE
    PRINTFORML 酒会的会场渐渐空无一人，只剩下空酒瓶和脏碗碟……
    PRINTL 
    PRINTL 
    PRINTW 三大组织联合举办的酒会结束了
ENDIF

