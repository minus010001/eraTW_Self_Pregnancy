@FADD_BANQUET10(ARG, O_DATA)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTIONS
#DIMS DYNAMIC O_DATA

SELECTCASE O_DATA
    CASE "NAME"
        RETURNF "姐姐聚会"
    CASE "ACTIVITIES"
        RETURNF "饮酒聊天"
    CASE "TERM"
        RETURNF "宴会"
    CASE "CATEGORY"
        RETURNF "宴会"
    CASE "PRIORITY"
        RETURNF "3"
    CASE "HOST"
        RETURNF @"{ADD_BANQUET_10_HOST()}"
    CASE "HOST_LIST"
        RETURNF @"{[[レミリア]]}/{[[さとり]]}/{[[豊姫]]}"
    CASE "GUEST_LIST"
        RETURNF @"{[[萃香]]}/{[[フラン]]}/{[[こいし]]}/{[[依姫]]}/{[[る～こと]]}/{[[お空]]}/{[[お燐]]}/{[[咲夜]]}/{[[小悪魔]]}"
    CASE "BANNED_LIST"
        RETURNF @"{[[正邪]]}"
    CASE "CONDITIONS"
        SIF CFLAG:[[レミリア]]:出禁 || CFLAG:[[咲夜]]:出禁
			RETURNF "0"
		SIF CFLAG:[[さとり]]:出禁 || CFLAG:[[お燐]]:出禁 || CFLAG:[[お空]]:出禁
			RETURNF "0"
		SIF CFLAG:[[豊姫]]:出禁 || CFLAG:[[レイセン]]:出禁
			RETURNF "0"
		SIF DAY:3 == 3 && (DAY:2 == 2 || DAY:2 == 4)
			RETURNF "1"
        RETURNF "0"
    CASE "WEATHER_DEPENDENT"
        RETURNF "0"
    CASE "DRINKING"
        RETURNF "1"
    CASE "MUSIC_PERFORMANCE"
        RETURNF "1"
ENDSELECT
RETURNF ""

@ADD_BANQUET_PLANNING10
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC LOCATION
#DIM DYNAMIC SCALE
#DIM DYNAMIC START_TIME

LOCATION = P218小料理屋

SCALE = 1500
START_TIME = CLOCK_TO_TIME(16, 0)

CALL ADD_BANQUET_CREATE(10, LOCATION, START_TIME, DAY+3, (SCALE / 10) + 300, SCALE)
LOCAL = RESULT

SIF LOCAL < 0
    RETURN

ADD_BANQUETS_INVITED:LOCAL = ADD_BANQUET_INVITE_INVITED
PRINTL 
PRINTFORMW 似乎要召开一场守护姐姐声誉与魅力的会议了。
PRINTFORML 
CALL ADD_BANQUET_DRINKING_INITIALIZATION_DESCRIPTION(LOCAL)

@ADD_BANQUET_START10
#LOCALSIZE 1
#LOCALSSIZE 1
CALL ADD_BANQUET_DRESS_UP(10)

@ADD_BANQUET_FINISH10
#LOCALSIZE 1
#LOCALSSIZE 1
CALL ADD_BANQUET_DRESS_DOWN(10)

@ADD_BANQUET_VISIT10(PREVIOUS_STATE)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC PREVIOUS_STATE
#DIM DYNAMIC BANQUET_INDEX
#DIM DYNAMIC CURRENT_STATE

BANQUET_INDEX = ADD_BANQUET_INDEX(10)
CURRENT_STATE = ADD_BANQUETS_STATUS:BANQUET_INDEX

IF CURRENT_STATE == ADD_BANQUET_STATE_IN_PROGRESS && PREVIOUS_STATE == ADD_BANQUET_STATE_PREPARING
    PRINTL 
    PRINTFORMW 姐姐们的聚会开始了！
    PRINTFORML 「长女万岁！」
    PRINTFORML 「赞美姐姐！」
    PRINTFORMW ……虽然听到了这样的声音，但总觉得其中混进了醉鬼的胡言乱语……
ELSEIF CURRENT_STATE == ADD_BANQUET_STATE_FINISHED && PREVIOUS_STATE == ADD_BANQUET_STATE_IN_PROGRESS
    DRAWLINE
    PRINTFORML 姐姐们的聚会结束了
    PRINTFORML 「结论！姐姐是世界上最棒的存在！」
    PRINTFORML 「……这种结论到底是谁得出的……」
    PRINTFORMW 姐姐们的品性似乎因为醉鬼们被严重怀疑了……
ENDIF

CALL ADD_BANQUET_DRINKING_VISIT(PREVIOUS_STATE, BANQUET_INDEX)

@ADD_BANQUET_PROGRESS10(BANQUET_INDEX)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC BANQUET_INDEX
CALL ADD_BANQUET_DRINKING_PROGRESS(BANQUET_INDEX)

@ADD_BANQUET_PREPARATION_TEXT10(CHARA, LOCATION)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC CHARA
#DIM DYNAMIC LOCATION
CALL ADD_BANQUET_DRINKING_PREPARATION_TEXT(CHARA, LOCATION)

@ADD_BANQUET_JOIN_TEXT10(CHARA, LOCATION)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC CHARA
#DIM DYNAMIC LOCATION
CALL ADD_BANQUET_DRINKING_JOIN_TEXT(CHARA, LOCATION)

@ADD_BANQUET_SET_PARTICIPANTS10
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC BANQUET_INDEX
#DIM DYNAMIC BANQUET_SCALE
BANQUET_INDEX = ADD_BANQUET_INDEX(10)
BANQUET_SCALE = ADD_BANQUETS_SCALE:BANQUET_INDEX

CALL ADD_BANQUET_FILL_PARTICIPANTS(BANQUET_INDEX, 0, 0)

@ADD_BANQUET_PARTICIPANT_JOIN_CHECK10(ARG)
#LOCALSIZE 1
#LOCALSSIZE 1
IF GROUPMATCH(ARG, [[レミリア]], [[ルナサ]], [[さとり]], [[静葉]], [[豊姫]], [[白蓮]], [[幻月]], [[紫苑]], [[弁々]])
    RETURN RAND:100 < 50
ENDIF
RETURN 0

@ADD_BANQUET_WORKLOAD_PREPARATION10(ARG)
#LOCALSIZE 1
#LOCALSSIZE 1
CALL ADD_BANQUET_DRINKING_PREPARATION_WORKLOAD(ARG, ADD_BANQUET_INDEX(10))

@ADD_BANQUET_WORKLOAD_PARTICIPATION10(ARG, SCALE)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC SCALE
CALL ADD_BANQUET_DRINKING_WORKLOAD(ARG, SCALE)

@ADD_BANQUET_MESSAGE_TALK10
#LOCALSIZE 1
#LOCALSSIZE 1
CALL ADD_BANQUET_DRINKING_MESSAGE_TALK(ADD_BANQUET_INDEX(10))

@ADD_BANQUET_10_HOST()
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTION
;開催回数次第で主催を持ち回り
SELECTCASE 宴会開催回数:10 % 3
	CASE 0
		RETURNF [[レミリア]]
	CASE 1
		RETURNF [[さとり]]
	CASE 2
		RETURNF [[豊姫]]
	CASEELSE
		RETURNF [[レミリア]]
ENDSELECT
