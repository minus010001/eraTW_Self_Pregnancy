@FADD_BANQUET41(ARG, O_DATA)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTIONS
#DIMS DYNAMIC O_DATA

SELECTCASE O_DATA
	CASE "NAME"
		RETURNF "正邪的一人宴会"
	CASE "ACTIVITIES"
		RETURNF "独自饮酒"
	CASE "TERM"
		RETURNF "宴会"
	CASE "CATEGORY"
		RETURNF "宴会"
	CASE "PRIORITY"
		RETURNF "3"
	CASE "HOST"
		RETURNF @"{[[正邪]]}"
	CASE "HOST_LIST"
		RETURNF @"{[[正邪]]}"
	CASE "GUEST_LIST"
		RETURNF ""
	CASE "BANNED_LIST"
		RETURNF ""
	CASE "CONDITIONS"
		SIF CFLAG:[[正邪]]:出禁 == 0 && ABL:[[正邪]]:親密 >= 8 && DAY:3 == 8 && DAY:2 != 4 && !(DAY:2 == 4 && DAY:3 > 25)
			RETURNF "1"
		RETURNF "0"
	CASE "WEATHER_DEPENDENT"
		;恋慕なら室内なので雨天決行、非恋慕なら屋外なので雨天中止
		IF TALENT:[[正邪]]:恋慕
			RETURNF "0"
		ELSE
			RETURNF "1"
		ENDIF
	CASE "ALTERNATIVE_INDOOR_LOCATION"
		;非恋慕の場合は雨天中止（屋内替代なし）
		RETURNF ""
	CASE "DRINKING"
		RETURNF "1"
	CASE "MUSIC_PERFORMANCE"
		RETURNF "0"
ENDSELECT
RETURNF ""

@ADD_BANQUET_PLANNING41
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC LOCATION
#DIM DYNAMIC SCALE
#DIM DYNAMIC START_TIME

IF TALENT:[[正邪]]:恋慕
	LOCATION = P733正邪の隠れ家
ELSE
	LOCATION = P703玄武の沢
ENDIF
SCALE = 100
START_TIME = 1200

CALL ADD_BANQUET_CREATE(41, LOCATION, START_TIME, DAY+1, (SCALE / 10) + 300, SCALE)
LOCAL = RESULT

SIF LOCAL < 0
	RETURN

PRINTL
PRINTFORMW 从正邪那里收到了一封信，信上写着她要一个人开一场开心的宴会
PRINTL
PRINTFORML ……不管读多少遍，内容都只有这些。完全没有邀请%CALLNAME:MASTER%的字眼，明明写着地点和时间
PRINTFORMW 这就是天邪鬼式的邀请函吗？总之先记下来好了……

@ADD_BANQUET_START41
#LOCALSIZE 1
#LOCALSSIZE 1
CALL ADD_BANQUET_DRESS_UP(41)

@ADD_BANQUET_FINISH41
#LOCALSIZE 1
#LOCALSSIZE 1
CALL ADD_BANQUET_DRESS_DOWN(41)
CFLAG:[[正邪]]:BANQUET_ROLE = 1

@ADD_BANQUET_VISIT41(PREVIOUS_STATE)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC PREVIOUS_STATE
#DIM DYNAMIC BANQUET_INDEX
#DIM DYNAMIC CURRENT_STATE
BANQUET_INDEX = ADD_BANQUET_INDEX(41)
CURRENT_STATE = ADD_BANQUETS_STATUS:BANQUET_INDEX

IF CURRENT_STATE == ADD_BANQUET_STATE_IN_PROGRESS && PREVIOUS_STATE == ADD_BANQUET_STATE_PREPARING
	PRINTFORML
	PRINTFORMW 正邪独自坐在那里，手里端着酒杯，嘴里嘟嘟囔囔地抱怨着什么
	PRINTFORML
ELSEIF CURRENT_STATE == ADD_BANQUET_STATE_IN_PROGRESS
	PRINTL
	PRINTFORMW 正邪似乎已经开始一个人喝起来了……
	PRINTL
ENDIF

@ADD_BANQUET_PROGRESS41(BANQUET_INDEX)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC BANQUET_INDEX
#DIM DYNAMIC BANQUET_ID
#DIM DYNAMIC PRESENT
#DIM DYNAMIC LAPSE
#DIM DYNAMIC LOCATION

BANQUET_ID = ADD_BANQUETS_UPCOMING:BANQUET_INDEX
LOCATION = GET_MAP_REPLACEMENT(ADD_BANQUETS_LOCATION:BANQUET_INDEX)
PRESENT = CFLAG:MASTER:現在位置 == LOCATION
LAPSE = TIME_PROGRESS(TIME:1)

SELECTCASE ADD_BANQUETS_STATUS:BANQUET_INDEX
	CASE ADD_BANQUET_STATE_PREPARING
		IF PRESENT
			FOR LOCAL, 1, CHARANUM
				IF CFLAG:LOCAL:BANQUET == BANQUET_ID && CFLAG:LOCAL:BANQUET_ROLE > 1
					PRINTFORML %CALLNAME:LOCAL%在准备着什么……看起来只有酒和杯子
				ENDIF
			NEXT
		ENDIF
	CASE ADD_BANQUET_STATE_IN_PROGRESS
		FOR LOCAL, 1, CHARANUM
			IF CFLAG:LOCAL:BANQUET == BANQUET_ID && CFLAG:LOCAL:現在位置 == LOCATION
				CALL ADD_BANQUET_DRINKING(LOCAL, LAPSE)
				IF PRESENT
					IF LOCAL == [[正邪]]
						IF TCVAR:LOCAL:泥酔
							PRINTFORML %CALLNAME:LOCAL%已经喝得烂醉，嘴里含糊不清地念叨着「反转……」
						ELSE
							PRINTFORML %CALLNAME:LOCAL%一边喝酒一边嘟囔着什么，看起来心情不太好
						ENDIF
					ELSE
						CALL ADD_BANQUET_DRINKING_DESCRIPTIONS(LOCAL)
					ENDIF
				ENDIF
			ENDIF
		NEXT
	CASE ADD_BANQUET_STATE_FINISHED
ENDSELECT

@ADD_BANQUET_PREPARATION_TEXT41(CHARA, LOCATION)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC CHARA
#DIM DYNAMIC LOCATION
IF CFLAG:CHARA:現在位置 == CFLAG:MASTER:現在位置 && CFLAG:MASTER:現在位置 == LOCATION
	PRINTFORML %CALLNAME:CHARA%开始准备一个人的宴会
ELSEIF CFLAG:MASTER:現在位置 == LOCATION
	PRINTFORML %CALLNAME:CHARA%来到了%NAME_FROM_PLACE(LOCATION)%准备一个人的宴会
ELSEIF CFLAG:CHARA:現在位置 == CFLAG:MASTER:現在位置
	PRINTFORML %CALLNAME:CHARA%动身前往%NAME_FROM_PLACE(LOCATION)%准备一个人的宴会
ENDIF

@ADD_BANQUET_JOIN_TEXT41(CHARA, LOCATION)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC CHARA
#DIM DYNAMIC LOCATION
IF CFLAG:CHARA:現在位置 == CFLAG:MASTER:現在位置 && CFLAG:MASTER:現在位置 == LOCATION
	PRINTFORML %CALLNAME:CHARA%加入了宴会
ELSEIF CFLAG:MASTER:現在位置 == LOCATION
	PRINTFORML %CALLNAME:CHARA%来到了%NAME_FROM_PLACE(LOCATION)%加入宴会
ELSEIF CFLAG:CHARA:現在位置 == CFLAG:MASTER:現在位置
	PRINTFORML %CALLNAME:CHARA%动身前往%NAME_FROM_PLACE(LOCATION)%加入宴会
ENDIF

@ADD_BANQUET_SET_PARTICIPANTS41
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC BANQUET_INDEX
BANQUET_INDEX = ADD_BANQUET_INDEX(41)

CALL ADD_BANQUET_FILL_PARTICIPANTS(BANQUET_INDEX, 0, 0)

@ADD_BANQUET_PARTICIPANT_JOIN_CHECK41(ARG)
#LOCALSIZE 1
#LOCALSSIZE 1
IF ARG == [[針妙丸]]
	RETURN RAND:100 < 25
ENDIF
RETURN 0

@ADD_BANQUET_WORKLOAD_PREPARATION41(ARG)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC BANQUET_INDEX
#DIM DYNAMIC SCALE
#DIM DYNAMIC WORKLOAD
BANQUET_INDEX = ADD_BANQUET_INDEX(41)
SCALE = ADD_BANQUETS_SCALE:BANQUET_INDEX
WORKLOAD = ADD_BANQUET_TIME_UNTIL(BANQUET_INDEX) * 5

IF CFLAG:ARG:職種 != JOB_宴会準備
	MAXBASE:ARG:仕事量 = MIN(WORKLOAD, 600)
	BASE:ARG:仕事量 = MAXBASE:ARG:仕事量
	CFLAG:ARG:職種 = JOB_宴会準備
	TCVAR:ARG:手伝えない = 2
	CFLAG:ARG:行動 = 5
ENDIF

@ADD_BANQUET_WORKLOAD_PARTICIPATION41(ARG, SCALE)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC SCALE
IF CFLAG:ARG:職種 != JOB_宴会参加 && TCVAR:ARG:泥酔 == 0
	MAXBASE:ARG:仕事量 = 600
	BASE:ARG:仕事量 = MAXBASE:ARG:仕事量
	CFLAG:ARG:職種 = JOB_宴会参加
	CFLAG:ARG:行動 = 5
	TCVAR:ARG:手伝えない = 1
ENDIF

@ADD_BANQUET_MESSAGE_TALK41
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC BANQUET_INDEX
#DIM DYNAMIC PARTICIPANTS
BANQUET_INDEX = ADD_BANQUET_INDEX(41)
PARTICIPANTS = ADD_BANQUET_PARTICIPANT_COUNT(BANQUET_INDEX)

IF PARTICIPANTS > 0
	PRINTFORML 正邪的一人宴会正在进行中
	IF PARTICIPANTS == 1
		PRINTFORML 只有正邪一个人在喝酒……
	ELSE
		PRINTFORML 居然还有{PARTICIPANTS - 1}个人来陪正邪喝酒
	ENDIF
ELSE
	PRINTFORML 宴会已经结束了
ENDIF
