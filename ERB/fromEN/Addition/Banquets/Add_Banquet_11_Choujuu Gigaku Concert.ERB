@FADD_BANQUET11(ARG, O_DATA)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTIONS
#DIMS DYNAMIC O_DATA

SELECTCASE O_DATA
	CASE "NAME"
        RETURNF "鸟兽伎乐演唱会"
    CASE "ACTIVITIES"
        RETURNF "听音乐"
    CASE "TERM"
        RETURNF "演唱会"
    CASE "CATEGORY"
        RETURNF "演唱会"
    CASE "PRIORITY"
        RETURNF "2"
    CASE "NOTIFY_PLAYER"
        RETURNF "1"
    CASE "HOST"
        RETURNF @"{[[ミスティア]]}"
    CASE "HOST_LIST"
        RETURNF @"{[[ミスティア]]}/{[[響子]]}"
    CASE "GUEST_LIST"
        RETURNF @"{[[阿求]]}"
    CASE "BANNED_LIST"
        RETURNF @"{[[白蓮]]}"
    CASE "CONDITIONS"
        SIF CFLAG:[[ミスティア]]:出禁 == 0 && CFLAG:[[響子]]:出禁 == 0 && DAY%7 == 0 && RAND:100 <= 25
            RETURNF "1"
        RETURNF "0"
    CASE "WEATHER_DEPENDENT"
        RETURNF "1"
    CASE "LISTEN_TO_MUSIC"
        RETURNF "1"
    CASE "PERFORMERS"
        RETURNF @"{[[ミスティア]]}/{[[響子]]}"
ENDSELECT
RETURNF ""

@ADD_BANQUET_PLANNING11
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC LOCATION
#DIM DYNAMIC SCALE
#DIM DYNAMIC START_TIME

LOCATION = P201人里の門

SCALE = 500 + RAND:5000
START_TIME = 1260 ;21:00

CALL ADD_BANQUET_CREATE(11, LOCATION, START_TIME, DAY+2, 180, SCALE)
LOCAL = RESULT ;banquet_index

SIF LOCAL < 0 ;couldn't create
    RETURN

ADD_BANQUETS_INVITED:LOCAL = ADD_BANQUET_INVITE_INVITED
PRINTL  
PRINTFORMW 看到了鸟兽伎乐演唱会的传单。
PRINTFORML 

PRINTFORMW %ADD_BANQUET_TIME_AND_PLACE_DESCRIPTION(LOCAL)%

PRINT 看起来
IF SCALE >= 5000
	PRINTW 有很多人在期待呢。
ELSEIF SCALE >= 2500
	PRINTW 会吸引相当多的人来吧。
ELSEIF SCALE >= 1500
	PRINTW 这次应该会比较克制吧。
ELSE
	PRINTW 没什么人感兴趣的样子。
ENDIF

PRINTFORMW 另外、看天气的情况可能会中止……

CALLF Add_SPECIAL_REQUEST_CREATION([[ミスティア]], 94, 50, 1, 1)
CALLF Add_SPECIAL_REQUEST_CREATION([[響子]], 94, 50, 1, 1)

@ADD_BANQUET_START11
#LOCALSIZE 1
#LOCALSSIZE 1
FOR LOCAL, 1, CHARANUM
    SIF CFLAG:LOCAL:BANQUET == 11
        CALL ADD_BANQUET_SET_OUTFIT11(LOCAL)
NEXT

@ADD_BANQUET_FINISH11
#LOCALSIZE 1
#LOCALSSIZE 1
FOR LOCAL, 1, CHARANUM
    CALL ADD_BANQUET_RESET_OUTFIT11(LOCAL)
NEXT

@ADD_BANQUET_VISIT11(PREVIOUS_STATE)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC PREVIOUS_STATE
#DIM DYNAMIC BANQUET_INDEX
#DIM DYNAMIC CURRENT_STATE
#DIM DYNAMIC PARTICIPANTS
BANQUET_INDEX = ADD_BANQUET_INDEX(11)
PARTICIPANTS = ADD_BANQUET_PARTICIPANT_COUNT(BANQUET_INDEX)
CURRENT_STATE = ADD_BANQUETS_STATUS:BANQUET_INDEX

IF CURRENT_STATE == ADD_BANQUET_STATE_IN_PROGRESS && PREVIOUS_STATE == ADD_BANQUET_STATE_PREPARING ;player was present during start
    PRINTFORML 
    IF PARTICIPANTS >= 15
        PRINTW 演唱会正式开始了，庞大的人群已经兴奋不已。
    ELSEIF PARTICIPANTS >= 5
        PRINTW 演唱会正式开始了，人群迫不及待地等待着%CALLNAME:[[響子]]%和%CALLNAME:[[ミスティア]]%的歌声。
    ELSE
        PRINTW 演唱会开始了，但因为人太少，气氛有些冷清。
    ENDIF
    PRINTFORML 
ELSEIF CURRENT_STATE == ADD_BANQUET_STATE_IN_PROGRESS ;joins later
    PRINTL  
    PRINTW 演唱会好像已经开始了…
    PRINTL  
ENDIF

@ADD_BANQUET_PROGRESS11(BANQUET_INDEX)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC BANQUET_INDEX
#DIM DYNAMIC BANQUET_ID
#DIM DYNAMIC PRESENT
#DIM DYNAMIC LAPSE

BANQUET_ID = ADD_BANQUETS_UPCOMING:BANQUET_INDEX
;if master at location
PRESENT = CFLAG:MASTER:現在位置 == GET_MAP_REPLACEMENT(ADD_BANQUETS_LOCATION:BANQUET_INDEX)
LAPSE = TIME_PROGRESS(TIME:1)

SELECTCASE ADD_BANQUETS_STATUS:BANQUET_INDEX
    CASE ADD_BANQUET_STATE_PREPARING
        IF PRESENT
            FOR LOCAL, 1, CHARANUM
                IF CFLAG:LOCAL:BANQUET == BANQUET_ID && CFLAG:LOCAL:BANQUET_ROLE > 1
                    IF TALENT:LOCAL:恋慕
                        PRINTFORML %CALLNAME:LOCAL%一边牵挂着%CALLNAME:MASTER%一边准备着演唱会。
                    ELSE
                        PRINTFORML %CALLNAME:LOCAL%正忙碌地准备着演唱会。
                    ENDIF
                ENDIF
            NEXT
        ENDIF
    CASE ADD_BANQUET_STATE_IN_PROGRESS
        FOR LOCAL, 1, CHARANUM
            IF CFLAG:LOCAL:BANQUET == BANQUET_ID
                IF CFLAG:LOCAL:行動 == 5
                    BASE:LOCAL:仕事量 = MAX(BASE:LOCAL:仕事量 - LAPSE * 10, 0)
                    SIF CFLAG:LOCAL:BANQUET_ROLE < ADD_BANQUET_ROLE_HOST && (BASE:LOCAL:仕事量 == 0 || CFLAG:LOCAL:睡眠)
                        CALL ADD_BANQUET_END_PARTICIPATION(LOCAL)
                    IF PRESENT
                        IF ADD_BANQUET_IS_PERFORMER(LOCAL, BANQUET_ID)
                            IF TALENT:LOCAL:恋慕
                                PRINTFORML %CALLNAME:LOCAL%在演出时偶尔看向你。
                            ELSE
                                PRINTFORML %CALLNAME:LOCAL%继续着演出。
                            ENDIF
                        ELSEIF TALENT:LOCAL:恋慕
                            PRINTFORML %CALLNAME:LOCAL%一边享受着演唱会一边时不时看向%CALLNAME:MASTER%。
                        ELSE
                            PRINTFORML %CALLNAME:LOCAL%享受着演唱会。
                        ENDIF
                    ENDIF
                ENDIF
            ENDIF
        NEXT
    CASE ADD_BANQUET_STATE_FINISHED
ENDSELECT

@ADD_BANQUET_PREPARATION_TEXT11(CHARA, LOCATION)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC CHARA
#DIM DYNAMIC LOCATION
IF CFLAG:CHARA:現在位置 == CFLAG:MASTER:現在位置 && CFLAG:MASTER:現在位置 == LOCATION
    PRINTFORML %CALLNAME:CHARA%开始准备演唱会。
ELSEIF CFLAG:MASTER:現在位置 == LOCATION
    PRINTFORML %CALLNAME:CHARA%来到了%NAME_FROM_PLACE(LOCATION)%开始准备演唱会。
ELSEIF CFLAG:CHARA:現在位置 == CFLAG:MASTER:現在位置
    PRINTFORML %CALLNAME:CHARA%动身前往%NAME_FROM_PLACE(LOCATION)%准备演唱会。
ENDIF

@ADD_BANQUET_JOIN_TEXT11(CHARA, LOCATION)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC CHARA
#DIM DYNAMIC LOCATION
IF CFLAG:CHARA:現在位置 == CFLAG:MASTER:現在位置 && CFLAG:MASTER:現在位置 == LOCATION
    PRINTFORML %CALLNAME:CHARA%加入了演唱会。
ELSEIF CFLAG:MASTER:現在位置 == LOCATION
    PRINTFORML %CALLNAME:CHARA%来到了%NAME_FROM_PLACE(LOCATION)%参加演唱会。
ELSEIF CFLAG:CHARA:現在位置 == CFLAG:MASTER:現在位置
    PRINTFORML %CALLNAME:CHARA%动身前往%NAME_FROM_PLACE(LOCATION)%参加演唱会。
ENDIF

@ADD_BANQUET_SET_PARTICIPANTS11
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC BANQUET_INDEX
#DIM DYNAMIC BANQUET_SCALE
BANQUET_INDEX = ADD_BANQUET_INDEX(11)
BANQUET_SCALE = ADD_BANQUETS_SCALE:BANQUET_INDEX

CALL ADD_BANQUET_FILL_PARTICIPANTS(BANQUET_INDEX, 0, 0)

@ADD_BANQUET_PARTICIPANT_JOIN_CHECK11(ARG)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC BANQUET_SCALE
#DIM DYNAMIC JOIN_CHANCE
#DIM DYNAMIC HIGH_RATE ;fairies and youkai
#DIM DYNAMIC NORMAL_RATE ;everyone else
BANQUET_SCALE = ADD_BANQUETS_SCALE:ADD_BANQUET_INDEX(11)
IF BANQUET_SCALE > 5000
    HIGH_RATE = 40
    NORMAL_RATE = 20
ELSEIF BANQUET_SCALE > 3000
    HIGH_RATE = 20
    NORMAL_RATE = 10
ELSEIF BANQUET_SCALE > 2000
    HIGH_RATE = 17
    NORMAL_RATE = 7
ELSEIF BANQUET_SCALE > 1000
    HIGH_RATE = 10
    NORMAL_RATE = 5
ELSE
    HIGH_RATE = 8
    NORMAL_RATE = 1
ENDIF

IF TALENT:ARG:妖精 || TALENT:ARG:妖怪
    RETURN RAND:100 < HIGH_RATE
ELSE
    RETURN RAND:100 < NORMAL_RATE
ENDIF

@ADD_BANQUET_WORKLOAD_PREPARATION11(ARG)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC SCALE
#DIM DYNAMIC BANQUET_INDEX
#DIM DYNAMIC WORKLOAD
BANQUET_INDEX = ADD_BANQUET_INDEX(11)
SCALE = ADD_BANQUETS_SCALE:BANQUET_INDEX
WORKLOAD = ADD_BANQUET_TIME_UNTIL(BANQUET_INDEX) * 10

IF CFLAG:ARG:職種 != JOB_宴会準備
	MAXBASE:ARG:仕事量 = MIN(WORKLOAD, 2400)
	BASE:ARG:仕事量 = MAXBASE:ARG:仕事量
	CFLAG:ARG:職種 = JOB_宴会準備
    TCVAR:ARG:手伝えない = 2
	CFLAG:ARG:行動 = 5
ENDIF

@ADD_BANQUET_WORKLOAD_PARTICIPATION11(ARG, SCALE)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC SCALE

IF CFLAG:ARG:職種 != JOB_宴会参加
	MAXBASE:ARG:仕事量 = 1800 ;stay for the full duration
	BASE:ARG:仕事量 = MAXBASE:ARG:仕事量
	CFLAG:ARG:職種 = JOB_宴会参加
	CFLAG:ARG:行動 = 5
    TCVAR:ARG:手伝えない = 1
ENDIF

@ADD_BANQUET_MESSAGE_TALK11
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC BANQUET_INDEX
#DIM DYNAMIC PARTICIPANTS
BANQUET_INDEX = ADD_BANQUET_INDEX(11)
PARTICIPANTS = MAX(ADD_BANQUET_PARTICIPANT_COUNT(BANQUET_INDEX)-2, 0) ;do not include the performers themselves

PRINTFORML 鸟兽伎乐正在演出中。
IF PARTICIPANTS > 0
    IF PARTICIPANTS == 1
        PRINTFORML 只有一个人在听……
    ELSE
        PRINTFORML 大约有{PARTICIPANTS}名观众。
    ENDIF
    IF ADD_BANQUET_TIME_UNTIL(BANQUET_INDEX) > -30
        PRINTFORML 刚开始不久，演唱会的气氛还很平静。
    ELSEIF ADD_BANQUET_TIME_UNTIL(BANQUET_INDEX) > -120
        IF PARTICIPANTS > 5
            PRINTFORML 演唱会正酣，观众们兴奋地跟着节拍动了起来。
        ELSE
            PRINTFORML 演唱会正酣。尽管观众不多，%CALLNAME:[[響子]]%和%CALLNAME:[[ミスティア]]%依然在放声高歌。
        ENDIF
    ELSE
        PRINTFORML 演唱会开始收尾，观众们也渐渐安静下来。
    ENDIF
ELSE
    PRINTFORML 观众已经散去了。
ENDIF

@ADD_BANQUET_SET_OUTFIT11(ARG)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC OUTFIT
IF CFLAG:ARG:BANQUET_ROLE == ADD_BANQUET_ROLE_HOST
    CALL SET_EVENT_CLOTHES(ARG, [[鸟兽伎乐套装]])
    TCVAR:ARG:DRESSED_FOR_BANQUET = 11
ELSE
    OUTFIT = 宴会服决定(ARG, 11)
    SIF OUTFIT
        CALL SET_EVENT_CLOTHES(ARG, OUTFIT)
    SIF OUTFIT
        TCVAR:ARG:DRESSED_FOR_BANQUET = 11
ENDIF

@ADD_BANQUET_RESET_OUTFIT11(ARG)
#LOCALSIZE 1
#LOCALSSIZE 1
SIF TCVAR:ARG:DRESSED_FOR_BANQUET == 11
    CALL RESET_EVENT_CLOTHES(ARG)
SIF TCVAR:ARG:DRESSED_FOR_BANQUET == 11
    TCVAR:ARG:DRESSED_FOR_BANQUET = 0
