@FADD_BANQUET9(ARG, O_DATA)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTIONS
#DIMS DYNAMIC O_DATA

SELECTCASE O_DATA
    CASE "NAME"
        RETURNF "自机聚会"
    CASE "ACTIVITIES"
        RETURNF "饮酒聊天"
    CASE "TERM"
        RETURNF "宴会"
    CASE "CATEGORY"
        RETURNF "宴会"
    CASE "PRIORITY"
        RETURNF "2"
    CASE "NOTIFY_PLAYER"
        RETURNF "1"
    CASE "HOST"
        RETURNF @"{[[霊夢]]}"
    CASE "HOST_LIST"
        RETURNF @"{[[霊夢]]}/{[[魔理沙]]}"
    CASE "GUEST_LIST"
        RETURNF @"{[[紫]]}/{[[チルノ]]}/{[[咲夜]]}/{[[レミリア]]}/{[[アリス]]}/{[[妖夢]]}/{[[幽々子]]}/{[[文]]}/{[[早苗]]}/{[[はたて]]}"
    CASE "BANNED_LIST"
        RETURNF @"{[[正邪]]}"
    CASE "CONDITIONS"
        SIF CFLAG:[[霊夢]]:出禁 == 0 && (DAY:2 == 1 || DAY:2 == 2) && DAY:3 == 20 && RAND:100 <= 15
            RETURNF "1"
        RETURNF "0"
    CASE "WEATHER_DEPENDENT"
        RETURNF "1"
    CASE "DRINKING"
        RETURNF "1"
    CASE "MUSIC_PERFORMANCE"
        RETURNF "1"
    CASE "ALTERNATIVE_INDOOR_LOCATION"
        RETURNF @"{P9居間}"
ENDSELECT
RETURNF ""

@ADD_BANQUET_PLANNING9
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC LOCATION
#DIM DYNAMIC SCALE
#DIM DYNAMIC START_TIME

LOCATION = P11庭

SCALE = 2000
START_TIME = CLOCK_TO_TIME(17, 0)

CALL ADD_BANQUET_CREATE(9, LOCATION, START_TIME, DAY+3, (SCALE / 10) + 300, SCALE)
LOCAL = RESULT

SIF LOCAL < 0
    RETURN

ADD_BANQUETS_INVITED:LOCAL = ADD_BANQUET_INVITE_INVITED
PRINTL 
PRINTFORMW 似乎有曾经肩负过荣耀重任的少女们要举办亲睦会。
PRINTFORML 
CALL ADD_BANQUET_DRINKING_INITIALIZATION_DESCRIPTION(LOCAL)

@ADD_BANQUET_START9
#LOCALSIZE 1
#LOCALSSIZE 1
CALL ADD_BANQUET_DRESS_UP(9)

@ADD_BANQUET_FINISH9
#LOCALSIZE 1
#LOCALSSIZE 1
CALL ADD_BANQUET_DRESS_DOWN(9)

@ADD_BANQUET_VISIT9(PREVIOUS_STATE)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC PREVIOUS_STATE
CALL ADD_BANQUET_DRINKING_VISIT(PREVIOUS_STATE, ADD_BANQUET_INDEX(9))

@ADD_BANQUET_PROGRESS9(BANQUET_INDEX)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC BANQUET_INDEX
CALL ADD_BANQUET_DRINKING_PROGRESS(BANQUET_INDEX)

@ADD_BANQUET_PREPARATION_TEXT9(CHARA, LOCATION)
