@ADD_BANQUET_SET_PARTICIPANTS9
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC BANQUET_INDEX
#DIM DYNAMIC BANQUET_SCALE
BANQUET_INDEX = ADD_BANQUET_INDEX(9)
BANQUET_SCALE = ADD_BANQUETS_SCALE:BANQUET_INDEX

CALL ADD_BANQUET_FILL_PARTICIPANTS(BANQUET_INDEX, 5, 3)

@ADD_BANQUET_WORKLOAD_PREPARATION9(ARG)
