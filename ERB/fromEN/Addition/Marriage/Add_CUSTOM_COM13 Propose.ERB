;求婚
@ADD_CUSTOM_COM13
#LOCALSIZE 1
#LOCALSSIZE 1
SELECTCASE TFLAG:192
	CASE IS <= -1
		TFLAG:193 = 0
	CASE 0
		TFLAG:193 = ADD_PROPOSAL_CHECK(TARGET)
	CASE 1
		TFLAG:193 = 1
ENDSELECT

IF TFLAG:193 == 1
	LEGAL_SPOUSE = TARGET
	TALENT:妻 = 1
	MARRIAGE_STATE = 1
	ITEM:結婚指輪 --
	CALL QoL_Info_Write(TARGET, Qol_Dates_Engagement)
ENDIF

TFLAG:ProposedToday = 1
TIME += 10
RETURN 1

@ADD_CUSTOM_COM_ABLE13
#LOCALSIZE 1
#LOCALSSIZE 1
SIF !TARGET
	RETURN 0
SIF MARRIAGE_STATE
	RETURN 0
SIF TARGET != FLAG:デート相手
	RETURN 0
SIF !TALENT:恋人
	RETURN 0
SIF !ITEM:結婚指輪
	RETURN 0
SIF TFLAG:ProposedToday
	RETURN 0

RETURN 1

@ADD_CUSTOM_MESSAGE_COM13
#LOCALSIZE 1
#LOCALSSIZE 1
PRINTFORMDW 约会途中，你突然停下脚步，拿出订婚戒指向%CALLNAME:TARGET%求婚。

IF TFLAG:193 == 1
	PRINTFORMDW %HE_SHE(TARGET,1)%满脸笑容地欣然接受了。
ELSE
	PRINTFORMDL 但是%HE_SHE(TARGET)%拒绝了。
	IF TALENT:恋慕 < 2
		PRINTFORMDW 也许%HE_SHE(TARGET)%对你的感情还不够深。
	ELSEIF MARK:反発刻印
		PRINTFORMDW %HE_SHE(TARGET,1)%对你之前做过的事仍然耿耿于怀。
	ELSEIF TALENT:機嫌 < 0
		PRINTFORMDW 你应该多注意一下%HE_SHE(TARGET)%的心情。
	ELSEIF CFLAG:ブチギレ
		PRINTFORMDW %HE_SHE(TARGET,1)%显然正在气头上，不可能答应。
	ENDIF
ENDIF

@ADD_PROPOSAL_CHECK(ARG = -1)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTION
SIF ARG == -1
	ARG = TARGET
SIF !ARG
	RETURNF 0
SIF TALENT:ARG:恋慕 < 2
	RETURNF 0
SIF MARK:ARG:反発刻印
	RETURNF 0
SIF TALENT:ARG:機嫌 < 0
	RETURNF 0
SIF CFLAG:ARG:ブチギレ
	RETURNF 0

RETURNF 1
