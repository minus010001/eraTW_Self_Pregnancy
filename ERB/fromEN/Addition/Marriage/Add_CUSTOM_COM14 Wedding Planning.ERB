@ADD_CUSTOM_COM14
#LOCALSIZE 2
#LOCALSSIZE 1
#DIM DYNAMIC SPOUSE_GUESTS,200
#DIM DYNAMIC MAX_SPOUSE_GUESTS
#DIM DYNAMIC FIRST_LINE
IF TARGET == LEGAL_SPOUSE
	IF WEDDING_DATE < DAY + (MARRIAGE_DEBUG ? 1 # 2)
		VARSET WEDDING_DATE
		VARSET WEDDING_TIME
	ENDIF

	PRINTFORMDL 当前计划：
	PRINTFORMD 类型：
	SELECTCASE WEDDING_TYPE
		CASE "WESTERN"
			PRINTFORMDL [红魔馆西式婚礼]
		CASE "JAPANESE"
			PRINTFORMDL [博丽神社神道式婚礼]
		CASE "FAIRY"
			PRINTFORMDL [太阳花田妖精式婚礼]
		CASE "CUSTOM"
			PRINTFORMDL [%CALLNAME:LEGAL_SPOUSE%的自定义婚礼，地点在%NAME_FROM_PLACE(GET_MAP_REPLACEMENT(WEDDING_LOCATION))%。]
		CASEELSE
			CALL COLORMESSAGE("[未定]", C_RED, 1)
	ENDSELECT
	PRINTFORMD 规模：
	IF !WEDDING_SIZE
		CALL COLORMESSAGE("[未定]", C_RED, 1)
	ELSE
		PRINTFORMD [
		SELECTCASE WEDDING_SIZE
			CASE IS > 50
				PRINTFORMD 盛大
			CASE 50
				PRINTFORMD 超大型
			CASE IS >= 30
				PRINTFORMD 大型
			CASE IS >= 15
				PRINTFORMD 中型
			CASEELSE
				PRINTFORMD 小型
		ENDSELECT
		PRINTFORMDL 婚礼，可容纳{WEDDING_SIZE}位来宾。]
	ENDIF
	PRINTFORMD 日期：
	IF !WEDDING_DATE
		CALL COLORMESSAGE("[未定]", C_RED, 1)
	ELSE
		PRINTFORMDL [%PRINT_DATE_F(WEDDING_DATE)% %TWENTY_FOUR_TIME(WEDDING_TIME)%。]
	ENDIF

	PRINTFORMDL 来宾：
	IF !SUMARRAY(WEDDING_GUESTS)
		CALL COLORMESSAGE("[未定]", C_RED, 1)
	ELSE
		LOCALS =
		FOR LOCAL, 1, CHARANUM-1
			SIF !WEDDING_GUESTS:LOCAL
				CONTINUE
			LOCALS += @"%CALLNAME:LOCAL%、"
		NEXT
		PRINTFORMDL %BREAKENG(LIST_IN_STRING(LOCALS))%。
	ENDIF

	PRINTFORMDL 当前费用：%金額表示(ADD_WEDDING_COST())%
	PRINTFORMDL 你想讨论哪个部分？

	CALL ASK_M("类型", 1, "规模", 1, "日期", 1, "来宾", WEDDING_SIZE, "确定婚礼", ADD_WEDDING_READY(), "返回", 1)
	TFLAG:194 = RESULT
	SELECTCASE RESULT
		CASE 0
			CALL KOJO_MESSAGE_SEND("EVENT", 0, TARGET, 0, 0, "WEDDING_PREPARATIONS", "TYPE")
			RESULT = 0
			RESULTS =
			CALL KOJO_CHECK(TARGET, "CUSTOM_WEDDING", "EXISTS")
			LOCAL = RESULT
			LOCALS '= RESULTS
			PRINTFORMDL 你想要哪种类型的婚礼？
			;神道式婚礼需要至少一位可用主持人（灵梦/先代/早苗）
			CALL ASK_M("西式婚礼", 1, "神道式婚礼", (!CFLAG:[[霊夢]]:出禁 || !CFLAG:[[先代]]:出禁 || !CFLAG:[[早苗]]:出禁) ? 1 # -1, "妖精式婚礼", TALENT:妖精 || TALENT:MASTER:FAIRY_FRIEND >= 5 ? 1 # -1, STRLENS(RESULTS) ? RESULTS # @"%CALLNAME:TARGET%的自定义婚礼", LOCAL ? 1 # -1)
			SELECTCASE RESULT
				CASE 0
				PRINTFORMDL 选择了西式婚礼。
				PRINTFORMDL 婚礼将在红魔馆举行。
				WEDDING_TYPE = WESTERN
				WEDDING_LOCATION = P306裏庭
				IF LEGAL_SPOUSE == [[レミリア]]
					;蕾米莉亚是新娘，直接确认场地
					CALL SET_KOJO_COLOR([[レミリア]])
					PRINTFORML 「在我的宅邸举办婚礼？那还用说！」
					PRINTFORML 「恭喜你……也恭喜我自己。」
					PRINTFORML 「咲夜会替我们操办一切的，你放心吧。」
					PRINTFORMW 「费用嘛……%金額表示(2000000)%！呋呋，就算到咱家的小金库里就好。」
					RESETCOLOR
					WEDDING_VENUE_AGREED = 1
				ELSE
					PRINTFORMDW 你应该去和蕾米莉亚谈谈。
					WEDDING_VENUE_AGREED = 0
				ENDIF
			CASE 1
				PRINTFORMDL 选择了神道式婚礼。
				PRINTFORMDL 婚礼将在博丽神社举行。
				WEDDING_TYPE = JAPANESE
				WEDDING_LOCATION = P2境内
				IF LEGAL_SPOUSE == [[霊夢]]
					;灵梦是新娘，直接确认场地
					CALL SET_KOJO_COLOR([[霊夢]])
					PRINTFORML 「诶？在神社办婚礼？」
					PRINTFORML 「……也不是不行啦。毕竟是我自己的事嘛。」
					IF !CFLAG:[[先代]]:出禁
						PRINTFORML 「那自然是让真正的博丽巫女出面啦——开玩笑的。」
						PRINTFORMDL 灵梦想了想，补充道：
						PRINTFORML 「那就拜托先代大人来主持吧，她肯定很乐意。」
					ELSEIF !CFLAG:[[早苗]]:出禁
						PRINTFORML 「虽然我当不了自己的司仪……不过早苗应该可以帮忙。」
						PRINTFORMDL 灵梦有些不好意思地说：
						PRINTFORML 「守矢神社的正牌巫女来主持，排场也不差嘛。」
					ELSE
						PRINTFORML 「虽然没人能主持……不过也没关系，我们自己来就好。」
					ENDIF
					PRINTFORMW 「费用的话，%金額表示(1000000)%。别看我这样，该收的钱还是要收的。」
					RESETCOLOR
					WEDDING_VENUE_AGREED = 1
				ELSE
					PRINTFORMDW 你应该去和灵梦谈谈。
					WEDDING_VENUE_AGREED = 0
				ENDIF
			CASE 2
				PRINTFORMDL 选择了妖精式婚礼。
				PRINTFORMDL 婚礼将在太阳花田举行。
				WEDDING_TYPE = FAIRY
				WEDDING_LOCATION = P438太陽の畑
				IF LEGAL_SPOUSE == [[幽香]]
					;幽香是新娘，直接确认场地
					CALL SET_KOJO_COLOR([[幽香]])
					PRINTFORML 「在我的花田举办婚礼？」
					PRINTFORML 「……难得有人提出这种请求呢。」
					PRINTFORML 「拉尔瓦会帮忙布置的，你就安心吧。」
					PRINTFORMW 「费用%金額表示(1500000)%……我可不是在收你的钱，只是花田维护的开销而已。」
					RESETCOLOR
					WEDDING_VENUE_AGREED = 1
				ELSE
					PRINTFORMDW 你应该去和幽香谈谈。
					WEDDING_VENUE_AGREED = 0
				ENDIF
				CASE 3
					PRINTFORMDL %CALLNAME:TARGET%会亲自筹备场地。
					CALL KOJO_CHECK(TARGET, "CUSTOM_WEDDING", "COST")
					LOCAL = RESULT
					PRINTFORMDL 费用为：%金額表示(RESULT)%。

					PRINTFORMDL 这样可以吗？
					CALL ASK_YN
					IF !RESULT
						CALL KOJO_CHECK(TARGET, "CUSTOM_WEDDING", "LOCATION")
						WEDDING_LOCATION = RESULT
						WEDDING_VENUE_AGREED = 1
						WEDDING_TYPE = CUSTOM
						WEDDING_CUSTOM_COST = LOCAL
						PRINTFORMDW 婚礼将在%NAME_FROM_PLACE(GET_MAP_REPLACEMENT(WEDDING_LOCATION))%举行。
					ELSE
						PRINTFORMDW 已取消。
						RETURN -1
					ENDIF
			ENDSELECT
		CASE 1
			CALL KOJO_MESSAGE_SEND("EVENT", 0, TARGET, 0, 0, "WEDDING_PREPARATIONS", "SIZE")
			PRINTFORMDL 婚礼要多大规格？
			CALL ASK_M("小型（最多10位来宾）", 1, "中型（最多15位来宾）", 1, "大型（最多30位来宾）", 1, "超大型（最多50位来宾）", 1, @"盛大（最多{CHARANUM-1}位来宾）", 1)
			LOCAL = RESULT
			
			SELECTCASE LOCAL
				CASE 0
					LOCAL = 10
					LOCAL:1 = 500000
				CASE 1
					LOCAL = 15
					LOCAL:1 = 1500000
				CASE 2
					LOCAL = 30
					LOCAL:1 = 5000000
				CASE 3
					LOCAL = 50
					LOCAL:1 = 10000000
				CASE 4
					LOCAL = CHARANUM-1
					LOCAL:1 = 50000000
			ENDSELECT

			PRINTFORMDL 此规模的婚礼将额外花费￥{LOCAL:1}。
			PRINTFORMDL 这样可以吗？
			CALL ASK_YN

			IF !RESULT
				WEDDING_SIZE = LOCAL
				VARSET WEDDING_GUESTS
			ELSE
				PRINTFORMDW 已取消。
				RETURN -1
			ENDIF
		CASE 2
			CALL KOJO_MESSAGE_SEND("EVENT", 0, TARGET, 0, 0, "WEDDING_PREPARATIONS", "DATE")
			LOCAL = DAY + (MARRIAGE_DEBUG ? 1 # 10)
			SIF WEDDING_DATE > 0
				LOCAL = MIN(WEDDING_DATE, LOCAL)

			PRINTFORMDL 婚礼要在哪天举行？（必须在%PRINT_DATE_F(LOCAL,1)%或之后）
			CALL DATEPICKER(WEDDING_DATE > 0 ? WEDDING_DATE # -1, LOCAL)
			SIF RESULT < 0
				RETURN -1

			WEDDING_DATE = RESULT
			WEDDING_TIME = (CFLAG:TARGET:起床時間 + 180) % 1440
			PRINTFORMDL 婚礼将于%UNCAPITALIZE(PRINT_DATE_F(WEDDING_DATE))% %TWENTY_FOUR_TIME(WEDDING_TIME)%举行。
		CASE 3
			CALL KOJO_MESSAGE_SEND("EVENT", 0, TARGET, 0, 0, "WEDDING_PREPARATIONS", "GUESTS")
			CALL ADD_SPOUSE_GUESTS()
			;first value is count
			ARRAYCOPY "RESULT", "SPOUSE_GUESTS"
			SELECTCASE WEDDING_SIZE
				CASE IS > 50
					MAX_SPOUSE_GUESTS = 30
				CASE 50
					MAX_SPOUSE_GUESTS = 20
				CASE 30
					MAX_SPOUSE_GUESTS = 10
				CASE 15
					MAX_SPOUSE_GUESTS = 7
				CASEELSE
					MAX_SPOUSE_GUESTS = 5
			ENDSELECT
			MAX_SPOUSE_GUESTS = MIN(MAX_SPOUSE_GUESTS, SPOUSE_GUESTS:0)
			SIF MAX_SPOUSE_GUESTS < 30
				VARSET SPOUSE_GUESTS, 0, MAX_SPOUSE_GUESTS + 1

			FOR LOCAL, 1, MAX_SPOUSE_GUESTS+1
				SIF !SPOUSE_GUESTS:LOCAL
					BREAK
				WEDDING_GUESTS:(SPOUSE_GUESTS:LOCAL) = 1
			NEXT

			FIRST_LINE = LINECOUNT
			$OVERVIEW
			CLEARLINE LINECOUNT - FIRST_LINE
			REDRAW 0
			PRINTFORMDL 你想邀请谁参加婚礼？
			PRINTFORMDL 橙色标记的角色已被%CALLNAME:TARGET%邀请。
			PRINTFORMDL 红色标记的角色因%CALLNAME:TARGET%讨厌而无法邀请。
			
			DRAWLINE
			FOR LOCAL,1,CHARANUM-1
				IF LOCAL == LEGAL_SPOUSE
					CONTINUE
				ELSEIF NO:LOCAL != LOCAL
					CONTINUE
				ELSEIF CFLAG:LOCAL:出禁
					CONTINUE
				ELSEIF FINDELEMENT(SPOUSE_GUESTS, LOCAL, 1) >= 0
					SETCOLOR C_ORANGE
				ELSEIF WEDDING_GUESTS:LOCAL
					SETCOLOR C_YELLOW
				ELSEIF INRANGE(RELATION:LEGAL_SPOUSE:LOCAL, 1, 99)
					SETCOLOR C_RED
				ELSE
					RESETCOLOR
				ENDIF
				PRINTFORMLC [{LOCAL}] %CALLNAME:LOCAL%
			NEXT
			RESETCOLOR
			PRINTFORML 
			DRAWLINE
			IF WEDDING_SIZE > 50
				PRINTFORMDL [997] 全部取消
				PRINTFORMDL [998] 全部选择
			ENDIF
			PRINTFORMDL [999] 完成
			$INPUT_LOOP
			INPUT
			LOCAL = RESULT
			IF LOCAL >= CHARANUM && !INRANGE(LOCAL, 997, 999)
				CLEARLINE 1
				REUSELASTLINE 无效输入
				GOTO INPUT_LOOP
			ELSEIF LOCAL == 999
			ELSEIF LOCAL == 998
				FOR LOCAL, 1, CHARANUM
					SIF !INRANGE(RELATION:LEGAL_SPOUSE:LOCAL, 1, 99) && !CFLAG:LOCAL:出禁 && LOCAL != LEGAL_SPOUSE
						WEDDING_GUESTS:LOCAL = 1
				NEXT
				CLEARLINE 1
				GOTO OVERVIEW
			ELSEIF LOCAL == 997
				FOR LOCAL, 1, CHARANUM
					SIF FINDELEMENT(SPOUSE_GUESTS, LOCAL, 1) < 0
						WEDDING_GUESTS:LOCAL = 0
				NEXT
				CLEARLINE 1
				GOTO OVERVIEW
			ELSEIF FINDELEMENT(SPOUSE_GUESTS, LOCAL, 1) >= 0
				CLEARLINE 1
				REUSELASTLINE 无法移除。
				GOTO INPUT_LOOP
			ELSEIF INRANGE(RELATION:LEGAL_SPOUSE:LOCAL, 1, 99)
				CLEARLINE 1
				REUSELASTLINE 不允许。
				GOTO INPUT_LOOP
			ELSE
				IF !WEDDING_GUESTS:LOCAL && SUMARRAY(WEDDING_GUESTS) >= WEDDING_SIZE
					CLEARLINE 1
					REUSELASTLINE 此规模的婚礼无法再添加更多来宾。
					GOTO INPUT_LOOP
				ENDIF
				WEDDING_GUESTS:LOCAL = !WEDDING_GUESTS:LOCAL
				GOTO OVERVIEW
			ENDIF
		CASE 4
			PRINTFORMDL 按当前选项，婚礼将花费%金額表示(ADD_WEDDING_COST())%。

			IF MONEY < ADD_WEDDING_COST()
				PRINTFORMDL 你没有足够的钱支付。
			ELSE
				PRINTFORMDL 以此设定确定婚礼？一旦确认，将无法再更改。
				CALL ASK_YN
				IF !RESULT
					WEDDING_PLANNING_COMPLETE = 1
					PRINTFORMDL 婚礼策划完成。
					CALL PAY_MONEY_YEN(ADD_WEDDING_COST(),2)
				ENDIF
			ENDIF
		CASE 5
			RETURN -1
	ENDSELECT
ELSE
	IF TARGET == [[レミリア]]
		IF LEGAL_SPOUSE == [[レミリア]]
			;蕾米莉亚是新娘
			CALL SET_KOJO_COLOR([[レミリア]])
			PRINTFORML 「在我的宅邸举办婚礼？那还用说！」
			PRINTFORML 「恭喜你……也恭喜我自己。」
			PRINTFORML 「咲夜会替我们操办一切的，你放心吧。」
			PRINTFORMW 「费用嘛……%金額表示(2000000)%！呋呋，就算到咱家的小金库里就好。」
			RESETCOLOR
		ELSE
			CALL SET_KOJO_COLOR([[レミリア]])
			PRINTFORML 「婚礼啊，你想在我的宅邸举办？」
			PRINTFORML 「太棒了。恭喜你！」
			PRINTFORML 「我最喜欢盛大的活动了，这可是展示我华丽风采的大好机会。」
			IF !CFLAG:[[咲夜]]:出禁
				PRINTFORML 「咲夜会负责筹备的，她可是我最信赖的女仆。」
			ENDIF
			PRINTFORMW 「当然，费用是必须的，你需要支付%金額表示(2000000)%才行。」
			RESETCOLOR
		ENDIF
		WEDDING_VENUE_AGREED = 1
	ELSEIF TARGET == [[霊夢]]
		IF LEGAL_SPOUSE == [[霊夢]]
			;灵梦是新娘
			CALL SET_KOJO_COLOR([[霊夢]])
			PRINTFORML 「诶？在神社办婚礼？」
			PRINTFORML 「……也不是不行啦。毕竟是我自己的事嘛。」
			IF !CFLAG:[[先代]]:出禁
				PRINTFORML 「那自然是让真正的博丽巫女出面啦——开玩笑的。」
				PRINTFORMDL 灵梦想了想，补充道：
				PRINTFORML 「那就拜托先代来主持吧，她肯定很乐意。」
			ELSEIF !CFLAG:[[早苗]]:出禁
				PRINTFORML 「虽然我当不了自己的司仪……不过早苗应该可以帮忙。」
				PRINTFORMDL 灵梦有些不好意思地说：
				PRINTFORML 「守矢神社的正牌巫女来主持，排场也不差嘛。」
			ELSE
				PRINTFORML 「虽然没人能主持……不过也没关系，我们自己来就好。」
			ENDIF
			PRINTFORMW 「费用的话，%金額表示(1000000)%。别看我这样，该收的钱还是要收的。」
			RESETCOLOR
		ELSE
			CALL SET_KOJO_COLOR([[霊夢]])
			PRINTFORML 「要在我的神社办婚礼？」
			PRINTFORML 「行啊行啊，反正神社平时也没什么人。」
			PRINTFORML 「恭喜你了！不过别指望我免费借你场地哦。」
			PRINTFORMW 「场地费%金額表示(1000000)%，童叟无欺。这可是博丽神社的行情价！」
			RESETCOLOR
		ENDIF
		WEDDING_VENUE_AGREED = 1
	ELSEIF TARGET == [[幽香]]
		IF LEGAL_SPOUSE == [[幽香]]
			;幽香是新娘
			CALL SET_KOJO_COLOR([[幽香]])
			PRINTFORML 「在我的花田举办婚礼？」
			PRINTFORML 「……难得有人提出这种请求呢。」
			PRINTFORML 「拉尔瓦会帮忙布置的，你就安心吧。」
			PRINTFORMW 「费用%金額表示(1500000)%……我可不是在收你的钱，只是花田维护的开销而已。」
			RESETCOLOR
		ELSE
			CALL SET_KOJO_COLOR([[幽香]])
			PRINTFORML 「好久没见过妖精的婚礼了呢。」
			PRINTFORML 「好吧。我允许了。连准备工作我也一并包了。」
			IF !CFLAG:[[ラルバ]]:出禁
				PRINTFORML 「拉尔瓦会帮忙打理花田的布置，那孩子虽然小，做事还算靠谱。」
			ENDIF
			PRINTFORMW 「全部加起来大概需要%金額表示(1500000)%左右。」
			RESETCOLOR
		ENDIF
		WEDDING_VENUE_AGREED = 1
	ENDIF
ENDIF
TIME += 10
RETURN 1

@ADD_WEDDING_COST()
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTION
LOCAL = 0
IF WEDDING_VENUE_AGREED
	SELECTCASE WEDDING_TYPE
		CASE "WESTERN"
			LOCAL += 2000000
		CASE "JAPANESE"
			LOCAL += 1000000
		CASE "FAIRY"
			LOCAL += 1500000
		CASE "CUSTOM"
			LOCAL += WEDDING_CUSTOM_COST
	ENDSELECT
ENDIF

IF WEDDING_SIZE
	SELECTCASE WEDDING_SIZE
		CASE IS > 50
			LOCAL += 50000000
		CASE 50
			LOCAL += 10000000
		CASE 30
			LOCAL += 5000000
		CASE 15
			LOCAL += 1500000
		CASEELSE
			LOCAL += 500000
	ENDSELECT
ENDIF
RETURNF LOCAL

@ADD_SPOUSE_GUESTS()
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC GUESTS, 200
#DIM DYNAMIC GUESTS_RELATION, 200
#DIM DYNAMIC GUEST_INDEX
VARSET RESULT
CALL KOJO_CHECK(LEGAL_SPOUSE, "WEDDING_GUESTS")

IF RESULT
	LOCAL = FINDELEMENT(RESULT, 0)
	RETURN LOCAL
ELSE
	FOR LOCAL, 1, CHARANUM
		IF RELATION:LEGAL_SPOUSE:LOCAL > 100
			GUESTS:GUEST_INDEX = LOCAL
			GUESTS_RELATION:GUEST_INDEX = RELATION:LEGAL_SPOUSE:LOCAL
			GUEST_INDEX++
		ENDIF
	NEXT

	ARRAYMSORT GUESTS_RELATION, GUESTS
	ARRAYSHIFT GUESTS, 1, 0
	ARRAYCOPY "GUESTS", "RESULT"

	RETURN GUEST_INDEX
ENDIF

@ADD_WEDDING_READY()
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTION
SIF !STRLENS(WEDDING_TYPE)
	RETURNF 0
SIF !WEDDING_VENUE_AGREED
	RETURNF 0
SIF !WEDDING_SIZE
	RETURNF 0
SIF !WEDDING_DATE
	RETURNF 0
SIF !SUMARRAY(WEDDING_GUESTS)
	RETURNF 0

RETURNF 1

@ADD_CUSTOM_COM_ABLE14
#LOCALSIZE 1
#LOCALSSIZE 1
SIF !TARGET
	RETURN 0
SIF MARRIAGE_STATE != 1
	RETURN 0
SIF WEDDING_PLANNING_COMPLETE
	RETURN 0
SIF CFLAG:うふふ
	RETURN 0
SIF !SHIRAHU(TARGET)
	RETURN 0
SIF FLAG:時間停止
	RETURN 0
IF TARGET == LEGAL_SPOUSE
	SIF !TALENT:妻
		RETURN 0
ELSE
	IF WEDDING_VENUE_AGREED
		RETURN 0
	ELSEIF WEDDING_TYPE == "WESTERN" && TARGET == [[レミリア]]
	ELSEIF WEDDING_TYPE == "JAPANESE" && TARGET == [[霊夢]]
	ELSEIF WEDDING_TYPE == "FAIRY" && TARGET == [[幽香]]
	ELSE
		RETURN 0
	ENDIF
ENDIF

RETURN 1

@ADD_CUSTOM_MESSAGE_COM14
#LOCALSIZE 1
#LOCALSSIZE 1
