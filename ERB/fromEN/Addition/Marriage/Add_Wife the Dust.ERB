@WIFE_THE_DUST_PROCESSING(OPERATION)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS DYNAMIC OPERATION
#DIM DYNAMIC FIRST_LINE
#DIM DYNAMIC WIVES_TO_RESTORE, キャラクタ数上限
SELECTCASE OPERATION
	CASE "save"
		PRINTFORMDL 保存当前\@ WIFE_COUNT() == 1 ? 妻子 # 妻子们 \@的记忆？
		PRINTFORMDL 她们的数据将保存在\dat文件夹中，可以在后续的世界中恢复。
		CALL ASK_YN
		IF !RESULT
			FOR LOCAL, 1, CHARANUM
				SIF CFLAG:LOCAL:DUPLICATE_CHARACTER
					CONTINUE
				IF TALENT:LOCAL:妻 == 2
					IF !MARRIAGE_WIFE_THE_DUST_CODES:LOCAL
						MARRIAGE_WIFE_THE_DUST_CODES:LOCAL = WIFE_THE_DUST_GENERATE_ID()
					ELSE
						IF MARRIAGE_WIFE_THE_DUST_CODES:LOCAL != CFLAG:LOCAL:WIFE_THE_DUST_ID
							PRINTFORMDL %CALLNAME:LOCAL%已有保存的版本。
							PRINTFORMDL 要保留哪个版本？
							CALL ASK_YN("旧版本", "新版本")
							SIF !RESULT
								CONTINUE
						ENDIF
					ENDIF
					SETBIT CFLAG:LOCAL:引き継ぎ, 1
					SIF TALENT:LOCAL:自慰狂い
						SETBIT CFLAG:LOCAL:引き継ぎ, 2
					SIF TALENT:LOCAL:淫壺
						SETBIT CFLAG:LOCAL:引き継ぎ, 3
					SIF TALENT:LOCAL:尻穴狂い
						SETBIT CFLAG:LOCAL:引き継ぎ, 4
					SIF TALENT:LOCAL:淫乳
						SETBIT CFLAG:LOCAL:引き継ぎ, 5
					SIF TALENT:LOCAL:キス魔
						SETBIT CFLAG:LOCAL:引き継ぎ, 6
					VARSET CHILDNAME:LOCAL:0
					VARSET CHILD_SEX:LOCAL:0
					VARSET CHILD_BIRTHDAY:LOCAL:0
					VARSET CHILD_BIRTHDATE:LOCAL:0
					VARSET CHILD_LOVE:LOCAL:0
					VARSET CHILD_WEATHER:LOCAL:0
					VARSET CHILD_ACT:LOCAL:0
					VARSET CHILD_AREA:LOCAL:0
					VARSET CHILD_INDEPENDENT:LOCAL:0
					VARSET CHILD_TIMESTAMP:LOCAL:0
					VARSET CHILD_PRINT_DESCRIPTION:LOCAL:0
					VARSET CHILD_HUNGER:LOCAL:0
					CFLAG:LOCAL:子供人数 = 0
					CFLAG:LOCAL:育児人数 = 0
					CFLAG:LOCAL:出産経過日 = 0
					CFLAG:LOCAL:BANQUET = 0
					CFLAG:LOCAL:BANQUET_ROLE = 0
					CFLAG:LOCAL:宴会参加 = 0
					LOCALS '= WIFE_THE_DUST_FILE(LOCAL, MARRIAGE_WIFE_THE_DUST_CODES:LOCAL)
					CFLAG:LOCAL:WIFE_THE_DUST_ID = MARRIAGE_WIFE_THE_DUST_CODES:LOCAL
					DEBUGPRINTFORML 正在保存%CALLNAME:LOCAL%的配偶数据至"%LOCALS%"
					SAVECHARA LOCALS, @"Wife the Dust data for {LOCAL}", LOCAL
				ENDIF
			NEXT
		ENDIF
	CASE "restore"
		SIF !SUMARRAY(MARRIAGE_WIFE_THE_DUST_CODES)
			RETURN
		FIRST_LINE = LINECOUNT
		$OVERVIEW
		CLEARLINE LINECOUNT - FIRST_LINE
		REDRAW 0
		PRINTFORMDL 要从之前的游戏中继承哪些妻子？
		DRAWLINE
		FOR LOCAL,1,CHARANUM-1
			SIF !MARRIAGE_WIFE_THE_DUST_CODES:LOCAL
				CONTINUE
			CHKCHARADATA WIFE_THE_DUST_FILE(LOCAL, MARRIAGE_WIFE_THE_DUST_CODES:LOCAL)
			IF RESULT
				SETCOLOR C_RED
			ELSEIF WIVES_TO_RESTORE:LOCAL
				SETCOLOR C_GREEN
			ELSE
				RESETCOLOR
			ENDIF
			PRINTFORMLC [{LOCAL}] %CALLNAME:LOCAL%
		NEXT
		RESETCOLOR
		PRINTFORML 
		DRAWLINE
		PRINTFORML [999] 完成
		$INPUT_LOOP
		INPUT
		LOCAL = RESULT
		IF LOCAL >= CHARANUM && LOCAL != 999
			CLEARLINE 1
			REUSELASTLINE 无效输入
			GOTO INPUT_LOOP
		ELSEIF LOCAL == 999
			FOR LOCAL,1,CHARANUM-1
				SIF WIVES_TO_RESTORE:LOCAL
					CALL WIFE_THE_DUST_RESTORE(LOCAL, WIFE_THE_DUST_FILE(LOCAL, MARRIAGE_WIFE_THE_DUST_CODES:LOCAL))
			NEXT
		ELSE
			CHKCHARADATA WIFE_THE_DUST_FILE(LOCAL, MARRIAGE_WIFE_THE_DUST_CODES:LOCAL)
			IF RESULT
				CALL COLORMESSAGE(@"错误：加载%CALLNAME:LOCAL%的角色文件'chara_%WIFE_THE_DUST_FILE(LOCAL, MARRIAGE_WIFE_THE_DUST_CODES:LOCAL)%.dat'时发生异常。", C_RED, 1)
				CALL COLORMESSAGE(@"角色无法恢复。", C_RED, 2)
			ELSE
				WIVES_TO_RESTORE:LOCAL = !WIVES_TO_RESTORE:LOCAL
			ENDIF
			RESETCOLOR
			GOTO OVERVIEW
		ENDIF
ENDSELECT

@WIFE_THE_DUST_RESTORE(CHARA, FILE)
#LOCALSIZE 4
#LOCALSSIZE 1
#DIM DYNAMIC CHARA
#DIMS DYNAMIC FILE

DEBUGPRINTFORML 正在从"%FILE%"恢复%CALLNAME:CHARA%的配偶数据
LOCAL:2 = CHARANUM
LOADCHARA FILE
IF !RESULT
	CALL COLORMESSAGE(@"错误：%CALLNAME:LOCAL%的角色文件'chara_%FILE%.dat'无法加载。", C_RED, 1)
	CALL COLORMESSAGE(@"角色无法恢复。", C_RED, 2)
	RETURN
ENDIF
LOCAL:3 = CHARANUM - LOCAL:2
COPYCHARA LOCAL:2, CHARA
DELCHARA LOCAL:2

@WIFE_THE_DUST_GENERATE_ID
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTION
VARSET LOCAL
WHILE !LOCAL
	LOCAL = RAND:1099511627776
WEND
RETURNF LOCAL

@WIFE_THE_DUST_FILE(CHARA, CODE)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTIONS
#DIM DYNAMIC CHARA
#DIM DYNAMIC CODE
RETURNF @"{CHARA}_%TOSTR(CODE, "X10")%"
