@CONCUBINAGE_TALK_TENGU
#DIM CONST TENGU_PAYMENT = 3500000
CALL SET_KOJO_COLOR([[文]])
SELECTCASE CONCUBINAGE_CONVINCED_TENGU
    CASE 0
        PRINTFORMDW 你向文表达了想要面见天狗之长——天魔大人的意愿。
        PRINTFORML 「天魔大人本人？！」
        PRINTFORMW 「这和你正在搞的那个小"计划"有关吧？」
