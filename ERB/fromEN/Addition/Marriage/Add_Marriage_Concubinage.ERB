                        PRINTFORML 「不错。记住这一点，你应该能应对任何针对你家人的不速之客。」
                        PRINTFORMW 「好了，我大概该给她们三个松绑了……」
                        CONCUBINAGE_REIMU_TRAINING_REMAINING--
                    ELSE
                        PRINTFORMDL 不幸的是，你不习惯这样，%SPLIT_G("桑妮:露娜:斯塔")%被弹幕打中了脸。
                        PRINTFORML 「嗯，这也难怪。你应该多练习搬运重物。」
                        PRINTFORML 「这样以后应对这种情况会更容易。」
                        PRINTFORMW 「明天再来，我们再试一次。」
                    ENDIF
                    
                CASE 2
                    PRINTFORML 「接下来是这个。」
                    PRINTFORML 『第四课：尊老敬贤』
                    PRINTFORMW 「看看你能不能躲过这个。」
                    PRINTFORMDW 灵梦放出一张极其复杂的符卡，你看不出任何空隙。
                    IF ABL:MASTER:教養 + CFLAG:[[永琳]]:弾幕勝負勝利 + CFLAG:[[純狐]]:弾幕勝負勝利 > RAND:10
                        PRINTFORMDL 等等，这不就是永琳的符卡和纯狐的符卡混在一起吗？
                        SIF ABL:MASTER:教養 > 3
                            PRINTFORMDL 你很确定之前在书上见过这些。
                        PRINTFORMDW 既然你知道了模式，躲避就不太难了，你轻松地把符卡耗到了时间结束。
                        PRINTFORML 「干得好，你反应得不错。」
                        PRINTFORML 「永远记住，真正愤怒的妖怪可能不会按规矩来，你需要做好万全准备。」
                        PRINTFORML 「她们很可能会直接偷别人的强力符卡，而不是自己创造。」
                        PRINTFORMW 「一定要尽可能多地了解各种符卡。」
                        CONCUBINAGE_REIMU_TRAINING_REMAINING--
                    ELSE
                        PRINTFORMDL 无法逃脱，你被攻击重创。
                        PRINTFORML 「这对你来说可能有点太难了。」
                        PRINTFORML 「记住弹幕不只是战斗，还要了解你的对手。」
                        PRINTFORML 「学习同样重要。」
                        PRINTFORML 「……好吧，至少对除了我以外的人来说是这样。」
                        PRINTFORML 「明天再来，我们再试一次」
                        PRINTFORMDW 灵梦走开了，留你自己舔伤口。
                    ENDIF
                CASE 1
                    PRINTFORML 「这是你的最后一课。如果你能通过，我就愿意支持你那个愚蠢的后宫计划。」
                    PRINTFORML 「这次我叫了一些朋友来帮忙。」
                    PRINTFORMW 『第五课：兵不厌诈』
                    CALL CHARA_TEXT([[早苗]], "「我不习惯群战，但我会尽力的。」")
                    CALL CHARA_TEXT([[魔理沙]], @"「对%PRINT_MALE("一个男人", MASTER)%围攻有点过意不去，但既然灵梦觉得有必要，我就不客气了。」")
                    CALL CHARA_TEXT([[妖夢]], "「没关系，这毕竟是训练的一部分。」")
                    CALL CHARA_TEXT([[咲夜]], "「这会是保持技能敏锐的好机会。」")
                    PRINTFORMDL 等等，五个人同时上？
                    CALL CHARA_TEXT([[魔理沙]], @"「这不是你想要的吗？一大群女孩子追着你？」")
                    PRINTFORMW 「开始吧。如果你连这都应付不了，在真正的战斗中你更不行。」
                    PRINTFORMDL 她们五个人开始向你发射弹幕，有时轮换，有时配合。
                    PRINTFORMDW 猛烈的攻势毫不留情，最终……
                    IF ABL:MASTER:戦闘能力 + 弾幕勝負勝利カウント() > 35
                        PRINTFORMDW 所有女孩都倒在了地上。
                        CALL CHARA_TEXT([[魔理沙]], @"「疼疼疼。我认输，我认输。」")
                        PRINTFORML 「够了。你赢了。」
                        CALL CHARA_TEXT([[咲夜]], @"「你能应对得这么好，真令人印象深刻。」")
                        CALL CHARA_TEXT([[妖夢]], @"「你真厉害，%CALLNAME:MASTER%。我不介意多跟你一起训练。」")
                        CALL CHARA_TEXT([[早苗]], "「比想象中疼多了。我回家后大概会直接上床睡觉。」")
                        PRINTFORML 「总之，我正式支持你的纳妾计划。」
                        PRINTFORMW 「只是别来找我哭诉它引起的那些闹剧。」
                    
                        CONCUBINAGE_REIMU_TRAINING_REMAINING--
                        CONCUBINAGE_CONVINCED_REIMU = 2
                    ELSE
                        PRINTFORMDW 你倒在了地上。
                        CALL CHARA_TEXT([[魔理沙]], @"「你就这点本事？」")
                        CALL CHARA_TEXT([[早苗]], @"「我们是不是太过分了？」")
                        PRINTFORML 「没事，不用担心，%HE_SHE(MASTER)%就是还不够强。」
                        CALL CHARA_TEXT([[妖夢]], @"「你不够专注，%CALLNAME:MASTER%。你像只无头苍蝇一样乱跑。」")
                        CALL CHARA_TEXT([[咲夜]], "「如果就这些的话，我就先走了。宅邸里还有工作要做。」")
                        PRINTFORMW 「谢谢你们的帮忙。不过我想下次还需要再叫你们来。」
                        PRINTFORML 「至于你，%CALLNAME:MASTER%……」
                        PRINTFORML 「你真的需要多练习。」
                        PRINTFORML 「花点时间练基本功，跟新对手打打……」
                        PRINTFORML 「你得确保能应对她们向你投来的一切。」
                        CALL CHARA_TEXT([[魔理沙]], @"「弹幕毕竟是永无止境的挑战嘛。」", "w")
                    ENDIF
            ENDSELECT
            CONCUBINAGE_REIMU_LAST_TRAINING_DAY = DAY
            TIME += 120
        ENDIF
ENDSELECT
[SKIPEND]
@CONCUBINAGE_FALL_STATE(ARG, EXPECTED_WIDTH)
#DIM EXPECTED_WIDTH
SIF !CONCUBINAGE_LEGALIZED
    RETURN
SIF TALENT:ARG:妻
    RETURN
SIF (TALENT:ARG:恋慕 < 2 || !TALENT:ARG:恋人) && !TALENT:ARG:愛欲
    RETURN 0

PRINTFORMDL %"-"*(EXPECTED_WIDTH)%
CALL COLORMESSAGE(@"□侧室达成条件",C_AQUA,1)
PRINTFORML
IF TALENT:ARG:妾
	PRINT 　
	CALL COLORMESSAGE(@"-　已达成",C_YELLOW,1)
ELSE
    IF TALENT:ARG:恋慕
        PRINT 　
        CALL COND_COLORMESSAGE(CFLAG:ARG:好感度 >= REQUIRED_FAVOR_CONCUBINE_LOVE,@"好感度{REQUIRED_TRUST_CONCUBINE_LOVE}以上 (现在：{CFLAG:ARG:好感度})")
        PRINT 　
        CALL COND_COLORMESSAGE(CFLAG:ARG:信頼度 >= REQUIRED_TRUST_CONCUBINE_LOVE,@"信赖度{REQUIRED_TRUST_CONCUBINE_LOVE}以上 (现在：{CFLAG:ARG:信頼度})")
        PRINT 　
        CALL COND_COLORMESSAGE(ABL:ARG:親密 >= REQUIRED_AFFECTION_CONCUBINE_LOVE,@"亲密{REQUIRED_AFFECTION_CONCUBINE_LOVE}以上 (现在：{ABL:ARG:親密})")
        PRINT 　
        CALL COND_COLORMESSAGE(RELATION:MASTER:ARG >= REQUIRED_AFFINITY_CONCUBINE_LOVE,@"关系{REQUIRED_AFFINITY_CONCUBINE_LOVE}以上 (现在：{RELATION:MASTER:ARG})")
    ELSEIF TALENT:ARG:愛欲
        PRINT 　
        CALL COND_COLORMESSAGE(CFLAG:ARG:好感度 >= REQUIRED_FAVOR_CONCUBINE_LUST,@"好感度{REQUIRED_TRUST_CONCUBINE_LUST}以上 (现在：{CFLAG:ARG:好感度})")
        PRINT 　
        CALL COND_COLORMESSAGE(CFLAG:ARG:信頼度 >= REQUIRED_TRUST_CONCUBINE_LUST,@"信赖度{REQUIRED_TRUST_CONCUBINE_LUST}以上 (现在：{CFLAG:ARG:信頼度})")
        PRINT 　
        CALL COND_COLORMESSAGE(ABL:ARG:欲望 >= REQUIRED_LUST_CONCUBINE_LUST,@"欲望{REQUIRED_LUST_CONCUBINE_LUST}以上 (现在：{ABL:ARG:欲望})")
    ENDIF
ENDIF
