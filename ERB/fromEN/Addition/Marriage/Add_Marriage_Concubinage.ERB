[SKIPSTART]
@EVENTEND
#PRI
IF CONCUBINAGE_LEGALIZED
    FOR LOCAL, 1, CHARANUM
        SIF CFLAG:LOCAL:WIFE_VISITATION && !CFLAG:LOCAL:神社在住
            CFLAG:LOCAL:翌日来訪 = 1
    NEXT
ELSE
    SIF CONCUBINAGE_PROGRESS < 0
        RETURN
    SIF FLAG:気絶中断
        RETURN
    SIF MARRIAGE_STATE < 2 || DAY < (WEDDING_DATE + 7)
        RETURN

    CALL CONCUBINAGE_CORE_LOOP
ENDIF

@CONCUBINAGE_CORE_LOOP
IF CONCUBINAGE_PROGRESS == 0 ;initialize concubinage
    PRINTFORMDL 最近你一直在思考自己的婚姻，但%CALLNAME:LEGAL_SPOUSE%真的足够吗？
    PRINTFORMDL 也许你可以拥有更多。一个小小的后宫，只属于你。
    PRINTFORMDL 你理应得到这些，不是吗？
    
    PRINTFORMDL 认真考虑这个想法？
    CALL ASK_YN
    IF !RESULT
        CONCUBINAGE_PROGRESS = 1
        PRINTFORMDL 这个想法在脑海中逐渐成形，你拿出笔记本，决定列一份待办清单。
        PRINTFORMDW 首先，你应该和幻想乡中有重大影响力的人商量这件事。
    ELSE
        PRINTFORMDW 你认定%CALLNAME:LEGAL_SPOUSE%对你来说已经足够了，便将这个愚蠢的念头抛诸脑后。
        CONCUBINAGE_PROGRESS = -2 ;full rejection
    ENDIF
ELSEIF CONCUBINAGE_PROGRESS == 3
    LOCAL = 0
    SIF CONCUBINAGE_CONVINCED_AKYUU == 2
        LOCAL++
    SIF CONCUBINAGE_CONVINCED_VILLAGERS == 2
        LOCAL++
    SIF CONCUBINAGE_CONVINCED_EIKI == 2
        LOCAL++
    SIF CONCUBINAGE_CONVINCED_TENGU == 2
        LOCAL++
    SIF CONCUBINAGE_CONVINCED_KANAKO == 2
        LOCAL++
    SIF CONCUBINAGE_CONVINCED_BYAKUREN == 2
        LOCAL++
    SIF CONCUBINAGE_CONVINCED_MIKO == 2
        LOCAL++
    SIF CONCUBINAGE_CONVINCED_OKINA == 2
        LOCAL++
    SIF CONCUBINAGE_CONVINCED_KASEN == 2
        LOCAL++
    SIF CONCUBINAGE_CONVINCED_REMILIA == 2
        LOCAL++
    SIF CONCUBINAGE_CONVINCED_MAMIZOU == 2
        LOCAL++
    SIF CONCUBINAGE_CONVINCED_REIMU == 2
        LOCAL++

    ;trigger initial event
    IF LOCAL >= 4 && !CONCUBINAGE_CONVINCED_REMILIA
        CALL CONCUBINAGE_TALK_REMILIA
    ENDIF
    IF LOCAL >= 6 && !CONCUBINAGE_CONVINCED_MAMIZOU
        CALL CONCUBINAGE_TALK_MAMIZOU
    ENDIF

    ;nightly progress once applicable
    CALL CONCUBINAGE_OKINA_PROGRESS
ENDIF
RESETCOLOR

@CONCUBINAGE_CAN_TAKE_AS_CONCUBINE(ARG)
#FUNCTION
;set requirements
SIF !CONCUBINAGE_LEGALIZED
    RETURNF 0
SIF TALENT:ARG:妻
    RETURNF 0
SIF TALENT:ARG:妾
    RETURNF 0
SIF TALENT:ARG:恋慕 && (!TALENT:ARG:恋人 || TALENT:ARG:恋慕 < 2)
    RETURNF 0
SIF !TALENT:ARG:恋慕 && !TALENT:ARG:愛欲
    RETURNF 0

IF TALENT:ARG:恋慕
    SIF RELATION:MASTER:ARG < REQUIRED_AFFINITY_CONCUBINE_LOVE
        RETURNF 0
    SIF CFLAG:ARG:好感度 < REQUIRED_FAVOR_CONCUBINE_LOVE
        RETURNF 0
    SIF CFLAG:ARG:信頼度 < REQUIRED_TRUST_CONCUBINE_LOVE
        RETURNF 0
    SIF ABL:ARG:親密 < REQUIRED_AFFECTION_CONCUBINE_LOVE
        RETURNF 0
    RETURNF 1
ELSEIF TALENT:ARG:愛欲
    SIF CFLAG:ARG:好感度 < REQUIRED_FAVOR_CONCUBINE_LUST
        RETURNF 0
    SIF CFLAG:ARG:信頼度 < REQUIRED_TRUST_CONCUBINE_LUST
        RETURNF 0
    SIF ABL:ARG:欲望 < REQUIRED_LUST_CONCUBINE_LUST
        RETURNF 0
    RETURNF 1
ENDIF

RETURNF 0

@CONCUBINAGE_RELATION(RELATION_FROM, RELATION_TO)
#FUNCTION
#DIM RELATION_FROM
#DIM RELATION_TO
SIF !RELATION:RELATION_FROM:RELATION_TO
    RETURNF 100
RETURNF RELATION:RELATION_FROM:RELATION_TO

;returns 0 if any character other than these are your lover
@CONCUBINAGE_ONLY_THESE_LOVERS(ARG:0,ARG:1=0,ARG:2=0,ARG:3=0,ARG:4=0,ARG:5=0,ARG:6=0,ARG:7=0,ARG:8=0,ARG:9=0)
#FUNCTION
FOR LOCAL, 1, CHARANUM
    SIF TALENT:LOCAL:恋人 && FINDELEMENT(ARG, LOCAL) == -1
        RETURNF 0
NEXT
RETURNF 1

@CONCUBINAGE_LOVERS_STRING(ARG:0,ARG:1=0,ARG:2=0,ARG:3=0,ARG:4=0,ARG:5=0,ARG:6=0,ARG:7=0,ARG:8=0,ARG:9=0)
#FUNCTIONS
#DIM LAST_INDEX
LAST_INDEX = FINDELEMENT(ARG, 0)
SIF LAST_INDEX == -1
    LAST_INDEX = 10
VARSET LOCALS
FOR LOCAL, 0, LAST_INDEX
    SIF TALENT:LOCAL:恋人
        LOCALS += @"%CALLNAME:LOCAL%、"
NEXT
RETURNF LIST_IN_STRING(LOCALS)

@CONCUBINAGE_YUKARI_CHECK
#FUNCTION
SIF ABL:MASTER:話術技能 < 5 || ABL:MASTER:教養 < 4 ;not well-spoken enough to convince her
    RETURNF 0

IF TALENT:妻 ;harsh, as she's already your wife, unless your other lovers are Ran and Chen, which is more acceptable
    SIF CONCUBINAGE_ONLY_THESE_LOVERS([[紫]], [[藍]], [[橙]])
        RETURNF ABL:親密 >= 20 && CFLAG:好感度 >= 10000 && CFLAG:信頼度 >= 3000
    RETURNF ABL:親密 >= 25 && CFLAG:好感度 >= 50000 && CFLAG:信頼度 >= 10000
ELSEIF TALENT:恋人 || TALENT:愛欲 ;easier since it appeals to her a little
    RETURNF CFLAG:好感度 >= 5000 && CFLAG:信頼度 >= 2000
ELSE ;normal check
    RETURNF ABL:親密 >= 20 && CFLAG:好感度 >= 10000 && CFLAG:信頼度 >= 3000
ENDIF

@CONCUBINAGE_TALK_YUKARI
CALL SET_KOJO_COLOR([[紫]])
SELECTCASE CONCUBINAGE_PROGRESS
    CASE 1
        IF CONCUBINAGE_SUB_PROGRESS == 0
            PRINTFORML 「今天你的表情可真严肃啊。在想什么呢？」
            PRINTFORMDW 你向紫倾诉了最近对婚姻的烦恼，以及感到有些束缚的心情。
            PRINTFORMDW 最后你问起了幻想乡对一夫多妻的态度，以及你是否有可能拥有多个伴侣。
            IF NO:LEGAL_SPOUSE == [[紫]]
                PRINTFORML 「当面对自己的妻子说这种话，你还真是厚颜无耻呢。」
                PRINTFORMW 「不过，事到如今妾身对你这副样子倒也不算意外了。」
            ELSEIF TALENT:恋人
                PRINTFORML 「哦？%CALLNAME:LEGAL_SPOUSE%还不够满足你吗？」
                CALL PRINT_DIALOGUE, @"妾身能理解你想多和如此美妙的妾身相处的心情，但你也该稍微体谅一下你的%PRINT_MALE("丈夫", LEGAL_SPOUSE)%才对哦？", "w"
            ELSE
                PRINTFORML 「哦？%CALLNAME:LEGAL_SPOUSE%还不够满足你吗？」
                PRINTFORMW 「你真是个贪心的%PRINT_MALE("男人", MASTER)%呢。」
            ENDIF

            PRINTFORMDW 紫沉默了片刻，思考着你的提议。
            IF CONCUBINAGE_YUKARI_CHECK()
                PRINTFORML 
                IF TALENT:妻
                    IF CONCUBINAGE_ONLY_THESE_LOVERS([[紫]], [[藍]], [[橙]])
                        PRINTFORML 「妾身确实有些受伤，居然妾身一个人还不够……不过，如果只是%CONCUBINAGE_LOVERS_STRING([[藍]], [[橙]])%的话，或许也没问题。」
                        PRINTFORMW 「好吧，妾身允许了。」
                    ELSE
                        PRINTFORML 「妾身大概会后悔吧，但你那令人难以置信的热情，也一直是妾身如此喜欢你的重要原因。」
                        PRINTFORMW 「妾身就允许你这小小的冒险吧。」
                    ENDIF
                    CONCUBINAGE_PROGRESS = 3 ;skip the wife stage
                ELSE
                    PRINTFORML 「这个想法倒是有趣，妾身就稍微帮你一把吧。」
                    PRINTFORMW 「不过，实现它还得靠你自己。」
                    CONCUBINAGE_PROGRESS = 2
                ENDIF
                GOTO YUKARI_OK
            ELSE
                PRINTFORML 「……抱歉，这不是妾身能够支持的事。」
                PRINTFORML 「虽然你的提议很有趣，但这可能会颠覆幻想乡脆弱的平衡，而妾身不认为你有能力掌控局面。」
                PRINTFORMW 「所以请把这个愚蠢的念头抛诸脑后，好好享受和你的%PRINT_MALE("丈夫", LEGAL_SPOUSE)%的幸福生活吧。」
                PRINTFORMDW 看来你的话还不足以说服紫。也许你应该在提升自己的技能和与她的关系后再来尝试。
                CONCUBINAGE_SUB_PROGRESS = 1
            ENDIF
        ELSE
            PRINTFORMDW 你再次向紫恳切地表达了你需要不止一个%PRINT_MALE("丈夫", LEGAL_SPOUSE)%的迫切心情。
            IF CONCUBINAGE_YUKARI_CHECK()
                IF TALENT:妻
                    PRINTFORML 「……好吧。」
                    IF CONCUBINAGE_ONLY_THESE_LOVERS([[紫]], [[藍]], [[橙]])
                        PRINTFORMW 「I want %CONCUBINAGE_LOVERS_STRING([[藍]], [[橙]])% to be happy too, after all.」
                    ELSE
                        PRINTFORMW 「I know there's no stopping you whenever you get this passionate.」
                    ENDIF
                    CONCUBINAGE_PROGRESS = 3 ;skip the wife stage
                ELSE
                    PRINTFORML 「You appear to be truly passionate about this.」
                    PRINTFORMW 「这一定会很有趣吧，妾身允许你继续追求。」
                    CONCUBINAGE_PROGRESS = 2
                ENDIF

                $YUKARI_OK
                CONCUBINAGE_SUB_PROGRESS = 0
                PRINTL
                CALL PRINT_DIALOGUE, @"要拥有多个合法%PRINT_MALE("丈夫", LEGAL_SPOUSE)%是不可能的，但或许可以安排某种侧室制度。"
                PRINTFORML 「她们不会是你的「%PRINT_MALE("丈夫_:妻子", LEGAL_SPOUSE)%」，但或多或少会被正式承认为你家的一员。」
                PRINTFORML 「当然，幻想乡没有这样的先例，你不能贸然建立你的小后宫。」
                PRINTFORMW 「你需要让幻想乡所有的主要势力都同意，正式确立侧室制度，并允许你纳妾。」
                IF TALENT:妻
                    PRINTFORML 「妾身已经同意了，接下来说明一下还需要说服哪些人。」
                    GOTO YUKARI_FACTIONS
                ELSE
                    PRINTFORML 「但在我们操之过急之前，有一个非常重要的人必须先同意才行。」
                    PRINTFORML 「你必须先说服你的%PRINT_MALE("丈夫", LEGAL_SPOUSE)%同意，然后才能和其他人谈。」
                    PRINTFORMW 「就算是妾身，也不至于去干涉别人的婚姻%COND_STR(@"，哪怕是为了%CALLNAME:LEGAL_SPOUSE%", CONCUBINAGE_RELATION([[紫]], LEGAL_SPOUSE) < 100)%。」
                ENDIF
            ELSE
                PRINTFORML 「妾身的回答还是不行。」
                PRINTFORMW 「有时候，你应该知足于现有的一切。」
            ENDIF
        ENDIF
    CASE 2
        IF CONCUBINAGE_SUB_PROGRESS == 0
            PRINTFORML 「你还没有说服你的%PRINT_MALE("丈夫", LEGAL_SPOUSE)%。」
            PRINTFORMW 「等那件事完成后再来吧。」
        ELSE
            PRINTFORML 「看来你成功说服了%CALLNAME:LEGAL_SPOUSE%同意你纳妾。」
            PRINTFORMW 「Then allow me to explain what else needs to be done.」
            $YUKARI_FACTIONS
            PRINTL
            PRINTFORMW 「There are many people likely to cause problems if they're not included, so you'll need to convince all of them in turn.」
            
            PRINTFORML 「首先，需要考虑人类村落。」
            PRINTFORML 「由于没有统一的领导者，你需要获得长老们的首肯，因为他们的话在村民中最有分量。」
            PRINTFORMW 「你应该可以通过阿礼之子来联系他们。」

            PRINTFORML 「接下来，你需要说服妾身的同道贤者，也就是那位山中的仙人，和那位隐秘之神。」
            PRINTFORML 「她们相当反复无常，妾身也帮不了你太多忙。」
            SIF GROUPMATCH(NO:LEGAL_SPOUSE, [[華扇]], [[隠岐奈]])
                PRINTFORML 「不过话说回来，你已经和其中一位打过交道了。另一位应该也不会给你太多麻烦。」
            WAIT
            
            PRINTFORML 「你还需要说服天狗。」
            CALL PRINT_DIALOGUE, "作为少数有组织的妖怪集团之一，她们在幻想乡拥有很大的影响力，而且总是喜欢多管闲事。"
            PRINTFORML 「算你运气好，只要能让她们得到好处，说服她们应该不难。」
            PRINTFORML 「不过要注意，她们非常在意礼节，如果你表现得不够恭敬，她们会视之为侮辱。」
            PRINTFORMW 「试着问问你的天狗朋友，看看有没有人能帮你联系到她们的首领。」
            
            PRINTFORML 「各个宗教团体在幻想乡也很有分量，所以你也需要和她们都谈谈。」
            IF NO:LEGAL_SPOUSE == [[霊夢]]
                PRINTFORML 「灵梦已经同意了是个好的开始，但你还是应该问问她是否准备好应对可能因此不满的妖怪。」
            ELSE
                PRINTFORML 「灵梦尤其重要，毕竟她肩负着维持平衡的职责。」
            ENDIF
            IF NO:LEGAL_SPOUSE == [[神奈子]]
                PRINTFORML 「虽然神奈子已经接受了，但你还需要确保那里的另一位神也同意。」
            ELSEIF NO:LEGAL_SPOUSE == [[諏訪子]]
                PRINTFORML 「既然住在山顶的神之一已经同意了，说服另一位应该也不会太难。」
            ELSE
                CALL PRINT_DIALOGUE, "住在山顶的神明可能相当强势苛刻，但她们并非不可接近，只要你在交涉时立场坚定，应该能谈出公平的条件。"
            ENDIF
            IF NO:LEGAL_SPOUSE == [[神子]]
                PRINTFORML 「既然神子已经同意了，道教方面应该不成问题。」
            ELSE
                PRINTFORML 「Though reclusive, the taoist wields significant influence in the village.」
                CALL PRINT_DIALOGUE, "除了对妖怪的厌恶之外，她其实还算通情达理，只要你说得有理有据，应该能让她同意。"
            ENDIF
            IF NO:LEGAL_SPOUSE == [[白蓮]]
                PRINTFORML 「既然那位僧侣已经同意了，她的团体应该不成问题。」
            ELSE
                PRINTFORML 「说服那位僧侣可能会有些困难。」
                PRINTFORML 「她很可能会提出一些要求来让自己过得更轻松，你只能忍耐直到她满意为止。」
            ENDIF
            PRINTFORML 「其他一些有实力的人可能也会主动来找你。」
            PRINTFORML 「你应该认真倾听她们的意见，毕竟在这件事上支持者越多越好。」
            PRINTFORML 「如果你能说服所有这些人让你建立自己的后宫，之后应该就不会有什么问题了。」
            PRINTFORMW 「祝你好运。你会需要的。」
            PRINTFORMDW 你感谢了\@ TALENT:[[紫]]:妻 ? 你的妻子 # 紫 \@的建议，开始思考先接触哪个势力比较好。

            SELECTCASE NO:LEGAL_SPOUSE
                CASE [[華扇]]
                    CONCUBINAGE_CONVINCED_KASEN = 2
                CASE [[隠岐奈]]
                    CONCUBINAGE_CONVINCED_OKINA = 2
                CASE [[神子]]
                    CONCUBINAGE_CONVINCED_MIKO = 2
                CASE [[白蓮]]
                    CONCUBINAGE_CONVINCED_BYAKUREN = 2
                CASE [[レミリア]]
                    CONCUBINAGE_CONVINCED_REMILIA = 2
                CASE [[マミゾウ]]
                    CONCUBINAGE_CONVINCED_MAMIZOU = 2
            ENDSELECT

            CONCUBINAGE_PROGRESS = 3
        ENDIF
    CASE 3
        ;working on factions
        {
        IF CONCUBINAGE_CONVINCED_VILLAGERS == 2 && CONCUBINAGE_CONVINCED_EIKI == 2 && CONCUBINAGE_CONVINCED_TENGU == 2 
            && CONCUBINAGE_CONVINCED_KANAKO == 2 && CONCUBINAGE_CONVINCED_BYAKUREN == 2 && CONCUBINAGE_CONVINCED_MIKO == 2
            && CONCUBINAGE_CONVINCED_OKINA == 2 && CONCUBINAGE_CONVINCED_KASEN == 2 && CONCUBINAGE_CONVINCED_REMILIA == 2
            && CONCUBINAGE_CONVINCED_MAMIZOU == 2 && CONCUBINAGE_CONVINCED_REIMU == 2 && CONCUBINAGE_CONVINCED_AKYUU == 2
        }
            PRINTFORML 「妾身由衷地佩服。没想到你竟然真的说服了所有人让你建立后宫。」
            PRINTFORML 「去吧，好好犒劳一下自己。」
            PRINTFORMDW %BREAKENG("这是一段漫长而艰辛的旅程，但现在你已经说服了所有主要势力接受侧室制度，你可以邀请他人成为你的侧室了。")%
            PRINTFORMW 「妾身很期待你接下来会做什么。」

            CONCUBINAGE_LEGALIZED = 1
        ELSEIF CONCUBINAGE_CONVINCED_EIKI == 1 || CONCUBINAGE_CONVINCED_REMILIA == 1 || CONCUBINAGE_CONVINCED_MAMIZOU == 1
            PRINTFORML 「看来有意料之外的人决定插手了呢。」
            PRINTFORMW 「你不能无视她。如果惹恼了她，她会成为相当大的麻烦。」
        ELSE
            PRINTFORMW 「你还没有说服所有人。等所有人都同意了再来吧。」
        ENDIF
ENDSELECT

@CONCUBINAGE_TALK_AKYUU
CALL SET_KOJO_COLOR([[阿求]])
PRINTFORMDW 你向阿求转述了紫的话，以及她让你去找村中长老商议在幻想乡推行侧室制度的事。
IF LEGAL_SPOUSE == TARGET
    PRINTFORML 「是的。我理解。紫大人建议这样做很慎重。」
    PRINTFORMDL 她短暂地停顿了一下，妻子的嘴角浮现一丝苦笑，继续说道。
    PRINTFORML 「说实话，我还是不太能接受。」
    CALL PRINT_DIALOGUE, @"我知道我不该自私，但当你向我求婚时，即使知道那只有短暂的时间，我也比想象中更加幸福。"
    PRINTFORMW 「但我知道那样对你不公平。你也应该得到幸福。」
    PRINTFORML 「好吧，我来召集长老们，替你和他们谈谈。」
    PRINTFORMW 「请在这里稍等。」
    TIME += 120
    PRINTFORMDW 两小时后……
    PRINTFORML 「我已经和长老们详细谈过了。」
    PRINTFORML 「他们对整件事并不太热心，但我还是说服了他们给个机会试试。」
    PRINTFORML 「不过，在他们接受之前，他们希望你先证明你愿意为村落的利益着想。」
    CALL PRINT_DIALOGUE, @"我们达成了共识，如果你能为村落做出重大贡献，就能在很大程度上避免村民对你产生嫉妒和怨恨。", "w"
    CALL PRINT_DIALOGUE, @"最近几年的收成不如预期，村落的粮食储备日益减少，人们越来越担心会彻底耗尽。"
    PRINTFORMW 「你有些园艺的技能，不是吗？如果你能恢复储备，长老们说他们会全力支持你。」
    PRINTFORML 「……不过，即便如此，我还是觉得这不是个好主意。」
    PRINTFORML 「我知道在我已经表示接受之后还提出这种要求很失礼，但请你去和映姬大人谈谈这件事。」
    PRINTFORML 「如果她愿意认可这件事，也能打消我所有的疑虑。」
    PRINTFORMW 「祝你好运，夫君。」
    CONCUBINAGE_CONVINCED_AKYUU = 2
    CONCUBINAGE_CONVINCED_VILLAGERS = 1
    CONCUBINAGE_VILLAGERS_FOOD_REMAINING = 1000
ELSE
    IF CFLAG:[[阿求]]:信頼度 > 400
        PRINTFORMW 「……」
        PRINTFORMDW 阿求静静地听你详细说明了情况。
        PRINTFORML 「……看来你已经下定决心了。」
        PRINTFORMW 「好吧，我会替你向村中长老进言。请在这里等到我们谈完。」
        TIME += 180
        PRINTFORMDW 三小时后……
        PRINTFORML 「我已经和村中长老详细讨论过了。」
        CALL PRINT_DIALOGUE, "对你的提案并没有强烈的支持，但有些人认为如果你能为村落做出重大贡献，村民们是可以被说服的。"
        PRINTFORML 「这几年收成不佳，村落的应急储备一直在缓慢但持续地减少。」
        PRINTFORMW 「如果你能补充储备，那将大大有助于树立你作为村落可信赖的宽厚之人的形象。」
        PRINTFORML 「不过，即便如此，我还是不禁担心允许此事的后果。」
        PRINTFORML 「没有我真正信赖之人的保证，我无法给予你个人的支持。」
        PRINTFORMW 「请去和映姬大人谈谈你的想法。如果她愿意支持，我也会支持。」
        CONCUBINAGE_CONVINCED_AKYUU = 2
        CONCUBINAGE_CONVINCED_VILLAGERS = 1
        CONCUBINAGE_VILLAGERS_FOOD_REMAINING = 1000
    ELSEIF CONCUBINAGE_CONVINCED_AKYUU == 1
        PRINTFORML 「正如我之前所说，我实在无法在这件事上信任你。」
        PRINTFORML 「请重新考虑吧。」
        PRINTFORMDW 阿求仍然不够信任你，甚至不愿考虑你的提案。
    ELSE
        PRINTFORMW 「……」
