@CONCUBINAGE_VILLAGERS_DELIVERY
#DIM DYNAMIC TOTAL_COUNT
#DIM STARTLINE
PRINTFORMDL 你想向村落的储备捐赠什么（还需{CONCUBINAGE_VILLAGERS_FOOD_REMAINING}份）？

FOR LOCAL, 0, 1000
	CALL ITEMDATA(LOCAL, "SHOP:八百屋")
    IF RESULT || GROUPMATCH(LOCAL, GETNUM(ITEM, "獣肉"), GETNUM(ITEM, "鳥肉"))
        SIF !ITEM:LOCAL
            SETCOLOR C_GRAY
            
        PRINTFORML [{LOCAL}] %ITEMNAME_TR(LOCAL)% (持有{ITEM:LOCAL}个)
        RESETCOLOR
    ENDIF
NEXT
PRINTL
PRINTFORMDL [-2] 全部捐赠
PRINTFORMDL [-1] 取消

STARTLINE = LINECOUNT
$CHOOSE
CLEARLINE LINECOUNT - STARTLINE
INPUT
LOCAL = RESULT

IF LOCAL == -2
    FOR LOCAL, 0, 1000
        CALL ITEMDATA(LOCAL, "SHOP:八百屋")
        IF RESULT || GROUPMATCH(LOCAL, GETNUM(ITEM, "獣肉"), GETNUM(ITEM, "鳥肉"))
            IF ITEM:LOCAL
                TOTAL_COUNT += ITEM:LOCAL
                CALL LOST_ITEM(ITEMNAME:LOCAL, ITEM:LOCAL, 1)
            ENDIF
        ENDIF
    NEXT
    IF !TOTAL_COUNT
        PRINTFORMDW 你没有任何可以捐赠的食物！
        TIME += 5
        RETURN
    ELSE
        CONCUBINAGE_VILLAGERS_FOOD_REMAINING -= TOTAL_COUNT
        PRINTFORMDW 向村民捐赠了{TOTAL_COUNT}份食物。
    ENDIF
ELSEIF LOCAL == -1
    TIME += 5
    RETURN
ELSEIF INRANGE(LOCAL, 0, 1000)
	CALL ITEMDATA(LOCAL, "SHOP:八百屋")
    IF RESULT || GROUPMATCH(LOCAL, GETNUM(ITEM, "獣肉"), GETNUM(ITEM, "鳥肉"))
        PRINTFORMDL 你想捐赠多少（最多{ITEM:LOCAL}份）？
        INPUT
        IF RESULT <= 0
            GOTO CHOOSE
        ELSE
            LOCAL:1 = MIN(RESULT, ITEM:LOCAL)
            CALL LOST_ITEM(ITEMNAME:LOCAL, LOCAL:1, 2)
            CONCUBINAGE_VILLAGERS_FOOD_REMAINING -= LOCAL:1
        ENDIF
    ELSE
        GOTO CHOOSE
    ENDIF
ELSE
    GOTO CHOOSE
ENDIF
IF CONCUBINAGE_VILLAGERS_FOOD_REMAINING <= 0
    CONCUBINAGE_VILLAGERS_FOOD_REMAINING = 0
    CONCUBINAGE_CONVINCED_VILLAGERS = 2
    PRINTFORMDL 看到仓库再次被食物塞得满满当当，村民露出了笑容。
    PRINTFORMDL \@ RAND:2 ? He # She \@ thanks you profusely for all your efforts and tells you that the village will be forever grateful.
    PRINTFORMDW 这下应该能搞定村中长老们了。
    RETURN
ELSEIF !TOTAL_COUNT
    RESTART
ENDIF

TIME += 5

