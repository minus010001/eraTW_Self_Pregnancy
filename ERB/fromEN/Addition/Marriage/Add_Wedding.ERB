@WEDDING_CEREMONY
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM LOCATION
TALENT:MASTER:機嫌 = 1
TALENT:LEGAL_SPOUSE:機嫌 = 1
LOCATION = GET_MAP_REPLACEMENT(WEDDING_LOCATION)

TIME:5 = 0
WIND_VELOCITY = 0
FORBIDDEN_CHANGE_WEATHER = 1
CALL qol_FORCESET_REGION_WEATHER_SYSTEM
CALL qol_FORCESET_REGION_RAINBOW_SYSTEM
CALL qol_FORCESET_REGION_WIND_VE_SYSTEM

CALL ENDUFUFU_ALL

FOR LOCAL, 1, CHARANUM
    IF WEDDING_GUESTS:LOCAL
        SIF CFLAG:LOCAL:睡眠
            CALL CHARA_AWAKE(LOCAL)
        CALL WEDDING_MOVE_TO_LOCATION(LOCAL, LOCATION)
    ENDIF
NEXT

CFLAG:MASTER:デート中 = GET_MAPID(LOCATION)
CALL WEDDING_MOVE_TO_LOCATION(MASTER, LOCATION)
CALL WEDDING_MOVE_TO_LOCATION(LEGAL_SPOUSE, LOCATION)

PRINTFORMDW 你急步赶往婚礼现场。
IF WEDDING_TYPE == ""
	;防御：WEDDING_TYPE为空时不应进入婚礼（如败者食尘后残留WEDDING_PLANNING_COMPLETE）
	VARSET WEDDING_TYPE
	VARSET WEDDING_SIZE
	VARSET WEDDING_CUSTOM_COST
	VARSET WEDDING_LOCATION
	VARSET WEDDING_VENUE_AGREED
	VARSET WEDDING_PLANNING_COMPLETE
	VARSET WEDDING_GUESTS, キャラクタ数上限
	WEDDING_OFFICIANT_ID = 0
    PRINTL ERROR, wedding type does not exist.
	RETURN
ELSEIF WEDDING_TYPE == "CUSTOM"
    CALL KOJO_MESSAGE_SEND("EVENT", 0, LEGAL_SPOUSE, 0, 0, "CUSTOM_WEDDING", "")
ELSE
    TRYCCALLFORM WEDDING_%WEDDING_TYPE%
    CATCH
        THROW ERROR, wedding type %WEDDING_TYPE% does not exist.
    ENDCATCH
ENDIF

TALENT:MASTER:妻 = 2
TALENT:LEGAL_SPOUSE:妻 = 2
TALENT:LEGAL_SPOUSE:人妻 = 1
MARRIAGE_STATE = 2
TFLAG:WeddingNight = 1
CALL QoL_Info_Write(LEGAL_SPOUSE, Qol_Dates_Marriage)
SIF RELATION:MASTER:LEGAL_SPOUSE < 150
    RELATION:MASTER:LEGAL_SPOUSE = 150
SIF RELATION:LEGAL_SPOUSE:MASTER < 150
    RELATION:LEGAL_SPOUSE:MASTER = 150

VARSET WEDDING_TYPE
VARSET WEDDING_SIZE
VARSET WEDDING_CUSTOM_COST
VARSET WEDDING_LOCATION
VARSET WEDDING_VENUE_AGREED
VARSET WEDDING_PLANNING_COMPLETE

LOCAL = ADD_BANQUET_INDEX(31)
IF LOCAL >= 0
    ADD_BANQUETS_START_TIME:LOCAL = TIME
    ADD_BANQUETS_START_DAY:LOCAL = DAY
    IF TIME > 1440
        ADD_BANQUETS_START_TIME:LOCAL = TIME % 1440
        ADD_BANQUETS_START_DAY:LOCAL ++
    ENDIF
    ;宴会参与者填充必须在VARSET WEDDING_GUESTS之前完成
    CALL ADD_BANQUET_SET_PARTICIPANTS31
    ;ADD_BANQUET_FILL_PARTICIPANTS的循环从LOCAL=1开始跳过MASTER(0)，需手动设置
    CFLAG:MASTER:BANQUET = 31
    CFLAG:MASTER:BANQUET_ROLE = 2
    CFLAG:MASTER:宴会参加 = 2
ENDIF

CALL ADD_BANQUET_PROGRESS()

;宴会参与者填充完成后才能清除WEDDING_GUESTS和WEDDING_OFFICIANT_ID
VARSET WEDDING_GUESTS, キャラクタ数上限
WEDDING_OFFICIANT_ID = 0

@WEDDING_MOVE_TO_LOCATION(CHARA, LOCATION)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC CHARA
#DIM DYNAMIC LOCATION

CFLAG:CHARA:現在位置 = LOCATION
CFLAG:CHARA:前ターン位置 = LOCATION
TCVAR:CHARA:今日会ったか = 1
CFLAG:CHARA:同室 = 1

@WEDDING_WESTERN
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC GUEST_COUNT
#DIMS DYNAMIC OFFICIANT
#DIM DYNAMIC OFFICIANT_ID
GUEST_COUNT = SUMARRAY(WEDDING_GUESTS)

IF LEGAL_SPOUSE == [[レミリア]]
    IF !CFLAG:[[咲夜]]:出禁
        OFFICIANT = 咲夜
        OFFICIANT_ID = [[咲夜]]
    ELSE
        OFFICIANT = 司仪
        OFFICIANT_ID = -1
    ENDIF
ELSE
    IF !CFLAG:[[レミリア]]:出禁
        OFFICIANT = 蕾米莉亚
        OFFICIANT_ID = [[レミリア]]
    ELSE
        OFFICIANT = 司仪
        OFFICIANT_ID = -1
    ENDIF
ENDIF

SIF OFFICIANT_ID > 0
    CFLAG:OFFICIANT_ID:現在位置 = GET_MAP_REPLACEMENT(WEDDING_LOCATION)
WEDDING_OFFICIANT_ID = OFFICIANT_ID

CALL OKIGAE(MASTER, [[婚礼套装]])
CALL OKIGAE(LEGAL_SPOUSE, [[婚紗套]])

PRINTFORMD 走进婚礼会场，你看到
SELECTCASE GUEST_COUNT
    CASE IS >= 100
        PRINTFORMD 一排又一排的座位上坐满了参加婚礼的宾客。
    CASE IS >= 50
        PRINTFORMD 许多排座位上坐满了你的宾客。
    CASE IS >= 15
        PRINTFORMD 宾客们坐在各自的座位上，迫不及待地等待婚礼开始。
    CASEELSE
        PRINTFORMD 零零散散几个人坐在座位上。
ENDSELECT
PRINTDW

PRINTFORMDL 仪式开始，你跟随%OFFICIANT%走过红毯。
PRINTFORMDL 婚礼的其他成员紧随其后。

RESULT = 0
CALL KOJO_MESSAGE_SEND("EVENT", 0, LEGAL_SPOUSE, 0, 0, "WEDDING", "AISLE_WALK")
IF !RESULT
    PRINTFORMDW 终于，%CALLNAME:LEGAL_SPOUSE%走过红毯，你看到%HE_SHE_CN(LEGAL_SPOUSE)%身着华美婚纱的模样，心跳不禁漏了一拍。
ENDIF

PRINTFORMDW %BREAKENG(@"%CALLNAME:LEGAL_SPOUSE%在你身旁站定，%OFFICIANT%开始致辞，讲述你来到幻想乡的经过、与%CALLNAME:LEGAL_SPOUSE%相遇的缘分，最终说到你们二人决定携手共度此生的誓约。")%

LOCALS '= @"『%NAME:MASTER%，你是否愿意娶%NAME:LEGAL_SPOUSE%为你的%PRINT_MALE("丈夫", LEGAL_SPOUSE)%？/你是否承诺爱%HE_SHE_CN(LEGAL_SPOUSE)%、尊重%HE_SHE_CN(LEGAL_SPOUSE)%、珍惜并守护%HE_SHE_CN(LEGAL_SPOUSE)%，舍弃一切他人，只对%HE_SHE_CN(LEGAL_SPOUSE)%忠贞不渝？』"
IF OFFICIANT_ID > 0
    CALL SPTALK, OFFICIANT_ID, "通常", 0, LOCALS, 1
ELSE
    CALL SPTALK, 0, "通常", 0, LOCALS, 1
ENDIF
WAIT
PRINTDL [0] 我愿意。
INPUT

;SIF LOVER_COUNT() > 1
;    DEBUGPRINTFORML Lol. Lmao, even.

LOCALS '= @"『那么，%NAME:LEGAL_SPOUSE%，你是否愿意嫁给%NAME:MASTER%为你的%PRINT_MALE("丈夫", MASTER)%？/你是否承诺爱%HE_SHE_CN(MASTER)%、尊重%HE_SHE_CN(MASTER)%、珍惜并守护%HE_SHE_CN(MASTER)%，舍弃一切他人，只对%HE_SHE_CN(MASTER)%忠贞不渝？』"
IF OFFICIANT_ID > 0
    CALL SPTALK, OFFICIANT_ID, "通常", 0, LOCALS, 1
ELSE
    CALL SPTALK, 0, "通常", 0, LOCALS, 1
ENDIF
WAIT

RESULT = 0
CALL KOJO_MESSAGE_SEND("EVENT", 0, LEGAL_SPOUSE, 0, 0, "WEDDING", "I_DO")
IF !RESULT
    CALL SPTALK, LEGAL_SPOUSE, "笑顔", 0, "「我愿意。」", 1, "", "照れ,泪"
ENDIF
WAIT

PRINTFORMDW 你将婚戒戴在%CALLNAME:LEGAL_SPOUSE%的手指上，%HE_SHE_CN(LEGAL_SPOUSE)%也同样为你戴上。

LOCALS '= @"『现在，我宣布你们结为%PRINT_MALE("丈夫", MASTER)%与%PRINT_MALE("丈夫", LEGAL_SPOUSE)%。/现在可以亲吻%PRINT_MALE("新郎_:新娘", LEGAL_SPOUSE)%了。』"
IF OFFICIANT_ID > 0
    CALL SPTALK, OFFICIANT_ID, "通常", 0, LOCALS, 1
ELSE
    CALL SPTALK, 0, "通常", 0, LOCALS, 1
ENDIF
WAIT

RESULT = 0
CALL KOJO_MESSAGE_SEND("EVENT", 0, LEGAL_SPOUSE, 0, 0, "WEDDING", "KISS")
IF !RESULT
    PRINTFORMDL 你在宾客的欢呼声中与你的%PRINT_MALE("丈夫", LEGAL_SPOUSE)%深情拥吻，婚姻的幸福感将你包围。
    SIF TALENT:MASTER:キス未経験
        PRINTFORMDL 你毫不后悔等待了这么久。
ENDIF
WAIT

CALL SET_FIRSTKISS_CUSTOM(MASTER, @"%HE_SHE_CN(MASTER)%在婚礼当天欣然将初吻献给了%CALLNAME:LEGAL_SPOUSE%。")
CALL SET_FIRSTKISS_CUSTOM(LEGAL_SPOUSE, @"%HE_SHE_CN(LEGAL_SPOUSE)%在婚礼当天欣然将初吻献给了%CALLNAME:MASTER%。")

PRINTFORMDL %BREAKENG(@"当你和%CALLNAME:LEGAL_SPOUSE%终于分开，你转身望向人群。有人喜极而泣，有人面露失落，但你能感受到这对所有人来说都是难忘的时刻。")%
PRINTFORMDW 你与你的新婚%PRINT_MALE("丈夫", LEGAL_SPOUSE)%%CALLNAME:LEGAL_SPOUSE%率先离场，其他人紧随其后。你期待着未来的婚姻生活，相信一定会充满幸福。

TIME += 180

@WEDDING_FAIRY
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC GUEST_COUNT
#DIMS DYNAMIC OFFICIANT
#DIM DYNAMIC OFFICIANT_ID
GUEST_COUNT = SUMARRAY(WEDDING_GUESTS)

IF !CFLAG:[[幽香]]:出禁 && LEGAL_SPOUSE != [[幽香]]
    OFFICIANT = 幽香
    OFFICIANT_ID = [[幽香]]
ELSEIF !CFLAG:[[ラルバ]]:出禁 && LEGAL_SPOUSE != [[ラルバ]]
    OFFICIANT = 拉尔瓦
    OFFICIANT_ID = [[ラルバ]]
ELSE
    OFFICIANT = 司仪
    OFFICIANT_ID = -1
ENDIF

SIF OFFICIANT_ID > 0
    CFLAG:OFFICIANT_ID:現在位置 = GET_MAP_REPLACEMENT(WEDDING_LOCATION)
WEDDING_OFFICIANT_ID = OFFICIANT_ID

PRINTFORMDL 你走进太阳花田，眼前的景象美不胜收。
SIF DAY:2 == 4
    PRINTFORMDL 虽然已是深秋，向日葵依然挺拔饱满，让花园宛如盛夏。
PRINTFORMDL 无数妖精在花丛间飞舞嬉戏，整片花田洋溢着勃勃生机。
PRINTFORMDL 在妖精们载歌载舞的花丛间，你看到宾客们已经到齐了。

SELECTCASE GUEST_COUNT
    CASE IS >= 100
        PRINTFORMDW 宾客们挤得满满当当，即使在这广阔的花田中也显得拥挤。
    CASE IS >= 50
        PRINTFORMDW 人多到有些人都在努力寻找好的观赏位置。
    CASEELSE
        PRINTFORMDW 所有人都迫不及待地想要开始。
ENDSELECT

PRINTFORMDL 你和%CALLNAME:LEGAL_SPOUSE%手牵着手，一起走向花田中央。
PRINTFORMDL 你们前行时，各色妖精从四面八方簇拥而来，手持鲜花、翩翩起舞、奏响乐曲，为新婚夫妇庆祝。

RESULT = 0
CALL KOJO_MESSAGE_SEND("EVENT", 0, LEGAL_SPOUSE, 0, 0, "WEDDING", "AISLE_WALK")

PRINTFORMDL 你和%CALLNAME:LEGAL_SPOUSE%站定，%OFFICIANT%开始致辞。

LOCALS = 『欢迎各位。今天我们齐聚于此，庆祝%CALLNAME:MASTER%与%CALLNAME:LEGAL_SPOUSE%的婚礼，见证他们迈入人生的新阶段。/我知道未来一定会有许多艰难险阻，但只要他们彼此相爱，/就一定能够克服一切挑战。/让我们共同守护他们，接纳他们成为%PRINT_MALE("丈夫", MASTER)%与%PRINT_MALE("丈夫", LEGAL_SPOUSE)%。』
IF OFFICIANT_ID > 0
    CALL SPTALK, OFFICIANT_ID, "通常", 0, LOCALS, 1
ELSE
    CALL SPTALK, 0, "通常", 0, LOCALS, 1
ENDIF
WAIT

LOCALS = 『%CALLNAME:MASTER%，你是否愿意接受%CALLNAME:LEGAL_SPOUSE%为你的%PRINT_MALE("丈夫", LEGAL_SPOUSE)%，并承诺一生守护%HE_SHE_CN(LEGAL_SPOUSE)%、让%HE_SHE_CN(LEGAL_SPOUSE)%幸福？』
IF OFFICIANT_ID > 0
    CALL SPTALK, OFFICIANT_ID, "通常", 0, LOCALS, 1
ELSE
    CALL SPTALK, 0, "通常", 0, LOCALS, 1
ENDIF
WAIT

PRINTDL [0] 当然。
INPUT

LOCALS '= @"『%CALLNAME:LEGAL_SPOUSE%，你是否愿意接受%CALLNAME:MASTER%为你的%PRINT_MALE("丈夫", MASTER)%，并承诺永远珍惜%HE_SHE_CN(MASTER)%？』"
IF OFFICIANT_ID > 0
    CALL SPTALK, OFFICIANT_ID, "通常", 0, LOCALS, 1
ELSE
    CALL SPTALK, 0, "通常", 0, LOCALS, 1
ENDIF
WAIT

RESULT = 0
CALL KOJO_MESSAGE_SEND("EVENT", 0, LEGAL_SPOUSE, 0, 0, "WEDDING", "I_DO")
IF !RESULT
    CALL SPTALK, LEGAL_SPOUSE, "笑顔", 0, "「嗯，我会的！」", 1
ENDIF
WAIT

PRINTFORMDW 当你将戒指戴在%HE_SHE_CN(LEGAL_SPOUSE)%手指上，%CALLNAME:LEGAL_SPOUSE%几乎按捺不住心中的兴奋。

LOCALS '= @"『那么，在自然的祝福下，我宣布你们结为%PRINT_MALE("丈夫", MASTER)%与%PRINT_MALE("丈夫", LEGAL_SPOUSE)%。/来吧，%CALLNAME:MASTER%。亲吻%HE_SHE_CN(LEGAL_SPOUSE)%。』"
IF OFFICIANT_ID > 0
    CALL SPTALK, OFFICIANT_ID, "通常", 0, LOCALS, 1
ELSE
    CALL SPTALK, 0, "通常", 0, LOCALS, 1
ENDIF
WAIT

RESULT = 0
CALL KOJO_MESSAGE_SEND("EVENT", 0, LEGAL_SPOUSE, 0, 0, "WEDDING", "KISS")
IF !RESULT
    PRINTFORMDL 在花田中央，你亲吻了你的新%PRINT_MALE("丈夫", LEGAL_SPOUSE)%。
    PRINTFORMDL 你们沉浸在热烈的拥吻中，心中只有彼此，而周围的向日葵全都转过头来直直地注视着你们。
ENDIF
WAIT

CALL SET_FIRSTKISS_CUSTOM(MASTER, @"%HE_SHE_CN(MASTER)%在花丛中的婚礼上欣然将初吻献给了%CALLNAME:LEGAL_SPOUSE%。")
CALL SET_FIRSTKISS_CUSTOM(LEGAL_SPOUSE, @"%HE_SHE_CN(LEGAL_SPOUSE)%在花丛中的婚礼上欣然将初吻献给了%CALLNAME:MASTER%。")

PRINTFORMDL 你们终于松开彼此，喘着气，在宾客们的阵阵欢呼声中。
PRINTFORMDL 周围的妖精们彻底疯狂起来，奏乐的奏乐，跳舞的跳舞，尽情狂欢。
PRINTFORMDW %BREAKENG("妖精们的热情感染了在场的宾客，你和%CALLNAME:LEGAL_SPOUSE%也加入其中翩翩起舞，在大自然慈爱的温暖怀抱中沉醉于幸福。")%

TIME += 240

@WEDDING_JAPANESE
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC GUEST_COUNT
#DIMS DYNAMIC OFFICIANT
#DIM DYNAMIC OFFICIANT_ID
GUEST_COUNT = SUMARRAY(WEDDING_GUESTS)

;--- 主持人选择逻辑 ---
;灵梦是新娘时：先代→早苗→可跳过主持
;灵梦不是新娘时：灵梦→先代→早苗→无法触发（三人全禁）
IF LEGAL_SPOUSE == [[霊夢]]
	IF !CFLAG:[[先代]]:出禁
		OFFICIANT = 先代
		OFFICIANT_ID = [[先代]]
	ELSEIF !CFLAG:[[早苗]]:出禁
		OFFICIANT = 早苗
		OFFICIANT_ID = [[早苗]]
	ELSE
		OFFICIANT =
		OFFICIANT_ID = -1
	ENDIF
ELSE
	IF !CFLAG:[[霊夢]]:出禁
		OFFICIANT = 灵梦
		OFFICIANT_ID = [[霊夢]]
	ELSEIF !CFLAG:[[先代]]:出禁
		OFFICIANT = 先代
		OFFICIANT_ID = [[先代]]
	ELSEIF !CFLAG:[[早苗]]:出禁
		OFFICIANT = 早苗
		OFFICIANT_ID = [[早苗]]
	ELSE
		;三人全禁则无法触发神道式婚礼
		THROW ERROR, No available officiant for Shinto wedding.
	ENDIF
ENDIF

SIF OFFICIANT_ID > 0
	CFLAG:OFFICIANT_ID:現在位置 = GET_MAP_REPLACEMENT(WEDDING_LOCATION)
WEDDING_OFFICIANT_ID = OFFICIANT_ID

;--- 换装 ---
CALL OKIGAE(MASTER, 5)
CALL OKIGAE(LEGAL_SPOUSE, [[白无垢]])

;--- 参入 + 修祓 + 致辞（AISLE_WALK锚点）---
PRINTFORMDL 你和%CALLNAME:LEGAL_SPOUSE%穿过鸟居，步入博丽神社的境内。
PRINTFORMDL 神社的庭院中，宾客们已经到齐，静静等待着仪式开始。

SELECTCASE GUEST_COUNT
	CASE IS >= 100
		PRINTFORMDW 宾客们从境内一直排到参道，人数之多让神社显得格外热闹。
	CASE IS >= 50
		PRINTFORMDW 许多宾客坐在境内两侧，期待地注视着你们。
	CASE IS >= 15
		PRINTFORMDW 宾客们安静地坐在两侧，等待着仪式开始。
	CASEELSE
		PRINTFORMDW 几位宾客安静地等待着。
ENDSELECT

PRINTFORMDL 你们在巫女的引导下走向本殿前的拜殿。
IF OFFICIANT_ID > 0
	PRINTFORMDL %OFFICIANT%身着正装，手持祓串，为你们进行修祓之仪。
	PRINTFORMDL 清净的祝词声在神社中回荡，驱散一切不净。
ELSE
	PRINTFORMDL 巫女为你们进行修祓之仪，清净的祝词声在神社中回荡。
ENDIF

RESULT = 0
CALL KOJO_MESSAGE_SEND("EVENT", 0, LEGAL_SPOUSE, 0, 0, "WEDDING", "AISLE_WALK")
IF !RESULT
	PRINTFORMDW %CALLNAME:LEGAL_SPOUSE%身着白无垢，在神前的光芒中显得格外圣洁美丽，你不禁屏住了呼吸。
ENDIF

IF OFFICIANT_ID > 0
	LOCALS = 『今日，%CALLNAME:MASTER%与%CALLNAME:LEGAL_SPOUSE%在神前缔结良缘。/愿神明庇佑此二人，赐予永恒的祝福。/此婚约，天地共鉴。』
	CALL SPTALK, OFFICIANT_ID, "通常", 0, LOCALS, 1
ELSE
	LOCALS = 『今日，%CALLNAME:MASTER%与%CALLNAME:LEGAL_SPOUSE%在神前缔结良缘。/愿神明庇佑此二人，赐予永恒的祝福。/此婚约，天地共鉴。』
	CALL SPTALK, 0, "通常", 0, LOCALS, 1
ENDIF
WAIT

;--- 誓词（I_DO锚点）---
PRINTFORMDL 接下来是誓词。请面向神前，宣读你们的誓言。
PRINTFORMDL 『我，%CALLNAME:MASTER%，在此立誓：\n与%CALLNAME:LEGAL_SPOUSE%结为夫妻，\n无论顺境逆境，皆将守护相伴，\n此心此誓，至死不渝。』
PRINTDL [0] 我在此立誓。
INPUT

RESULT = 0
CALL KOJO_MESSAGE_SEND("EVENT", 0, LEGAL_SPOUSE, 0, 0, "WEDDING", "I_DO")
IF !RESULT
	LOCALS = 『我，%CALLNAME:LEGAL_SPOUSE%，在此立誓：/与%CALLNAME:MASTER%结为夫妻，/无论顺境逆境，皆将守护相伴，/此心此誓，至死不渝。』
	PRINTFORMDL %CALLNAME:LEGAL_SPOUSE%的声音清亮而坚定：
	CALL SPTALK, LEGAL_SPOUSE, "笑顔", 0, LOCALS, 1, "", "照れ,泪"
ENDIF
WAIT

;--- 三献仪（KISS锚点）---
PRINTFORMDL 三献仪开始。新郎新娘交替饮下三杯神酒，每杯三口，共九口——此为三三九度之仪。
PRINTFORMDL 第一杯——小杯，%CALLNAME:LEGAL_SPOUSE%先饮，你随后。
PRINTFORMDL 第二杯——中杯，你先饮，%CALLNAME:LEGAL_SPOUSE%随后。
PRINTFORMDL 第三杯——大杯，%CALLNAME:LEGAL_SPOUSE%先饮，你随后。
PRINTFORMDW 三三九度之仪完成，你们的姻缘已在神前缔结。

PRINTDL [0] 亲吻。
INPUT

RESULT = 0
CALL KOJO_MESSAGE_SEND("EVENT", 0, LEGAL_SPOUSE, 0, 0, "WEDDING", "KISS")
IF !RESULT
	PRINTFORMDL 在神前，你轻轻拥住%CALLNAME:LEGAL_SPOUSE%，在宾客的注视下亲吻了%HE_SHE_CN(LEGAL_SPOUSE)%的唇。
	PRINTFORMDL %CALLNAME:LEGAL_SPOUSE%白无垢的衣袂在微风中轻轻飘动，宛如一幅画。
ENDIF
