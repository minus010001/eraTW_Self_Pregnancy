; ADD_EXTENDED_TRAITS.ERB
; pedy-tw custom code ported to eratw-chs
; Automatically assigns extended talents to characters on load.

@EVENTLOAD
#LATER
CALL ADD_EXTENDED_TRAITS_SET_ALL

@ADD_EXTENDED_TRAITS_SET_ALL
#LOCALSIZE 1
#LOCALSSIZE 1
FOR LOCAL, 1, CHARANUM
    TRYCALLFORM ADD_EXTENDED_TRAITS_SET_{NO:LOCAL}(LOCAL)
NEXT

;-------------------------------------------------
; Generic extended talent setters
; Each tracks which slots have been filled via CFLAG:EXTENDED_TRAITS_SET bits
; to prevent reapplication on subsequent EVENTLOADs.
;-------------------------------------------------

@ADD_EXTENDED_TRAIT_力持ち(ARG, ARG:1)
#LOCALSIZE 1
#LOCALSSIZE 1
SIF GETBIT(CFLAG:ARG:EXTENDED_TRAITS_SET, 0)
    RETURN

TALENT:ARG:力持ち = ARG:1
SETBIT CFLAG:ARG:EXTENDED_TRAITS_SET, 0

@ADD_EXTENDED_TRAIT_体型(ARG, ARG:1)
#LOCALSIZE 1
#LOCALSSIZE 1
SIF GETBIT(CFLAG:ARG:EXTENDED_TRAITS_SET, 1)
    RETURN

SIF TALENT:ARG:体型 == CSVTALENT(NO:ARG, GETNUM(TALENT, "体型")) 
    TALENT:ARG:体型 = ARG:1
SETBIT CFLAG:ARG:EXTENDED_TRAITS_SET, 1

@ADD_EXTENDED_TRAIT_バストサイズ(ARG, ARG:1)
#LOCALSIZE 1
#LOCALSSIZE 1
SIF GETBIT(CFLAG:ARG:EXTENDED_TRAITS_SET, 2)
    RETURN

SIF TALENT:ARG:バストサイズ == CSVTALENT(NO:ARG, GETNUM(TALENT, "バストサイズ")) 
    TALENT:ARG:バストサイズ = ARG:1
SETBIT CFLAG:ARG:EXTENDED_TRAITS_SET, 2

@ADD_EXTENDED_TRAIT_初潮(ARG, ARG:1)
#LOCALSIZE 1
#LOCALSSIZE 1
SIF GETBIT(CFLAG:ARG:EXTENDED_TRAITS_SET, 3)
    RETURN

SIF TALENT:ARG:初潮 == CSVTALENT(NO:ARG, GETNUM(TALENT, "初潮")) 
    TALENT:ARG:初潮 = ARG:1
SETBIT CFLAG:ARG:EXTENDED_TRAITS_SET, 3

@ADD_EXTENDED_TRAIT_汚臭耐性(ARG, ARG:1)
#LOCALSIZE 1
#LOCALSSIZE 1
SIF GETBIT(CFLAG:ARG:EXTENDED_TRAITS_SET, 4)
    RETURN

SIF TALENT:ARG:汚臭耐性 == CSVTALENT(NO:ARG, GETNUM(TALENT, "汚臭耐性")) 
    TALENT:ARG:汚臭耐性 = ARG:1
SETBIT CFLAG:ARG:EXTENDED_TRAITS_SET, 4

@ADD_EXTENDED_TRAIT_噂話者(ARG, ARG:1)
#LOCALSIZE 1
#LOCALSSIZE 1
SIF GETBIT(CFLAG:ARG:EXTENDED_TRAITS_SET, 5)
    RETURN

TALENT:ARG:噂話者 = ARG:1
SETBIT CFLAG:ARG:EXTENDED_TRAITS_SET, 5

@ADD_EXTENDED_TRAIT_酒造家(ARG, ARG:1)
#LOCALSIZE 1
#LOCALSSIZE 1
SIF GETBIT(CFLAG:ARG:EXTENDED_TRAITS_SET, 6)
    RETURN

TALENT:ARG:酒造家 = ARG:1
SETBIT CFLAG:ARG:EXTENDED_TRAITS_SET, 6

; In pedy-tw 吸血鬼 is a standalone talent; in chs it is value 3 of 妖怪.
@ADD_EXTENDED_TRAIT_吸血鬼(ARG, ARG:1)
#LOCALSIZE 1
#LOCALSSIZE 1
SIF GETBIT(CFLAG:ARG:EXTENDED_TRAITS_SET, 7)
    RETURN

SIF ARG:1
    TALENT:ARG:妖怪 = 3
SETBIT CFLAG:ARG:EXTENDED_TRAITS_SET, 7

