@祈愿游戏
IF FIRSTTIME("祈愿游戏",,MASTER)
	PRINTFORMW 在心中这样想了想后，令你意外的是，你似乎真的听到了来自神明的声音——
	SETCOLOR C_YELLOW
	PRINTFORMW …
	PRINTFORMW ……
	PRINTFORMW ………
	PRINTFORMW 不想努力？
	PRINTFORMW 这里可没有不劳而获的事情。
	PRINTFORMW 想要我的赐福，就要献上祭品
	RESETCOLOR
	PRINTL
	PRINTFORMW 祭品？什么祭品？金钱还是筹码？你心中这样想着。
	SETCOLOR C_YELLOW
	PRINTFORMW 所谓祭品，自然是世间最为神圣的东西——胖次
	RESETCOLOR
	PRINTL
	IF !FLAG:獲得胖次種数
		PRINTFORMW 歪？妖妖灵吗？这里有一个变态邪教——
		PRINTFORMW 原本你是想这样大声斥责的，但当你看到赐福的内容后，你把这些抛到了脑后
		PRINTFORMW ——祂给的实在是太多了
	ELSE
		PRINTFORMW 嘶…有品！竟然有和我一样喜欢少女胖次的人——啊不，神
		PRINTFORMW 你这样想着。
	ENDIF
	PRINTL
ELSE
	SETCOLOR C_YELLOW
	PRINTFORMW 又是你啊，还是老规矩。
ENDIF
SETCOLOR C_YELLOW
PRINTFORMW 献上祭品，和我进行一场游戏，知识，健康，金钱，筹码，这些赐福你可以挑一样带走
RESETCOLOR
PRINTL
PRINTFORMW 要献上祭品，和神玩一场游戏吗？
CALL ASK_M("是",FLAG:獲得胖次種数 > 0 || !CFLAG:MASTER:没穿内裤,"否",1)
IF RESULT == 0
	IF FLAG:獲得胖次種数 > 0 
		FLAG:獲得胖次種数 --
		PRINTFORMW 很巧的是，你手中恰好有来自女孩子们的胖次，你将其作为祭品放在了祭坛上
		PRINTFORMW 将秘藏的收集品叠起来刚一祈祷，一道非人间所能有的火焰就冒了出来将胖次烧的一点都不剩！
		PRINTL
		SETCOLOR C_YELLOW
		PRINTFORMW 如此，汝之愿望终将实现……
		RESETCOLOR
	ELSE
		CFLAG:MASTER:没穿内裤 = 2
		EQUIP:MASTER:下半身内衣２ = 0
		PRINTFORMW 虽然对奖励很眼馋，但是胖次这种东西怎么可能轻易到手——
		PRINTFORMW 这样想着的时候，一道非人间所能有的火焰冒了出来，将你穿着的内裤烧得一干二净
		PRINTFORMW ？？？
		IF IS_MALE(MASTER)
			PRINTFORMW 哇趣，真变态啊！男人的胖次也要啊！
		ELSE
			PRINTFORMW 非礼啊！光天化日之下强抢少女内裤啊啊！！
		ENDIF
		PRINTFORMW 感受着凉飕飕的下半身，时间仿佛暂停了下来，四周的景色突然变换，你置身在了一个游戏厅一样的场景中。
	ENDIF
	CALL 祈愿游戏开始
	RETURN
ELSE
	PRINTFORMW 深思熟虑后，你决定放弃。
ENDIF
@祈愿游戏开始
PRINTFORML 要玩哪个游戏？
PRINTFORML [1] 恶魔轮盘
PRINTFORML [2] 不公平投掷
INPUT
SELECTCASE RESULT
	CASE 1
		CALL 恶魔轮盘入口
	CASE 2
		CALL 抛硬币入口
	CASEELSE
		RETURN
ENDSELECT

@获得奖励(ARG)
#DIM DYNAMIC 奖励选择
#DIM DYNAMIC 选择次数
PRINTFORMW 恍惚之间，你回到了现实
SELECTCASE ARG
	;常规胜利
	CASE 1
		SETCOLOR C_YELLOW
		PRINTFORMW 看来你通过了我给你的考验，说出你的愿望吧，我会为你实现
		RESETCOLOR
		CALL RELINE(,1)
		$INPUT_LOOP1
		CALL RELINE()
		PRINTFORML 祈愿什么赐福呢？
		PRINTFORML [1] 金钱
		PRINTFORML [2] 健康
		PRINTFORML [3] 筹码
		PRINTFORML [4] 色色！！！
		SIF TFLAG:幸運補正 < 最大幸运补正()
			PRINTFORML [5] 好运
		PRINTFORML [6] 胖次
		SIF !TALENT:MASTER:禁断的知識
			PRINTFORML [7] 知识
		INPUT
		奖励选择 = RESULT
		CALL 愿望实现(奖励选择)
		SIF !RESULT
			GOTO INPUT_LOOP1
	;常规失败
	CASE 2
		SETCOLOR C_YELLOW
		PRINTFORMW 没有获胜吗？
		PRINTFORMW 没关系，我仍然会予你赐福，只是这次你没有选择权，只能听从命运的安排
		RESETCOLOR
		CALL 愿望实现(RAND:6 + 1)
	;戏剧性结局
	CASE 3
		SETCOLOR C_YELLOW
		PRINTFORMW 不得不说，这可真是一场好戏
		PRINTFORMW 说出汝的愿望吧，我允许你额外选择一项奖励
		RESETCOLOR
		CALL RELINE(,1)
		$INPUT_LOOP2
		CALL RELINE()
		IF !选择次数
			PRINTFORMW 选择第一项奖励吧
		ELSE
			PRINTFORMW 选择第二项奖励吧
		ENDIF
		PRINTFORML 祈愿什么赐福呢？
		PRINTFORML [1] 金钱
		PRINTFORML [2] 健康
		PRINTFORML [3] 筹码
		PRINTFORML [4] 色色！！！
		SIF TFLAG:幸運補正 < 最大幸运补正()
			PRINTFORML [5] 好运
		PRINTFORML [6] 胖次
		SIF !TALENT:MASTER:禁断的知識
			PRINTFORML [7] 知识
		INPUT
		奖励选择 = RESULT
		CALL 愿望实现(奖励选择)
		SIF !RESULT
			GOTO INPUT_LOOP2
		IF !选择次数
			选择次数 ++
			GOTO INPUT_LOOP2
		ENDIF
ENDSELECT
RETURN

@愿望实现(ARG)
#DIM DYNAMIC VALUE
SELECTCASE ARG
	CASE 1
		PRINTFORML 你突然感到钱包一重
		VALUE = 60000
		SIF TALENT:MASTER:黄金律 && MAGIC_DLC_魔法成就
			VALUE = 78000
		PRINTFORML 钱包中多了%金额表示(VALUE)%
		MONEY += VALUE
		PRINTW
		RETURN 1
	CASE 2
		PRINTFORML 你感到全身一阵轻松
		CALL CHANGE_MAXBASE(MASTER, BASE_気力, SQRT(MAXBASE:MASTER:体力)/2,2)
		CALL CHANGE_MAXBASE(MASTER, BASE_体力, SQRT(MAXBASE:MASTER:気力)/2,2)
		CALL CHANGE_MAXBASE(MASTER, BASE_TSP, SQRT(MAXBASE:MASTER:TSP)/2,2)
		CALL CHANGE_MAXBASE(MASTER, BASE_酒气, SQRT(MAXBASE:MASTER:酒気)/2,2)
		CALL CHANGE_MAXBASE(MASTER, BASE_法力, SQRT(MAXBASE:MASTER:法力)/2,2)
		CALL CHANGE_MAXBASE(MASTER, BASE_精力, SQRT(MAXBASE:MASTER:精力)/2,2)
		CALL RECOVER(MASTER, 1000, "体力")
		CALL RECOVER(MASTER, 1000, "気力")
		CALL RECOVER(MASTER, 1000, "TSP")
		CALL RECOVER(MASTER, 1000, "法力")
		CALL RECOVER(MASTER, 1000, "精力")
		PRINTW
		RETURN 1
	CASE 3
		PRINTFORML 你突然感到钱包一重
		VALUE = 250
		PRINTFORMW 钱包中多了{VALUE}个筹码
		MONEY:2 += VALUE
		RETURN 1
	CASE 4
		CALL PINK_WIND
		PRINTW
		RETURN 1
	CASE 5
		IF TFLAG:幸運補正 < 最大幸运补正()
			PRINTFORML 你没有感觉到任何变化，但冥冥之中你的运气似乎变好了
			CFLAG:MASTER:今日の運勢 = 999
			TFLAG:幸運補正 = LIMIT(TFLAG:幸運補正+1, 5, 最大幸运补正())
			PRINTW
			RETURN 1
		ELSE
			RETURN 0
		ENDIF
	CASE 6
		FLAG:獲得胖次種数 += 10
		PRINTFORML 手中突然出现了好几条胖次！！！
		PRINTFORML 你慌忙把这些不知主人是谁的胖次藏了起来……
		PRINTW
		RETURN 1
	CASE 7
		IF TALENT:MASTER:禁断的知識
			RETURN 0
		ELSE
			PRINTFORML 胖次之神赐予了你禁断的知识！
			TALENT:MASTER:禁断的知識 = 1
			PRINTW
			RETURN 1
		ENDIF
	CASEELSE
		RETURN 0
ENDSELECT