RETURNF 0

; ---------- 胜负判定 ----------
@恶魔轮盘胜负判定
IF 局_玩家HP <= 0
	局_胜负 = -1
	SETCOLOR 0xC03030
	PRINTFORML
	PRINTFORML 　 你倒在血泊中...
	PRINTFORML 　 游戏失败
	RESETCOLOR
	PRINTW
	RETURN
ENDIF
IF 局_庄家HP <= 0
	局_胜负 = 1
	SETCOLOR 0xC0C030
	PRINTFORML
	PRINTFORML 　 Dealer 倒在桌下
	PRINTFORML 　 你赢了这一阶段
	RESETCOLOR
	PRINTW
	RETURN
ENDIF
RETURN
