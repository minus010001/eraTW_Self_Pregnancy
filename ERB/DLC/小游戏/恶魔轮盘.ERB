; ---------- 添加道具 ----------
; 找到第一个空槽 (值 < 0), 放入一个随机道具
; 槽位满则跳过
@恶魔轮盘添加道具(方)
#DIM DYNAMIC 方
#DIM DYNAMIC 序号
#DIM DYNAMIC 道具ID
#DIM DYNAMIC 找到空槽
#DIM DYNAMIC 已找到
找到空槽 = -1
已找到 = 0
序号 = 0
WHILE 序号 < 道具_最大槽位 && 已找到 == 0
	IF 方 == 方_玩家
		IF 局_玩家道具:序号 < 0
			找到空槽 = 序号
			已找到 = 1
		ENDIF
	ELSE
		IF 局_庄家道具:序号 < 0
			找到空槽 = 序号
			已找到 = 1
		ENDIF
	ENDIF
	序号 ++
WEND
SIF 已找到 == 0
	RETURN
; 9 种出率一致
道具ID = RAND:道具_种类数
IF 方 == 方_玩家
	局_玩家道具:找到空槽 = 道具ID
ELSE
	局_庄家道具:找到空槽 = 道具ID
ENDIF
RETURN

; ---------- 整理庄家槽位 ----------
@恶魔轮盘整理庄家槽位
#DIM DYNAMIC 序号
#DIM DYNAMIC 整理轮次
FOR 整理轮次, 0, 道具_最大槽位 - 1
	FOR 序号, 0, 道具_最大槽位 - 1
		IF 局_庄家道具:序号 < 0 && 局_庄家道具:(序号 + 1) >= 0
			SWAP 局_庄家道具:序号, 局_庄家道具:(序号 + 1)
		ENDIF
	NEXT
NEXT
RETURN

; ---------- 整理玩家槽位 ----------
@恶魔轮盘整理玩家槽位
#DIM DYNAMIC 序号
#DIM DYNAMIC 整理轮次
FOR 整理轮次, 0, 道具_最大槽位 - 1
	FOR 序号, 0, 道具_最大槽位 - 1
		IF 局_玩家道具:序号 < 0 && 局_玩家道具:(序号 + 1) >= 0
			SWAP 局_玩家道具:序号, 局_玩家道具:(序号 + 1)
		ENDIF
	NEXT
NEXT
RETURN

