; ---------- 刷新状态显示 ----------
@恶魔轮盘刷新状态
;CALL RELINE()
DRAWLINE
SETCOLOR 0xC0C030
LOCALS:0 = 　 阶 段 {局_阶段}/3   持枪: %局_持枪者 == 方_玩家 ? "玩家" # "庄家"%
PRINTFORML %LOCALS:0%
RESETCOLOR
PRINTFORML 　玩家 HP {局_玩家HP}   庄家 HP {局_庄家HP}
PRINTFORML 　剩余子弹: {局_子弹数 - 局_当前下标}/{局_子弹数}
IF 局_手锯状态
	SETCOLOR 0xC0C030
	PRINTFORML 　手锯生效中
	RESETCOLOR
ENDIF
CALL 恶魔轮盘打印子弹概率
RETURN

; ---------- 开枪 ----------
@恶魔轮盘开枪(持枪方, 目标)
#DIM DYNAMIC 持枪方
#DIM DYNAMIC 目标
#DIM DYNAMIC 子弹类型
#DIM DYNAMIC 手锯生效
#DIM DYNAMIC 伤害
#DIM DYNAMIC 命中方
#DIMS DYNAMIC 持枪方名
#DIMS DYNAMIC 命中方名
#DIMS DYNAMIC 目标名

IF 局_当前下标 >= 局_子弹数
	SETCOLOR 0xA0A0A0
	PRINTFORML 　 没有子弹了
	RESETCOLOR
	RETURN
ENDIF

子弹类型 = 局_子弹队列:局_当前下标
持枪方名 = %持枪方 == 方_玩家 ? "你" # "庄家"%
目标名 = %目标 == 目标_自己 ? "自己" # "对方"%
SETCOLOR 0xA0A0A0
PRINTFORML >>> 咔嚓 <<<
TWAIT 800, 0

; 手锯是否生效
; 手锯刻在枪管上, 仅当非空弹打出时才消耗 (空弹不触发手锯, 也不清空手锯状态)
手锯生效 = 0
IF 局_手锯状态 && 子弹类型 != 弹_空弹
	手锯生效 = 1
	局_手锯状态 = 0
ENDIF

; 打印枪响
SELECTCASE 子弹类型
	CASE 弹_实弹
		SETCOLOR 0xC03030
		PRINTFORML >>> 砰! <<<
	CASE 弹_空弹
		SETCOLOR 0x808080
		PRINTFORML >>> 咔哒 <<<
	CASE 弹_治疗弹
		SETCOLOR 0x30C060
		PRINTFORML >>> 治愈 <<<
	CASE 弹_独头弹
		SETCOLOR 0xC0C030
		PRINTFORML >>> 轰! <<<
ENDSELECT
TWAIT 1200, 0
RESETCOLOR

; 结算伤害
伤害 = 子弹类型伤害(子弹类型)
IF 手锯生效 && 子弹类型 != 弹_空弹
	伤害 = 伤害 * 2
ENDIF

IF 子弹类型 == 弹_空弹
	SETCOLOR 0x808080
	PRINTFORML 　%持枪方名% 射%目标名%: 空弹 (无效果)
	RESETCOLOR
ELSE
	IF 目标 == 目标_自己
		命中方 = 持枪方
	ELSE
		命中方 = 1 - 持枪方
	ENDIF
	命中方名 = %命中方 == 方_玩家 ? "你" # "庄家"%
	; 先打印击发信息 (持枪方 射 目标)
	SETCOLOR 0xC0C0C0
	PRINTFORML 　%持枪方名% 射%目标名%:
	RESETCOLOR
	IF 伤害 < 0
		伤害 = -伤害
		IF 命中方 == 方_玩家
			局_玩家HP += 伤害
		ELSE
			局_庄家HP += 伤害
		ENDIF
		SETCOLOR 0x30C060
		PRINTFORML 　%命中方名% 感觉好多了 +{伤害} HP
		RESETCOLOR
	ELSEIF 伤害 > 0
		IF 命中方 == 方_玩家
			局_玩家HP -= 伤害
		ELSE
			局_庄家HP -= 伤害
		ENDIF
		SETCOLOR 0xC03030
		SIF 手锯生效
			PRINTFORML 　[手锯 翻倍]
		PRINTFORML 　%命中方名% 流血 -{伤害} HP
		RESETCOLOR
	ENDIF
ENDIF

局_当前下标 ++

; 更新剩余子弹统计
; 局_剩余* 始终 -1 (玩家和 AI 都能看到的"剩余")
; 局_庄家未揭示* -1: 当这颗对庄家未揭示时 (无论谁开火, 子弹已出膛, 不再属于"未揭示剩余")
SELECTCASE 子弹类型
	CASE 弹_空弹
		局_剩余空弹 --
		SIF 局_庄家已揭示:(局_当前下标 - 1) == 0
			局_庄家未揭示空弹 --
	CASE 弹_实弹
		局_剩余实弹 --
		SIF 局_庄家已揭示:(局_当前下标 - 1) == 0
			局_庄家未揭示实弹 --
	CASE 弹_治疗弹
		局_剩余治疗弹 --
		SIF 局_庄家已揭示:(局_当前下标 - 1) == 0
			局_庄家未揭示治疗弹 --
	CASE 弹_独头弹
		局_剩余独头弹 --
		SIF 局_庄家已揭示:(局_当前下标 - 1) == 0
			局_庄家未揭示独头弹 --
ENDSELECT

CALL 恶魔轮盘胜负判定
; 返回 0 = 切换持枪者, 1 = 不切换 (空弹/治疗弹射自己, 可连射)
IF (子弹类型 == 弹_空弹 || 子弹类型 == 弹_治疗弹) && 目标 == 目标_自己
	RETURN 1
ENDIF
RETURN 0

