; ===================================================================
; 恶魔轮盘 (Buckshot Roulette 复刻)
; 主题: 霰弹枪 + 概率 + 道具博弈
; 游戏变量声明
; ===================================================================

; ---------- 子弹类型常量 ----------
#DIM CONST 弹_空弹    = 0
#DIM CONST 弹_实弹    = 1
#DIM CONST 弹_治疗弹  = 2
#DIM CONST 弹_独头弹  = 3

; ---------- 子弹基础伤害 (正数=扣血, 负数=治疗) ----------
#DIM CONST 弹_伤害_空弹    = 0
#DIM CONST 弹_伤害_实弹    = 1
#DIM CONST 弹_伤害_治疗弹  = -1
#DIM CONST 弹_伤害_独头弹  = 2

; ---------- 子弹生成权重 (合计 100) ----------
#DIM CONST 弹_权重_空弹   = 35
#DIM CONST 弹_权重_实弹   = 35
#DIM CONST 弹_权重_治疗弹 = 15
#DIM CONST 弹_权重_独头弹 = 15

; ---------- 阶段 HP 基础值 (无上限, 治疗可超过) ----------
#DIM CONST 阶段1_基础HP = 8
#DIM CONST 阶段2_基础HP = 12
#DIM CONST 阶段3_基础HP = 16

; ---------- 阶段子弹数范围 ----------
#DIM CONST 阶段1_子弹数_最小 = 6
#DIM CONST 阶段1_子弹数_最大 = 6
#DIM CONST 阶段2_子弹数_最小 = 8
#DIM CONST 阶段2_子弹数_最大 = 8
#DIM CONST 阶段3_子弹数_最小 = 10
#DIM CONST 阶段3_子弹数_最大 = 10

; ---------- 道具槽位 / 种类 ----------
#DIM CONST 道具_最大槽位 = 8
#DIM CONST 道具_种类数   = 9

; ---------- 道具 ID ----------
#DIM CONST 道具_放大镜     = 0
#DIM CONST 道具_香烟       = 1
#DIM CONST 道具_啤酒       = 2
#DIM CONST 道具_手铐       = 3
#DIM CONST 道具_手锯       = 4
#DIM CONST 道具_肾上腺素   = 5
#DIM CONST 道具_逆转器     = 6
#DIM CONST 道具_一次性手机 = 7
#DIM CONST 道具_过期药物   = 8

; ---------- 行动方常量 ----------
#DIM CONST 方_玩家 = 0
#DIM CONST 方_庄家 = 1

; ---------- 目标常量 ----------
#DIM CONST 目标_自己 = 0
#DIM CONST 目标_对方 = 1

; ---------- 运行时变量 (全部由 恶魔轮盘初始化 负责重置) ----------
#DIM 局_阶段               ; 1 / 2 / 3
#DIM 局_玩家HP
#DIM 局_庄家HP
#DIM 局_玩家道具, 8         ; 8 槽, 0 表示空
#DIM 局_庄家道具, 8
#DIM 局_持枪者             ; 0=玩家 1=庄家
#DIM 局_上一持枪者         ; 记录上次持枪者 (用于参考)
#DIM 局_手锯状态           ; 0=无 1=下一发非空弹伤害翻倍
#DIM 局_手铐绑定的持枪者   ; -1=无 0/1=被手铐绑定的持枪者(下次轮到时跳过并解除)
#DIM 局_副作用结束回合     ; 0=否 1=是 (道具副作用强制结束当前回合, 如过期药物)
#DIM 局_子弹队列, 16        ; 当前回合所有子弹的类型
#DIM 局_子弹数             ; 当前队列的子弹总数
#DIM 局_当前下标           ; 下一发要打的下标 (0-based)
#DIM 局_玩家已揭示, 16     ; 玩家用道具揭示的位置 (0=未, 1=已), 跨轮清空
#DIM 局_庄家已揭示, 16     ; 庄家(AI)用道具揭示的位置 (0=未, 1=已), 跨轮清空
#DIM 局_剩余空弹           ; 未打出的空弹数 (玩家和 AI 都能看到的标准概率)
#DIM 局_剩余实弹           ; 未打出的实弹数
#DIM 局_剩余治疗弹         ; 未打出的治疗弹数
#DIM 局_剩余独头弹         ; 未打出的独头弹数
#DIM 局_庄家未揭示空弹     ; 庄家(AI)未揭示且未打出的空弹数 (AI 决策用)
#DIM 局_庄家未揭示实弹     ; 庄家(AI)未揭示且未打出的实弹数
#DIM 局_庄家未揭示治疗弹   ; 庄家(AI)未揭示且未打出的治疗弹数
#DIM 局_庄家未揭示独头弹   ; 庄家(AI)未揭示且未打出的独头弹数
#DIM 局_胜负               ; 0=未结束 1=玩家胜 -1=玩家败
#DIM 局_总胜场             ; 跨次局保留的胜场计数 (重置 eraTW 后清空)
#DIM 局_难度               ; 0=简单(庄家30%错误) 1=普通(15%) 2=困难(0%)
