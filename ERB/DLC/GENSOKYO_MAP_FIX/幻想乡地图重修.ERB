;-----------------------------------------------------------
;全地图房间设定
;-----------------------------------------------------------
@GMF_ALL_MAP_ROOMSETTING
#LOCALSIZE 3
#LOCALSSIZE 1
#DIM MASTER_ORIGINAL_HOME
#DIM MASTER_ORIGINAL_HOUSEHEAD
#DIM CHARA_ORIGINAL_HOME
#DIM DYNAMIC R_ID
GMF_HOME_MAP = MAIN_MAP
MASTER_ORIGINAL_HOME = 默认初期位置
MASTER_ORIGINAL_HOUSEHEAD = 拠点_家主
VARSET LOCAL
FOR LOCAL, 0, MAXHOME
	SIF !GET_EXISTMAP(LOCAL)
		CONTINUE
	MAIN_MAP = LOCAL
	TRYCCALLFORM ROOMSETTING_{MAIN_MAP}
		FOR LOCAL:1, 1, 100
			;補完設定
			;MASTERの初期位置は最低限の機能を備える,飲食はできなくなる
			IF CFLAG:MASTER:初期位置 % 100 == LOCAL
				ROOMDATA:(LOCAL:1) |= 場所_被窝
				ROOMDATA:(LOCAL:1) |= 場所_学习
				ROOMDATA:(LOCAL:1) |= 場所_プライベート
				ROOMDATA:(LOCAL:1) &= ~場所_飲食
			ENDIF
			;ワンルーム
			IF ROOMDATA:(LOCAL:1) & 場所_ワンルーム
				ROOMDATA:(LOCAL:1) |= 場所_被窝
				ROOMDATA:(LOCAL:1) |= 場所_屋内
				ROOMDATA:(LOCAL:1) |= 場所_厨房
				ROOMDATA:(LOCAL:1) |= 場所_学习
				ROOMDATA:(LOCAL:1) |= 場所_休憩
				ROOMDATA:(LOCAL:1) |= 場所_飲食
				ROOMDATA:(LOCAL:1) |= 場所_プライベート
				ROOMDATA:(LOCAL:1) |= 場所_炬燵
				ROOMDATA:(LOCAL:1) &= ~場所_過疎
			ENDIF
			;被窝
			IF ROOMDATA:(LOCAL:1) & 場所_被窝
				ROOMDATA:(LOCAL:1) |= 場所_休憩
			ENDIF
			;洋室
			IF ROOMDATA:(LOCAL:1) & 場所_洋室
				ROOMDATA:(LOCAL:1) |= 場所_屋内
			ENDIF
			;厨房
			IF ROOMDATA:(LOCAL:1) & 場所_厨房
				ROOMDATA:(LOCAL:1) |= 場所_つまみ食い
			ENDIF
			;施錠チェック,初期位置が変わった場合、施錠を解錠する
			R_ID = (LOCAL:1) % 1000 + MAIN_MAP * 100
			SIF LOCK:R_ID && !PRIVATEROOM:(LOCAL:1)
				LOCK:R_ID = 0
		NEXT
		GMF_MAXROOM:LOCAL = MAXROOM
		GMF_ENTRANCE:LOCAL = ENTRANCE
		GMF_MAP_PAGES:LOCAL = MAP_PAGES
		FOR LOCAL:1, 0, 15
			GMF_MAPNAME:LOCAL:(LOCAL:1) '= MAPNAME:(LOCAL:1)
		NEXT
		FOR LOCAL:1, 0, 100
			GMF_ROOMDATA:LOCAL:(LOCAL:1) = ROOMDATA:(LOCAL:1)
		NEXT
	CATCH
		CALLF GMF_ERROR_INFO_PRINT(GET_MAPNAME(MAIN_MAP) + "的房间情报设定失败")
	ENDCATCH
	TRYCCALLFORM DEFAULT_OWNER_{MAIN_MAP}
		GMF_默认初期位置:LOCAL = (LOCAL == GMF_HOME_MAP) ? MASTER_ORIGINAL_HOME # 默认初期位置
		GMF_拠点_家主:LOCAL = (LOCAL == GMF_HOME_MAP) ? MASTER_ORIGINAL_HOUSEHEAD # 拠点_家主
	CATCH
		CALLF GMF_ERROR_INFO_PRINT(GET_MAPNAME(MAIN_MAP) + "的家主情报设定失败")
	ENDCATCH
NEXT
FOR LOCAL, 1, CHARANUM
	;重修初期位置的逻辑，将0和隙间空间99的初期位置改回原据点初期位置
	;虽然未设定任何初期位置的角色，初期位置还是锁定的99就是了
	IF GROUPMATCH(CFLAG:LOCAL:初期位置%100, 0, 99)
		CFLAG:LOCAL:初期位置 = CSVCFLAG(LOCAL, GETNUM(CFLAG, "初期位置"))
	ENDIF
	;自宅位置先不动，主要是重修自宅位置的相关逻辑，区分两个地图模式，用初期直接替代有些欠考虑
	;CFLAG:LOCAL:自宅位置 = CFLAG:LOCAL:初期位置
	IF !CFLAG:LOCAL:出禁
		;PRIVATEROOM变量，注意，最终编号大的角色会成为共用寝室的家主，如秋姐妹里的穰子，典龙中的龙
		CHARA_ORIGINAL_HOME = CFLAG:LOCAL:本来の初期位置 ? CFLAG:LOCAL:本来の初期位置 # CFLAG:LOCAL:初期位置
		GMF_PRIVATEROOM:(CHARA_ORIGINAL_HOME / 100):(CHARA_ORIGINAL_HOME % 100) = LOCAL
	ENDIF
NEXT
MAIN_MAP = GMF_HOME_MAP
TRYCALLFORM ROOMSETTING_{MAIN_MAP}
TRYCALLFORM DEFAULT_OWNER_{MAIN_MAP}
默认初期位置 = MASTER_ORIGINAL_HOME
拠点_家主 = MASTER_ORIGINAL_HOUSEHEAD
PRINTFORMW GMF_INFO：幻想乡全地图房间情报设定完毕

