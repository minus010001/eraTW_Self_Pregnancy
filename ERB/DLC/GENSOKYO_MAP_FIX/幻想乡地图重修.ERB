			PRINTFORML 该功能尚处于开发阶段，且对原版eratw的地点和移动逻辑改动极大，可预见的会有非常多BUG，请谨慎选择开启！
			PRINTFORML 若出现相关BUG等，可以随时选择关闭该功能，应该不会产生任何影响。
			PRINTFORMW 欢迎反馈任何在地图、表现或功能上与原版不一致的地方，补丁作者会慢慢摸鱼修复更新的。
			CALL GMF_ALL_MAP_ROOMSETTING
			GMF_临时更新地图 = 1
			CALL SET_MAINHOME
			GMF_临时更新地图 = 0
		ELSE
			GMF_MAP_MODE = 0
		ENDIF
		CALL GRAPH_DB_REBUILD_ALL
		GOTO GMF_MAIN_LOOP
	CASE 1
		LOCAL:1 = LINECOUNT
		$GMF_SETTING_LOOP
		CLEARLINE LINECOUNT - LOCAL:1
		CALL PRINTBUTTON_EX, @"[0] 人里菜园开关　状态：%\@ GMF_GETBIT("人里菜园") ? 开启 # 关闭 \@%", 0, 0, GMF_GETBIT("人里菜园")
		PRINTFORML
		CALL PRINTBUTTON_EX, @"[1] 人里地图优化开关　状态：%\@ GMF_GETBIT("人里地图优化") ? 开启 # 关闭 \@%", 1, 0, GMF_GETBIT("人里地图优化")
		PRINTFORML
		PRINTFORML [2] 返回
		$GMF_SETTING_INPUT_LOOP
		INPUT
		SELECTCASE RESULT
			CASE 0
				CALL GMF_INVERTBIT("人里菜园")
				PRINTL
				PRINTFORML 该选项在人里设置了家庭菜园，位置在201人里的门，是在人里门外附近不远处找到一块小菜园。
				PRINTFORML 这样一来，访问人里的少女们也能欣赏到你先生你小姐在田间辛劳的美景了。
				PRINTFORML 开启该选项后，需要从搬家界面退出一次才能刷新。（搬家中止也可）
				CALL 有色二择提示,"人里的家庭菜园","不可用","现在在人里门外附近",GMF_GETBIT("人里菜园")
				WAIT
				GOTO GMF_SETTING_LOOP
			CASE 1
				CALL GMF_INVERTBIT("人里地图优化")
				PRINTL
				PRINTFORML 该选项重修了人里的部分地图和坐标，使之和基础据点地图的结构保持一致。（推荐使用颜色地图）
				PRINTFORML 原版外出地图为了保持整合性将各地点的位置做了很大变动，使得许多店铺的位置发生了错位。
				PRINTFORML 重修的主要目的是保证空间上的一致性，外出地点现在只用作功能性分类而并不代表实际空间位置。
				PRINTFORML 如果你已经习惯了之前的地图结构，也可以只选择开启菜园。功能性角度来说原版地图确实更方便一些。
				CALL 有色二择提示,"甜品店现在归属于","广场","吞屋小道",GMF_GETBIT("人里地图优化")
				CALL 有色二择提示,"人里各区域在外出地图中的距离","没有变化","相距更近了",GMF_GETBIT("人里地图优化")
				CALL 有色二择提示,"人里各地点的寻路","没有变化","经过优化了",GMF_GETBIT("人里地图优化")
				CALL GRAPH_DB_REBUILD_ALL
				WAIT
				GOTO GMF_SETTING_LOOP
			CASE 2
				GOTO GMF_MAIN_LOOP
			CASEELSE
				CLEARLINE 1
				GOTO GMF_SETTING_INPUT_LOOP
		ENDSELECT
	CASE 99
		CALL GRAPH_DB_REBUILD_ALL
		RETURN
	CASEELSE
		CLEARLINE 1
		GOTO GMF_MAIN_INPUT_LOOP
ENDSELECT

;-----------------------------------------------------------
;お出かけ先のMap設定を返す関数
;ARG   対象の地点
;ARGS  判定文字典数
;-----------------------------------------------------------
@GMF_ODEKAKEMAP_SETTING(ARG, ARGS)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC 地图记录
#DIM DYNAMIC VALUE
IF GMF_GETBIT("幻想乡大地图")
	;隙间空间处理
	地图记录 = MAIN_MAP
	MAIN_MAP = GMF_LARGE_MAP_ID()
	MAXROOM = GMF_MAXROOM:MAIN_MAP
ENDIF
;待客室と隙間はスルー,0もスルー
IF GROUPMATCH(ARG % 100, 97, 98, 99, 0)
	VALUE = 0
;MAIN_MAPを対象にしていた場合はエラーを吐く
ELSEIF GET_MAPID(ARG) == MAIN_MAP && GET_MAPID(CFLAG:MASTER:現在位置) == MAIN_MAP
	THROW 判定地点位于当前大地图上！当前判定地点{ARG}，当前大地图{MAIN_MAP}
ENDIF
;文字典数を省いた場合もエラー
SIF ARGS == ""
	THROW 未设置需要获取的参数内容！
;RETURNF GETMETH(@"ODEKAKEMAP_SETTING_{GET_MAPID(ARG)}", 0, ARG, ARGS)
SELECTCASE GET_MAPID(ARG)
	CASE 0
		VALUE = ODEKAKEMAP_SETTING_0(ARG, ARGS)
	CASE 1
		VALUE = ODEKAKEMAP_SETTING_1(ARG, ARGS)
	CASE 2
		VALUE = ODEKAKEMAP_SETTING_2(ARG, ARGS)
	CASE 3
		VALUE = ODEKAKEMAP_SETTING_3(ARG, ARGS)
	CASE 4
		VALUE = ODEKAKEMAP_SETTING_4(ARG, ARGS)
	CASE 5
		VALUE = ODEKAKEMAP_SETTING_5(ARG, ARGS)
	CASE 6
		VALUE = ODEKAKEMAP_SETTING_6(ARG, ARGS)
	CASE 7
		VALUE = ODEKAKEMAP_SETTING_7(ARG, ARGS)
	CASE 8
		VALUE = ODEKAKEMAP_SETTING_8(ARG, ARGS)
	CASE 9
		VALUE = ODEKAKEMAP_SETTING_9(ARG, ARGS)
	CASE 10
		VALUE = ODEKAKEMAP_SETTING_10(ARG, ARGS)
	CASE 11
		VALUE = ODEKAKEMAP_SETTING_11(ARG, ARGS)
	CASEELSE
		THROW
ENDSELECT
IF GMF_GETBIT("幻想乡大地图")
	MAIN_MAP = 地图记录
	MAXROOM = GMF_MAXROOM:MAIN_MAP
ENDIF
RETURNF VALUE

