SELECTCASE Setting_FLAG:单独一人吃饭
	CASE 0
		LOCALS =  单独一人吃饭:禁用
	CASE 1
		LOCALS =  单独一人吃饭:启用
ENDSELECT
CALL PRINTBUTTON_EX(@"[%LOCALS%]", 5, !Setting_FLAG:单独一人吃饭)
