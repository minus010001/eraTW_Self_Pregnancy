		CASE 0
			LOCALS =  低亮/无文字衬底
	ENDSELECT
	CALL PRINTBUTTON_EX(@"[背景图显示模式:%LOCALS%]", 13)
	PRINT ==
		SELECTCASE Setting_FLAG:高亮背景图
		CASE 1
			LOCALS:1 =  衬底透明度
		CASE 0
			LOCALS:1 =  图片明亮度
	ENDSELECT
	CALL PRINTBUTTON_EX(@"[%LOCALS:1%:{衬底透明度}]", 14)
ENDIF


PRINTL

CALL PRINTBUTTON_EX(@"[显示角色列表]", 996)
PRINTL
CALL PRINTBUTTON_EX(@"[批量切换人物立绘]", 997)
PRINTL
CALL PRINTBUTTON_EX(@"[即时设置(实验性)]", 998)
PRINTL
CALL PRINTBUTTON_EX(@"[确认]", 999)
PRINTFORML
INPUT


IF RESULT == 1
	IF Setting_FLAG:五重绝顶 < 2
		Setting_FLAG:五重绝顶 ++
	ELSE
		Setting_FLAG:五重绝顶 = 0
	ENDIF
ELSEIF RESULT == 2
	IF Setting_FLAG:满足终了 < 2
		Setting_FLAG:满足终了 ++
	ELSE
		Setting_FLAG:满足终了 = 0
	ENDIF
ELSEIF RESULT == 3
	Setting_FLAG:主动权转移禁止 = !Setting_FLAG:主动权转移禁止
ELSEIF RESULT == 4 && GMF_GETBIT("幻想乡大地图")
	Setting_FLAG:外出时可以带出去 = !Setting_FLAG:外出时可以带出去
ELSEIF RESULT == 5
	Setting_FLAG:单独一人吃饭 = !Setting_FLAG:单独一人吃饭
ELSEIF RESULT == 6 && Real_Time_Save
	Setting_FLAG:即时重载 = !Setting_FLAG:即时重载
ELSEIF RESULT == 7
	CALL GMF_ALL_MAP_ROOMSETTING
ELSEIF RESULT == 8
	Setting_FLAG:逆推口上找补 = !Setting_FLAG:逆推口上找补
ELSEIF RESULT == 9 && HOUGONG
	Setting_FLAG:跟随型后宫 = !Setting_FLAG:跟随型后宫
ELSEIF RESULT == 10 && Setting_FLAG:跟随型后宫
	PRINTFORMW 确认清除所有人的后宫标记吗？
	CALL ASK_YN, "那当然", "再想想"
	IF !RESULT
		CVARSET Setting_CFLAG, 1, 0
	ENDIF
ELSEIF RESULT == 11
	Setting_FLAG:背景图片 = !Setting_FLAG:背景图片
	SIF !Setting_FLAG:背景图片 
		CALL 背景图片打印()
ELSEIF RESULT == 12
	Setting_FLAG:逆推反感禁止 = !Setting_FLAG:逆推反感禁止
ELSEIF RESULT == 13
	Setting_FLAG:高亮背景图 = !Setting_FLAG:高亮背景图
ELSEIF RESULT == 14
	IF 衬底透明度 < 10
		衬底透明度 ++
	ELSE
		衬底透明度 = 0
	ENDIF
	IF Setting_FLAG:高亮背景图
		CALL 背景展示
		TEXT_BGC_ON GET_MAP_WEATHER_BGCOLOR(), LIMIT(衬底透明度 * 10 + 1, 1, 100)
	ELSE
		CALL 背景展示
	ENDIF
ELSEIF RESULT == 15 && !TFLAG:妄想中
	Setting_FLAG:测试妄想自慰 = !Setting_FLAG:测试妄想自慰
ELSEIF RESULT == 16 && Setting_FLAG:跟随型后宫
	FOR LOCAL, 1, CHARANUM
		SIF CFLAG:LOCAL:神社在住 == SUMIKOMI_ROOM
			Setting_CFLAG:LOCAL:后宫居住标记 = 1
	NEXT
	PRINTFORMW 标记成功
ELSEIF RESULT == 17
	Setting_FLAG:胖次神的小游戏 = !Setting_FLAG:胖次神的小游戏
ELSEIF RESULT == -100
	CALL 运行时函数调用
	PRINTFORMW {RESULT}
ELSEIF RESULT == 996
	DEBUGCLEAR
	CALL SHOW_CHARA_LIST("现有的角色列表", "体力气力", "「情報表示」「条件変更」")
ELSEIF RESULT == 997
	CALL 批量切换人物立绘
ELSEIF RESULT == 998
	PRINTFORMW 警告，实验性功能，不建议用此功能进行某些dlc开关的设置，尤其是幻想乡大地图。
	CALL OPTION
ELSEIF RESULT == 999
	RETURN 
ENDIF
GOTO LOOP

@逆推指令转化(ARG)
#FUNCTION
IF CFLAG:MASTER:诶嘿嘿 == 1
	SELECTCASE ARG
		CASE T3手指插入
			RETURNF T316手指插入
		CASE T5肛门爱抚
			RETURNF T314肛门爱抚
		CASE T6胸爱抚
			RETURNF T313胸爱抚
		CASE T15阴蒂爱抚
			RETURNF T315阴蒂爱抚
		CASE T20接吻
			RETURNF T312接吻
		CASE T60正常位
			RETURNF T320对方主导正常位
		CASE T61后背位
			RETURNF T322对方主导后背位
		CASE T63后背位肛交
			RETURNF T323对方主导后背位Ａ
	ENDSELECT
ELSEIF CFLAG:MASTER:诶嘿嘿 == 2
	SELECTCASE ARG
		CASE 316
			RETURNF T3手指插入
		CASE T314肛门爱抚
			RETURNF T5肛门爱抚
		CASE T313胸爱抚
			RETURNF T6胸爱抚
		CASE T315阴蒂爱抚
			RETURNF T15阴蒂爱抚
		CASE T312接吻
			RETURNF T20接吻
		CASE T320对方主导正常位
			RETURNF T60正常位
		CASE T322对方主导后背位
			RETURNF T61后背位
		CASE T323对方主导后背位Ａ
			RETURNF T63后背位肛交
	ENDSELECT
ENDIF
RETURNF 0

@SET_逆推口上找补(KOJO_NAME, COM_ID, COM_TYPE)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS DYNAMIC KOJO_NAME
#DIM DYNAMIC COM_ID
#DIMS DYNAMIC COM_TYPE
#DIM DYNAMIC LINE_RECORD
#DIM DYNAMIC REPEAT_TIMES
#DIM DYNAMIC 子宫开发
LINE_RECORD = LINECOUNT
自动喘息阻碍 = 1
TRYCALLFORM M_KOJO%KOJO_NAME%_MESSAGE_%COM_TYPE%_K{NO:TARGET}_{COM_ID}
IF 检测最新输出内容(LINECOUNT-LINE_RECORD) && COM_ID == 317 && COM_TYPE == "COM"
	REPEAT_TIMES = 0
	CALL RELINE(,1)
	$LOOP_317
	CALL RELINE()
	子宫开发 = 0
	REPEAT_TIMES ++
	LINE_RECORD = LINECOUNT
	SELECTCASE RAND:4
		CASE 1
			TRYCALLFORM M_KOJO%KOJO_NAME%_MESSAGE_SCOM_K{NO:TARGET}_6
		CASE 2
			TRYCALLFORM M_KOJO%KOJO_NAME%_MESSAGE_SCOM_K{NO:TARGET}_7
			子宫开发 = 1
		CASE 3
			TRYCALLFORM M_KOJO%KOJO_NAME%_MESSAGE_COM_K{NO:TARGET}_360
		CASEELSE
			TRYCALLFORM M_KOJO%KOJO_NAME%_MESSAGE_COM_K{NO:TARGET}_{POSE_TO_COMNO:(TEQUIP:TARGET:体位)}
	ENDSELECT
	IF 检测最新输出内容(LINECOUNT-LINE_RECORD) && REPEAT_TIMES < 20
		SIF REPEAT_TIMES >= 10
			自动喘息阻碍 = 0
		GOTO LOOP_317
	ELSEIF REPEAT_TIMES >= 20
		RESULT = 0
		TRYCALLFORM M_KOJO%KOJO_NAME%_MESSAGE_COM_K{NO:TARGET}_00
	ELSE
		RESULT = 1
	ENDIF
	SIF 子宫开发
		EXP:TARGET:子宮口開発経験 ++
ELSEIF 检测最新输出内容(LINECOUNT-LINE_RECORD) && COM_ID == 318 && COM_TYPE == "COM"
	REPEAT_TIMES = 0
	CALL RELINE(,1)
	$LOOP_318
	CALL RELINE()
	REPEAT_TIMES ++
	LINE_RECORD = LINECOUNT
	SELECTCASE RAND:4
		CASE 1
			TRYCALLFORM M_KOJO%KOJO_NAME%_MESSAGE_SCOM_K{NO:TARGET}_14
		CASE 2
			TRYCALLFORM M_KOJO%KOJO_NAME%_MESSAGE_SCOM_K{NO:TARGET}_15
		CASE 3
			TRYCALLFORM M_KOJO%KOJO_NAME%_MESSAGE_COM_K{NO:TARGET}_360
		CASEELSE
			TRYCALLFORM M_KOJO%KOJO_NAME%_MESSAGE_COM_K{NO:TARGET}_{POSE_A_TO_COMNO:(TEQUIP:TARGET:体位)}
	ENDSELECT
	IF 检测最新输出内容(LINECOUNT-LINE_RECORD) && REPEAT_TIMES < 20
		SIF REPEAT_TIMES >= 10
			自动喘息阻碍 = 0
		GOTO LOOP_318
	ELSEIF REPEAT_TIMES >= 20
		RESULT = 0
		TRYCALLFORM M_KOJO%KOJO_NAME%_MESSAGE_COM_K{NO:TARGET}_00
	ELSE
		RESULT = 1
	ENDIF
ELSEIF 检测最新输出内容(LINECOUNT-LINE_RECORD) && 逆推指令转化(COM_ID) != 0 && COM_TYPE == "COM"
	REPEAT_TIMES = 0
	CALL RELINE(,1)
	$LOOP_360
	CALL RELINE()
	REPEAT_TIMES ++
	LINE_RECORD = LINECOUNT
	SELECTCASE RAND:2
		CASE 1
			TRYCALLFORM M_KOJO%KOJO_NAME%_MESSAGE_COM_K{NO:TARGET}_360
		CASEELSE
			TRYCALLFORM M_KOJO%KOJO_NAME%_MESSAGE_COM_K{NO:TARGET}_{逆推指令转化(COM_ID)}
	ENDSELECT
	IF 检测最新输出内容(LINECOUNT-LINE_RECORD) && REPEAT_TIMES < 20
		SIF REPEAT_TIMES >= 10
			自动喘息阻碍 = 0
		GOTO LOOP_360
	ELSEIF REPEAT_TIMES >= 20
		RESULT = 0
		TRYCALLFORM M_KOJO%KOJO_NAME%_MESSAGE_COM_K{NO:TARGET}_00
	ELSE
		RESULT = 1
	ENDIF
ENDIF
自动喘息阻碍 = 0
RETURN RESULT

@批量切换人物立绘
PRINTL 尽可能地将立绘切换为所选立绘组'
PRINTL 要切换哪种立绘呢?
PRINTL [1]默认立绘
PRINTL [2]Isacc
PRINTL [3]EagloV
PRINTL [4]AS06MARKIV
PRINTL [0]取消
INPUT
SELECTCASE RESULT
	CASE 0
	CASE 1
		FOR LOCAL, 0, CHARANUM
			SIF TALENT:LOCAL:路人
				CONTINUE
			CFLAG:LOCAL:差し替え適用 = 0
		NEXT
	CASE 2
		FOR LOCAL, 0, CHARANUM
			SIF TALENT:LOCAL:路人
				CONTINUE
			SIF Isacc_Index:LOCAL:0 != 0
				CFLAG:LOCAL:差し替え適用 = Isacc_Index:LOCAL:0
		NEXT
	CASE 3
		FOR LOCAL, 0, CHARANUM
			SIF TALENT:LOCAL:路人
				CONTINUE
			SIF EagloV_Index:LOCAL:0 != 0
				CFLAG:LOCAL:差し替え適用 = EagloV_Index:LOCAL:0
		NEXT
	CASE 4
		FOR LOCAL, 0, CHARANUM
			SIF TALENT:LOCAL:路人
				CONTINUE
			SIF AS06MARKIV_Index:LOCAL:0 != 0
				CFLAG:LOCAL:差し替え適用 = AS06MARKIV_Index:LOCAL:0
		NEXT
ENDSELECT
RETURN

