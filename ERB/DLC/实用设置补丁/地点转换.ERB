@MAP_SEARCH_REPLACEMENT_4_ALTER(ARG)
#FUNCTION
SELECTCASE ARG
	CASE P401永遠亭入口, P421庭, P422後院, P409走廊
		RETURNF 永远亭外
	CASE P403待合室 TO P406来客用廁所
		RETURNF 永远亭诊室
	CASE P407廊下 TO P430地下室
		IF GROUPMATCH(ARG, P415大廳, P416居間, P417廚房)
			RETURNF 永远亭客厅
		ELSEIF INRANGE(ARG, P410帝私室, P414輝夜私室) || GROUPMATCH(ARG,P428二階空的部屋, P430地下室)
			RETURNF 永远亭卧室
		ELSE
			RETURNF 永远亭走廊
		ENDIF
		RETURNF 永遠亭的内院
	CASE P431兎的洞穴
		RETURNF 兎的洞穴
	CASE P433斜角的竹林
		RETURNF 斜角的竹林
	CASE P432影狼的家, P445妹紅的家, P443米斯蒂亜的家, P440廃屋, P442空的小屋
		RETURNF 竹林居所
	CASE P434迷失的小道, P435井戸, P441温泉
		RETURNF 迷失的小道
	CASE P437梅蒂欣的家, P439拉尔瓦的家
		RETURNF 花田居所
	CASE P436無名之丘, 
		RETURNF 無名之丘
	CASE P438太陽花田, 
		RETURNF 太陽花田
	CASE P450玄関 TO P466庭
		IF GROUPMATCH(ARG, P451胡桃私室, P452艾麗私室, P457夢月私室, P459幻月私室, P460空的部屋, P463幽香私室)
			RETURNF 梦幻馆卧室
		ELSEIF GROUPMATCH(ARG, P465大堂, P454浴室, P455廁所, P456倉庫)
			RETURNF 梦幻馆大厅
		ELSEIF GROUPMATCH(ARG, P461生活間, P458廊下)
			RETURNF 梦幻馆客厅
		ELSEIF ARG == P453用餐房間
			RETURNF 梦幻馆餐厅
		ELSE
			RETURNF 梦幻馆外
		ENDIF
	CASEELSE
		RETURNF 竹林入口
ENDSELECT
RETURNF 0

@背景展示
#DIMS 地点名
#DIM 季节编号
#DIM 时间编号
#DIMS 背景名
#DIM 无季节差分
#DIM 无时间差分
背景名 =
地点名 = 
无季节差分 = 0
无时间差分 = 0
IF IS_GAP_GUEST(MASTER)
ELSE
	IF GMF_AT_LARGE_MAP(MASTER)
		IF GET_MAPID(CFLAG:MASTER:現在位置) == 0
			IF 位置归类(CFLAG:MASTER:現在位置) == 神社境内
				地点名 '= "神社境内"
			ELSEIF 位置归类(CFLAG:MASTER:現在位置) == 神社本堂
				地点名 '= "神社本殿"
			ELSEIF 位置归类(CFLAG:MASTER:現在位置) == 桜花道的鳥居 || GMF_AT_LARGE_MAP(MASTER) == 2
				地点名 '= "参道"
			ELSEIF 位置归类(CFLAG:MASTER:現在位置) == 神社走廊
				地点名 '= "神社走廊"
			ELSEIF 位置归类(CFLAG:MASTER:現在位置) == 夢幻遺跡
				IF INROOM(CFLAG:MASTER:現在位置)
					地点名 '= "梦幻遗迹内部"
					无时间差分 ++
					无季节差分 ++
				ELSE
					地点名 '= "梦幻遗迹前"
				ENDIF
			ELSEIF 位置归类(CFLAG:MASTER:現在位置) == 妖精的大樹
				IF INROOM(CFLAG:MASTER:現在位置)
					地点名 '= "三月精的家"
					无季节差分 ++
				ELSE
					地点名 '= "镇守之森"
				ENDIF
			ELSEIF 位置归类(CFLAG:MASTER:現在位置) == 大别墅
				IF INROOM(CFLAG:MASTER:現在位置)
					地点名 '= "大别墅"
				ELSE
					地点名 '= "大别墅外"
				ENDIF
			ENDIF
		ELSEIF GET_MAPID(CFLAG:MASTER:現在位置) == 1
			IF 位置归类(CFLAG:MASTER:現在位置) == 地藏小路
				地点名 '= "地藏小路"
