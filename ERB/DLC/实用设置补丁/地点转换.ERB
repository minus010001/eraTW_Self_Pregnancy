IF !无季节差分
	季节编号 = DAY:季節
ELSE
	季节编号 = 0
ENDIF
IF !无时间差分
	时间编号 = TIME >= 360 && TIME < 1080 ? 0 # 1
ELSE
	时间编号 = 0
ENDIF
