
@位置归类(ARG)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM 対象Map
#DIM OUTID
対象Map = GET_MAPID(ARG)
SELECTCASE 対象Map
	CASE 0
		OUTID = MAP_SEARCH_REPLACEMENT_0_ALTER(ARG)
	CASE 1
		OUTID = MAP_SEARCH_REPLACEMENT_1_ALTER(ARG)
	CASE 2
		OUTID = MAP_SEARCH_REPLACEMENT_2_ALTER(ARG)
	CASE 3
		OUTID = MAP_SEARCH_REPLACEMENT_3_ALTER(ARG)
	CASE 4
		OUTID = MAP_SEARCH_REPLACEMENT_4_ALTER(ARG)
	CASE 5
		OUTID = MAP_SEARCH_REPLACEMENT_5(ARG)
	CASE 6
		OUTID = MAP_SEARCH_REPLACEMENT_6(ARG)
	CASE 7
		OUTID = MAP_SEARCH_REPLACEMENT_7(ARG)
	CASE 8
		OUTID = MAP_SEARCH_REPLACEMENT_8(ARG)
	CASE 9
		OUTID = MAP_SEARCH_REPLACEMENT_9(ARG)
	CASE 10
		OUTID = MAP_SEARCH_REPLACEMENT_10(ARG)
	CASE 11
		OUTID = MAP_SEARCH_REPLACEMENT_11(ARG)
	CASEELSE
		OUTID = ARG
ENDSELECT
RETURNF OUTID

@MAP_SEARCH_REPLACEMENT_1_ALTER(ARG)
#FUNCTION
SELECTCASE ARG
	CASE P140地蔵小路
		RETURNF 地藏小路
	CASE P101山門, P102境内, P122梵鐘楼
		RETURNF 命莲寺山门
	CASE P121墓地
		RETURNF 命莲寺墓地
	CASE P106後院
		RETURNF 命莲寺后院
	CASE P110走廊
		RETURNF 命莲寺后院外景走廊
	CASE P135廊下
		RETURNF 命莲寺后院内部走廊
	CASE P107土間, P111廚房
		RETURNF 命莲寺后院玄关
	CASE P108居間
		RETURNF 命莲寺后院客厅
	CASE P109女苑私室, P113納茲琳私室 TO P119別屋, P137猯藏の棲家
		RETURNF 命莲寺通用卧室
	CASE P103本堂
		RETURNF 命莲寺本堂
	CASE P104講堂
		RETURNF 命莲寺讲堂
	CASE P105経蔵, P120庫房
		RETURNF 命莲寺经藏
	CASE P123霊廟大門, P124霊廟広場
		RETURNF 神灵庙大门
	CASE P138鐘楼
		RETURNF 神灵庙钟楼
	CASE P139邪仙楼
		RETURNF 神灵庙邪仙楼
	CASE P126道場
		RETURNF 神灵庙道场
	CASE P132調薬室, P134蔵
		RETURNF 神灵庙调药室
	CASE P131枯山水
		RETURNF 神灵庙枯山水
	CASE P129客間
		RETURNF 神灵庙客厅
	CASE P125屠自古私室, P127布都私室, P128神子私室
		RETURNF 神灵庙通用私室
	CASE P130廊下
		RETURNF 神灵庙走廊
	CASE P133湯殿, P112風呂
		RETURNF 通用浴室
ENDSELECT
RETURNF 0

@MAP_SEARCH_REPLACEMENT_0_ALTER(ARG)
#FUNCTION
SELECTCASE ARG
	CASE P1鳥居, P22参道, P23温泉・脱衣所, P24温泉
		RETURNF 桜花道的鳥居
	CASE P2境内, P5手水舎, P6庫房, P21守矢神社分社, P56阿吽の棲家, P16破舊小屋, P3賽銭箱
		RETURNF 神社境内
	;賽銭箱,本堂
	CASE P4本堂, P7土間 ,P8廚房, P9居間 ,P12脱衣所, P13風呂, P14廁所, P15霊夢私室, P18壁櫥間, P55和室
		RETURNF 神社本堂
	;三妖精之家
	CASE P27三妖精之家・大廳 TO P35三妖精之家・地下室, P25鎮守之森
		RETURNF 妖精的大樹
	;夢幻遺跡
	CASE P36夢幻遺跡前 TO P51夢幻遺跡・倉庫
		RETURNF 夢幻遺跡
	;大别墅
	CASE P57大温泉 TO P68大广场
		RETURNF 大别墅
	CASEELSE
		RETURNF 神社走廊
ENDSELECT
RETURNF 0

