@EagloV_特殊效果_17(VIS_C, TARGET_CHARA = -1)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC エフェクト数 = 0
#DIMS DYNAMIC L_RESULTS,40
#DIM DYNAMIC VIS_C
#DIM DYNAMIC TARGET_CHARA
SIF TARGET_CHARA == -1
	TARGET_CHARA = VIS_C
CALL EagloV_人偶差分_17(TARGET_CHARA)
IF RESULT && SPRITECREATED(RESULTS)
	L_RESULTS:(エフェクト数*2) = %RESULTS%
	エフェクト数 += 1
ELSE
	RETURN
ENDIF
CALL EagloV_GET_颊红差分(, VIS_C, 0, TARGET_CHARA)
IF RESULT && SPRITECREATED(@"EagloV17_特效_人偶颊红")
	L_RESULTS:(エフェクト数*2) = EagloV17_特效_人偶颊红
	エフェクト数 += 1
ENDIF
IF CFLAG:TARGET_CHARA:睡眠
	L_RESULTS:(エフェクト数*2) = EagloV17_特效_人偶闭目
ELSEIF (FLAG:時間停止 && EX:TARGET_CHARA:無自覚Ｃ絶頂 + EX:TARGET_CHARA:無自覚Ｖ絶頂 + EX:TARGET_CHARA:無自覚Ａ絶頂 + EX:TARGET_CHARA:無自覚Ｂ絶頂 + EX:TARGET_CHARA:無自覚Ｍ絶頂 > 30) || (TCVAR:TARGET_CHARA:烂醉 && BASE:TARGET_CHARA:酒気 > MAXBASE:TARGET_CHARA:酒気 * 2/3)
	L_RESULTS:(エフェクト数*2) = EagloV17_特效_人偶白目
ELSEIF FLAG:時間停止
	L_RESULTS:(エフェクト数*2) = EagloV17_特效_人偶常目
ELSEIF NOWEX:TARGET_CHARA:TotalEX > 2 
	L_RESULTS:(エフェクト数*2) = EagloV17_特效_人偶白目
ELSEIF TCVAR:TARGET_CHARA:烂醉
	L_RESULTS:(エフェクト数*2) = EagloV17_特效_人偶闭目
ELSEIF BASE:TARGET_CHARA:憤怒 >= 900
	L_RESULTS:(エフェクト数*2) = EagloV17_特效_人偶暗目
ELSEIF CFLAG:TARGET_CHARA:心情不快 > 0
	L_RESULTS:(エフェクト数*2) = EagloV17_特效_人偶闭目
ELSE
	L_RESULTS:(エフェクト数*2) = EagloV17_特效_人偶常目
ENDIF
エフェクト数 += 1

; 人偶气泡
IF RAND:4 && !FLAG:時間停止
	CALL EagloV_气泡判定(TARGET_CHARA)
	;DEBUGPRINTFORML 气泡是%RESULTS%：{SPRITECREATED(@"EagloV17_特效_人偶%RESULTS%")}
	IF SPRITECREATED(@"EagloV17_特效_人偶%RESULTS%")
		L_RESULTS:(エフェクト数*2) = EagloV17_特效_人偶%RESULTS%
		エフェクト数 += 1
	ENDIF
ENDIF
[IF DEBUG]
FOR LOCAL, 0, 10
	SIF L_RESULTS:LOCAL != ""
		DEBUGPRINTFORML {LOCAL}%L_RESULTS:LOCAL%
NEXT
[ENDIF]
VARSET RESULTS
ARRAYCOPY "L_RESULTS", "RESULTS"
RETURN エフェクト数

