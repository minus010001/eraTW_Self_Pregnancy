@EagloV_特殊效果_49(VIS_C, TARGET_CHARA = -1)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC エフェクト数 = 0
#DIMS DYNAMIC L_RESULTS, 40
#DIMS DYNAMIC 眼特效
#DIM DYNAMIC VIS_C
#DIM DYNAMIC TARGET_CHARA
SIF TARGET_CHARA == -1
	TARGET_CHARA = VIS_C
; 3rd眼
IF CFLAG:TARGET_CHARA:睡眠
	眼特效 = EagloV49_特效_3rd闭目
ELSEIF (FLAG:時間停止 && EX:TARGET_CHARA:無自覚Ｃ絶頂 + EX:TARGET_CHARA:無自覚Ｖ絶頂 + EX:TARGET_CHARA:無自覚Ａ絶頂 + EX:TARGET_CHARA:無自覚Ｂ絶頂 + EX:TARGET_CHARA:無自覚Ｍ絶頂 > 30) || (TCVAR:TARGET_CHARA:烂醉 && BASE:TARGET_CHARA:酒気 > MAXBASE:TARGET_CHARA:酒気 * 2/3)
	眼特效 = EagloV49_特效_3rd啊嘿
ELSEIF FLAG:時間停止
	眼特效 = EagloV49_特效_3rd睁目
ELSEIF NOWEX:TARGET_CHARA:TotalEX > 2 
	眼特效 = EagloV49_特效_3rd啊嘿
ELSEIF TCVAR:TARGET_CHARA:烂醉
	眼特效 = EagloV49_特效_3rd闭目
ELSEIF BASE:TARGET_CHARA:憤怒 >= 900
	眼特效 = EagloV49_特效_3rd暗眼
ELSEIF CFLAG:TARGET_CHARA:心情不快 > 0
	眼特效 = EagloV49_特效_3rd闭目
ELSEIF (TALENT:TARGET_CHARA:恋慕 || TALENT:TARGET_CHARA:愛欲) && (CFLAG:TARGET_CHARA:积攒度 > 800 || CFLAG:TARGET_CHARA:诶嘿嘿 && GETPALAMLV(PALAM:TARGET_CHARA:欲情, 6) >= 6)
	IF ABL:TARGET_CHARA:親密 + RAND:(ABL:TARGET_CHARA:親密/2+1) > ABL:TARGET_CHARA:欲望
		眼特效 = EagloV49_特效_3rd心目
	ELSE
		眼特效 = EagloV49_特效_3rd暗心目
	ENDIF
ELSE
	眼特效 = EagloV49_特效_3rd睁目
ENDIF
; 先推入气泡后推入3rd眼
; 3rd眼气泡
IF RAND:4 && !FLAG:時間停止
	CALL EagloV_气泡判定(TARGET_CHARA)
	IF SPRITECREATED(@"EagloV49_特效_3rd气泡_%RESULTS%")
		L_RESULTS:(エフェクト数*2) '= @"EagloV49_特效_3rd气泡_%RESULTS%"
		エフェクト数++
	ENDIF
ENDIF
L_RESULTS:(エフェクト数*2) '= 眼特效
エフェクト数++

VARSET RESULTS
ARRAYCOPY "L_RESULTS", "RESULTS"
RETURN エフェクト数
;}
