@EagloV0_你小姐玩偶(VIS_C, TARGET_CHARA = -1, MODE)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC VIS_C
#DIM DYNAMIC TARGET_CHARA
#DIM DYNAMIC MODE
#DIM DYNAMIC P_ID
;1:灵梦 11:魔理沙 14:琪露诺 16:蕾米莉亚 17:爱丽丝 23:妖梦 25:蓝 26:紫 38:恋 40:小伞 49:觉 50:芙兰 52:铃仙 54:帕秋莉 61:妹红 62:辉夜 66:幽幽子 71:针妙丸 97:正邪
#DIM DYNAMIC 玩偶 = 1, 11, 14, 16, 17, 23, 25, 26, 38, 40, 49, 50, 52, 54, 61, 62, 66, 71, 97
#FUNCTION
SIF TARGET_CHARA == -1
	TARGET_CHARA = VIS_C
FOR LOCAL, 1, GET_TARGETNUM() + 1
	IF FINDELEMENT(玩偶, TARGET:LOCAL) > 0
		P_ID = TARGET:LOCAL
		BREAK
	ENDIF
NEXT
SIF !P_ID
	P_ID = 玩偶:(FLAG:9 % VARSIZE("玩偶"))
RETURNF P_ID

