@EagloV_特殊服装_49(VIS_C, TARGET_CHARA = -1)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC G_ID
#DIM DYNAMIC VIS_C
#DIM DYNAMIC TARGET_CHARA
