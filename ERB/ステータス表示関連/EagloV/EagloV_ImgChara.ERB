	エフェクト数++
ENDIF
IF CFLAG:TARGET_CHARA:行動 == 5 && CFLAG:TARGET_CHARA:職種 == JOB_料理
	L_RESULTS:(エフェクト数*2) = EagloV28_特效_托盘
