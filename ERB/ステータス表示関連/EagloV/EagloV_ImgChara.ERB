IF 仕事中チェック(TARGET_CHARA) || IS_ANGRY(TARGET_CHARA) || !IS_FALLEN(TARGET_CHARA)
	;拿着悔悟棒
	SELECTCASE EagloV_服装初步判定(TARGET_CHARA)
		CASE "服"
			IF CURRENT_CLOTHES_SET(TARGET_CHARA) == [[超棒的Ｔ恤衬衫套]]
				L_RESULTS:(エフェクト数*2) = EagloV30_特效_怪T悔悟
			ELSEIF CURRENT_CLOTHES_SET(TARGET_CHARA) == [[婚紗套]]
			ELSE
				L_RESULTS:(エフェクト数*2) = EagloV30_特效_常服悔悟
			ENDIF
		CASE "胸罩","内衣"
			L_RESULTS:(エフェクト数*2) = EagloV30_特效_内衣悔悟
		CASEELSE
			L_RESULTS:(エフェクト数*2) = EagloV30_特效_裸悔悟
	ENDSELECT
	エフェクト数++
ELSE
	;不拿悔悟棒
ENDIF
FOR LOCAL, 0, 3
	IF GETBIT(STAIN:TARGET_CHARA:(精渍部位:LOCAL), 2)
		L_RESULTS:(エフェクト数*2) = EagloV30_特效_%STAINNAME:(精渍部位:LOCAL)%精渍
		エフェクト数++
	ENDIF
NEXT
IF CURRENT_CLOTHES_SET(TARGET_CHARA) == [[婚紗套]]
	L_RESULTS:(エフェクト数*2) = EagloV30_特效_头冠
	エフェクト数++
ELSEIF 仕事中チェック(TARGET_CHARA)
	L_RESULTS:(エフェクト数*2) = EagloV30_特效_帽子
	エフェクト数++
ELSEIF EagloV_服装初步判定(TARGET_CHARA) == "服" && !(CFLAG:TARGET_CHARA:睡眠 || CFLAG:TARGET_CHARA:陪睡中 || 睡眠時間(TARGET_CHARA) || CFLAG:TARGET_CHARA:诶嘿嘿)
	L_RESULTS:(エフェクト数*2) = EagloV30_特效_帽子
	エフェクト数++
ENDIF
IF TALENT:TARGET_CHARA:妻 > 1
	L_RESULTS:(エフェクト数*2) = EagloV30_特效_婚戒
	エフェクト数++
ENDIF

VARSET RESULTS
ARRAYCOPY "L_RESULTS", "RESULTS"
RETURN エフェクト数

@EagloV_特殊内衣_30(VIS_C, TARGET_CHARA = -1)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC VIS_C
#DIM DYNAMIC TARGET_CHARA
SIF TARGET_CHARA == -1
	TARGET_CHARA = VIS_C
;IF IS_BUNNY(TARGET_CHARA)
;	RESULTS = 兔女郎
;	RETURN 2
;ENDIF
RETURN 0
;}

