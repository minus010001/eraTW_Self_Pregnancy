@EagloV_BUILD_表情差分(Version, VIS_C, 表情)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS DYNAMIC Version
#DIM G_ID
#DIM VIS_C
#DIMS 表情
#DIMS 表情_眉
#DIMS 表情_目
#DIMS 表情_口
#DIMS 表情_鼻
