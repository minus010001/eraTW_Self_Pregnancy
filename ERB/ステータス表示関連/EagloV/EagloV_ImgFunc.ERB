#DIM DYNAMIC TARGET_CHARA

SIF TARGET_CHARA == -1
	TARGET_CHARA = VIS_C
CALL EagloV_GET_EFFECT_RESOURCE(VIS_C, エフェクト, TARGET_CHARA)
RETURN RESULT

;}

@EagloV_ADD_EFFECT_FACE(EFFECT_FACE, EFFECT_IDX, TEMP_EFFECT, operator)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS 	DYNAMIC	EFFECT_FACE
#DIMS 	DYNAMIC	operator
#DIM	REF	EFFECT_IDX
#DIMS	REF	TEMP_EFFECT ;从主函数引用，保证在主函数返回时释放

; 应用特效
IF operator == "SET"
	VARSET RESULTS
	ARRAYCOPY "TEMP_EFFECT", "RESULTS"
	RETURN EFFECT_IDX
ENDIF

; 添加特效
IF EFFECT_FACE != ""
	RESULTS:(EFFECT_IDX * 2) '= EFFECT_FACE
	EFFECT_IDX ++
ENDIF

@EagloV_SET_EFFECT_FACE(EFFECT_IDX, TEMP_EFFECT)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS 	DYNAMIC	EFFECT_FACE
#DIMS 	DYNAMIC	operation
#DIM	REF	EFFECT_IDX
#DIMS	REF	TEMP_EFFECT ;从主函数引用，保证在主函数返回时释放
JUMP EagloV_ADD_EFFECT_FACE,EFFECT_FACE, EFFECT_IDX, TEMP_EFFECT ,"SET"
