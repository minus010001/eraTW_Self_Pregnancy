;无 <- 皱眉 <- 怒眉
IF 表情_眉 == "怒眉"
	SIF !SPRITECREATED(@"%Version%EagloV{NO:VIS_C}_眉_%表情_眉%")
		表情_眉 = 皱眉
ENDIF
SIF SPRITECREATED(@"%Version%EagloV{NO:VIS_C}_眉_%表情_眉%")
	CALL 画像合成(G_ID, @"%Version%EagloV{NO:VIS_C}_眉_%表情_眉%")

;EagloV{NO:VIS_C}_目_{目}
;无 <- 闭目 <- 笑目
IF 表情_目 == "笑目"
	SIF !SPRITECREATED(@"%Version%EagloV{NO:VIS_C}_目_%表情_目%")
		表情_目 = 闭目
ENDIF
SIF SPRITECREATED(@"%Version%EagloV{NO:VIS_C}_目_%表情_目%")
	CALL 画像合成(G_ID, @"%Version%EagloV{NO:VIS_C}_目_%表情_目%")

;EagloV{NO:VIS_C}_口_{口}
;无 <- 大口 <- 小口
IF 表情_口 == "小口"
	SIF !SPRITECREATED(@"%Version%EagloV{NO:VIS_C}_口_%表情_口%")
		表情_口 = 大口
ENDIF
SIF SPRITECREATED(@"%Version%EagloV{NO:VIS_C}_口_%表情_口%")
	CALL 画像合成(G_ID, @"%Version%EagloV{NO:VIS_C}_口_%表情_口%")

;EagloV{NO:VIS_C}_鼻_{鼻}
SIF SPRITECREATED(@"%Version%EagloV{NO:VIS_C}_鼻_%表情_鼻%")
	CALL 画像合成(G_ID, @"%Version%EagloV{NO:VIS_C}_鼻_%表情_鼻%")

; 合成体图
SPRITECREATE 表情索引, G_ID
RETURN


; RESULTS:0 {眉}
; RESULTS:1 {目}
; RESULTS:2 {口}
; RESULTS:3 {鼻}
@EagloV_GET_表情差分(表情)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS 表情

RESULTS:0 = 
RESULTS:1 = 
RESULTS:2 = 
RESULTS:3 = 鼻

SELECTCASE 表情
CASE "时停解除绝顶"
	RESULTS:0 = 挑眉
	RESULTS:1 = 白目
	RESULTS:2 = 大口
CASE "时停"
	RESULTS:0 = 常眉
	RESULTS:1 = 暗目
	RESULTS:2 = 闭口
CASE "时停绝顶"
	RESULTS:0 = 挑眉
	RESULTS:1 = 白目
	RESULTS:2 = 闭口
CASE "睡眠"
	RESULTS:0 = 常眉
	RESULTS:1 = 闭目
	IF RAND:2
		RESULTS:2 = 闭口
	ELSE
		RESULTS:2 = 笑口
	ENDIF
CASE "睡眠察觉"
	RESULTS:0 = 挑眉
	RESULTS:1 = 闭目
	IF RAND:2
		RESULTS:2 = 闭口
