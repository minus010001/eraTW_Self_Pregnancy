; [EagloV2]系列
; 与[EagloV]唯一的差异在 EagloV_BUILD_下着体差分 函数里。如[EagloV]有修改需使其同步
; 在内衣状态时，胸罩的拼接规则不同，不再是裸胸上覆盖胸罩，而是选择胸罩或裸胸之一
; 目前使用此套方法的角色有 [永琳]
;{
@EagloV2_GET_BASE_RESOURCE(VIS_C, 表示形式 = "", 服装 = "", 表情:0 = "", 表情:1 = "", 特服 = "", 乳量 = "", TARGET_CHARA = -1)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM VIS_C
#DIM TARGET_CHARA
#DIMS 表示形式
#DIMS 妊肚
#DIMS 乳量
#DIMS 丁日
#DIMS 服装
#DIMS 特服
#DIM 特服种类		; 0:无，1:胸罩胖次，2:连体内衣
#DIMS 表情, 2
#DIMS 全图索引, 2
#DIMS DYNAMIC Version

SIF TARGET_CHARA == -1
	TARGET_CHARA = VIS_C

;EagloV_{妊肚}_{乳量}_{丁日}_{服装}_{表情}_{VIS_C}

;初步判定
SIF 服装 == ""
	服装 = %EagloV_服装初步判定(TARGET_CHARA)%
妊肚 = %EagloV_妊肚判定(TARGET_CHARA)%
乳量 = %EagloV_乳量判定(TARGET_CHARA)%
丁日 = %EagloV_丁日判定(TARGET_CHARA, 服装)%
特服 =

Version =
RESULT = 0
TRYCALLFORM EagloV_Version{NO:VIS_C}
SIF RESULT
	Version = %RESULTS%

IF 服装 == "服"
	TRYCCALLFORM EagloV_特殊服装%Version%_{NO:VIS_C}(VIS_C, TARGET_CHARA)
	IF RESULT
		特服 = %RESULTS%
	ENDIF
	CATCH
	ENDCATCH
ELSEIF 服装 == "内衣" || 服装 == "胸罩" || 服装 == "胖次"
	TRYCCALLFORM EagloV_特殊内衣%Version%_{NO:VIS_C}(VIS_C, TARGET_CHARA)
	IF RESULT
		特服 = %RESULTS%
		特服种类 = RESULT
	ENDIF
	CATCH
	ENDCATCH
ENDIF

IF 表情:0 == ""
	CALL EagloV_表情判定(TARGET_CHARA, Version, VIS_C)
	表情:0 = %RESULTS:0%
	表情:1 = %RESULTS:1%
ENDIF

全图索引:0 = %EagloV_全图索引(Version, VIS_C, 妊肚, 乳量, 丁日, 服装, 特服, 表情:0)%
SIF !SPRITECREATED(全图索引:0)
	CALL EagloV2_BUILD_BASE_IMAGE(Version, VIS_C, 妊肚, 乳量, 丁日, 服装, 特服, 表情:0, 特服种类, TARGET_CHARA)

IF 表情:1 == ""
	全图索引:1 =
ELSE
	全图索引:1 = %EagloV_全图索引(Version, VIS_C, 妊肚, 乳量, 丁日, 服装, 特服, 表情:1)%
	SIF !SPRITECREATED(全图索引:1)
		CALL EagloV2_BUILD_BASE_IMAGE(Version, VIS_C, 妊肚, 乳量, 丁日, 服装, 特服, 表情:1, 特服种类, TARGET_CHARA)
ENDIF


IF 表示形式 != "立絵" && (FLAG:立絵種類 || 表示形式 == "顔絵")
	; 颜绘
	CALL EagloV_颜像生成(Version, VIS_C, 全图索引:0, 全图索引:1)
ELSE
	; 立绘
	RESULTS:0 = %全图索引:0%
	RESULTS:1 = %全图索引:1%
ENDIF

RETURN


@EagloV2_BUILD_BASE_IMAGE(Version, VIS_C, 妊肚, 乳量, 丁日, 服装, 特服, 表情, 特服种类, TARGET_CHARA = -1)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS DYNAMIC Version
#DIM G_ID
#DIM VIS_C
#DIM TARGET_CHARA
#DIMS 妊肚
#DIMS 乳量
#DIMS 丁日
#DIMS 服装
#DIMS 特服
#DIMS 表情
#DIM 特服种类
#DIMS 体图索引
#DIMS 表情索引
#DIMS 全图索引
#DIM 立绘尺寸,2

SIF TARGET_CHARA == -1
	TARGET_CHARA = VIS_C

体图索引 = %EagloV_体图索引(Version, VIS_C, 妊肚, 乳量, 丁日, 服装, 特服)%
表情索引 = %EagloV_表情索引(Version, VIS_C, 表情)%
全图索引 = %EagloV_全图索引(Version, VIS_C, 妊肚, 乳量, 丁日, 服装, 特服, 表情)%

IF !SPRITECREATED(体图索引)
	IF 服装 == "裸"
		CALL EagloV_BUILD_裸体差分(Version, VIS_C, 妊肚, 乳量, 丁日, 服装, 特服, TARGET_CHARA)
	ELSEIF 服装 == "服"
		CALL EagloV_BUILD_服体差分(Version, VIS_C, 妊肚, 乳量, 丁日, 服装, 特服, TARGET_CHARA)
	ELSEIF 服装 == "内衣" || 服装 == "胸罩" || 服装 == "胖次"
		CALL EagloV2_BUILD_下着体差分(Version, VIS_C, 妊肚, 乳量, 丁日, 服装, 特服, 特服种类, TARGET_CHARA)
	ENDIF
ENDIF

IF !SPRITECREATED(表情索引)
	CALL EagloV_BUILD_表情差分(Version, VIS_C, 表情)
ENDIF

IF SPRITECREATED(@"%Version%EagloV{NO:VIS_C}_立绘尺寸")
	立绘尺寸:0 = SPRITEWIDTH(@"%Version%EagloV{NO:VIS_C}_立绘尺寸")
	立绘尺寸:1 = SPRITEHEIGHT(@"%Version%EagloV{NO:VIS_C}_立绘尺寸")
ELSE
	立绘尺寸:0 = 300
	立绘尺寸:1 = 300
ENDIF

G_ID = 0
CALL 画像合成(G_ID, "ダミー", 0, 0, 立绘尺寸:0, 立绘尺寸:1)
CALL 画像合成(G_ID, 体图索引)
CALL 画像合成(G_ID, 表情索引)

SPRITECREATE 全图索引, G_ID
RETURN


@EagloV2_BUILD_下着体差分(Version, VIS_C, 妊肚, 乳量, 丁日, 服装, 特服, 特服种类, TARGET_CHARA = -1)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS DYNAMIC Version
#DIM G_ID
#DIM VIS_C
#DIM TARGET_CHARA
#DIMS 妊肚
#DIMS 乳量
#DIMS 丁日
#DIMS 服装
#DIMS 特服
#DIM 特服种类
#DIMS 体图索引
#DIMS 内衣差分暂存,2	; 0是胖次，1是胸罩
#DIM 立绘尺寸,2

SIF TARGET_CHARA == -1
	TARGET_CHARA = VIS_C

体图索引 = %EagloV_体图索引(Version, VIS_C, 妊肚, 乳量, 丁日, 服装, 特服)%
SIF SPRITECREATED(体图索引)
	RETURN

IF SPRITECREATED(@"%Version%EagloV{NO:VIS_C}_立绘尺寸")
	立绘尺寸:0 = SPRITEWIDTH(@"%Version%EagloV{NO:VIS_C}_立绘尺寸")
	立绘尺寸:1 = SPRITEHEIGHT(@"%Version%EagloV{NO:VIS_C}_立绘尺寸")
ELSE
	立绘尺寸:0 = 300
	立绘尺寸:1 = 300
ENDIF

G_ID = 0
CALL 画像合成(G_ID, "ダミー", 0, 0, 立绘尺寸:0, 立绘尺寸:1)

; 内衣差分，由于有些特殊内衣不支持膨腹状态，故优先判定
CALL EagloV_GET_下着差分(Version, VIS_C, 妊肚, 乳量, 丁日, 服装, 特服, 特服种类)
内衣差分暂存:0 = %RESULTS:0%
内衣差分暂存:1 = %RESULTS:1%

; 躯干差分
CALL EagloV_GET_裸躯差分(Version, VIS_C, 妊肚)
SIF RESULT
	CALL 画像合成(G_ID, RESULTS)

; 腹部差分
CALL EagloV_GET_裸腹差分(Version, VIS_C, 妊肚, 乳量)
SIF RESULT
	CALL 画像合成(G_ID, RESULTS)

; 内衣差分
SIF 内衣差分暂存:0 != ""
	CALL 画像合成(G_ID, 内衣差分暂存:0)
IF 内衣差分暂存:1 != ""
	CALL 画像合成(G_ID, 内衣差分暂存:1)
ELSEIF NUDITYCHECK(TARGET_CHARA) == 3 && EQUIP:TARGET_CHARA:0 ;不露
ELSE
	CALL EagloV_GET_裸胸差分(Version, VIS_C, 乳量)
	SIF RESULT
		CALL 画像合成(G_ID, RESULTS)
ENDIF

; 丁日差分
CALL EagloV_GET_丁日差分(Version, VIS_C, 丁日, TARGET_CHARA)
SIF RESULT
	CALL 画像合成(G_ID, RESULTS)

; 裸躯特效差分
TRYCALLFORM EagloV_裸躯特效%Version%_{NO:VIS_C}(VIS_C, TARGET_CHARA)
DEBUGPRINTFORML %RESULTS% IS {RESULT}
IF RESULT
	CALL 画像合成(G_ID, RESULTS)
ENDIF
; 合成体图
SPRITECREATE 体图索引, G_ID
RETURN


@EagloV2_GET_EFFECT_RESOURCE(VIS_C, エフェクト = "", TARGET_CHARA = -1)
#LOCALSIZE 1
