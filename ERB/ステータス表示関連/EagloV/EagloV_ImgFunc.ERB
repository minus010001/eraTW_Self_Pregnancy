
; GET_BASE_RESOURCE{
;函数被单独调用时，表情可能是 "自慰" "通常"，服装可能是 "服" "裸"。
@EagloV_GET_BASE_RESOURCE(VIS_C, 表示形式 = "", 服装 = "", 表情:0 = "", 表情:1 = "", 特服 = "", 乳量 = "", TARGET_CHARA = -1)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM VIS_C
#DIM TARGET_CHARA
#DIMS 表示形式
#DIMS 妊肚
#DIMS 乳量
#DIMS 丁日
#DIMS 服装
#DIMS 特服
#DIM 特服种类		; 0:无，1:胸罩胖次，2:连体内衣
#DIMS 表情, 2
#DIMS 全图索引, 2
#DIMS DYNAMIC Version

SIF TARGET_CHARA == -1
	TARGET_CHARA = VIS_C

;EagloV_{妊肚}_{乳量}_{丁日}_{服装}_{表情}_{NO:VIS_C}

;初步判定
SIF 服装 == ""
	服装 = %EagloV_服装初步判定(TARGET_CHARA)%
妊肚 = %EagloV_妊肚判定(TARGET_CHARA)%
乳量 = %EagloV_乳量判定(TARGET_CHARA)%
丁日 = %EagloV_丁日判定(TARGET_CHARA, 服装)%
特服 = 

Version = 
RESULT = 0
TRYCALLFORM EagloV_Version{NO:VIS_C}
SIF RESULT
	Version = %RESULTS%

IF 服装 == "服"
	TRYCCALLFORM EagloV_特殊服装%Version%_{NO:VIS_C}(VIS_C, TARGET_CHARA)
	IF RESULT
		特服 = %RESULTS%
	ENDIF
	CATCH
	ENDCATCH
ELSEIF 服装 == "内衣" || 服装 == "胸罩" || 服装 == "胖次"
	TRYCCALLFORM EagloV_特殊内衣%Version%_{NO:VIS_C}(VIS_C, TARGET_CHARA)
	IF RESULT
		特服 = %RESULTS%
		特服种类 = RESULT
		DEBUGPRINTFORML 特服 = %RESULTS% 特服种类 = {RESULT}
	ENDIF
	CATCH
	ENDCATCH
; FIX: 当传入非标准服装参数时，将其作为特服处理并回退到默认服装，避免无躯体问题
ELSEIF 服装 != "裸"
	特服 '= 服装
	服装 = %EagloV_服装初步判定(TARGET_CHARA)%
ENDIF

IF 表情:0 == ""
	CALL EagloV_表情判定(TARGET_CHARA, Version, VIS_C)
	表情:0 = %RESULTS:0%
	表情:1 = %RESULTS:1%
ENDIF

全图索引:0 = %EagloV_全图索引(Version, VIS_C, 妊肚, 乳量, 丁日, 服装, 特服, 表情:0)%
DEBUGPRINTFORML %全图索引% IS {SPRITECREATED(全图索引)}
SIF !SPRITECREATED(全图索引:0)
	CALL EagloV_BUILD_BASE_IMAGE(Version, VIS_C, 妊肚, 乳量, 丁日, 服装, 特服, 表情:0, 特服种类, TARGET_CHARA)

IF 表情:1 == ""
	全图索引:1 =
ELSE
	全图索引:1 = %EagloV_全图索引(Version, VIS_C, 妊肚, 乳量, 丁日, 服装, 特服, 表情:1)%
	SIF !SPRITECREATED(全图索引:1)
		CALL EagloV_BUILD_BASE_IMAGE(Version, VIS_C, 妊肚, 乳量, 丁日, 服装, 特服, 表情:1, 特服种类, TARGET_CHARA)
ENDIF


IF 表示形式 != "立絵" && (FLAG:立絵種類 || 表示形式 == "顔絵")
	; 颜绘
	CALL EagloV_颜像生成(Version, VIS_C, 全图索引:0, 全图索引:1)
ELSE
	; 立绘
	RESULTS:0 = %全图索引:0%
	RESULTS:1 = %全图索引:1%
ENDIF

RETURN
;}


; 立像生成{
@EagloV_BUILD_BASE_IMAGE(Version, VIS_C, 妊肚, 乳量, 丁日, 服装, 特服, 表情, 特服种类, TARGET_CHARA = -1)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS DYNAMIC Version
#DIM G_ID
#DIM VIS_C
#DIM TARGET_CHARA
#DIMS 妊肚
#DIMS 乳量
#DIMS 丁日
#DIMS 服装
#DIMS 特服
#DIMS 表情
#DIM 特服种类
#DIMS 体图索引
#DIMS 表情索引
#DIMS 全图索引
#DIM 立绘尺寸,2

SIF TARGET_CHARA == -1
	TARGET_CHARA = VIS_C

体图索引 = %EagloV_体图索引(Version, VIS_C, 妊肚, 乳量, 丁日, 服装, 特服)%
表情索引 = %EagloV_表情索引(Version, VIS_C, 表情)%
全图索引 = %EagloV_全图索引(Version, VIS_C, 妊肚, 乳量, 丁日, 服装, 特服, 表情)%
DEBUGPRINTFORML %体图索引% IS {SPRITECREATED(体图索引)}

IF !SPRITECREATED(体图索引)
	IF 服装 == "裸"
		CALL EagloV_BUILD_裸体差分(Version, VIS_C, 妊肚, 乳量, 丁日, 服装, 特服, TARGET_CHARA)
	ELSEIF 服装 == "服"
		CALL EagloV_BUILD_服体差分(Version, VIS_C, 妊肚, 乳量, 丁日, 服装, 特服, TARGET_CHARA)
	ELSEIF 服装 == "内衣" || 服装 == "胸罩" || 服装 == "胖次"
		CALL EagloV_BUILD_下着体差分(Version, VIS_C, 妊肚, 乳量, 丁日, 服装, 特服, 特服种类, TARGET_CHARA)
	ENDIF
ENDIF

DEBUGPRINTFORML %表情索引% IS {SPRITECREATED(表情索引)}
IF !SPRITECREATED(表情索引)
	CALL EagloV_BUILD_表情差分(Version, VIS_C, 表情)
ENDIF

IF SPRITECREATED(@"%Version%EagloV{NO:VIS_C}_立绘尺寸")
	立绘尺寸:0 = SPRITEWIDTH(@"%Version%EagloV{NO:VIS_C}_立绘尺寸")
	立绘尺寸:1 = SPRITEHEIGHT(@"%Version%EagloV{NO:VIS_C}_立绘尺寸")
ELSE
	立绘尺寸:0 = 300
	立绘尺寸:1 = 300
ENDIF

IF STRCOUNT(表情,"覆盖")
	G_ID = 0
	CALL 画像合成(G_ID, "ダミー", 0, 0, 立绘尺寸:0, 立绘尺寸:1)
	CALL 画像合成(G_ID, 表情索引)
ELSE
	G_ID = 0
	CALL 画像合成(G_ID, "ダミー", 0, 0, 立绘尺寸:0, 立绘尺寸:1)
	CALL 画像合成(G_ID, 体图索引)
	CALL 画像合成(G_ID, 表情索引)
ENDIF
SPRITECREATE 全图索引, G_ID
RETURN
;}

; 颜像生成{

@EagloV_颜像生成(Version, VIS_C, 全图索引:0, 全图索引:1)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS DYNAMIC Version
#DIM VIS_C
#DIMS 全图索引, 2
#DIMS 颜像索引, 2

颜像索引:0 = %EagloV_颜像索引(全图索引:0)%
SIF !SPRITECREATED(颜像索引:0)
	CALL EagloV_颜像切分(Version, VIS_C, 全图索引:0)

IF 全图索引:1 == ""
	颜像索引:1 = 
ELSE
	颜像索引:1 = %EagloV_颜像索引(全图索引:1)%
	SIF !SPRITECREATED(颜像索引:1)
		CALL EagloV_颜像切分(Version, VIS_C, 全图索引:1)
ENDIF

RESULTS:0 = %颜像索引:0%
RESULTS:1 = %颜像索引:1%
RETURN


@EagloV_颜像切分(Version, VIS_C, 全图索引)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS DYNAMIC Version
#DIM G_ID
#DIM VIS_C
#DIMS 全图索引
#DIMS 颜像索引
#DIM 颜RECT,4
#DIM 立绘尺寸,2

IF STRCOUNT(全图索引,"覆盖")
	IF SPRITECREATED(@"%Version%EagloV{NO:VIS_C}_覆盖范围")
		颜RECT:0 = SPRITEPOSX(@"%Version%EagloV{NO:VIS_C}_覆盖范围")
		颜RECT:1 = SPRITEPOSY(@"%Version%EagloV{NO:VIS_C}_覆盖范围")
		颜RECT:2 = SPRITEWIDTH(@"%Version%EagloV{NO:VIS_C}_覆盖范围")
		颜RECT:3 = SPRITEHEIGHT(@"%Version%EagloV{NO:VIS_C}_覆盖范围")
	ELSE
		颜RECT:0 = 0
		颜RECT:1 = 0
		IF SPRITECREATED(@"%Version%EagloV{NO:VIS_C}_立绘尺寸")
			颜RECT:2 = SPRITEWIDTH(@"%Version%EagloV{NO:VIS_C}_立绘尺寸")
			颜RECT:3 = SPRITEHEIGHT(@"%Version%EagloV{NO:VIS_C}_立绘尺寸")
		ELSE
			颜RECT:2 = 300
			颜RECT:3 = 300
		ENDIF
	ENDIF
ELSEIF SPRITECREATED(@"%Version%EagloV{NO:VIS_C}_颜像范围")
	颜RECT:0 = SPRITEPOSX(@"%Version%EagloV{NO:VIS_C}_颜像范围")
	颜RECT:1 = SPRITEPOSY(@"%Version%EagloV{NO:VIS_C}_颜像范围")
	颜RECT:2 = SPRITEWIDTH(@"%Version%EagloV{NO:VIS_C}_颜像范围")
	颜RECT:3 = SPRITEHEIGHT(@"%Version%EagloV{NO:VIS_C}_颜像范围")
ELSE
	颜RECT:0 = -60
	颜RECT:1 = 0
	颜RECT:2 = 180
	颜RECT:3 = 180
ENDIF

IF SPRITECREATED(@"%Version%EagloV{NO:VIS_C}_立绘尺寸")
	立绘尺寸:0 = SPRITEWIDTH(@"%Version%EagloV{NO:VIS_C}_立绘尺寸")
	立绘尺寸:1 = SPRITEHEIGHT(@"%Version%EagloV{NO:VIS_C}_立绘尺寸")
ELSE
	立绘尺寸:0 = 300
	立绘尺寸:1 = 300
ENDIF

颜像索引 = %EagloV_颜像索引(全图索引)%

G_ID = 0
CALL 画像合成(G_ID, "ダミー", 0, 0, 颜RECT:2, 颜RECT:3)
CALL 画像合成(G_ID, 全图索引, 颜RECT:0, 颜RECT:1, 立绘尺寸:0, 立绘尺寸:1)

SPRITECREATE 颜像索引, G_ID

RETURN
;}


; 体型判定{
@EagloV_服装初步判定(ARG)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTIONS
LOCAL = NUDITYCHECK(ARG)
IF LOCAL == 0
	RETURNF "裸" 
ELSEIF LOCAL == 1
	RETURNF "胖次"
ELSEIF LOCAL == 2
	RETURNF "胸罩"
ELSEIF LOCAL == 3 ;&& GROUPMATCH(CFLAG:ARG:衣装一時変更,0,100)
	RETURNF "内衣"
ELSE
	RETURNF "服"
ENDIF

@EagloV_乳量判定(ARG)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTIONS
#DIMS CONST 乳型 = "绝壁", "贫乳", "普乳", "巨乳", "爆乳"
RETURNF 乳型:(TALENT:ARG:胸围+2)

@EagloV_妊肚判定(ARG)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTIONS
SIF CFLAG:ARG:妊娠経過日数 >= 40
	RETURNF "妊肚"
SIF 充填率(ARG,3) >= 70
	RETURNF "膨腹"
RETURNF ""

@EagloV_丁日判定(ARG, 服装)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTIONS 
#DIMS 服装
IF TALENT:ARG:性別 == 3 && (服装 == "裸" || 服装 == "胸罩")
	SELECTCASE TALENT:ARG:形状
		CASE 10
			RETURNF "驴屌"
		CASE 6
			RETURNF "巨屌"
		CASEELSE
			RETURNF "丁日"
	ENDSELECT
ENDIF
RETURNF ""

;}

; 表情判定{
@EagloV_表情判定(TARGET_CHARA, Version, VIS_C = -1, ARG:1)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS DYNAMIC Version
#DIM TARGET_CHARA
#DIM VIS_C
#DIM DYNAMIC 曾無自覚絶頂数,300

SIF VIS_C == -1
	VIS_C = TARGET_CHARA
RESULTS:0 = 
RESULTS:1 = 

LOCAL = 曾無自覚絶頂数:TARGET_CHARA
曾無自覚絶頂数:TARGET_CHARA = EX:TARGET_CHARA:無自覚Ｃ絶頂 + EX:TARGET_CHARA:無自覚Ｖ絶頂 + EX:TARGET_CHARA:無自覚Ａ絶頂 + EX:TARGET_CHARA:無自覚Ｂ絶頂 + EX:TARGET_CHARA:無自覚Ｍ絶頂

IF !FLAG:時間停止 && 曾無自覚絶頂数:TARGET_CHARA == 0 && LOCAL > 30
	RESULTS:0 = 时停解除绝顶
ELSEIF FLAG:時間停止
	IF EX:TARGET_CHARA:無自覚Ｃ絶頂 + EX:TARGET_CHARA:無自覚Ｖ絶頂 + EX:TARGET_CHARA:無自覚Ａ絶頂 + EX:TARGET_CHARA:無自覚Ｂ絶頂 + EX:TARGET_CHARA:無自覚Ｍ絶頂 > 30
		RESULTS:0 = 时停绝顶
	ELSEIF CFLAG:TARGET_CHARA:睡眠
		RESULTS:0 = 睡眠
	ELSE
		RESULTS:0 = 时停
	ENDIF
ELSEIF CFLAG:TARGET_CHARA:睡眠
	IF NOWEX:TARGET_CHARA:TotalEX >= 5
		RESULTS:0 = 睡眠绝顶
	ELSEIF NOWEX:TARGET_CHARA:TotalEX
		RESULTS:0 = 睡眠快感
		RESULTS:1 = 睡眠快感1
	ELSEIF TCVAR:TARGET_CHARA:睡眠深度 <= 1500 - (TCVAR:TARGET_CHARA:睡眠薬強度 * 500)
		RESULTS:0 = 睡眠察觉
		RESULTS:1 = 睡眠察觉1
	ELSE
		RESULTS:0 = 睡眠
	ENDIF
ELSEIF CFLAG:TARGET_CHARA:ブチギレ
	IF NOWEX:TARGET_CHARA:TotalEX
		RESULTS:0 = 不悦绝顶
	ELSE
		RESULTS:0 = 愤怒
		RESULTS:1 = 愤怒1
	ENDIF
ELSEIF TCVAR:TARGET_CHARA:烂醉
	IF NOWEX:TARGET_CHARA:TotalEX >= 5
		RESULTS:0 = 醉酒绝顶
	ELSEIF NOWEX:TARGET_CHARA:TotalEX
		RESULTS:0 = 醉酒快感
		RESULTS:1 = 醉酒快感1
	ELSE
		RESULTS:0 = 醉酒
		RESULTS:1 = 醉酒1
	ENDIF
ELSEIF MARK:TARGET_CHARA:反発刻印
	IF NOWEX:TARGET_CHARA:TotalEX
		RESULTS:0 = 不悦绝顶
	ELSE
		RESULTS:0 = 不悦
		RESULTS:1 = 不悦1
	ENDIF
ELSEIF !CFLAG:TARGET_CHARA:诶嘿嘿 && NOWEX:TARGET_CHARA:TotalEX
	RESULTS:0 = 通常绝顶
	SIF NOWEX:TARGET_CHARA:TotalEX < 2
		RESULTS:1 = 通常绝顶1
ELSEIF BASE:TARGET_CHARA:憤怒 >= 900 || TALENT:TARGET_CHARA:心情 < 0 || CFLAG:TARGET_CHARA:心情不快 > 0
	RESULTS:0 = 坏心情
	RESULTS:1 = 坏心情1
ELSEIF !CFLAG:TARGET_CHARA:诶嘿嘿 && EagloV_発情判定(TARGET_CHARA)
	RESULTS:0 = 発情
	SIF TARGET_CHARA == TARGET && ((CFLAG:TARGET_CHARA:既成事実 & 合意_诶嘿嘿) || TALENT:TARGET_CHARA:思慕 || TALENT:TARGET_CHARA:炮友)
		RESULTS:1 = 発情1
ELSEIF CFLAG:TARGET_CHARA:诶嘿嘿
	IF NOWEX:TARGET_CHARA:TotalEX >= 5
		RESULTS:0 = 性爱绝顶
		RESULTS:1 = 通常绝顶1
	ELSEIF NOWEX:TARGET_CHARA:TotalEX
		RESULTS:0 = 性爱快感
		RESULTS:1 = 性爱快感1
	ELSE
		RESULTS:0 = 性爱
		SIF GETPALAMLV(PALAM:TARGET_CHARA:欲情,5) > 4
			RESULTS:1 = 性爱1
	ENDIF
ELSEIF !NOWEX:TARGET_CHARA:TotalEX && EX:TARGET_CHARA:Ｃ絶頂 + EX:TARGET_CHARA:Ｖ絶頂 + EX:TARGET_CHARA:Ａ絶頂 + EX:TARGET_CHARA:Ｂ絶頂 + EX:TARGET_CHARA:Ｍ絶頂 > 30
	RESULTS:0 = 疲惫
	RESULTS:1 = 疲惫1
ELSEIF !NOWEX:TARGET_CHARA:TotalEX && TALENT:TARGET_CHARA:心情 > 0
	RESULTS:0 = 好心情
	RESULTS:1 = 好心情1
ELSEIF NOWEX:TARGET_CHARA:TotalEX
	RESULTS:0 = 通常绝顶
	SIF NOWEX:TARGET_CHARA:TotalEX < 2
		RESULTS:1 = 通常绝顶1
ELSEIF TALENT:TARGET_CHARA:恋慕 || TALENT:TARGET_CHARA:愛欲
	RESULTS:0 = 通常喜爱
	SIF TALENT:TARGET_CHARA:恋人 || BASE:TARGET_CHARA:情緒 >= 300
		RESULTS:1 = 通常喜爱1
ELSEIF TALENT:TARGET_CHARA:思慕 || TALENT:TARGET_CHARA:炮友
	RESULTS:0 = 通常熟识
	SIF BASE:TARGET_CHARA:情緒 >= 600
		RESULTS:1 = 通常熟识1
ELSE
	RESULTS:0 = 通常
	SIF BASE:TARGET_CHARA:情緒 >= 600
		RESULTS:1 = 通常1
ENDIF

SIF !ARG:1
	TRYCALLFORM EagloV_特殊表情%Version%_{NO:VIS_C}(VIS_C, TARGET_CHARA)


@EagloV_発情判定(ARG)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTION
RETURNF CFLAG:ARG:积攒度 > 600 && (TCVAR:ARG:発情 || TCVAR:ARG:媚薬)

@EagloV_心眼判定(ARG)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTION
RETURNF EagloV_発情判定(ARG) || ((GETPALAMLV(PALAM:ARG:欲情, 5) >= 4 && (CFLAG:ARG:积攒度 + (TCVAR:ARG:発情 + TCVAR:ARG:媚薬) * 100 > 700)))
;}


