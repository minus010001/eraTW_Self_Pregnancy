; 体图差分{
@EagloV_BUILD_裸体差分(Version, VIS_C, 妊肚, 乳量, 丁日, 服装, 特服, TARGET_CHARA = -1)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS DYNAMIC Version
#DIM G_ID
#DIM VIS_C
#DIM TARGET_CHARA
#DIMS 妊肚
#DIMS 乳量
#DIMS 丁日
#DIMS 服装
#DIMS 特服
#DIMS 体图索引
#DIM 立绘尺寸,2

SIF TARGET_CHARA == -1
	TARGET_CHARA = VIS_C

体图索引 = %EagloV_体图索引(Version, VIS_C, 妊肚, 乳量, 丁日, 服装, 特服)%
DEBUGPRINTFORML %体图索引% IS {SPRITECREATED(体图索引)}
SIF SPRITECREATED(体图索引)
	RETURN

IF SPRITECREATED(@"%Version%EagloV{NO:VIS_C}_立绘尺寸")
	立绘尺寸:0 = SPRITEWIDTH(@"%Version%EagloV{NO:VIS_C}_立绘尺寸")
	立绘尺寸:1 = SPRITEHEIGHT(@"%Version%EagloV{NO:VIS_C}_立绘尺寸")
ELSE
	立绘尺寸:0 = 300
	立绘尺寸:1 = 300
ENDIF

G_ID = 0
CALL 画像合成(G_ID, "ダミー", 0, 0, 立绘尺寸:0, 立绘尺寸:1)

; 躯干差分
CALL EagloV_GET_裸躯差分(Version, VIS_C, 妊肚)
SIF RESULT
	CALL 画像合成(G_ID, RESULTS)

; 胸部差分
CALL EagloV_GET_裸胸差分(Version, VIS_C, 乳量)
SIF RESULT
	CALL 画像合成(G_ID, RESULTS)

; 腹部差分
CALL EagloV_GET_裸腹差分(Version, VIS_C, 妊肚, 乳量)
SIF RESULT
	CALL 画像合成(G_ID, RESULTS)

; 丁日差分
CALL EagloV_GET_丁日差分(Version, VIS_C, 丁日, TARGET_CHARA)
SIF RESULT
	CALL 画像合成(G_ID, RESULTS)

; 裸躯特效差分
TRYCALLFORM EagloV_裸躯特效%Version%_{NO:VIS_C}(VIS_C, TARGET_CHARA)
DEBUGPRINTFORML %RESULTS% IS {RESULT}
IF RESULT
	CALL 画像合成(G_ID, RESULTS)
ENDIF

; 合成体图
SPRITECREATE 体图索引, G_ID
RETURN


@EagloV_BUILD_下着体差分(Version, VIS_C, 妊肚, 乳量, 丁日, 服装, 特服, 特服种类, TARGET_CHARA = -1)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS DYNAMIC Version
#DIM G_ID
#DIM VIS_C
#DIM TARGET_CHARA
#DIMS 妊肚
#DIMS 乳量
#DIMS 丁日
#DIMS 服装
#DIMS 特服
#DIM 特服种类
#DIMS 体图索引
#DIMS 内衣差分暂存,2	; 0是胖次，1是胸罩
#DIM 立绘尺寸,2

SIF TARGET_CHARA == -1
	TARGET_CHARA = VIS_C

体图索引 = %EagloV_体图索引(Version, VIS_C, 妊肚, 乳量, 丁日, 服装, 特服)%
;PRINTFORML %体图索引% 为 {SPRITECREATED(体图索引)}
SIF SPRITECREATED(体图索引)
	RETURN

IF SPRITECREATED(@"%Version%EagloV{NO:VIS_C}_立绘尺寸")
	立绘尺寸:0 = SPRITEWIDTH(@"%Version%EagloV{NO:VIS_C}_立绘尺寸")
	立绘尺寸:1 = SPRITEHEIGHT(@"%Version%EagloV{NO:VIS_C}_立绘尺寸")
ELSE
	立绘尺寸:0 = 300
	立绘尺寸:1 = 300
ENDIF

G_ID = 0
CALL 画像合成(G_ID, "ダミー", 0, 0, 立绘尺寸:0, 立绘尺寸:1)

; 内衣差分，由于有些特殊内衣不支持膨腹状态，故优先判定
CALL EagloV_GET_下着差分(Version, VIS_C, 妊肚, 乳量, 丁日, 服装, 特服, 特服种类)
内衣差分暂存:0 = %RESULTS:0%
内衣差分暂存:1 = %RESULTS:1%

; 躯干差分
CALL EagloV_GET_裸躯差分(Version, VIS_C, 妊肚)
SIF RESULT
	CALL 画像合成(G_ID, RESULTS)

; 胸部差分
CALL EagloV_GET_裸胸差分(Version, VIS_C, 乳量)
SIF RESULT
	CALL 画像合成(G_ID, RESULTS)

; 腹部差分
CALL EagloV_GET_裸腹差分(Version, VIS_C, 妊肚, 乳量)
SIF RESULT
	CALL 画像合成(G_ID, RESULTS)

; 裸躯特效差分
TRYCALLFORM EagloV_裸躯特效%Version%_{NO:VIS_C}(VIS_C, TARGET_CHARA)
DEBUGPRINTFORML %RESULTS% IS {RESULT}
IF RESULT
	CALL 画像合成(G_ID, RESULTS)
ENDIF

; 内衣差分
SIF 内衣差分暂存:0 != ""
	CALL 画像合成(G_ID, 内衣差分暂存:0)
SIF 内衣差分暂存:1 != ""
	CALL 画像合成(G_ID, 内衣差分暂存:1)

; 丁日差分
CALL EagloV_GET_丁日差分(Version, VIS_C, 丁日, TARGET_CHARA)
SIF RESULT
	CALL 画像合成(G_ID, RESULTS)
	

; 合成体图
SPRITECREATE 体图索引, G_ID
RETURN


