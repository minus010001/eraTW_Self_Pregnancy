@EagloV_气泡判定(ARG)
#LOCALSIZE 2
#LOCALSSIZE 2
#DIMS DYNAMIC 气泡名 = "", "睡眠", "醉酒", "欲求", "不悦", "疑惑", "沉默", "愉悦", "羞涩", "绝顶", "悲伤", "惊讶", "流汗", "愤怒"
#DIM DYNAMIC 气泡概率, 14
VARSET 气泡概率
IF TCVAR:ARG:心情气泡
	RESULTS = %气泡名:(TCVAR:ARG:心情气泡)%
	RETURN
ENDIF
; 无气泡
气泡概率:0 = 10

;睡眠
SIF CFLAG:ARG:睡眠
	气泡概率:1 = 5 + TCVAR:ARG:睡眠深度/400

;醉酒
SIF BASE:ARG:酒気 > MAXBASE:ARG:酒気 / 4
	气泡概率:2 = 20 * BASE:ARG:酒気 / MAXBASE:ARG:酒気

;欲求
SIF (CFLAG:ARG:既成事実 & 合意_诶嘿嘿) && CFLAG:ARG:积攒度 > 600
	气泡概率:3 += CFLAG:ARG:积攒度/100 - 5 + TCVAR:ARG:発情 * 5

;不悦
SIF GETPALAMLV(PALAM:ARG:抑鬱,5) + GETPALAMLV(PALAM:ARG:反感,5) > 2
	气泡概率:4 = GETPALAMLV(PALAM:ARG:抑鬱,5)*3 + GETPALAMLV(PALAM:ARG:反感,5)*2

;疑惑
SIF TCVAR:ARG:烂醉 && CFLAG:ARG:诶嘿嘿
	气泡概率:5 = 15

;愉悦
SIF GETPALAMLV(PALAM:ARG:好意,10) + BASE:ARG:情緒/200 > 10
	气泡概率:7 = GETPALAMLV(PALAM:ARG:好意,10) + BASE:ARG:情緒/200 -5

;羞涩
SIF GETPALAMLV(PALAM:ARG:恥情,5) > 2
	气泡概率:8 = GETPALAMLV(PALAM:ARG:恥情,10) * 3

;绝顶
SIF NOWEX:ARG:TotalEX > 2
	气泡概率:9 = NOWEX:ARG:TotalEX * 10

;悲伤
SIF TALENT:ARG:心情 < 0 || CFLAG:ARG:心情不快 > 0
	气泡概率:10 = MAX(0, CFLAG:ARG:心情不快 - TALENT:ARG:心情) * 3

;惊讶
气泡概率:11 = NOWEX:ARG:TotalEX * 2 + CUP:ARG:苦痛/100

;流汗
SIF EagloV_GET_指令失败判定(ARG)
	气泡概率:12 = 5

;愤怒
气泡概率:13 = MAX(BASE:ARG:憤怒/100 - TALENT:ARG:恋慕 * 2 - TALENT:ARG:思慕,0)

;沉默
SIF SUMARRAY(气泡概率) < 15
	气泡概率:6 = 5 - MAX(0, GETPALAMLV(PALAM:ARG:好意,10) -5)


; 诶嘿嘿时，只有反感lv1以上才会有负面气泡
IF CFLAG:ARG:诶嘿嘿 && PALAM:ARG:反感 < PALAMLV:2
	气泡概率:6 = 0		;沉默
	气泡概率:5 = 0		;疑惑
	气泡概率:4 = 0		;不悦
	气泡概率:13 = 0		;愤怒
ENDIF

; 发怒后，只会有负面气泡
IF CFLAG:ARG:ブチギレ
	VARSET 气泡概率
	气泡概率:6 = 1		;沉默
	气泡概率:5 = 2		;疑惑
	气泡概率:4 = 5		;不悦
	气泡概率:13 = 15	;愤怒
ENDIF

; 随机选出气泡
RESULTS = 
LOCAL:1 = SUMARRAY(气泡概率)
LOCAL:1 = RAND:(LOCAL:1)
FOR LOCAL, 0, 14
	LOCAL:1 -= 气泡概率:LOCAL
	IF LOCAL:1 < 0
		TCVAR:ARG:心情气泡 = LOCAL
		RESULTS = %气泡名:LOCAL%
		BREAK
	ENDIF
NEXT
;}

