@MAKE_TALENT_MAP
;used to legitimately categorize talents, make look ups a little faster and have custom sorting regardless of variable number
;honestly using MAP for this is kind of dogshit but whatever, is XML better?
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM INDEX
#DIM INDEX_CATEGORY
#DIMS TALENT_NAME

MAP_RELEASE "REGISTERED_TALENT_MAP"
FOR INDEX, 1, VARSIZE("TALENT_CATEGORY_LIST")
	MAP_RELEASE @"TALENT_%TALENT_CATEGORY_LIST:INDEX%_MAP"
NEXT

IF !MAP_EXIST("REGISTERED_TALENT_MAP")
	MAP_CREATE "REGISTERED_TALENT_MAP"
	FOR INDEX, 1, VARSIZE("TALENT_CATEGORY_LIST")
		MAP_CREATE @"TALENT_%TALENT_CATEGORY_LIST:INDEX%_MAP"
	NEXT
	DEBUGPRINTFORML ------------------------------
	FOR INDEX_CATEGORY, 1, VARSIZE("TALENT_CATEGORY_LIST") - 1
		FOR INDEX, 1, VARSIZE(@"TALENT_%TALENT_CATEGORY_LIST:INDEX_CATEGORY%")
			TALENT_NAME '= GETVARS(@"TALENT_%TALENT_CATEGORY_LIST:INDEX_CATEGORY%:INDEX")
			MAP_SET @"TALENT_%TALENT_CATEGORY_LIST:INDEX_CATEGORY%_MAP", TOSTR(INDEX), TOSTR(GETNUM(TALENT, TALENT_NAME))
			MAP_SET "REGISTERED_TALENT_MAP", TOSTR(GETNUM(TALENT, TALENT_NAME)), TALENT_NAME
			DEBUGPRINTFORML {MAP_SIZE("REGISTERED_TALENT_MAP"), 3, LEFT}: TALENT_%TALENT_CATEGORY_LIST:INDEX_CATEGORY%_MAP, {INDEX}, %MAP_GET(@"TALENT_%TALENT_CATEGORY_LIST:INDEX_CATEGORY%_MAP", TOSTR(INDEX))%
		NEXT
	NEXT
	FOR INDEX, 0, VARSIZE("TALENT")
		SIF MAP_HAS("REGISTERED_TALENT_MAP", TOSTR(INDEX))
			CONTINUE
		TALENT_NAME '= TALENTNAME:INDEX
		SIF TALENT_NAME == ""
			CONTINUE
		;if talent is not already categorized, put it in OTHER
		LOCAL++
		MAP_SET "TALENT_OTHER_MAP", TOSTR(LOCAL), TOSTR(INDEX)
		MAP_SET "REGISTERED_TALENT_MAP", TOSTR(INDEX), TALENT_NAME
		DEBUGPRINTFORML {MAP_SIZE("REGISTERED_TALENT_MAP"), 3, LEFT}: TALENT_OTHER_MAP, {LOCAL}, %MAP_GET("TALENT_OTHER_MAP", TOSTR(LOCAL))%
	NEXT
	DEBUGPRINTFORML ------------------------------
	DEBUGPRINTFORML Talent map made
ENDIF

@MAKE_CUSTOM_TALENT_COLOR_MAP(C_ID)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM C_ID
MAP_RELEASE @"CUSTOM_COLOR_{C_ID}"
MAP_CREATE @"CUSTOM_COLOR_{C_ID}"
FOR LOCAL, 0, MAX_CUSTOM_TALENT
    SIF !CUSTOM_TALENT:C_ID:LOCAL
        CONTINUE
    MAP_SET @"CUSTOM_COLOR_{C_ID}", CUSTOM_TALENT_NAME:C_ID:LOCAL, TOSTR(CUSTOM_TALENT_COLOR:C_ID:LOCAL)
NEXT

;============================================
;Takes a character ID and a talent category, returns character's talent of that category in a string array
;Output might look like this:
;RESULTS = 人間＠外界人＠
;RESULTS = 伐採Lv4＠釣りLv1＠採集Lv1＠
;============================================
@GET_CHARA_TALENT_BY_CATEGORY(C_ID = -1, CATEGORY = "")
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTIONS
#DIM C_ID
#DIM INDEX
#DIMS CATEGORY
#DIMS DYNAMIC TALENT_NAME_ARRAY

SIF C_ID == -1
	RETURNF
SIF CATEGORY == ""
	THROW TALENT_GET_CHARA_TALENT_BY_CATEGORY: カテゴリーが指定されていません
SIF !MAP_EXIST(@"TALENT_%CATEGORY%_MAP")
	THROW TALENT_GET_CHARA_TALENT_BY_CATEGORY: 不明なカテゴリーが指定されました (CATEGORY: %CATEGORY%)
FOR INDEX, 1, MAP_SIZE(@"TALENT_%CATEGORY%_MAP")
	LOCAL = TOINT(MAP_GET(@"TALENT_%CATEGORY%_MAP", TOSTR(INDEX)))
	LOCALS '= GET_TALENTNAME(LOCAL, TALENT:C_ID:LOCAL)
	SIF LOCALS == ""
		CONTINUE
	TALENT_NAME_ARRAY '= TALENT_NAME_ARRAY + LOCALS + "＠"
NEXT

FOR INDEX, 0, MAX_CUSTOM_TALENT
	SIF !CUSTOM_TALENT:C_ID:INDEX
		CONTINUE
	IF (TALENT_CATEGORY_LIST:(CUSTOM_TALENT_TYPE:C_ID:INDEX) == CATEGORY) || (!INRANGE(CUSTOM_TALENT_TYPE:C_ID:INDEX, 1, 5) && CATEGORY == "OTHER")
		LOCALS '= CUSTOM_TALENT_NAME:C_ID:INDEX
		SIF LOCALS == ""
			CONTINUE
		TALENT_NAME_ARRAY '= TALENT_NAME_ARRAY + LOCALS + "＠"
	ENDIF
NEXT

RETURNF TALENT_NAME_ARRAY

@PRINT_STATE_TALENT(選択中キャラID, HIDE_HEADER = 0)
#LOCALSIZE 2
#DIM 選択中キャラID
#DIM INDEX
#DIM HIDE_HEADER
#DIM CAT
#DIM ENTRY
#DIMS 種族テキスト
#DIM CONST TALENT_LINE_WRAP_THRESHOLD = 60
CALL QOL_PRINT_STATE_TALENT(選択中キャラID)
RETURN
SIF !HIDE_HEADER
	CALL PRINTBUTTON_EX("素质",165,TFLAG:165, , , 1)

IF !TFLAG:165
	FOR CAT, 1, VARSIZE("TALENT_CATEGORY_LIST")
		LOCAL = 0
		ARRAYREMOVE LOCALS, 0, 100
		LOCALS '= GET_CHARA_TALENT_BY_CATEGORY(選択中キャラID, @"%TALENT_CATEGORY_LIST:CAT%")
		SPLIT LOCALS, "＠", LOCALS
		PRINTFORM %@"　%TALENT_CATEGORY_STRING_CN:CAT%:", 13%

		FOR ENTRY, 0, VARSIZE("LOCALS")
			SIF LOCALS:ENTRY == ""
				CONTINUE
			SELECTCASE TALENT_CATEGORY_STRING:CAT
				CASE "種族"
					種族テキスト += LOCALS:ENTRY
				CASE "性的特徴"
					SIF LOCALS:ENTRY == "童贞" && IS_FEMALE(選択中キャラID)
						CONTINUE

				CASE "身体的特徴"
					SIF (GROUPMATCH(LOCALS:ENTRY, "普乳", "绝壁", "纤臀") && IS_MALE(選択中キャラID))
						CONTINUE

				CASE "精神的特徴"

				CASE "技術的特徴"
					;掃除係は住んでる時だけ表示 ;;でもなぜ？
					;SIF LOCALS:ENTRY == "掃除係" && (CFLAG:選択中キャラID:初期位置 / 100) != MAIN_MAP
						;CONTINUE

				CASE "その他"

			ENDSELECT
			LOCAL += STRLENS(LOCALS:ENTRY)
			IF LOCAL > TALENT_LINE_WRAP_THRESHOLD
				PRINTL
				PRINTFORM %"",13%
				LOCAL = 0
			ENDIF
			;素質によっては色変え
			{
			IF GROUPMATCH(LOCALS:ENTRY, "无自觉非处女", "处女", "恋慕", "无接吻经验", "淫乱", "恋人", "自慰狂",
						"淫壶", "尻穴狂", "淫乳", "接吻魔", "子宫口性快感", "精爱味觉", "风骚"
						 ) || (LOCALS:ENTRY == "风俗娘" && IS_FEMALE(選択中キャラID))
				}
				SETCOLOR 255, 120, 200
				FONTBOLD
			ELSEIF GROUPMATCH(LOCALS:ENTRY, "思慕", "风俗娘")
				SETCOLOR C_PINK
			ENDIF
			;カスタム素質を表示
			IF MAP_HAS(@"CUSTOM_COLOR_{選択中キャラID}", LOCALS:ENTRY)
				LOCAL:1 = TOINT(MAP_GET(@"CUSTOM_COLOR_{選択中キャラID}", LOCALS:ENTRY))
				IF LOCAL:1 == 1
					SETCOLOR C_PINK
				ELSEIF LOCAL:1 == 2
					SETCOLOR 255, 120, 200
					FONTBOLD
				ENDIF
			ENDIF
			SIF LOCALS:ENTRY != ""
				PRINTFORM [%LOCALS:ENTRY%]
			RESETCOLOR
			FONTREGULAR
		NEXT
		SIF TALENT_CATEGORY_STRING:CAT == "種族"
			CALL PRINT_種族抽出(選択中キャラID, 種族テキスト)
		PRINTL 
	NEXT
ENDIF

@PRINT_STATE_TALENT_orig(選択中角色ID)
#DIM 選択中角色ID
#DIM TLNT_CNT, 6
#DIM TLNT_NO, 6, 100
#DIM CST_CNT, 6
#DIM CST_NO, 6, 100
#DIM CAT
#DIM ENTRY
#DIMS 種族文本

VARSET TLNT_CNT
VARSET TLNT_NO
VARSET CST_CNT
VARSET CST_NO
CALL QOL_PRINT_STATE_TALENT(選択中角色ID)
RETURN
CALL PRINTBUTTON_EX("素质",165,TFLAG:165, , , 1)
IF !TFLAG:165
	;TALENT:200(汎用角色)は表示させない
	FOR LOCAL, 0, 400
		SIF !STRLENS(GET_TALENTNAME(LOCAL, TALENT:選択中角色ID:LOCAL))
			CONTINUE
		LOCALS = {LOCAL}/
		IF GROUPMATCH(LOCAL,90,91,164,165,166,189,190,191,192,193,194,195,196,197,198,285)
			;種族,132=吸血鬼は被るので身体特徴に移動
			TLNT_NO:0:(TLNT_CNT:0) = LOCAL
			TLNT_CNT:0 ++
		ELSEIF GROUPMATCH(LOCAL,0,1,3,4,5,6,7,8,9,60,70,72,73,74,75,76,77,78,82,83,122,142,152,183,184,185,250,254,255,256,257,258,259,260,261,262,263,264)
			;性的特徴
			TLNT_NO:1:(TLNT_CNT:1) = LOCAL
			TLNT_CNT:1 ++
		ELSEIF GROUPMATCH(LOCAL,2,16,17,40,41,54,56,57,92,100,101,102,103,104,105,106,108,121,130,132,133,134,137,138,143,146,149,310,311,312)
			;身体的特徴
			TLNT_NO:2:(TLNT_CNT:2) = LOCAL
			TLNT_CNT:2 ++
		ELSEIF GROUPMATCH(LOCAL,9,10,11,12,13,14,18,19,20,21,22,23,24,25,26,30,31,32,33,61,62,71,80,81,84,85,86,94,151,155)
			;精神的特徴
			TLNT_NO:3:(TLNT_CNT:3) = LOCAL
			TLNT_CNT:3 ++
		ELSEIF GROUPMATCH(LOCAL,46, 47, 48, 49, 50,51,52,53,55,93,135,136,144,161,162,199,225)
			;技術的特徴
			TLNT_NO:4:(TLNT_CNT:4) = LOCAL
			TLNT_CNT:4 ++
		ELSE
			;其他
			TLNT_NO:5:(TLNT_CNT:5) = LOCAL
			TLNT_CNT:5 ++
		ENDIF
	NEXT
	;カスタム素質読み込み
	CALL KOJO_MESSAGE_SEND("CUSTOM_TALENT", 0, 選択中角色ID)
	;カスタム素質特徴振り分け
	FOR CAT, 0, MAX_CUSTOM_TALENT
		SIF !CUSTOM_TALENT:選択中角色ID:CAT
			CONTINUE
		LOCAL = CUSTOM_TALENT_TYPE:選択中角色ID:CAT
		IF INRANGE(LOCAL, 1, 5)
			LOCAL --
			CST_NO:LOCAL:(CST_CNT:LOCAL) = CAT
			CST_CNT:LOCAL ++
		ELSE
			CST_NO:5:(CST_CNT:5) = CAT
			CST_CNT:5 ++
		ENDIF
	NEXT
	
	FOR CAT, 0, 6
		SELECTCASE CAT
			CASE 0
				PRINT 　 种族 　：
			CASE 1
				PRINT 　性的特征：
			CASE 2
				PRINT 身体的特征：
			CASE 3
				PRINT 精神的特征：
			CASE 4
				PRINT 技术的特征：
			CASE 5
				PRINT 　 其他 　：
		ENDSELECT
		LOCALS = 
		FOR ENTRY, 0, TLNT_CNT:CAT
			LOCAL = TLNT_NO:CAT:ENTRY
			;童貞
			SIF LOCAL == 1 && !(TALENT:選択中角色ID:性別 & 2)
				CONTINUE
			;男絶壁
			IF LOCAL == 105 && (TALENT:選択中角色ID:性別 == 2)
				SIF (TALENT:選択中角色ID:105 == -2) && (TALENT:選択中角色ID:性別 == 2)
					CONTINUE
			ENDIF
			;男普臀
			IF LOCAL == 108 && (TALENT:選択中角色ID:性別 == 2)
				SIF (TALENT:選択中角色ID:108 == 0) && (TALENT:選択中角色ID:性別 == 2)
					CONTINUE
			ENDIF
			;掃除係は住んでる時だけ表示
			SIF LOCAL == GETNUM(TALENT, "掃除係") && !CFLAG:選択中角色ID:神社在住
				CONTINUE
			LOCALS += GET_TALENTNAME(LOCAL, TALENT:選択中角色ID:LOCAL)
			IF STRLENS(LOCALS) > 60
				LOCALS = " "
				PRINTL
				PRINT 　　　　　　
			ENDIF
			;素質によっては色変え
			IF GROUPMATCH(LOCAL,0,3,4,6,7,73,74,75,76,77,78,122,142) || (LOCAL == 199 && TALENT:選択中角色ID:LOCAL == 2)
				SETCOLOR 255, 120, 200
				FONTBOLD
			ELSEIF GROUPMATCH(LOCAL, 8, 199)
				SETCOLOR C_PINK
			ENDIF
			PRINTFORM [%GET_TALENTNAME(LOCAL,TALENT:選択中角色ID:LOCAL)%]
			RESETCOLOR
			FONTREGULAR
			IF CAT == 0
				種族文本 += @"%GET_TALENTNAME(LOCAL,TALENT:選択中角色ID:LOCAL)%"
			ELSE
				種族文本 = 
			ENDIF
		NEXT
		;カスタム素質を表示
		IF CST_CNT:CAT
			FOR ENTRY, 0, CST_CNT:CAT
				LOCAL = CST_NO:CAT:ENTRY
				LOCALS = %LOCALS%%CUSTOM_TALENT_NAME:選択中角色ID:LOCAL%
				IF STRLENS(LOCALS) > 60
					LOCALS = " "
					PRINTL
					PRINT 　　　　　　
				ENDIF
				SIF CUSTOM_TALENT_COLOR:選択中角色ID:LOCAL
					SETCOLOR CUSTOM_TALENT_COLOR:選択中角色ID:LOCAL
				PRINTFORM [%CUSTOM_TALENT_NAME:選択中角色ID:LOCAL%]
				RESETCOLOR
				FONTREGULAR
			NEXT
		ENDIF
		SIF CAT == 0
			CALL PRINT_種族抽出(選択中角色ID, 種族文本)
		SIF LOCALS != " "
			PRINTL 
	NEXT
	;口上自定义
	;CALL showKojoCustomTalent(選択中角色ID)
ENDIF

@PRINT_種族抽出(選択中角色ID, 種族文本)
#LOCALSIZE 1
#LOCALSSIZE 2
#DIM 選択中角色ID
#DIM TMP_RESULT
#DIMS STR_LIST, 10
#DIMS 種族文本

VARSET STR_LIST
TMP_RESULT:0 = RESULT
LOCALS =  %CSVCSTR(NO:選択中角色ID,10)%
IF STRFIND(LOCALS, "●") > -1
	SPLIT LOCALS, "●", STR_LIST
	FOR LOCAL, 0, RESULT
		IF STRFIND(STR_LIST:LOCAL, "種族：") > -1
			LOCALS:1 = %REPLACE(STR_LIST:LOCAL, "種族：", "")%
			LOCALS:1 = %REPLACE(LOCALS:1, "　", "")%
			SIF STRFIND(種族文本, LOCALS:1) < 0
				PRINTFORM 〈%LOCALS:1%〉
			BREAK
		ENDIF
	NEXT
;ELSEIF TALENT:選択中角色ID:路人 とどっちがいいんでしょうね？
ELSEIF RANDOM_CHARANUM && 選択中角色ID == RANDOM_CHARANUM
	PRINTFORM [%CSTR:選択中角色ID:路人子種族%]
ENDIF
RESULT = TMP_RESULT:0


@PRINT_刻印(選択中角色ID)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM 選択中角色ID
IF !TFLAG:166
	FOR LOCAL, 0, 6
		SIF !STRLENS(MARKNAME:LOCAL)
			CONTINUE
		PRINTFORM 　%MARKNAME:LOCAL,12%:
		IF LOCAL == 3
			SETCOLOR C_RED
			PRINTFORML %"×" * (MARK:選択中角色ID:LOCAL)%
		ELSE
			SETCOLOR 255, 255, 0
			PRINTFORML %"★" * (MARK:選択中角色ID:LOCAL)%
		ENDIF
		RESETCOLOR
	NEXT
ELSE
	PRINTL
ENDIF



