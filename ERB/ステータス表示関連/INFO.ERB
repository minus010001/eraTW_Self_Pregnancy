;qol custom code
IF ADD_BANQUET_CHARA_STATE(TARGET) == 2
	CALL COLORMESSAGE(@" 正在准备%ADD_BANQUET_TERM(CFLAG:TARGET:BANQUET)%",C_ORANGE,0,1)
ELSEIF ADD_BANQUET_CHARA_STATE(TARGET) == 1
	CALL COLORMESSAGE(@" 正在参加%ADD_BANQUET_TERM(CFLAG:TARGET:BANQUET)%",C_ORANGE,0,1)
ELSEIF CFLAG:TARGET:BANQUET && INRANGE(ADD_BANQUET_TIME_UNTIL(ADD_BANQUET_INDEX(CFLAG:TARGET:BANQUET)), 1, 180)
	CALL COLORMESSAGE(@" %ADD_BANQUET_TERM(CFLAG:TARGET:BANQUET)%还有{ADD_BANQUET_TIME_UNTIL(ADD_BANQUET_INDEX(CFLAG:TARGET:BANQUET))}分钟开始",C_ORANGE,0,1)
ENDIF

;通常時
IF LOCALS== "（"
	RETURN
;状態時
ELSE
	LOCALS += "）"
	PRINTFORM %REPLACE(LOCALS, "（・", "（")%
ENDIF
RESETCOLOR

