		DISH_TASTE '= REPLACE(DISH_TASTE, "温暖\/", "")
	ENDIF
	DISH_TASTE += "劣化/"
	FRESH_MESSAGE = 1
ENDIF

;-------------------------------------------------
;古典時刻関数@CLASSICAL_TIME
;	引数0：対象の変数（デフォでは秒）
;	引数1：1なら引数0を秒で、2なら時で計算する
;	引数2：表示形式（デフォ「○の○つ」、1=「○の刻、○つ」、2=「○の○つ　-○○-」）
;式中で使用する関数です。引数に記録されている数字を秒として、現在的時刻を文字列で返します
;古典時刻表記なので、30分単位未満の端数は切り捨てます。
;-------------------------------------------------
@CLASSICAL_TIME(ARG, ARG:1, ARG:2)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTIONS
;0:00が子の三つなので、60分を足す
ARG += 60
;日期も管理しているケースを考え、24時間（1440分）で割ってあまりを取る（子の一つ～二つもここで対応される）
ARG %= 1440
;表示
SIF GET_CLASSICAL_HOUR(ARG, 1) == "丑" && (ARG%120)/30 == 2
	RETURNF "丑三时"
RETURNF @"%GET_CLASSICAL_HOUR(ARG, 1)%时\@ ARG:2 == 1 ? 刻、 # \@%TOKANJI(((ARG%120)/30)+1)%点\@ ARG:2 == 2 ?  -%GET_CLASSICAL_HOUR(ARG, 1, 1)%- # \@"

;時を取得
;引数2を真にすると、大まかな時間の样子を取る
@GET_CLASSICAL_HOUR(ARG, ARG:1, ARG:2)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTIONS
;分に変換する
SELECTCASE ARG:1
	;時で渡す場合
	CASE 2
		ARG *= 60
	;分で渡す場合（処理無）
	CASE 1
	;秒で渡す場合（默认）
	CASEELSE
		ARG /= 60
ENDSELECT

SELECTCASE ARG/120
	CASE 0
		RETURNF \@ ARG:2 ? 深更 # 子 \@
	CASE 1
		RETURNF \@ ARG:2 ? 未明 # 丑 \@
	CASE 2
		RETURNF \@ ARG:2 ? 东云 # 寅 \@
	CASE 3
		RETURNF \@ ARG:2 ? 晓 # 卯 \@
	CASE 4
		RETURNF \@ ARG:2 ? 早天 # 辰 \@
	CASE 5
		RETURNF \@ ARG:2 ? 小昼 # 巳 \@
	CASE 6
		RETURNF \@ ARG:2 ? 昼中 # 午 \@
	CASE 7
		RETURNF \@ ARG:2 ? 日盛 # 未 \@
	CASE 8
		RETURNF \@ ARG:2 ? 终日 # 申 \@
	CASE 9
		RETURNF \@ ARG:2 ? 黄昏 # 酉 \@
	CASE 10
		RETURNF \@ ARG:2 ? 宵 # 戌 \@
	CASE 11
		RETURNF \@ ARG:2 ? 夜半 # 亥 \@
ENDSELECT

;-------------------------------------------------
;数值→汉字数字转换函数 @TOKANJI
;TOSTR関数チックに、引数の数値を漢数字の文字列で返します
;変数の最大値は約922京であるため、一、万、億、兆、京の5回処理します
;-------------------------------------------------
;-------------------------------------------------
;数值→汉字数字转换函数 @TOKANJI
;-------------------------------------------------
@TOKANJI(ARG, ARG:1)
#FUNCTIONS
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM LCOUNT, 1
#DIMS L_RESULT
#DIM IS_FIRST_BLOCK ;标记是否为首个数字块

VARSET L_RESULT
IS_FIRST_BLOCK = 1

SIF ARG == 0
	RETURNF "零"
IF ARG:1 && ARG == 2
	RETURNF "两"
ENDIF

FOR LCOUNT, 0, 5
	; 这里的除数是 10^16, 10^12, 10^8, 10^4, 1
	LOCAL = ARG / POWER(10000, (4 - LCOUNT))
	ARG %= POWER(10000, (4 - LCOUNT))
	
	IF LOCAL > 0
		; 如果不是块首，且当前块小于1000，说明前面有空位，需要补“零”
		; 例如 10001 -> 一万 零 一
		SIF !IS_FIRST_BLOCK && LOCAL < 1000
			L_RESULT += "零"
		
		; 调用转换，传入 IS_FIRST_BLOCK 以判断是否需要把 1x 读作 十x
		L_RESULT += TOKANJIT(LOCAL, ARG:1, IS_FIRST_BLOCK)
		
		SELECTCASE LCOUNT
			CASE 0
				L_RESULT += "京"
			CASE 1
				L_RESULT += "兆"
			CASE 2
				L_RESULT += "亿"
			CASE 3
				L_RESULT += "万"
		ENDSELECT
		
		; 只要出现过非0块，后面的就都不是首块了
		IS_FIRST_BLOCK = 0
	ELSEIF !IS_FIRST_BLOCK
		; 如果当前块是0，但前面已经有数字了（比如一亿零一万），这里的0由下一轮的 <1000 判断处理，或者无需处理
		; 此处不需要额外操作
	ENDIF
NEXT

RETURNF L_RESULT

;-------------------------------------------------
;内部用：四位以内汉字转换
;ARG:0 = 数值 (0-9999)
;ARG:1 = 计数数词
;ARG:2 = 是否为整个大数值的开头（决定10是读“十”还是“一十”）
;-------------------------------------------------
@TOKANJIT(ARG, ARG:1, ARG:2)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTIONS
#DIMS L_STR
#DIM L_DIGIT
#DIM HAS_PREV ; 标记当前块内是否已经输出了数字

SIF ARG >= 10000
	RETURNF "ＢＵＧ"

L_STR = 
HAS_PREV = 0

;--- 千位 ---
L_DIGIT = ARG / 1000
IF L_DIGIT > 0
	L_STR += \@ L_DIGIT == 2 && ARG:1 ? 两 # %TOKANJIS(L_DIGIT)% \@ + "千"
	HAS_PREV = 1
ENDIF

;--- 百位 ---
L_DIGIT = (ARG / 100) % 10
IF L_DIGIT > 0
	L_STR += \@ L_DIGIT == 2 && ARG:1 ? 两 # %TOKANJIS(L_DIGIT)% \@ + "百"
	HAS_PREV = 1
ELSEIF HAS_PREV && (ARG % 100) > 0
	; 如果前面有千位，且百位是0，且后面还有数字（比如 1010），补零
	L_STR += "零"
ENDIF

;--- 十位 ---
L_DIGIT = (ARG / 10) % 10
IF L_DIGIT > 0
	; 如果是“十”，且前面没有千/百位(HAS_PREV=0)，且是整个数值的开头(ARG:2=1) -> 读“十”
	; 否则读“一十”
	IF L_DIGIT == 1 && !HAS_PREV && ARG:2
		L_STR += "十"
	ELSE
		L_STR += TOKANJIS(L_DIGIT) + "十"
	ENDIF
	HAS_PREV = 1
ELSEIF HAS_PREV && (ARG % 10) > 0
	; 处理类似 101 的中间那个零，或者 8009 的零
	; 检查字符串末尾是否已经是零，避免重复（比如千位补了一次，这里不需要再补）
	SIF SUBSTRING(L_STR, STRLENS(L_STR)-2) != "零"
		L_STR += "零"
ENDIF

;--- 个位 ---
L_DIGIT = ARG % 10
IF L_DIGIT > 0
	L_STR += \@ L_DIGIT == 2 && ARG:1 && !HAS_PREV ? 两 # %TOKANJIS(L_DIGIT)% \@
ENDIF

RETURNF L_STR

;-------------------------------------------------
;内部函数
;个位数转换
;-------------------------------------------------
@TOKANJIS(ARG,ARG:1)
#LOCALSIZE 1
#LOCALSSIZE 1
#FUNCTIONS
SELECTCASE ARG
	CASE 0
		RETURNF \@ ARG:1 ? 零 #  \@
	CASE 1
		RETURNF "一"
	CASE 2
		RETURNF "二"
	CASE 3
		RETURNF "三"
	CASE 4
		RETURNF "四"
	CASE 5
		RETURNF "五"
	CASE 6
		RETURNF "六"
	CASE 7
		RETURNF "七"
	CASE 8
		RETURNF "八"
	CASE 9
		RETURNF "九"
	CASEELSE
		RETURNF "ＢＵＧ"
ENDSELECT


;-------------------------------------------------
;時間経過、角色の移動
;-------------------------------------------------
@INFO_TIME_PASSING
#LOCALSIZE 3
#LOCALSSIZE 1
#DIM MOODBREAKER
IF TFLAG:遠距離移動
	;TFLAGを戻す（遠距離移動フラグ）
	TFLAG:遠距離移動 = 0
ELSEIF TIME_PROGRESS(TIME:1)
	;角色移動
	CALL CHARA_MOVEMENT
	CALL ADD_BANQUET_PROGRESS() ;addition custom code
	IF TCVAR:MASTER:亲热 >= 1
		MOODBREAKER = IN_ROOM_MEMBER("MIN", CFLAG:MASTER:現在位置, "CFLAG", 6)
		LOCAL:2 = CFLAG:MOODBREAKER:態度
		;亲热強度０以下だと空気が変わる
		IF LOCAL:2 <= 0 && MOODBREAKER > 0 && CFLAG:MOODBREAKER:現在位置 != CFLAG:MOODBREAKER:前一次的位置 && !CFLAG:MOODBREAKER:睡眠
			SIF PREVCOM != 400
				PRINTFORMW 由于%CALLNAME:MOODBREAKER%的进入、现场的气氛改变了…
			FOR LOCAL, 0, CHARANUM
				;同室判定前なので同室フラグは使えない
				SIF CFLAG:LOCAL:現在位置 == CFLAG:MASTER:現在位置 && CFLAG:LOCAL:態度 >= 1 && !CFLAG:LOCAL:睡眠 && PREVCOM != 400
					CALL KOJO_MESSAGE_SEND("EVENT",5,LOCAL,MOODBREAKER)
				;恶作剧OFF
				CALL SET_PRANK(0,LOCAL,2)
				;隠密中OFF
				CALL SET_SNEAK(0,LOCAL,2)
			NEXT
		ENDIF
	ENDIF
	SIF WEATHERDLC
		CALL WEATHERCHANGESTAUS
ENDIF
;有关时间流速减缓的函数在TIME_PROGRESS()中
IF M_TFLAG:时间循环 && TIME_PROGRESS(TIME:1)
	DEBUGPRINTFORML 时间循环了{TIME_PROGRESS(TIME:1)}分钟
ELSE
	DEBUGPRINTFORML 没有时间循环
	TIME:1 = TIME:1 + TIME_PROGRESS(TIME:1)
ENDIF
IF M_TFLAG:时间因子类型 == TimeFactor_倒带
	TIME:1 = DAY * 1440 + TIME
ELSE
	TIME = TIME:1 - DAY * 1440
ENDIF
M_TFLAG:时间因子类型 = 0
CALL SET_SLEEP(0,MASTER,0)



;-------------------------------------------------
;TARGET関連の角色変数の更新
;-------------------------------------------------
@INFO_RENEW_TARGET
#LOCALSIZE 2
#LOCALSSIZE 1
CALL TARGETSET_CHECK("「同室更新無し」")
;MASTERと同室フラグ
FOR LOCAL, 1, CHARANUM
	;口上の基本フラグ設定
	CALL KOJO_MESSAGE_SEND("FLAGSETTING", 0, LOCAL)

	;現在位置がMASTERと同じなら同室
	IF CFLAG:LOCAL:現在位置 == CFLAG:MASTER:現在位置
		RESULT = 0
		;まだ同室フラグが立っていない(現ターンで同室化）かつ眠っていない
		SIF !CFLAG:LOCAL:同室 && !CFLAG:LOCAL:睡眠
			CALL AFFAIR_DISCLOSURE(LOCAL, 0)
		;情事の発覚 AFFAIR_DISCLOSURE で立ち去った場合は同室が立たない
		SIF !RESULT
			CFLAG:LOCAL:同室 = 1
	ELSE
		;相手からこちらが見えていて、相手かこちらかが移動したかこちらが推倒た
		IF CAN_MOVE(CFLAG:LOCAL:現在位置, CFLAG:MASTER:現在位置) & 2 && !CFLAG:LOCAL:睡眠 && PREVCOM >= 0 && FLAG:70 != 1
			IF (CFLAG:MASTER:前一次的位置 != CFLAG:MASTER:現在位置 || CFLAG:LOCAL:前一次的位置 != CFLAG:LOCAL:現在位置 || TRAINNAME:PREVCOM == "推倒") && !TCVAR:LOCAL:SEEN_NOW ;qol custom code
				CALL AFFAIR_DISCLOSURE(LOCAL, 1)
				TCVAR:LOCAL:SEEN_NOW = 1 ;qol custom code
			ENDIF
		ENDIF
		CFLAG:LOCAL:同室 = 0
	ENDIF
NEXT
CFLAG:MASTER:あなた前ターン位置 = CFLAG:MASTER:現在位置

;亲热強度決定
;TARGET側
FOR LOCAL, 1, GET_TARGETNUM() + 1
	;合意か把柄がないと3にならない
	IF GETBIT(CFLAG:(TARGET:LOCAL):既成事實, 0) || CFLAG:(TARGET:LOCAL):被掌握把柄
		LOCAL:1 = CFLAG:(TARGET:LOCAL):態度
	ELSE
		LOCAL:1 = MIN(CFLAG:(TARGET:LOCAL):態度, 2)
	ENDIF
	TCVAR:(TARGET:LOCAL):亲热 = LOCAL:1
	;TARGET:2以降は、MIN(直前のTARGETのTCVAR:130,自己的CFLAG:6)
	SIF LOCAL >= 2
		TCVAR:(TARGET:LOCAL):亲热 = MIN(TCVAR:(TARGET:(LOCAL - 1)):亲热, TCVAR:(TARGET:LOCAL):亲热)
NEXT

;MASTERはTARGET:1～のCFLAG:6の最低値
TCVAR:MASTER:亲热 = TCVAR:(IN_ROOM_MEMBER("MIN", CFLAG:MASTER:現在位置, "TCVAR", 130)):亲热

;if a character leaves in their greeting dialogue, make sure they're not set as TARGET any more
;也许不需要，整个情事察觉已经打了好几个重置对象的补丁
SIF !IS_HERE(TARGET)
	TARGET = IN_ROOM_MEMBER(, CFLAG:MASTER:現在位置, "RAND")

;-------------------------------------------------
;ウフフ終了TEQUIP処理
;EQUIPの更新もここに仕込んでおく
;-------------------------------------------------
@INFO_RENEW_EQUIP
#LOCALSIZE 1
#LOCALSSIZE 1
FOR LOCAL, 0, CHARANUM
	;qol custom code
	IF CFLAG:LOCAL:うふふ && !TCVAR:LOCAL:SEX_INITIALIZION_CHECKED
		CALL QOL_INITIALIZE_SEX(LOCAL)
		TCVAR:LOCAL:SEX_INITIALIZION_CHECKED = 1
	ENDIF
	
	SIF CFLAG:LOCAL:诶嘿嘿 && !BATHROOM(CFLAG:LOCAL:現在位置) && !睡眠時間(LOCAL)
		CONTINUE
	SIF LOCAL == TARGET && CFLAG:LOCAL:現在位置 != CFLAG:LOCAL:前一次的位置 && CFLAG:LOCAL:诶嘿嘿 > 0
		CALL ENDUFUFU(LOCAL)
	;服装更新系
	;游泳补丁
	SIF TEQUIP:LOCAL:SWIMMING && !ADD_SWIMMING_CONSTITUTION(LOCAL)
		CALL ADD_END_SWIMMING(LOCAL)
	;メンドイのでまとめて
	SIF !BATHROOM(CFLAG:LOCAL:現在位置)
		TEQUIP:(LOCAL):浴室PLAY = 0
	;風呂の中なら全裸
	IF BATHROOM(CFLAG:LOCAL:現在位置)
		SIF EQUIP:LOCAL:0 && !(TFLAG:泡風呂 && TALENT:LOCAL:風俗嬢)  
			CALL 脱衣処理(LOCAL, "全裸", "「表示無」")
		IF CFLAG:LOCAL:诶嘿嘿
			; || TCVAR:LOCAL:亲热 > 2
			TEQUIP:(LOCAL):浴室PLAY = 1
		ELSE
			TEQUIP:(LOCAL):浴室PLAY = 0
		ENDIF
	;诶嘿嘿/恶作剧中は复原衣服を抑制
	ELSEIF !(CFLAG:LOCAL:诶嘿嘿 || CFLAG:LOCAL:恶作剧 || TCVAR:LOCAL:TIME_CLOTHING_SET)
		CALL CHANGE_CLOTHES(LOCAL, "复原衣服")
	ENDIF
	CALL CLOTHES_SETTING_TRAIN(LOCAL)

	;相合伞フラグ（同行依存）
	;相合伞できるのはターゲットだけ
	SIF LOCAL != 0 && !CHK_DATENOW(CFLAG:LOCAL:约会中) && (!CFLAG:LOCAL:同行 || LOCAL != TARGET)
