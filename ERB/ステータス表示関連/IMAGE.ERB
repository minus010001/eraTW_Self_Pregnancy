#DIM VIS_C
#DIMS 表示形式
#DIMS 服装
#DIMS 差分
#DIMS TEMP, 2
;跳转新接口
CALL CALC_EXPRESSION_CORE(CHARA, 表示形式, 服装, 差分, GRAPH_SYSTEM_STATIC, LOCALS, VIS_C) ; 传入一个傀儡数组以满足语法要求
RETURN

IF TALENT:CHARA:心情 == -1 || CFLAG:CHARA:ブチギレ
	RESULTS:0 = 憤怒
	LOCAL = -1
ELSEIF TALENT:CHARA:心情 == 1 || BASE:CHARA:情緒 == MAXBASE:CHARA:情緒 || TCVAR:CHARA:烂醉
	RESULTS:0 = 笑顔
	LOCAL = 1
ELSE
	RESULTS:0 = 通常
	LOCAL = 0
ENDIF
SIF CHECK_CHARA(CHARA, "陥落")
	LOCAL ++
SIF BATHROOM(CFLAG:CHARA:現在位置) && 風呂逐出条件(CHARA)
	LOCAL --
SIF MARK:CHARA:反発刻印
	LOCAL --
SIF BASE:CHARA:憤怒 >= 500
	LOCAL --
SIF BASE:CHARA:情緒 >= 650
	LOCAL ++
;addition custom code: display jealous characters' angry portraits if you're on dates with them and they aren't the current target (thanks to Harris for the idea) 
IF TALENT:CHARA:嫉妬 && FLAG:デート相手 == CHARA && TARGET != CHARA 
	RESULTS:0 = 憤怒 
	LOCAL = -1 
ENDIF 
SELECTCASE RESULTS:0
CASE "笑顔"
;	笑顔時は表情が固まらないように
;	IF LOCAL < 0
		RESULTS:1 = 通常
;	ELSE
;		RESULTS:1 = 笑顔
;	ENDIF
CASE "憤怒"
	IF LOCAL > 0
		RESULTS:1 = 通常
	ELSE
		RESULTS:1 = 憤怒
	ENDIF
CASEELSE
	IF LOCAL > 0
		RESULTS:1 = 笑顔
	ELSEIF LOCAL < 0
		RESULTS:1 = 憤怒
	ELSE
		RESULTS:1 = 通常
	ENDIF
ENDSELECT

;表情がなければ通常
SIF !SPRITECREATED(@"%表示形式%_%服装%_%RESULTS:0%_{NO:CHARA}%差分%")
	RESULTS:0 = 通常
SIF !SPRITECREATED(@"%表示形式%_%服装%_%RESULTS:1%_{NO:CHARA}%差分%")
	RESULTS:1 = 通常

;発情用
IF TCVAR:CHARA:発情 && SPRITECREATED(@"%表示形式%_%服装%_発情_{NO:CHARA}%差分%")
	RESULTS:0 = 発情
	RESULTS:1 = 発情
ENDIF

;睡眠用
IF CFLAG:CHARA:睡眠 && SPRITECREATED(@"%表示形式%_%服装%_睡眠_{NO:CHARA}%差分%")
	RESULTS:0 = 睡眠
	RESULTS:1 = 睡眠
ENDIF
IF CFLAG:CHARA:うふふ && GETPALAMLV(PALAM:CHARA:欲情, 10) >= 7 && SPRITECREATED(@"%表示形式%_%服装%_トロ顔_{NO:CHARA}%差分%")
	RESULTS:0 = トロ顔
	RESULTS:1 = トロ顔
	IF NOWEX:CHARA:TotalEX >= 5
		RESULTS:0 = イキ顔
		RESULTS:1 = イキ顔
	ENDIF
ENDIF
;専用の特殊表情変化
CALL IMAGE_CHARA_OVERRIDE("特殊表情", CHARA)
SIF RESULTS:0 == ""
	RESULTS:0 = 通常
SIF RESULTS:1 == ""
	RESULTS:1 = 通常
;以下指令から追加される表情
SIF FLAG:時間停止 || CHARA != TARGET || CFLAG:CHARA:睡眠
	RETURN 0

;現在的表情を一時保存
TEMP:0 = %RESULTS:0%
TEMP:1 = %RESULTS:1%

;挿入中なら性交表情
SIF IS_SEXING(CHARA) && SPRITECREATED(@"%表示形式%_%服装%_性交_{NO:CHARA}%差分%")
	RESULTS:0 = 性交

SELECTCASE SELECTCOM
	;愛撫系
	CASE 0 TO 15
		IF SELECTCOM == 9
			RESULTS:0 = 自慰
		ELSE
			RESULTS:0 = 愛撫
		ENDIF
	;性交系
	CASE 60 TO 79, 317 TO 323
		RESULTS:0 = 性交
	;Counterまたは日常系愛撫
	CASE 313 TO 316
		IF CFLAG:CHARA:诶嘿嘿
			RESULTS:0 = 愛撫
		ELSEIF MARK:CHARA:不埒刻印 == 3
			RESULTS:1 = 愛撫
		ENDIF
ENDSELECT
;DEBUGPRINTFORML 表情チェック　%表示形式%_%服装%_%RESULTS:0%_{CHARA}%差分%
;表情がなければ戻す
SIF !SPRITECREATED(@"%表示形式%_%服装%_%RESULTS:0%_{NO:CHARA}%差分%")
	RESULTS:0 = %TEMP:0%
SIF !SPRITECREATED(@"%表示形式%_%服装%_%RESULTS:1%_{NO:CHARA}%差分%")
	RESULTS:1 = %TEMP:1%

;発情時2/3でマウスオーバーと表情交代
SIF RAND:3 && TCVAR:CHARA:発情 && SPRITECREATED(@"%表示形式%_%服装%_発情_{NO:CHARA}%差分%")
	SWAP RESULTS:0, RESULTS:1

;専用の特殊表情変化
CALL IMAGE_CHARA_OVERRIDE("特殊表情COM", CHARA, SELECTCOM)


;=========================================================
;@GET_EFFECT_RESOURCE(CHARA, エフェクト, 表示形式, 差分, 服装)
;	返回特效图像的资源
;		将资源分别存储在 RETURNS 数组中
;		CHARA 传入角色编号，エフェクト 传入特效名称
;		参数省略或输入空字符串时，根据当前状态自动决定
;	如果存在资源则返回特效数量，否则返回 0
;	合并变身系统的复制逻辑。但是特殊合成系统不兼容
;=========================================================
@GET_EFFECT_RESOURCE(CHARA, エフェクト = "", 表示形式 = "", 差分 = "", 服装 = "", VIS_C = -1)
#DIM CHARA
#DIM VIS_C
#DIMS 表示形式
#DIMS エフェクト
#DIMS 差分
#DIMS 服装
#DIM DYNAMIC エフェクト数 = 0
#DIMS DYNAMIC リソース, 100
#DIMS DYNAMIC エフェクト名

SIF VIS_C == -1
	VIS_C = (CFLAG:CHARA:変化先 > 0) ? CFLAG:CHARA:変化先 # CHARA
SIF !FLAG:追加エフェクト
	RETURN 0
VARSET RESULTS

; 特殊合成系统
TRYCCALLFORM SPECIAL_EFFECT_IMAGE_{NO:VIS_C}
IF RESULTS != ""
	TRYCCALLFORM %RESULTS%_GET_EFFECT_RESOURCE(VIS_C, エフェクト, CHARA)
	CATCH
		VARSET RESULTS
	ENDCATCH
	RETURN RESULT
ENDIF
CATCH
ENDCATCH

表示形式 = %GET_BASESTYLE(VIS_C, 表示形式)%
IF 差分 == ""
	CALL IMAGE_CHARA_OVERRIDE("差分", VIS_C, , , CHARA)
	SIF RESULT:1
		差分 = %RESULTS%
ENDIF

; 照れ
IF STRFIND(エフェクト, "照れ") != -1 || (エフェクト == "" && CHECK_BLUSH(CHARA, 表示形式, 差分, VIS_C))
	エフェクト名 = 照れ
	CALL IMAGE_CHARA_OVERRIDE("特殊照れ", VIS_C, , , CHARA)
	SIF RESULT:1
		エフェクト名 '= RESULTS + エフェクト名
	SIF ((CHECK_NUDE(CHARA) && 服装 == "") || 服装 == "裸") && SPRITECREATED(@"%表示形式%_裸%エフェクト名%_{NO:VIS_C}%差分%")
		エフェクト名 '= "裸" + エフェクト名
	IF SPRITECREATED(@"%表示形式%_%エフェクト名%_{NO:VIS_C}%差分%")
		リソース:エフェクト数 = %表示形式%_%エフェクト名%_{NO:VIS_C}%差分%
		エフェクト数 += 1
	ENDIF
ENDIF

; 吐息
IF STRFIND(エフェクト, "吐息") != -1 || (エフェクト == "" && CHECK_EXHALATION(CHARA))
	エフェクト名 = 吐息
	CALL IMAGE_CHARA_OVERRIDE("特殊吐息", VIS_C, , , CHARA)
	SIF RESULT:1
		エフェクト名 '= RESULTS + エフェクト名
	SIF ((CHECK_NUDE(CHARA) && 服装 == "") || 服装 == "裸") && SPRITECREATED(@"%表示形式%_裸%エフェクト名%_{NO:VIS_C}%差分%")
		エフェクト名 '= "裸" + エフェクト名
	;DEBUGPRINTFORML %表示形式%_%エフェクト名%_{NO:VIS_C}%差分%：判定为{SPRITECREATED(@"%表示形式%_%エフェクト名%_{NO:VIS_C}%差分%")}
	IF SPRITECREATED(@"%表示形式%_%エフェクト名%_{NO:VIS_C}%差分%")
		リソース:エフェクト数 = %表示形式%_%エフェクト名%_{NO:VIS_C}%差分%
		エフェクト数 += 1
	ENDIF
ENDIF

; 汗
IF STRFIND(エフェクト, "汗") != -1 || (エフェクト == "" && CHECK_SWEAT(CHARA))
	エフェクト名 = 汗
	CALL IMAGE_CHARA_OVERRIDE("特殊汗", VIS_C, , , CHARA)
	SIF RESULT:1
		エフェクト名 '= RESULTS + エフェクト名
	SIF ((CHECK_NUDE(CHARA) && 服装 == "") || 服装 == "裸") && SPRITECREATED(@"%表示形式%_裸%エフェクト名%_{NO:VIS_C}%差分%")
		エフェクト名 '= "裸" + エフェクト名
	IF SPRITECREATED(@"%表示形式%_%エフェクト名%_{NO:VIS_C}%差分%")
		リソース:エフェクト数 = %表示形式%_%エフェクト名%_{NO:VIS_C}%差分%
		エフェクト数 += 1
	ENDIF
ENDIF

; 特殊
RESULT = 0
CALL IMAGE_CHARA_OVERRIDE("特殊エフェクトチェック", VIS_C, , エフェクト, CHARA)
IF RESULT || エフェクト == ""
	CALL IMAGE_CHARA_OVERRIDE("特殊エフェクト", VIS_C, , , CHARA)
	FOR LOCAL, 0, RESULT
		;DEBUGPRINTFORML SPRITECREATED(@"%表示形式%_%RESULTS:LOCAL%_{NO:VIS_C}%差分%") IS {SPRITECREATED(@"%表示形式%_%RESULTS:LOCAL%_{NO:VIS_C}%差分%")}
		IF SPRITECREATED(@"%表示形式%_%RESULTS:LOCAL%_{NO:VIS_C}%差分%")
			リソース:エフェクト数 = %表示形式%_%RESULTS:LOCAL%_{NO:VIS_C}%差分%
			エフェクト数 += 1
		ENDIF
	NEXT
ENDIF

; 泛用特效
IF CFLAG:CHARA:通用拟声词 && NOWEX:CHARA:TotalEX >= 4 && GETPALAMLV(PALAM:CHARA:欲情, 10) >= 7
	CSTR:CHARA:汎用エフェクト '= GET_随机泛用文字()
ENDIF
IF CSTR:CHARA:汎用エフェクト != ""
	IF SPRITECREATED(@"汎用エフェクト_%CSTR:CHARA:汎用エフェクト%")
		リソース:エフェクト数 = 汎用エフェクト_%CSTR:CHARA:汎用エフェクト%
		エフェクト数 += 1
	ENDIF
ENDIF

ARRAYCOPY "リソース", "RESULTS"
RETURN エフェクト数

;照れの条件
@CHECK_BLUSH(CHARA, 表示形式, 差分, VIS_C = -1)
#FUNCTION
#DIM CHARA
#DIM VIS_C
#DIMS 表示形式
#DIMS 差分

SIF VIS_C == -1
	VIS_C = (CFLAG:CHARA:変化先 > 0) ? CFLAG:CHARA:変化先 # CHARA

SIF SPRITECREATED(@"%表示形式%_裸_発情_{NO:VIS_C}%差分%") && TCVAR:CHARA:発情
	RETURNF 0
SIF TCVAR:CHARA:烂醉 || TCVAR:CHARA:媚薬 || TCVAR:CHARA:発情
	RETURNF 1
SIF GETPALAMLV(PALAM:CHARA:好意, 15) >= 10
	RETURNF 1
SIF GETPALAMLV(PALAM:CHARA:欲情, 15) + CFLAG:CHARA:积攒度 / 200 >= 8
	RETURNF 1
SIF CFLAG:CHARA:诶嘿嘿 && (GETPALAMLV(PALAM:CHARA:欲情, 15) + CFLAG:CHARA:积攒度 / 200 >= 5)
	RETURNF 1
RETURNF 0


;吐息の条件
@CHECK_EXHALATION(CHARA)
#FUNCTION
#DIM CHARA

SIF FLAG:時間停止
	RETURNF 0

SIF BATHROOM(CFLAG:CHARA:現在位置)
	RETURNF 1
SIF GETPALAMLV(PALAM:CHARA:欲情, 5) + CFLAG:CHARA:积攒度 / 200 >= 8
	RETURNF 1
SIF CFLAG:CHARA:诶嘿嘿 && (GETPALAMLV(PALAM:CHARA:欲情, 5) + CFLAG:CHARA:积攒度 / 200 >= 5)
	RETURNF 1
RETURNF 0

;汗の条件
@CHECK_SWEAT(CHARA)
#FUNCTION
#DIM CHARA
#DIM SPENT_TIME

;夏の12~15時で晴天と晴天かつ屋外か地底なら常時汗エフェクト
;04/07/06画像加工者より。時間帯 = 3 となっていたのを 時間帯 == 3 と修正しました
SIF DAY:2 == 2 && 時間帯 == 3 && INRANGE(天候, 0, 1) && (OUTROOF(CFLAG:CHARA:現在位置) || GET_MAPID(CFLAG:CHARA:現在位置) == 9)
	RETURNF 1

SIF FLAG:時間停止
	RETURNF 0

;诶嘿嘿1時間以上
SPENT_TIME = TIME_PROGRESS(UFUFU_START_TIME + UFUFU_START_DAY * 1440) / 60
SIF SPENT_TIME > 0 && CFLAG:CHARA:诶嘿嘿
	RETURNF 1
;体力3/4かつ気力1/4
SIF BASE:CHARA:体力 < MAXBASE:CHARA:体力*3/4 && BASE:CHARA:気力 < MAXBASE:CHARA:気力/4
	RETURNF 1
RETURNF 0

@IMAGE_KOJO_OVERRIDE(FUNC_TYPE, CHARA, VALUE, STR_VALUE, TARGET_CHARA = -1)
#DIMS FUNC_TYPE
#DIM CHARA
#DIM VALUE
#DIMS STR_VALUE
#DIM TARGET_CHARA

SIF TARGET_CHARA == -1
	TARGET_CHARA = CHARA

;store content of RESULTS since KOJO_MESSAGE_SEND will clear it
LOCALS:0 '= RESULTS:0
LOCALS:1 '= RESULTS:1

CALL KOJO_MESSAGE_SEND_IMAGE("IMAGE", 0, CHARA, VALUE,, FUNC_TYPE, STR_VALUE,,,TARGET_CHARA)
SIF RESULT
	RETURN RESULT < 0 ? 0 # RESULT, 1

RESULTS:0 '= LOCALS:0
RESULTS:1 '= LOCALS:1
RETURN 0, 0

@IMAGE_CHARA_DISPATCH(FUNC_TYPE, CHARA, VALUE, STR_VALUE, TARGET_CHARA = -1)
#DIMS FUNC_TYPE
#DIM CHARA
#DIM VALUE
#DIMS STR_VALUE
#DIM TARGET_CHARA

SIF TARGET_CHARA == -1
	TARGET_CHARA = CHARA

SELECTCASE FUNC_TYPE
	CASE "特殊表情COM"
		TRYCCALLFORM IMAGE_I{NO:CHARA}_%FUNC_TYPE%(TARGET_CHARA, VALUE)
			SIF RESULT || RESULTS:0 != ""
				RETURN RESULT, 1
		CATCH
		ENDCATCH
	CASE "特殊エフェクトチェック"
		TRYCCALLFORM IMAGE_I{NO:CHARA}_%FUNC_TYPE%(TARGET_CHARA, STR_VALUE)
			SIF RESULT || RESULTS:0 != ""
				RETURN RESULT, 1
		CATCH
		ENDCATCH
	CASEELSE
		TRYCCALLFORM IMAGE_I{NO:CHARA}_%FUNC_TYPE%(TARGET_CHARA)
			SIF RESULT || RESULTS:0 != ""
				RETURN RESULT, 1
		CATCH
		ENDCATCH
ENDSELECT
RETURN 0, 0

@IMAGE_CHARA_OVERRIDE(FUNC_TYPE, CHARA, VALUE, STR_VALUE, TARGET_CHARA = -1)
#DIMS FUNC_TYPE
#DIM CHARA
#DIM VALUE
#DIMS STR_VALUE
#DIM TARGET_CHARA

SIF TARGET_CHARA == -1
	TARGET_CHARA = CHARA

CALL IMAGE_KOJO_OVERRIDE(FUNC_TYPE, CHARA, VALUE, STR_VALUE, TARGET_CHARA)
SIF RESULT:1
	RETURN RESULT:0, 1
CALL IMAGE_CHARA_DISPATCH(FUNC_TYPE, CHARA, VALUE, STR_VALUE, TARGET_CHARA)
RETURN RESULT:0, RESULT:1

;=========================================================
;	リソースの表示2
;	表示後サイズに合わせて改行を行う
;	PRINT_IMG の拡張みたいな感じ　文中の挿絵的に使えると思う
;
;	sRes_Name	：リソースの名前文字列
;	iSize		：一行の高さに対するサイズ％数値　縦基準　縦横比維持　省略で1000(10倍)
;	sAlign		：align属性　省略で左寄せ　left, center, rightの三種が指定できます
;=========================================================
@PRINT_IMAGE_OVERRAP(sRes_Name,sRes_Name_2,iSize=1000,sAlign="left")
#DIMS sRes_Name
#DIMS sRes_Name_2
#DIM iSize
#DIMS sAlign
#DIMS sPrint_Text
#DIM iEnter_Con
#DIM iFont_Hei_mag

;SIF GETCONFIGS("描画インターフェース") == "WINAPI"
;	THROW 描画インターフェースをTextRendererに変更して下さい

SIF !FLAG:画像表示 || sRes_Name == "" || sRes_Name_2 == ""
	RETURN RESULT

iEnter_Con = 0
iFont_Hei_mag = GETCONFIG("一行の高さ") * iSize*10 / GETCONFIG("フォントサイズ")
iFont_Hei_mag = (iFont_Hei_mag/10) + (iFont_Hei_mag%10 >= 5?1#0)

SIF SPRITECREATED(sRes_Name) && SPRITECREATED(sRes_Name)
	HTML_PRINT @"<p align='%sAlign%'><nobr><img src='%sRes_Name%' height='{iFont_Hei_mag}'>"
iEnter_Con++
SIF SPRITECREATED(sRes_Name_2) && SPRITECREATED(sRes_Name_2)
	HTML_PRINT @"<p align='%sAlign%'><nobr><img src='%sRes_Name_2%' height='{iFont_Hei_mag}' ypos='-{iEnter_Con * iFont_Hei_mag / 10}'>"
iEnter_Con++
IF FLAG:時間停止
	sPrint_Text =  <p align='%sAlign%'><nobr>
	sPrint_Text += @"<img src='時間停止' height='{iFont_Hei_mag}' width='{iFont_Hei_mag +20}' ypos='-{iEnter_Con * iFont_Hei_mag / 10+1}'>"
	HTML_PRINT sPrint_Text
	iEnter_Con++
ENDIF

IF FLAG:画像枠表示
	sPrint_Text =  <p align='%sAlign%'><nobr>
	sPrint_Text += @"<img src='フレーム_通常' height='{iFont_Hei_mag}' ypos='-{iEnter_Con * iFont_Hei_mag / 10+1}'>"
	HTML_PRINT sPrint_Text
	iEnter_Con++
ENDIF


FOR LOCAL,iEnter_Con-1,(iSize/100)-1
	HTML_PRINT "<br>"
NEXT
RETURN RESULT

;=========================================================
;	連番画像アニメーション
;
;	sRes_Name	：リソースの名前文字列　1番目のキャラ
;	sRes_Name_2	：リソースの名前文字列　2番目のキャラ
;	sRes_Name_3	：リソースの名前文字列　アニメーションするエフェクト　この名前の後に連番数字を付ける
;	iStart		：開始番号
;	iEnd		：開始からの描画枚数
;	iAnime_Num	：全体のアニメーション繰り返し回数 省略0でオプション設定したフラグ回数になります
;	iChenge		：sRes_Nameを表示するフレーム
;	iWait		：1枚の表示時間 デフォルトで100ms(10fps)
;	iSize		：一行の高さに対するサイズ％数値　縦基準　縦横比維持　省略で1000(10倍)
;	sAlign		：align属性　省略で左寄せ　left, center, rightの三種が指定できます
;=========================================================
@PRINT_IMAGE_TRANSANIMATION(sRes_Name,sRes_Name_2,sRes_Name_3,iStart=0,iEnd=16,iAnime_Num=1,iChenge=4,iWait=100,iSize=1000,sAlign="left")
#DIMS sRes_Name
#DIMS sRes_Name_2
#DIMS sRes_Name_3
#DIM iStart
#DIM iEnd
#DIM iAnime_Num
#DIM iChenge
#DIM iWait
#DIM iSize
#DIM txtCount
#DIM TEMP
#DIMS sAlign

SIF !FLAG:画像表示 || sRes_Name == "" || sRes_Name_2 == "" || sRes_Name_3 == ""
	RETURN RESULT

txtCount = 0
TEMP = CURRENTREDRAW()
REDRAW 0

CALL PRINT_IMAGE(sRes_Name)
PRINTFORML
TWAIT iWait, 0
CLEARLINE (iSize/100)+1

FOR LOCAL,0,iAnime_Num
	FOR LOCAL:1,iStart,(iStart+iChenge)
		CALL PRINT_IMAGE_OVERRAP(sRes_Name,@"%sRes_Name_3%{LOCAL:1}",iSize,sAlign)
		PRINTFORML 嘣砰%"…" * txtCount%
		SIF LOCAL:1 % 3 == 0
			txtCount++
		TWAIT iWait, 0
		CLEARLINE (iSize/100)+1
	NEXT


	FOR LOCAL:1,(iStart+iChenge),(iStart+iEnd)
		CALL PRINT_IMAGE_OVERRAP(sRes_Name_2,@"%sRes_Name_3%{LOCAL:1}",iSize,sAlign)
		PRINTFORML 嘣砰%"…" * txtCount%
		SIF LOCAL:1 % 3 == 0
			txtCount++
		TWAIT iWait, 0
		CLEARLINE (iSize/100)+1
	NEXT
NEXT
REDRAW TEMP

RETURN RESULT
