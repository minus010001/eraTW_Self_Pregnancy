	TRYCCALLFORM %RESULTS%_GET_BASE_RESOURCE(VIS_C, 表示形式, 服装, 表情, 表情_マウスオーバー , 差分,,, CHARA)
	CATCH
		VARSET RESULTS
	ENDCATCH
	RETURN 1
ENDIF
CATCH
ENDCATCH

;表示形式
表示形式 = %GET_BASESTYLE(CHARA, 表示形式, VIS_C)%
