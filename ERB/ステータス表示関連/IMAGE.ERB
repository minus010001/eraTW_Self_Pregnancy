; 概  要：分发资源请求、获取立绘索引
; 参  数：
;   CHARA : 角色ID
;   立绘种类 : 强制指定的显示形式 (如 "顔絵", "立絵")，为空则自动判定
;   服装 : 强制指定的服装状态，为空则自动判定
;   表情 : 强制指定的表情文本，为空则走状态机
;   表情_マウスオーバー : 强制指定的悬停表情
;   差分 : 强制指定的皮肤/状态差分
;   ALLOW_BUST_DIFF : 是否允许开启巨乳降级循环逻辑 (默认1)
; 返回值：
;   RESULTS:0 = 基础图, RESULTS:1 = 鼠标悬停图, RESULT = 1(成功)/0(失败)
;=========================================================
@GET_BASE_RESOURCE(CHARA, 表示形式 = "", 服装 = "", 表情 = "", 表情_マウスオーバー = "", 差分 = "", VIS_C = -1)
#DIM CHARA
#DIMS 表示形式
#DIMS 服装
#DIMS 表情
#DIMS 表情_マウスオーバー
#DIMS 差分
#DIM VIS_C
#DIMS 乳型 = "絶壁", "貧乳", "並乳", "巨乳", "爆乳"
#DIM CHARA_CSV_乳型
#DIM LOOP_乳型
CALL QOL_GET_BASE_RESOURCE(CHARA, 表示形式, 服装, 表情, 表情_マウスオーバー, 差分, 1, VIS_C)
RETURN RESULT

;custom code, EagloV's alt images
