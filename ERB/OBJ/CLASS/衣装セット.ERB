;要素名→ID変換用関数の存否確認用関数
;変換可能（IDと要素名の関係が常に変化しない）なら設置
;状況によって名前が変わるようなのは不可能
@EXIST_衣装セット_ID
#LOCALSIZE 1
#LOCALSSIZE 1

;要素名→ID変換用関数
;必要なら各オブジェクトで同様に作成のこと
@衣装セット_ID(ARG:0, ARGS:0, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS V_NAME                  ;作成する変数名
#DIMS C_NAME, OBJ_ID_LAST + 1 ;データ保持
#DIM  O_ID                    ;参照用
IF ARGS:0 == "RESET"
	VARSET C_NAME
	FOR O_ID, 1, OBJ_ID_LAST + 1
		C_NAME:O_ID = %GETMETH_STR(, "衣装セット", O_ID, "名前")%
	NEXT
ELSE
	O_ID = FINDELEMENT(C_NAME, ESCAPE(ARGS:0), , , 1)
	CALLF MAKE_INT(V_NAME, O_ID)
ENDIF



;存否関数
;F関数はTRYCALL系が使えないので通常関数で存否配列を作っちゃう
@EXIST_衣装セット1
#LOCALSIZE 1
#LOCALSSIZE 1

;オブジェクト本体
@衣装セット1(ARG, O_DATA, V_NAME)
#FUNCTION
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "名前"
	CALLF MAKE_STR(V_NAME, "一套男装")
CASE "基本套装"
	CALLF MAKE_INT(V_NAME, 1)

;こっから衣装設定系
CASE "靴"
	CALLF MAKE_INT(V_NAME, [[靴_鞋子]])
CASE "襪子"
	CALLF MAKE_INT(V_NAME, [[襪子_袜子]])
CASE "裤子"
	CALLF MAKE_INT(V_NAME, [[裤子_裤子]])
CASE "上半身内衣１"
;漢女は裹胸をつける
	IF GETBIT(TALENT:ARG:2, 0)
		CALLF MAKE_INT(V_NAME, [[上半身内衣_はだけ不可_裹胸]])
	ELSE
		CALLF MAKE_INT(V_NAME, [[上半身内衣_はだけ不可_Ｔ恤衫]])
	ENDIF
CASE "上身衣服１"
	CALLF MAKE_INT(V_NAME, [[上身衣服_はだけ不可_上衣]])
ENDSELECT



