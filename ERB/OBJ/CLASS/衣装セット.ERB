#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS O_DATA
#DIMS V_NAME
SELECTCASE O_DATA
CASE "名前"
	CALLF MAKE_STR(V_NAME, "迦勒底制服")
CASE "cosplay服装"
	CALLF MAKE_INT(V_NAME, 1)
;こっから衣装設定系
CASE "上身衣服２"
	CALLF MAKE_INT(V_NAME, [[上身衣服_はだけ可能_迦勒底制服衬衫]])
CASE "裙子"
	CALLF MAKE_INT(V_NAME, [[裙子_学生制服短裙]])
CASE "襪子"
		CALLF MAKE_INT(V_NAME, [[襪子_裤袜]])
CASE "靴"
	CALLF MAKE_INT(V_NAME, [[靴_长靴]])
ENDSELECT
