;==================================================
;对象高潮时的口上
;@KOJO_MESSAGE_SEND中PALAM类型CASE 2自动调用
;情景文本PALAM_MESSAGE_B已由@KOJO_MESSAGE_SEND统一调用
;==================================================
@M_KOJO_XXX_MESSAGE_PALAMCNG_B_KX
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM TotalEX

;-------------------------------------------------
;按TotalEX总强度分支
;-------------------------------------------------
SELECTCASE NOWEX:TotalEX
    ;强高潮（合计值5~15）
    CASE 5 TO 15
        PRINTFORML 
    ;中高潮（合计值2~4）
    CASE 2 TO 4
        PRINTFORML 
    ;弱高潮（合计值1）
    CASE 1
        PRINTFORML 
ENDSELECT

;-------------------------------------------------
;喷乳
;-------------------------------------------------
IF NOWEX:喷乳
    PRINTFORML 
ENDIF

;-------------------------------------------------
;射精
;-------------------------------------------------
IF NOWEX:射精
    PRINTFORML 
ENDIF

;-------------------------------------------------
;放尿
;-------------------------------------------------
IF NOWEX:放尿
    PRINTFORML 
ENDIF

;未成功调用文本，需要返回0
RETURN 0

;==================================================
;对象睡眠中的高潮口上（睡眠奸）
;@KOJO_MESSAGE_SEND中PALAM类型CASE 2自动调用（恶作剧时）
;==================================================
@M_KOJO_XXX_MESSAGE_PALAMCNG_B2_KX
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM TotalEX

;-------------------------------------------------
;按TotalEX总强度分支（睡眠中）
;-------------------------------------------------
SELECTCASE NOWEX:TotalEX
    CASE 5 TO 15
        PRINTFORML 
    CASE 2 TO 4
        PRINTFORML 
    CASE 1
        PRINTFORML 
ENDSELECT

;-------------------------------------------------
;喷乳
;-------------------------------------------------
IF NOWEX:喷乳
    PRINTFORML 
ENDIF

;-------------------------------------------------
;射精
;-------------------------------------------------
IF NOWEX:射精
    PRINTFORML 
ENDIF

;-------------------------------------------------
;放尿
;-------------------------------------------------
IF NOWEX:放尿
    PRINTFORML 
ENDIF

;未成功调用文本，需要返回0
RETURN 0

