;指令名称：六九式（COM1501）
;-------------------------------------------------
@M_KOJO_XXX_MESSAGE_PALAMCNG_A_KX_22(ARG)
#LOCALSIZE 1
#LOCALSSIZE 1
;同时射精
IF NOWEX:射精 && NOWEX:MASTER:射精
    PRINTFORML 
    RETURN 1
;只有TARGET射精
ELSEIF NOWEX:射精
    ;PLAYER有阴茎
    IF GETBIT(TALENT:PLAYER:性别,1)
        PRINTFORML 
        RETURN 1
    ;PLAYER没有阴茎
    ELSE
        PRINTFORML 
        RETURN 1
    ENDIF
;只有PLAYER射精
ELSE
    ;TARGET有阴茎
    IF GETBIT(TALENT:性别,1)
        PRINTFORML 
        RETURN 1
    ;TARGET没有阴茎
    ELSE
        PRINTFORML 
        RETURN 1
    ENDIF
ENDIF

;未成功调用文本，需要返回0
RETURN 0

