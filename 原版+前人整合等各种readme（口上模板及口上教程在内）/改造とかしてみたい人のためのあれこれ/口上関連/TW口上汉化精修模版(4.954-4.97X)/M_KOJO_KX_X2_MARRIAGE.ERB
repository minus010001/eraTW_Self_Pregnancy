;eraTheWorld 4.981 画蛇又添足 别人版剧本模板 — 婚姻事件
;※※※※※※※※※※※※※※※※※※※※※※※※※※※※
;本模板对应婚姻系统的剧本接口
;包含：求婚判定、求婚台词、婚礼准备、婚礼仪式、宾客名单
;※※※※※※※※※※※※※※※※※※※※※※※※※※※※
;--------------------------------------------------
;※剧本模板的初始化方法：
;1.将所有 KX 批量替换为「K+角色编号」（参照CSV\Chara）
;例：映姬（NO：30） - KX → K30
;2.将所有 _XXX 替换为自己的剧本标识符
;若为初期版，则可以删去所有的_XXX
;--------------------------------------------------

;==================================================
;求婚成功判定
;--------------------------------------------------
;COM13（求婚）的成功判定剧本
;设置TFLAG:192为1则求婚成功，为0则失败
;若不写此函数，则使用默认的求婚成功判定
;==================================================
@M_KOJO_XXX_SUCCESS_CUSTOM_COM_KX_13
;TFLAG:192 = 1
RETURN 1

;==================================================
;求婚剧本
;--------------------------------------------------
;COM13（求婚）的剧本
;TFLAG:193 == 0 时为求婚失败，否则为求婚成功
;==================================================
@M_KOJO_XXX_MESSAGE_CUSTOM_COM_KX_13
IF TFLAG:193 == 0
    ;-------------------------------------------------
    ;求婚失败
    ;-------------------------------------------------
    PRINTFORML
ELSE
    ;-------------------------------------------------
    ;求婚成功
    ;-------------------------------------------------
    PRINTFORML
ENDIF
RETURN 1

;==================================================
;婚礼准备剧本
;--------------------------------------------------
;ARGS参数：
;  "TYPE"   — 选择婚礼场地类型时
;  "SIZE"   — 决定婚礼规模（宾客人数）时
;  "DATE"   — 决定婚礼日期时
;  "GUESTS" — 确认宾客名单时
;==================================================
@M_KOJO_XXX_EVENT_KX_WEDDING_PREPARATIONS(ARGS, ARG, ARG:1)
#LOCALSIZE 1
#LOCALSSIZE 1
SELECTCASE ARGS
    CASE "TYPE"
        ;VARS_OR_DEFAULT("WEDDING_TYPE") != "" 时表示已选好类型
        PRINTFORML
    CASE "SIZE"
        PRINTFORML
    CASE "DATE"
        PRINTFORML
    CASE "GUESTS"
        PRINTFORML
ENDSELECT
RETURN 1

;==================================================
;自定义婚礼仪式
;--------------------------------------------------
;完全自定义的婚礼叙事，可以编写独特的婚礼场景
;若不写此函数，则使用标准婚礼仪式（WEDDING）
;可以在此更换新郎新娘的服装：
;  CALL OKIGAE(MASTER, OBJNAME_TO_ID(MASTER, "GET", "衣装セット", "ウェディングスーツセット"))
;  CALL OKIGARE(TARGET, OBJNAME_TO_ID(TARGET, "GET", "衣装セット", "ウェディングセット"))
;==================================================
@M_KOJO_XXX_EVENT_KX_CUSTOM_WEDDING(ARGS, ARG, ARG:1)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC GUEST_COUNT
;计算宾客人数
IF EXISTVAR("WEDDING_GUESTS")
    FOR LOCAL, 0, CHARANUM
        SIF GETVAR(@"WEDDING_GUESTS:{LOCAL}")
            GUEST_COUNT++
    NEXT
ENDIF

;在此编写自定义婚礼场景
PRINTFORML

TIME += 240
RETURN 1

;==================================================
;标准婚礼仪式
;--------------------------------------------------
;ARGS参数：
;  "AISLE_WALK" — 新娘入场走过通道
;  "I_DO"       — 誓词回应
;  "KISS"       — 亲吻
;==================================================
@M_KOJO_XXX_EVENT_KX_WEDDING(ARGS, ARG, ARG:1)
#LOCALSIZE 1
#LOCALSSIZE 1
SELECTCASE WEDDING_TYPE
    CASE "WESTERN"
        SELECTCASE ARGS
            CASE "AISLE_WALK"
                ;新娘入场
                PRINTFORML
            CASE "I_DO"
                ;誓词回应
                PRINTFORML
            CASE "KISS"
                ;亲吻
                PRINTFORML
        ENDSELECT
        RETURN 1
    CASE "JAPANESE"
        SELECTCASE ARGS
            CASE "AISLE_WALK"
                ;参入・修祓・致辞
                PRINTFORML
            CASE "I_DO"
                ;誓词
                PRINTFORML
            CASE "KISS"
                ;三献仪・亲吻
                PRINTFORML
        ENDSELECT
        RETURN 1
    CASE "FAIRY"
        SELECTCASE ARGS
            CASE "AISLE_WALK"
                ;花田入场
                PRINTFORML
            CASE "I_DO"
                ;誓词回应
                PRINTFORML
            CASE "KISS"
                ;亲吻
                PRINTFORML
        ENDSELECT
        RETURN 1
ENDSELECT
RETURN 1

