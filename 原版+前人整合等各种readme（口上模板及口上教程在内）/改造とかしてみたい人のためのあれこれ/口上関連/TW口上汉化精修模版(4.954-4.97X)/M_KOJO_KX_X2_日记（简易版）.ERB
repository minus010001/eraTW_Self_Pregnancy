; M_KOJO_KX_X2_日记（简易版）.ERB
; 简易版日记模板 - 自动循环调用HAPPEN函数
; 适用于：每日事件型日记（自动填充内容）
;
; 设计特点：
; - 废弃子接口设计，所有分支在主接口内直接处理
; - 废弃录入标志（LOCAL=0/IF LOCAL结构）
; - 函数名下行立即声明LOCALSIZE/LOCALSSIZE
; - 采用自动TRYCALLFORM循环机制
; - 使用PRINTFORML替代PRINTFORMW
; - 简易版自动遍历1~100页HAPPEN函数

;==========================================================
; 存在判定
; 返回1则日记系统会处理该角色的日记
;==========================================================
@DIARY_XXX_KX_EXIST
#LOCALSIZE 1
#LOCALSSIZE 1
RETURN 1

;==========================================================
; 事前处理 - 自动循环调用HAPPEN函数
; 简易版自动遍历DIARY_XXX_KX_1_HAPPEN ~ DIARY_XXX_KX_100_HAPPEN
; 根据各HAPPEN的返回值判定是否写入日记
;==========================================================
@DIARY_XXX_BEFORE_CHECK_KX
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC CHARA
CHARA = XX
MAX_DIARY_PAGE:CHARA:0 = 100
FOR LOCAL, 1, MAX_DIARY_PAGE:CHARA:0 + 1
	RESULT = 0
	TRYCALLFORM DIARY_XXX_KX_{LOCAL}_HAPPEN
	IF RESULT
		IF !DIARY:CHARA:LOCAL || RESULT:2
			DIARY:CHARA:LOCAL = RESULT:1
			SIF RESULT:1 == 3
				CALL CHARA_DIARY_PAGESETTING(CHARA, LOCAL)
		ENDIF
	ENDIF
NEXT
RETURN 0

;==========================================================
; 事后处理
; 每日事件读取日记后的收尾处理，可管理标志位等
;==========================================================
@DIARY_XXX_AFTER_CHECK_KX
#LOCALSIZE 1
#LOCALSSIZE 1
RETURN 0

;==========================================================
; 文本主接口
; PAGENUM   = 日记编号（日记模式）
; MODE      = "デイリー"：一日结束时的每日事件读取
;             "コマンド"：[阅读日记]指令读取
; PAGECOUNT = 写入的第几页
;==========================================================
@DIARY_XXX_TEXT_KX(PAGENUM, MODE, PAGECOUNT)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC PAGENUM
#DIMS DYNAMIC MODE
#DIM DYNAMIC PAGECOUNT
#DIM DYNAMIC CHARA
CHARA = XX
; 在此设置面部表情显示逻辑
; （示例代码，按需修改）
; IF MODE == "デイリー"
; 	IF GROUPMATCH(PAGENUM, 1)
; 		CALL PRINT_FACE, CHARA, "発情", "裸"
; 	ELSEIF GROUPMATCH(PAGENUM, 2)
; 		CALL PRINT_FACE, CHARA, "笑顔", "服"
; 	ELSEIF GROUPMATCH(PAGENUM, 3)
; 		CALL PRINT_FACE, CHARA, "憤怒"
; 	ELSE
; 		CALL PRINT_FACE, CHARA
; 	ENDIF
; ENDIF
PRINTFORMDL - %CALLNAME:CHARA%的日记　PAGE.{PAGECOUNT} --------------------------------------------------------------------------------------
PRINTL
; 简易版自动跳转到对应内容函数
CALLFORM DIARY_XXX_KX_{PAGENUM}
RETURN 0

;==========================================================
; 日记的发生条件（@DIARY_XXX_KX_YY_HAPPEN）
; RETURN    返回值：1为触发
; RESULT:1  形式：2为每日事件中自动读取
;                   多个日记同时触发时编号最小的仅一个被读取，
;                   其他触发的日记会被重置
;                 3为每日事件中不自动读取
;                   玩家主动阅读才能看到
;                   触发时立即写入，多次触发可写入多页
;                 0不可读，1为已读，请勿设置
; RESULT:2  重复：1为允许重复写入
;                   需配合当日有效的临时标志（TCVAR、TFLAG等）设置条件，
;                   否则会大量写入请注意
;==========================================================

;==========================================================
; 第1页
;==========================================================
@DIARY_XXX_KX_1_HAPPEN
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC CHARA
CHARA = XX
; 每日事件中自动读取填2，不自动读取填3
RESULT:1 = 2
; 允许重复写入填1，不允许填0
RESULT:2 = 0
; 在此设定触发条件
SIF CHARA == 1
	RETURN 1
RETURN 0

;－－－－－－－－－－－－－－－－－－－－－－－－－－－－－
