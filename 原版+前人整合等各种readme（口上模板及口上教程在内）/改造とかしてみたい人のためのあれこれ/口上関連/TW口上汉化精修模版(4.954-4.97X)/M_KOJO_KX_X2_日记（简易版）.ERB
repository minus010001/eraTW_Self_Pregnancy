;=============================
; 406,阅读日记
; 指令口上
; TFLAG:194（正在阅读谁的日记）
; TFLAG:194非CHARA时为阅读他人的日记，请注意区分
; PAGE为已写入的页数
; SHIRAHU(CHARA)判定角色状态是否正常
;=============================
;==================================================
; 可选：是否跳过标准描述
; 返回0：显示描述和口上
; 返回1：隐藏描述，显示口上
; 返回2：显示描述，隐藏口上
; 返回3：隐藏描述和口上
;==================================================
@M_KOJO_XXX_MESSAGE_MESSAGECHECK_COM_KX_406
#LOCALSIZE 1
#LOCALSSIZE 1
RETURN 0

@M_KOJO_XXX_MESSAGE_COM_KX_406
#LOCALSIZE 1
#LOCALSSIZE 1
#DIM DYNAMIC CHARA
CHARA = XX
IF SHIRAHU(CHARA) && TFLAG:194 == CHARA
	PRINTFORML 「」
ENDIF
RETURN 0
