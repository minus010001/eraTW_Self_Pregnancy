;编号140~150的硬核系指令
;
;设计说明：
; 硬核系指令的特点是拥有较高的痛苦/屈辱属性，角色反应强烈。
; 部分指令设计为"装着/解除"两阶段，需要分别设计台词。
; 拘束中（TEQUIP:30）状态会影响角色对其他指令的反应。
;
;如果不知道指令的含义，或不知道如何设计差分，金标准是参照该指令的情景描写文本。
;本系列的情景描写在EVENT_MESSAGE_COM.ERB

;==================================================
;140,深喉插入  强制口交至咽喉深处
;==================================================
;@M_KOJO_XXX_MESSAGE_MESSAGECHECK_COM_KX_140
;#LOCALSIZE 1
;#LOCALSSIZE 1
;RETURN 0

@M_KOJO_XXX_MESSAGE_COM_KX_140
#LOCALSIZE 1
#LOCALSSIZE 1

;时奸中
IF FLAG:70
	PRINTFORML 
	RETURN 1
;初次
ELSEIF FIRSTTIME(SELECTCOM)
	PRINTFORML 
	RETURN 1
;本回合射精
ELSEIF NOWEX:PLAYER:11
	PRINTFORML 
	RETURN 1
;通常
ELSE
	;恋慕
	IF TALENT:恋慕
		PRINTFORML 
		RETURN 1
	;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORML 
		RETURN 1
	;其他
	ELSE
		PRINTFORML 
		RETURN 1
	ENDIF
ENDIF

;未成功调用文本，需要返回0
RETURN 0

