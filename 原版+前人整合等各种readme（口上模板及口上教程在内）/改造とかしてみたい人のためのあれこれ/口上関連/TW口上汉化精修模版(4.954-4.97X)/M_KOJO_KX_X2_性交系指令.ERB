;-------------------------------------------------
;指令系总览
;-------------------------------------------------
;
;调用位置：绝大多数指令的剧本侧文本函数，仅在@SOURCE_CHECK中调用，受剧本文本统一管理接口@KOJO_MESSAGE_SEND控制；
;
;函数流：在@SOURCE_CHECK中，MESSAGE系的相关流程为
;（1）调用剧本侧指令成否判定接口——"SUCCESS"(@M_KOJO_XXX_SUCCESS_COM_KX_XX)，给予剧本侧判定指令是否成功的控制力。
;（2）调用指令函数本体@COMXX(指令函数体)
;（3）调用数值计算控制接口——"EXTRASOURCE"(@M_KOJO_XXX_EXTRASOURCE_COM_KX_XX)，给予剧本侧修改指令数值的控制力。
;*这两个接口给予剧本侧对指令行为交互的强大控制力。
;（4）调用文本控制接口——"MESSAGECHECK"(@M_KOJO_XXX_MESSAGE_MESSAGECHECK_COM_KX_XX)，用于控制何时需要略过通用的情景描写以及剧本台词
;（5）调用剧本侧文本函数体——@M_KOJO_XXX_MESSAGE_COM_KX_XX
;
;所有函数的剧本标识符由_XXX和KX表示。
;_XXX 对应 %KOJO_NAME%（角色剧本名称），KX 对应 K{NO:TARGET}（角色编号）。
;脚本创作者在复制模板时，请将函数名和调用中的_XXX替换为角色剧本名，KX替换为K{NO:TARGET}。
;
;返回值：MESSAGE_COM RETURN 0时，调用自动喘息系统,非0值不调用。自动喘息系统内部会适当判断什么情况输出什么文本。
;设计意图为，当没有剧本侧台词时，调用系统通用的、函数化台词。
;当输出了有效文本时，在分支结构的最后RETURN 1；当没有输出有效文本时，不做任何处理，让函数返回默认值0。
;
;这份模板是X2版，采用平铺式设计（废弃主接口调子接口模式），所有分支直接在函数内用IF/ELSEIF/ELSE/ENDIF处理。
;
;*********************************************
;返回值
;*********************************************
;MESSAGECHECK返回值（按需使用，不用时整段注释掉或直接RETURN 0）
;RESULT = 0: 正常显示【通用情景描写】和【剧本台词】
;RESULT = 1: 略过通用描写，只显示台词（角色性格不符合通用描写时使用）
;RESULT = 2: 显示通用描写，略过台词（罕见）
;RESULT = 3: 全部略过（不推荐）
;SKIP_MESSAGE = GETBIT(RESULT, 0) ; 第0位：是否略过通用情景描写
;SKIP_KOJO    = GETBIT(RESULT, 1) ; 第1位：是否略过剧本台词
;
;函数末尾必须包含RETURN 0，以表示未成功调用文本时的返回值
;未成功调用文本，需要返回0

;==================================================
;指令成否判定·数值控制·文本控制·模板（已封装，按需使用）
;==================================================
[SKIPSTART]
;指令成否判定
;剧本侧覆写式接管指令的结果的规则，以TFLAG:192返回成否鉴定值
;TFLAG:192 = 0 表示剧本侧不干涉COM本体设定
;TFLAG:192 = 1 强制成/大成功
;TFLAG:192 = -1 强制失败
;TFLAG:192 = -2 指令中止
@M_KOJO_XXX_SUCCESS_COM_KX_XX
#LOCALSIZE 1
#LOCALSSIZE 1
TFLAG:192 = 0

;数值计算控制函数
;提供对COM设计的各类数值进行改动的时点。与COMXX一致，可以做到任何事。
@M_KOJO_XXX_EXTRASOURCE_COM_KX_XX
#LOCALSIZE 1
#LOCALSSIZE 1

;文本控制函数
;控制是否需要略过通用情景描写和/或剧本台词
@M_KOJO_XXX_MESSAGE_MESSAGECHECK_COM_KX_XX
#LOCALSIZE 1
#LOCALSSIZE 1
RETURN 0
[SKIPEND]

;※※※※※※※※※※※※※※※※※※※※※※※※※
;性交系指令
;※※※※※※※※※※※※※※※※※※※※※※※※※
;维护人：狂气刘俊海
;维护日期：2026年4月29日

;编号60~75、79的性交系指令
;60~79号是标准的V/A性交指令
;
;差异设计说明：
;性交系指令的特点是拥有"立位"（TFLAG:193）和"正常位/後背位"两种体位变体。
;对于初学者：
; TFLAG:193 是游戏内部用来标记"当前体位是否为站立位"的标志。
; 该标志为真时代表玩家以立位姿势进行（车站便等场景），
; 为假时代表普通的卧姿体位（正常位/後背位）。
; 您可以根据角色性格为两种体位设计不同的台词。
;
;本系列的核心分支结构：
; 时奸中（FLAG:70）→ 初次（FIRSTTIME，含破瓜差分）→ V插入中（TEQUIP:50）→ A插入中（TEQUIP:51）→ 立位/正常位 → 陷落嵌套
;
;其他常用变量：
; TCVAR:破瓜（V破瓜标志，0=处女，1=已破瓜）
; TCVAR:Ａ破瓜（A破瓜标志）
; TCVAR:V挿入管理FLAG == PLAYER（上一回合V插入）
; TCVAR:A挿入管理FLAG == PLAYER（上一回合A插入）
; TCVAR:V被中出FLAG（V中出标志）
; TCVAR:A被中出FLAG（A中出标志）
; TCVAR:100 == PLAYER（V插入者检查）
; TCVAR:102（V射精检查）
; NOWEX:PLAYER:11（本回合是否射精）
;
;如果不知道指令的含义，或不知道如何设计差分，金标准是参照该指令的情景描写文本。
;本系列的情景描写在EVENT_MESSAGE_COM.ERB
;==================================================
;60,正常位  标准V性交体位，角色仰卧，玩家在上
;==================================================

;@M_KOJO_XXX_MESSAGE_MESSAGECHECK_COM_KX_60
;#LOCALSIZE 1
;#LOCALSSIZE 1
;RETURN 0

@M_KOJO_XXX_MESSAGE_COM_KX_60
#LOCALSIZE 1
#LOCALSSIZE 1

;时奸中
IF FLAG:70
	PRINTFORML 
	RETURN 1
;初次
ELSEIF FIRSTTIME(SELECTCOM)
	;V破瓜
	IF TCVAR:破瓜 == 1
		PRINTFORML 
		RETURN 1
	;非处女
	ELSE
		PRINTFORML 
		RETURN 1
	ENDIF
;V插入中（本回合插入）
ELSEIF TEQUIP:50 == PLAYER
	;本回合射精
	IF NOWEX:PLAYER:11
		PRINTFORML 
		RETURN 1
	;上回合射精（V中出）
	ELSEIF TCVAR:V被中出FLAG
		PRINTFORML 
		RETURN 1
	;通常插入中
	ELSE
		PRINTFORML 
		RETURN 1
	ENDIF
;上一回合是V插入
ELSEIF TCVAR:V挿入管理FLAG == PLAYER
	;上回合V中出
	IF TCVAR:V被中出FLAG
		PRINTFORML 
		RETURN 1
	ELSE
		PRINTFORML 
		RETURN 1
	ENDIF
;立位体位变体（车站便等场景）
ELSEIF TFLAG:193
	;基本陷落嵌套
	;时奸中
	IF FLAG:70
		PRINTFORML 
		RETURN 1
	;恋慕
	ELSEIF TALENT:恋慕
		PRINTFORML 
		RETURN 1
	;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORML 
		RETURN 1
	;其他
	ELSE
		PRINTFORML 
		RETURN 1
	ENDIF
;正常位（通常体位）
ELSE
	;基本陷落嵌套
	;恋慕
	IF TALENT:恋慕
		PRINTFORML 
		RETURN 1
	;屈服3
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORML 
		RETURN 1
	;其他
	ELSE
		PRINTFORML 
		RETURN 1
	ENDIF
ENDIF

;未成功调用文本，需要返回0
RETURN 0

