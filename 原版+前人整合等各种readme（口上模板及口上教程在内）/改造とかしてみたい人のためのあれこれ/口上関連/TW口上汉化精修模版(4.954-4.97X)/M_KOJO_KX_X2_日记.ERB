;==================================================
;日记口上模板（完整版）
;用途：为角色编写日记系统剧本
;版本：X2优化版
;==================================================
;
;剧本标识符说明：
;   本模板使用 _XXX 作为剧本标识符占位符。
;   实际使用时，请将文件中所有的 _XXX 替换为你的剧本标识（如 _少女之梦）。
;   同时将 @DIARY_XXX_ 相关函数名中的 XXX 替换为角色编号（如 @DIARY_XXX_KX_EXIST → @DIARY_30_KX_EXIST）。
;   函数名示例：
;     @DIARY_XXX_KX_EXIST       → @DIARY_少女之梦_KX_EXIST
;     @DIARY_XXX_BEFORE_CHECK_KX → @DIARY_少女之梦_BEFORE_CHECK_KX
;     @M_KOJO_XXX_MESSAGE_COM_KX_406 → @M_KOJO_少女之梦_MESSAGE_COM_KX_406
;
;调用位置：通过剧本文本统一管理接口 @KOJO_MESSAGE_SEND("DIARY", ...) 调用
;
;==================================================
;日记系统的完整调用流程
;==================================================
;
; 【每日结束时的自动流程】（由 EVENTCOMEND.ERB 触发，不依赖当前位置）
;
;   妊娠判定/出産経過 → 会っていない日数チェック → デイリーイベント
;   → 夜自慰（口上）
;   → @DIARY_XXX_TEXT_KX（日记正文显示）
;   → @DIARY_XXX_AFTER_CHECK_KX（标志处理）
;   → 陥落・素質UPチェック → 一日の終了
;
;   其中 @DIARY_XXX_BEFORE_CHECK_KX 在每日开始时由 @KOJO_MESSAGE_SEND 调用，
;   负责设置日记标志（DIARY:XX:YY）。
;
; 【@KOJO_MESSAGE_SEND 中"DIARY"分支的处理流程】（位于 KOJO_MESSAGE.ERB）
;
;   CASE "DIARY"
;       TARGET = ARG:2（发言者/日记主人编号）
;
;       ; 1. 日记存在判定
;       TRYCALLFORM DIARY%RESULTS%_K{NO:TARGET}_EXIST
;       IF RESULT
;           ; 2. 口上色指定
;           TRYCALLFORM M_KOJO%RESULTS%_COLOR_K{NO:TARGET}
;
;           SELECTCASE ARGS:1
;               CASE "EXIST"
;                   RESULT = 1
;               CASE "BEFORE_CHECK", "AFTER_CHECK"
;                   CALLFORM DIARY%RESULTS%_%ARGS:1%_K{NO:TARGET}
;               CASE "TEXT"
;                   CALLFORM DIARY%RESULTS%_TEXT_K{NO:TARGET}(ARG:3, ARGS:2, ARG:4)
;           ENDSELECT
;       ENDIF
;
;==================================================
;DIARY变量系统详解
;==================================================
;
; MAX_DIARY_PAGE:XX:0
;     角色XX的日记最大页数。取值范围1～100。
;     必须在 @DIARY_XXX_BEFORE_CHECK_KX 中设定。
;
; DIARY:XX:YY
;     角色XX的日记编号YY的状态标志。
;     YY的取值范围 1～MAX_DIARY_PAGE:XX:0。
;     值含义：
;       0 = 锁定/未解禁（不出现在日记中，不会触发显示）
;       1 = 已读（显示在日记列表中，但标记为已读）
;       2 = 未读（每日结束时自动触发阅读——デイリーイベント）
;           注意：如有多页同时为2，仅编号最小的会被读取，其余会被重置回0。
;           因此同时触发多页时，有些可能被跳过。
;       3 = 未读（不会在每日结束时自动触发，需通过[阅读日记]指令手动阅读）
;           设置为3后，日记立即写入，玩家可自主选择阅读时机。
;           一天可写入多页。
;
; PAGESET:XX:YY
;     角色XX的日记中，实际写入第YY页的日记编号。
;     当 DIARY:XX:YY = 3 时，必须调用 CHARA_DIARY_PAGESETTING(XX,YY) 来记录。
;
; 【设置DIARY标志的两种方式】
;
;   方式一：每日事件自动读取（推荐，DIARY = 2）
;     IF DIARY:XX:YY == 0 && 触发条件
;         DIARY:XX:YY = 2
;     ENDIF
;     每日结束时自动阅读，无需玩家操作。
;
;   方式二：手动读取（进阶，DIARY = 3）
;     IF DIARY:XX:YY == 0 && 触发条件
;         DIARY:XX:YY = 3
;         CALL CHARA_DIARY_PAGESETTING(XX, YY)
;     ENDIF
;     写入后需玩家主动使用[阅读日记]指令才能阅读。
;     适合需要玩家自主发现的日记内容。
;
; 【@DIARY_XXX_TEXT_KX 参数说明】
;     PAGENUM   = 日记编号（对应 DIARY:XX:YY 中的 YY）
;     MODE      = "デイリー"（每日结束时自动阅读）
;               = "コマンド"（通过[阅读日记]指令阅读）
;     PAGECOUNT = 当前日记是第几页（物理页数，从1开始）
;     TFLAG:194 = 正在阅读日记的角色编号
;
; 【COM406 - [阅读日记]指令说明】
;     [阅读日记]指令由系统 COM406 处理。
;     如果日记主人处于[恋慕]状态，可自由阅读；
;     否则需要无其他人在场，或时停状态下偷偷阅读。
;     非据点居民角色在恋慕状态下可在自宅（招待房间）阅读。
;
;     TFLAG:194 = 正在阅读谁的日记（角色编号）
;     SHIRAHU(XX) = 检查角色XX的状态是否正常
;     SPTALK = 日记阅读后的反应对话系统
;
;==================================================
;@DIARY_XXX_KX_EXIST
;日记存在判定
;返回值：
;   0 = 没有日记（系统判定该角色不写日记）
;   1 = 有日记（系统会继续调用其他日记接口）
;==================================================
@DIARY_XXX_KX_EXIST
#LOCALSIZE 1
#LOCALSSIZE 1
RETURN 1

;==================================================
;@DIARY_XXX_AFTER_CHECK_KX
;日记在每日事件中被阅读后的善后处理函数
;在此可以进行：
;   - 日记标志的追加处理
;   - 条件标志的复位
;   - 状态判定追加
;
;例如：
;   某日记被阅读后，复位"今日互动标志"
;     CFLAG:XX:今日互动标志 = 0
;
;   计数连续冷淡天数
;     SIF CFLAG:XX:好感度 <= LAST_LP + 3
;         NOTOUCH_DAY ++
;==================================================
@DIARY_XXX_AFTER_CHECK_KX
#LOCALSIZE 1
#LOCALSSIZE 1

;==================================================
;@DIARY_XXX_BEFORE_CHECK_KX
;每日开始时调用，用于更新日记标志。
;由 EVENTCOMEND.ERB 调用，不依赖当前位置。
;※ DIARY:XX:0 不可使用（0号页保留）。
;
;在此处设定 MAX_DIARY_PAGE 和各个日记的触发条件。
;所有触发条件必须包含 DIARY:XX:YY == 0 检查，
;否则同一日记可能被重复写入。
;
;推荐做法：
;   基础事件在此处统一判定；
;   指令/事件触发的日记在各指令文本函数中直接设置。
;
;常用事件判定条件参考：
;   初吻：       !TALENT:XX:キス未経験
;   処女喪失：   CSTR:XX:処女喪失履歴 != ""
;   恋人：       TALENT:XX:恋人
;   恋慕：       TALENT:XX:恋慕
;   思慕：       TALENT:XX:思慕
;   初次见面：   CFLAG:XX:面識
;==================================================
@DIARY_XXX_BEFORE_CHECK_KX
#LOCALSIZE 1
#LOCALSSIZE 1

;设置日记总页数（最大值100）
MAX_DIARY_PAGE:XX:0 = 100

;==================================================
;在此处编写日记触发条件
;格式示例：
;   方式一：每日事件自动读取（DIARY = 2）
;     ;初吻（示例）
;     SIF DIARY:XX:1 == 0 && !TALENT:XX:キス未経験
;         DIARY:XX:1 = 2
;
;     ;思慕（示例）
;     SIF DIARY:XX:20 == 0 && TALENT:XX:思慕
;         DIARY:XX:20 = 2
;
;   方式二：手动读取（DIARY = 3，需要配合 CHARA_DIARY_PAGESETTING）
;     ;好感度100以上（示例）
;     IF DIARY:XX:21 == 0 && CFLAG:XX:好感度 >= 100
;         DIARY:XX:21 = 3
;         CALL CHARA_DIARY_PAGESETTING(XX, 21)
;     ENDIF
;
;   进阶用法：读取前置日记后触发后续日记
;     IF DIARY:XX:22 == 0 && DIARY:XX:21 == 1 && CFLAG:XX:好感度 >= 1000
;         DIARY:XX:22 = 3
;         CALL CHARA_DIARY_PAGESETTING(XX, 22)
;     ENDIF
;==================================================

;==================================================
;@DIARY_XXX_TEXT_KX(PAGENUM, MODE, PAGECOUNT)
;日记正文显示函数
;
;参数：
;   PAGENUM   = 日记编号（DIARY:XX:YY 中的 YY，1～MAX_DIARY_PAGE）
;   MODE      = "デイリー"（每日结束时自动阅读）
;             = "コマンド"（通过[阅读日记]指令阅读）
;   PAGECOUNT = 当前日记的总页数（物理页数，从1开始）
;
;设计说明：
;   MODE == "デイリー" 时，建议显示角色表情/服装；
;   MODE == "コマンド" 时，可加入角色对日记内容的评论反应。
;==================================================
@DIARY_XXX_TEXT_KX(PAGENUM, MODE, PAGECOUNT)
#DIM PAGENUM
#DIMS MODE
#DIM PAGECOUNT
#LOCALSIZE 1
#LOCALSSIZE 1

;如需口上色，取消下面注释
;CALL M_KOJO_XXX_COLOR_KX

;==================================================
;面部表情/服装显示（仅每日事件时）
;使用 GROUPMATCH(PAGENUM, 日记编号) 按日记编号指定表情
;支持表情、服装、特殊画像等参数
;详细格式参见 resources\顔.CSV
;==================================================
IF MODE == "デイリー"
	IF GROUPMATCH(PAGENUM, 1)
		CALL PRINT_FACE, XX, "発情", "裸"
	ELSEIF GROUPMATCH(PAGENUM, 2)
		CALL PRINT_FACE, XX, "笑顔", "服"
	ELSEIF GROUPMATCH(PAGENUM, 3)
		CALL PRINT_FACE, XX, "憤怒"
	ELSE
		CALL PRINT_FACE, XX
	ENDIF
ENDIF

;日记标题栏
PRINTFORMDL - %CALLNAME:XX%的日记　PAGE.{PAGECOUNT} --------------------------------------------------------------------------------------
PRINTL

;==================================================
;日记正文（按日记编号分支）
;※ PAGENUM:0 不可使用
;==================================================
SELECTCASE PAGENUM
	CASE 1
		PRINTFORML ○月×日
		PRINTFORML 从今天开始，决定写日记了。
		RETURN 1
	CASE 2
		PRINTFORML 
		RETURN 1
	CASE 3
		PRINTFORML 
		RETURN 1
	CASEELSE
		;通用内容（可选）
		PRINTFORML 
		RETURN 1
ENDSELECT

RESETCOLOR

;==================================================
;未成功调用文本，需要返回0
;==================================================
RETURN 0

;==================================================
;以下为[阅读日记]指令（COM406）的文本接口
;指令编号：406
;指令名称：日记阅读（日記を読む）
;指令说明：阅读指定角色的日记。TFLAG:194 存储日记主人编号。
;
;调用流程：
;   @SOURCE_CHECK 中调用 MESSAGE 系列流程
;   → @M_KOJO_XXX_MESSAGE_MESSAGECHECK_COM_KX_406（是否跳过通用描写）
;   → @M_KOJO_XXX_MESSAGE_COM_KX_406（剧本台词）
;
;注意：TFLAG:194 可能不是当前角色，需要判断是否一致。
;==================================================

;==================================================
;文本控制函数：MESSAGECHECK
;返回值：
;   0 = 正常显示所有文本（通用描写 + 剧本台词）
;   1 = 跳过通用描写（剧本侧重写）
;   2 = 跳过剧本台词
;   3 = 全部跳过
;==================================================
[SKIPSTART]
@M_KOJO_XXX_MESSAGE_MESSAGECHECK_COM_KX_406
#LOCALSIZE 1
#LOCALSSIZE 1
RETURN 0
[SKIPEND]

;==================================================
;406,阅读日记（日記を読む）
;指令文本函数
;
;TFLAG:194 = 正在阅读日记的角色编号
;SHIRAHU(XX) = 检查角色XX的状态是否正常
;SPTALK = 用于日记阅读后的反应对话
;
;如果 TFLAG:194 != XX，说明正在阅读他人日记，需另行处理。
;==================================================
@M_KOJO_XXX_MESSAGE_COM_KX_406
#LOCALSIZE 1
#LOCALSSIZE 1

IF SHIRAHU(XX) && TFLAG:194 == XX
	;计算当前已写的日记页数
	LOCAL = 0
	FOR CHARA, 0, MAX_DIARY_PAGE:(TFLAG:194):0
		IF GROUPMATCH(DIARY:(TFLAG:194):CHARA, 1, 3)
			LOCAL ++
		ENDIF
	NEXT

	;日记阅读后的反应
	IF LOCAL > 2
		CALL SPTALK, XX, "通常", 0, @"「让你看日记…总觉得好害羞啊…」//%CALLNAME:XX%直直地看着这边"
		RETURN 1
	ELSE
		PRINTFORML 
		RETURN 1
	ENDIF
ENDIF

;未成功调用文本，需要返回0
RETURN 0
