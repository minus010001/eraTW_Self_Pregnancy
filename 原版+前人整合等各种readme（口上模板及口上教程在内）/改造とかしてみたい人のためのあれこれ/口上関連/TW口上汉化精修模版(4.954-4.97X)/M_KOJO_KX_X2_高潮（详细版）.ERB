;==================================================
;对象高潮时的口上
;@KOJO_MESSAGE_SEND中PALAM类型CASE 2自动调用
;情景文本PALAM_MESSAGE_B已由@KOJO_MESSAGE_SEND统一调用
;==================================================
@M_KOJO_XXX_MESSAGE_PALAMCNG_B_KX
#LOCALSIZE 1
#LOCALSSIZE 1

;-------------------------------------------------
;喷乳
;-------------------------------------------------
IF NOWEX:喷乳
    PRINTFORML 
ENDIF

;-------------------------------------------------
;射精
;-------------------------------------------------
IF NOWEX:射精
    PRINTFORML 
ENDIF

;-------------------------------------------------
;放尿
;-------------------------------------------------
IF NOWEX:放尿
    PRINTFORML 
ENDIF

;-------------------------------------------------
;绝顶
;-------------------------------------------------
;-------------------------------------------------
;五重绝顶（C+V+A+B+M全部同时高潮）
;-------------------------------------------------
IF NOWEX:五重绝顶
    PRINTFORML 
    RETURN 1
ENDIF

;-------------------------------------------------
;四重绝顶（4个部位同时高潮）
;-------------------------------------------------
IF NOWEX:四重绝顶
    SELECTCASE NOWEX:四重绝顶组合
        ;C+V+A+B（不含M）
        CASE 1
            PRINTFORML 
        ;C+V+A+M（不含B）
        CASE 2
            PRINTFORML 
        ;C+V+B+M（不含A）
        CASE 3
            PRINTFORML 
        ;C+A+B+M（不含V）
        CASE 4
            PRINTFORML 
        ;V+A+B+M（不含C）
        CASE 5
            PRINTFORML 
    ENDSELECT
    RETURN 1
ENDIF

;-------------------------------------------------
;三重绝顶（3个部位同时高潮）
;-------------------------------------------------
IF NOWEX:三重绝顶
    SELECTCASE NOWEX:三重绝顶组合
        ;C+V+A
        CASE 1
            PRINTFORML 
        ;C+V+B
        CASE 2
            PRINTFORML 
        ;C+V+M
        CASE 3
            PRINTFORML 
        ;C+A+B
        CASE 4
            PRINTFORML 
        ;C+A+M
        CASE 5
            PRINTFORML 
        ;C+B+M
        CASE 6
            PRINTFORML 
        ;V+A+B
        CASE 7
            PRINTFORML 
        ;V+A+M
        CASE 8
            PRINTFORML 
        ;V+B+M
        CASE 9
            PRINTFORML 
        ;A+B+M
        CASE 10
            PRINTFORML 
    ENDSELECT
    RETURN 1
ENDIF

;-------------------------------------------------
;二重绝顶（2个部位同时高潮）
;-------------------------------------------------
IF NOWEX:二重绝顶
    SELECTCASE NOWEX:二重绝顶组合
        ;C+V
        CASE 1
            PRINTFORML 
        ;C+A
        CASE 2
            PRINTFORML 
        ;C+B
        CASE 3
            PRINTFORML 
        ;C+M
        CASE 4
            PRINTFORML 
        ;V+A
        CASE 5
            PRINTFORML 
        ;V+B
        CASE 6
            PRINTFORML 
        ;V+M
        CASE 7
            PRINTFORML 
        ;A+B
        CASE 8
            PRINTFORML 
        ;A+M
        CASE 9
            PRINTFORML 
        ;B+M
        CASE 10
            PRINTFORML 
    ENDSELECT
    RETURN 1
ENDIF

;-------------------------------------------------
;C绝顶（阴蒂高潮）
;强度：超强(=3) / 强(=2) / 普通(=1)
;-------------------------------------------------
IF NOWEX:Ｃ绝顶
    IF NOWEX:Ｃ绝顶 == 3
        PRINTFORML 
    ELSEIF NOWEX:Ｃ绝顶 == 2
        PRINTFORML 
    ELSE
        PRINTFORML 
    ENDIF
ENDIF

;-------------------------------------------------
;V绝顶（阴道高潮）
;强度：超强(=3) / 强(=2) / 普通(=1)
;-------------------------------------------------
IF NOWEX:Ｖ绝顶
    IF NOWEX:Ｖ绝顶 == 3
        PRINTFORML 
    ELSEIF NOWEX:Ｖ绝顶 == 2
        PRINTFORML 
    ELSE
        PRINTFORML 
    ENDIF
ENDIF

;-------------------------------------------------
;A绝顶（肛门高潮）
;强度：超强(=3) / 强(=2) / 普通(=1)
;-------------------------------------------------
IF NOWEX:Ａ绝顶
    IF NOWEX:Ａ绝顶 == 3
        PRINTFORML 
    ELSEIF NOWEX:Ａ绝顶 == 2
        PRINTFORML 
    ELSE
        PRINTFORML 
    ENDIF
ENDIF

;-------------------------------------------------
;B绝顶（胸部高潮）
;强度：超强(=3) / 强(=2) / 普通(=1)
;-------------------------------------------------
IF NOWEX:Ｂ绝顶
    IF NOWEX:Ｂ绝顶 == 3
        PRINTFORML 
    ELSEIF NOWEX:Ｂ绝顶 == 2
        PRINTFORML 
    ELSE
        PRINTFORML 
    ENDIF
ENDIF

;-------------------------------------------------
;M绝顶（精神高潮/心理高潮）
;强度：超强(=3) / 强(=2) / 普通(=1)
;-------------------------------------------------
IF NOWEX:Ｍ绝顶
    IF NOWEX:Ｍ绝顶 == 3
        PRINTFORML 
    ELSEIF NOWEX:Ｍ绝顶 == 2
        PRINTFORML 
    ELSE
        PRINTFORML 
    ENDIF
ENDIF

;未成功调用文本，需要返回0
RETURN 0

