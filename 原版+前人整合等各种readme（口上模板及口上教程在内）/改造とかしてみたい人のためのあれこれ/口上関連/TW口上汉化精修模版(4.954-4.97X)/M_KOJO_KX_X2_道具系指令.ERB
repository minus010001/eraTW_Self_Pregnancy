;-------------------------------------------------
;指令系总览
;-------------------------------------------------
;
;*********************************************
;道具系指令说明
;*********************************************
;道具系指令涉及使用各种性爱辅助道具对对象进行调教。根据道具是否装备在对象身上，分为装备中和解除时两个主要分支。
;部分指令（如跳蛋、乳头跳蛋）可能不设置装备状态，而是在使用指令时触发一次性的效果。
;对于有装备状态的指令，应在装备中（TEQUIP:XX为真）和解除时（TEQUIP:XX为假）分别设计台词。
;典型分支顺序为：时奸判定(FLAG:70) > 初次判定(FIRSTTIME) > 装备/解除分支 > 陷落状态嵌套(恋慕/屈服3/其他)
;其中44号振动棒有特殊的破瓜(TCVAR:破瓜)判定，48号搾乳机和50号避孕套可根据需要有不同文本结构。
;
[SKIPSTART]
;关于剧本文本控制函数的说明，请参看爱抚系指令中的总览。这里仅提供模板，按需复制使用。
;==================================================
;指令成否判定
;剧本侧覆写式接管指令的结果的规则，以TFLAG:192返回成否鉴定值。0表示剧本侧不干涉COM本体设定，其余值的定义具体参照COMXX。
;==================================================
@M_KOJO_XXX_SUCCESS_COM_KX_XX
#LOCALSIZE 1
#LOCALSSIZE 1
TFLAG:192 = 0

@M_KOJO_XXX_EXTRASOURCE_COM_KX_XX
#LOCALSIZE 1
#LOCALSSIZE 1
;做任何事

@M_KOJO_XXX_MESSAGE_MESSAGECHECK_COM_KX_XX
#LOCALSIZE 1
#LOCALSSIZE 1
RETURN 0

@M_KOJO_XXX_MESSAGE_COM_KX_XX
;#LOCALSIZE 1
;#LOCALSSIZE 1
;可以使用LOCAL与LOCALS。如需使用LOCAL:1，则需要将#LOCALSIZE 1改为#LOCALSIZE 2.依此类推，如需使用LOCAL:X，则需要将#LOCALSIZE 1改为#LOCALSIZE X+1
IF 0
	PRINTFORML
	RETURN 1
ENDIF
RETURN 0

[SKIPEND]
;
;==================================================
;40,跳蛋
;==================================================
@M_KOJO_XXX_MESSAGE_COM_KX_40
#LOCALSIZE 1
#LOCALSSIZE 1
IF FLAG:70
	PRINTFORML 
	RETURN 1
ENDIF
IF FIRSTTIME(SELECTCOM)
	PRINTFORML 
	RETURN 1
ENDIF
IF TEQUIP:40
	IF TALENT:恋慕
		PRINTFORML 
		RETURN 1
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORML 
		RETURN 1
	ELSE
		PRINTFORML 
		RETURN 1
	ENDIF
ELSE
	IF TALENT:恋慕
		PRINTFORML 
		RETURN 1
	ELSEIF MARK:不埒刻印 == 3
		PRINTFORML 
		RETURN 1
	ELSE
		PRINTFORML 
		RETURN 1
	ENDIF
ENDIF
RETURN 0

