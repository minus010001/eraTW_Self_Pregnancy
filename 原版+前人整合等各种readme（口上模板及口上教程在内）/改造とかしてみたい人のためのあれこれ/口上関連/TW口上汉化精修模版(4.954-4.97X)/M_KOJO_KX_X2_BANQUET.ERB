;==================================================
;类别口上：演奏会（CONCERT）
;--------------------------------------------------
;所有CATEGORY为CONCERT的宴会，若没有特定编号口上，则回落到此
;==================================================
@M_KOJO_XXX_EVENT_KX_BANQUET_TYPE_CONCERT(SCENE, BANQUET_ID, ARG)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS SCENE
#DIM BANQUET_ID
#DIM PRESENT
PRESENT = IS_HERE(TARGET)
SELECTCASE SCENE
    CASE "BANQUET_START"
    CASE "MEET_PLAYER"
    CASE "CHARA_LEAVES", "BANQUET_END"
    CASE "IDLE"
ENDSELECT
RETURN 1