;※※※※※※※※※※※※※※※※※※※※※※※※※※※※
;eraTheWorld 4.981 画蛇又添足 别人版口上模板 — 宴会口上
;※※※※※※※※※※※※※※※※※※※※※※※※※※※※
;本模板对应新宴会系统（ADD_BANQUET）的口上接口
;旧宴会系统（ENKAI）无口上接口
;※※※※※※※※※※※※※※※※※※※※※※※※※※※※
;--------------------------------------------------
;※口上模板的初始化方法：
;1.将所有 KX 批量替换为「K+角色编号」（参照CSV\Chara）
;例：映姬（NO：30） - KX → K30
;2.将所有 _XXX 替换为自己的口上标识符
;若为初期版，则可以删去所有的_XXX
;--------------------------------------------------

;==================================================
;宴会口上 主入口
;--------------------------------------------------
;调用路径：
;  Add_Banquet.ERB → KOJO_MESSAGE_SEND("EVENT", 0, TARGET, BANQUET_ID, 0, "BANQUET", SCENE)
;  → KOJO_MESSAGE.ERB → TRYCALLFORM M_KOJO%RESULTS%_EVENT_K{NO:TARGET}_BANQUET(SCENE, BANQUET_ID, ARG)
;--------------------------------------------------
;ARG=banquet_id（宴会编号，对应ADD_BANQUET CSV）
;ARGS=SCENE（场景标识）
;==================================================
@M_KOJO_XXX_EVENT_KX_BANQUET(SCENE, BANQUET_ID, ARG)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS SCENE
#DIMS TERM
#DIM BANQUET_ID
#DIM PRESENT
RESULT = 0
PRESENT = IS_HERE(TARGET)

;--------------------------------------------------
;优先级1：特定宴会的口上
;按宴会编号分发，BANQUET_ID对应ADD_BANQUET CSV中的编号
;若该编号的宴会不需要特殊口上，可以删除对应函数
;--------------------------------------------------
TRYCALLFORM M_KOJO_XXX_EVENT_KX_BANQUET_{BANQUET_ID}(SCENE, ARG)
SIF RESULT
    RETURN 1

;--------------------------------------------------
;优先级2：按宴会类别分发
;TERM为ADD_BANQUET CSV中CATEGORY字段的大写形式
;常见类别：BANQUET（一般宴会）、CONCERT（演奏会）
;--------------------------------------------------
TERM '= TOUPPER(GET_STR(0, "ADD_BANQUET", BANQUET_ID, "CATEGORY"))
TRYCALLFORM M_KOJO_XXX_EVENT_KX_BANQUET_TYPE_%TERM%(SCENE, BANQUET_ID, ARG)
SIF RESULT
    RETURN 1

;--------------------------------------------------
;优先级3：通用宴会口上
;SCENE枚举值：
;  BANQUET_START — 宴会开始
;  MEET_PLAYER   — 在宴会中遇到玩家
;  CHARA_LEAVES  — 角色离开宴会
;  BANQUET_END   — 宴会结束
;  IDLE          — 宴会中的空闲闲聊
;--------------------------------------------------
SELECTCASE SCENE
    CASE "BANQUET_START"
        ;PRESENT为1时表示角色在宴会现场
        ;IF PRESENT
        ;   PRINTFORML
        ;ENDIF
    CASE "MEET_PLAYER"
        ;IF PRESENT
        ;   PRINTFORML
        ;ENDIF
    CASE "CHARA_LEAVES"
    CASE "BANQUET_END"
    CASE "IDLE"
        ;空闲时随机触发的闲聊，建议用PRINTDATAL
        ;IF PRESENT && !RAND:3
        ;   PRINTDATAL
        ;       DATAFORM 「……」
        ;   ENDDATA
        ;ENDIF
ENDSELECT
RETURN 1

;==================================================
;特定宴会口上：编号1（霊夢の宴会）
;--------------------------------------------------
;BANQUET_ID=1，对应ADD_BANQUET CSV中编号1的宴会
;==================================================
@M_KOJO_XXX_EVENT_KX_BANQUET_1(SCENE, ARG)
#LOCALSIZE 1
#LOCALSSIZE 1
#DIMS SCENE
#DIM PRESENT
PRESENT = IS_HERE(TARGET)
SELECTCASE SCENE
    CASE "BANQUET_START"
        ;IF PRESENT
        ;   PRINTFORML
        ;ENDIF
        RETURN 1
    CASE "MEET_PLAYER"
        ;IF PRESENT
        ;   PRINTFORML
        ;ENDIF
        RETURN 1
    CASE "CHARA_LEAVES"
    CASE "BANQUET_END"
    CASE "IDLE"
ENDSELECT
RETURN 1

;==================================================
;特定宴会口上：编号22（湖畔パーティー）
;--------------------------------------------------
;BANQUET_ID=22，对应ADD_BANQUET CSV中编号22的宴会
;==================================================
@M_KOJO_XXX_EVENT_KX_BANQUET_22(SCENE, ARG)
