;==================================================
;自定义事件・妖精恶作剧（FAIRY_PRANK）
; 一般依頼92「赌上性命的恶作剧」的剧本接口；用于给恶作剧目标角色添加专属的恶作剧情景/失败/惩罚对话
; 调用入口见 ERB\コマンド関連\COMF\依頼\一般依頼92_fairy_prank.ERB
;
; 函数签名：@M_KOJO_EVENT_K<N>_<N>_FAIRY_PRANK(ARGS, ARG, ARG:1)
;   ARGS = STATE（"scenarios" / "prank" / "failure" / "punishment" / "success"）
;
; 分支语义：
;   "scenarios"  → 决定本角色专属的恶作剧池。RETURN 一个非 0 整数，
;                   框架会把它传给 IRAI_一般92_Select_Scenario 决定本次实际场景ID。
;                   若 RETURN 0 则使用通用场景池。
;   "prank"      → 恶作剧实际执行时的角色反应（必填）。
;   "failure"    → 恶作剧失败时的角色反应（必填）。
;   "punishment" → 恶作剧完成但遭反杀/惩罚时的角色反应（可选）。
;   "success"    → 恶作剧完美成功时的角色反应（可选）。
;
; 可用变量（详见 ERB\fromEN\Addition\Add_Misc.ERH）：
;   Add_CULPRIT        = 委托人（妖精）的角色编号
;   Add_VICTIM         = 恶作剧目标的角色编号（也是本口上的 TARGET）
;   Add_ACCOMPLICES    = 共犯角色数组
;   Add_ACCOMPLICECOUNT = 共犯数量
;   Add_SCENARIO       = 当前场景ID（与 SELECTED_PRANK 一致）
;==================================================
@M_KOJO_EVENT_KX_FAIRY_PRANK(ARGS, ARG, ARG:1)
#DIMS SELECTED_PRANK
#DIM CULPRIT
SELECTCASE ARGS
	; 给本角色定义一个专属恶作剧池（2 个候选），框架会用 RETURN 值做场景选择
	CASE "scenarios"
		SELECTCASE RAND:2
			CASE 0
				SELECTED_PRANK = example_name1
			CASE 1
				SELECTED_PRANK = example_name2
		ENDSELECT
		RETURN 2

	; 恶作剧实际执行时的角色反应
	; ※ 实际角色口上实现中应根据 SELECTED_PRANK 进一步分支输出
	CASE "prank"
		CULPRIT = Add_CULPRIT
		SELECTCASE SELECTED_PRANK
			CASE "example_name1"
			CASE "example_name2"
		ENDSELECT
		RETURN 1

	; 恶作剧失败时的角色反应
	CASE "failure"
		CULPRIT = Add_CULPRIT
		SELECTCASE SELECTED_PRANK
			CASE "example_name1"
			CASE "example_name2"
		ENDSELECT
		RETURN 1

	; 恶作剧成功但遭反杀/惩罚时的角色反应（可选）
	CASE "punishment"
		RETURN 1

	; 恶作剧完美成功时的角色反应（可选）
	; CASE "success"
	;     RETURN 1
ENDSELECT
RETURN 0
