		; 示例：如果处于某些特殊状态（如：刚生完孩子、正在禁闭、或者剧情强制不准触发）
		; SIF CFLAG:具体剧情状态 == 1
		;     RETURN -1

		; 示例：如果你希望只有恋慕才能触发这个系统的任何事件
		; SIF !TALENT:恋慕
		;     RETURN -1

		;RETURN 1
	;案例：修改口交的触发条件
	;CASE DAYEVENT_ORAL ;口交
		;如果是妹子但主角没有JJ，禁止 (系统默认其实也有判断，这里是双重保险)
		;SIF !HAS_PENIS(MASTER)
		;	RETURN -1
		
		;必须满足比系统默认更高的要求才行 (系统默认是 欲望3, 技巧3)
		;SIF !( ABL:欲望 >= 5 && ABL:技巧 >= 4 && EXP:奉仕快楽経験 >= 100 )
		;	RETURN -1
		
		;满足上述条件后允许
		;RETURN 1

	;案例：修改骑乘位的触发条件
	;CASE DAYEVENT_COWGIRL ;骑乘位
		;必须是恋人才能做
		;SIF !TALENT:恋人
		;	RETURN -1
		;RETURN 1

	;案例：晚酌条件放宽
	;CASE DAYEVENT_DRINK ;晚酌
		;如果有“酒豪”素质，无视好感度要求强制允许
		;SIF TALENT:酒豪
		;	RETURN 1
		;否则交给系统判断
		;RETURN 0

	;案例：禁用某些没写剧本的事件
	;CASE DAYEVENT_STARE, DAYEVENT_PRANK, DAYEVENT_MOONVIEWING
	;	RETURN -1
ENDSELECT

;默认返回0，交给系统通用逻辑判断
RETURN 0

