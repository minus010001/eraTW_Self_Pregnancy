	ENDIF
	;-------------------------------------------------
	;A感觉 >= 2
	;地文中每2级有一个差分，直到 A感觉 >= 10 共5个（不包含<2的情况），可酌情照应
	;-------------------------------------------------
	IF ARG:1 == 2
		PRINTFORML
		RETURN 1
	ENDIF
