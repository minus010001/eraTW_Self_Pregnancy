	;在这里编写口上文本
	PRINTFORMW 
	RETURN 1
ENDIF

;--------------------------------------------------
;事件类型：乳交唤醒
;描述：角色通过乳交将玩家唤醒。
;-------------------------------------------------
IF ARG == 2
	;在这里编写口上文本
	PRINTFORMW 
	RETURN 1
ENDIF

;--------------------------------------------------
;事件类型：骑乘位/磨豆腐唤醒
;描述：角色骑在玩家身上将玩家唤醒。
;分支 (ARG:1)：
;   ARG:1 == 0 : 事件开始时的描写
;   ARG:1 == 1 : H结束后的对话（玩家选择是否起床还是继续做）
;-------------------------------------------------
IF ARG == 3
	;=== 第一阶段：事件开始 ===
	IF ARG:1 == 0
		;如果是异性/有非处女判定等
		IF TALENT:MASTER:非童貞 == 0 ;根据需要修改判断条件
			;骑乘位描写
		ELSE
			;磨豆腐描写
		ENDIF
		PRINTFORMW 
		
	;=== 第二阶段：事后选择 ===
	ELSE
		;TFLAG:193 == 1 代表玩家选择了【推倒她继续做】
		IF TFLAG:193 == 1
			;被推倒时的反应
			PRINTFORMW 
		;否则代表玩家选择了【起床整理衣服】
		ELSE
			;遗憾或满足地结束
			PRINTFORMW 
		ENDIF
	ENDIF
	RETURN 1
ENDIF
RETURN 1

