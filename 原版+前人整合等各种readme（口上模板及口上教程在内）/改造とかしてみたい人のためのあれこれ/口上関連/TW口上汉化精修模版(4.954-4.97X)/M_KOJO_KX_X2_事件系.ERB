;==================================================
;时间停止终了时
;--------------------------------------------------
;ERB\時間停止解除.ERB
;==================================================
@M_KOJO_XXX_EVENT_KX_17(ARG, ARG:1)
#LOCALSIZE 1
#LOCALSSIZE 1
;口上角色编号 = TARGET
;解除时停之后，会按照下列顺序依次触发（如果满足条件的话）
;ARG == 1/2 → 3 → 7 → 8 → 9 → 4 → 5 → 6 → 0
;如果触发浴室逐出，ARG == 7 之后的不会触发
;虽然有自带的 CFLAG:時間停止バレ 来表示角色知晓时停，但还是建议自行建立机制
;自带的判定机制会导致出现一些很敷衍的地文，并且无陷落素质时的惩罚非常严重，比如偷一条胖次直接反发3（这倒更贴近真实情况了）
;再加上惩罚是以增加SOURCE的方式，而该处并没有SOURCE的结算，所以会出现不碰就没事，一旦交互就反发的滑稽场景
;当然还要考虑移动到别处解除时停以避开惩罚的可能性，这个漏洞要不要堵看作者自己的选择了
;总绝顶次数计算方式：EX:無自覚Ｃ絶頂 + EX:無自覚Ｖ絶頂 + EX:無自覚Ａ絶頂 + EX:無自覚Ｂ絶頂 + EX:無自覚Ｍ絶頂
;--------------------------------------------------
;【谜之快感】（0 < 绝顶次数 <= 20）或【突如其来的快感】（20 < 绝顶次数 <= 40）
;-------------------------------------------------
IF ARG == 1
	PRINTFORML
	RETURN 1
ENDIF
;-------------------------------------------------
;【强烈的快感】（40 < 绝顶次数 <= 60）或【击垮神经的快感】（绝顶次数 > 60）
;-------------------------------------------------
IF ARG == 2
	PRINTFORML
	RETURN 1
ENDIF
;-------------------------------------------------
;【不寻常的开放感】或【充斥快感的开放感】（失去胖次）
;偷胖次后反复开启解除时停也会导致不断触发此处口上，建议使用一个自定义TCVR或ONCE()防止当日再次触发
;当然很残念地文还是会照常反复显示
;-------------------------------------------------
IF ARG == 3
	RETURN 1
ENDIF
;-------------------------------------------------
;【无自觉口内射精】
;-------------------------------------------------
IF ARG == 4
	;-------------------------------------------------
	;不假思索的吞了下去
	;在 精液中毒 <= 2 时，ARG:1 == 1, 2, 3的情况各有1/3概率触发
	;-------------------------------------------------
	IF ARG:1 == 1
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;想办法找机会吐了出来
	;-------------------------------------------------
	IF ARG:1 == 2
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;急忙捂住了嘴巴
	;-------------------------------------------------
	IF ARG:1 == 3
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;精液中毒 > 2，喝了下去
	;地文中有 2 < 精液中毒 <= 4 和 精液中毒 > 4 的两种情况，可酌情照应
	;-------------------------------------------------
	IF ARG:1 == 4
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;浓厚精液时，精液中毒 <= 2，被呛住
	;-------------------------------------------------
	IF ARG:1 == 5
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;浓厚精液时，精液中毒 > 2，喝了下去
	;地文中有 2 < 精液中毒 <= 4 和 精液中毒 > 4 的两种情况，可酌情照应
	;-------------------------------------------------
	IF ARG:1 == 6
		PRINTFORML
		RETURN 1
	ENDIF
ENDIF
;-------------------------------------------------
;【无自觉颜面射精】
;-------------------------------------------------
IF ARG == 5
	;-------------------------------------------------
	;持有[无知]，精液经验 < 100（没认出来是什么）
	;-------------------------------------------------
	IF ARG:1 == 1
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;注意到了粘在脸上的精液、慌忙将其擦掉了
	;-------------------------------------------------
	IF ARG:1 == 2
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;精液中毒 > 2，喝了下去
	;地文中有 2 < 精液中毒 <= 4 和 精液中毒 > 4 的两种情况，可酌情照应
	;-------------------------------------------------
	IF ARG:1 == 3
		PRINTFORML
		RETURN 1
	ENDIF
ENDIF
;-------------------------------------------------
;【无自觉手淫射精】
;-------------------------------------------------
IF ARG == 6
	;-------------------------------------------------
	;注意到了粘在手掌上的精液、不快地擦掉了
	;-------------------------------------------------
	IF ARG:1 == 1
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;精液中毒 > 2，喝了下去
	;地文中有 2 < 精液中毒 <= 4 和 精液中毒 > 4 的两种情况，可酌情照应
	;-------------------------------------------------
	IF ARG:1 == 2
		PRINTFORML
		RETURN 1
	ENDIF
ENDIF
;-------------------------------------------------
;【无自觉肛门射精】
