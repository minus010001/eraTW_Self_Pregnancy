		ELSE
			PRINTFORML
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;让MASTER停止和其他角色的情事，没有逐出便睡觉了
	;-------------------------------------------------
	IF ARG:1 == 2
		PRINTFORMW 
		RETURN 1
	ENDIF
ENDIF
