;ERB\ステータス計算関連\押し倒され.ERB （ARG == 1, 4, 5的情况）
;ERB\イベント関連\EVENTCOMEND2.ERB（ARG == 1 && ARG:1 == 2（攻守逆转）的情况）
;ERB\コマンド関連\COMF\COMF850 抜け出す.ERB （ARG == 2 && ARG:1 == 0, 2（主动摆脱） 与 ARG == 3的情况）
;ERB\ステータス計算関連\SOURCE\SOURCE.ERB （ARG == 2 && ARG:1 == 1的情况）
;ERB\イベント関連\情事発覚.ERB （ARG == 2 && ARG:1 == 2（被目击）的情况）
;==================================================
@M_KOJO_XXX_EVENT_KX_10(ARG, ARG:1)
#LOCALSIZE 1
#LOCALSSIZE 1
;口上角色编号 = TARGET
;--------------------------------------------------
;逆推倒（开始時）
;-------------------------------------------------
IF ARG == 1
	;-------------------------------------------------
	;MASTER被推倒（开始时）
	;参考的差分条件：
	;!GETBIT(CFLAG:既成事實, 1) && TALENT:合意誤認 → 并没有合意，只是因为合意误认催眠的效果逆推
	;TCVAR:発情 || TCVAR:媚薬 || CFLAG:积攒度 > 850 → 非常想做爱的状态
	;-------------------------------------------------
	IF ARG:1 == 0
		IF FIRSTTIME("逆推")
			;第一次逆推
			IF GETBIT(CFLAG:既成事實, 1)
				;已经拥有合意
				PRINTFORML
			ELSE
				;尚未拥有合意（初次情事）
				PRINTFORML
			ENDIF
		ELSE
			;非第一次逆推
			PRINTFORML
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;MASTER被抱住（开始时）
	;抱住模式是一种特殊的逆推，没有性行为的参与，只有双方均不为男性才会触发
	;参考的差分条件同逆推，请自行选用
	;-------------------------------------------------
	IF ARG:1 == 1
		IF FIRSTTIME("抱住")
			;第一次被抱住
			PRINTFORML
		ELSE
			;非第一次被抱住
			PRINTFORML
		ENDIF
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;4.973逆推接口新增：TARGET夺取主导
	;在诶嘿嘿中发生攻守逆转事件，才会触发；玩家主动使用@COM24攻守交替不能触发
	;原版条件：SHIRAHU(TARGET) && TEQUIP:TARGET:体位 == 3 && CFLAG:积攒度 > 300 && !TCVAR:TARGET:强行
	;可以在@M_KOJO_XXX_CHECK_KX_OSHITAOSARE(ARGS,ARG,ARG:1)自定义发生条件
	;-------------------------------------------------
	IF ARG:1 == 2
		PRINTFORML
		RETURN 1
	ENDIF
ENDIF
;-------------------------------------------------
;逆推终止（逆推模式以满足或疲惫结束在后面很远的地方，这里没有）
;-------------------------------------------------
IF ARG == 2
	;-------------------------------------------------
	;逆推被摆脱（安慰着拔了出来）
	;-------------------------------------------------
	IF ARG:1 == 0
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;抱住模式以满足结束
	;-------------------------------------------------
	IF ARG:1 == 1
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;抱住模式强制结束
	;-------------------------------------------------
	IF ARG:1 == 2
		IF SELECTCOM == 850
			;主动摆脱
			PRINTFORML
		ELSE
			;因为被目击而结束
			PRINTFORML
		ENDIF
		RETURN 1
	ENDIF
ENDIF
;-------------------------------------------------
;逆推摆脱失败
;-------------------------------------------------
IF ARG == 3
	;-------------------------------------------------
	;在请求做到不能做（随便模式）之后，又试图摆脱失败
	;摆脱难度与角色的施虐属性与战斗能力正相关，但无论如何都可能成功或失败
	;-------------------------------------------------
	IF ARG:1 == 1
		PRINTFORML
		RETURN 1
	ENDIF
	;-------------------------------------------------
	;欲壑难填，无法自拔（必要条件 积攒度 >= 500）
	;-------------------------------------------------
	IF ARG:1 == 2
		PRINTFORML
		RETURN 1
	ENDIF
ENDIF
;-------------------------------------------------
;满足推倒条件但在公共场合（想去没人的地方）
;-------------------------------------------------
IF ARG == 4
	;ARG:1是TARGET的积攒度（最高1000）
	;地文处分为<600, <800, <1000, =1000四个情况，如果口上侧写差分可以考虑阶段保持一致
	PRINTFORML
	RETURN 1
ENDIF
;-------------------------------------------------
;MASTER无志气时，被使用奇迹之石推倒，此时MASTER为主动（目前调用此情况的代码被注释）
;-------------------------------------------------
;IF ARG == 5
;	PRINTFORML
;	RETURN 1
;ENDIF
RETURN 1

