;==================================================
;DE系统的CHECKS系控制接口
;用于控制该角色是否允许触发特定事件，以及覆盖系统的默认条件
;==================================================
@M_KOJO_XXX_CHECK_KX_DAYEVENT_COND(ARGS, ARG, ARG:1)
#LOCALSIZE 1
#LOCALSSIZE 1
;ARG 代表事件ID，具体对应如下：
; --- 早晨 H ---
; 1: 口交/舔阴
; 2: 乳交
; 3: 骑乘位/磨豆腐
; --- 早晨 日常 ---
; 4: 早安吻
; 5: 普通叫醒
; 6: 同床共枕 (醒来时发现)
; 7: 凝视
; 8: 恶作剧
; --- 夜晚 H ---
; 9: 晚安吻 (带H气氛)
; 10: 夜袭
; --- 夜晚 日常 ---
; 11: 晚酌
; 12: 赏月
; 13: 留宿请求
;对应的枚举常量如下：
;DAYEVENT_GENERAL = 0
;DAYEVENT_ORAL = 1
;DAYEVENT_PAIZURI = 2
;DAYEVENT_COWGIRL = 3
;DAYEVENT_KISS = 4
;DAYEVENT_WAKEUP = 5
;DAYEVENT_COSLEEPING = 6
;DAYEVENT_STARE = 7
;DAYEVENT_PRANK = 8
;NIGHTEVENT_KISS = 9
;NIGHTEVENT_YOBAI = 10
;NIGHTEVENT_DRINK = 11
;NIGHTEVENT_MOONVIEWING = 12
;NIGHTEVENT_SLEEPOVER = 13

;返回值说明：
; RETURN -1 : 【绝对禁止】。
;             剧本侧禁止，即使满足系统默认条件也不触发。
;
; RETURN 0  : 【默认判定】。
;             交给系统通用逻辑判断（如好感度、能力等级、是否允许该类事件等）。
;
; RETURN 1  : 【条件允许】。
;             剧本侧允许触发，但必须遵守“3天冷却时间(CD)”和“随机来访概率”的限制。
;             这是最常用的返回值，适用于正常的恋人互动。
;
; RETURN 2  : 【强制允许】。
;             剧本侧强制允许触发，完全无视系统的限制条件：
;             1. 无视3天冷却时间（昨天刚来今天还能来）。
;             2. 无视随机概率（不需要掷骰子，必定发生）。
;             3. 无视作息时间（即使睡觉时间也能强制触发）。
;             适用于：病娇角色（每天必来）、特殊状态（如发情中）、剧情关键日（如生日）。
;             注意：这只是保证角色必定进入【候选池】，最终是否选中还得看权重抽奖。
;如果不写这个函数，或者所有情况都返回0，则完全遵循系统的通用判定。

SELECTCASE ARG
	CASE DAYEVENT_GENERAL
		; 整个DE系统的关口，决定该角色今天是否有资格参与早安/晚安事件的判定
		; 返回 2，该角色今天必定会出现在早安/晚安名单里。
		; 返回 1，视为有剧本角色参与抽选。
		; 返回 0，视为无剧本角色。
		; 返回 -1，该角色今天绝对不会出现在早安/晚安名单里。
		
