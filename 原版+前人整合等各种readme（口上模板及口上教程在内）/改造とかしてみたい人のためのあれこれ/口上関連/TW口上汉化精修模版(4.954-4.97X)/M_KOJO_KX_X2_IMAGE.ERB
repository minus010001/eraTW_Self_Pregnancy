	IF CHECK_NUDE(TARGET)
		;裸体
		IF FLAG:立ち絵種類
			;面部肖像
		ELSE
			;站立立绘
		ENDIF
	ELSE
		;穿着衣服
		IF FLAG:立ち絵種類
			;面部肖像
		ELSE
			;站立立绘
		ENDIF
	ENDIF
ELSE
	;通常图像
	IF CHECK_NUDE(TARGET)
		;裸体
		IF FLAG:立ち絵種類
			;面部肖像
		ELSE
			;站立立绘
		ENDIF
	ELSE
		;穿着衣服
		IF FLAG:立ち絵種類
			;面部肖像
		ELSE
			;站立立绘
		ENDIF
	ENDIF
ENDIF
RETURN 1

